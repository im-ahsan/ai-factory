y\n          required: false\n          schema:\n            type: string\n            enum:\n              - All results\n              - Authorized\n              - Denied\n              - Permanent sticker\n              - Unsuccessful\n        - name: page\n          in: query\n          required: false\n          schema:\n            type: integer\n            minimum: 1\n      responses:\n        '200':\n          description: Entrance attempts, including permanent-sticker and failure records\n          content:\n            application/json:\n              schema:\n                $ref: '#/components/schemas/EntryCheckPage'\n              example:\n                page: 1\n                pages: 4\n                checks:\n                  - verificationId: 3001\n                    officeDate: \"2026-06-16\"\n                    officeTime: \"08:12\"\n                    plate: KLG-4821\n                    verification: Authorized\n                    entryStatus: Green requested\n                    detail: Active temporary allocation\n                  - verificationId: 3002\n                    officeDate: \"2026-06-16\"\n                    officeTime: \"07:54\"\n                    plate: ICT-6612\n                    verification: Permanent sticker\n                    entryStatus: Not blocked\n                    detail: Utilization recorded\n        '401':\n          $ref: '#/components/responses/Unauthorized'\n        '403':\n          $ref: '#/components/responses/Forbidden'\n  /admin/utilization:\n    get:\n      operationId: getWeeklyUtilizationReport\n      summary: Get the generated weekly utilization report\n      parameters:\n        - name: weekStart\n          in: query\n          required: false\n          schema:\n            type: string\n            format: date\n      responses:\n        '200':\n          description: Weekly report with statistics and unused parking records\n          content:\n            application/json:\n        