- LPR verification\n              - Utilization\n        - name: page\n          in: query\n          required: false\n          schema:\n            type: integer\n            minimum: 1\n      responses:\n        '200':\n          description: Retained events in office-local time\n          content:\n            application/json:\n              schema:\n                $ref: '#/components/schemas/ActivityPage'\n              example:\n                page: 1\n                pages: 12\n                events:\n                  - activityId: 9201\n                    officeTime: \"2026-06-16T08:04:00+05:00\"\n                    employeeName: Aisha Rahman\n                    event: Same-day release\n                    spaceOrPlate: B2-114\n                    outcome: Released\n                  - activityId: 9202\n                    officeTime: \"2026-06-16T08:07:00+05:00\"\n                    employeeName: Bilal Ahmed\n                    event: Temporary claim\n                    spaceOrPlate: B2-08 · KLG-4821\n                    outcome: Claimed\n        '401':\n          $ref: '#/components/responses/Unauthorized'\n        '403':\n          $ref: '#/components/responses/Forbidden'\n  /integrations/entrance/detections:\n    post:\n      operationId: processEntranceDetection\n      summary: Process an LPR detection and return its indicator decision\n      security:\n        - oauth2:\n            - parking:access\n      requestBody:\n        required: true\n        content:\n          application/json:\n            schema:\n              $ref: '#/components/schemas/EntranceDetectionRequest'\n      responses:\n        '200':\n          description: Detection recorded and fail-closed verification outcome returned\n          content:\n            application/json:\n              schema:\n                $ref: '#/components/schemas/EntranceVerification'\n              example:\n                verificationId: 3001\n                officeDate: \"2026-06-16\"\n