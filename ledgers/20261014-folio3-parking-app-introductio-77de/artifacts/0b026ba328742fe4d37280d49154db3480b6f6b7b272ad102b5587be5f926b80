      properties:\n        releases:\n          type: array\n          items:\n            $ref: '#/components/schemas/ParkingRelease'\n    ScheduleReleasesRequest:\n      type: object\n      required:\n        - dates\n      properties:\n        dates:\n          type: array\n          items:\n            type: string\n            format: date\n    ReleaseCancellation:\n      type: object\n      required:\n        - releaseId\n        - status\n        - auditEvents\n      properties:\n        releaseId:\n          type: integer\n        status:\n          type: string\n          enum:\n            - Cancelled\n        auditEvents:\n          type: array\n          items:\n            $ref: '#/components/schemas/AuditEvent'\n    AuditEvent:\n      type: object\n      required:\n        - auditEventId\n        - event\n        - officeTime\n      properties:\n        auditEventId:\n          type: integer\n        event:\n          type: string\n        officeTime:\n          type: string\n          format: date-time\n    ParkingAvailability:\n      type: object\n      required:\n        - officeDate\n        - officeTimezone\n        - availableSpaceCount\n        - spaces\n      properties:\n        officeDate:\n          type: string\n          format: date\n        officeTimezone:\n          type: string\n        availableSpaceCount:\n          type: integer\n        spaces:\n          type: array\n          items:\n            $ref: '#/components/schemas/ParkingSpace'\n    ParkingSpace:\n      type: object\n      required:\n        - spaceId\n        - floor\n        - spaceCode\n      properties:\n        spaceId:\n          type: integer\n        floor:\n          type: string\n        spaceCode:\n          type: string\n    ClaimParkingRequest:\n      type: object\n      required:\n        - vehicleId\n      properties:\n        vehicleId:\n          type: integer\n","chars":9293,"exitCode":0}
