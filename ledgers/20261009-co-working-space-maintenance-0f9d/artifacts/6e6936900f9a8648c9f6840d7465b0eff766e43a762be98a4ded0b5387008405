\";","import type { MaintenanceRequest, RequestStatus } from \"@/lib/api/client.schemas\";","import { RequestDetailScreen, SPEC } from \"./screen\";","import { fixture } from \"./fixtures\";","const NEXT: Record<RequestStatus, { action: string; to: RequestStatus }> = {","  Open: { action: \"Start work\", to: \"In progress\" },","  \"In progress\": { action: \"Mark done\", to: \"Done\" },","  Done: { action: \"Reopen\", to: \"Open\" },","};","","type Load = { kind: \"loading\" } | { kind: \"found\"; request: MaintenanceRequest } | { kind: \"missing\" } | { kind: \"failed\" };","type Update = \"idle\" | \"pending\" | \"failed\" | \"done\";","","function LiveRequestDetail() {","  const nav = useNav();","  const id = Number(nav.param(\"id\") ?? nav.path.split(\"/\").pop());","  const filter = nav.param(\"filter\");","  const [reload, setReload] = useState(0);","  const [load, setLoad] = useState<Load>({ kind: \"loading\" });","  const [update, setUpdate] = useState<Update>(\"idle\");","  const sending = useRef(false);","","  useEffect(() => {","    let current = true;","    setLoad({ kind: \"loading\" });","    setUpdate(\"idle\");","    getRequest(id)","      .then((res) => {","        if (!current) return;","        if (res.status === 200) setLoad({ kind: \"found\", request: res.data });","        else setLoad({ kind: res.status === 404 ? \"missing\" : \"failed\" });","      })","      .catch(() => { if (current) setLoad({ kind: \"failed\" }); });","    return () => { current = false; };","  }, [id, reload]);","","  const request = load.kind === \"found\" ? load.request : null;","","  const fail = () => {","    setUpdate(\"failed\");","    toast.error(SPEC.copy!.validation!);","  };","","  const advance = async (current: MaintenanceRequest) => {","    if (sending.current) return;","    sending.current = true;","    setUpdate(\"pending\");","    try {","      const to = NEXT[current.status].to;","      const res = await changeRequestStatus(current.id, { status: to });","      if (res.status === 200) {","        setLoad({ kind: \"found\", request: res.data });","        setUpdate(to === \"Done\" ? \"done\" : \"idle\");","      } else fail();","    } catch {","      fail();","    } finally {","      sending.current = false;","    }","  };","","  const pending = update === \"pending\" ? ({ state: \"loading\" } as const) : {};","  const data = request","    ? {","        b0: {","          ...fixture.b0,","          title: request.title,","          lead: { label: \"Request ID\", value: `#${request.id}` },","          rows: [","            { label: \"Area\", value: request.area },","            { badge: true, label: \"Priority\", value: request.priority },","            { badge: true, label: \"Status\", value: request.status },","            { label: \"Created (UTC)\", value: request.createdAt.slice(0, 10) },","            { label: \"Description\", value: request.description || \"No description.\" },","          ],","        },","        b1: { buttons: [{ label: NEXT[request.status].action, variant: \"primary\", ...pending }] } satisfies ActionsData,","      }","    : fixture;","","  const state = load.kind === \"loading\" ? \"loading\" : load.kind === \"failed\" ? \"error\" : load.kind === \"missing\" ? \"empty\" : update === \"failed\" ? \"validation\" : update === \"done\" ? \"success\" : \"default\";","  // the header and messages of the approved spec describe the sample request, so they follow the loaded one; the failure message is shown by this page, not on every click","  const spec: ScreenSpec = { ...SPEC, badge: request?.status, subtitle: request ? `#${request.id} · ${request.title}` : undefined, toasts: undefined };","","  const onAction = (label: string) => {","    if (label === \"Retry\") setReload((n) => n + 1);","    else if (request && label === NEXT[request.status].action) void advance(request);","  };","","  return (","    <>","      <ScreenShell spec={spec} state={state} onAction={onAction}>","        {(act, invalid)