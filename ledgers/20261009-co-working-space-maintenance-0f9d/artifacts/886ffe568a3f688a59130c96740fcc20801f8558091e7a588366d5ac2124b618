{"files":[{"added":["import { useCallback, useEffect, useRef, useState } from \"react\";","import { toast } from \"sonner\";","import { AlertBlock, FormBlock, type AlertData, type Field } from \"@/components/blocks\";","import { useNav } from \"@/lib/nav\";","import { createRequest, listRequests } from \"@/lib/api/client\";","import type { CreateRequest, MaintenanceRequest, RequestStatus } from \"@/lib/api/client.schemas\";","import { RequestsScreen, SPEC } from \"./screen\";","import { fixture, overlayBlocks, type ScreenData } from \"./fixtures\";","const FILTERS = [\"All\", \"Open\", \"In progress\", \"Done\"];","const FIELD_KEYS = [\"title\", \"area\", \"priority\", \"description\"] as const;","type FieldKey = (typeof FIELD_KEYS)[number];","type FormProblem = { kind: \"validation\"; errors: Partial<Record<FieldKey, string>> } | { kind: \"failed\" } | null;","","const formFields = overlayBlocks[0]!.flatMap((b) => (b.type === \"form\" ? b.fields : []));","","function readForm(form: HTMLFormElement): CreateRequest {","  const read = (label: string) => {","    const l = Array.from(form.querySelectorAll(\"label\")).find((x) => x.textContent?.trim().startsWith(label));","    const el = l ? form.ownerDocument.getElementById(l.htmlFor) : null;","    if (!el) return \"\";","    if (el instanceof HTMLInputElement || el instanceof HTMLTextAreaElement) return el.value;","    return el.hasAttribute(\"data-placeholder\") ? \"\" : (el.textContent ?? \"\");","  };","  const description = read(\"Description\");","  return {","    title: read(\"Title\"),","    area: read(\"Area\") as CreateRequest[\"area\"],","    priority: read(\"Priority\") as CreateRequest[\"priority\"],","    ...(description ? { description } : {}),","  };","}","","function LiveRequests() {","  const nav = useNav();","  const [filter, setFilter] = useState(\"All\");","  const [reload, setReload] = useState(0);","  const [screenKey, setScreenKey] = useState(0);","  const [items, setItems] = useState<MaintenanceRequest[] | null>(null);","  const [failed, setFailed] = useState(false);","  const [problem, setProblem] = useState<FormProblem>(null);","  const sending = useRef(false);","","  useEffect(() => {","    let current = true;","    setItems(null);","    setFailed(false);","    listRequests(filter === \"All\" ? undefined : { status: filter as RequestStatus })","      .then((res) => {","        if (!current) return;","        if (res.status === 200) setItems(res.data.requests);","        else setFailed(true);","      })","      .catch(() => { if (current) setFailed(true); });","    return () => { current = false; };","  }, [filter, reload]);","","  const submit = useCallback(async (form: HTMLFormElement) => {","    if (sending.current) return;","    sending.current = true;","    const button = form.querySelector<HTMLButtonElement>('button[type=\"submit\"]');","    if (button) button.disabled = true;","    setProblem(null);","    try {","      const res = await createRequest(readForm(form));","      if (res.status === 201) {","        toast.success(SPEC.toasts![0]!.text);","        setFilter(\"All\");","        setReload((n) => n + 1);","        setScreenKey((n) => n + 1);","        return;","      }","      const errors: Partial<Record<FieldKey, string>> = {};","      if (res.status === 400) {","        for (const [key, messages] of Object.entries(res.data.errors ?? {})) {","          const k = key.toLowerCase() as FieldKey;","          if (FIELD_KEYS.includes(k) && messages[0]) errors[k] = messages[0];","        }","      }","      setProblem(Object.keys(errors).length ? { kind: \"validation\", errors } : { kind: \"failed\" });","    } catch {","      setProblem({ kind: \"failed\" });","    } finally {","      sending.current = false;","      if (button) button.disabled = false;","    }","  }, []);","","  const loading = items === null && !failed;","  const rows = items ?? [];","  const copy = SPEC.copy!;","  const alert: AlertData = failed","      ? { tone: \"bad\", title: \"Could not load requests.\", text: \"Retry to check for requests again.\", action: \"Retry\" }","      : loading","        ? { tone: \"info\", text: \"Loading requests…\" }","        : rows.length === 0","          ? { tone: \"info\", title: filter === \"All\" ? \"No requests here.\" : copy.emptyTitle!, text: copy.emptyHint! }","          : { tone: \"info\", text: `Showing ${rows.length} ${rows.length === 1 ? \"request\" : \"requests\"}, newest first.` };","  const data: ScreenData = {","    ...fixture,","    b1: alert as ScreenData[\"b1\"],","    b3: {","      ...fixture.b3,","      pages: 1,","      rows: rows.map((r) => [r.title, r.area, r.priority, r.status, r.createdAt.slice(0, 10)]),","    },","  };","","  const onAction = (label: string) => {","    if (label === \"New request\" || label === \"Cancel\") setProblem(null);","    else if (label === \"Retry\") setReload((n) => n + 1);","    else if (FILTERS.includes(label)) setFilter(label);","    else {","      const row = items?.find((r) => r.title === label);","      if (row) nav.go(`/requests/${row.id}`);","    }","  };","","  const fields: Field[] = formFields.map((f) => {","    const error = problem?.kind === \"validation\" ? problem.errors[f.label.toLowerCase() as FieldKey] : undefined;","    return problem?.kind === \"validation\" ? (error ? { ...f, required: true, error } : { ...f, required: false }) : f;","  });","","  return (","    <RequestsScreen","      key={screenKey}","      data={data}","      onAction={onAction}","      overlayBody={(index, act) => index !== 0 ? null : (","        <>","          {problem?.kind === \"validation\" && <AlertBlock mark=\"alert\" tone=\"warn\" text={copy.validation!} />}","          {problem?.kind === \"failed\" && <AlertBlock mark=\"alert\" tone=\"bad\" text={copy.error!} />}","          <FormBlock","            mark=\"form\"","            fields={fields}","            submit=\"Create\"","            invalid={problem?.kind === \"validation\"}","            onAction={(label, at) => (label === \"Create\" ? void submit(at as HTMLFormElement) : act(label, at))}","          />","        </>","      )}","    />","  );","}","","export function RequestsContainer({ fixture: state }: { fixture?: string }) {","  if (state) return <RequestsScreen state={state} />;","  return <LiveRequests />;"],"path":"components/screens/s-1/container.tsx","removed":["import { RequestsScreen } from \"./screen\";","export function RequestsContainer({ fixture }: { fixture?: string }) {","  if (fixture) return <RequestsScreen state={fixture} />;","  return <RequestsScreen />;"],"status":"M"}],"from":"c30bf377976880914e960846fa54b525847e1d1f","lockedNow":{"contracts/openapi.yaml":"2cf06dc03513489ad19f5631d6cb9d0e0227d2ddaad4d32406639075a9ba2585","lib/api/client.msw.ts":"980758c003cc449f394205d685aa7f19097d6189e043f4a691bd83390a3640f3","lib/api/client.schemas.ts":"9002cb2443593c979ed181d3432e92adc5f227eb2b118a1b8a3737c60f1a1051","lib/api/client.ts":"a4c5cd2fc6be1e33eb68b5e4de03bdaf2b3735a224c728048adfedf99329c49a","lib/api/index.ts":"06a1c829b0a5e58b2e32f755f204317fd1c34eceb5ae110d6823d668441172da","orval.config.cjs":"521b00b740896c01d641cda75dd886438bc2f64fcac27cf8ca26e88c9e8a7958","tests/api-create.test.ts":"34e42856255f5d99ae13167cf73f700345a48f3060f4305c64a87656ccf6ac6a","tests/api-seed.test.ts":"4369efa83a2ae611c0fa7ca7a26c7bf1c5398fc986b272bbd40807502b4e8508","tests/api-status.test.ts":"2b4973798ea40cd7a2536f72e579215e8ec8d251e3981ce0668fb66e265f2ce9","tests/helpers/api.ts":"3ff19179cbd897dcafed7a79c59fabb38acd371c20384879ea523ae5faba39cb","tests/helpers/fake-api.ts":"2f82004d634612e57417ceb7a6dcf2a29b352c07c0bc8510363a6afd47da06e6","tests/helpers/guard.ts":"3ee2e40e058beaccb511016930f67e87ad073b263f5fb841213cf50753742074","tests/helpers/page.tsx":"1845b179ec7eec2bc0f5c78736860a89872bffcfea51f802c989a469298936ea","tests/routes.char.test.ts":"618e71f0b0a786ba9bf89d04251ab6af8ac4fa0dee42338412db8ed7a1f7bd9c","tests/screen-create.test.tsx":"3ae362bcf55