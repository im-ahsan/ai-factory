ars\": \"The Hive Works maintenance app shall provide exactly two screens, Requests and Request detail, for the demo user Sam Carter with initials SC, without sign-in or role-selection screens.\",\n   \"id\": \"REQ-1\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-1\"\n   ],\n   \"stability\": 1\n  },\n  {\n   \"acceptance\": [\n    {\n     \"given\": \"A request has been created through the API.\",\n     \"id\": \"AC-2.1\",\n     \"level\": \"api\",\n     \"then\": \"The response and persisted row contain the system-generated ID, UTC creation timestamp, title, area, priority, and status, and contain a description only if one was supplied.\",\n     \"when\": \"The client retrieves the created request by ID.\"\n    }\n   ],\n   \"ears\": \"The Hive Works data model shall define only maintenance request records with a system-generated ID, a UTC creation timestamp, a required title, area, priority, and status, and an optional description.\",\n   \"id\": \"REQ-2\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-2\"\n   ],\n   \"stability\": 1\n  },\n  {\n   \"acceptance\": [\n    {\n     \"given\": \"A create request contains title and description values with leading or trailing whitespace and otherwise valid fields.\",\n     \"id\": \"AC-3.1\",\n     \"level\": \"api\",\n     \"then\": \"The response and persisted record contain the trimmed title and description values.\",\n     \"when\": \"The request is submitted to the API and the created request is retrieved by ID.\"\n    },\n    {\n     \"given\": \"A create request contains a title that is blank after trimming.\",\n     \"id\": \"AC-3.2\",\n     \"level\": \"api\",\n     \"then\": \"The response identifies the Title field as missing or invalid, and no request row is created.\",\n     \"when\": \"The request is submitted to the API.\"\n    }\n   ],\n   \"ears\": \"The Hive Works API shall trim leading and trailing whitespace from title and description values before validation and storage, and treat a title that is blank after trimming as missing.\",\n   \"id\": \"REQ-3\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-2\",\n    \"Q-1\"\n   ],\n   \"stability\": 1\n  },\n  {\n   \"acceptance\": [\n    {\n     \"given\": \"A create request contains a missing, blank, too-short, or too-long title; a missing or unsupported area or priority; or a description longer than 500 characters.\",\n     \"id\": \"AC-4.1\",\n     \"level\": \"api\",\n     \"then\": \"The response identifies each invalid field in an error message, and no request row is created.\",\n     \"when\": \"The request is submitted to the API.\"\n    },\n    {\n     \"given\": \"A create request contains valid field values at the stated length limits.\",\n     \"id\": \"AC-4.2\",\n     \"level\": \"api\",\n     \"then\": \"The response contains a created request row with those field values.\",\n     \"when\": \"The request is submitted to the API.\"\n    },\n    {\n     \"given\": \"A create request contains a title of 2 characters.\",\n     \"id\": \"AC-4.3\",\n     \"level\": \"api\",\n     \"then\": \"The response reports the Title field error, including “Title must be 3 to 80 characters.”\",\n     \"when\": \"The request is submitted to the API.\"\n    }\n   ],\n   \"ears\": \"The Hive Works API shall accept only titles of 3 to 80 characters, areas from Kitchen, Meeting room, Open desk, Washroom, and Reception, priorities from Low, Normal, and Urgent, and descriptions of at most 500 characters when supplied, and return a validation message naming each invalid field.\",\n   \"id\": \"REQ-4\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-2\",\n    \"I-4\",\n    \"I-8\",\n    \"Q-1\"\n   ],\n   \"stability\": 1\n  },\n  {\n   \"acceptance\": [\n    {\n     \"given\": \"A valid create request is submitted, including any caller-supplied values for system-controlled fields.\",\n     \"id\": \"AC-5.1\",\n     \"level\": \"api\",\n     \"then\": \"The response and database row contain status Open and system-generated ID and UTC creation timestamp values.\",\n     \"when\": \"The API completes creation.\"\n    }\n   ],\n   \"ears\": \"When a request is created, the Hive Works API shall set the status to Open and assign the ID and UTC creation timestamp itself, regardless of caller-supplied system-controlled values.\",\n   \"id\": \"REQ-5\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-2\",\n    \"I-4\"\n   ],\n   \"stability\": 1\n  },\n  {\n   \"acceptance\": [\n    {\n     \"given\": \"The database is empty.\",\n     \"id\": \"AC-6.1\",\n     \"level\": \"api\",\n     \"then\": \"The database contains exactly 8 seed request rows: 4 Open, 2 In progress, and 2 Done, including an Urgent Open row and at least one row for each supported area.\",\n     \"when\": \"The app initializes.\"\n    },\n    {\n     \"given\": \"The database already contains request rows and their prior values are recorded.\",\n     \"id\": \"AC-6.2\",\n     \"level\": \"api\",\n     \"then\": \"The database row count and all pre-existing request values are preserved, with no seed rows added.\",\n     \"when\": \"The app initializes or restarts.\"\n    },\n    {\n     \"given\": \"A request has been created and persisted.\",\n     \"id\": \"AC-6.3\",\n     \"level\": \"api\",\n     \"then\": \"The response and database row still contain the request, its system-generated ID, UTC creation timestamp, and stored values.\",\n     \"when\": \"The page is reloaded and the application is restarted before retrieving that request by ID.\"\n    }\n   ],\n   \"ears\": \"The Hive Works app shall initialize an empty database with exactly eight seed requests, including four Open requests with one Urgent request, two In progress requests, two Done requests, and every supported area represented, and, when initialized with a nonempty database, preserve all existing requests without inserting seeds.\",\n   \"id\": \"REQ-6\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-2\",\n    \"Q-6\"\n   ],\n   \"stability\": 1\n  },\n  {\n   \"acceptance\": [\n    {\n     \"given\": \"The API contract is available.\",\n     \"id\": \"AC-7.1\",\n     \"level\": \"api\",\n     \"then\": \"The API operation list contains only list, create, get-by-ID, and change-status operations, with no request editing or deletion operation.\",\n     \"when\": \"Its operations are inspected.\"\n    },\n    {\n     \"given\": \"A request has stored title, area, priority, and description values.\",\n     \"id\": \"AC-7.2\",\n     \"level\": \"api\",\n     \"then\": \"The response rejects the operation and the database row retains the original values and remains present.\",\n     \"when\": \"An API request attempts to change those values or delete the request.\"\n    }\n   ],\n   \"ears\": \"The Hive Works API shall expose exactly four operations: list requests with an optional status filter, create a request, get a request by ID, and change a request's status; prevent changes to title, area, priority, and description after creation; and expose no request deletion operation.\",\n   \"id\": \"REQ-7\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-3\",\n    \"I-4\"\n   ],\n   \"stability\": 1\n  },\n  {\n   \"acceptance\": [\n    {\n     \"given\": \"Requests exist with different statuses and creation timestamps.\",\n     \"id\": \"AC-8.1\",\n     \"level\": \"api\",\n     \"then\": \"The response list contains all requests without a filter or only matching-status requests with a filter, ordered by descending creation timestamp; the test does not assert relative order for equal timestamps.\",\n     \"when\": \"The list operation is called without a filter and then with each supported status filter.\"\n    }\n   ],\n   \"ears\": \"The Hive Works API shall return all requests or only requests matching an optional single status, ordered newest first by creation timestamp, without guaranteeing relative order for requests with equal timestamps.\",\n   \"id\": \"REQ-8\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-3\",\n    \"I-4\",\n    \"I-5\",\n    \"Q-3\",\n    \"I-8\"\n   ],\n   \"stability\": 1\n  },\n  {\n   \"acceptance\": [\n    {\n     \"given\": \"One requested ID belongs to an existing request and another ID does not exist.\",\n     \"id\": \"AC-9.1\",\n     \"level\": \"api\",\n     \"then\": \"The existing-ID response contains the matching record, and the unknown-ID response reports that the request was not found.\",\n     \"when\": \"The client sends a get-by-ID request for each ID.\"\n    }\n   ],\n   \"ears\": \"When a client requests a request by ID, the Hive Works API shall return the matching record if it exists and report not found if it does not.\",\n   \"id\": \"REQ-9\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-3\",\n    \"I-8\"\n   ],\n   \"stability\": 0.6666666666666666\n  },\n  {\n   \"acceptance\": [\n    {\n     \"given\": \"A request has status Open, In progress, or Done.\",\n     \"id\": \"AC-10.1\",\n     \"level\": \"api\",\n     \"then\": \"The response and database row show the requested new status for each transition.\",\n     \"when\": \"The API receives its respective allowed transition Open to In progress, In progress to Done, or Done to Open.\"\n    },\n    {\n     \"given\": \"A request has a status for which the submitted transition is not allowed.\",\n     \"id\": \"AC-10.2\",\n     \"level\": \"api\",\n     \"then\": \"The response contains an error and the database row status remains unchanged.\",\n     \"when\": \"The API processes the disallowed transition.\"\n    },\n    {\n     \"given\": \"No request exists for the supplied ID.\",\n     \"id\": \"AC-10.3\",\n     \"level\": \"api\",\n     \"then\": \"The response reports that the request was not found, and no database row is changed.\",\n     \"when\": \"The API receives a status-change request for that ID.\"\n    },\n    {\n     \"given\": \"A request exists with a supported status.\",\n     \"id\": \"AC-10.4\",\n     \"level\": \"api\",\n  