er":"<artifact id=\"spec\" kind=\"spec\" sha=\"\">\n{\n \"assumptions\": [\n  \"The locked OpenAPI contract governs session creation using `googleIdentityToken` and protected-operation OAuth2 security, rather than the conflicting email/password and reset-link assumptions.\",\n  \"Employee, vehicle, parking, and directory-profile source data are PostgreSQL records maintained through API operations or explicit test fixtures; external corporate-directory synchronization is not added.\",\n  \"Authorization follows the contract's administrator and standard-user distinctions; release and claim eligibility follows the contract-defined parking assignment status.\",\n  \"The entrance camera/controller is an external caller; the API returns verification decisions and does not control physical hardware.\",\n  \"No push or SMS delivery is added beyond contract-defined API behavior; reporting and settings are limited to contract-defined operations without scheduled email dispatch or a custom report builder.\",\n  \"Office release configuration is administrator-managed in PostgreSQL through contract configuration operations; the contract example initial timezone and release time are `Asia/Karachi` and `08:00`, and the initial scheduling window is 30 days.\",\n  \"Parking dates and times use the configured office-local timezone, initially `Asia/Karachi`, and use the persisted office timezone after an administrator changes it.\",\n  \"Demo seeding is idempotent: it inserts only when contract-defined identifiers are absent and does not overwrite or delete existing records.\",\n  \"Tests use isolated databases and provision their own fixtures rather than relying on demo seed rows, except for seed-specific acceptance checks.\",\n  \"The drafts contain different sample-row count interpretations; these are retained as separate requirements rather than resolved by an assumption.\"\n ],\n \"critic\": [],\n \"lint\": [\n  {\n   \"check\": \"L1 ids\",\n   \"details\": \"ok\",\n   \"passed\": true\n  },\n  {\n   \"check\": \"L2 req-ac\",\n   \"details\": \"ok\",\n   \"passed\": true\n  },\n  {\n   \"check\": \"L3 ears\",\n   \"details\": \"ok\",\n   \"passed\": true\n  },\n  {\n   \"check\": \"L4 vague\",\n   \"details\": \"ok\",\n   \"passed\": true\n  },\n  {\n   \"check\": \"L5 nfr\",\n   \"details\": \"ok\",\n   \"passed\": true\n  },\n  {\n   \"check\": \"L6 scope\",\n   \"details\": \"ok\",\n   \"passed\": true\n  },\n  {\n   \"check\": \"L8 anchors\",\n   \"details\": \"ok\",\n   \"passed\": true\n  },\n  {\n   \"check\": \"L9 size\",\n   \"details\": \"This spec has 14 requirements, about 2 runs' worth of work for a feature; approve it as one run or reject with which part to cut.\",\n   \"passed\": false\n  },\n  {\n   \"check\": \"L10 trace\",\n   \"details\": \"ok\",\n   \"passed\": true\n  },\n  {\n   \"check\": \"L11 observable\",\n   \"details\": \"ok\",\n   \"passed\": true\n  },\n  {\n   \"check\": \"L12 literals\",\n   \"details\": \"ok\",\n   \"passed\": true\n  }\n ],\n \"nfrs\": [],\n \"outOfScope\": [\n  \"Physical camera/LPR acquisition and physical indicator-light actuation; the API accepts detection requests and returns verification decisions only.\",\n  \"Push and SMS notification delivery beyond behavior expressly defined by the API contract.\",\n  \"Automated scheduled weekly or Monday report-email delivery and custom report-builder functionality; contract-defined reporting operations remain in scope.\",\n  \"External corporate-directory synchronization; employee profile, assignment, and directory-source records are maintained in PostgreSQL.\",\n  \"Email/password sign-in and reset-link flows, superseded by the locked OpenAPI contract's Google identity token and OAuth2 security.\"\n ],\n \"requirements\": [\n  {\n   \"acceptance\": [\n    {\n     \"given\": \"A valid Google identity token identifies an allowed Folio3 Google Workspace employee, and the session-creation operation has no bearer-token requirement.\",\n     \"id\": \"AC-1.1\",\n     \"level\": \"api\",\n     \"then\": \"The response status is 201 and the returned session contains the contract-required access token, token type, expiry, employee identity, corporate email, and administrator flag.\",\n     \"when\": \"The client sends the token as `googleIdentityToken` to `POST /auth/sessions`.\"\n    },\n    {\n     \"given\": \"A session request is malformed or has a missing token, or the identity token is invalid or unauthorized.\",\n     \"id\": \"AC-1.2\",\n     \"level\": \"api\",\n     \"then\": \"The response status is 400 for malformed or missing input, or 401 for an invalid or unauthorized identity, and the response body conforms to the contract `ApiError` schema for the applicable error.\",\n     \"when\": \"The client sends the request to `POST /auth/sessions`.\"\n    },\n    {\n     \"given\": \"An employee has a valid authenticated session and profile and vehicle records.\",\n     \"id\": \"AC-1.3\",\n     \"level\": \"api\",\n     \"then\": \"The response status is 200 and the returned profile conforms to `EmployeeProfile`, identifies the authenticated employee, and includes the contract-defined employee fields, assigned parking status, assigned floor, and vehicles; an unauthenticated request has response status 401 and an authenticated identity without permission has response status 403.\",\n     \"when\": \"The employee requests `GET /me/profile`.\"\n    },\n    {\n     \"given\": \"An employee has a valid authenticated session and registered vehicles.\",\n     \"id\": \"AC-1.4\",\n     \"level\": \"api\",\n     \"then\": \"The response status is 200 and the returned `vehicles` list conforms to `VehicleList` and contains only that employee's vehicles; a request without authentication has response status 401.\",\n     \"when\": \"The employee requests `GET /me/vehicles`.\"\n    },\n    {\n     \"given\": \"An employee has a valid authenticated session and submits a vehicle-registration request with a plate and optional vehicle details.\",\n     \"id\": \"AC-1.5\",\n     \"level\": \"api\",\n     \"then\": \"The response status is 201 and the returned vehicle conforms to `Vehicle`, contains the submitted fields, and has status `Active`; invalid input has response status 400, missing authentication has response status 401, and a conflicting registration has response status 409, with each error response conforming to the contract `ApiError` schema.\",\n     \"when\": \"The employee sends the request to `POST /me/vehicles`.\"\n    }\n   ],\n   \"anchors\": [\n    {\n     \"lineEnd\": 31,\n     \"lineStart\": 28,\n     \"path\": \"App.Api/Program.cs\",\n     \"quote\": \"app.MapGet(\\\"/\\\", () => \\\"API is up\\\").ExcludeFromDescription();\\n// The API's own document (/openapi/v1.json) and a page to read and try it (/swagger). Keep both: the factory's product page links to the page.\\napp.MapOpenApi();\\napp.UseSwaggerUI(o => o.SwaggerEndpoint(\\\"/openapi/v1.json\\\", \\\"API\\\"));\"\n    },\n    {\n     \"lineEnd\": 15,\n     \"lineStart\": 8,\n     \"path\": \"contracts/openapi.yaml\",\n     \"quote\": \"security:\\n  - oauth2:\\n      - parking:access\\npaths:\\n  /auth/sessions:\\n    post:\\n      operationId: createSession\\n      summary: Create a session from a Folio3 Google Workspace identity\"\n    }\n   ],\n   \"ears\": \"The Folio3 Parking API shall implement `POST /auth/sessions`, `GET /me/profile`, and `GET` and `POST /me/vehicles` with the request schemas, response schemas, security, and status behavior declared in the locked OpenAPI contract.\",\n   \"id\": \"REQ-1\",\n   \"op\": \"MODIFIED\",\n   \"sources\": [\n    \"I-1\",\n    \"I-5\"\n   ],\n   \"stability\": 1\n  },\n  {\n   \"acceptance\": [\n    {\n     \"given\": \"An authenticated employee requests the office configuration and the office has its contract-example initial configuration.\",\n     \"id\": \"AC-2.1\",\n     \"level\": \"api\",\n     \"then\": \"The response status is 200 and the response body conforms to `ParkingConfig`, with `officeTimezone` `Asia/Karachi`, `releaseTime` `08:00`, `schedulingWindowDays` 30, working days, and the holiday setting; a request without authentication has response status 401.\",\n     \"when\": \"The employee requests `GET /parking/config`.\"\n    },\n    {\n     \"given\": \"An employee has a valid authenticated session and parking data for the current office-local date.\",\n     \"id\": \"AC-2.2\",\n     \"level\": \"api\",\n     \"then\": \"The response status is 200 and the response body conforms to `ParkingHome` and contains the office-local date and timezone, employee assignment and parking status, space status, release time, availability count, and contract-required vehicle and working-day fields; a request without authentication has response status 401.\",\n     \"when\": \"The employee requests `GET /parking/today`.\"\n    }\n   ],\n   \"anchors\": [\n    {\n     \"lineEnd\": 31,\n     \"lineStart\": 28,\n     \"path\": \"App.Api/Program.cs\",\n     \"quote\": \"app.MapGet(\\\"/\\\", () => \\\"API is up\\\").ExcludeFromDescription();\\n// The API's own document (/openapi/v1.json) and a page to read and try it (/swagger). Keep both: the factory's product page links to the page.\\napp.MapOpenApi();\\napp.UseSwaggerUI(o => o.SwaggerEndpoint(\\\"/openapi/v1.json\\\", \\\"API\\\"));\"\n    }\n   ],\n   \"ears\": \"The Folio3 Parking API shall implement `GET /parking/config` and `GET /parking/today` using the configured office-local date and time and contract-defined response schemas; initial office configuration uses `Asia/Karachi`, release time `08:00`, and a 30-day scheduling window.\",\n   \"id\": \"REQ-2\",\n   \"op\": \"MODIFIED\",\n   \"sources\": [\n    \"I-1\",\n    \"ASM-7\",\n    \"ASM-8\"\n   ],\n   \"stability\": 1\n  },\n  {\n   \"acceptance\": [\n    {\n     \"given\": \"An authenticated dedicated parking holder has a reserved space today that has not already been released or claimed.\",\n     \"id\": \"AC-3.1\",\n     \"level\": \"api\",\n     \"then\": \"The response status is 201 and the returned release identifies the office date, `Released` status, floor, space code, and `claimableAt`; before release time `claimableAt` is the configured office-local release time, and after release time it makes the space immediately available.\",\n     \"when\": \"The holder sends `POST /parking/releases/today` before or after the configured release time.\"\n    },\n    {\n     \"given\": \"A non-holder attempts a dedicated-holder release, or a holder attempts a release that conflicts with the current parking state.\",\n     \"id\": \"AC-3.2\",\n     \"level\": \"api\",\n     \"then\": \"The response status is 403 for an ineligible employee or 409 for a conflicting state, and the response body conforms to the contract `ApiError` schema.\",\n     \"when\": \"The employee sends `POST /parking/releases/today`.\"\n    },\n    {\n     \"given\": \"An authenticated dedicated holder has saved releases and supplies optional `from` and `through` date filters where applicable.\",\n     \"id\": \"AC-3.3\",\n     \"level\": \"api\",\n     \"then\": \"The response status is 200 and the returned releases list conforms to `ParkingReleaseList` and contains only matching saved releases in office-local dates; a request without authentication has response status 401 and a non-holder receives response status 403.\",\n     \"when\": \"The holder requests `GET /parking/releases`.\"\n    },\n    {\n     \"given\": \"An authenticated dedicated holder submits one or more valid dates within the configured scheduling window.\",\n     \"id\": \"AC-3.4\",\n     \"level\": \"api\",\n     \"then\": \"The response status is 201 and the returned releases list contains one record for each accepted date with its release identifier, status, floor, space code, and `claimableAt` based on the configured office-local release time; invalid input has response status 400, a request without authentication has response status 401, a non-holder receives response status 403, and a conflicting release has response status 409.\",\n     \"when\": \"The holder sends those dates to `POST /parking/releases`.\"\n    },\n    {\n     \"given\": \"An authenticated holder owns an existing unclaimed scheduled release.\",\n     \"id\": \"AC-3.5\",\n     \"level\": \"api\",\n     \"then\": \"The response status is 200 and the returned release has status `Cancelled` and includes audit events for scheduling and cancellation; missing authentication has response status 401, a non-holder receives response status 403, an unknown identifier has response status 404, and a claimed or otherwise conflicting release has response status 409.\",\n     \"when\": \"The holder sends `DELETE /parking/releases/{releaseId}`.\"\n    },\n    {\n     \"given\": \"A dedicated holder submits a malformed date or a date outside the configured scheduling window.\",\n     \"id\": \"AC-3.6\",\n     \"level\": \"api\",\n     \"then\": \"The response status is the contract-declared 400 for invalid input or 409 for the applicable state conflict, and the response body conforms to the contract `ApiError` schema.\",\n     \"when\": \"The holder sends the date to `POST /parking/releases`.\"\n    }\n   ],\n   \"anchors\": [\n    {\n     \"lineEnd\": 31,\n     \"lineStart\": 28,\n     \"path\": \"App.Api/Program.cs\",\n     \"quote\": \"app.MapGet(\\\"/\\\", () => \\\"API is up\\\").ExcludeFromDescription();\\n// The API's own document (/openapi/v1.json) and a page to read and try it (/swagger). Keep both: the factory's product page links to the page.\\napp.MapOpenApi();\\napp.UseSwaggerUI(o => o.SwaggerEndpoint(\\\"/openapi/v1.json\\\", \\\"API\\\"));\"\n    }\n   ],\n   \"ears\": \"The Folio3 Parking API shall implement `POST /parking/releases/today`, `GET` and `POST /parking/releases`, and `DELETE /parking/releases/{releaseId}` with contract-defined release eligibility, scheduling, filtering, cancellation, audit, and conflict behavior, calculated using the configured office-local timezone and release time.\",\n   \"id\": \"REQ-3\",\n   \"op\": \"MODIFIED\",\n   \"sources\": [\n    \"I-1\",\n    \"ASM-3\",\n    \"ASM-7\",\n    \"ASM-8\"\n   ],\n   \"stability\": 1\n  },\n  {\n   \"acceptance\": [\n    {\n     \"given\": \"An authenticated employee requests availability while released spaces are claimable.\",\n     \"id\": \"AC-4.1\",\n     \"level\": \"api\",\n     \"then\": \"The response status is 200, the response body conforms to `ParkingAvailability`, and its `availableSpaceCount` equals the number of records in its spaces list, each with the contract-defined identifier, floor, and code; a request without authentication has response status 401.\",\n     \"when\": \"The employee requests `GET /parking/availability`.\"\n    },\n    {\n     \"given\": \"An authenticated non-dedicated employee has a valid active registered vehicle and at least one claimable space.\",\n     \"id\": \"AC-4.2\",\n     \"level\": \"api\",\n     \"then\": \"The response status is 201 and the returned claim conforms to `ParkingClaim` and identifies an active claim, allocated floor and space code, vehicle, authorized plate, entry status, floor capacities, and the contract allocation rule; invalid input has response status 400, a request without authentication has response status 401, an ineligible employee receives response status 403, and a conflicting or unavailable allocation has response status 409.\",\n     \"when\": \"The employee sends the vehicle ID to `POST /parking/claims`.\"\n    },\n    {\n     \"given\": \"Two eligible employees request the last available space and one request is accepted first by the API.\",\n     \"id\": \"AC-4.3\",\n     \"level\": \"api\",\n     \"then\": \"The accepted response has status 201 and a returned active claim for the space, the other response has status 409, and the database contains exactly one active claim for that space.\",\n     \"when\": \"Both employees submit valid `POST /parking/claims` requests concurrently.\"\n    },\n    {\n     \"given\": \"An authenticated employee has a temporary claim for today, or has no temporary claim for today.\",\n     \"id\": \"AC-4.4\",\n     \"level\": \"api\",\n     \"then\": \"For a claim, the response status is 200 and the returned claim conforms to `ParkingClaim` and contains its assigned space, vehicle, authorized plate, and entry status; with no claim, the response status is 404 and the response error code is `not_found`; a request without authentication has response status 401.\",\n     \"when\": \"The employee requests `GET /parking/claims/today`.\"\n    },\n    {\n     \"given\": \"An authenticated employee requests cancellation of an existing active temporary claim.\",\n     \"id\": \"AC-4.5\",\n     \"level\": \"api\",\n     \"then\": \"The response status is 409 and the returned claim remains `Active`; missing authentication has response status 401, an identity without permission receives response status 403, and an unknown claim has response status 404.\",\n     \"when\": \"The employee sends `POST /parking/claims/{claimId}/cancel`.\"\n    },\n    {\n     \"given\": \"A dedicated holder requests a non-dedicated claim operation, or a non-dedicated employee requests a dedicated-holder release operation.\",\n     \"id\": \"AC-4.6\",\n     \"level\": \"api\",\n     \"then\": \"The response status is 403 and the response body conforms to the contract `ApiError` schema.\",\n     \"when\": \"The API receives the relevant claim or release request.\"\n    }\n   ],\n   \"anchors\": [\n    {\n     \"lineEnd\": 31,\n     \"lineStart\": 28,\n     \"path\": \"App.Api/Program.cs\",\n     \"quote\": \"app.MapGet(\\\"/\\\", () => \\\"API is up\\\").ExcludeFromDescription();\\n// The API's own document (/openapi/v1.json) and a page to read and try it (/swagger). Keep both: the factory's product page links to the page.\\napp.MapOpenApi();\\napp.UseSwaggerUI(o => o.SwaggerEndpoint(\\\"/openapi/v1.json\\\", \\\"API\\\"));\"\n    }\n   ],\n   \"ears\": \"The Folio3 Parking API shall implement `GET /parking/availability`, `POST /parking/claims`, `GET /parking/claims/today`, and `POST /parking/claims/{claimId}/cancel` with contract-defined eligibility, allocation, concurrency, response, and cancellation behavior.\",\n   \"id\": \"REQ-4\",\n   \"op\": \"MODIFIED\",\n   \"sources\": [\n    \"I-1\",\n    \"ASM-3\",\n    \"ASM-7\",\n    \"ASM-8\"\n   ],\n   \"stability\": 1\n  },\n  {\n   \"acceptance\": [\n    {\n     \"given\": \"An authenticated parking administrator has employee roster records.\",\n     \"id\": \"AC-5.1\",\n     \"level\": \"api\",\n     \"then\": \"The response status is 200 and the returned page conforms to `RosterPage`, contains matching employee records with contract-defined fields, and reports page and page-count fields; a request without authentication has response status 401 and a non-administrator receives response status 403.\",\n     \"when\": \"The administrator requests `GET /admin/roster` with optional search, assignment, page, and page-size parameters.\"\n    },\n    {\n     \"given\": \"An authenticated parking administrator has recorded entrance checks.\",\n     \"id\": \"AC-5.2\",\n     \"level\": \"api\",\n     \"then\": \"The response status is 200 and the returned checks conform to `EntryCheckPage`, match the supplied filters, and contain the contract-defined verification date and time, plate, result, entry status, and detail; a request without authentication has response status 401 and a non-administrator receives response status 403.\",\n     \"when\": \"The administrator requests `GET /admin/entry-checks` with optional search, result, and page parameters.\"\n    },\n    {\n     \"given\": \"An authenticated parking administrator has retained parking activity.\",\n     \"id\": \"AC-5.3\",\n     \"level\": \"api\",\n     \"then\": \"The response status is 200 and the returned events conform to `ActivityPage`, match the supplied filters and pagination, and contain the contract-defined office time, employee name, event, space or plate, and outcome; a request without authentication has response status 401 and a non-administrator receives response status 403.\",\n     \"when\": \"The administrator requests `GET /admin/activity` with optional search, event type, and page parameters.\"\n    },\n    {\n     \"given\": \"An authenticated standard employee requests an administrator-only list operation.\",\n     \"id\": \"AC-5.4\",\n     \"level\": \"api\",\n     \"then\": \"The response status is 403 and the response error code is `forbidden`.\",\n     \"when\": \"The employee requests any of the roster, entry-check, or activity list routes.\"\n    }\n   ],\n   \"anchors\": [\n    {\n     \"lineEnd\": 31,\n     \"lineStart\": 28,\n     \"path\": \"App.Api/Program.cs\",\n     \"quote\": \"app.MapGet(\\\"/\\\", () => \\\"API is up\\\").ExcludeFromDescription();\\n// The API's own document (/openapi/v1.json) and a page to read and try it (/swagger). Keep both: the factory's product page links to the page.\\napp.MapOpenApi();\\napp.UseSwaggerUI(o => o.SwaggerEndpoint(\\\"/openapi/v1.json\\\", \\\"API\\\"));\"\n    }\n   ],\n   \"ears\": \"The Folio3 Parking API shall implement the administrator list operations `GET /admin/roster`, `GET /admin/entry-checks`, and `GET /admin/activity` with their contract-defined query filters, pagination, response schemas, and administrator authorization.\",\n   \"id\": \"REQ-5\",\n   \"op\": \"MODIFIED\",\n   \"sources\": [\n    \"I-1\",\n    \"ASM-3\"\n   ],\n   \"stability\": 1\n  },\n  {\n   \"acceptance\": [\n    {\n     \"given\": \"An authenticated parking administrator requests a week for which parking and entrance records are available.\",\n     \"id\": \"AC-6.1\",\n     \"level\": \"api\",\n     \"then\": \"The response status is 200 and the returned report conforms to `UtilizationReport` and contains the requested week dates, generation time, office timezone, released-space and temporary-claim counts, utilization percentage, daily statistics, and unused dedicated and temporary parking lists; an invalid date has response status 400, a request without authentication has response status 401, and a non-administrator receives response status 403.\",\n     \"when\": \"The administrator requests `GET /admin/utilization` with an optional `weekStart`.\"\n    },\n    {\n     \"given\": \"A dedicated holder did not release a space and has no registered-vehicle entry record for a date, and a temporary claimant has no registered-vehicle entry record for a date.\",\n     \"id\": \"AC-6.2\",\n     \"level\": \"api\",\n     \"then\": \"The response status is 200 and the returned report lists contain the corresponding `Unused Dedicated Parking` and `Unused Temporary Parking` events with employee, vehicle plate, and office-local date.\",\n     \"when\": \"An administrator requests the corresponding week through `GET /admin/utilization`.\"\n    },\n    {\n     \"given\": \"An authenticated standard employee requests a utilization report.\",\n     \"id\": \"AC-6.3\",\n     \"level\": \"api\",\n     \"then\": \"The response status is 403 and the response error code is `forbidden`.\",\n     \"when\": \"The employee requests `GET /admin/utilization`.\"\n    }\n   ],\n   \"anchors\": [\n    {\n     \"lineEnd\": 31,\n     \"lineStart\": 28,\n     \"path\": \"App.Api/Program.cs\",\n     \"quote\": \"app.MapGet(\\\"/\\\", () => \\\"API is up\\\").ExcludeFromDescription();\\n// The API's own document (/openapi/v1.json) and a page to read and try it (/swagger). Keep both: the factory's product page links to the page.\\napp.MapOpenApi();\\napp.UseSwaggerUI(o => o.SwaggerEndpoint(\\\"/openapi/v1.json\\\", \\\"API\\\"));\"\n    }\n   ],\n   \"ears\": \"The Folio3 Parking API shall implement `GET /admin/utilization` to return contract-defined office-local weekly statistics and unused dedicated and temporary parking records derived from retained parking and entrance data, with administrator authorization.\",\n   \"id\": \"REQ-6\",\n   \"op\": \"MODIFIED\",\n   \"sources\": [\n    \"I-1\",\n    \"ASM-6\",\n    \"ASM-8\",\n    \"ASM-3\"\n   ],\n   \"stability\": 1\n  },\n  {\n   \"acceptance\": [\n    {\n     \"given\": \"An authenticated parking administrator has office settings stored in the application database.\",\n     \"id\": \"AC-7.1\",\n     \"level\": \"api\",\n     \"then\": \"The response status is 200 and the returned `OfficeSettings` contains office timezone, release time, scheduling-window days, report recipients, report schedule, and next delivery; a request without authentication has response status 401 and a non-administrator receives response status 403.\",\n     \"when\": \"The administrator requests `GET /admin/settings`.\"\n    },\n    {\n     \"given\": \"An authenticated parking administrator submits valid office timezone, release time, and report-recipient values.\",\n     \"id\": \"AC-7.2\",\n     \"level\": \"api\",\n     \"then\": \"Both response statuses are 200 and the returned settings preserve the submitted timezone, release time, and recipient values and include the contract-defined schedule fields; invalid values have response status 400, a request without authentication has response status 401, and a non-administrator receives response status 403.\",\n     \"when\": \"The administrator sends the values to `PUT /admin/settings` and then reads `GET /admin/settings`.\"\n    },\n    {\n     \"given\": \"An authenticated standard employee submits or reads office settings.\",\n     \"id\": \"AC-7.3\",\n     \"level\": \"api\",\n     \"then\": \"The response status is 403 and the response error code is `forbidden`.\",\n     \"when\": \"The employee calls `PUT` or `GET /admin/settings`.\"\n    }\n   ],\n   \"anchors\": [\n    {\n     \"lineEnd\": 31,\n     \"lineStart\": 28,\n     \"path\": \"App.Api/Program.cs\",\n     \"quote\": \"app.MapGet(\\\"/\\\", () => \\\"API is up\\\").ExcludeFromDescription();\\n// The API's own document (/openapi/v1.json) and a page to read and try it (/swagger). Keep both: the factory's product page links to the page.\\napp.MapOpenApi();\\napp.UseSwaggerUI(o => o.SwaggerEndpoint(\\\"/openapi/v1.json\\\", \\\"API\\\"));\"\n    }\n   ],\n   \"ears\": \"The Folio3 Parking API shall implement `GET` and `PUT /admin/settings` to read and update administrator-managed office timezone, release time, and report recipients and to return contract-defined schedule fields.\",\n   \"id\": \"REQ-7\",\n   \"op\": \"MODIFIED\",\n   \"sources\": [\n    \"I-1\",\n    \"ASM-3\",\n    \"ASM-7\",\n    \"ASM-8\"\n   ],\n   \"stability\": 1\n  },\n  {\n   \"acceptance\": [\n    {\n     \"given\": \"An authorized integration request describes a car whose plate has an active temporary parking authorization for the office date.\",\n     \"id\": \"AC-8.1\",\n     \"level\": \"api\",\n     \"then\": \"The response status is 200 and the returned `EntranceVerification` identifies the plate as authorized, includes office date and time and contract-defined entry status, and sets `greenActivationRequested` to true.\",\n     \"when\": \"The integration sends the detection to `POST /integrations/entrance/detections`.\"\n    },\n    {\n     \"given\": \"An authorized integration request describes a car without a valid temporary allocation, a pedestrian, motorcycle, or other non-car object, or a vehicle with a permanent parking sticker.\",\n     \"id\": \"AC-8.2\",\n     \"level\": \"api\",\n     \"then\": \"The response status is 200 and the returned verification denies an unauthorized car, marks a non-car object as not applicable, or identifies a permanent sticker with entry status `Not blocked`; `greenActivationRequested` is false for each of these cases.\",\n     \"when\": \"The integration sends the detection to `POST /integrations/entrance/detections`.\"\n    },\n    {\n     \"given\": \"A detection request has valid `detectedObjectType` and `detectedAt` fields and, where applicable, a plate or failure reason.\",\n     \"id\": \"AC-8.3\",\n     \"level\": \"api\",\n     \"then\": \"The response status is 200 and the response body contains the verification identifier, office date and time, plate, verification, entry status, `greenActivationRequested`, and detail; invalid input has response status 400.\",\n     \"when\": \"The integration sends the request to `POST /integrations/entrance/detections`.\"\n    },\n    {\n     \"given\": \"A detection contains a failure reason or the verification service is unavailable.\",\n     \"id\": \"AC-8.4\",\n     \"level\": \"api\",\n     \"then\": \"The returned verification is fail-closed and requests no green activation; a verification-service outage has response status 503 and the response body conforms to `ApiError` with error code `service_unavailable`.\",\n     \"when\": \"The integration sends the detection to `POST /integrations/entrance/detections`.\"\n    },\n    {\n     \"given\": \"An integration client submits a successful or unsuccessful detection.\",\n     \"id\": \"AC-8.5\",\n     \"level\": \"api\",\n     \"then\": \"A corresponding database row records the office date and time, plate when present, verification result, and entry status.\",\n     \"when\": \"The API processes the detection request.\"\n    },\n    {\n     \"given\": \"An integration request lacks the required access token.\",\n     \"id\": \"AC-8.6\",\n     \"level\": \"api\",\n     \"then\": \"The response status is 401 and the response body conforms to `ApiError`.\",\n     \"when\": \"The API receives the detection request.\"\n    }\n   ],\n   \"anchors\": [\n    {\n     \"lineEnd\": 31,\n     \"lineStart\": 28,\n     \"path\": \"App.Api/Program.cs\",\n     \"quote\": \"app.MapGet(\\\"/\\\", () => \\\"API is up\\\").ExcludeFromDescription();\\n// The API's own document (/openapi/v1.json) and a page to read and try it (/swagger). Keep both: the factory's product page links to the page.\\napp.MapO