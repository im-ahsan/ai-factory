-3168\n                make: Suzuki\n                model: Swift\n                color: Blue\n                status: Active\n        '400':\n          $ref: '#/components/responses/BadRequest'\n        '401':\n          $ref: '#/components/responses/Unauthorized'\n        '409':\n          $ref: '#/components/responses/Conflict'\n  /parking/config:\n    get:\n      operationId: getParkingConfig\n      summary: Get office-local parking timing and working-day configuration\n      responses:\n        '200':\n          description: Current office parking configuration\n          content:\n            application/json:\n              schema:\n                $ref: '#/components/schemas/ParkingConfig'\n              example:\n                officeTimezone: Asia/Karachi\n                releaseTime: \"08:00\"\n                schedulingWindowDays: 30\n                workingDays:\n                  - Monday\n                  - Tuesday\n                  - Wednesday\n                  - Thursday\n                  - Friday\n                holidaysAreWorkingDays: true\n        '401':\n          $ref: '#/components/responses/Unauthorized'\n  /parking/today:\n    get:\n      operationId: getParkingHome\n      summary: Get the signed-in employee's parking home data\n      responses:\n        '200':\n          description: Today's assignment, vehicle, release timing, and availability\n          content:\n            application/json:\n              schema:\n                $ref: '#/components/schemas/ParkingHome'\n              example:\n                officeDate: \"2026-06-16\"\n                officeTimezone: Asia/Karachi\n                assignedParkingStatus: Dedicated\n                assignedFloor: B2\n                spaceCode: \"114\"\n                spaceStatus: Reserved\n                releaseTime: \"08:00\"\n                availableSpaceCount: 3\n                vehicle:\n                  vehicleId: 501\n                  plate: KLG-4821\n                  