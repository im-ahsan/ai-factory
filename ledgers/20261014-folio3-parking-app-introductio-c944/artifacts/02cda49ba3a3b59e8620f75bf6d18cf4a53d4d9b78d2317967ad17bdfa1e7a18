ons` (the contract also declares global OAuth security).\"\n  },\n  {\n   \"anchors\": [\n    {\n     \"lineEnd\": 9,\n     \"lineStart\": 8,\n     \"path\": \"App.Api/Program.cs\",\n     \"quote\": \"builder.Services.AddDbContext<AppDb>(o => o.UseNpgsql(builder.Configuration.GetConnectionString(\\\"App\\\")\\n    ?? throw new InvalidOperationException(\\\"No database connection is configured. Set ConnectionStrings__App (for example Host=...;Port=5432;Database=...;Username=...;Password=«SECRET_1»\")));\",\n     \"symbol\": \"Program\"\n    },\n    {\n     \"lineEnd\": 22,\n     \"lineStart\": 20,\n     \"path\": \"App.Api/Program.cs\",\n     \"quote\": \"using var scope = app.Services.CreateScope();\\n        var db = scope.ServiceProvider.GetRequiredService<AppDb>();\\n        db.Database.EnsureCreated();\",\n     \"symbol\": \"Program\"\n    },\n    {\n     \"lineEnd\": 7,\n     \"lineStart\": 5,\n     \"path\": \"App.Api/AppDb.cs\",\n     \"quote\": \"public class AppDb(DbContextOptions<AppDb> options) : DbContext(options)\\n{\\n}\",\n     \"symbol\": \"AppDb\"\n    }\n   ],\n   \"id\": \"C-I2\",\n   \"spans\": [\n    \"I-2\"\n   ],\n   \"text\": \"The API configures `AppDb` with PostgreSQL using the `ConnectionStrings:App` value and fails startup setup if it is absent. On startup, it calls `EnsureCreated()`. `AppDb` currently declares no entity sets or model configuration, so this is only an empty context rather than a defined parking-data schema.\"\n  },\n  {\n   \"anchors\": [\n    {\n     \"lineEnd\": 9,\n     \"lineStart\": 7,\n     \"path\": \"App.Api/SeedData.cs\",\n     \"quote\": \"public static void Run(AppDb db)\\n    {\\n    }\",\n     \"symbol\": \"SeedData.Run\"\n    },\n    {\n     \"lineEnd\": 7,\n     \"lineStart\": 5,\n     \"path\": \"App.Api/AppDb.cs\",\n     \"quote\": \"public class AppDb(DbContextOptions<AppDb> options) : DbContext(options)\\n{\\n}\",\n     \"symbol\": \"AppDb\"\n    }\n   ],\n   \"id\": \"C-I3\",\n   \"spans\": [\n    \"I-