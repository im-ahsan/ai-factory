{"ts":1791964887994,"kind":"call","tool":"Bash","input":"{\"command\":\"cat contracts/openapi.yaml\"}","output":"openapi: 3.0.3\ninfo:\n  title: Folio3 Parking API\n  version: 1.0.0\n  description: \"Shared contract for the responsive Folio3 Parking web app and its API.\"\nservers:\n  - url: https://parking-api.folio3.com\nsecurity:\n  - oauth2:\n      - parking:access\npaths:\n  /auth/sessions:\n    post:\n      operationId: createSession\n      summary: Create a session from a Folio3 Google Workspace identity\n      security: []\n      requestBody:\n        required: true\n        content:\n          application/json:\n            schema:\n              $ref: '#/components/schemas/SessionRequest'\n      responses:\n        '201':\n          description: Session created for an allowed Folio3 identity\n          content:\n            application/json:\n              schema:\n                $ref: '#/components/schemas/Session'\n              example:\n                accessToken: \"eyJhbGciOi...folio3\"\n                tokenType: Bearer\n                expiresAt: \"2026-06-16T17:00:00+05:00\"\n                employeeId: 101\n                employeeName: Aisha Rahman\n                corporateEmail: aisha.rahman@folio3.com\n                isParkingAdmin: false\n        '400':\n          $ref: '#/components/responses/BadRequest'\n        '401':\n          $ref: '#/components/responses/Unauthorized'\n  /me/profile:\n    get:\n      operationId: getMyProfile\n      summary: Get the signed-in employee profile\n      responses:\n        '200':\n          description: The profile belonging to the authenticated identity\n          content:\n            application/json:\n              schema:\n                $ref: '#/components/schemas/EmployeeProfile'\n              example:\n                employeeId: 101\n                employeeName: Aisha Rahman\n                corporateEmail: aisha.rahman@folio3.com\n                assignedParkingStatus: Dedicated\n          