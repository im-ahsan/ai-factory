{"ts":1791965478872,"kind":"call","tool":"Bash","input":"{\"command\":\"cat contracts/openapi.yaml\"}","output":"openapi: 3.0.3\ninfo:\n  title: Folio3 Parking API\n  version: 1.0.0\n  description: \"Shared contract for the responsive Folio3 Parking web app and its API.\"\nservers:\n  - url: https://parking-api.folio3.com\nsecurity:\n  - oauth2:\n      - parking:access\npaths:\n  /auth/sessions:\n    post:\n      operationId: createSession\n      summary: Create a session from a Folio3 Google Workspace identity\n      security: []\n      requestBody:\n        required: true\n        content:\n          application/json:\n            schema:\n              $ref: '#/components/schemas/SessionRequest'\n      responses:\n        '201':\n          description: Session created for an allowed Folio3 identity\n          content:\n            application/json:\n              schema:\n                $ref: '#/components/schemas/Session'\n              example:\n                accessToken: \"eyJhbGciOi...folio3\"\n                tokenType: Bearer\n                expiresAt: \"2026-06-16T17:00:00+05:00\"\n                employeeId: 101\n                employeeName: Aisha Rahman\n                corporateEmail: aisha.rahman@folio3.com\n                isParkingAdmin: false\n        '400':\n          $ref: '#/components/responses/BadRequest'\n        '401':\n          $ref: '#/components/responses/Unauthorized'\n  /me/profile:\n    get:\n      operationId: getMyProfile\n      summary: Get the signed-in employee profile\n      responses:\n        '200':\n          description: The profile belonging to the authenticated identity\n          content:\n            application/json:\n              schema:\n                $ref: '#/components/schemas/EmployeeProfile'\n              example:\n                employeeId: 101\n                employeeName: Aisha Rahman\n                corporateEmail: aisha.rahman@folio3.com\n                assignedParkingStatus: Dedicated\n                assignedFloor: B2\n                vehicles:\n                  - vehicleId: 501\n                    plate: KLG-4821\n                    make: Honda\n                    model: Civic\n                    color: White\n                    status: Active\n        '401':\n          $ref: '#/components/responses/Unauthorized'\n        '403':\n          $ref: '#/components/responses/Forbidden'\n  /me/vehicles:\n    get:\n      operationId: listMyVehicles\n      summary: List the signed-in employee's registered vehicles\n      responses:\n        '200':\n          description: Registered vehicles for the signed-in employee\n          content:\n            application/json:\n              schema:\n                $ref: '#/components/schemas/VehicleList'\n              example:\n                vehicles:\n                  - vehicleId: 501\n                    plate: KLG-4821\n                    make: Toyota\n                    model: Corolla\n                    color: Silver\n                    status: Active\n                  - vehicleId: 502\n                    plate: LEA-9073\n                    make: Honda\n                    model: City\n                    color: White\n                    status: Active\n        '401':\n          $ref: '#/components/responses/Unauthorized'\n    post:\n      operationId: registerMyVehicle\n      summary: Register and immediately activate a vehicle plate\n      requestBody:\n        required: true\n        content:\n          application/json:\n            schema:\n              $ref: '#/components/schemas/RegisterVehicleRequest'\n      responses:\n        '201':\n          description: Vehicle registered and active\n          content:\n            application/json:\n              schema:\n                $ref: '#/components/schemas/Vehicle'\n              example:\n                vehicleId: 503\n                plate: RWP-3168\n                make: Suzuki\n                model: Swift\n                color: Blue\n                status: Active\n        '400':\n          $ref: '#/components/responses/BadRequest'\n        '401':\n          $ref: '#/components/responses/Unauthorized'\n        '409':\n          $ref: '#/components/responses/Conflict'\n  /parking/config:\n    get:\n      operationId: getParkingConfig\n      summary: Get office-local parking timing and working-day configuration\n      responses:\n        '200':\n          description: Current office parking configuration\n          content:\n            application/json:\n              schema:\n                $ref: '#/components/schemas/ParkingConfig'\n              example:\n                officeTimezone: Asia/Karachi\n                releaseTime: \"08:00\"\n                schedulingWindowDays: 30\n                workingDays:\n                  - Monday\n                  - Tuesday\n                  - Wednesday\n                  - Thursday\n                  - Friday\n                holidaysAreWorkingDays: true\n        '401':\n          $ref: '#/components/responses/Unauthorized'\n  /parking/today:\n    get:\n      operationId: getParkingHome\n      summary: Get the signed-in employee's parking home data\n      responses:\n        '200':\n          description: Today's assignment, vehicle, release timing, and availability\n          content:\n            application/json:\n              schema:\n                $ref: '#/components/schemas/ParkingHome'\n              example:\n                officeDate: \"2026-06-16\"\n                officeTimezone: Asia/Karachi\n                assignedParkingStatus: Dedicated\n                assignedFloor: B2\n                spaceCode: \"114\"\n                spaceStatus: Reserved\n                releaseTime: \"08:00\"\n                availableSpaceCount: 3\n                vehicle:\n                  vehicleId: 501\n                  plate: KLG-4821\n                  make: Honda\n                  model: Civic\n                  color: White\n                  status: Active\n                workingDays:\n                  - Monday\n                  - Tuesday\n                  - Wednesday\n                  - Thursday\n                  - Friday\n                holidaysAreWorkingDays: true\n        '401':\n          $ref: '#/components/responses/Unauthorized'\n  /parking/releases/today:\n    post:\n      operationId: releaseParkingToday\n      summary: Release the signed-in dedicated holder's space today\n      responses:\n        '201':\n          description: Today's release recorded\n          content:\n            application/json:\n              schema:\n                $ref: '#/components/schemas/ParkingRelease'\n              example:\n                releaseId: 7001\n                date: \"2026-06-16\"\n                status: Released\n                floor: B2\n                spaceCode: \"114\"\n                claimableAt: \"2026-06-16T08:00:00+05:00\"\n        '401':\n          $ref: '#/components/responses/Unauthorized'\n        '403':\n          $ref: '#/components/responses/Forbidden'\n        '409':\n          $ref: '#/components/responses/Conflict'\n  /parking/releases:\n    get:\n      operationId: listMyReleases\n      summary: List the signed-in holder's saved releases\n      parameters:\n        - name: from\n          in: query\n          required: false\n          schema:\n            type: string\n            format: date\n        - name: through\n          in: query\n          required: false\n          schema:\n            type: string\n            format: date\n      responses:\n        '200':\n          description: Saved release dates in office-local time\n          content:\n            application/json:\n              schema:\n                $ref: '#/components/schemas/ParkingReleaseList'\n              example:\n                releases:\n                  - releaseId: 7002\n                    date: \"2026-06-18\"\n                    status: Released\n                    floor: B2\n                    spaceCode: \"114\"\n                    claimableAt: \"2026-06-18T08:00:00+05:00\"\n                  - releaseId: 7003\n                    date: \"2026-06-22\"\n                    status: Claimed\n                    floor: B2\n                    spaceCode: \"114\"\n                    claimableAt: \"2026-06-22T08:00:00+05:00\"\n        '401':\n          $ref: '#/components/responses/Unauthorized'\n        '403':\n          $ref: '#/components/responses/Forbidden'\n    post:\n      operationId: scheduleParkingReleases\n      summary: Schedule one or more releases within the 30-day window\n      requestBody:\n        required: true\n        content:\n          application/json:\n            schema:\n              $ref: '#/components/schemas/ScheduleReleasesRequest'\n      responses:\n        '201':\n          description: Scheduled release records\n          content:\n            application/json:\n              schema:\n                $ref: '#/components/schemas/ParkingReleaseList'\n              example:\n                releases:\n                  - releaseId: 7004\n                    date: \"2026-06-25\"\n                    status: Released\n                    floor: B2\n                    spaceCode: \"114\"\n                    claimableAt: \"2026-06-25T08:00:00+05:00\"\n        '400':\n          $ref: '#/components/responses/BadRequest'\n        '401':\n          $ref: '#/components/responses/Unauthorized'\n        '403':\n          $ref: '#/components/responses/Forbidden'\n        '409':\n          $ref: '#/components/responses/Conflict'\n  /parking/releases/{releaseId}:\n    delete:\n      operationId: cancelParkingRelease\n      summary: Cancel an unclaimed scheduled release\n      parameters:\n        - name: releaseId\n          in: path\n          required: true\n          schema:\n            type: integer\n      responses:\n        '200':\n          description: Release cancellation recorded with its audit events\n          content:\n            application/json:\n              schema:\n                $ref: '#/components/schemas/ReleaseCancellation'\n              example:\n                releaseId: 7004\n                status: Cancelled\n                auditEvents:\n                  - auditEventId: 9001\n                    event: Release scheduled\n                    officeTime: \"2026-06-16T09:00:00+05:00\"\n                  - auditEventId: 9002\n                    event: Release cancelled\n                    officeTime: \"2026-06-16T09:05:00+05:00\"\n        '401':\n          $ref: '#/components/responses/Unauthorized'\n        '403':\n          $ref: '#/components/responses/Forbidden'\n        '404':\n          $ref: '#/components/responses/NotFound'\n        '409':\n          $ref: '#/components/responses/Conflict'\n  /parking/availability:\n    get:\n      operationId: getParkingAvailability\n      summary: Get currently claimable released spaces\n      responses:\n        '200':\n          description: Current office-local claimable spaces and count\n          content:\n            application/json:\n              schema:\n                $ref: '#/components/schemas/ParkingAvailability'\n              example:\n                officeDate: \"2026-06-16\"\n                officeTimezone: Asia/Karachi\n                availableSpaceCount: 3\n                spaces:\n                  - spaceId: 801\n                    floor: B1\n                    spaceCode: \"08\"\n                  - spaceId: 802\n                    floor: B2\n                    spaceCode: \"21\"\n                  - spaceId: 803\n                    floor: B3\n                    spaceCode: \"05\"\n        '401':\n          $ref: '#/components/responses/Unauthorized'\n  /parking/claims:\n    post:\n      operationId: claimParkingSpace\n      summary: Claim the next available temporary space\n      requestBody:\n        required: true\n        content:\n          application/json:\n            schema:\n              $ref: '#/components/schemas/ClaimParkingRequest'\n      responses:\n        '201':\n          description: Space allocated to the first accepted eligible claim\n          content:\n            application/json:\n              schema:\n                $ref: '#/components/schemas/ParkingClaim'\n              example:\n                claimId: 8101\n                officeDate: \"2026-06-16\"\n                status: Active\n                floor: B1\n                spaceCode: \"08\"\n                vehicle:\n                  vehicleId: 501\n                  plate: KLG-4821\n                  make: Toyota\n                  model: Corolla\n                  color: Silver\n                  status: Active\n                authorizedPlate: KLG-4821\n                entryStatus: Awaiting detection\n                floorCapacities:\n                  - floor: B1\n                    freeSpaces: 8\n                    totalSpaces: 28\n                  - floor: B2\n                    freeSpaces: 8\n                    totalSpaces: 28\n                  - floor: B3\n                    freeSpaces: 5\n                    totalSpaces: 20\n                allocationRule: \"Highest free count; ties go to lowest floor code.\"\n        '400':\n          $ref: '#/components/responses/BadRequest'\n        '401':\n          $ref: '#/components/responses/Unauthorized'\n        '403':\n          $ref: '#/components/responses/Forbidden'\n        '409':\n          $ref: '#/components/responses/Conflict'\n  /parking/claims/today:\n    get:\n      operationId: getTodaysParkingClaim\n      summary: Get the signed-in employee's temporary claim for today\n      responses:\n        '200':\n          description: Today's temporary allocation and authorized plate\n          content:\n            application/json:\n              schema:\n                $ref: '#/components/schemas/ParkingClaim'\n              example:\n                claimId: 8101\n                officeDate: \"2026-06-16\"\n                status: Active\n                floor: B1\n                spaceCode: \"08\"\n                vehicle:\n                  vehicleId: 501\n                  plate: KLG-4821\n                  make: Toyota\n                  model: Corolla\n                  color: Silver\n                  status: Active\n                authorizedPlate: KLG-4821\n                entryStatus: Awaiting detection\n                floorCapacities:\n                  - floor: B1\n                    freeSpaces: 8\n                    totalSpaces: 28\n                allocationRule: \"Highest free count; ties go to lowest floor code.\"\n        '401':\n          $ref: '#/components/responses/Unauthorized'\n        '404':\n          $ref: '#/components/responses/NotFound'\n  /parking/claims/{claimId}/cancel:\n    post:\n      operationId: cancelParkingClaim\n      summary: Reject employee cancellation of a temporary claim in Phase 1\n      parameters:\n        - name: claimId\n          in: path\n          required: true\n          schema:\n            type: integer\n      responses:\n        '409':\n          description: Employee cancellation is unavailable and claim remains active\n          content:\n            application/json:\n              schema:\n                $ref: '#/components/schemas/ParkingClaim'\n              example:\n                claimId: 8101\n                officeDate: \"2026-06-16\"\n                status: Active\n                floor: B1\n                spaceCode: \"08\"\n                vehicle:\n                  vehicleId: 501\n                  plate: KLG-4821\n                  make: Toyota\n                  model: Corolla\n                  color: Silver\n                  status: Active\n                authorizedPlate: KLG-4821\n                entryStatus: Awaiting detection\n                floorCapacities:\n                  - floor: B1\n                    freeSpaces: 8\n                    totalSpaces: 28\n                allocationRule: \"Highest free count; ties go to lowest floor code.\"\n        '401':\n          $ref: '#/components/responses/Unauthorized'\n        '403':\n          $ref: '#/components/responses/Forbidden'\n        '404':\n          $ref: '#/components/responses/NotFound'\n  /admin/roster:\n    get:\n      operationId: listEmployeeRoster\n      summary: List roster records available to the authorized administrator\n      parameters:\n        - name: search\n          in: query\n          required: false\n          schema:\n            type: string\n        - name: assignment\n          in: query\n          required: false\n          schema:\n            type: string\n            enum:\n              - All assignments\n              - Dedicated\n              - Non-dedicated\n        - name: page\n          in: query\n          required: false\n          schema:\n            type: integer\n            minimum: 1\n        - name: pageSize\n          in: query\n          required: false\n          schema:\n            type: integer\n            minimum: 1\n      responses:\n        '200':\n          description: Employee directory identity and parking roster fields\n          content:\n            application/json:\n              schema:\n                $ref: '#/components/schemas/RosterPage'\n              example:\n                page: 1\n                pages: 18\n                employees:\n                  - employeeId: 101\n                    employeeName: Aisha Rahman\n                    corporateEmail: aisha.rahman@folio3.com\n                    assignedParkingStatus: Dedicated\n                    assignedFloor: B2\n                    vehiclePlate: KLG-4821\n                    access: Employee\n                  - employeeId: 102\n                    employeeName: Bilal Ahmed\n                    corporateEmail: bilal.ahmed@folio3.com\n                    assignedParkingStatus: Non-dedicated\n                    assignedFloor: null\n                    vehiclePlate: LEA-9073\n                    access: Employee\n        '401':\n          $ref: '#/components/responses/Unauthorized'\n        '403':\n          $ref: '#/components/responses/Forbidden'\n  /admin/entry-checks:\n    get:\n      operationId: listEntryChecks\n      summary: List recorded entrance verification activity for administrators\n      parameters:\n        - name: search\n          in: query\n          required: false\n          schema:\n            type: string\n        - name: result\n          in: query\n          required: false\n          schema:\n            type: string\n            enum:\n              - All results\n              - Authorized\n              - Denied\n              - Permanent sticker\n              - Unsuccessful\n        - name: page\n          in: query\n          required: false\n          schema:\n            type: integer\n            minimum: 1\n      responses:\n        '200':\n          description: Entrance attempts, including permanent-sticker and failure records\n          content:\n            application/json:\n              schema:\n                $ref: '#/components/schemas/EntryCheckPage'\n              example:\n                page: 1\n                pages: 4\n                checks:\n                  - verificationId: 3001\n                    officeDate: \"2026-06-16\"\n                    officeTime: \"08:12\"\n                    plate: KLG-4821\n                    verification: Authorized\n                    entryStatus: Green requested\n                    detail: Active temporary allocation\n                  - verificationId: 3002\n                    officeDate: \"2026-06-16\"\n                    officeTime: \"07:54\"\n                    plate: ICT-6612\n                    verification: Permanent sticker\n                    entryStatus: Not blocked\n                    detail: Utilization recorded\n        '401':\n          $ref: '#/components/responses/Unauthorized'\n        '403':\n          $ref: '#/components/responses/Forbidden'\n  /admin/utilization:\n    get:\n      operationId: getWeeklyUtilizationReport\n      summary: Get the generated weekly utilization report\n      parameters:\n        - name: weekStart\n          in: query\n          required: false\n          schema:\n            type: string\n            format: date\n      responses:\n        '200':\n          description: Weekly report with statistics and unused parking records\n          content:\n            application/json:\n              schema:\n                $ref: '#/components/schemas/UtilizationReport'\n              example:\n                weekStart: \"2026-06-08\"\n                weekEnd: \"2026-06-12\"\n                generatedAt: \"2026-06-15T08:05:00+05:00\"\n              ... (23892 more characters not kept)","chars":43892,"exitCode":0}
{"ts":1791965484878,"kind":"call","tool":"Bash","input":"{\"command\":\"cat App.Tests/App.Tests.csproj && sed -n '1,180p' App.Tests/AcceptancePart1Tests.cs\"}","output":"<Project Sdk=\"Microsoft.NET.Sdk\">\n  <PropertyGroup>\n    <TargetFramework>net9.0</TargetFramework>\n    <Nullable>enable</Nullable>\n    <ImplicitUsings>enable</ImplicitUsings>\n    <IsPackable>false</IsPackable>\n  </PropertyGroup>\n  <ItemGroup>\n    <PackageReference Include=\"Microsoft.NET.Test.Sdk\" Version=\"17.11.1\" />\n    <PackageReference Include=\"xunit\" Version=\"2.9.2\" />\n    <PackageReference Include=\"xunit.runner.visualstudio\" Version=\"2.8.2\" />\n    <PackageReference Include=\"Microsoft.AspNetCore.Mvc.Testing\" Version=\"9.0.0\" />\n  </ItemGroup>\n  <ItemGroup>\n    <ProjectReference Include=\"../App.Api/App.Api.csproj\" />\n  </ItemGroup>\n</Project>\nusing System.Collections.Concurrent;\nusing System.Globalization;\nusing System.Net;\nusing System.Net.Http.Headers;\nusing System.Text;\nusing System.Text.Json;\nusing App.Api;\nusing App.Api.Auth;\nusing Microsoft.AspNetCore.Hosting;\nusing Microsoft.AspNetCore.Mvc.Testing;\nusing Microsoft.AspNetCore.TestHost;\nusing Microsoft.EntityFrameworkCore;\nusing Microsoft.Extensions.DependencyInjection;\nusing Microsoft.Extensions.DependencyInjection.Extensions;\nusing Xunit;\n\nnamespace App.Tests.Part1;\n\npublic sealed class AcceptancePart1Tests\n{\n    private static int _nextId = 10000;\n\n    [Fact]\n    public async Task AC_1_1_CreatesSessionForAllowedWorkspaceIdentity()\n    {\n        using var host = CreateHost();\n        var employee = await SeedEmployeeAsync(host, dedicated: false, isAdmin: true);\n\n        using var response = await CreateSessionAsync(host, employee.IdentityToken);\n\n        Assert.Equal(HttpStatusCode.Created, response.StatusCode);\n        using var json = await ReadJsonAsync(response);\n        var session = json.RootElement;\n        AssertString(session, \"accessToken\");\n        Assert.Equal(\"Bearer\", session.GetProperty(\"tokenType\").GetString());\n        Assert.True(DateTimeOffset.TryParse(session.GetProperty(\"expiresAt\").GetString(), CultureInfo.InvariantCulture, DateTimeStyles.RoundtripKind, out _));\n        Assert.Equal(employee.Id, session.GetProperty(\"employeeId\").GetInt32());\n        Assert.Equal(employee.Name, session.GetProperty(\"employeeName\").GetString());\n        Assert.Equal(employee.Email, session.GetProperty(\"corporateEmail\").GetString());\n        Assert.True(session.GetProperty(\"isParkingAdmin\").GetBoolean());\n        Assert.Equal(new[] { employee.IdentityToken }, host.Verifier.Calls.ToArray());\n    }\n\n    [Fact]\n    public async Task AC_1_2_RejectsMissingAndInvalidIdentityTokensWithApiErrors()\n    {\n        using var host = CreateHost();\n\n        using var missing = await host.Client.PostAsync(\"/auth/sessions\", JsonContent(new { }));\n        Assert.Equal(HttpStatusCode.BadRequest, missing.StatusCode);\n        using (var missingJson = await ReadJsonAsync(missing)) AssertApiError(missingJson.RootElement);\n\n        using var invalid = await CreateSessionAsync(host, \"invalid-google-token\");\n        Assert.Equal(HttpStatusCode.Unauthorized, invalid.StatusCode);\n        using var invalidJson = await ReadJsonAsync(invalid);\n        AssertApiError(invalidJson.RootElement);\n        Assert.Equal(new[] { \"invalid-google-token\" }, host.Verifier.Calls.ToArray());\n    }\n\n    [Fact]\n    public async Task AC_1_3_ReturnsAuthenticatedEmployeeProfileAndVehicles()\n    {\n        using var host = CreateHost();\n        var employee = await SeedEmployeeAsync(host, dedicated: true);\n        var space = await SeedDedicatedAssignmentAsync(host, employee);\n        var vehicle = await SeedVehicleAsync(host, employee, \"PROFILE-\" + employee.Id);\n        await SeedVehicleAsync(host, employee, \"PROFILE-OTHER-\" + employee.Id);\n        var token = await AuthenticateAsync(host, employee);\n\n        host.Client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue(\"Bearer\", token);\n        using var response = await host.Client.GetAsync(\"/me/profile\");\n        Assert.Equal(HttpStatusCode.OK, response.StatusCode);\n        using var json = await ReadJsonAsync(response);\n        var profile = json.RootElement;\n        Assert.Equal(employee.Id, profile.GetProperty(\"employeeId\").GetInt32());\n        Assert.Equal(employee.Name, profile.GetProperty(\"employeeName\").GetString());\n        Assert.Equal(employee.Email, profile.GetProperty(\"corporateEmail\").GetString());\n        Assert.Equal(\"Dedicated\", profile.GetProperty(\"assignedParkingStatus\").GetString());\n        Assert.Equal(space.Floor, profile.GetProperty(\"assignedFloor\").GetString());\n        Assert.True(profile.GetProperty(\"vehicles\").GetArrayLength() == 2);\n        Assert.Contains(profile.GetProperty(\"vehicles\").EnumerateArray(), v => v.GetProperty(\"vehicleId\").GetInt32() == vehicle.Id);\n        foreach (var returnedVehicle in profile.GetProperty(\"vehicles\").EnumerateArray()) AssertVehicle(returnedVehicle);\n\n        host.Client.DefaultRequestHeaders.Authorization = null;\n        using var unauthenticated = await host.Client.GetAsync(\"/me/profile\");\n        Assert.Equal(HttpStatusCode.Unauthorized, unauthenticated.StatusCode);\n    }\n\n    [Fact]\n    public async Task AC_1_4_ListsOnlyAuthenticatedEmployeesVehicles()\n    {\n        using var host = CreateHost();\n        var employee = await SeedEmployeeAsync(host, dedicated: false);\n        var otherEmployee = await SeedEmployeeAsync(host, dedicated: false);\n        var ownVehicle = await SeedVehicleAsync(host, employee, \"OWN-\" + employee.Id);\n        await SeedVehicleAsync(host, otherEmployee, \"OTHER-\" + otherEmployee.Id);\n        var token = await AuthenticateAsync(host, employee);\n\n        host.Client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue(\"Bearer\", token);\n        using var response = await host.Client.GetAsync(\"/me/vehicles\");\n        Assert.Equal(HttpStatusCode.OK, response.StatusCode);\n        using var json = await ReadJsonAsync(response);\n        var vehicles = json.RootElement.GetProperty(\"vehicles\");\n        Assert.Single(vehicles.EnumerateArray());\n        Assert.Equal(ownVehicle.Id, vehicles[0].GetProperty(\"vehicleId\").GetInt32());\n        AssertVehicle(vehicles[0]);\n\n        host.Client.DefaultRequestHeaders.Authorization = null;\n        using var unauthenticated = await host.Client.GetAsync(\"/me/vehicles\");\n        Assert.Equal(HttpStatusCode.Unauthorized, unauthenticated.StatusCode);\n    }\n\n    [Fact]\n    public async Task AC_1_5_RegistersVehicleAndRejectsInvalidOrConflictingRequests()\n    {\n        using var host = CreateHost();\n        var employee = await SeedEmployeeAsync(host, dedicated: false);\n        var token = await AuthenticateAsync(host, employee);\n        host.Client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue(\"Bearer\", token);\n\n        using var created = await host.Client.PostAsync(\"/me/vehicles\", JsonContent(new { plate = \"REG-\" + employee.Id, make = \"Honda\", model = \"Civic\", color = \"Blue\" }));\n        Assert.Equal(HttpStatusCode.Created, created.StatusCode);\n        using (var createdJson = await ReadJsonAsync(created))\n        {\n            var vehicle = createdJson.RootElement;\n            AssertString(vehicle, \"vehicleId\");\n            Assert.Equal(\"REG-\" + employee.Id, vehicle.GetProperty(\"plate\").GetString());\n            Assert.Equal(\"Honda\", vehicle.GetProperty(\"make\").GetString());\n            Assert.Equal(\"Civic\", vehicle.GetProperty(\"model\").GetString());\n            Assert.Equal(\"Blue\", vehicle.GetProperty(\"color\").GetString());\n            Assert.Equal(\"Active\", vehicle.GetProperty(\"status\").GetString());\n        }\n\n        using var invalid = await host.Client.PostAsync(\"/me/vehicles\", JsonContent(new { plate = \" \" }));\n        Assert.Equal(HttpStatusCode.BadRequest, invalid.StatusCode);\n        using (var invalidJson = await ReadJsonAsync(invalid)) AssertApiError(invalidJson.RootElement);\n\n        using var conflict = await host.Client.PostAsync(\"/me/vehicles\", JsonContent(new { plate = \"REG-\" + employee.Id }));\n        Assert.Equal(HttpStatusCode.Conflict, conflict.StatusCode);\n        using (var conflictJson = await ReadJsonAsync(conflict)) AssertApiError(conflictJson.RootElement);\n\n        host.Client.DefaultRequestHeaders.Authorization = null;\n        using var unauthenticated = await host.Client.PostAsync(\"/me/vehicles\", JsonContent(new { plate = \"NOAUTH-\" + employee.Id }));\n        Assert.Equal(HttpStatusCode.Unauthorized, unauthenticated.StatusCode);\n    }\n\n    [Fact]\n    public async Task AC_2_1_ReturnsContractExampleParkingConfiguration()\n    {\n        using var host = CreateHost();\n        var employee = await SeedEmployeeAsync(host, dedicated: false);\n        await SeedOfficeSettingsAsync(host);\n        var token = await AuthenticateAsync(host, employee);\n\n        host.Client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue(\"Bearer\", token);\n        using var response = await host.Client.GetAsync(\"/parking/config\");\n        Assert.Equal(HttpStatusCode.OK, response.StatusCode);\n        using var json = await ReadJsonAsync(response);\n        var config = json.RootElement;\n        Assert.Equal(\"Asia/Karachi\", config.GetProperty(\"officeTimezone\").GetString());\n        Assert.Equal(\"08:00\", config.GetProperty(\"releaseTime\").GetString());\n        Assert.Equal(30, config.GetProperty(\"schedulingWindowDays\").GetInt32());\n        Assert.Equal(new[] { \"Monday\", \"Tuesday\", \"Wednesday\", \"Thursday\", \"Friday\" }, config.GetProperty(\"workingDays\").EnumerateArray().Select(x => x.GetString()).ToArray());\n        Assert.True(config.GetProperty(\"holidaysAreWorkingDays\").GetB