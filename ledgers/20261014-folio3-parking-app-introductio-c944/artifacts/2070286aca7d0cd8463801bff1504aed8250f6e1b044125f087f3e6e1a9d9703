 - name: VehicleId\n        references:\n          column: VehicleId\n          onDelete: restrict\n          table: Vehicles\n        required: true\n        type: int\n      - name: OfficeDate\n        required: true\n        type: date\n      - name: Status\n        required: true\n        type: enum\n        values:\n          - Active\n          - Cancelled\n      - name: AuthorizedPlate\n        required: true\n        type: string\n      - name: CreatedAt\n        required: true\n        type: datetime\n    name: ParkingClaims\n    purpose: Temporary employee allocations against a claimable parking release.\n    uniques:\n      - - EmployeeId\n        - OfficeDate\n  - change: new\n    columns:\n      - name: VerificationId\n        pk: true\n        required: true\n        type: int\n      - name: DetectedObjectType\n        required: true\n        type: enum\n        values:\n          - car\n          - pedestrian\n          - motorcycle\n          - other\n      - name: DetectedAt\n        required: true\n        type: datetime\n      - name: OfficeDate\n        required: true\n        type: date\n      - name: OfficeTime\n        required: true\n        type: time\n      - name: Plate\n        required: false\n        type: string\n      - name: FailureReason\n        required: false\n        type: string\n      - name: Verification\n        required: true\n        type: enum\n        values:\n          - Authorized\n          - Denied\n          - Permanent sticker\n          - Unsuccessful\n          - Not applicable\n          - Allocation cancelled\n      - name: EntryStatus\n        required: true\n        type: enum\n        values:\n          - Green requested\n          - Blocked\n          - Not blocked\n          - Denied\n          - No authorization result\n      - name: GreenActivationRequested\n        required: true\n        type: bool\n      - name: Detail\n        required: true\n        type: text\n      - name: EmployeeId\n        references:\n          column: EmployeeId\n          onDelete: set-null\n          table: Employees\n        required: false\n        type: int\n      - name: VehicleId\n        references:\n          column: VehicleId\n          onDelete: set-null\n          table: Vehicles\n        required: false\n        type: int\n    name: EntranceVerifications\n    purpose: Persisted LPR detection inputs and fail-closed verification decisions\n      in office-local time.\n    uniques: []\n  - change: new\n    columns:\n      - name: ActivityId\n        pk: true\n        required: true\n        type: int\n      - name: OfficeTime\n        required: true\n        type: datetime\n      - name: EmployeeId\n        references:\n          column: EmployeeId\n          onDelete: set-null\n          table: Employees\n        required: false\n        type: int\n      - name: Event\n        required: true\n        type: string\n      - name: SpaceOrPlate\n        required: true\n        type: string\n      - name: Outcome\n        required: true\n        type: string\n    name: ParkingActivities\n    purpose: Retained activity events used by the administrator activity list and\n      report audit trail.\n    uniques: []\n","tools":[],"user":"<artifact id=\"acs\" kind=\"acceptance-criteria\" sha=\"\">\n[\n {\n  \"req\": \"REQ-1\",\n  \"given\": \"A valid Google identity token identifies an allowed Folio3 Google Workspace employee, and the session-creation operation has no bearer-token requirement.\",\n  \"id\": \"AC-1.1\",\n  \"level\": \"api\",\n  \"then\": \"The response status is 201 and the returned session contains the contract-required access token, token type, expiry, employee identity, corporate email, and administrator flag.\",\n  \"when\": \"The client sends the token as `googleIdentityToken` to `POST /auth/sessions`.\"\n },\n {\n  \"req\": \"REQ-1\",\n  \"given\": \"A session request is malformed or has a missing token, or the identity token is invalid or unauthorized.\",\n  \"id\": \"AC-1.2\",\n  \"level\": \"api\",\n  \"then\": \"The response status is 400 for malformed or missing input, or 401 for an invalid or unauthorized identity, and the response body conforms to the contract `ApiError` schema for the applicable error.\",\n  \"when\": \"The client sends the request to `POST /auth/sessions`.\"\n },\n {\n  \"req\": \"REQ-1\",\n  \"given\": \"An employee has a valid authenticated session and profile and vehicle records.\",\n  \"id\": \"AC-1.3\",\n  \"level\": \"api\",\n  \"then\": \"The response status is 200 and the returned profile conforms to `EmployeeProfile`, identifies the authenticated employee, and includes the contract-defined employee fields, assigned parking status, assigned floor, and vehicles; an unauthenticated request has response status 401 and an authenticated identity without permission has response status 403.\",\n  \"when\": \"The employee requests `GET /me/profile`.\"\n },\n {\n  \"req\": \"REQ-1\",\n  \"given\": \"An employee has a valid authenticated session and registered vehicles.\",\n  \"id\": \"AC-1.4\",\n  \"level\": \"api\",\n  \"then\": \"The response status is 200 and the returned `vehicles` list conforms to `VehicleList` and contains only that employee's vehicles; a request without authentication has response status 401.\",\n  \"when\": \"The employee requests `GET /me/vehicles`.\"\n },\n {\n  \"req\": \"REQ-1\",\n  \"given\": \"An employee has a valid authenticated session and submits a vehicle-registration request with a plate and optional vehicle details.\",\n  \"id\": \"AC-1.5\",\n  \"level\": \"api\",\n  \"then\": \"The response status is 201 and the returned vehicle conforms to `Vehicle`, contains the submitted fields, and has status `Active`; invalid input has response status 400, missing authentication has response status 401, and a conflicting registration has response status 409, with each error response conforming to the contract `ApiError` schema.\",\n  \"when\": \"The employee sends the request to `POST /me/vehicles`.\"\n },\n {\n  \"req\": \"REQ-2\",\n  \"given\": \"An authenticated employee requests the office configuration and the office has its contract-example initial configuration.\",\n  \"id\": \"AC-2.1\",\n  \"level\": \"api\",\n  \"then\": \"The response status is 200 and the response body conforms to `ParkingConfig`, with `officeTimezone` `Asia/Karachi`, `releaseTime` `08:00`, `schedulingWindowDays` 30, working days, and the holiday setting; a request without authentication has response status 401.\",\n  \"when\": \"The employee requests `GET /parking/config`.\"\n },\n {\n  \"req\": \"REQ-2\",\n  \"given\": \"An employee has a valid authenticated session and parking data for the current office-local date.\",\n  \"id\": \"AC-2.2\",\n  \"level\": \"api\",\n  \"then\": \"The response status is 200 and the response body conforms to `ParkingHome` and contains the office-local date and timezone, employee assignment and parking status, space status, release time, availability count, and contract-required vehicle and working-day fields; a request without authentication has response status 401.\",\n  \"when\": \"The employee requests `GET /parking/today`.\"\n },\n {\n  \"req\": \"REQ-3\",\n  \"given\": \"An authenticated dedicated parking holder has a reserved space today that has not already been released or claimed.\",\n  \"id\": \"AC-3.1\",\n  \"level\": \"api\",\n  \"then\": \"The response status is 201 and the returned release identifies the office date, `Released` status, floor, space code, and `claimableAt`; before release time `claimableAt` is the configured office-local release time, and after release time it makes the space immediately available.\",\n  \"when\": \"The holder sends `POST /parking/releases/today` before or after the configured release time.\"\n },\n {\n  \"req\": \"REQ-3\",\n  \"given\": \"A non-holder attempts a dedicated-holder release, or a holder attempts a release that conflicts with the current parking state.\",\n  \"id\": \"AC-3.2\",\n  \"level\": \"api\",\n  \"then\": \"The response status is 403 for an ineligible employee or 409 for a conflicting state, and the response body conforms to the contract `ApiError` schema.\",\n  \"when\": \"The employee sends `POST /parking/releases/today`.\"\n },\n {\n  \"req\": \"REQ-3\",\n  \"given\": \"An authenticated dedicated holder has saved releases and supplies optional `from` and `through` date filters where applicable.\",\n  \"id\": \"AC-3.3\",\n  \"level\": \"api\",\n  \"then\": \"The response status is 200 and the returned releases list conforms to `ParkingReleaseList` and contains only matching saved releases in office-local dates; a request without authentication has response status 401 and a non-holder receives response status 403.\",\n  \"when\": \"The holder requests `GET /parking/releases`.\"\n },\n {\n  \"req\": \"REQ-3\",\n  \"given\": \"An authenticated dedicated holder submits one or more valid dates within the configured scheduling window.\",\n  \"id\": \"AC-3.4\",\n  \"level\": \"api\",\n  \"then\": \"The response status is 201 and the returned releases list contains one record for each accepted date with its release identifier, status, floor, space code, and `claimableAt` based on the configured office-local release time; invalid input has response status 400, a request without authentication has response status 401, a non-holder receives response status 403, and a conflicting release has response status 409.\",\n  \"when\": \"The holder sends those dates to `POST /parking/releases`.\"\n },\n {\n  \"req\": \"REQ-3\",\n  \"given\": \"An authenticated holder owns an existing unclaimed scheduled release.\",\n  \"id\": \"AC-3.5\",\n  \"level\": \"api\",\n  \"then\": \"The response status is 200 and the returned release has status `Cancelled` and includes audit events for scheduling and cancellation; missing authentication has response status 401, a non-holder receives response status 403, an unknown identifier has response status 404, and a claimed or otherwise conflicting release has response status 409.\",\n  \"when\": \"The holder sends `DELETE /parking/releases/{releaseId}`.\"\n },\n {\n  \"req\": \"REQ-3\",\n  \"given\": \"A dedicated holder submits a malformed date or a date outside the configured scheduling window.\",\n  \"id\": \"AC-3.6\",\n  \"level\": \"api\",\n  \"then\": \"The response status is the contract-declared 400 for invalid input or 409 for the applicable state conflict, and the response body conforms to the contract `ApiError` schema.\",\n  \"when\": \"The holder sends the date to `POST /parking/releases`.\"\n },\n {\n  \"req\": \"REQ-4\",\n  \"given\": \"An authenticated employee requests availability while released spaces are claimable.\",\n  \"id\": \"AC-4.1\",\n  \"level\": \"api\",\n  \"then\": \"The response status is 200, the response body conforms to `ParkingAvailability`, and its `availableSpaceCount` equals the number of records in its spaces list, each with the contract-defined identifier, floor, and code; a request without authentication has response status 401.\",\n  \"when\": \"The employee requests `GET /parking/availability`.\"\n },\n {\n  \"req\": \"REQ-4\",\n  \"given\": \"An authenticated non-dedicated employee has a valid active registered vehicle and at least one claimable space.\",\n  \"id\": \"AC-4.2\",\n  \"level\": \"api\",\n  \"then\": \"The response status is 201 and the returned claim conforms to `ParkingClaim` and identifies an active claim, allocated floor and space code, vehicle, authorized plate, entry status, floor capacities, and the contract allocation rule; invalid input has response status 400, a request without authentication has response status 401, an ineligible employee receives response status 403, and a conflicting or unavailable allocation has response status 409.\",\n  \"when\": \"The employee sends the vehicle ID to `POST /parking/claims`.\"\n },\n {\n  \"req\": \"REQ-4\",\n  \"given\": \"Two eligible employees request the last available space and one request is accepted first by the API.\",\n  \"id\": \"AC-4.3\",\n  \"level\": \"api\",\n  \"then\": \"The accepted response has status 201 and a returned active claim for the space, the other response has status 409, and the database contains exactly one active claim for that space.\",\n  \"when\": \"Both employees submit valid `POST /parking/claims` requests concurrently.\"\n },\n {\n  \"req\": \"REQ-4\",\n  \"given\": \"An authenticated employee has a temporary claim for today, or has no temporary claim for today.\",\n  \"id\": \"AC-4.4\",\n  \"level\": \"api\",\n  \"then\": \"For a claim, the response status is 200 and the returned claim conforms to `ParkingClaim` and contains its assigned space, vehicle, authorized plate, and entry status; with no claim, the response status is 404 and the response error code is `not_found`; a request without authentication has response status 401.\",\n  \"when\": \"The employee requests `GET /parking/claims/today`.\"\n },\n {\n  \"req\": \"REQ-4\",\n  \"given\": \"An authenticated employee requests cancellation of an existing active temporary claim.\",\n  \"id\": \"AC-4.5\",\n  \"level\": \"api\",\n  \"then\": \"The response status is 409 and the returned claim remains `Active`; missing authentication has response status 401, an identity without permission receives response status 403, and an unknown claim has response status 404.\",\n  \"when\": \"The employee sends `POST /parking/claims/{claimId}/cancel`.\"\n },\n {\n  \"req\": \"REQ-4\",\n  \"given\": \"A dedicated holder requests a non-dedicated claim operation, or a non-dedicated employee requests a dedicated-holder release operation.\",\n  \"id\": \"AC-4.6\",\n  \"level\": \"api\",\n  \"then\": \"The response status is 403 and the response body conforms to the contract `ApiError` schema.\",\n  \"when\": \"The API receives the relevant claim or release request.\"\n },\n {\n  \"req\": \"REQ-5\",\n  \"given\": \"An authenticated parking administr