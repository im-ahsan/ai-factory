.SpaceCode})\n                \"\"\");\n        });\n        return spot;\n    }\n\n    private async Task<(EmployeeSeed Employee, ParkingSpotSeed Spot, ReleaseSeed? Release)> SeedDedicatedOwnerAsync(DateOnly? releaseDate, string releaseStatus)\n    {\n        var spot = await SeedParkingSpotAsync();\n        var employee = await SeedEmployeeAsync(\"Dedicated\", floorCode: spot.FloorCode);\n        await UseDbAsync(db => db.Database.ExecuteSqlInterpolatedAsync($\"\"\"\n            INSERT INTO \"DedicatedParkingAssignments\" (\"AssignmentId\", \"EmployeeId\", \"SpaceId\", \"AssignedAt\")\n            VALUES ({NextId()}, {employee.EmployeeId}, {spot.SpaceId}, {DateTime.UtcNow})\n            \"\"\"));\n        ReleaseSeed? release = null;\n        if (releaseDate.HasValue)\n            release = await SeedReleaseAsync(employee, spot, releaseDate.Value, releaseStatus);\n        return (employee, spot, release);\n    }\n\n    private async Task<VehicleSeed> SeedVehicleAsync(EmployeeSeed employee)\n    {\n        var id = NextId();\n        var vehicle = new VehicleSeed(id, NewPlate());\n        await UseDbAsync(db => db.Database.ExecuteSqlRawAsync(\"\"\"\n            INSERT INTO \"Vehicles\" (\"VehicleId\", \"EmployeeId\", \"Plate\", \"Make\", \"Model\", \"Color\", \"Status\")\n            VALUES ({0}, {1}, {2}, 'Toyota', 'Corolla', 'Silver', 'Active')\n            \"\"\", vehicle.VehicleId, employee.EmployeeId, vehicle.Plate));\n        return vehicle;\n    }\n\n    private async Task<ReleaseSeed> SeedReleaseAsync(EmployeeSeed owner, ParkingSpotSeed spot, DateOnly officeDate, string status)\n    {\n        var id = NextId();\n        var release = new ReleaseSeed(id);\n        var statusLiteral = status switch\n        {\n            \"Reserved\" => \"'Reserved'\",\n            \"Released\" => \"'Released'\",\n            \"Claimed\" => \"'Claimed'\",\n            \"Cancelled\" => \"'Cancelled'\",\n            _ => throw new ArgumentOutOfRangeException(nameof(status))\n