d\" => \"'Blocked'\",\n            \"Not blocked\" => \"'Not blocked'\",\n            \"Denied\" => \"'Denied'\",\n            \"No authorization result\" => \"'No authorization result'\",\n            _ => throw new ArgumentOutOfRangeException(nameof(entryStatus))\n        };\n        var id = NextId();\n        var detectedAt = officeDate.ToDateTime(new TimeOnly(8, 12), DateTimeKind.Utc);\n        await UseDbAsync(db => db.Database.ExecuteSqlRawAsync($\"\"\"\n            INSERT INTO \"EntranceVerifications\"\n                (\"VerificationId\", \"DetectedObjectType\", \"DetectedAt\", \"OfficeDate\", \"OfficeTime\", \"Plate\", \"FailureReason\", \"Verification\", \"EntryStatus\", \"GreenActivationRequested\", \"Detail\", \"EmployeeId\", \"VehicleId\")\n            VALUES ({{0}}, 'car', {{1}}, {{2}}, TIME '08:12:00', {{3}}, NULL, {verificationLiteral}, {entryStatusLiteral}, FALSE, {{4}}, {{5}}, NULL)\n            \"\"\", id, detectedAt, officeDate, plate, detail, employee.EmployeeId));\n    }\n\n    private async Task SeedActivityAsync(EmployeeSeed employee, string @event, string spaceOrPlate, string outcome)\n    {\n        await UseDbAsync(db => db.Database.ExecuteSqlInterpolatedAsync($\"\"\"\n            INSERT INTO \"ParkingActivities\" (\"ActivityId\", \"OfficeTime\", \"EmployeeId\", \"Event\", \"SpaceOrPlate\", \"Outcome\")\n            VALUES ({NextId()}, {DateTime.UtcNow}, {employee.EmployeeId}, {@event}, {spaceOrPlate}, {outcome})\n            \"\"\"));\n    }\n\n    private async Task<HttpClient> AuthenticatedClientAsync(EmployeeSeed employee)\n    {\n        var client = _factory.CreateClient();\n        using var session = await client.PostAsJsonAsync(\"/auth/sessions\", new\n        {\n            googleIdentityToken = $\"{employee.Email}|{employee.EmployeeName}\"\n        });\n        Assert.Equal(HttpStatusCode.Created, session.StatusCode);\nusing System.Collections.Concurrent;\nusing System.Globalization;\nusing System.Net;\nusing System.Net.Http.He