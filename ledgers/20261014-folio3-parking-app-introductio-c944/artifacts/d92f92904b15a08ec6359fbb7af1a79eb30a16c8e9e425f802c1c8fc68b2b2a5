:\n              $ref: '#/components/schemas/ClaimParkingRequest'\n      responses:\n        '201':\n          description: Space allocated to the first accepted eligible claim\n          content:\n            application/json:\n              schema:\n                $ref: '#/components/schemas/ParkingClaim'\n              example:\n                claimId: 8101\n                officeDate: \"2026-06-16\"\n                status: Active\n                floor: B1\n                spaceCode: \"08\"\n                vehicle:\n                  vehicleId: 501\n                  plate: KLG-4821\n                  make: Toyota\n                  model: Corolla\n                  color: Silver\n                  status: Active\n                authorizedPlate: KLG-4821\n                entryStatus: Awaiting detection\n                floorCapacities:\n                  - floor: B1\n                    freeSpaces: 8\n                    totalSpaces: 28\n                  - floor: B2\n                    freeSpaces: 8\n                    totalSpaces: 28\n                  - floor: B3\n                    freeSpaces: 5\n                    totalSpaces: 20\n                allocationRule: \"Highest free count; ties go to lowest floor code.\"\n        '400':\n          $ref: '#/components/responses/BadRequest'\n        '401':\n          $ref: '#/components/responses/Unauthorized'\n        '403':\n          $ref: '#/components/responses/Forbidden'\n        '409':\n          $ref: '#/components/responses/Conflict'\n  /parking/claims/today:\n    get:\n      operationId: getTodaysParkingClaim\n      summary: Get the signed-in employee's temporary claim for today\n      responses:\n        '200':\n          description: Today's temporary allocation and authorized plate\n          content:\n            application/json:\n              schema:\n                $ref: '#/components/schemas/ParkingClaim'\n              example:\n                claimId: 8101\n                officeDate: \"2026-06-16\"\n                status: Active\n                floor: B1\n                spaceCode: \"08\"\n                vehicle:\n                  vehicleId: 501\n                  plate: KLG-4821\n                  make: Toyota\n                  model: Corolla\n                  color: Silver\n                  status: Active\n                authorizedPlate: KLG-4821\n                entryStatus: Awaiting detection\n                floorCapacities:\n                  - floor: B1\n                    freeSpaces: 8\n                    totalSpaces: 28\n                allocationRule: \"Highest free count; ties go to lowest floor code.\"\n        '401':\n          $ref: '#/components/responses/Unauthorized'\n        '404':\n          $ref: '#/components/responses/NotFound'\n  /parking/claims/{claimId}/cancel:\n    post:\n      operationId: cancelParkingClaim\n      summary: Reject employee cancellation of a temporary claim in Phase 1\n      parameters:\n        - name: claimId\n          in: path\n          required: true\n          schema:\n            type: integer\n      responses:\n        '409':\n          description: Employee cancellation is unavailable and claim remains active\n          content:\n            application/json:\n              schema:\n                $ref: '#/components/schemas/ParkingClaim'\n              example:\n                claimId: 8101\n                officeDate: \"2026-06-16\"\n                status: Active\n                floor: B1\n                spaceCode: \"08\"\n                vehicle:\n                  vehicleId: 501\n                  plate: KLG-4821\n                  make: Toyota\n                  model: Corolla\n                  color: Silver\n                  status: Active\n                authorizedPlate: KLG-4821\n                entryStatus: Awaiting detection\n                floorCapacities:\n                  - floor: B1\n                    freeSpaces: 8\n                    totalSpaces: 28\n   