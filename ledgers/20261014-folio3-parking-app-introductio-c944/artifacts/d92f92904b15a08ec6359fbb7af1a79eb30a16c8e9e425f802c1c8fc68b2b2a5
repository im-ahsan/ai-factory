atus: Active\n                workingDays:\n                  - Monday\n                  - Tuesday\n                  - Wednesday\n                  - Thursday\n                  - Friday\n                holidaysAreWorkingDays: true\n        '401':\n          $ref: '#/components/responses/Unauthorized'\n  /parking/releases/today:\n    post:\n      operationId: releaseParkingToday\n      summary: Release the signed-in dedicated holder's space today\n      responses:\n        '201':\n          description: Today's release recorded\n          content:\n            application/json:\n              schema:\n                $ref: '#/components/schemas/ParkingRelease'\n              example:\n                releaseId: 7001\n                date: \"2026-06-16\"\n                status: Released\n                floor: B2\n                spaceCode: \"114\"\n                claimableAt: \"2026-06-16T08:00:00+05:00\"\n        '401':\n          $ref: '#/components/responses/Unauthorized'\n        '403':\n          $ref: '#/components/responses/Forbidden'\n        '409':\n          $ref: '#/components/responses/Conflict'\n  /parking/releases:\n    get:\n      operationId: listMyReleases\n      summary: List the signed-in holder's saved releases\n      parameters:\n        - name: from\n          in: query\n          required: false\n          schema:\n            type: string\n            format: date\n        - name: through\n          in: query\n          required: false\n          schema:\n            type: string\n            format: date\n      responses:\n        '200':\n          description: Saved release dates in office-local time\n          content:\n            application/json:\n              schema:\n                $ref: '#/components/schemas/ParkingReleaseList'\n              example:\n                releases:\n                  - releaseId: 7002\n                    date: \"2026-06-18\"\n                    status: Released\n                    floor: B2\n  