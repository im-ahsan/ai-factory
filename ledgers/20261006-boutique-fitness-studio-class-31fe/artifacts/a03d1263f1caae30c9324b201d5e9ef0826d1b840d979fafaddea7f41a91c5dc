{"text":"openapi: 3.0.3\ninfo:\n  title: Pulse Studio Booking API\n  version: 1.0.0\n  description: >-\n    Contract for the Pulse Studio class booking app. In this release it is served\n    inside the browser by the booking service over local storage (no network);\n    the web app calls it only through the generated client in lib/api.\nservers:\n  - url: /api\ntags:\n  - name: member\n  - name: schedule\n  - name: bookings\n  - name: test-only\npaths:\n  /me:\n    get:\n      operationId: getMember\n      tags: [member]\n      summary: The pre-signed-in demo member\n      responses:\n        \"200\":\n          description: The member\n          content:\n            application/json:\n              schema:\n                $ref: \"#/components/schemas/Member\"\n              example:\n                id: 1\n                name: Alex Rivera\n                initials: AR\n                membership: Unlimited Monthly\n        \"500\":\n          $ref: \"#/components/responses/StorageFailure\"\n  /schedule:\n    get:\n      operationId: getSchedule\n      tags: [schedule]\n      summary: Week strip and the selected day's sessions, filtered\n      parameters:\n        - name: date\n          in: query\n          required: false\n          description: Selected day (Europe/London). Defaults to today. Must be in the current or next week.\n          schema:\n            type: string\n            format: date\n        - name: type\n          in: query\n          required: false\n          style: form\n          explode: true\n          schema:\n            type: array\n            items:\n              $ref: \"#/components/schemas/ClassType\"\n        - name: intensity\n          in: query\n          required: false\n          style: form\n          explode: true\n          schema:\n            type: array\n            items:\n              $ref: \"#/components/schemas/Intensity\"\n        - name: timeOfDay\n          in: query\n          required: false\n          style: form\n          explode: true\n          schema:\n            type: array\n            items:\n              $ref: \"#/components/schemas/TimeOfDay\"\n      responses:\n        \"200\":\n          description: The schedule for the selected day\n          content:\n            application/json:\n              schema:\n                $ref: \"#/components/schemas/Schedule\"\n              example:\n                today: \"2026-10-14\"\n                date: \"2026-10-14\"\n                weekStart: \"2026-10-12\"\n                canGoPreviousWeek: false\n                canGoNextWeek: true\n                days:\n                  - { date: \"2026-10-12\", label: \"Mon 12\", isToday: false, hasSessions: true }\n                  - { date: \"2026-10-13\", label: \"Tue 13\", isToday: false, hasSessions: true }\n                  - { date: \"2026-10-14\", label: \"Wed 14\", isToday: true, hasSessions: true }\n                  - { date: \"2026-10-15\", label: \"Thu 15\", isToday: false, hasSessions: true }\n                  - { date: \"2026-10-16\", label: \"Fri 16\", isToday: false, hasSessions: true }\n                  - { date: \"2026-10-17\", label: \"Sat 17\", isToday: false, hasSessions: true }\n                  - { date: \"2026-10-18\", label: \"Sun 18\", isToday: false, hasSessions: false }\n                sessions:\n                  - id: 101\n                    name: Sunrise Flow\n                    type: Yoga\n                    intensity: Low\n                    instructor: { id: 1, name: Maya Okafor, bio: \"Ex-sprinter, 8 years coaching HIIT, strength and slow-flow yoga\", avatarUrl: \"/avatars/maya-okafor.jpg\" }\n                    room: Studio A\n                    startsAt: \"2026-10-14T07:00:00Z\"\n                    endsAt: \"2026-10-14T08:00:00Z\"\n                    durationMin: 60\n                    capacity: 20\n                    bookedCount: 14\n                    waitlistCount: 0\n                    description: \"A gentle vinyasa to wake the body up. Expect sun salutations, hip openers and a long savasana. Suitable for every level.\"\n                    whatToBring: [{ title: Yoga mat, note: \"Or borrow one at reception\" }, { title: Water bottle, note: \"Refill station by Studio B\" }]\n                    status: Scheduled\n                    availabilityLabel: \"6 spots left\"\n                    capacityLabel: \"6 of 20 spots left\"\n                    actionState: { kind: booked, canChange: true, spotsLeft: null, position: null, bookingId: 501, reason: null, skipReason: null, lateCancellation: false }\n                    myBookingId: 501\n                  - id: 102\n                    name: Reformer Core\n                    type: Pilates\n                    intensity: Medium\n                    instructor: { id: 2, name: Lena Fischer, bio: \"Reformer specialist with 10 years teaching Pilates for strength and posture\", avatarUrl: \"/avatars/lena-fischer.jpg\" }\n                    room: Studio B\n                    startsAt: \"2026-10-14T08:30:00Z\"\n                    endsAt: \"2026-10-14T09:15:00Z\"\n                    durationMin: 45\n                    capacity: 12\n                    bookedCount: 10\n                    waitlistCount: 0\n                    description: \"Deep core work on the reformer. Slow, controlled springs build strength from the centre out. Beginners welcome.\"\n                    whatToBring: [{ title: Grip socks, note: \"Available at reception for £3\" }]\n                    status: Scheduled\n                    availabilityLabel: \"Only 2 left\"\n                    capacityLabel: \"2 of 12 spots left\"\n                    actionState: { kind: book, canChange: true, spotsLeft: 2, position: null, bookingId: null, reason: null, skipReason: null, lateCancellation: null }\n                    myBookingId: null\n                  - id: 103\n                    name: HIIT Blast\n                    type: HIIT\n                    intensity: High\n                    instructor: { id: 3, name: Jordan Blake, bio: \"Former rugby player who coaches high-energy intervals and spin\", avatarUrl: \"/avatars/jordan-blake.jpg\" }\n                    room: Studio A\n                    startsAt: \"2026-10-14T11:15:00Z\"\n                    endsAt: \"2026-10-14T12:00:00Z\"\n                    durationMin: 45\n                    capacity: 16\n                    bookedCount: 16\n                    waitlistCount: 3\n                    description: \"Short, sharp intervals of kettlebells and bodyweight circuits. 40 seconds on, 20 off. Every move has a lower-impact option.\"\n                    whatToBring: [{ title: Sweat towel, note: \"Or rent one at reception for £1\" }, { title: Training shoes, note: \"Flat soles, no running spikes\" }]\n                    status: Scheduled\n                    availabilityLabel: \"Full · 3 on waitlist\"\n                    capacityLabel: \"0 of 16 spots left\"\n                    actionState: { kind: join_waitlist, canChange: true, spotsLeft: null, position: 4, bookingId: null, reason: null, skipReason: null, lateCancellation: null }\n                    myBookingId: null\n                  - id: 105\n                    name: Fight Club Basics\n                    type: Boxing\n                    intensity: Medium\n                    instructor: { id: 5, name: Marcus Cole, bio: \"Amateur boxing champion who teaches technique first, sweat second\", avatarUrl: \"/avatars/marcus-cole.jpg\" }\n                    room: Studio B\n                    startsAt: \"2026-10-14T17:30:00Z\"\n                    endsAt: \"2026-10-14T18:30:00Z\"\n                    durationMin: 60\n                    capacity: 14\n                    bookedCount: 14\n                    waitlistCount: 2\n                    description: \"Learn the jab, cross and hook on pads with a partner. Footwork drills and a conditioning finisher close the class.\"\n                    whatToBring: [{ title: Hand wraps, note: \"Gloves are provided\" }]\n                    status: Scheduled\n                    availabilityLabel: \"Full · 2 on waitlist\"\n                    capacityLabel: \"0 of 14 spots left\"\n                    actionState: { kind: waitlisted, canChange: true, spotsLeft: null, position: 2, bookingId: 502, reason: null, skipReason: null, lateCancellation: null }\n                    myBookingId: 502\n                  - id: 106\n                    name: Restore & Stretch\n                    type: Yoga\n                    intensity: Low\n                    instructor: { id: 1, name: Maya Okafor, bio: \"Ex-sprinter, 8 years coaching HIIT, strength and slow-flow yoga\", avatarUrl: \"/avatars/maya-okafor.jpg\" }\n                    room: Studio A\n                    startsAt: \"2026-10-14T18:45:00Z\"\n                    endsAt: \"2026-10-14T19:30:00Z\"\n                    durationMin: 45\n                    capacity: 20\n                    bookedCount: 0\n                    waitlistCount: 0\n                    description: \"Long-held stretches and breathwork to unwind. Props do the work so you can relax.\"\n                    whatToBring: [{ title: Warm layer, note: \"The studio cools down during savasana\" }]\n                    status: Cancelled by studio\n                    availabilityLabel: Cancelled\n                    capacityLabel: \"20 of 20 spots left\"\n                    actionState: { kind: disabled, canChange: false, spotsLeft: null, position: null, bookingId: null, reason: \"Cancelled by studio\", skipReason: null, lateCancellation: null }\n                    myBookingId: null\n        \"400\":\n          $ref: \"#/components/responses/InvalidRequest\"\n        \"500\":\n          $ref: \"#/components/responses/StorageFailure\"\n  /sessions/{sessionId}:\n    get:\n      operationId: getSession\n      tags: [schedule]\n      summary: One class session with instructor and Alex's action state\n      parameters:\n        - $ref: \"#/components/parameters/SessionId\"\n      responses:\n        \"200\":\n          description: The session\n          content:\n            application/json:\n              schema:\n                $ref: \"#/components/schemas/Session\"\n              example:\n                id: 210\n                name: Power HIIT 45\n                type: HIIT\n                intensity: High\n                instructor: { id: 1, name: Maya Okafor, bio: \"Ex-sprinter, 8 years coaching HIIT, strength and slow-flow yoga\", avatarUrl: \"/avatars/maya-okafor.jpg\" }\n                room: Studio B\n                startsAt: \"2026-10-15T17:30:00Z\"\n                endsAt: \"2026-10-15T18:15:00Z\"\n                durationMin: 45\n                capacity: 20\n                bookedCount: 17\n                waitlistCount: 0\n                description: \"Fast intervals of kettlebells, sled pushes and bodyweight circuits. 40 seconds on, 20 off, five rounds, then a 5-minute stretch. Every move has a lower-impact option, so come as you are.\"\n                whatToBring:\n                  - { title: Water bottle, note: \"Refill station by Studio B\" }\n                  - { title: Sweat towel, note: \"Or rent one at reception for £1\" }\n                  - { title: Training shoes, note: \"Flat soles, no running spikes\" }\n                status: Scheduled\n                availabilityLabel: \"Only 3 left\"\n                capacityLabel: \"3 of 20 spots left\"\n                actionState: { kind: book, canChange: true, spotsLeft: 3, position: null, bookingId: null, reason: null, skipReason: null, lateCancellation: null }\n                myBookingId: null\n        \"404\":\n          $ref: \"#/components/responses/NotFound\"\n        \"500\":\n          $ref: \"#/components/responses/StorageFailure\"\n  /bookings:\n    post:\n      operationId: createBooking\n      tags: [bookings]\n      summary: Book a session for Alex\n      requestBody:\n        required: true\n        content:\n          application/json:\n            schema:\n              $ref: \"#/components/schemas/SessionRequest\"\n            example:\n              sessionId: 102\n      responses:\n        \"201\":\n          description: Booked\n          content:\n            application/json:\n              schema:\n                $ref: \"#/components/schemas/BookingChange\"\n              example:\n                booking: { id: 503, sessionId: 102, status: Booked, lateCancel: false, waitlistPosition: null, skipReason: null, createdAt: \"2026-10-14T07:42:10Z\", cancelledAt: null }\n                session:\n                  id: 102\n                  name: Reformer Core\n                  type: Pilates\n                  intensity: Medium\n                  instructor: { id: 2, name: Lena Fischer, bio: \"Reformer specialist with 10 years teaching Pilates for strength and posture\", avatarUrl: \"/avatars/lena-fischer.jpg\" }\n                  room: Studio B\n                  startsAt: \"2026-10-14T08:30:00Z\"\n                  endsAt: \"2026-10-14T09:15:00Z\"\n                  durationMin: 45\n                  capacity: 12\n                  bookedCount: 11\n                  waitlistCount: 0\n                  description: \"Deep core work on the reformer. Slow, controlled springs build strength from the centre out. Beginners welcome.\"\n                  whatToBring: [{ title: Grip socks, note: \"Available at reception for £3\" }]\n                  status: Scheduled\n                  availabilityLabel: \"1 spot left\"\n                  capacityLabel: \"1 of 12 spots left\"\n                  actionState: { kind: booked, canChange: true, spotsLeft: null, position: null, bookingId: 503, reason: null, skipReason: null, lateCancellation: true }\n                  myBookingId: 503\n                message: \"You're booked for Reformer Core · Wed 09:30\"\n        \"400\":\n          $ref: \"#/components/responses/InvalidRequest\"\n        \"404\":\n          $ref: \"#/components/responses/NotFound\"\n        \"409\":\n          description: Rejected by a booking rule (already_booked, class_full, outside_booking_window, class_has_started, cancelled_by_studio, overlap, limit_reached)\n          content:\n            application/json:\n              schema:\n                $ref: \"#/components/schemas/Error\"\n              example:\n                code: overlap\n                message: \"You're already booked for Power HIIT at 18:00–18:45.\"\n                session: null\n        \"500\":\n          $ref: \"#/components/responses/StorageFailure\"\n  /bookings/{bookingId}/undo:\n    post:\n      operationId: undoBooking\n      tags: [bookings]\n      summary: Undo a booking within 5 seconds, as if it was never made\n      parameters:\n        - $ref: \"#/components/parameters/BookingId\"\n      responses:\n        \"200\":\n          description: Booking removed\n          content:\n            application/json:\n              schema:\n                $ref: \"#/components/schemas/UndoResult\"\n              example:\n                message: \"Booking undone — Reformer Core\"\n                session:\n                  id: 102\n                  name: Reformer Core\n                  type: Pilates\n                  intensity: Medium\n                  instructor: { id: 2, name: Lena Fischer, bio: \"Reformer specialist with 10 years teaching Pilates for strength and posture\", avatarUrl: \"/avatars/lena-fischer.jpg\" }\n                  room: Studio B\n                  startsAt: \"2026-10-14T08:30:00Z\"\n                  endsAt: \"2026-10-14T09:15:00Z\"\n                  durationMin: 45\n                  capacity: 12\n                  bookedCount: 10\n                  waitlistCount: 0\n                  description: \"Deep core work on the reformer. Slow, controlled springs build strength from the centre out. Beginners welcome.\"\n                  whatToBring: [{ title: Grip socks, note: \"Available at reception for £3\" }]\n                  status: Scheduled\n                  availabilityLabel: \"Only 2 left\"\n                  capacityLabel: \"2 of 12 spots left\"\n                  actionState: { kind: book, canChange: true, spotsLeft: 2, position: null, bookingId: null, reason: null, skipReason: null, lateCancellation: null }\n                  myBookingId: null\n        \"404\":\n          $ref: \"#/components/responses/NotFound\"\n        \"409\":\n          description: Undo window passed (undo_expired) or record not Booked (invalid_booking_state)\n          content:\n            application/json:\n              schema:\n                $ref: \"#/components/schemas/Error\"\n              example:\n                code: undo_expired\n                message: Undo is no longer available for this booking.\n                session: null\n        \"500\":\n          $ref: \"#/components/responses/StorageFailure\"\n  /bookings/{bookingId}/cancel:\n    post:\n      operationId: cancelBooking\n      tags: [bookings]\n      summary: Cancel a Booked record (late flag when under 2 hours to start)\n      parameters:\n        - $ref: \"#/components/parameters/BookingId\"\n      responses:\n        \"200\":\n          description: Cancelled\n          content:\n            application/json:\n              schema:\n                $ref: \"#/components/schemas/BookingChange\"\n              example:\n                booking: { id: 506, sessionId: 120, status: Cancelled, lateCancel: true, waitlistPosition: null, skipReason: null, createdAt: \"2026-10-12T09:05:00Z\", cancelledAt: \"2026-10-14T16:40:00Z\" }\n                session:\n                  id: 120\n                  name: Power Spin\n                  type: Spin\n                  intensity: High\n                  instructor: { id: 3, name: Jordan Blake, bio: \"Former rugby player who coaches high-energy intervals and spin\", avatarUrl: \"/avatars/jordan-blake.jpg\" }\n                  room: Spin Room\n                  startsAt: \"2026-10-14T18:00:00Z\"\n                  endsAt: \"2026-10-14T18:45:00Z\"\n                  durationMin: 45\n                  capacity: 20\n                  bookedCount: 18\n                  waitlistCount: 0\n                  description: \"Climbs, sprints and a big finish to a loud playlist. Set your own resistance and ride to the beat.\"\n                  whatToBring: [{ title: Water bottle, note: \"Bottle cages on every bike\" }]\n                  status: Scheduled\n                  availabilityLabel: \"2 spots left\"\n                  capacityLabel: \"2 of 20 spots left\"\n                  actionState: { kind: book, canChange: true, spotsLeft: 2, position: null, bookingId: null, reason: null, skipReason: null, lateCancellation: null }\n                  myBookingId: null\n                message: \"Booking cancelled — Power Spin, today 19:00\"\n        \"404\":\n          $ref: \"#/components/responses/NotFound\"\n        \"409\":\n          description: Record not Booked (invalid_booking_state) or class has started (class_has_started)\n          content:\n            application/json:\n              schema:\n                $ref: \"#/components/schemas/Error\"\n              example:\n                code: invalid_booking_state\n                message: \"This booking can't be changed any more. Refresh to see its latest status.\"\n                session: null\n        \"500\":\n          $ref: \"#/components/responses/StorageFailure\"\n  /waitlist:\n    post:\n      operationId: joinWaitlist\n      tags: [bookings]\n      summary: Join the waitlist of a full session\n      requestBody:\n        required: true\n        content:\n          application/json:\n            schema:\n              $ref: \"#/components/schemas/SessionRequest\"\n            example:\n              sessionId: 103\n      responses:\n        \"201\":\n          description: Waitlisted\n          content:\n            application/json:\n              schema:\n                $ref: \"#/components/schemas/BookingChange\"\n              example:\n                booking: { id: 507, sessionId: 103, status: Waitlisted, lateCancel: false, waitlistPosition: 4, skipReason: null, createdAt: \"2026-10-14T07:50:00Z\", cancelledAt: null }\n                session:\n                  id: 103\n                  name: HIIT Blast\n                  type: HIIT\n                  intensity: High\n                  instructor: { id: 3, name: Jordan Blake, bio: \"Former rugby player who coaches high-energy intervals and spin\", avatarUrl: \"/avatars/jordan-blake.jpg\" }\n                  room: Studio A\n                  startsAt: \"2026-10-14T11:15:00Z\"\n                  endsAt: \"2026-10-14T12:00:00Z\"\n                  durationMin: 45\n                  capacity: 16\n                  bookedCount: 16\n                  waitlistCount: 4\n                  description: \"Short, sharp intervals of kettlebells and bodyweight circuits. 40 seconds on, 20 off. Every move has a lower-impact option.\"\n                  whatToBring: [{ title: Sweat towel, note: \"Or rent one at reception for £1\" }]\n                  status: Scheduled\n                  availabilityLabel: \"Full · 4 on waitlist\"\n                  capacityLabel: \"0 of 16 spots left\"\n                  actionState: { kind: waitlisted, canChange: true, spotsLeft: null, position: 4, bookingId: 507, reason: null, skipReason: null, lateCancellation: null }\n                  myBookingId: 507\n                message: \"You're on the waitlist for HIIT Blast · Wed 12:15 — you're #4\"\n        \"400\":\n          $ref: \"#/components/responses/InvalidRequest\"\n        \"404\":\n          $ref: \"#/components/responses/NotFound\"\n        \"409\":\n          description: Rejected (already_booked, not_full, outside_booking_window, class_has_started, cancelled_by_studio)\n          content:\n            application/json:\n              schema:\n                $ref: \"#/components/schemas/Error\"\n              example:\n                code: not_full\n                message: \"This class still has spots, so you can book it instead.\"\n                session: null\n        \"500\":\n          $ref: \"#/components/responses/StorageFailure\"\n  /bookings/{bookingId}/leave-waitlist:\n    post:\n      operationId: leaveWaitlist\n      tags: [bookings]\n      summary: Leave a waitlist (stored as Cancelled, not late)\n      parameters:\n        - $ref: \"#/components/parameters/BookingId\"\n      responses:\n        \"200\":\n          description: Left the waitlist\n          content:\n            application/json:\n              schema:\n                $ref: \"#/components/schemas/BookingChange\"\n              example:\n                booking: { id: 504, sessionId: 131, status: Cancelled, lateCancel: false, waitlistPosition: null, skipReason: null, createdAt: \"2026-10-12T18:20:00Z\", cancelledAt: \"2026-10-14T08:10:00Z\" }\n                session:\n                  id: 131\n                  name: Vinyasa Flow\n                  type: Yoga\n                  intensity: Medium\n                  instructor: { id: 1, name: Maya Okafor, bio: \"Ex-sprinter, 8 years coaching HIIT, strength and slow-flow yoga\", avatarUrl: \"/avatars/maya-okafor.jpg\" }\n                  room: Studio A\n                  startsAt: \"2026-10-15T06:00:00Z\"\n                  endsAt: \"2026-10-15T07:00:00Z\"\n                  durationMin: 60\n                  capacity: 18\n                  bookedCount: 18\n                  waitlistCount: 2\n                  description: \"Flowing sequences linking breath and movement. Builds heat, balance and focus before the working day.\"\n                  whatToBring: [{ title: Yoga mat, note: \"Or borrow one at reception\" }]\n                  status: Scheduled\n                  availabilityLabel: \"Full · 2 on waitlist\"\n                  capacityLabel: \"0 of 18 spots left\"\n                  actionState: { kind: join_waitlist, canChange: true, spotsLeft: null, position: 3, bookingId: null, reason: null, skipReason: null, lateCancellation: null }\n                  myBookingId: null\n                message: \"You've left the waitlist for Vinyasa Flow\"\n        \"404\":\n          $ref: \"#/components/responses/NotFound\"\n        \"409\":\n          description: Record not Waitlisted (invalid_booking_state) or class has started (class_has_started)\n          content:\n            application/json:\n              schema:\n                $ref: \"#/components/schemas/Error\"\n              example:\n                code: class_has_started\n                message: \"This class has already started, so it can't be changed.\"\n                session: null\n        \"500\":\n          $ref: \"#/components/responses/StorageFailure\"\n  /me/bookings:\n    get:\n      operationId: getMyBookings\n      tags: [bookings]\n      summary: Alex's Upcoming (grouped by day) and Past lists\n      responses:\n        \"200\":\n          description: Alex's bookings\n          content:\n            application/json:\n              schema:\n                $ref: \"#/components/schemas/MyBookings\"\n              example:\n                upcoming:\n                  - label: Today\n                    date: \"2026-10-14\"\n                    rows:\n                      - id: 506\n                        sessionId: 120\n                        status: Booked\n                        lateCancel: false\n                        waitlistPosition: null\n                        skipReason: null\n                        badge: Booked\n                        canChange: true\n                        isLateIfCancelledNow: true\n                        session: { id: 120, name: Power Spin, type: Spin, instructorName: Jordan Blake, room: Spin Room, startsAt: \"2026-10-14T18:00:00Z\", endsAt: \"2026-10-14T18:45:00Z\", durationMin: 45 }\n                  - label: Tomorrow\n                    d