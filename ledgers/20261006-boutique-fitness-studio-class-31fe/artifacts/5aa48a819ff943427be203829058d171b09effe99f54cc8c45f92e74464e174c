{"files":[{"added":["using App.Api.Contracts;","using App.Api.Data;","using Microsoft.EntityFrameworkCore;","","namespace App.Api.Services;","","/// <summary>Read-side queries for the demo member, serving the schedule, session detail, bookings and stats screens.</summary>","public sealed class StudioQueries(AppDb db, TimeProvider clock, SessionProjection projection)","{","    private DateTime Now => clock.GetUtcNow().UtcDateTime;","","    public Member GetMember() => new(1, \"Alex Rivera\", \"AR\", \"Unlimited Monthly\");","","    public async Task<Schedule> GetSchedule(DateOnly? date, ClassType[]? type, Intensity[]? intensity, TimeOfDay[]? timeOfDay)","    {","        var today = LondonTime.LondonDate(Now);","        var currentWeekStart = LondonTime.WeekStart(today);","        var nextWeekStart = currentWeekStart.AddDays(7);","        var selected = date ?? today;","        var weekStart = LondonTime.WeekStart(selected);","","        if (weekStart != currentWeekStart && weekStart != nextWeekStart) throw ApiException.Invalid();","","        var rangeStartUtc = LondonTime.StartOfLondonDayUtc(weekStart);","        var rangeEndUtc = LondonTime.StartOfLondonDayUtc(weekStart.AddDays(7));","","        var weekSessions = await db.Sessions.AsNoTracking().Include(s => s.Instructor)","            .Where(s => s.StartsAt >= rangeStartUtc && s.StartsAt < rangeEndUtc)","            .ToListAsync();","","        var days = Enumerable.Range(0, 7).Select(i =>","        {","            var d = weekStart.AddDays(i);","            return new DaySummary(d, LondonTime.DayLabel(d), d == today, weekSessions.Any(s => LondonTime.LondonDate(s.StartsAt) == d));","        }).ToList();","","        IEnumerable<SessionEntity> daySessions = weekSessions.Where(s => LondonTime.LondonDate(s.StartsAt) == selected);","        if (type is { Length: > 0 }) daySessions = daySessions.Where(s => type.Contains(s.Type));","        if (intensity is { Length: > 0 }) daySessions = daySessions.Where(s => intensity.Contains(s.Intensity));","        if (timeOfDay is { Length: > 0 }) daySessions = daySessions.Where(s => timeOfDay.Contains(LondonTime.TimeOfDay(s.StartsAt)));","","        var ordered = daySessions.OrderBy(s => s.StartsAt).ToList();","        var active = await ActiveBookingsFor(ordered.Select(s => s.Id));","        var sessions = ordered.Select(s => projection.ToSession(s, active.GetValueOrDefault(s.Id))).ToList();","","        return new Schedule(today, selected, weekStart, weekStart == nextWeekStart, weekStart == currentWeekStart, days, sessions);","    }","","    public async Task<Session> GetSession(int sessionId)","    {","        var s = await db.Sessions.AsNoTracking().Include(x => x.Instructor).FirstOrDefaultAsync(x => x.Id == sessionId)","            ?? throw ApiException.NotFound();","        var active = await ActiveBookingFor(sessionId);","        return projection.ToSession(s, active);","    }","","    public async Task<MyBookings> GetMyBookings()","    {","        var bookings = await db.Bookings.AsNoTracking().Include(b => b.Session!).ThenInclude(s => s.Instructor).ToListAsync();","","        var upcoming = bookings.Where(b =>","            b.Status is BookingStatus.Booked or BookingStatus.Waitlisted","            && b.Session!.Status != SessionStatus.CancelledByStudio","            && b.Session.EndsAt > Now);","","        var today = LondonTime.LondonDate(Now);","        var groups = upcoming","            .GroupBy(b => LondonTime.LondonDate(b.Session!.StartsAt))","            .OrderBy(g => g.Key)","            .Select(g => new UpcomingGroup(","                GroupLabel(g.Key, today), g.Key,","                g.OrderBy(b => b.Session!.StartsAt).Select(projection.ToRow).ToList()))","            .ToList();","","        var past = bookings.Where(b =>","                b.Status == BookingStatus.Cancelled","                || (b.Status == BookingStatus.Booked && b.Session!.EndsAt <= Now)","                || (b.Status is BookingStatus.Booked or BookingStatus.Waitlisted && b.Session!.Status == SessionStatus.CancelledByStudio))","            .OrderByDescending(b => b.Session!.StartsAt)","            .Select(projection.ToRow)","            .ToList();","","        return new MyBookings(groups, past);","    }","","    public async Task<Stats> GetStats()","    {","        var bookings = await db.Bookings.AsNoTracking().Include(b => b.Session!).ToListAsync();","","        var upcoming = bookings.Count(b =>","            b.Status == BookingStatus.Booked","            && b.Session!.Status != SessionStatus.CancelledByStudio","            && Now < b.Session.StartsAt);","","        var attended = bookings.Where(b =>","            b.Status == BookingStatus.Booked","            && b.Session!.Status != SessionStatus.CancelledByStudio","            && Now >= b.Session.EndsAt).ToList();","","        var today = LondonTime.LondonDate(Now);","        var classesThisMonth = attended.Count(b =>","        {","            var d = LondonTime.LondonDate(b.Session!.StartsAt);","            return d.Year == today.Year && d.Month == today.Month;","        });","","        var attendedWeeks = attended.Select(b => LondonTime.WeekStart(LondonTime.LondonDate(b.Session!.StartsAt))).ToHashSet();","        var currentWeekStart = LondonTime.WeekStart(today);","        var week = attendedWeeks.Contains(currentWeekStart) ? currentWeekStart : currentWeekStart.AddDays(-7);","        var streak = 0;","        while (attendedWeeks.Contains(week))","        {","            streak++;","            week = week.AddDays(-7);","        }","","        return new Stats(upcoming, classesThisMonth, streak);","    }","","    public async Task<PromotionNotices> ListNotices()","    {","        var bookings = await db.Bookings.AsNoTracking().Include(b => b.Session!)","            .Where(b => b.PromotedAt != null && b.NoticeAcknowledgedAt == null)","            .ToListAsync();","","        var notices = bookings.Select(b => new PromotionNotice(","            b.Id, b.SessionId, b.Session!.Name, b.Session.StartsAt,","            $\"Good news! You're off the waitlist and booked for {b.Session.Name} · {LondonTime.DayTime(b.Session.StartsAt)}\")).ToList();","","        return new PromotionNotices(notices);","    }","","    private async Task<BookingEntity?> ActiveBookingFor(int sessionId) =>","        await db.Bookings.AsNoTracking()","            .Where(b => b.SessionId == sessionId && (b.Status == BookingStatus.Booked || b.Status == BookingStatus.Waitlisted))","            .OrderByDescending(b => b.Id)","            .FirstOrDefaultAsync();","","    private async Task<Dictionary<int, BookingEntity>> ActiveBookingsFor(IEnumerable<int> sessionIds)","    {","        var ids = sessionIds.ToList();","        var bookings = await db.Bookings.AsNoTracking()","            .Where(b => ids.Contains(b.SessionId) && (b.Status == BookingStatus.Booked || b.Status == BookingStatus.Waitlisted))","            .ToListAsync();","        return bookings.GroupBy(b => b.SessionId).ToDictionary(g => g.Key, g => g.OrderByDescending(b => b.Id).First());","    }","","    private static string GroupLabel(DateOnly date, DateOnly today)","    {","        if (date == today) return \"Today\";","        if (date == today.AddDays(1)) return \"Tomorrow\";","        return LondonTime.GroupLabel(date);","    }","}"],"path":"App.Api/Services/StudioQueries.cs","removed":[],"status":"A"}],"from":"f74e56fdca86ad460451b1efdc8da431fd8a0f55","lockedNow":{"App.Tests/AcceptanceTests.cs":"daba42c796d7ecd5a3f450496fc6649c542da32a3fa56e9f0c45132e17f98512","App.Tests/BookingTests.cs":"da4eb70b626ba96be1872acf3588355a756c267da2d606e2212cfc7aa45bd893","App.Tests/ContractSupport.cs":"ba8fab9883217f467d4b0420ecc2f5bbcaeac961ededb811fccfffd7c0df8845","App.Tests/ContractTests.cs":"2da4e1db11d71a4b5b0f4c15c41a06474d70715b0b87d64f1d43cf596c43a8c8","App.Tests/MyBookingsTests.cs":"e5e3c7fd2b48b70e912a7da3e874e3dcddc1f3245e51922fe76b3173b83ca1d6","App.Tests/ScheduleTests.cs":"eba3604873885d