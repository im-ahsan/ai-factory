+using System.Text.Json;
+using App.Api.Contracts;
+using Microsoft.AspNetCore.Diagnostics;
+
+namespace App.Api.Infrastructure;
+
+/// <summary>Turns every unhandled exception or empty-bodied error response into the contract's Error shape, without leaking exception details.</summary>
+public static class ErrorHandling
+{
+    private static readonly Error NotFound = new(ApiException.NotFound().Code, ApiException.NotFound().Message, null);
+    private static readonly Error Invalid = new(ApiException.Invalid().Code, ApiException.Invalid().Message, null);
+    private static readonly Error StorageFailure = new("storage_failure", "We couldn't save your changes just now. Please try again.", null);
+
+    public static void UseStudioErrorHandling(this WebApplication app)
+    {
+        app.UseExceptionHandler(handler => handler.Run(async context =>
+        {
+            var ex = context.Features.Get<IExceptionHandlerFeature>()?.Error;
+
+            var error = ex switch
+            {
+                ApiException api => new Error(api.Code, api.Message, api.Session),
+                BadHttpRequestException or { InnerException: JsonException } => Invalid,
+                _ => StorageFailure,
+            };
+
+            if (error == StorageFailure)
+                app.Logger.LogError(ex, "Unhandled exception");
+
+            context.Response.StatusCode = ex is ApiException apiEx ? apiEx.Status : error == Invalid ? 400 : 500;
+            await context.Response.WriteAsJsonAsync(error);
+        }));
+
+        app.UseStatusCodePages(async statusCodeContext =>
+        {
+            var response = statusCodeContext.HttpContext.Response;
+            var error = response.StatusCode switch
+            {
+                404 => NotFound,
+                >= 400 and < 500 => Invalid,
+                _ => StorageFailure,
+            };
+            await response.WriteAsJsonAsync(error);
+        });
+    }
+}
