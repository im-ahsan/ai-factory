+using App.Api.Contracts;
+using Microsoft.OpenApi.Any;
+using Microsoft.OpenApi.Models;
+
+namespace App.Api.OpenApi;
+
+/// <summary>Configures OpenAPI document generation so the built document (App.Api/openapi/built.json) lines up with contracts/openapi.yaml:
+/// the /api server url (routes are mapped without the prefix) and the inline durationMin enum on Session.</summary>
+public static class ContractOpenApi
+{
+    public static IServiceCollection AddContractOpenApi(this IServiceCollection services) =>
+        services.AddOpenApi(options =>
+        {
+            options.AddDocumentTransformer((document, _, _) =>
+            {
+                document.Servers = [new OpenApiServer { Url = "/api" }];
+                return Task.CompletedTask;
+            });
+
+            options.AddSchemaTransformer((schema, context, _) =>
+            {
+                if (context.JsonTypeInfo.Type == typeof(Session) && schema.Properties.TryGetValue("durationMin", out var durationMin))
+                    durationMin.Enum = [new OpenApiInteger(30), new OpenApiInteger(45), new OpenApiInteger(60), new OpenApiInteger(75)];
+                return Task.CompletedTask;
+            });
+        });
+}
