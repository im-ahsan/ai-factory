+/// <summary>Maps the 13 contract operations, mirroring their paths, methods and declared status codes.</summary>
+public static class StudioEndpoints
+{
+    public static void MapStudioEndpoints(this WebApplication app)
+    {
+        app.MapGet("/me", (StudioQueries queries) => queries.GetMember())
+            .WithName("getMember").WithTags("member")
+            .Produces<Member>(200).Produces<Error>(500);
+
+        app.MapGet("/schedule", async (StudioQueries queries, DateOnly? date, ClassType[]? type, Intensity[]? intensity, TimeOfDay[]? timeOfDay) =>
+                await queries.GetSchedule(date, type, intensity, timeOfDay))
+            .WithName("getSchedule").WithTags("schedule")
+            .Produces<Schedule>(200).Produces<Error>(400).Produces<Error>(500);
+
+        app.MapGet("/sessions/{sessionId:int}", async (StudioQueries queries, int sessionId) => await queries.GetSession(sessionId))
+            .WithName("getSession").WithTags("schedule")
+            .Produces<Session>(200).Produces<Error>(404).Produces<Error>(500);
+
+        app.MapPost("/bookings", async (BookingCommands commands, SessionRequest body) =>
+                Results.Created((string?)null, await commands.Create(body.SessionId)))
+            .WithName("createBooking").WithTags("bookings")
+            .Produces<BookingChange>(201).Produces<Error>(400).Produces<Error>(404).Produces<Error>(409).Produces<Error>(500);
+
+        app.MapPost("/bookings/{bookingId:int}/undo", async (BookingCommands commands, int bookingId) => await commands.Undo(bookingId))
+            .WithName("undoBooking").WithTags("bookings")
+            .Produces<UndoResult>(200).Produces<Error>(404).Produces<Error>(409).Produces<Error>(500);
+
+        app.MapPost("/bookings/{bookingId:int}/cancel", async (BookingCommands commands, int bookingId) => await commands.Cancel(bookingId))
+            .WithName("cancelBooking").WithTags("bookings")
+            .Produces<BookingChange>(200).Produces<Error>(404).Produces<Error>(409).Produces<Error>(500);
+
+        app.MapPost("/waitlist", async (BookingCommands commands, SessionRequest body) =>
+                Results.Created((string?)null, await commands.JoinWaitlist(body.SessionId)))
+            .WithName("joinWaitlist").WithTags("bookings")
+            .Produces<BookingChange>(201).Produces<Error>(400).Produces<Error>(404).Produces<Error>(409).Produces<Error>(500);
+
+        app.MapPost("/bookings/{bookingId:int}/leave-waitlist", async (BookingCommands commands, int bookingId) => await commands.LeaveWaitlist(bookingId))
+            .WithName("leaveWaitlist").WithTags("bookings")
+            .Produces<BookingChange>(200).Produces<Error>(404).Produces<Error>(409).Produces<Error>(500);
+
+        app.MapGet("/me/bookings", async (StudioQueries queries) => await queries.GetMyBookings())
+            .WithName("getMyBookings").WithTags("bookings")
+            .Produces<MyBookings>(200).Produces<Error>(500);
+
+        app.MapGet("/me/stats", async (StudioQueries queries) => await queries.GetStats())
+            .WithName("getStats").WithTags("bookings")
+            .Produces<Stats>(200).Produces<Error>(500);
+
+        app.MapGet("/me/promotion-notices", async (StudioQueries queries) => await queries.ListNotices())
+            .WithName("listPromotionNotices").WithTags("bookings")
+            .Produces<PromotionNotices>(200).Produces<Error>(500);
+
+        app.MapPost("/me/promotion-notices/acknowledge", async (BookingCommands commands) =>
+            {
+                await commands.Acknowledge();
+                return Results.NoContent();
+            })
+            .WithName("acknowledgePromotionNotices").WithTags("bookings")
+            .Produces(204).Produces<Error>(500);
+
+        app.MapPost("/test/sessions/{sessionId:int}/simulate-other-member-cancellation", async (BookingCommands commands, int sessionId) => await commands.Simulate(sessionId))
+            .WithName("simulateOtherMemberCancellation").WithTags("test-only")
+            .Produces<SimulationResult>(200).Produces<Error>(404).Produces<Error>(500);
+    }
