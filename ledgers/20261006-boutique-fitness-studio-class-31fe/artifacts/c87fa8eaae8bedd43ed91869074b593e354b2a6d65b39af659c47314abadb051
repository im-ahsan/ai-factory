+using System.Text.Json;
+using App.Api.Contracts;
+using Microsoft.AspNetCore.Diagnostics;
+
+namespace App.Api.Infrastructure;
+
+/// <summary>Turns exceptions and bare error status codes into the contract's Error JSON, without leaking exception details.</summary>
+public static class ErrorHandling
+{
+    public static void UseContractErrorHandling(this WebApplication app)
+    {
+        app.UseExceptionHandler(branch => branch.Run(async context =>
+        {
+            var exception = context.Features.Get<IExceptionHandlerFeature>()?.Error;
+
+            var (status, error) = exception switch
+            {
+                ApiException api => (api.Status, new Error(api.Code, api.Message, api.Session)),
+                BadHttpRequestException or { InnerException: JsonException } =>
+                    (StatusCodes.Status400BadRequest, new Error("invalid_request", "Something about that request wasn't right. Please try again.", null)),
+                _ => (StatusCodes.Status500InternalServerError, new Error("storage_failure", "We couldn't save your changes just now. Please try again.", null)),
+            };
+
+            if (status == StatusCodes.Status500InternalServerError)
+                app.Logger.LogError(exception, "Unhandled exception while processing {Path}", context.Request.Path);
+
+            context.Response.StatusCode = status;
+            await context.Response.WriteAsJsonAsync(error);
+        }));
+
+        app.UseStatusCodePages(async statusCodeContext =>
+        {
+            var response = statusCodeContext.HttpContext.Response;
+            var code = response.StatusCode switch
+            {
+                StatusCodes.Status404NotFound => "not_found",
+                >= 400 and < 500 => "invalid_request",
+                _ => "storage_failure",
+            };
+            var message = code switch
+            {
+                "not_found" => "We couldn't find that class.",
+                "invalid_request" => "Something about that request wasn't right. Please try again.",
+                _ => "We couldn't save your changes just now. Please try again.",
+            };
+            response.ContentType = "application/json";
+            await response.WriteAsJsonAsync(new Error(code, message, null));
+        });
+    }
+}
