{"files":[{"added":["using System.Globalization;","","namespace App.Api.Services;","","/// <summary>All class times, labels and \"today\" are anchored to Europe/London, regardless of server timezone.</summary>","public static class LondonTime","{","    public static readonly TimeZoneInfo Zone = TimeZoneInfo.FindSystemTimeZoneById(\"Europe/London\");","","    public static DateTime ToLondon(DateTime utc) =>","        TimeZoneInfo.ConvertTimeFromUtc(DateTime.SpecifyKind(utc, DateTimeKind.Utc), Zone);","","    public static DateOnly LondonDate(DateTime utc) => DateOnly.FromDateTime(ToLondon(utc));","","    public static DateOnly WeekStart(DateOnly date) => date.AddDays(-(((int)date.DayOfWeek + 6) % 7));","","    public static DateTime StartOfLondonDayUtc(DateOnly date) =>","        TimeZoneInfo.ConvertTimeToUtc(date.ToDateTime(TimeOnly.MinValue, DateTimeKind.Unspecified), Zone);","","    public static TimeOfDay TimeOfDay(DateTime utc)","    {","        var t = ToLondon(utc).TimeOfDay;","        if (t < new TimeSpan(12, 0, 0)) return App.Api.TimeOfDay.Morning;","        if (t < new TimeSpan(17, 0, 0)) return App.Api.TimeOfDay.Afternoon;","        return App.Api.TimeOfDay.Evening;","    }","","    public static string DayTime(DateTime utc) => ToLondon(utc).ToString(\"ddd HH:mm\", CultureInfo.InvariantCulture);","","    public static string Hm(DateTime utc) => ToLondon(utc).ToString(\"HH:mm\", CultureInfo.InvariantCulture);","","    public static string DayLabel(DateOnly date) => date.ToDateTime(TimeOnly.MinValue).ToString(\"ddd d\", CultureInfo.InvariantCulture);","","    public static string GroupLabel(DateOnly date) => date.ToDateTime(TimeOnly.MinValue).ToString(\"ddd d MMM\", CultureInfo.InvariantCulture);","}"],"path":"App.Api/Services/LondonTime.cs","removed":[],"status":"A"},{"added":["using App.Api.Contracts;","using App.Api.Data;","","namespace App.Api.Services;","","/// <summary>Builds the Session and booking-row contract shapes, deriving labels and action state from the current time.</summary>","public sealed class SessionProjection(TimeProvider clock)","{","    public const int BookingOpensDays = 7;","    public const int BookingClosesMinutes = 15;","    public const int LateCancelHours = 2;","    public const int UndoSeconds = 5;","    public const int UpcomingLimit = 10;","","    private DateTime Now => clock.GetUtcNow().UtcDateTime;","","    public Session ToSession(SessionEntity s, BookingEntity? demoActive)","    {","        var spotsLeft = Math.Max(0, s.Capacity - s.BookedCount);","        return new Session(","            s.Id, s.Name, s.Type, s.Intensity,","            new Instructor(s.Instructor!.Id, s.Instructor.Name, s.Instructor.Bio, s.Instructor.AvatarUrl),","            s.Room, s.StartsAt, s.EndsAt, DurationMin(s),","            s.Capacity, s.BookedCount, s.WaitlistCount,","            s.Description,","            s.WhatToBring.Select(w => new WhatToBringItem(w.Title, w.Note)).ToList(),","            s.Status,","            AvailabilityLabel(s, spotsLeft),","            $\"{spotsLeft} of {s.Capacity} spots left\",","            ActionStateFor(s, demoActive, spotsLeft),","            demoActive?.Id);","    }","","    public Booking ToBooking(BookingEntity b) =>","        new(b.Id, b.SessionId, b.Status, b.LateCancel, b.WaitlistPosition, null, b.CreatedAt, b.CancelledAt);","","    public BookingRow ToRow(BookingEntity b)","    {","        var s = b.Session!;","        var started = Now >= s.StartsAt;","        var studioCancelled = s.Status == SessionStatus.CancelledByStudio;","        var ended = Now >= s.EndsAt;","","        var (status, badge) = (studioCancelled, b.Status, ended) switch","        {","            (true, BookingStatus.Booked or BookingStatus.Waitlisted, _) => (BookingStatus.CancelledByStudio, \"Cancelled by studio\"),","            (false, BookingStatus.Booked, true) => (BookingStatus.Attended, \"Attended\"),","            (false, BookingStatus.Waitlisted, _) => (b.Status, $\"Waitlisted #{b.WaitlistPosition}\"),","            (false, BookingStatus.Cancelled, _) => (b.Status, b.LateCancel ? \"Late cancel\" : \"Cancelled\"),","            _ => (b.Status, b.Status.ToString()),","        };","","        var canChange = b.Status is BookingStatus.Booked or BookingStatus.Waitlisted && !started && !studioCancelled;","        var isLateIfCancelledNow = b.Status == BookingStatus.Booked && !started && s.StartsAt - Now < TimeSpan.FromHours(LateCancelHours);","","        return new BookingRow(","            b.Id, b.SessionId, status, b.LateCancel, b.WaitlistPosition, null,","            badge, canChange, isLateIfCancelledNow,","            new SessionSummary(s.Id, s.Name, s.Type, s.Instructor!.Name, s.Room, s.StartsAt, s.EndsAt, DurationMin(s)));","    }","","    private static int DurationMin(SessionEntity s) => (int)(s.EndsAt - s.StartsAt).TotalMinutes;","","    private static string AvailabilityLabel(SessionEntity s, int spotsLeft)","    {","        if (s.Status == SessionStatus.CancelledByStudio) return \"Cancelled\";","        if (spotsLeft == 0) return $\"Full · {s.WaitlistCount} on waitlist\";","        return spotsLeft switch","        {","            1 => \"1 spot left\",","            2 or 3 => $\"Only {spotsLeft} left\",","            _ => $\"{spotsLeft} spots left\",","        };","    }","","    private ActionState ActionStateFor(SessionEntity s, BookingEntity? demoActive, int spotsLeft)","    {","        if (s.Status == SessionStatus.CancelledByStudio) return Disabled(\"Cancelled by studio\");","","        var started = Now >= s.StartsAt;","","        if (demoActive is { Status: BookingStatus.Booked })","        {","            var canChange = !started;","            var lateCancellation = canChange && s.StartsAt - Now < TimeSpan.FromHours(LateCancelHours);","            return new ActionState(\"booked\", canChange, null, null, demoActive.Id, null, null, lateCancellation);","        }","","        if (demoActive is { Status: BookingStatus.Waitlisted })","        {","            if (Now >= s.EndsAt) return Disabled(\"Class has started\");","            return new ActionState(\"waitlisted\", !started, null, demoActive.WaitlistPosition, demoActive.Id, null, null, null);","        }","","        if (started) return Disabled(\"Class has started\");","        if (s.StartsAt - Now > TimeSpan.FromDays(BookingOpensDays)) return Disabled(\"Booking opens 7 days before class\");","        if (s.StartsAt - Now < TimeSpan.FromMinutes(BookingClosesMinutes)) return Disabled(\"Booking closes 15 minutes before class\");","","        return spotsLeft == 0","            ? new ActionState(\"join_waitlist\", true, null, s.WaitlistCount + 1, null, null, null, null)","            : new ActionState(\"book\", true, spotsLeft, null, null, null, null, null);","    }","","    private static ActionState Disabled(string reason) => new(\"disabled\", false, null, null, null, reason, null, null);","}"],"path":"App.Api/Services/SessionProjection.cs","removed":[],"status":"A"}],"from":"7f474897feca6000b7a6a4eb8949bef0c5408bf7","lockedNow":{"App.Tests/AcceptanceTests.cs":"daba42c796d7ecd5a3f450496fc6649c542da32a3fa56e9f0c45132e17f98512","App.Tests/BookingTests.cs":"da4eb70b626ba96be1872acf3588355a756c267da2d606e2212cfc7aa45bd893","App.Tests/ContractSupport.cs":"ba8fab9883217f467d4b0420ecc2f5bbcaeac961ededb811fccfffd7c0df8845","App.Tests/ContractTests.cs":"2da4e1db11d71a4b5b0f4c15c41a06474d70715b0b87d64f1d43cf596c43a8c8","App.Tests/MyBookingsTests.cs":"e5e3c7fd2b48b70e912a7da3e874e3dcddc1f3245e51922fe76b3173b83ca1d6","App.Tests/ScheduleTests.cs":"eba3604873885d85d08c680b62059a95f4f6e861082c0fa671aaaad6252f6e33","App.Tests/SessionTests.cs":"2a45775a32794a3bfd75dd5b7d23f0234960479e703fb1713a1dc96c4c4de9b4","App.Tests/StorageTests.cs":"32e9a4bd9bb6bc4929e301a3de004283fdf51394cd5de7e4a4efc7f78123c3f7","App.Tests/TestSupport.cs":"b394720b18093aa4190952d8fccd978f9548938ea9ba34ffe1ab13c8abe8944a","App.Tests/WaitlistTests.cs":"d8db77f6a4b79f09fc8fbde86b392c