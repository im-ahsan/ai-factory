{"files":[{"added":["using App.Api.Contracts;","using App.Api.Data;","using Microsoft.EntityFrameworkCore;","","namespace App.Api.Services;","","/// <summary>Write-side commands for Alex's bookings: every method runs its checks, row change and count change in one transaction.</summary>","public sealed class BookingCommands(AppDb db, TimeProvider clock, SessionProjection projection)","{","    private DateTime Now => clock.GetUtcNow().UtcDateTime;","","    public async Task<BookingChange> Create(int sessionId)","    {","        await using var tx = await db.Database.BeginTransactionAsync();","","        var session = await LoadSession(sessionId);","        CheckSchedulingWindow(session);","        if (await HasActiveBooking(sessionId)) throw AlreadyBooked();","","        if (session.BookedCount >= session.Capacity)","            throw ApiException.Conflict(\"class_full\", \"This class is full, but you can join the waitlist.\", projection.ToSession(session, null));","","        await CheckOverlap(session);","        await CheckLimit();","","        var booking = new BookingEntity { SessionId = sessionId, Status = BookingStatus.Booked, CreatedAt = Now };","        db.Bookings.Add(booking);","        session.BookedCount++;","        await db.SaveChangesAsync();","        await tx.CommitAsync();","","        var message = $\"You're booked for {session.Name} · {LondonTime.DayTime(session.StartsAt)}\";","        return new BookingChange(projection.ToBooking(booking), projection.ToSession(session, booking), message);","    }","","    public async Task<BookingChange> JoinWaitlist(int sessionId)","    {","        await using var tx = await db.Database.BeginTransactionAsync();","","        var session = await LoadSession(sessionId);","        CheckSchedulingWindow(session);","        if (await HasActiveBooking(sessionId)) throw AlreadyBooked();","        if (session.BookedCount < session.Capacity) throw ApiException.Conflict(\"not_full\", \"This class still has spots, so you can book it instead.\");","","        var position = session.WaitlistCount + 1;","        var booking = new BookingEntity { SessionId = sessionId, Status = BookingStatus.Waitlisted, WaitlistPosition = position, CreatedAt = Now };","        db.Bookings.Add(booking);","        session.WaitlistCount++;","        await db.SaveChangesAsync();","        await tx.CommitAsync();","","        var message = $\"You're on the waitlist for {session.Name} · {LondonTime.DayTime(session.StartsAt)} — you're #{position}\";","        return new BookingChange(projection.ToBooking(booking), projection.ToSession(session, booking), message);","    }","","    public async Task<BookingChange> Cancel(int bookingId)","    {","        await using var tx = await db.Database.BeginTransactionAsync();","","        var booking = await LoadBooking(bookingId);","        if (booking.Status != BookingStatus.Booked) throw InvalidState();","        var session = booking.Session!;","        if (Now >= session.StartsAt) throw ClassHasStarted();","","        booking.Status = BookingStatus.Cancelled;","        booking.CancelledAt = Now;","        booking.LateCancel = session.StartsAt - Now < TimeSpan.FromHours(SessionProjection.LateCancelHours);","","        if (session.WaitlistCount > 0) session.WaitlistCount--;","        else session.BookedCount = Math.Max(0, session.BookedCount - 1);","","        await db.SaveChangesAsync();","        await tx.CommitAsync();","","        var message = $\"Booking cancelled — {session.Name}, {CancelTimeLabel(session.StartsAt)}\";","        return new BookingChange(projection.ToBooking(booking), projection.ToSession(session, null), message);","    }","","    public async Task<BookingChange> LeaveWaitlist(int bookingId)","    {","        await using var tx = await db.Database.BeginTransactionAsync();","","        var booking = await LoadBooking(bookingId);","        if (booking.Status != BookingStatus.Waitlisted) throw InvalidState();","        var session = booking.Session!;","        if (Now >= session.StartsAt) throw ClassHasStarted();","","        booking.Status = BookingStatus.Cancelled;","        booking.LateCancel = false;","        booking.WaitlistPosition = null;","        booking.CancelledAt = Now;","        session.WaitlistCount = Math.Max(0, session.WaitlistCount - 1);","","        await db.SaveChangesAsync();","        await tx.CommitAsync();","","        var message = $\"You've left the waitlist for {session.Name}\";","        return new BookingChange(projection.ToBooking(booking), projection.ToSession(session, null), message);","    }","","    public async Task<UndoResult> Undo(int bookingId)","    {","        await using var tx = await db.Database.BeginTransactionAsync();","","        var booking = await LoadBooking(bookingId);","        if (booking.Status != BookingStatus.Booked || booking.PromotedAt != null) throw InvalidState();","        if (Now - booking.CreatedAt > TimeSpan.FromSeconds(SessionProjection.UndoSeconds))","            throw ApiException.Conflict(\"undo_expired\", \"Undo is no longer available for this booking.\");","","        var session = booking.Session!;","        db.Bookings.Remove(booking);","        session.BookedCount = Math.Max(0, session.BookedCount - 1);","        await db.SaveChangesAsync();","        await tx.CommitAsync();","","        return new UndoResult(projection.ToSession(session, null), $\"Booking undone — {session.Name}\");","    }","","    public async Task<SimulationResult> Simulate(int sessionId)","    {","        await using var tx = await db.Database.BeginTransactionAsync();","","        var session = await LoadSession(sessionId);","        var demo = await db.Bookings.FirstOrDefaultAsync(b => b.SessionId == sessionId && b.Status == BookingStatus.Waitlisted);","","        if (demo is { WaitlistPosition: 1 })","        {","            demo.Status = BookingStatus.Booked;","            demo.WaitlistPosition = null;","            demo.PromotedAt = Now;","            session.WaitlistCount = Math.Max(0, session.WaitlistCount - 1);","        }","        else if (session.WaitlistCount > 0)","        {","            session.WaitlistCount--;","            if (demo != null) demo.WaitlistPosition--;","        }","        else","        {","            var demoBookedCount = await db.Bookings.CountAsync(b => b.SessionId == sessionId && b.Status == BookingStatus.Booked);","            session.BookedCount = Math.Max(demoBookedCount, session.BookedCount - 1);","        }","","        await db.SaveChangesAsync();","        await tx.CommitAsync();","","        return new SimulationResult(projection.ToSession(session, demo), demo is null ? null : projection.ToBooking(demo));","    }","","    public async Task Acknowledge()","    {","        await using var tx = await db.Database.BeginTransactionAsync();","","        var pending = await db.Bookings.Where(b => b.PromotedAt != null && b.NoticeAcknowledgedAt == null).ToListAsync();","        foreach (var b in pending) b.NoticeAcknowledgedAt = Now;","","        await db.SaveChangesAsync();","        await tx.CommitAsync();","    }","","    private async Task<SessionEntity> LoadSession(int sessionId) =>","        await db.Sessions.Include(s => s.Instructor).FirstOrDefaultAsync(s => s.Id == sessionId) ?? throw ApiException.NotFound();","","    private async Task<BookingEntity> LoadBooking(int bookingId) =>","        await db.Bookings.Include(b => b.Session!).ThenInclude(s => s.Instructor).FirstOrDefaultAsync(b => b.Id == bookingId) ?? throw ApiException.NotFound();","","    private Task<bool> HasActiveBooking(int sessionId) =>","        db.Bookings.AnyAsync(b => b.SessionId == sessionId && (b.Status == BookingStatus.Booked || b.Status == BookingStatus.Waitlisted));","","    private void CheckSchedulingWindow(SessionEntity session)","    {","        if (session.Status == SessionStatus.CancelledByStudio)","            throw ApiException.Conflict(\"cancelled_by_studio\", \"This class was cancelled by the studio.\");","        if (Now >= session.StartsAt) throw ClassHasStarted();","        if (session.StartsAt - Now > TimeSpan.FromDays(SessionProjection.BookingOpensDays)","            || session.StartsAt - Now < TimeSpan.FromMinutes(SessionProjection.BookingClosesMinutes))","            throw ApiException.Conflict(\"outside_booking_window\", \"Bookings open 7 days before a class and close 15 minutes before it starts.\");","    }","","    private async Task CheckOverlap(SessionEntity session)","    {","        var clash = await db.Bookings.Include(b => b.Session)","            .Where(b => b.Status == BookingStatus.Booked","                && b.Session!.Status != SessionStatus.CancelledByStudio","                && b.Session.EndsAt > Now","                && b.Session.StartsAt < session.EndsAt && session.StartsAt < b.Session.EndsAt)","            .Select(b => b.Session!)","            .FirstOrDefaultAsync();","        if (clash != null)","            throw ApiException.Conflict(\"overlap\", $\"You're already booked for {clash.Name} at {LondonTime.Hm(clash.StartsAt)}–{LondonTime.Hm(clash.EndsAt)}.\");","    }","","    private async Task CheckLimit()","    {","        var upcoming = await db.Bookings.CountAsync(b => b.Status == BookingStatus.Booked && b.Session!.StartsAt > Now);","        if (upcoming >= SessionProjection.UpcomingLimit)","            throw ApiException.Conflict(\"limit_reached\", $\"You've reached the limit of {SessionProjection.UpcomingLimit} upcoming classes.\");","    }","","    private string CancelTimeLabel(DateTime startsAt) =>","        LondonTime.LondonDate(startsAt) == LondonTime.LondonDate(Now) ? $\"today {LondonTime.Hm(startsAt)}\" : LondonTime.DayTime(startsAt);","","    private static ApiException AlreadyBooked() =>","        ApiException.Conflict(\"already_booked\", \"You already have a booking for this class.\");","","    private static ApiException InvalidState() =>","        ApiException.Conflict(\"invalid_booking_state\", \"This booking can't be changed any more. Refresh to see its latest status.\");","","    private static ApiException ClassHasStarted() =>","        ApiException.Conflict(\"class_has_started\", \"This class has already started, so it can't be changed.\");","}"],"path":"App.Api/Services/BookingCommands.cs","removed":[],"status":"A"}],"from":"0afc1ddaa2beea3b539a5faba0f0a9f54bda0848","lockedNow":{"App.Tests/AcceptanceTests.cs":"daba42c796d7ecd5a3f450496fc6649c542da32a3fa56e9f0c45132e17f98512","App.Tests/BookingTests.cs":"da4eb70b626ba96be1872acf3588355a756c267da2d606e2212cfc7aa45bd893","App.Tests/ContractSupport.cs":"ba8fab9883217f467d4b0420ecc2f5bbcaeac961ededb811fccfffd7c0df8845","App.Tests/ContractTests.cs":"2da4e1db11d71a4b5b0f4c15c41a06474d70715b0b87d64f1d43cf596c43a8c8","App.Tests/MyBookingsTests.cs":"e5e3c7fd2b48b70e912a7da3e874e3dcddc1f3245e51922fe76b3173b83ca1d6","App.Tests/ScheduleTests.cs":"eba3604873885d85d08c680b62059a95f4f6e861082c0fa671aaaad6252f6e33","App.Tests/SessionTests.cs":"2a45775a32794a3bfd75dd5b7d23f0234960479e703fb1713a1dc96c4c4de9b4","App.Tests/StorageTests.cs":"32e9a4bd9bb6bc4929e301a3de004283fdf51394cd5de7e4a4efc7f78123c3f7","App.Tests/TestSupport.cs":"b394720b18093aa4190952d8fccd978f9548938ea9ba34ffe1ab13c8abe8944a","App.Tests/WaitlistTests.cs":"d8db77f6a4b79f09fc8fbde86b392cec7f847ae26c1c17ca11a1c0350b358b25","contracts/openapi.yaml":"c54e5fc3a2c17dc183a7fe589ea1976ec3dc19c1059ea417be9cba29bc9c393e"},"to":"9da505ab1b14a519fd3b5f33f58982002eb1bb3e"}