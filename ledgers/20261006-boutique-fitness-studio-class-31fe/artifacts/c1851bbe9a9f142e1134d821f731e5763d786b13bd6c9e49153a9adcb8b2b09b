+using System.Text.Json;
+using App.Api.Contracts;
+using Microsoft.AspNetCore.Diagnostics;
+
+namespace App.Api.Infrastructure;
+
+/// <summary>Turns every unhandled exception and every bodiless error response into the contract's Error shape.</summary>
+public static class ErrorHandling
+{
+    public static void UseApiErrorHandling(this WebApplication app)
+    {
+        app.UseExceptionHandler(builder => builder.Run(async context =>
+        {
+            var error = context.Features.Get<IExceptionHandlerFeature>()?.Error;
+
+            var (status, code, message, session) = error switch
+            {
+                ApiException ex => (ex.Status, ex.Code, ex.Message, ex.Session),
+                BadHttpRequestException or { InnerException: JsonException } =>
+                    (400, "invalid_request", "Something about that request wasn't right. Please try again.", null),
+                _ => (500, "storage_failure", "We couldn't save your changes just now. Please try again.", null),
+            };
+
+            if (status == 500) app.Logger.LogError(error, "Unhandled exception");
+
+            context.Response.StatusCode = status;
+            await context.Response.WriteAsJsonAsync(new Error(code, message, session));
+        }));
+
+        app.UseStatusCodePages(async context =>
+        {
+            var response = context.HttpContext.Response;
+            if (response.HasStarted || response.ContentLength is > 0) return;
+
+            var (code, message) = response.StatusCode switch
+            {
+                404 => ("not_found", "We couldn't find that class."),
+                >= 500 => ("storage_failure", "We couldn't save your changes just now. Please try again."),
+                _ => ("invalid_request", "Something about that request wasn't right. Please try again."),
+            };
+
+            response.ContentType = "application/json";
+            await response.WriteAsJsonAsync(new Error(code, message, null));
+        });
+    }
+}
