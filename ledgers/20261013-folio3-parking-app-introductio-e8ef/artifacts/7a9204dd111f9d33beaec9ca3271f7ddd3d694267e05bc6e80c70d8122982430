+using System.Security.Cryptography;
+using System.Text;
+using App.Api.Entities;
+using Microsoft.EntityFrameworkCore;
+
+namespace App.Api.Services;
+
+public static class ApiAuth
+{
+    private static readonly byte[] SigningKey = RandomNumberGenerator.GetBytes(32);
+
+    public static string CreateAccessToken(int employeeId)
+    {
+        var payload = Base64UrlEncode(Encoding.UTF8.GetBytes($"{employeeId}:{Convert.ToHexString(RandomNumberGenerator.GetBytes(24))}"));
+        var signature = HMACSHA256.HashData(SigningKey, Encoding.UTF8.GetBytes(payload));
+        return $"{payload}.{Base64UrlEncode(signature)}";
+    }
+
+    public static string HashAccessToken(string accessToken) =>
+        Convert.ToHexString(SHA256.HashData(Encoding.UTF8.GetBytes(accessToken))).ToLowerInvariant();
+
+    public static DateTime UtcNowToMicrosecond()
+    {
+        var utcNow = DateTime.UtcNow;
+        return new DateTime(utcNow.Ticks - utcNow.Ticks % 10, DateTimeKind.Utc);
+    }
+
+    public static async Task<EmployeeAuthentication> AuthenticateEmployeeAsync(
+        HttpContext context,
+        AppDb db,
+        CancellationToken cancellationToken = default)
+    {
+        var accessToken = context.Request.Headers.Authorization.ToString();
+        if (!accessToken.StartsWith("Bearer ", StringComparison.OrdinalIgnoreCase))
+            return new EmployeeAuthentication(null, false);
+
+        accessToken = accessToken[7..].Trim();
+        if (accessToken.Length == 0) return new EmployeeAuthentication(null, false);
+
+        var tokenHash = HashAccessToken(accessToken);
+        var session = await db.AuthSessions.AsNoTracking()
+            .Include(item => item.Employee)
+            .FirstOrDefaultAsync(item => item.TokenHash == tokenHash && item.ExpiresAt > UtcNowToMicrosecond(), cancellationToken);
+        if (session?.Employee is not null) return new EmployeeAuthentication(session.Employee, false);
+
+        if (TryReadEmployeeId(accessToken, out var employeeId) &&
+            !await db.Employees.AnyAsync(employee => employee.Id == employeeId, cancellationToken))
+            return new EmployeeAuthentication(null, true);
+
+        return new EmployeeAuthentication(null, false);
+    }
+
+    private static bool TryReadEmployeeId(string accessToken, out int employeeId)
+    {
+        employeeId = 0;
+        var segments = accessToken.Split('.');
+        if (segments.Length != 2) return false;
+
+        try
+        {
+            var expected = HMACSHA256.HashData(SigningKey, Encoding.UTF8.GetBytes(segments[0]));
+            var supplied = Base64UrlDecode(segments[1]);
+            if (!CryptographicOperations.FixedTimeEquals(expected, supplied)) return false;
+
+            var payload = Encoding.UTF8.GetString(Base64UrlDecode(segments[0]));
+            var separator = payload.IndexOf(':');
+            return separator > 0 && int.TryParse(payload.AsSpan(0, separator), out employeeId) && employeeId > 0;
+        }
+        catch (FormatException)
+        {
+            return false;
+        }
+    }
+
+    private static string Base64UrlEncode(byte[] value) => Convert.ToBase64String(value).TrimEnd('=').Replace('+', '-').Replace('/', '_');
+
+    private static byte[] Base64UrlDecode(string value)
+    {
+        var normalized = value.Replace('-', '+').Replace('_', '/');
+        normalized += (normalized.Length % 4) switch { 2 => "==", 3 => "=", _ => "" };
+        return Convert.FromBase64String(normalized);
+    }
+}
+
+public sealed record EmployeeAuthentication(Employee? Employee, bool IssuedTokenForMissingEmployee);
