+                    Make = "Honda",
+                    Model = "Civic",
+                    Color = "White",
+                    Active = true
+                });
+        }
+
+        var createdAt = Services.ApiAuth.UtcNowToMicrosecond();
+        if (!db.AuthSessions.Any())
+        {
+            foreach (var employee in employees)
+            {
+                db.AuthSessions.Add(new AuthSession
+                {
+                    EmployeeId = employee.Id,
+                    TokenHash = HashDemoToken(employee.Id),
+                    CreatedAt = createdAt,
+                    ExpiresAt = createdAt.AddHours(12)
+                });
