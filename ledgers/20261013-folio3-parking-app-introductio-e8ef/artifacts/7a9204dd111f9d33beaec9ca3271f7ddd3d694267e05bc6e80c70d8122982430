+                new Employee
+                {
+                    EmployeeId = "F3-1042",
+                    EmployeeName = "Aisha Rahman",
+                    CorporateEmail = "aisha.rahman@folio3.com",
+                    Role = "employee",
+                    DedicatedParking = true,
+                    AssignedFloor = "B2",
