+                    EmployeeName = "Bilal Ahmed",
+                    CorporateEmail = "bilal.ahmed@folio3.com",
+                    Role = "employee",
+                    DedicatedParking = false
+                });
+            db.SaveChanges();
+        }
+
+        var employees = db.Employees.OrderBy(employee => employee.Id).Take(2).ToList();
+        if (!db.Vehicles.Any() && employees.Count >= 2)
+        {
+            db.Vehicles.AddRange(
