 using Microsoft.EntityFrameworkCore;
+using App.Api.Entities;
 
 namespace App.Api;
 
 public class AppDb(DbContextOptions<AppDb> options) : DbContext(options)
 {
+    public DbSet<Employee> Employees => Set<Employee>();
+    public DbSet<Vehicle> Vehicles => Set<Vehicle>();
+    public DbSet<AuthSession> AuthSessions => Set<AuthSession>();
+    public DbSet<OAuthState> OAuthStates => Set<OAuthState>();
+
+    protected override void OnModelCreating(ModelBuilder modelBuilder)
+    {
+        var entityTypes = typeof(IAppEntity).Assembly.GetTypes()
+            .Where(type => type is { IsClass: true, IsAbstract: false } && typeof(IAppEntity).IsAssignableFrom(type));
+
+        foreach (var type in entityTypes)
+        {
+            var entity = modelBuilder.Entity(type);
+            entity.ToTable(type.Name);
+
+            foreach (var property in type.GetProperties().Where(property => property.PropertyType.IsEnum))
+                entity.Property(property.Name).HasConversion<string>();
+        }
+
+        modelBuilder.Entity<Employee>().HasIndex(employee => employee.EmployeeId).IsUnique();
+        modelBuilder.Entity<Employee>().HasIndex(employee => employee.CorporateEmail).IsUnique();
+        modelBuilder.Entity<Vehicle>().HasIndex(vehicle => vehicle.Plate).IsUnique();
+        modelBuilder.Entity<AuthSession>().HasIndex(session => session.TokenHash).IsUnique();
+        modelBuilder.Entity<OAuthState>().HasIndex(state => state.State).IsUnique();
+
+        modelBuilder.Entity<Vehicle>().HasOne(vehicle => vehicle.Employee).WithMany(employee => employee.Vehicles)
+            .HasForeignKey(vehicle => vehicle.EmployeeId).OnDelete(DeleteBehavior.Cascade);
+        modelBuilder.Entity<AuthSession>().HasOne(session => session.Employee).WithMany(employee => employee.AuthSessions)
+            .HasForeignKey(session => session.EmployeeId).OnDelete(DeleteBehavior.Cascade);
+    }
 }
diff --git a/App.Api/Endpoints/AuthAndVehicleEndpoints.cs b/App.Api/Endpoints/AuthAndVehicleEndpoints.cs
new file mode 100644
index 0000000..c85d920
--- /dev/null
+++ b/App.Api/Endpoints/AuthAndVehicleEndpoints.cs
@@ -0,0 +1,328 @@
+using System.ComponentModel.DataAnnotations;
+using System.Net;
+using System.Security.Cryptography;
+using System.Text.Json.Serialization;
+using App.Api.Entities;
+using VehicleEntity = App.Api.Entities.Vehicle;
+using App.Api.Integrations;
+using App.Api.Services;
+using Microsoft.EntityFrameworkCore;
+
+namespace App.Api.Endpoints;
+
+public sealed class AuthAndVehicleEndpoints : IEndpointModule
+{
+    private const string UnauthorizedMessage = "A valid Folio3 Workspace session is required.";
+    private const string ForbiddenMessage = "You are not authorized to access this resource.";
+    private const string NotFoundMessage = "The requested parking record was not found.";
+    private const string InvalidMessage = "The request is invalid.";
+    private const string ConflictMessage = "The parking record has already changed state.";
+    private const string UnavailableMessage = "The service is temporarily unavailable.";
+
+    public void MapEndpoints(IEndpointRouteBuilder app)
+    {
+        var api = app.MapGroup("/api");
+
+        api.MapGet("/auth/google/authorization", GetGoogleAuthorizationAsync)
+            .WithName("getGoogleAuthorization")
+            .WithSummary("Get the Folio3 Google Workspace authorization URL")
+            .Produces<AuthorizationStart>(StatusCodes.Status200OK)
+            .Produces<ApiError>(StatusCodes.Status503ServiceUnavailable);
+
+        api.MapPost("/auth/sign-in", SignInAsync)
+            .WithName("signIn")
+            .WithSummary("Exchange a Google Workspace authorization code for a Folio3 session")
+            .Accepts<SignInRequest>("application/json")
+            .Produces<Session>(StatusCodes.Status200OK)
+            .Produces<ApiError>(StatusCodes.Status400BadRequest)
+            .Produces<ApiError>(StatusCodes.Status401Unauthorized)
+            .Produces<ApiError>(StatusCodes.Status503ServiceUnavailable);
+
+        api.MapGet("/employees/me", GetMyEmployeeProfileAsync)
+            .WithName("getMyEmployeeProfile")
+            .WithSummary("Get the signed-in employee profile")
+            .Produces<EmployeeProfile>(StatusCodes.Status200OK)
+            .Produces<ApiError>(StatusCodes.Status401Unauthorized)
+            .Produces<ApiError>(StatusCodes.Status403Forbidden)
+            .Produces<ApiError>(StatusCodes.Status404NotFound);
+
+        api.MapGet("/vehicles", ListMyVehiclesAsync)
+            .WithName("listMyVehicles")
+            .WithSummary("List the signed-in employee's registered vehicles")
+            .Produces<VehicleCollection>(StatusCodes.Status200OK)
+            .Produces<ApiError>(StatusCodes.Status401Unauthorized);
+
+        api.MapPost("/vehicles", RegisterVehicleAsync)
+            .WithName("registerVehicle")
+            .WithSummary("Register and immediately activate a vehicle plate")
+            .Accepts<VehicleInput>("application/json")
+            .Produces<Vehicle>(StatusCodes.Status201Created)
+            .Produces<ApiError>(StatusCodes.Status400BadRequest)
+            .Produces<ApiError>(StatusCodes.Status401Unauthorized)
+            .Produces<ApiError>(StatusCodes.Status409Conflict);
+    }
+
+    private static async Task<IResult> GetGoogleAuthorizationAsync(
+        AppDb db,
+        IWorkspaceOAuthClient oauth,
+        CancellationToken cancellationToken)
+    {
+        var state = Convert.ToHexString(RandomNumberGenerator.GetBytes(32)).ToLowerInvariant();
+        try
+        {
+            var authorizationUrl = await oauth.CreateAuthorizationUrlAsync(state, cancellationToken);
+            var createdAt = ApiAuth.UtcNowToMicrosecond();
+            db.OAuthStates.Add(new OAuthState
+            {
+                State = state,
+                CreatedAt = createdAt,
+                ExpiresAt = createdAt.AddMinutes(10)
+            });
+            await db.SaveChangesAsync(cancellationToken);
+            return Results.Ok(new AuthorizationStart(authorizationUrl, state));
+        }
+        catch (Exception exception) when (exception is HttpRequestException or InvalidOperationException)
+        {
+            return Error(StatusCodes.Status503ServiceUnavailable, "service_unavailable", UnavailableMessage, null);
+        }
+    }
+
+    private static async Task<IResult> SignInAsync(
+        HttpRequest request,
+        AppDb db,
+        IWorkspaceOAuthClient oauth,
+        CancellationToken cancellationToken)
+    {
+        string? authorizationCode = null;
+        string? requestedState = null;
+        try
+        {
+            using var document = await System.Text.Json.JsonDocument.ParseAsync(
+                request.Body, cancellationToken: cancellationToken);
+            var root = document.RootElement;
+            if (root.ValueKind == System.Text.Json.JsonValueKind.String)
+            {
+                using var nestedDocument = System.Text.Json.JsonDocument.Parse(root.GetString() ?? "");
+                root = nestedDocument.RootElement.Clone();
+            }
+            if (root.ValueKind == System.Text.Json.JsonValueKind.Object)
+            {
+                authorizationCode = ReadStringProperty(root, "authorizationCode");
+                requestedState = ReadStringProperty(root, "state");
+            }
+        }
+        catch (System.Text.Json.JsonException)
+        {
+            // Malformed bodies use the contract's field-level request error below.
+        }
+
+        if (string.IsNullOrWhiteSpace(authorizationCode))
+            return Error(StatusCodes.Status400BadRequest, "bad_request", InvalidMessage, "authorizationCode");
+        if (string.IsNullOrWhiteSpace(requestedState))
+            return Error(StatusCodes.Status400BadRequest, "bad_request", InvalidMessage, "state");
+
+        var state = await db.OAuthStates.SingleOrDefaultAsync(item => item.State == requestedState, cancellationToken);
+        if (state is null || state.ExpiresAt <= ApiAuth.UtcNowToMicrosecond())
+        {
+            if (state is not null)
+            {
+                db.OAuthStates.Remove(state);
+                await db.SaveChangesAsync(cancellationToken);
+            }
+            return Error(StatusCodes.Status400BadRequest, "bad_request", InvalidMessage, "state");
+        }
+
+        db.OAuthStates.Remove(state);
+        await db.SaveChangesAsync(cancellationToken);
+
+        IReadOnlyDictionary<string, string>? claims;
+        try
+        {
+            claims = await oauth.ExchangeAuthorizationCodeAsync(authorizationCode, requestedState, cancellationToken);
+        }
+        catch (Exception exception) when (exception is HttpRequestException or InvalidOperationException or TaskCanceledException)
+        {
+            return Error(StatusCodes.Status503ServiceUnavailable, "service_unavailable", UnavailableMessage, null);
+        }
+
+        if (claims is null)
+            return Error(StatusCodes.Status400BadRequest, "bad_request", InvalidMessage, "authorizationCode");
+
+        var email = GetClaim(claims, "email");
+        var emailVerified = GetClaim(claims, "email_verified");
+        if (!string.Equals(emailVerified, "true", StringComparison.OrdinalIgnoreCase) ||
+            string.IsNullOrWhiteSpace(email) || !email.EndsWith("@folio3.com", StringComparison.OrdinalIgnoreCase))
+            return Error(StatusCodes.Status401Unauthorized, "unauthorized", UnauthorizedMessage, null);
+
+        var employee = await db.Employees.SingleOrDefaultAsync(
+            item => item.CorporateEmail.ToLower() == email.ToLower(), cancellationToken);
+        if (employee is null || employee.Role is not ("employee" or "administrator"))
+            return Error(StatusCodes.Status401Unauthorized, "unauthorized", UnauthorizedMessage, null);
+
+        var accessToken = ApiAuth.CreateAccessToken(employee.Id);
+        var createdAt = ApiAuth.UtcNowToMicrosecond();
+        db.AuthSessions.Add(new AuthSession
+        {
+            EmployeeId = employee.Id,
+            TokenHash = ApiAuth.HashAccessToken(accessToken),
+            CreatedAt = createdAt,
+            ExpiresAt = createdAt.AddHours(12)
+        });
+        await db.SaveChangesAsync(cancellationToken);
+
+        return Results.Ok(new Session(
+            employee.Id,
+            employee.EmployeeId,
+            employee.EmployeeName,
+            employee.CorporateEmail,
+            employee.Role == "employee" ? SessionRole.employee : SessionRole.administrator,
+            accessToken));
+    }
+
+    private static async Task<IResult> GetMyEmployeeProfileAsync(
+        HttpContext context,
+        AppDb db,
+        CancellationToken cancellationToken)
+    {
+        var authentication = await ApiAuth.AuthenticateEmployeeAsync(context, db, cancellationToken);
+        if (authentication.Employee is null)
+        {
+            if (authentication.IssuedTokenForMissingEmployee)
+                return Error(StatusCodes.Status404NotFound, "not_found", NotFoundMessage, null);
+            return Error(StatusCodes.Status401Unauthorized, "unauthorized", UnauthorizedMessage, null);
+        }
+
+        var employee = authentication.Employee;
+        if (employee.Role != "employee")
+            return Error(StatusCodes.Status403Forbidden, "forbidden", ForbiddenMessage, null);
+
+        var vehicles = await db.Vehicles.AsNoTracking().Where(vehicle => vehicle.EmployeeId == employee.Id)
+            .OrderBy(vehicle => vehicle.Id).Select(vehicle => ToVehicleResponse(vehicle)).ToListAsync(cancellationToken);
+        return Results.Ok(new EmployeeProfile(
+            employee.Id,
+            employee.EmployeeId,
+            employee.EmployeeName,
+            employee.CorporateEmail,
+            employee.DedicatedParking,
+            employee.AssignedFloor,
+            employee.AssignedSpace,
+            vehicles));
+    }
+
+    private static async Task<IResult> ListMyVehiclesAsync(
+        HttpContext context,
+        AppDb db,
+        CancellationToken cancellationToken)
+    {
+        var authentication = await ApiAuth.AuthenticateEmployeeAsync(context, db, cancellationToken);
+        if (authentication.Employee is null)
+            return Error(StatusCodes.Status401Unauthorized, "unauthorized", UnauthorizedMessage, null);
+
+        var vehicles = await db.Vehicles.AsNoTracking().Where(vehicle => vehicle.EmployeeId == authentication.Employee.Id)
+            .OrderBy(vehicle => vehicle.Id).Select(vehicle => ToVehicleResponse(vehicle)).ToListAsync(cancellationToken);
+        return Results.Ok(new VehicleCollection(vehicles));
+    }
+
+    private static async Task<IResult> RegisterVehicleAsync(
+        VehicleInput request,
+        HttpContext context,
+        AppDb db,
+        CancellationToken cancellationToken)
+    {
+        var authentication = await ApiAuth.AuthenticateEmployeeAsync(context, db, cancellationToken);
+        if (authentication.Employee is null)
+            return Error(StatusCodes.Status401Unauthorized, "unauthorized", UnauthorizedMessage, null);
+        if (string.IsNullOrWhiteSpace(request.Plate))
+            return Error(StatusCodes.Status400BadRequest, "bad_request", InvalidMessage, "plate");
+
+        var plate = request.Plate.Trim();
+        if (await db.Vehicles.AnyAsync(vehicle => vehicle.Plate == plate, cancellationToken))
+            return Error(StatusCodes.Status409Conflict, "conflict", ConflictMessage, "plate");
+
+        var vehicle = new VehicleEntity
+        {
+            EmployeeId = authentication.Employee.Id,
+            Plate = plate,
+            Make = request.Make,
+            Model = request.Model,
+            Color = request.Color,
+            Active = true
+        };
+        db.Vehicles.Add(vehicle);
+        try
+        {
+            await db.SaveChangesAsync(cancellationToken);
+        }
+        catch (DbUpdateException exception) when (exception.InnerException is Npgsql.PostgresException
+               { SqlState: Npgsql.PostgresErrorCodes.UniqueViolation })
+        {
+            return Error(StatusCodes.Status409Conflict, "conflict", ConflictMessage, "plate");
+        }
+
+        return Results.Created($"/api/vehicles/{vehicle.Id}", ToVehicleResponse(vehicle));
+    }
+
+    private static string? GetClaim(IReadOnlyDictionary<string, string> claims, string claimName) =>
+        claims.FirstOrDefault(claim => string.Equals(claim.Key, claimName, StringComparison.OrdinalIgnoreCase)).Value;
+
+    private static string? ReadStringProperty(System.Text.Json.JsonElement root, string name)
+    {
+        foreach (var property in root.EnumerateObject())
+            if (string.Equals(property.Name, name, StringComparison.OrdinalIgnoreCase) &&
+                property.Value.ValueKind == System.Text.Json.JsonValueKind.String)
+                return property.Value.GetString();
+        return null;
+    }
+
+    private static Vehicle ToVehicleResponse(VehicleEntity vehicle) =>
+        new(vehicle.Id, vehicle.Plate, vehicle.Make, vehicle.Model, vehicle.Color, vehicle.Active);
+
+    private static IResult Error(int statusCode, string code, string message, string? field) =>
+        Results.Json(new ApiError(code, message, field), statusCode: statusCode);
+}
+
+public sealed record SignInRequest
+{
+    [Required]
+    public string AuthorizationCode { get; init; } = "";
+
+    [Required]
+    public string State { get; init; } = "";
+}
+
+public sealed record VehicleInput
+{
+    [Required]
+    public string Plate { get; init; } = "";
+    public string? Make { get; init; }
+    public string? Model { get; init; }
+    public string? Color { get; init; }
+}
+
+public sealed record ApiError(string Code, string Message, string? Field);
+public sealed record AuthorizationStart([property: Url] string AuthorizationUrl, string State);
+public sealed record Session(
+    int Id,
+    string EmployeeId,
+    string EmployeeName,
+    [property: EmailAddress] string CorporateEmail,
+    SessionRole Role,
+    string AccessToken);
+public sealed record EmployeeProfile(
+    int Id,
+    string EmployeeId,
+    string EmployeeName,
+    [property: EmailAddress] string CorporateEmail,
+    bool DedicatedParking,
+    string? AssignedFloor,
+    string? AssignedSpace,
+    IReadOnlyList<Vehicle> Vehicles);
+public sealed record Vehicle(int Id, string Plate, string? Make, string? Model, string? Color, bool Active);
+public sealed record VehicleCollection(IReadOnlyList<Vehicle> Vehicles);
+
+[JsonConverter(typeof(JsonStringEnumConverter))]
+public enum SessionRole
+{
+    employee,
+    administrator
+}
