+using System.Net.Http.Headers;
+using System.Net.Http.Json;
+using Microsoft.Extensions.Configuration;
+
+namespace App.Api.Integrations;
+
+public sealed class ConfiguredAvailabilityEmailDispatcher(HttpClient httpClient, IConfiguration configuration)
+    : IAvailabilityEmailDispatcher
+{
+    public async Task<int> SendAvailabilityAsync(
+        DateOnly officeDate,
+        int availableSpaces,
+        IReadOnlyList<string> recipientEmails,
+        CancellationToken cancellationToken = default)
+    {
+        var endpoint = RequiredSetting("AvailabilityEmail:Endpoint");
+        var apiKey = RequiredSetting("AvailabilityEmail:ApiKey");
+        var sender = RequiredSetting("AvailabilityEmail:Sender");
+        using var request = new HttpRequestMessage(HttpMethod.Post, endpoint);
+        request.Headers.Authorization = new AuthenticationHeaderValue("Bearer", apiKey);
+        request.Content = JsonContent.Create(new
+        {
+            sender,
+            template = "parking-availability",
+            recipients = recipientEmails,
+            officeDate = officeDate.ToString("yyyy-MM-dd"),
+            availableSpaces
+        });
+
+        using var response = await httpClient.SendAsync(request, cancellationToken);
+        response.EnsureSuccessStatusCode();
+        return recipientEmails.Count;
+    }
+
+    private string RequiredSetting(string key) =>
+        !string.IsNullOrWhiteSpace(configuration[key])
+            ? configuration[key]!
+            : throw new InvalidOperationException($"The required setting '{key}' is not configured.");
+}
