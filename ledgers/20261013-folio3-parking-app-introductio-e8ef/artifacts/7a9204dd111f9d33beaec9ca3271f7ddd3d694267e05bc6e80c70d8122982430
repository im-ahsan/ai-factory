+using System.ComponentModel.DataAnnotations;
+using System.Text.Json.Serialization;
+using App.Api.Integrations;
+using Microsoft.EntityFrameworkCore;
+
+namespace App.Api.Endpoints;
+
+public sealed class AvailabilityNotificationEndpoints : IEndpointModule
+{
+    private const string InvalidMessage = "The request is invalid.";
+    private const string UnavailableMessage = "The service is temporarily unavailable.";
+
+    public void MapEndpoints(IEndpointRouteBuilder app)
+    {
+        app.MapPost("/api/notifications/availability", SendAvailabilityNotificationAsync)
+            .WithName("sendAvailabilityNotification")
+            .WithSummary("Send the fixed-template email to eligible non-dedicated employees when spaces become available")
+            .Accepts<AvailabilityNotificationRequest>("application/json")
+            .Produces<NotificationDispatch>(StatusCodes.Status202Accepted)
+            .Produces<ApiError>(StatusCodes.Status400BadRequest)
+            .Produces<ApiError>(StatusCodes.Status503ServiceUnavailable);
+    }
+
+    private static async Task<IResult> SendAvailabilityNotificationAsync(
+        AvailabilityNotificationRequest request,
+        AppDb db,
+        IAvailabilityEmailDispatcher dispatcher,
+        CancellationToken cancellationToken)
+    {
+        if (request.AvailableSpaces < 1) return Error("availableSpaces");
+        if (request.Id < 1) return Error("id");
+        if (request.OfficeDate == default) return Error("officeDate");
+
+        var recipients = await db.Employees.AsNoTracking()
+            .Where(employee => !employee.DedicatedParking)
+            .OrderBy(employee => employee.Id)
+            .Select(employee => employee.CorporateEmail)
+            .ToListAsync(cancellationToken);
+
+        try
+        {
+            var recipientCount = await dispatcher.SendAvailabilityAsync(
+                request.OfficeDate, request.AvailableSpaces, recipients, cancellationToken);
+            return Results.Json(new NotificationDispatch(
+                request.Id, AvailabilityNotificationStatus.accepted, recipientCount, "parking-availability"),
+                statusCode: StatusCodes.Status202Accepted);
+        }
+        catch (Exception exception) when (exception is HttpRequestException or InvalidOperationException or TaskCanceledException)
+        {
+            return Results.Json(new ApiError("service_unavailable", UnavailableMessage, null),
+                statusCode: StatusCodes.Status503ServiceUnavailable);
+        }
+    }
+
+    private static IResult Error(string field) =>
+        Results.Json(new ApiError("bad_request", InvalidMessage, field), statusCode: StatusCodes.Status400BadRequest);
+}
+
+public sealed record AvailabilityNotificationRequest
+{
+    [Required]
+    public int Id { get; init; }
+
+    [Required]
+    public DateOnly OfficeDate { get; init; }
+
+    [Required, Range(1, int.MaxValue)]
+    public int AvailableSpaces { get; init; }
+}
+
+public sealed record NotificationDispatch(int Id, AvailabilityNotificationStatus Status, int RecipientCount, string Template);
+
+[JsonConverter(typeof(JsonStringEnumConverter))]
+public enum AvailabilityNotificationStatus
+{
+    accepted
+}
