{"partial":true,"path":"App.Api/openapi/built.json","text":"{\n  \"openapi\": \"3.0.1\",\n  \"info\": {\n    \"title\": \"App.Api | v1\",\n    \"version\": \"1.0.0\"\n  },\n  \"paths\": {\n    \"/api/auth/google/authorization\": {\n      \"get\": {\n        \"tags\": [\n          \"AuthAndVehicleEndpoints\"\n        ],\n        \"summary\": \"Get the Folio3 Google Workspace authorization URL\",\n        \"operationId\": \"getGoogleAuthorization\",\n        \"responses\": {\n          \"200\": {\n            \"description\": \"OK\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/AuthorizationStartResponse\"\n                }\n              }\n            }\n          },\n          \"503\": {\n            \"description\": \"Service Unavailable\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/ApiErrorResponse\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"/api/auth/sign-in\": {\n      \"post\": {\n        \"tags\": [\n          \"AuthAndVehicleEndpoints\"\n        ],\n        \"summary\": \"Exchange a Google Workspace authorization code for a Folio3 session\",\n        \"operationId\": \"signIn\",\n        \"requestBody\": {\n          \"content\": {\n            \"application/json\": {\n              \"schema\": {\n                \"$ref\": \"#/components/schemas/SignInRequest\"\n              }\n            }\n          },\n          \"required\": true\n        },\n        \"responses\": {\n          \"200\": {\n            \"description\": \"OK\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/SessionResponse\"\n                }\n              }\n            }\n          },\n          \"400\": {\n            \"description\": \"Bad Request\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/ApiErrorResponse\"\n                }\n              }\n            }\n          },\n          \"401\": {\n            \"description\": \"Unauthorized\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/ApiErrorResponse\"\n                }\n              }\n            }\n          },\n          \"503\": {\n            \"description\": \"Service Unavailable\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/ApiErrorResponse\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"/api/employees/me\": {\n      \"get\": {\n        \"tags\": [\n          \"AuthAndVehicleEndpoints\"\n        ],\n        \"summary\": \"Get the signed-in employee profile\",\n        \"operationId\": \"getMyEmployeeProfile\",\n        \"responses\": {\n          \"200\": {\n            \"description\": \"OK\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/EmployeeProfileResponse\"\n                }\n              }\n            }\n          },\n          \"401\": {\n            \"description\": \"Unauthorized\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/ApiErrorResponse\"\n                }\n              }\n            }\n          },\n          \"403\": {\n            \"description\": \"Forbidden\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/ApiErrorResponse\"\n                }\n              }\n            }\n          },\n          \"404\": {\n            \"description\": \"Not Found\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/ApiErrorResponse\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"/api/vehicles\": {\n      \"get\": {\n        \"tags\": [\n          \"AuthAndVehicleEndpoints\"\n        ],\n        \"summary\": \"List the signed-in employee's registered vehicles\",\n        \"operationId\": \"listMyVehicles\",\n        \"responses\": {\n          \"200\": {\n            \"description\": \"OK\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/VehicleCollectionResponse\"\n                }\n              }\n            }\n          },\n          \"401\": {\n            \"description\": \"Unauthorized\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/ApiErrorResponse\"\n                }\n              }\n            }\n          }\n        }\n      },\n      \"post\": {\n        \"tags\": [\n          \"AuthAndVehicleEndpoints\"\n        ],\n        \"summary\": \"Register and immediately activate a vehicle plate\",\n        \"operationId\": \"registerVehicle\",\n        \"requestBody\": {\n          \"content\": {\n            \"application/json\": {\n              \"schema\": {\n                \"$ref\": \"#/components/schemas/VehicleInput\"\n              }\n            }\n          },\n          \"required\": true\n        },\n        \"responses\": {\n          \"201\": {\n            \"description\": \"Created\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/VehicleResponse\"\n                }\n              }\n            }\n          },\n          \"400\": {\n            \"description\": \"Bad Request\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/ApiErrorResponse\"\n                }\n              }\n            }\n          },\n          \"401\": {\n            \"description\": \"Unauthorized\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/ApiErrorResponse\"\n                }\n              }\n            }\n          },\n          \"409\": {\n            \"description\": \"Conflict\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/ApiErrorResponse\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"/api/notifications/availability\": {\n      \"post\": {\n        \"tags\": [\n          \"AvailabilityNotificationEndpoints\"\n        ],\n        \"summary\": \"Send the fixed-template email to eligible non-dedicated employees when spaces become available\",\n        \"operationId\": \"sendAvailabilityNotification\",\n        \"requestBody\": {\n          \"content\": {\n            \"application/json\": {\n              \"schema\": {\n                \"$ref\": \"#/components/schemas/AvailabilityNotificationRequest\"\n              }\n            }\n          },\n          \"required\": true\n        },\n        \"responses\": {\n          \"202\": {\n            \"description\": \"Accepted\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/NotificationDispatchResponse\"\n                }\n              }\n            }\n          },\n          \"400\": {\n            \"description\": \"Bad Request\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/ApiErrorResponse\"\n                }\n              }\n            }\n          },\n          \"503\": {\n            \"description\": \"Service Unavailable\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/ApiErrorResponse\"\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  },\n  \"components\": {\n    \"schemas\": {\n      \"ApiErrorResponse\": {\n        \"required\": [\n          \"code\",\n          \"message\",\n          \"field\"\n        ],\n        \"type\": \"object\",\n        \"properties\": {\n          \"code\": {\n            \"type\": \"string\"\n          },\n          \"message\": {\n            \"type\": \"string\"\n          },\n          \"field\": {\n            \"type\": \"string\",\n            \"nullable\": true\n          }\n        }\n      },\n      \"AuthorizationStartResponse\": {\n        \"required\": [\n          \"authorizationUrl\",\n          \"state\"\n        ],\n        \"type\": \"object\",\n        \"properties\": {\n          \"authorizationUrl\": {\n            \"type\": \"string\",\n            \"format\": \"uri\"\n          },\n          \"state\": {\n            \"type\": \"string\"\n          }\n        }\n      },\n      \"AvailabilityNotificationRequest\": {\n        \"required\": [\n          \"id\",\n          \"officeDate\",\n          \"availableSpaces\"\n        ],\n        \"type\": \"object\",\n        \"properties\": {\n          \"id\": {\n            \"type\": \"integer\",\n            \"format\": \"int32\"\n          },\n          \"officeDate\": {\n            \"type\": \"string\",\n            \"format\": \"date\"\n          },\n          \"availableSpaces\": {\n            \"type\": \"integer\",\n            \"format\": \"int32\"\n          }\n        }\n      },\n      \"EmployeeProfileResponse\": {\n        \"required\": [\n          \"id\",\n          \"employeeId\",\n          \"employeeName\",\n          \"corporateEmail\",\n          \"dedicatedParking\",\n          \"assignedFloor\",\n          \"assignedSpace\",\n          \"vehicles\"\n        ],\n        \"type\": \"object\",\n        \"properties\": {\n          \"id\": {\n            \"type\": \"integer\",\n            \"format\": \"int32\"\n          },\n          \"employeeId\": {\n            \"type\": \"string\"\n          },\n          \"employeeName\": {\n            \"type\": \"string\"\n          },\n          \"corporateEmail\": {\n            \"type\": \"string\"\n          },\n          \"dedicatedParking\": {\n            \"type\": \"boolean\"\n          },\n          \"assignedFloor\": {\n            \"type\": \"string\",\n            \"nullable\": true\n          },\n          \"assignedSpace\": {\n            \"type\": \"string\",\n            \"nullable\": true\n          },\n          \"vehicles\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"$ref\": \"#/components/schemas/VehicleResponse\"\n            }\n          }\n        }\n      },\n      \"EmployeeRole\": {\n        \"enum\": [\n          \"employee\",\n          \"administrator\"\n        ]\n      },\n      \"NotificationDispatchResponse\": {\n        \"required\": [\n          \"id\",\n          \"status\",\n          \"recipientCount\",\n          \"template\"\n        ],\n        \"type\": \"object\",\n        \"properties\": {\n          \"id\": {\n            \"type\": \"integer\",\n            \"format\": \"int32\"\n          },\n          \"status\": {\n            \"$ref\": \"#/components/schemas/NotificationDispatchStatus\"\n          },\n          \"recipientCount\": {\n            \"type\": \"integer\",\n            \"format\": \"int32\"\n          },\n          \"template\": {\n            \"type\": \"string\"\n          }\n        }\n      },\n      \"NotificationDispatchStatus\": {\n        \"enum\": [\n          \"accepted\"\n        ]\n      },\n      \"SessionResponse\": {\n        \"required\": [\n          \"id\",\n          \"employeeId\",\n          \"employeeName\",\n          \"corporateEmail\",\n          \"role\",\n          \"accessToken\"\n        ],\n        \"type\": \"object\",\n        \"properties\": {\n          \"id\": {\n            \"type\": \"integer\",\n            \"format\": \"int32\"\n          },\n          \"employeeId\": {\n            \"type\": \"string\"\n          },\n          \"employeeName\": {\n            \"type\": \"string\"\n          },\n          \"corporateEmail\": {\n            \"type\": \"string\"\n          },\n          \"role\": {\n            \"$ref\": \"#/components/schemas/EmployeeRole\"\n          },\n          \"accessToken\": {\n            \"type\": \"string\"\n          }\n        }\n      },\n      \"SignInRequest\": {\n        \"required\": [\n          \"authorizationCode\",\n          \"state\"\n        ],\n        \"type\": \"object\",\n        \"properties\": {\n          \"authorizationCode\": {\n            \"type\": \"string\"\n          },\n          \"state\": {\n            \"type\": \"string\"\n          }\n        }\n      },\n      \"VehicleCollectionResponse\": {\n        \"required\": [\n          \"vehicles\"\n        ],\n        \"type\": \"object\",\n        \"properties\": {\n          \"vehicles\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"$ref\": \"#/components/schemas/VehicleResponse\"\n            }\n          }\n        }\n      },\n      \"VehicleInput\": {\n        \"required\": [\n          \"plate\",\n          \"make\",\n          \"model\",\n          \"color\"\n        ],\n        \"type\": \"object\",\n        \"properties\": {\n          \"plate\": {\n            \"type\": \"string\"\n          },\n          \"make\": {\n            \"type\": \"string\",\n            \"nullable\": true\n          },\n          \"model\": {\n            \"type\": \"string\",\n            \"nullable\": true\n          },\n          \"color\": {\n            \"type\": \"string\",\n            \"nullable\": true\n          }\n        }\n      },\n      \"VehicleResponse\": {\n        \"required\": [\n          \"id\",\n          \"plate\",\n          \"make\",\n          \"model\",\n          \"color\",\n          \"active\"\n        ],\n        \"type\": \"object\",\n        \"properties\": {\n          \"id\": {\n            \"type\": \"integer\",\n            \"format\": \"int32\"\n          },\n          \"plate\": {\n            \"type\": \"string\"\n          },\n          \"make\": {\n            \"type\": \"string\",\n            \"nullable\": true\n          },\n          \"model\": {\n            \"type\": \"string\",\n            \"nullable\": true\n          },\n          \"color\": {\n            \"type\": \"string\",\n            \"nullable\": true\n          },\n          \"active\": {\n            \"type\": \"boolean\"\n          }\n        }\n      }\n    }\n  },\n  \"tags\": [\n    {\n      \"name\": \"AuthAndVehicleEndpoints\"\n    },\n    {\n      \"name\": \"AvailabilityNotificationEndpoints\"\n    }\n  ]\n}"}