{"partial":true,"path":"App.Api/openapi/built.json","text":"{\n  \"openapi\": \"3.0.1\",\n  \"info\": {\n    \"title\": \"App.Api | v1\",\n    \"version\": \"1.0.0\"\n  },\n  \"paths\": {\n    \"/api/auth/google/authorization\": {\n      \"get\": {\n        \"tags\": [\n          \"AuthAndVehicleEndpoints\"\n        ],\n        \"operationId\": \"getGoogleAuthorization\",\n        \"responses\": {\n          \"200\": {\n            \"description\": \"OK\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/AuthorizationStart\"\n                }\n              }\n            }\n          },\n          \"503\": {\n            \"description\": \"Service Unavailable\"\n          }\n        }\n      }\n    },\n    \"/api/auth/sign-in\": {\n      \"post\": {\n        \"tags\": [\n          \"AuthAndVehicleEndpoints\"\n        ],\n        \"operationId\": \"signIn\",\n        \"requestBody\": {\n          \"content\": {\n            \"application/json\": {\n              \"schema\": {\n                \"$ref\": \"#/components/schemas/SignInInput\"\n              }\n            }\n          },\n          \"required\": true\n        },\n        \"responses\": {\n          \"200\": {\n            \"description\": \"OK\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/SessionResponse\"\n                }\n              }\n            }\n          },\n          \"400\": {\n            \"description\": \"Bad Request\"\n          },\n          \"401\": {\n            \"description\": \"Unauthorized\"\n          },\n          \"503\": {\n            \"description\": \"Service Unavailable\"\n          }\n        }\n      }\n    },\n    \"/api/employees/me\": {\n      \"get\": {\n        \"tags\": [\n          \"AuthAndVehicleEndpoints\"\n        ],\n        \"operationId\": \"getMyE