+using System.Net.Http.Headers;
+using System.Net.Http.Json;
+
+namespace App.Api.Integrations;
+
+public sealed class ConfiguredAvailabilityEmailDispatcher(
+    HttpClient httpClient,
+    IConfiguration configuration,
+    ILogger<ConfiguredAvailabilityEmailDispatcher> logger) : IAvailabilityEmailDispatcher
+{
+    public async Task<int> SendAvailabilityAsync(
+        DateOnly officeDate,
+        int availableSpaces,
+        IReadOnlyList<string> recipientEmails,
+        CancellationToken cancellationToken = default)
+    {
+        var endpoint = configuration["AvailabilityEmail:Endpoint"];
+        var apiKey = configuration["AvailabilityEmail:ApiKey"];
+        var sender = configuration["AvailabilityEmail:Sender"];
+        if (string.IsNullOrWhiteSpace(endpoint) || string.IsNullOrWhiteSpace(apiKey) || string.IsNullOrWhiteSpace(sender))
+            throw new HttpRequestException("The availability email service is not configured.");
+
+        using var request = new HttpRequestMessage(HttpMethod.Post, endpoint)
+        {
+            Content = JsonContent.Create(new
+            {
+                sender,
+                recipients = recipientEmails,
+                template = "parking-availability",
+                data = new { officeDate, availableSpaces }
+            })
+        };
+        request.Headers.Authorization = new AuthenticationHeaderValue("Bearer", apiKey);
+        using var response = await httpClient.SendAsync(request, cancellationToken);
+        if (!response.IsSuccessStatusCode)
+        {
+            logger.LogWarning("Availability email endpoint returned status {StatusCode}.", (int)response.StatusCode);
+            throw new HttpRequestException("The availability email service rejected the dispatch.");
+        }
+
+        return recipientEmails.Count;
+    }
+}
