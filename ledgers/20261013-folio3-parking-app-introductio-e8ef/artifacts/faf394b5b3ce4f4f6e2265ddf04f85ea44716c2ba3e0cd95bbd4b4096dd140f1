+using App.Api;
+using App.Api.Integrations;
+using App.Api.Services;
+using Microsoft.EntityFrameworkCore;
+
+namespace App.Api.Endpoints;
+
+public sealed class AvailabilityNotificationEndpoints : IEndpointModule
+{
+    public void MapEndpoints(IEndpointRouteBuilder endpoints)
+    {
+        endpoints.MapPost("/notifications/availability", SendAvailabilityNotificationAsync)
+            .WithName("sendAvailabilityNotification")
+            .WithSummary("Send the fixed-template email to eligible non-dedicated employees when spaces become available")
+            .Produces<NotificationDispatchResponse>(StatusCodes.Status202Accepted)
+            .Produces<ApiErrorResponse>(StatusCodes.Status400BadRequest)
+            .Produces<ApiErrorResponse>(StatusCodes.Status503ServiceUnavailable);
+    }
+
+    private static async Task<IResult> SendAvailabilityNotificationAsync(
+        AvailabilityNotificationRequest request,
+        AppDb db,
+        IAvailabilityEmailDispatcher emailDispatcher,
+        ILogger<AvailabilityNotificationEndpoints> logger,
+        CancellationToken cancellationToken)
+    {
+        if (request.Id <= 0)
+            return Results.Json(BadRequestError("id"), statusCode: StatusCodes.Status400BadRequest);
+        if (request.OfficeDate == default)
+            return Results.Json(BadRequestError("officeDate"), statusCode: StatusCodes.Status400BadRequest);
+        if (request.AvailableSpaces <= 0)
+            return Results.Json(BadRequestError("availableSpaces"), statusCode: StatusCodes.Status400BadRequest);
+
+        var recipients = await db.Employees.AsNoTracking()
+            .Where(employee => !employee.DedicatedParking && employee.Role == "employee")
+            .Select(employee => employee.CorporateEmail)
+            .Distinct()
+            .OrderBy(email => email)
+            .ToListAsync(cancellationToken);
+
+        int recipientCount;
+        try
+        {
+            recipientCount = await emailDispatcher.SendAvailabilityAsync(
+                request.OfficeDate,
+                request.AvailableSpaces,
+                recipients,
+                cancellationToken);
+        }
+        catch (HttpRequestException exception)
+        {
+            logger.LogWarning(exception, "Availability email delivery is unavailable for office date {OfficeDate}.", request.OfficeDate);
+            return Results.Json(ServiceUnavailableError(), statusCode: StatusCodes.Status503ServiceUnavailable);
+        }
+        catch (OperationCanceledException exception) when (!cancellationToken.IsCancellationRequested)
+        {
+            logger.LogWarning(exception, "Availability email delivery timed out for office date {OfficeDate}.", request.OfficeDate);
+            return Results.Json(ServiceUnavailableError(), statusCode: StatusCodes.Status503ServiceUnavailable);
+        }
+
+        return Results.Json(new NotificationDispatchResponse(
+            request.Id,
+            NotificationDispatchStatus.Accepted,
+            recipientCount,
+            "parking-availability"), statusCode: StatusCodes.Status202Accepted);
+    }
+
+    private static ApiErrorResponse BadRequestError(string field) =>
+        new("bad_request", "The request is invalid.", field);
+
+    private static ApiErrorResponse ServiceUnavailableError() =>
+        new("service_unavailable", "The service is temporarily unavailable.", null);
+}
+
+public sealed record AvailabilityNotificationRequest(int Id, DateOnly OfficeDate, int AvailableSpaces);
+public enum NotificationDispatchStatus
+{
+    Accepted
+}
+
+public sealed record NotificationDispatchResponse(int Id, NotificationDispatchStatus Status, int RecipientCount, string Template);
