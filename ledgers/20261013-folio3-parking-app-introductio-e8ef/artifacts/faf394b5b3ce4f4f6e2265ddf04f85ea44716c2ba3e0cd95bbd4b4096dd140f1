@@ -0,0 +1,75 @@
+using App.Api;
+using App.Api.Entities;
+using Microsoft.EntityFrameworkCore;
+using System.Collections.Concurrent;
+using System.Security.Cryptography;
+using System.Text;
+using System.Text.Json.Serialization;
+
+namespace App.Api.Services;
+
+public sealed record ApiErrorResponse(string Code, string Message, [property: JsonRequired] string? Field);
+
+public sealed record EmployeeSessionResolution(bool Authenticated, int EmployeeId, Employee? Employee);
+
+public static class ApiAuth
+{
+    private sealed record KnownSession(int EmployeeId, DateTime ExpiresAt);
+
+    private static readonly ConcurrentDictionary<string, KnownSession> KnownSessions = new(StringComparer.Ordinal);
+
+    public static DateTime UtcNow => DatabaseTime.UtcNow;
+
+    public static DateTime TruncateToMicrosecond(DateTime value) => DatabaseTime.TruncateToMicrosecond(value);
+
+    public static string HashToken(string token) => Convert.ToHexString(SHA256.HashData(Encoding.UTF8.GetBytes(token)));
+
+    public static void RememberIssuedSession(string token, int employeeId, DateTime expiresAt) =>
+        KnownSessions[HashToken(token)] = new KnownSession(employeeId, expiresAt);
+
+    public static async Task<EmployeeSessionResolution?> ResolveEmployeeAsync(
+        HttpContext context,
+        AppDb db,
+        CancellationToken cancellationToken = default)
+    {
+        var authorization = context.Request.Headers.Authorization.ToString();
+        if (!authorization.StartsWith("Bearer ", StringComparison.OrdinalIgnoreCase))
+            return null;
+
+        var token = authorization[7..].Trim();
+        if (token.Length == 0)
+            return null;
+
+        var tokenHash = HashToken(token);
+        var now = UtcNow;
+        var session = await db.AuthSessions.AsNoTracking()
+            .SingleOrDefaultAsync(value => value.TokenHash == tokenHash && value.ExpiresAt > now, cancellationToken);
+        if (session is not null)
+        {
+            RememberIssuedSession(token, session.EmployeeId, session.ExpiresAt);
+            var employee = await db.Employees.AsNoTracking()
+                .SingleOrDefaultAsync(value => value.Id == session.EmployeeId, cancellationToken);
+            return new EmployeeSessionResolution(true, session.EmployeeId, employee);
+        }
+
+        if (!KnownSessions.TryGetValue(tokenHash, out var knownSession))
+            return null;
+        if (knownSession.ExpiresAt <= now)
+        {
+            KnownSessions.TryRemove(tokenHash, out _);
+            return null;
+        }
+
+        var knownEmployee = await db.Employees.AsNoTracking()
+            .SingleOrDefaultAsync(value => value.Id == knownSession.EmployeeId, cancellationToken);
+        return new EmployeeSessionResolution(true, knownSession.EmployeeId, knownEmployee);
+    }
+}
+
+public static class DatabaseTime
+{
+    public static DateTime UtcNow => TruncateToMicrosecond(DateTime.UtcNow);
+
+    public static DateTime TruncateToMicrosecond(DateTime value) =>
+        new(value.Ticks - value.Ticks % 10, value.Kind);
+}
