 using Microsoft.EntityFrameworkCore;
+using App.Api.Entities;
 
 namespace App.Api;
 
 public class AppDb(DbContextOptions<AppDb> options) : DbContext(options)
 {
+    public DbSet<Employee> Employees => Set<Employee>();
+    public DbSet<Vehicle> Vehicles => Set<Vehicle>();
+    public DbSet<AuthSession> AuthSessions => Set<AuthSession>();
+    public DbSet<OAuthState> OAuthStates => Set<OAuthState>();
+
+    protected override void OnModelCreating(ModelBuilder modelBuilder)
+    {
+        foreach (var entityType in typeof(IAppEntity).Assembly.GetTypes()
+                     .Where(type => !type.IsAbstract && !type.IsInterface && typeof(IAppEntity).IsAssignableFrom(type)))
+            modelBuilder.Entity(entityType);
+
+        modelBuilder.Entity<Employee>(entity =>
+        {
+            entity.ToTable("Employee", table => table.HasCheckConstraint("CK_Employee_Role", "\"Role\" IN ('employee', 'administrator')"));
+            entity.HasKey(x => x.Id);
+            entity.HasIndex(x => x.EmployeeId).IsUnique();
+            entity.HasIndex(x => x.CorporateEmail).IsUnique();
+            entity.Property(x => x.EmployeeId).IsRequired();
+            entity.Property(x => x.EmployeeName).IsRequired();
+            entity.Property(x => x.CorporateEmail).IsRequired();
+            entity.Property(x => x.Role).IsRequired();
+            entity.Property(x => x.DedicatedParking).IsRequired();
+        });
+
+        modelBuilder.Entity<Vehicle>(entity =>
+        {
+            entity.ToTable("Vehicle");
+            entity.HasKey(x => x.Id);
+            entity.HasIndex(x => x.Plate).IsUnique();
+            entity.Property(x => x.Plate).IsRequired();
+            entity.Property(x => x.Active).IsRequired();
+            entity.HasOne<Employee>().WithMany().HasForeignKey(x => x.EmployeeId).OnDelete(DeleteBehavior.Cascade);
+        });
+
+        modelBuilder.Entity<AuthSession>(entity =>
+        {
+            entity.ToTable("AuthSession");
+            entity.HasKey(x => x.Id);
+            entity.HasIndex(x => x.TokenHash).IsUnique();
+            entity.Property(x => x.TokenHash).IsRequired();
+            entity.Property(x => x.CreatedAt).IsRequired();
+            entity.Property(x => x.ExpiresAt).IsRequired();
+            entity.HasOne<Employee>().WithMany().HasForeignKey(x => x.EmployeeId).OnDelete(DeleteBehavior.Cascade);
+        });
+
+        modelBuilder.Entity<OAuthState>(entity =>
+        {
+            entity.ToTable("OAuthState");
+            entity.HasKey(x => x.Id);
+            entity.HasIndex(x => x.State).IsUnique();
+            entity.Property(x => x.State).IsRequired();
+            entity.Property(x => x.CreatedAt).IsRequired();
+            entity.Property(x => x.ExpiresAt).IsRequired();
+        });
+
+        base.OnModelCreating(modelBuilder);
+    }
 }
diff --git a/App.Api/Endpoints/AuthAndVehicleEndpoints.cs b/App.Api/Endpoints/AuthAndVehicleEndpoints.cs
new file mode 100644
index 0000000..5dd1621
--- /dev/null
+++ b/App.Api/Endpoints/AuthAndVehicleEndpoints.cs
@@ -0,0 +1,312 @@
+using App.Api;
+using App.Api.Entities;
+using App.Api.Integrations;
+using App.Api.Services;
+using Microsoft.EntityFrameworkCore;
+using System.ComponentModel.DataAnnotations;
+using System.Security.Cryptography;
+using System.Text.Json.Serialization;
+
+namespace App.Api.Endpoints;
+
+public sealed class AuthAndVehicleEndpoints : IEndpointModule
+{
+    public void MapEndpoints(IEndpointRouteBuilder endpoints)
+    {
+        endpoints.MapGet("/auth/google/authorization", GetAuthorizationAsync)
+            .WithName("getGoogleAuthorization")
+            .WithSummary("Get the Folio3 Google Workspace authorization URL")
+            .Produces<AuthorizationStartResponse>(StatusCodes.Status200OK)
+            .Produces<ApiErrorResponse>(StatusCodes.Status503ServiceUnavailable);
+
+        endpoints.MapPost("/auth/sign-in", SignInAsync)
+            .WithName("signIn")
+            .WithSummary("Exchange a Google Workspace authorization code for a Folio3 session")
+            .Produces<SessionResponse>(StatusCodes.Status200OK)
+            .Produces<ApiErrorResponse>(StatusCodes.Status400BadRequest)
+            .Produces<ApiErrorResponse>(StatusCodes.Status401Unauthorized)
+            .Produces<ApiErrorResponse>(StatusCodes.Status503ServiceUnavailable);
+
+        endpoints.MapGet("/employees/me", GetMyEmployeeProfileAsync)
+            .WithName("getMyEmployeeProfile")
+            .WithSummary("Get the signed-in employee profile")
+            .Produces<EmployeeProfileResponse>(StatusCodes.Status200OK)
+            .Produces<ApiErrorResponse>(StatusCodes.Status401Unauthorized)
+            .Produces<ApiErrorResponse>(StatusCodes.Status403Forbidden)
+            .Produces<ApiErrorResponse>(StatusCodes.Status404NotFound);
+
+        endpoints.MapGet("/vehicles", ListMyVehiclesAsync)
+            .WithName("listMyVehicles")
+            .WithSummary("List the signed-in employee's registered vehicles")
+            .Produces<VehicleCollectionResponse>(StatusCodes.Status200OK)
+            .Produces<ApiErrorResponse>(StatusCodes.Status401Unauthorized);
+
+        endpoints.MapPost("/vehicles", RegisterVehicleAsync)
+            .WithName("registerVehicle")
+            .WithSummary("Register and immediately activate a vehicle plate")
+            .Produces<VehicleResponse>(StatusCodes.Status201Created)
+            .Produces<ApiErrorResponse>(StatusCodes.Status400BadRequest)
+            .Produces<ApiErrorResponse>(StatusCodes.Status401Unauthorized)
+            .Produces<ApiErrorResponse>(StatusCodes.Status409Conflict);
+    }
+
+    private static async Task<IResult> GetAuthorizationAsync(
+        AppDb db,
+        IWorkspaceOAuthClient oauthClient,
+        ILogger<AuthAndVehicleEndpoints> logger,
+        CancellationToken cancellationToken)
+    {
+        var now = DatabaseTime.UtcNow;
+        var state = Convert.ToBase64String(RandomNumberGenerator.GetBytes(32)).TrimEnd('=').Replace('+', '-').Replace('/', '_');
+        var oauthState = new OAuthState
+        {
+            State = state,
+            CreatedAt = now,
+            ExpiresAt = DatabaseTime.TruncateToMicrosecond(now.AddMinutes(10))
+        };
+        db.OAuthStates.Add(oauthState);
+        await db.SaveChangesAsync(cancellationToken);
+
+        try
+        {
+            var authorizationUrl = await oauthClient.CreateAuthorizationUrlAsync(state, cancellationToken);
+            return Results.Ok(new AuthorizationStartResponse(new Uri(authorizationUrl), state));
+        }
+        catch (HttpRequestException exception)
+        {
+            logger.LogWarning(exception, "Google Workspace authorization could not be started.");
+        }
+        catch (OperationCanceledException exception) when (!cancellationToken.IsCancellationRequested)
+        {
+            logger.LogWarning(exception, "Google Workspace authorization timed out.");
+        }
+
+        db.OAuthStates.Remove(oauthState);
+        await db.SaveChangesAsync(cancellationToken);
+        return Results.Json(ServiceUnavailableError(), statusCode: StatusCodes.Status503ServiceUnavailable);
+    }
+
+    private static async Task<IResult> SignInAsync(
+        SignInRequest request,
+        AppDb db,
+        IWorkspaceOAuthClient oauthClient,
+        ILogger<AuthAndVehicleEndpoints> logger,
+        CancellationToken cancellationToken)
+    {
+        if (string.IsNullOrWhiteSpace(request.AuthorizationCode))
+            return Results.Json(BadRequestError("authorizationCode"), statusCode: StatusCodes.Status400BadRequest);
+        if (string.IsNullOrWhiteSpace(request.State))
+            return Results.Json(BadRequestError("state"), statusCode: StatusCodes.Status400BadRequest);
+
+        var now = DatabaseTime.UtcNow;
+        var oauthState = await db.OAuthStates.SingleOrDefaultAsync(
+            value => value.State == request.State && value.ExpiresAt > now, cancellationToken);
+        if (oauthState is null)
+            return Results.Json(BadRequestError("state"), statusCode: StatusCodes.Status400BadRequest);
+
+        db.OAuthStates.Remove(oauthState);
+        await db.SaveChangesAsync(cancellationToken);
+
+        IReadOnlyDictionary<string, string>? claims;
+        try
+        {
+            claims = await oauthClient.ExchangeAuthorizationCodeAsync(request.AuthorizationCode, request.State, cancellationToken);
+        }
+        catch (HttpRequestException exception)
+        {
+            logger.LogWarning(exception, "Google Workspace sign-in is unavailable.");
+            return Results.Json(ServiceUnavailableError(), statusCode: StatusCodes.Status503ServiceUnavailable);
+        }
+        catch (OperationCanceledException exception) when (!cancellationToken.IsCancellationRequested)
+        {
+            logger.LogWarning(exception, "Google Workspace sign-in timed out.");
+            return Results.Json(ServiceUnavailableError(), statusCode: StatusCodes.Status503ServiceUnavailable);
+        }
+
+        if (claims is null || !claims.TryGetValue("email", out var email) || string.IsNullOrWhiteSpace(email))
+            return Results.Json(BadRequestError("authorizationCode"), statusCode: StatusCodes.Status400BadRequest);
+
+        var verified = (claims.TryGetValue("email_verified", out var emailVerified) &&
+                        string.Equals(emailVerified, "true", StringComparison.OrdinalIgnoreCase)) ||
+                       (claims.TryGetValue("verified_email", out var verifiedEmail) &&
+                        string.Equals(verifiedEmail, "true", StringComparison.OrdinalIgnoreCase));
+        if (!verified || !email.EndsWith("@folio3.com", StringComparison.OrdinalIgnoreCase))
+            return Results.Json(UnauthorizedError(), statusCode: StatusCodes.Status401Unauthorized);
+
+        var employee = await db.Employees.SingleOrDefaultAsync(
+            value => value.CorporateEmail.ToLower() == email.ToLower(), cancellationToken);
+        if (employee is null)
+            return Results.Json(UnauthorizedError(), statusCode: StatusCodes.Status401Unauthorized);
+
+        var accessToken = Convert.ToBase64String(RandomNumberGenerator.GetBytes(32))
+            .TrimEnd('=').Replace('+', '-').Replace('/', '_');
+        var createdAt = DatabaseTime.UtcNow;
+        var expiresAt = DatabaseTime.TruncateToMicrosecond(createdAt.AddHours(8));
+        var session = new AuthSession
+        {
+            EmployeeId = employee.Id,
+            TokenHash = ApiAuth.HashToken(accessToken),
+            CreatedAt = createdAt,
+            ExpiresAt = expiresAt
+        };
+        db.AuthSessions.Add(session);
+        await db.SaveChangesAsync(cancellationToken);
+        ApiAuth.RememberIssuedSession(accessToken, employee.Id, expiresAt);
+
+        return Results.Ok(new SessionResponse(
+            session.Id,
+            employee.EmployeeId,
+            employee.EmployeeName,
+            employee.CorporateEmail,
+            NormalizeRole(employee.Role),
+            accessToken));
+    }
+
+    private static async Task<IResult> GetMyEmployeeProfileAsync(
+        HttpContext context,
+        AppDb db,
+        CancellationToken cancellationToken)
+    {
+        var session = await ApiAuth.ResolveEmployeeAsync(context, db, cancellationToken);
+        if (session is null)
+            return Results.Json(UnauthorizedError(), statusCode: StatusCodes.Status401Unauthorized);
+        if (session.Employee is null)
+            return Results.Json(NotFoundError(), statusCode: StatusCodes.Status404NotFound);
+        if (session.Employee.Role == "administrator")
+            return Results.Json(ForbiddenError(), statusCode: StatusCodes.Status403Forbidden);
+
+        var vehicles = (await db.Vehicles.AsNoTracking()
+            .Where(vehicle => vehicle.EmployeeId == session.EmployeeId)
+            .OrderBy(vehicle => vehicle.Id)
+            .ToListAsync(cancellationToken))
+            .Select(ToVehicleResponse)
+            .ToArray();
+
+        return Results.Ok(new EmployeeProfileResponse(
+            session.Employee.Id,
+            session.Employee.EmployeeId,
+            session.Employee.EmployeeName,
+            session.Employee.CorporateEmail,
+            session.Employee.DedicatedParking,
+            session.Employee.AssignedFloor,
+            session.Employee.AssignedSpace,
+            vehicles));
+    }
+
+    private static async Task<IResult> ListMyVehiclesAsync(
+        HttpContext context,
+        AppDb db,
+        CancellationToken cancellationToken)
+    {
+        var session = await ApiAuth.ResolveEmployeeAsync(context, db, cancellationToken);
+        if (session is null)
+            return Results.Json(UnauthorizedError(), statusCode: StatusCodes.Status401Unauthorized);
+
+        var vehicles = (await db.Vehicles.AsNoTracking()
+            .Where(vehicle => vehicle.EmployeeId == session.EmployeeId)
+            .OrderBy(vehicle => vehicle.Id)
+            .ToListAsync(cancellationToken))
+            .Select(ToVehicleResponse)
+            .ToArray();
+        return Results.Ok(new VehicleCollectionResponse(vehicles));
+    }
+
+    private static async Task<IResult> RegisterVehicleAsync(
+        VehicleInput request,
+        HttpContext context,
+        AppDb db,
+        CancellationToken cancellationToken)
+    {
+        var session = await ApiAuth.ResolveEmployeeAsync(context, db, cancellationToken);
+        if (session is null)
+            return Results.Json(UnauthorizedError(), statusCode: StatusCodes.Status401Unauthorized);
+        if (string.IsNullOrWhiteSpace(request.Plate))
+            return Results.Json(BadRequestError("plate"), statusCode: StatusCodes.Status400BadRequest);
+
+        var plate = request.Plate.Trim();
+        if (await db.Vehicles.AnyAsync(vehicle => vehicle.Plate == plate, cancellationToken))
+            return Results.Json(ConflictError("plate"), statusCode: StatusCodes.Status409Conflict);
+
+        var vehicle = new Vehicle
+        {
+            EmployeeId = session.EmployeeId,
+            Plate = plate,
+            Make = NormalizeOptional(request.Make),
+            Model = NormalizeOptional(request.Model),
+            Color = NormalizeOptional(request.Color),
+            Active = true
+        };
+        db.Vehicles.Add(vehicle);
+        try
+        {
+            await db.SaveChangesAsync(cancellationToken);
+        }
+        catch (DbUpdateException)
+        {
+            return Results.Json(ConflictError("plate"), statusCode: StatusCodes.Status409Conflict);
+        }
+
+        return Results.Created($"/api/vehicles/{vehicle.Id}", ToVehicleResponse(vehicle));
+    }
+
+    private static string? NormalizeOptional(string? value) =>
+        string.IsNullOrWhiteSpace(value) ? null : value.Trim();
+
+    private static EmployeeRole NormalizeRole(string role) =>
+        role == "administrator" ? EmployeeRole.Administrator : EmployeeRole.Employee;
+
+    private static VehicleResponse ToVehicleResponse(Vehicle vehicle) =>
+        new(vehicle.Id, vehicle.Plate, vehicle.Make, vehicle.Model, vehicle.Color, vehicle.Active);
+
+    private static ApiErrorResponse BadRequestError(string field) =>
+        new("bad_request", "The request is invalid.", field);
+
+    private static ApiErrorResponse UnauthorizedError() =>
+        new("unauthorized", "A valid Folio3 Workspace session is required.", null);
+
+    private static ApiErrorResponse ForbiddenError() =>
+        new("forbidden", "You are not authorized to access this resource.", null);
+
+    private static ApiErrorResponse NotFoundError() =>
+        new("not_found", "The requested parking record was not found.", null);
+
+    private static ApiErrorResponse ConflictError(string field) =>
+        new("conflict", "The parking record has already changed state.", field);
+
+    private static ApiErrorResponse ServiceUnavailableError() =>
+        new("service_unavailable", "The service is temporarily unavailable.", null);
+}
+
+public sealed record AuthorizationStartResponse(Uri AuthorizationUrl, string State);
+public sealed record SignInRequest(string AuthorizationCode, string State);
+public enum EmployeeRole
+{
+    Employee,
+    Administrator
+}
+
+public sealed record SessionResponse(
+    int Id,
+    string EmployeeId,
+    string EmployeeName,
+    [property: EmailAddress] string CorporateEmail,
+    EmployeeRole Role,
+    string AccessToken);
+public sealed record VehicleInput(string Plate, string? Make, string? Model, string? Color);
+public sealed record VehicleResponse(
+    int Id,
+    string Plate,
+    [property: JsonRequired] string? Make,
+    [property: JsonRequired] string? Model,
+    [property: JsonRequired] string? Color,
+    bool Active);
+public sealed record VehicleCollectionResponse(IReadOnlyList<VehicleResponse> Vehicles);
+public sealed record EmployeeProfileResponse(
+    int Id,
+    string EmployeeId,
+    string EmployeeName,
+    [property: EmailAddress] string CorporateEmail,
+    bool DedicatedParking,
+    [property: JsonRequired] string? AssignedFloor,
+    [property: JsonRequired] string? AssignedSpace,
+    IReadOnlyList<VehicleResponse> Vehicles);
