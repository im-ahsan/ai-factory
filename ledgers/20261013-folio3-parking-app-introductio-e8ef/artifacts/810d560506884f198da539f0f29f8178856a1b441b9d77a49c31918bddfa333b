 },\n      \"SessionResponse\": {\n        \"required\": [\n          \"id\",\n          \"employeeId\",\n          \"employeeName\",\n          \"corporateEmail\",\n          \"role\",\n          \"accessToken\"\n        ],\n        \"type\": \"object\",\n        \"properties\": {\n          \"id\": {\n            \"type\": \"integer\",\n            \"format\": \"int32\"\n          },\n          \"employeeId\": {\n            \"type\": \"string\"\n          },\n          \"employeeName\": {\n            \"type\": \"string\"\n          },\n          \"corporateEmail\": {\n            \"type\": \"string\"\n          },\n          \"role\": {\n            \"type\": \"string\"\n          },\n          \"accessToken\": {\n            \"type\": \"string\"\n          }\n        }\n      },\n      \"SignInInput\": {\n        \"required\": [\n          \"authorizationCode\",\n          \"state\"\n        ],\n        \"type\": \"object\",\n        \"properties\": {\n          \"authorizationCode\": {\n            \"type\": \"string\"\n          },\n          \"state\": {\n            \"type\": \"string\"\n          }\n        }\n      },\n      \"TodayReleaseInput\": {\n        \"required\": [\n          \"officeDate\"\n        ],\n        \"type\": \"object\",\n        \"properties\": {\n          \"officeDate\": {\n            \"type\": \"string\",\n            \"format\": \"date\"\n          }\n        }\n      },\n      \"VehicleCollection\": {\n        \"required\": [\n          \"vehicles\"\n        ],\n        \"type\": \"object\",\n        \"properties\": {\n          \"vehicles\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"$ref\": \"#/components/schemas/VehicleResponse\"\n            }\n          }\n        }\n      },\n      \"VehicleInput\": {\n        \"required\": [\n          \"plate\"\n        ],\n        \"type\": \"object\",\n        \"properties\": {\n          \"plate\": {\n            \"type\": \"string\"\n          },\