<link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect"/>
<link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@600;650&amp;family=IBM+Plex+Mono:wght@400;500;600&amp;family=Source+Sans+3:wght@400;500;600&amp;display=swap" rel="stylesheet"/>
<style>
    /* Strict CSS reset & token definitions */
    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      background-color: #F5F5F5;
      color: #262626;
      font-family: 'Source Sans 3', sans-serif;
      font-size: 16px;
      line-height: 24px;
      -webkit-font-smoothing: antialiased;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    /* Typography rules */
    h1, h2, h3 {
      font-family: 'Hanken Grotesk', sans-serif;
      color: #262626;
    }
    h1 {
      font-size: 32px;
      font-weight: 650;
      line-height: 40px;
    }
    h2 {
      font-size: 24px;
      font-weight: 600;
      line-height: 32px;
    }
    h3 {
      font-size: 18px;
      font-weight: 600;
      line-height: 24px;
    }

    .num-data, .code-data, .time-data {
      font-family: 'IBM Plex Mono', monospace;
    }

    .quieter-text {
      color: #626262;
    }

    /* Motion specifications */
    @keyframes entranceFadeIn {
      from {
        opacity: 0;
        transform: translateY(6px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes live-breathe {
      0%, 100% {
        opacity: 0.82;
      }
      50% {
        opacity: 0.86;
      }
    }

    .animate-entrance {
      animation: entranceFadeIn 280ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    .status-dot-pulse {
      animation: live-breathe 8s cubic-bezier(0.65, 0, 0.35, 1) infinite;
    }

    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
        scroll-behavior: auto !important;
      }
    }

    /* Component styles */
    .top-header {
      background-color: #FFFFFF;
      border-bottom: 1px solid #D8D8D8;
      height: 56px;
      padding: 0 24px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      width: 100%;
    }

    .brand-section {
      display: flex;
      align-items: center;
      gap: 12px;
      flex-shrink: 0;
    }

    .brand-mark {
      width: 24px;
      height: 24px;
      background-color: #262626;
      color: #FFFFFF;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: 'Hanken Grotesk', sans-serif;
      font-weight: 650;
      font-size: 14px;
      border-radius: 4px;
      user-select: none;
    }

    .brand-title {
      font-family: 'Hanken Grotesk', sans-serif;
      font-weight: 650;
      font-size: 18px;
      color: #262626;
      text-decoration: none;
      white-space: nowrap;
    }

    .nav-menu {
      display: flex;
      align-items: center;
      gap: 20px;
      list-style: none;
      margin-left: 28px;
      overflow-x: auto;
      scrollbar-width: none;
    }
    .nav-menu::-webkit-scrollbar {
      display: none;
    }

    .nav-item {
      white-space: nowrap;
    }

    .nav-link {
      color: #626262;
      text-decoration: none;
      font-size: 15px;
      font-weight: 400;
      padding: 16px 0;
      display: inline-block;
      border-bottom: 2px solid transparent;
      transition: color 150ms ease, border-color 150ms ease;
    }
    .nav-link:hover {
      color: #262626;
    }
    .nav-link.active {
      color: #B3473D;
      border-bottom: 2px solid #B3473D;
      font-weight: 600;
    }

    .user-profile {
      display: flex;
      align-items: center;
      gap: 10px;
      flex-shrink: 0;
      margin-left: 16px;
    }

    .user-avatar {
      width: 32px;
      height: 32px;
      border-radius: 4px;
      object-fit: cover;
      aspect-ratio: 1 / 1;
      border: 1px solid #D8D8D8;
    }

    .user-info {
      display: flex;
      flex-direction: column;
      line-height: 1.2;
    }

    .user-name {
      font-weight: 600;
      font-size: 14px;
      color: #262626;
      white-space: nowrap;
    }

    .user-role {
      font-size: 12px;
      color: #626262;
      white-space: nowrap;
    }

    /* Main Layout */
    .main-container {
      max-width: 1440px;
      width: 100%;
      margin: 0 auto;
      padding: 24px;
      flex: 1;
    }

    .header-row {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      margin-bottom: 24px;
    }

    .page-title-block {
      display: flex;
      flex-direction: column;
      gap: 4px;
    }

    .yard-meta {
      font-size: 14px;
      color: #626262;
    }

    .btn-primary {
      background-color: #B3473D;
      color: #FFFFFF;
      border: none;
      border-radius: 4px;
      height: 44px;
      padding: 0 20px;
      font-family: 'Source Sans 3', sans-serif;
      font-size: 15px;
      font-weight: 600;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      text-decoration: none;
      transition: opacity 120ms ease;
    }
    .btn-primary:hover {
      opacity: 0.92;
    }
    .btn-primary:focus {
      outline: 2px solid #B3473D;
      outline-offset: 2px;
    }
    .btn-primary:active {
      opacity: 0.84;
    }

    /* Workbench Layout */
    .workbench-layout {
      display: grid;
      grid-template-columns: 280px 1fr;
      gap: 24px;
      align-items: start;
    }

    /* Filter Rail */
    .filter-rail {
      background-color: #FFFFFF;
      border: 1px solid #D8D8D8;
      border-radius: 4px;
      padding: 24px;
      display: flex;
      flex-direction: column;
      gap: 20px;
    }

    .filter-group {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    .filter-label {
      font-size: 14px;
      font-weight: 600;
      color: #262626;
    }

    .filter-input, .filter-select {
      height: 44px;
      border: 1px solid #D8D8D8;
      border-radius: 4px;
      padding: 0 12px;
      font-family: 'Source Sans 3', sans-serif;
      font-size: 15px;
      color: #262626;
      background-color: #FFFFFF;
      width: 100%;
      outline: none;
      transition: border-color 150ms ease;
    }
    .filter-input.num-data {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 14px;
    }
    .filter-input:focus, .filter-select:focus {
      border-color: #B3473D;
      box-shadow: 0 0 0 1px #B3473D;
    }

    .filter-helper {
      font-size: 13px;
      color: #626262;
      line-height: 18px;
    }

    .filter-divider {
      height: 1px;
      background-color: #D8D8D8;
      width: 100%;
      margin: 4px 0;
    }

    /* Results Panel */
    .results-panel {
      background-color: #FFFFFF;
      border: 1px solid #D8D8D8;
      border-radius: 4px;
      overflow: hidden;
    }

    .panel-header {
      padding: 20px 24px;
      border-bottom: 1px solid #D8D8D8;
      display: flex;
      justify-content: space-between;
      align-items: center;
      background-color: #FFFFFF;
    }

    .panel-title-area {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .record-count-badge {
      font-size: 13px;
      color: #626262;
    }

    .sample-status-box {
      background-color: #F5F5F5;
      border-bottom: 1px solid #D8D8D8;
      padding: 10px 24px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      font-size: 13px;
      color: #626262;
    }

    .sample-pill {
      border: 1px solid #D8D8D8;
      background-color: #FFFFFF;
      color: #626262;
      padding: 2px 8px;
      border-radius: 4px;
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 0.04em;
    }

    /* Dense Table */
    .table-container {
      width: 100%;
      overflow-x: auto;
    }

    .dense-table {
      width: 100%;
      border-collapse: collapse;
      text-align: left;
    }

    .dense-table th {
      height: 48px;
      padding: 0 16px;
      font-size: 13px;
      font-weight: 600;
      color: #626262;
      background-color: #FFFFFF;
      border-bottom: 1px solid #D8D8D8;
      white-space: nowrap;
      user-select: none;
    }

    .dense-table th.sortable {
      cursor: pointer;
    }
    .dense-table th.sortable:hover {
      color: #262626;
    }

    .dense-table td {
      height: 48px;
      padding: 0 16px;
      font-size: 14px;
      color: #262626;
      border-bottom: 1px solid #D8D8D8;
      white-space: nowrap;
    }

    .dense-table tr:last-child td {
      border-bottom: none;
    }

    .dense-table tr:hover td {
      background-color: #FAFAFA;
    }

    /* Status indicators */
    .status-cell {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: 14px;
    }

    .status-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      flex-shrink: 0;
    }

    .status-good {
      color: #286143;
    }
    .status-good .status-dot {
      background-color: #286143;
    }

    .status-waiting {
      color: #805600;
    }
    .status-waiting .status-dot {
      background-color: #805600;
    }

    .status-failed {
      color: #A13D36;
    }
    .status-failed .status-dot {
      background-color: #A13D36;
    }

    /* Sub-rows & Lot Performance Reference */
    .table-section-title {
      padding: 16px 24px 8px 24px;
      font-size: 14px;
      font-weight: 600;
      color: #262626;
      background-color: #FBFBFB;
      border-top: 2px solid #D8D8D8;
      border-bottom: 1px solid #D8D8D8;
    }

    .conflict-badge {
      display: inline-block;
      font-size: 12px;
      color: #805600;
      margin-left: 6px;
    }

    /* Responsive */
    @media (max-width: 960px) {
      .workbench-layout {
        grid-template-columns: 1fr;
      }
      .filter-rail {
        padding: 16px;
      }
      .filter-input, .filter-select, .btn-primary {
        height: 48px;
      }
      .dense-table td, .dense-table th {
        height: 56px;
      }
      .main-container {
        padding: 16px;
      }
    }
  </style>
</head>
