<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Sign in — Range Ledger</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@600;650&family=IBM+Plex+Mono:wght@400;500;600&family=Source+Sans+3:ital,wght@0,400;0,500;0,600;1,400&display=swap" rel="stylesheet">
  <style>
    /* Reset & Base Tokens */
    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      background-color: #F5F5F5;
      color: #262626;
      font-family: 'Source Sans 3', sans-serif;
      font-size: 16px;
      line-height: 24px;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 24px 16px;
    }

    /* Motion Tokens & Animations (CSS Only) */
    @keyframes entranceFadeUp {
      0% {
        opacity: 0;
        transform: translateY(12px);
      }
      100% {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes live-breathe {
      0%, 100% {
        opacity: 0.82;
      }
      50% {
        opacity: 0.86;
      }
    }

    .animate-entrance {
      animation: entranceFadeUp 360ms cubic-bezier(0.16, 1, 0.3, 1) both;
    }

    .animate-entrance-panel {
      animation: entranceFadeUp 420ms cubic-bezier(0.16, 1, 0.3, 1) 90ms both;
    }

    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
        scroll-behavior: auto !important;
      }
    }

    /* Layout Container */
    .auth-container {
      width: 100%;
      max-width: 440px;
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    /* Brand Header Above Panel */
    .brand-header {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      margin-bottom: 24px;
    }

    .brand-mark {
      width: 40px;
      height: 40px;
      margin-bottom: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .brand-name {
      font-family: 'Hanken Grotesk', sans-serif;
      font-weight: 650;
      font-size: 20px;
      line-height: 26px;
      letter-spacing: -0.01em;
      color: #262626;
    }

    /* Centred Panel */
    .auth-panel {
      width: 100%;
      background-color: #FFFFFF;
      border: 1px solid #D8D8D8;
      border-radius: 4px;
      padding: 24px;
    }

    @media (max-width: 640px) {
      .auth-panel {
        padding: 16px;
      }
    }

    .panel-heading {
      font-family: 'Hanken Grotesk', sans-serif;
      font-weight: 650;
      font-size: 32px;
      line-height: 38px;
      letter-spacing: -0.02em;
      color: #262626;
      margin-bottom: 8px;
    }

    .panel-subtitle {
      font-size: 16px;
      line-height: 24px;
      color: #626262;
      margin-bottom: 24px;
    }

    /* Form Elements */
    .auth-form {
      display: flex;
      flex-direction: column;
      gap: 20px;
    }

    .field-group {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .field-label {
      font-size: 14px;
      font-weight: 600;
      line-height: 20px;
      color: #262626;
    }

    .field-input {
      width: 100%;
      height: 44px;
      background-color: #FFFFFF;
      border: 1px solid #D8D8D8;
      border-radius: 4px;
      padding: 0 12px;
      font-family: 'Source Sans 3', sans-serif;
      font-size: 16px;
      line-height: 24px;
      color: #262626;
      outline: none;
      transition: border-color 160ms ease, box-shadow 160ms ease;
    }

    .field-input::placeholder {
      color: #626262;
      opacity: 0.6;
    }

    .field-input:hover {
      border-color: #262626;
    }

    .field-input:focus {
      border-color: #B3473D;
      outline: 2px solid #B3473D;
      outline-offset: 0;
    }

    @media (max-width: 640px) {
      .field-input {
        height: 48px;
      }
    }

    /* Primary Action Button */
    .btn-primary {
      width: 100%;
      height: 44px;
      background-color: #B3473D;
      color: #FFFFFF;
      border: 1px solid #B3473D;
      border-radius: 4px;
      font-family: 'Source Sans 3', sans-serif;
      font-size: 16px;
      font-weight: 600;
      line-height: 24px;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-top: 4px;
      transition: background-color 160ms ease, border-color 160ms ease, transform 100ms ease;
    }

    @media (max-width: 640px) {
      .btn-primary {
        height: 48px;
      }
    }

    .btn-primary:hover {
      background-color: #9c3c33;
      border-color: #9c3c33;
    }

    .btn-primary:focus-visible {
      outline: 2px solid #B3473D;
      outline-offset: 2px;
    }

    .btn-primary:active {
      transform: scale(0.99);
      background-color: #88342c;
    }
  </style>
</head>
<body>
  <div class="auth-container">
    <!-- Brand mark and words above panel -->
    <header class="brand-header animate-entrance">
      <div class="brand-mark" aria-hidden="true">
        <!-- SVG geometric brand mark reflecting feedlot precision and fence/range structure -->
        <svg width="40" height="40" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
          <rect x="2" y="2" width="36" height="36" rx="4" stroke="#262626" stroke-width="2" fill="#FFFFFF"/>
          <line x1="2" y1="14" x2="38" y2="14" stroke="#262626" stroke-width="1.5"/>
          <line x1="2" y1="26" x2="38" y2="26" stroke="#262626" stroke-width="1.5"/>
          <line x1="14" y1="2" x2="14" y2="38" stroke="#262626" stroke-width="1.5"/>
          <line x1="26" y1="2" x2="26" y2="38" stroke="#262626" stroke-width="1.5"/>
          <rect x="15.5" y="15.5" width="9" height="9" fill="#262626"/>
        </svg>
      </div>
      <h2 class="brand-name">Range Ledger</h2>
    </header>

    <!-- Centred Panel (Max width 440px) -->
    <main class="auth-panel animate-entrance-panel">
      <h1 class="panel-heading">Sign in</h1>
      <p class="panel-subtitle">Use your work account to open your yard.</p>

      <form class="auth-form" method="POST" action="/api/auth/sign-in" novalidate>
        <!-- Email field -->
        <div class="field-group">
          <label class="field-label" for="email">Email</label>
          <input
            type="email"
            id="email"
            name="email"
            class="field-input"
            autocomplete="email"
            required
            spellcheck="false"
          >
        </div>

        <!-- Password field -->
        <div class="field-group">
          <label class="field-label" for="password">Password</label>
          <input
            type="password"
            id="password"
            name="password"
            class="field-input"
            autocomplete="current-password"
            required
          >
        </div>

        <!-- Single Primary Button -->
        <button type="submit" class="btn-primary">
          Sign in
        </button>
      </form>
    </main>
  </div>
</body>
</html>
