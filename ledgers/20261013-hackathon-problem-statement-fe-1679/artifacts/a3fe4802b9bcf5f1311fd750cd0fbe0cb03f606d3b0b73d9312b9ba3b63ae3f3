  <style>
    /* Exact tokens specified by system rules */
    :root {
      --bg-page: #F5F5F5;
      --bg-surface: #FFFFFF;
      --text-main: #262626;
      --text-quiet: #626262;
      --border-rule: #D8D8D8;
      --primary-accent: #B3473D;
      --status-good: #286143;
      --status-waiting: #805600;
      --status-failed: #A13D36;
    }

    body {
      background-color: var(--bg-page);
      color: var(--text-main);
      font-family: 'Source Sans 3', sans-serif;
      font-size: 16px;
      line-height: 24px;
      margin: 0;
      padding: 0;
      -webkit-font-smoothing: antialiased;
    }

    h1 {
      font-family: 'Hanken Grotesk', sans-serif;
      font-size: 32px;
      font-weight: 650;
      line-height: 40px;
    }

    h2 {
      font-family: 'Hanken Grotesk', sans-serif;
      font-size: 24px;
      font-weight: 600;
      line-height: 32px;
    }

    h3 {
      font-family: 'Hanken Grotesk', sans-serif;
      font-size: 18px;
      font-weight: 600;
      line-height: 26px;
    }

    .font-mono-val {
      font-family: 'IBM Plex Mono', monospace;
    }

    .btn-primary {
      background-color: var(--primary-accent);
      color: #FFFFFF;
      height: 44px;
      border-radius: 4px;
      padding: 0 20px;
      font-family: 'Source Sans 3', sans-serif;
      font-size: 16px;
      font-weight: 600;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      transition: opacity 160ms ease, box-shadow 160ms ease;
    }

    .btn-primary:hover {
      opacity: 0.92;
    }

    .btn-primary:focus {
      outline: 2px solid var(--primary-accent);
      outline-offset: 2px;
    }

    .btn-primary:active {
      opacity: 0.85;
    }

    .btn-secondary {
      background-color: transparent;
      color: var(--text-main);
      height: 44px;
      border-radius: 4px;
      border: 1px solid var(--border-rule);
      padding: 0 16px;
      font-family: 'Source Sans 3', sans-serif;
      font-size: 16px;
      font-weight: 500;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      transition: background-color 160ms ease, border-color 160ms ease;
    }

    .btn-secondary:hover {
      background-color: #FAFAFA;
      border-color: #BFBFBF;
    }

    .btn-secondary:focus {
      outline: 2px solid var(--primary-accent);
      outline-offset: 2px;
    }

    .form-input, .form-select {
      height: 44px;
      border-radius: 4px;
      border: 1px solid var(--border-rule);
      background-color: #FFFFFF;
      padding: 0 12px;
      font-family: 'Source Sans 3', sans-serif;
      font-size: 16px;
      color: var(--text-main);
      transition: border-color 160ms ease;
    }

    .form-input:focus, .form-select:focus {
      outline: 2px solid var(--primary-accent);
      outline-offset: 2px;
      border-color: var(--primary-accent);
    }

    /* Motion specifications */
    @keyframes entranceFadeUp {
      from {
        opacity: 0;
        transform: translateY(6px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .entrance-sequence {
      animation: entranceFadeUp 300ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    @keyframes live-breathe {
      0%, 100% {
        opacity: 0.82;
      }
      50% {
        opacity: 0.86;
      }
    }

    .animate-live-breathe {
      animation: live-breathe 8s cubic-bezier(0.65, 0, 0.35, 1) infinite;
    }

    @media (prefers-reduced-motion: reduce) {
      .entrance-sequence,
      .animate-live-breathe {
        animation: none !important;
        opacity: 1 !important;
        transform: none !important;
      }
    }

    @media (max-width: 640px) {
      .btn-primary, .btn-secondary, .form-input, .form-select {
        height: 48px;
      }
    }
  </style>
</head>
