@@ -5,24 +5,55 @@ export type SessionState = {
   landingPage: string;
   permissions: string[];
   authorizedYards: Array<{ id: number; name: string }>;
+  accessToken?: string;
 };
 
+const SESSION_STORAGE_KEY = "range-ledger-session";
+
+function isSessionState(value: unknown): value is SessionState {
+  if (typeof value !== "object" || value === null) return false;
+  const session = value as Partial<SessionState>;
+  return typeof session.id === "number"
+    && typeof session.name === "string"
+    && typeof session.email === "string"
+    && typeof session.landingPage === "string"
+    && Array.isArray(session.permissions)
+    && session.permissions.every((permission) => typeof permission === "string")
+    && Array.isArray(session.authorizedYards)
+    && session.authorizedYards.every((yard) => typeof yard === "object" && yard !== null && typeof yard.id === "number" && typeof yard.name === "string")
+    && (session.accessToken === undefined || typeof session.accessToken === "string");
+}
+
 export function readSession(): SessionState | null {
-  throw new Error("not implemented");
+  if (typeof window === "undefined") return null;
+  try {
+    const saved = window.localStorage.getItem(SESSION_STORAGE_KEY);
+    if (!saved) return null;
+    const parsed: unknown = JSON.parse(saved);
+    return isSessionState(parsed) ? parsed : null;
+  } catch {
+    return null;
+  }
 }
 
 export function writeSession(session: SessionState): void {
-  throw new Error("not implemented");
+  if (typeof window === "undefined") return;
+  window.localStorage.setItem(SESSION_STORAGE_KEY, JSON.stringify(session));
 }
 
 export function clearSession(): void {
-  throw new Error("not implemented");
+  if (typeof window === "undefined") return;
+  window.localStorage.removeItem(SESSION_STORAGE_KEY);
 }
 
 export function hasPermission(session: SessionState | null, permission: string): boolean {
-  throw new Error("not implemented");
+  return session?.permissions.includes(permission) ?? false;
 }
 
 export function updatePermissions(permissions: string[]): SessionState | null {
-  throw new Error("not implemented");
+  const session = readSession();
+  if (!session) return null;
+  const updated = { ...session, permissions };
+  writeSession(updated);
+  return updated;
 }
