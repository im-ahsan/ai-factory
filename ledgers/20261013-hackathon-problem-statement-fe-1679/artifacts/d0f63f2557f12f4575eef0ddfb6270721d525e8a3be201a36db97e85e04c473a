  <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@600;650&family=IBM+Plex+Mono:wght@400;500;600&family=Source+Sans+3:wght@400;500;600&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    :root {
      --bg: #F5F5F5;
      --surface: #FFFFFF;
      --text: #262626;
      --quiet: #626262;
      --border: #D8D8D8;
      --primary: #B3473D;
      --status-good: #286143;
      --status-waiting: #805600;
      --status-refused: #A13D36;
    }

    body {
      background-color: var(--bg);
      color: var(--text);
      font-family: 'Source Sans 3', sans-serif;
      font-size: 16px;
      line-height: 24px;
      margin: 0;
      padding: 0;
      -webkit-font-smoothing: antialiased;
    }

    h1, h2, h3 {
      font-family: 'Hanken Grotesk', sans-serif;
    }

    h1 {
      font-size: 32px;
      font-weight: 650;
      line-height: 40px;
    }

    h2 {
      font-size: 24px;
      font-weight: 600;
      line-height: 32px;
    }

    h3 {
      font-size: 18px;
      font-weight: 600;
      line-height: 24px;
    }

    .font-mono {
      font-family: 'IBM Plex Mono', monospace;
    }

    .border-rule {
      border-color: var(--border);
    }

    .focus-ring:focus-visible, .focus-ring:focus {
      outline: 2px solid var(--primary);
      outline-offset: 2px;
    }

    /* Motion tokens */
    @keyframes entranceFadeUp {
      from {
        opacity: 0;
        transform: translateY(8px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes live-breathe {
      0%, 100% {
        opacity: 0.82;
      }
      50% {
        opacity: 0.86;
      }
    }

    .animate-entrance {
      animation: entranceFadeUp 420ms cubic-bezier(0.16, 1, 0.3, 1) both;
    }

    .live-status-dot {
      animation: live-breathe 8s cubic-bezier(0.65, 0, 0.35, 1) infinite;
    }

    @media (prefers-reduced-motion: reduce) {
      .animate-entrance,
      .live-status-dot {
        animation: none !important;
        transition: none !important;
      }
    }

    /* Interactive state styles */
    .control-interactive {
      transition: background-color 150ms ease, border-color 150ms ease, transform 100ms ease;
    }
    .control-interactive:hover {
      background-color: #fafafa;
    }
    .control-interactive:active {
      transform: scale(0.99);
    }
    .row-card {
      transition: border-color 150ms ease, background-color 150ms ease;
    }
    .row-card:hover {
      border-color: #bfbfbf;
    }
    .row-card:active {
      background-color: #fafafa;
    }

    /* Details toggle without JS */
    details summary {
      list-style: none;
    }
    details summary::-webkit-details-marker {
      display: none;
    }
  </style>
</head>
