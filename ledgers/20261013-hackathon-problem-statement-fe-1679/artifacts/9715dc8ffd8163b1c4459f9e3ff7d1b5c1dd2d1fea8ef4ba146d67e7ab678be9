  <style>
    :root {
      --bg-page: #F5F5F5;
      --bg-surface: #FFFFFF;
      --text-main: #262626;
      --text-muted: #626262;
      --border-rule: #D8D8D8;
      --primary-color: #B3473D;
      --status-good: #286143;
      --status-waiting: #805600;
      --status-failed: #A13D36;
    }

    body {
      background-color: var(--bg-page);
      color: var(--text-main);
      font-family: 'Source Sans 3', sans-serif;
      font-size: 16px;
      line-height: 24px;
      margin: 0;
      padding: 0;
      -webkit-font-smoothing: antialiased;
    }

    h1 {
      font-family: 'Hanken Grotesk', sans-serif;
      font-size: 32px;
      font-weight: 650;
      line-height: 38px;
      letter-spacing: -0.02em;
    }

    h2 {
      font-family: 'Hanken Grotesk', sans-serif;
      font-size: 24px;
      font-weight: 600;
      line-height: 30px;
    }

    h3 {
      font-family: 'Hanken Grotesk', sans-serif;
      font-size: 18px;
      font-weight: 600;
      line-height: 24px;
    }

    .font-mono-val {
      font-family: 'IBM Plex Mono', monospace;
    }

    /* Motion tokens & Entrance sequence */
    @keyframes pageEntrance {
      from {
        opacity: 0;
        transform: translateY(8px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .animate-entrance {
      animation: pageEntrance 400ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    /* Signature motion */
    @keyframes feedingTrackFill {
      from { transform: scaleX(0); }
      to { transform: scaleX(1); }
    }

    .feeding-track {
      transform-origin: left;
      animation-timeline: view();
      animation-range: entry 0% entry 55%;
      animation-duration: 420ms;
      animation-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
    }

    /* Ambient live breathing dot */
    @keyframes live-breathe {
      0%, 100% { opacity: 0.82; transform: scale(1); }
      50% { opacity: 0.86; transform: scale(1.05); }
    }

    .live-dot {
      animation: live-breathe 8s cubic-bezier(0.65, 0, 0.35, 1) infinite;
    }

    /* Controls: hover, focus, pressed */
    button, input, select {
      transition: background-color 160ms ease, border-color 160ms ease, transform 100ms ease;
    }

    button:active {
      transform: scale(0.98);
    }

    button:focus-visible, input:focus-visible, select:focus-visible {
      outline: 2px solid var(--primary-color);
      outline-offset: 1px;
    }

    .btn-primary {
      background-color: var(--primary-color);
      color: #FFFFFF;
      height: 48px;
      border-radius: 4px;
      font-weight: 600;
      border: 1px solid var(--primary-color);
    }

    .btn-primary:hover {
      background-color: #9d3d34;
    }

    .btn-secondary {
      background-color: #FFFFFF;
      color: var(--text-main);
      height: 48px;
      border-radius: 4px;
      font-weight: 600;
      border: 1px solid var(--border-rule);
    }

    .btn-secondary:hover {
      background-color: #F9F9F9;
      border-color: #BEBEBE;
    }

    .panel-box {
      background-color: var(--bg-surface);
      border: 1px solid var(--border-rule);
      border-radius: 4px;
      padding: 16px;
    }

    .group-rule {
      height: 2px;
      background-color: var(--border-rule);
      width: 100%;
      border: none;
      margin: 24px 0;
    }

    .item-rule {
      height: 1px;
      background-color: var(--border-rule);
      width: 100%;
      border: none;
      margin: 12px 0;
    }

    @media (prefers-reduced-motion: reduce) {
      *, ::before, ::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
        scroll-behavior: auto !important;
      }
    }
  </style>
