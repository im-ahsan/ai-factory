      <!-- Add Weight Measurement Trigger -->
      <div class="mt-4">
        <button id="toggle-form-btn" type="button" class="btn-secondary w-full text-sm flex items-center justify-center gap-2">
          <span>+ Add weight measurement</span>
        </button>
      </div>

      <!-- Inline date/weight form -->
      <div id="inline-weight-form" class="mt-3 p-3 bg-[#F5F5F5] border border-[#D8D8D8] rounded space-y-3">
        <div class="text-xs font-semibold text-[#262626] uppercase tracking-wider">New Weight Entry (Service Connected)</div>
        <div>
          <label class="block text-xs text-[#626262] mb-1">Measurement Date & Time (Mountain Time)</label>
          <input type="text" value="2025-06-19 08:00 MT" class="w-full h-12 px-3 bg-white border border-[#D8D8D8] rounded font-mono-val text-sm text-[#262626]" />
        </div>
        <div>
          <label class="block text-xs text-[#626262] mb-1">Average Weight (lb/head)</label>
          <input type="number" placeholder="e.g. 1150" class="w-full h-12 px-3 bg-white border border-[#D8D8D8] rounded font-mono-val text-sm text-[#262626]" />
        </div>
        <div>
          <label class="block text-xs text-[#626262] mb-1">Recorded By Staff</label>
          <input type="text" value="Rosa Alvarez (Livestock technician)" readonly class="w-full h-12 px-3 bg-[#EAEAEA] border border-[#D8D8D8] rounded text-sm text-[#626262]" />
