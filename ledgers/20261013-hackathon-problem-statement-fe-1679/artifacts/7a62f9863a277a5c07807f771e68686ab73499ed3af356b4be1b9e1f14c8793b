<style>
    :root {
      --bg-page: #F5F5F5;
      --bg-panel: #FFFFFF;
      --text-main: #262626;
      --text-muted: #626262;
      --border-color: #D8D8D8;
      --brand-accent: #B3473D;
      --status-good: #286143;
      --status-waiting: #805600;
      --status-failed: #A13D36;
    }

    body {
      background-color: var(--bg-page);
      color: var(--text-main);
      font-family: 'Source Sans 3', sans-serif;
      font-size: 16px;
      line-height: 24px;
      margin: 0;
      padding: 0;
      -webkit-font-smoothing: antialiased;
    }

    h1, h2, h3, .heading-font {
      font-family: 'Hanken Grotesk', sans-serif;
    }

    .num-font, .code-font, .time-font {
      font-family: 'IBM Plex Mono', monospace;
    }

    /* Design System Spacing & Component Rules */
    .panel-card {
      background: var(--bg-panel);
      border: 1px solid var(--border-color);
      border-radius: 4px;
      padding: 24px;
    }

    @media (max-width: 768px) {
      .panel-card {
        padding: 16px;
      }
    }

    .btn-solid {
      background-color: var(--brand-accent);
      color: #FFFFFF;
      height: 44px;
      border-radius: 4px;
      padding: 0 16px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-weight: 600;
      transition: background-color 150ms ease, transform 100ms ease;
      cursor: pointer;
      border: 1px solid transparent;
    }

    .btn-solid:hover {
      background-color: #9c3c33;
    }

    .btn-solid:active {
      transform: scale(0.98);
    }

    .btn-outline {
      background-color: #FFFFFF;
      color: var(--text-main);
      height: 44px;
      border-radius: 4px;
      padding: 0 16px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-weight: 600;
      border: 1px solid var(--border-color);
      transition: background-color 150ms ease, border-color 150ms ease, transform 100ms ease;
      cursor: pointer;
    }

    .btn-outline:hover {
      background-color: #FAFAFA;
      border-color: #BDBDBD;
    }

    .btn-outline:active {
      transform: scale(0.98);
    }

    .form-input, .form-select {
      background-color: #FFFFFF;
      border: 1px solid var(--border-color);
      border-radius: 4px;
      height: 44px;
      padding: 0 12px;
      color: var(--text-main);
      width: 100%;
      outline: none;
      transition: border-color 150ms ease, box-shadow 150ms ease;
    }

    .form-input:focus, .form-select:focus {
      border-color: var(--brand-accent);
      box-shadow: 0 0 0 2px var(--brand-accent);
    }

    @media (max-width: 768px) {
      .btn-solid, .btn-outline, .form-input, .form-select {
        height: 48px;
      }
    }

    /* Motion Tokens and Keyframes */
    @keyframes page-enter {
      from {
        opacity: 0;
        transform: translateY(4px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes live-breathe {
      0%, 100% {
        opacity: 0.82;
      }
      50% {
        opacity: 0.86;
      }
    }

    .animate-entrance {
      animation: page-enter 350ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    .live-dot {
      animation: live-breathe 8s cubic-bezier(0.65, 0, 0.35, 1) infinite;
    }

    .feeding-track-fill {
      animation-timeline: view();
      animation-range: entry 0% entry 55%;
      animation-duration: 420ms;
      animation-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
    }

    @media (prefers-reduced-motion: reduce) {
      .animate-entrance, .live-dot, .feeding-track-fill {
        animation: none !important;
      }
    }

    /* Table rules */
    .table-row-item {
      height: 48px;
      border-bottom: 1px solid var(--border-color);
    }

    @media (max-width: 768px) {
      .table-row-item {
        min-height: 56px;
        height: auto;
      }
    }

    .major-divider {
      border: 0;
      border-top: 2px solid var(--border-color);
      margin: 32px 0;
    }

    /* Ratio crop helper */
    .portrait-avatar {
      aspect-ratio: 1 / 1;
      object-fit: cover;
      border-radius: 4px;
    }
  </style>
</head>
