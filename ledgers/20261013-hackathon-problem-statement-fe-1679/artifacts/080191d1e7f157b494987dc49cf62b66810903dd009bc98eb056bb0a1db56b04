<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Sample data — Range Ledger</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@600;650&family=IBM+Plex+Mono:wght@400;500;600&family=Source+Sans+3:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    /* Design System strict colors & reset */
    :root {
      --bg-page: #F5F5F5;
      --bg-surface: #FFFFFF;
      --text-main: #262626;
      --text-quiet: #626262;
      --border-rule: #D8D8D8;
      --brand-primary: #B3473D;
      --status-good: #286143;
      --status-waiting: #805600;
      --status-failed: #A13D36;
      --font-heading: 'Hanken Grotesk', -apple-system, BlinkMacSystemFont, sans-serif;
      --font-body: 'Source Sans 3', -apple-system, BlinkMacSystemFont, sans-serif;
      --font-mono: 'IBM Plex Mono', monospace;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      background-color: var(--bg-page);
      color: var(--text-main);
      font-family: var(--font-body);
      font-size: 16px;
      line-height: 24px;
      -webkit-font-smoothing: antialiased;
    }

    /* Motion specifications */
    @keyframes pageEnter {
      from {
        opacity: 0;
        transform: translateY(4px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes live-breathe {
      0%, 100% { opacity: 0.82; }
      50% { opacity: 0.86; }
    }

    .animate-enter {
      animation: pageEnter 280ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    .live-dot {
      animation: live-breathe 8s cubic-bezier(0.65, 0, 0.35, 1) infinite;
    }

    @media (prefers-reduced-motion: reduce) {
      .animate-enter, .live-dot {
        animation: none !important;
        transform: none !important;
      }
      * {
        transition-duration: 0.01ms !important;
      }
    }

    /* Typography */
    h1 {
      font-family: var(--font-heading);
      font-size: 32px;
      font-weight: 650;
      line-height: 40px;
      color: var(--text-main);
    }

    h2 {
      font-family: var(--font-heading);
      font-size: 24px;
      font-weight: 600;
      line-height: 32px;
      color: var(--text-main);
    }

    h3 {
      font-family: var(--font-heading);
      font-size: 18px;
      font-weight: 600;
      line-height: 24px;
      color: var(--text-main);
    }

    .font-mono {
      font-family: var(--font-mono);
    }

    .text-quiet {
      color: var(--text-quiet);
    }

    /* Top Plain Header */
    .top-header {
      background-color: var(--bg-surface);
      border-bottom: 1px solid var(--border-rule);
      height: 56px;
      padding: 0 24px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .header-left {
      display: flex;
      align-items: center;
      gap: 32px;
    }

    .brand-mark {
      display: flex;
      align-items: center;
      gap: 8px;
      text-decoration: none;
      color: var(--text-main);
    }

    .brand-box {
      width: 24px;
      height: 24px;
      background-color: var(--text-main);
      color: #FFFFFF;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: var(--font-heading);
      font-weight: 650;
      font-size: 14px;
      border-radius: 4px;
    }

    .brand-name {
      font-family: var(--font-heading);
      font-weight: 650;
      font-size: 16px;
      letter-spacing: -0.01em;
    }

    .shared-menu {
      display: flex;
      align-items: center;
      gap: 16px;
      list-style: none;
    }

    .menu-item {
      font-family: var(--font-body);
      font-size: 14px;
      font-weight: 500;
      color: var(--text-quiet);
      text-decoration: none;
      padding: 16px 0;
      border-bottom: 2px solid transparent;
      transition: color 140ms ease;
    }

    .menu-item:hover {
      color: var(--text-main);
    }

    .menu-item.active {
      color: var(--brand-primary);
      border-bottom-color: var(--brand-primary);
      font-weight: 600;
    }

    .header-profile {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .profile-photo {
      width: 32px;
      height: 32px;
      border-radius: 4px;
      object-fit: cover;
      aspect-ratio: 1 / 1;
      border: 1px solid var(--border-rule);
    }

    .profile-meta {
      display: flex;
      flex-direction: column;
      line-height: 16px;
    }

    .profile-name {
      font-size: 13px;
      font-weight: 600;
      color: var(--text-main);
    }

    .profile-role {
      font-size: 12px;
      color: var(--text-quiet);
    }

    /* Layout */
    .page-container {
      max-width: 1280px;
      margin: 0 auto;
      padding: 24px;
    }

    .header-subtext {
      margin-top: 4px;
      font-size: 14px;
      color: var(--text-quiet);
    }

    .major-divider {
      height: 2px;
      background-color: var(--border-rule);
      border: none;
      margin: 24px 0;
    }

    /* Panels & Cards */
    .panel {
      background-color: var(--bg-surface);
      border: 1px solid var(--border-rule);
      border-radius: 4px;
      padding: 24px;
      margin-bottom: 24px;
    }

    /* Visibly Distinct SAMPLE banner/treatment */
    .sample-status-banner {
      border: 1px solid var(--border-rule);
      border-left: 4px solid var(--status-waiting);
      border-radius: 4px;
      background-color: var(--bg-surface);
      padding: 16px 20px;
      margin-bottom: 24px;
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 20px;
    }

    .sample-pill {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-family: var(--font-mono);
      font-size: 12px;
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      padding: 3px 8px;
      border-radius: 4px;
      background-color: #FAF4E6;
      color: var(--status-waiting);
      border: 1px solid #E4D5B3;
    }

    .status-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      display: inline-block;
    }

    .status-good {
      color: var(--status-good);
    }
    .status-good .status-dot {
      background-color: var(--status-good);
    }

    .status-waiting {
      color: var(--status-waiting);
    }
    .status-waiting .status-dot {
      background-color: var(--status-waiting);
    }

    .status-failed {
      color: var(--status-failed);
    }
    .status-failed .status-dot {
      background-color: var(--status-failed);
    }

    /* Action area */
    .action-panel {
      background-color: var(--bg-surface);
      border: 1px solid var(--border-rule);
      border-radius: 4px;
      padding: 24px;
      margin-bottom: 24px;
    }

    .action-row {
      display: flex;
      align-items: center;
      gap: 16px;
      flex-wrap: wrap;
      margin-top: 16px;
    }

    /* Buttons conforming to design system */
    button {
      font-family: var(--font-body);
      font-size: 15px;
      font-weight: 600;
      height: 44px;
      padding: 0 18px;
      border-radius: 4px;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      transition: background-color 140ms ease, border-color 140ms ease, color 140ms ease;
    }

    button:focus-visible {
      outline: 2px solid var(--brand-primary);
      outline-offset: 2px;
    }

    .btn-primary {
      background-color: var(--brand-primary);
      color: #FFFFFF;
      border: 1px solid var(--brand-primary);
    }

    .btn-primary:hover:not(:disabled) {
      background-color: #9E3E35;
      border-color: #9E3E35;
    }

    .btn-primary:active:not(:disabled) {
      background-color: #8C372F;
    }

    .btn-primary:disabled {
      background-color: #E2CFCD;
      border-color: #E2CFCD;
      color: #FFFFFF;
      cursor: not-allowed;
    }

    .btn-secondary {
      background-color: transparent;
      color: var(--text-main);
      border: 1px solid var(--border-rule);
    }

    .btn-secondary:hover:not(:disabled) {
      background-color: #F5F5F5;
      border-color: #BFBFBF;
    }

    .btn-secondary:active:not(:disabled) {
      background-color: #EBEBEB;
    }

    .btn-destructive-outline {
      background-color: transparent;
      color: var(--status-failed);
      border: 1px solid #E6B8B5;
    }

    .btn-destructive-outline:hover:not(:disabled) {
      background-color: #FDF3F2;
      border-color: var(--status-failed);
    }

    .btn-destructive-solid {
      background-color: var(--status-failed);
      color: #FFFFFF;
      border: 1px solid var(--status-failed);
    }

    .btn-destructive-solid:hover {
      background-color: #8B342E;
    }

    /* Confirmation Modal / Inline Drawer */
    .confirmation-box {
      margin-top: 16px;
      padding: 16px;
      border: 1px solid #E6B8B5;
      background-color: #FCF7F7;
      border-radius: 4px;
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .confirmation-actions {
      display: flex;
      gap: 12px;
      align-items: center;
    }

    /* Service Result Callout */
    .service-result-card {
      margin-top: 16px;
      padding: 14px 16px;
      background-color: #F5F5F5;
      border: 1px solid var(--border-rule);
      border-radius: 4px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
    }

    /* Compact Status-Led Table */
    .data-table-wrapper {
      background-color: var(--bg-surface);
      border: 1px solid var(--border-rule);
      border-radius: 4px;
      overflow-x: auto;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      text-align: left;
    }

    thead th {
      background-color: #FAFAFA;
      font-size: 13px;
      font-weight: 600;
      color: var(--text-quiet);
      text-transform: uppercase;
      letter-spacing: 0.04em;
      padding: 12px 16px;
      border-bottom: 1px solid var(--border-rule);
      height: 44px;
    }

    tbody tr {
      height: 48px;
      border-bottom: 1px solid var(--border-rule);
    }

    tbody tr:last-child {
      border-bottom: none;
    }

    tbody td {
      padding: 10px 16px;
      font-size: 15px;
      color: var(--text-main);
      vertical-align: middle;
    }

    .tag-sample {
      display: inline-block;
      font-family: var(--font-mono);
      font-size: 11px;
      font-weight: 600;
      padding: 2px 6px;
      border-radius: 4px;
      background-color: #FAF4E6;
      color: var(--status-waiting);
      border: 1px solid #E4D5B3;
      margin-left: 6px;
    }

    /* Status badge */
    .badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: 13px;
      font-weight: 500;
    }

    /* Responsive */
    @media (max-width: 900px) {
      .top-header {
        height: auto;
        padding: 12px 16px;
        flex-direction: column;
        align-items: flex-start;
        gap: 12px;
      }
      .shared-menu {
        overflow-x: auto;
        width: 100%;
        padding-bottom: 4px;
      }
      .panel {
        padding: 16px;
      }
      tbody tr {
        height: 56px;
      }
      button {
        height: 48px;
        width: 100%;
      }
      .action-row {
        flex-direction: column;
      }
    }
  </style>
</head>
