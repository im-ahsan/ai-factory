  <script>
    function toggleConfirm(type) {
      const resetBox = document.getElementById('confirm-reset-box');
      const replaceBox = document.getElementById('confirm-replace-box');
      if (type === 'reset') {
        resetBox.style.display = resetBox.style.display === 'none' ? 'flex' : 'none';
        replaceBox.style.display = 'none';
      } else if (type === 'replace') {
        replaceBox.style.display = replaceBox.style.display === 'none' ? 'flex' : 'none';
        resetBox.style.display = 'none';
      }
    }

    function executeAction(msg) {
      alert(msg);
      document.getElementById('confirm-reset-box').style.display = 'none';
      document.getElementById('confirm-replace-box').style.display = 'none';
    }
  </script>
