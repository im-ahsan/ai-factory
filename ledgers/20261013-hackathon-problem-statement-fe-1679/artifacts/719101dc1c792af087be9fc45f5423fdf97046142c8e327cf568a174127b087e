  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@600;650;700&family=IBM+Plex+Mono:wght@400;500;600&family=Source+Sans+3:wght@400;500;600&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    /* Exact System Design Tokens */
    :root {
      --bg-page: #F5F5F5;
      --bg-surface: #FFFFFF;
      --text-main: #262626;
      --text-quiet: #626262;
      --border-color: #D8D8D8;
      --brand-accent: #B3473D;
      --status-good: #286143;
      --status-waiting: #805600;
      --status-failed: #A13D36;
    }

    body {
      background-color: var(--bg-page);
      color: var(--text-main);
      font-family: 'Source Sans 3', sans-serif;
      font-size: 16px;
      line-height: 24px;
      margin: 0;
      padding: 0;
      -webkit-font-smoothing: antialiased;
    }

    h1, h2, h3, .heading-hanken {
      font-family: 'Hanken Grotesk', sans-serif;
    }

    .font-mono-num {
      font-family: 'IBM Plex Mono', monospace;
    }

    /* Motion specifications */
    @keyframes fadeInPage {
      from {
        opacity: 0;
        transform: translateY(4px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes liveBreathe {
      0%, 100% {
        opacity: 0.82;
      }
      50% {
        opacity: 0.86;
      }
    }

    .page-entrance {
      animation: fadeInPage 400ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    .status-dot-pulse {
      animation: liveBreathe 8s cubic-bezier(0.65, 0, 0.35, 1) infinite;
    }

    @media (prefers-reduced-motion: reduce) {
      .page-entrance, .status-dot-pulse {
        animation: none !important;
        transition: none !important;
      }
    }

    /* Focus and interactive styles */
    a:focus-visible, button:focus-visible {
      outline: 2px solid var(--brand-accent);
      outline-offset: 2px;
    }

    .table-row-hover:hover {
      background-color: #FAFAFA;
    }
  </style>
</head>
<body class="min-h-screen text-[#262626] bg-[#F5F5F5]">

