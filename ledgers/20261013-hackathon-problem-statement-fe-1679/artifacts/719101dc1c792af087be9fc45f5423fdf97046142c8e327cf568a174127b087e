  <!-- Main Content Page -->
  <main class="max-w-[1440px] mx-auto px-4 sm:px-6 py-8 page-entrance space-y-8">

    <!-- Page Heading -->
    <div class="flex flex-col md:flex-row md:items-baseline md:justify-between gap-2">
