                  Covered
                </span>
              </td>
            </tr>

            <!-- Weekly Horizon -->
            <tr class="h-12 sm:h-12 table-row-hover transition-colors">
              <td class="py-3 px-4 font-semibold text-[#262626]">Weekly (7 days)</td>
