                <th scope="col" class="py-3 px-4">Ration</th>
                <th scope="col" class="py-3 px-4 text-right">Head count</th>
                <th scope="col" class="py-3 px-4 text-right">Rate</th>
                <th scope="col" class="py-3 px-4 text-right">Daily planned</th>
                <th scope="col" class="py-3 px-4 text-center">Audit</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-[#D8D8D8] text-[15px]">
              
              <!-- P-04 Row (Flagged for review) -->
              <tr class="h-12 table-row-hover transition-colors">
                <td class="py-3 px-4 font-semibold text-[#262626]">P-04</td>
                <td class="py-3 px-4 text-[#262626]">Grower</td>
                <td class="py-3 px-4 text-right font-mono-num text-[#262626]">142 head*</td>
