            </tr>

            <!-- Semi-Annual Horizon -->
            <tr class="h-12 sm:h-12 table-row-hover transition-colors">
              <td class="py-3 px-4 font-semibold text-[#262626]">Semi-annual (180 days)</td>
              <td class="py-3 px-4 text-right font-mono-num text-[#262626]">1,509,084 lb</td>
              <td class="py-3 px-4 text-right font-mono-num text-[#626262]">42,254 lb</td>
              <td class="py-3 px-4 text-right font-mono-num text-[#626262]">1,551,338 lb</td>
              <td class="py-3 px-4 text-right font-mono-num font-semibold text-[#A13D36]">−1,413,938 lb</td>
              <td class="py-3 px-4 text-center">
                <span class="inline-flex items-center gap-1.5 px-2 py-0.5 text-[12px] font-medium text-[#A13D36]">
                  <span class="w-1.5 h-1.5 rounded-full bg-[#A13D36]"></span>
                  Reorder needed
                </span>
              </td>
            </tr>

            <!-- Annual Horizon -->
            <tr class="h-12 sm:h-12 table-row-hover transition-colors">
              <td class="py-3 px-4 font-semibold text-[#262626]">Annual (365 days)</td>
              <td class="py-3 px-4 text-right font-mono-num text-[#262626]">3,060,087 lb</td>
              <td class="py-3 px-4 text-right font-mono-num text-[#626262]">85,682 lb</td>
              <td class="py-3 px-4 text-right font-mono-num text-[#626262]">3,145,769 lb</td>
              <td class="py-3 px-4 text-right font-mono-num font-semibold text-[#A13D36]">−3,008,369 lb</td>
              <td class="py-3 px-4 text-center">
                <span class="inline-flex items-center gap-1.5 px-2 py-0.5 text-[12px] font-medium text-[#A13D36]">
                  <span class="w-1.5 h-1.5 rounded-full bg-[#A13D36]"></span>
                  Reorder needed
                </span>
              </td>
            </tr>

          </tbody>
        </table>
      </div>

      <!-- Explanatory note -->
      <div class="text-[13px] text-[#626262] leading-5 pt-1">
        Balances reflect cumulative consumption against the static on-hand balance of 137,400 lb without planned inbound commodity contracts factored in.
      </div>
    </div>

    <!-- 2px Full-width rule separating major sections -->
    <hr class="border-t-2 border-[#D8D8D8] my-8" />

    <!-- Two-column section: Pen-Level Daily Quantities & Separate 30-Day Known Actual Wastage -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
      
      <!-- Panel 1: Pen-Level Daily Quantities (Source Plan Jun 19) -->
