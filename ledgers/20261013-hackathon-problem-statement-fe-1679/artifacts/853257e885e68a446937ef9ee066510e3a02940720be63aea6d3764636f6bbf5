<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Feeding — Range Ledger</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@600;650&family=IBM+Plex+Mono:wght@400;500;600&family=Source+Sans+3:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    /* Reset & Base Variables */
    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    :root {
      --bg-page: #F5F5F5;
      --bg-panel: #FFFFFF;
      --text-main: #262626;
      --text-muted: #626262;
      --border-color: #D8D8D8;
      --primary: #B3473D;
      
      --status-good: #286143;
      --status-waiting: #805600;
      --status-failed: #A13D36;

      --font-heading: 'Hanken Grotesk', -apple-system, BlinkMacSystemFont, sans-serif;
      --font-body: 'Source Sans 3', -apple-system, BlinkMacSystemFont, sans-serif;
      --font-mono: 'IBM Plex Mono', monospace;
    }

    body {
      background-color: var(--bg-page);
      color: var(--text-main);
      font-family: var(--font-body);
      font-size: 16px;
      line-height: 24px;
      -webkit-font-smoothing: antialiased;
      min-height: 100vh;
    }

    /* Motion Tokens & Keyframes */
    @keyframes page-enter {
      from {
        opacity: 0;
        transform: translateY(6px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes live-breathe {
      0%, 100% {
        opacity: 0.82;
      }
      50% {
        opacity: 0.86;
      }
    }

    .animate-enter {
      animation: page-enter 320ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    .live-status-dot {
      animation: live-breathe 8s cubic-bezier(0.65, 0, 0.35, 1) infinite;
    }

    /* Signature motion */
    .feeding-track-fill {
      animation-duration: 420ms;
      animation-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
      transform-origin: left;
    }

    @supports (animation-timeline: view()) {
      .feeding-track-fill {
        animation-timeline: view();
        animation-range: entry 0% entry 55%;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
      }
    }

    /* Header */
    header {
      background-color: #FFFFFF;
      border-bottom: 1px solid var(--border-color);
      width: 100%;
    }

    .header-inner {
      max-width: 1440px;
      margin: 0 auto;
      padding: 0 24px;
      height: 56px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .header-left {
      display: flex;
      align-items: center;
      gap: 32px;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 8px;
      text-decoration: none;
      color: var(--text-main);
    }

    .brand-mark {
      width: 24px;
      height: 24px;
      background-color: var(--text-main);
      color: #FFFFFF;
      border-radius: 4px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: var(--font-heading);
      font-weight: 650;
      font-size: 14px;
      line-height: 1;
    }

    .brand-title {
      font-family: var(--font-heading);
      font-weight: 650;
      font-size: 16px;
      letter-spacing: -0.01em;
      white-space: nowrap;
    }

    nav {
      display: flex;
      align-items: center;
      gap: 16px;
      overflow-x: auto;
    }

    .nav-item {
      font-size: 14px;
      font-weight: 400;
      color: var(--text-muted);
      text-decoration: none;
      padding: 16px 2px;
      border-bottom: 2px solid transparent;
      white-space: nowrap;
      transition: color 150ms ease;
    }

    .nav-item:hover {
      color: var(--text-main);
    }

    .nav-item:focus-visible {
      outline: 2px solid var(--primary);
      outline-offset: 2px;
      border-radius: 2px;
    }

    .nav-item.active {
      color: var(--primary);
      font-weight: 600;
      border-bottom-color: var(--primary);
    }

    .header-right {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .user-avatar {
      width: 32px;
      height: 32px;
      border-radius: 4px;
      object-fit: cover;
      aspect-ratio: 1 / 1;
      display: block;
    }

    .user-meta {
      display: flex;
      flex-direction: column;
      line-height: 1.2;
    }

    .user-name {
      font-size: 13px;
      font-weight: 600;
      color: var(--text-main);
      white-space: nowrap;
    }

    .user-role {
      font-size: 12px;
      color: var(--text-muted);
      white-space: nowrap;
    }

    /* Layout Container */
    main {
      max-width: 1440px;
      margin: 0 auto;
      padding: 32px 24px 64px 24px;
    }

    /* Page Heading */
    .page-title {
      font-family: var(--font-heading);
      font-size: 32px;
      font-weight: 650;
      line-height: 40px;
      letter-spacing: -0.02em;
      margin-bottom: 24px;
      color: var(--text-main);
    }

    /* Error Notification Banner */
    .error-banner {
      background-color: var(--bg-panel);
      border: 1px solid var(--border-color);
      border-left: 4px solid var(--status-failed);
      border-radius: 4px;
      padding: 16px 24px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 24px;
      margin-bottom: 24px;
    }

    .error-banner-content {
      display: flex;
      align-items: flex-start;
      gap: 12px;
    }

    .status-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      flex-shrink: 0;
      margin-top: 8px;
    }

    .status-dot.failed {
      background-color: var(--status-failed);
    }

    .status-dot.good {
      background-color: var(--status-good);
    }

    .status-dot.waiting {
      background-color: var(--status-waiting);
    }

    .error-banner-title {
      font-size: 16px;
      font-weight: 600;
      color: var(--text-main);
      display: flex;
      align-items: center;
      gap: 8px;
      margin-bottom: 4px;
    }

    .error-code {
      font-family: var(--font-mono);
      font-size: 12px;
      color: var(--text-muted);
      background-color: #F0F0F0;
      padding: 2px 6px;
      border-radius: 4px;
    }

    .error-banner-text {
      font-size: 14px;
      line-height: 20px;
      color: var(--text-muted);
    }

    /* Buttons */
    .btn {
      font-family: var(--font-body);
      font-size: 14px;
      font-weight: 600;
      height: 44px;
      padding: 0 16px;
      border-radius: 4px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      text-decoration: none;
      transition: background-color 150ms ease, border-color 150ms ease, opacity 150ms ease;
      white-space: nowrap;
    }

    .btn:focus-visible {
      outline: 2px solid var(--primary);
      outline-offset: 2px;
    }

    .btn-primary {
      background-color: var(--primary);
      color: #FFFFFF;
      border: 1px solid var(--primary);
    }

    .btn-primary:hover:not(:disabled) {
      opacity: 0.92;
    }

    .btn-primary:active:not(:disabled) {
      opacity: 0.84;
    }

    .btn-primary:disabled {
      background-color: #D8D8D8;
      border-color: #D8D8D8;
      color: #8C8C8C;
      cursor: not-allowed;
    }

    .btn-secondary {
      background-color: #FFFFFF;
      color: var(--text-main);
      border: 1px solid var(--border-color);
    }

    .btn-secondary:hover:not(:disabled) {
      background-color: #F8F8F8;
      border-color: #BFBFBF;
    }

    .btn-secondary:active:not(:disabled) {
      background-color: #EEEEEE;
    }

    /* Panels & Sections */
    .panel {
      background-color: var(--bg-panel);
      border: 1px solid var(--border-color);
      border-radius: 4px;
      padding: 24px;
      margin-bottom: 24px;
    }

    .panel-header {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      margin-bottom: 20px;
    }

    .panel-title {
      font-family: var(--font-heading);
      font-size: 24px;
      font-weight: 600;
      line-height: 32px;
      letter-spacing: -0.01em;
      color: var(--text-main);
    }

    .panel-subtitle {
      font-size: 14px;
      color: var(--text-muted);
    }

    /* Step Flow Header */
    .steps-indicator {
      display: flex;
      border-bottom: 1px solid var(--border-color);
      margin-bottom: 24px;
    }

    .step-item {
      flex: 1;
      padding: 12px 16px;
      border-bottom: 2px solid transparent;
      display: flex;
      flex-direction: column;
      gap: 2px;
    }

    .step-item.active {
      border-bottom-color: var(--primary);
    }

    .step-num {
      font-family: var(--font-mono);
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      color: var(--text-muted);
    }

    .step-item.active .step-num {
      color: var(--primary);
      font-weight: 600;
    }

    .step-name {
      font-size: 14px;
      font-weight: 600;
      color: var(--text-main);
    }

    /* Form Grid */
    .form-grid-top {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 16px;
      margin-bottom: 20px;
    }

    .field-group {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    .field-label {
      font-size: 13px;
      font-weight: 600;
      color: var(--text-main);
    }

    .field-input, .field-select {
      height: 44px;
      padding: 0 12px;
      border: 1px solid var(--border-color);
      border-radius: 4px;
      font-family: var(--font-body);
      font-size: 15px;
      background-color: #FFFFFF;
      color: var(--text-main);
      width: 100%;
    }

    .field-input:focus, .field-select:focus {
      outline: 2px solid var(--primary);
      outline-offset: -1px;
    }

    .field-input.mono, .field-select.mono {
      font-family: var(--font-mono);
      font-size: 14px;
    }

    /* Feeding Details Layout */
    .feeding-split {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 24px;
      margin-bottom: 24px;
      padding: 20px;
      background-color: #FAFAFA;
      border: 1px solid var(--border-color);
      border-radius: 4px;
    }

    .info-card {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .card-heading {
      font-family: var(--font-heading);
      font-size: 18px;
      font-weight: 600;
      color: var(--text-main);
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .badge-status {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: 12px;
      font-weight: 500;
      padding: 2px 8px;
      border-radius: 4px;
      background-color: #FFFFFF;
      border: 1px solid var(--border-color);
    }

    .assigned-lots-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 14px;
      background-color: #FFFFFF;
      border: 1px solid var(--border-color);
      border-radius: 4px;
      overflow: hidden;
    }

    .assigned-lots-table th {
      text-align: left;
      padding: 10px 12px;
      background-color: #F8F8F8;
      border-bottom: 1px solid var(--border-color);
      font-size: 12px;
      font-weight: 600;
      color: var(--text-muted);
    }

    .assigned-lots-table td {
      padding: 12px;
      border-bottom: 1px solid var(--border-color);
      vertical-align: middle;
    }

    .assigned-lots-table tr:last-child td {
      border-bottom: none;
    }

    /* Validation Bar */
    .validation-bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 12px 16px;
      border-radius: 4px;
      margin-bottom: 24px;
      font-size: 14px;
    }

    .validation-bar.valid {
      background-color: #EEF6F1;
      border: 1px solid #C4DFC9;
      color: var(--status-good);
    }

    .validation-bar.mismatch {
      background-color: #FDF4E7;
      border: 1px solid #F3DFB8;
      color: var(--status-waiting);
    }

    .validation-summary {
      display: flex;
      align-items: center;
      gap: 8px;
      font-weight: 600;
    }

    .mono-num {
      font-family: var(--font-mono);
      font-variant-numeric: tabular-nums;
    }

    /* Service Outcome Banner (Unknown Outcome on Timeout) */
    .timeout-notice {
      background-color: #FBF5E8;
      border: 1px solid #E4D5BA;
      border-radius: 4px;
      padding: 16px;
      margin-bottom: 24px;
      display: flex;
      align-items: flex-start;
      gap: 12px;
    }

    .timeout-notice-title {
      font-size: 14px;
      font-weight: 600;
      color: var(--status-waiting);
      margin-bottom: 2px;
    }

    .timeout-notice-desc {
      font-size: 13px;
      line-height: 18px;
      color: #5C430B;
    }

    /* Form Footer Controls */
    .form-actions {
      display: flex;
      align-items: center;
      justify-content: flex-end;
      gap: 12px;
      padding-top: 16px;
      border-top: 1px solid var(--border-color);
    }

    /* Full-width Divider between Major Groups */
    .section-divider {
      height: 2px;
      background-color: var(--border-color);
      width: 100%;
      margin: 32px 0;
      border: none;
    }

    /* Saved-Event Worklist Table */
    .table-container {
      background-color: #FFFFFF;
      border: 1px solid var(--border-color);
      border-radius: 4px;
      overflow: hidden;
    }

    .worklist-table {
      width: 100%;
      border-collapse: collapse;
      text-align: left;
    }

    .worklist-table th {
      background-color: #FAFAFA;
      padding: 12px 16px;
      border-bottom: 1px solid var(--border-color);
      font-size: 13px;
      font-weight: 600;
      color: var(--text-muted);
      white-space: nowrap;
    }

    .worklist-table td {
      padding: 12px 16px;
      height: 48px;
      border-bottom: 1px solid var(--border-color);
      font-size: 14px;
      color: var(--text-main);
      vertical-align: middle;
    }

    .worklist-table tr.data-row:hover {
      background-color: #FBFBFB;
    }

    .operator-cell {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .operator-img {
      width: 28px;
      height: 28px;
      border-radius: 4px;
      object-fit: cover;
      aspect-ratio: 1 / 1;
    }

    /* Expanded Details Row */
    .expanded-row td {
      padding: 20px 24px;
      background-color: #FBFBFB;
      border-bottom: 1px solid var(--border-color);
    }

    .expansion-container {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 24px;
    }

    .breakdown-box {
      background-color: #FFFFFF;
      border: 1px solid var(--border-color);
      border-radius: 4px;
      padding: 16px;
    }

    .breakdown-heading {
      font-size: 13px;
      font-weight: 600;
      color: var(--text-main);
      margin-bottom: 12px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .compact-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 13px;
    }

    .compact-table th {
      background: none;
      padding: 6px 8px;
      border-bottom: 1px solid var(--border-color);
      font-size: 12px;
      color: var(--text-muted);
    }

    .compact-table td {
      height: auto;
      padding: 8px;
      border-bottom: 1px solid #ECECEC;
    }

    .compact-table tr:last-child td {
      border-bottom: none;
    }

    /* Service Shortage Warning in History */
    .shortage-callout {
      background-color: #FFF5F4;
      border: 1px solid #F5C7C3;
      border-radius: 4px;
      padding: 10px 14px;
      margin-top: 12px;
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 13px;
      color: var(--status-failed);
    }

    /* Responsiveness */
    @media (max-width: 1024px) {
      .form-grid-top {
        grid-template-columns: 1fr;
      }
      .feeding-split {
        grid-template-columns: 1fr;
      }
      .expansion-container {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 768px) {
      main {
        padding: 20px 16px 48px 16px;
      }
      .panel {
        padding: 16px;
      }
      .header-inner {
        padding: 0 16px;
      }
      .error-banner {
        flex-direction: column;
        align-items: stretch;
      }
      .worklist-table td {
        height: 56px;
      }
    }
  </style>
</head>
<body>

  <!-- Plain Header as specified on every page -->
  <header>
    <div class="header-inner">
      <div class="header-left">
        <a href="#" class="brand">
          <div class="brand-mark">R</div>
          <span class="brand-title">Range Ledger</span>
        </a>
        <nav aria-label="Main Navigation">
          <a href="#" class="nav-item">Yard</a>
          <a href="#" class="nav-item">Imports</a>
          <a href="#" class="nav-item">Allocations</a>
          <a href="#" class="nav-item">Lots</a>
          <a href="#" class="nav-item">Inventory</a>
          <a href="#" class="nav-item">Feed outlook</a>
          <a href="#" class="nav-item">Rations</a>
          <a href="#" class="nav-item">Feed plans</a>
          <a href="#" class="nav-item active">Feeding</a>
          <a href="#" class="nav-item">Reports</a>
          <a href="#" class="nav-item">Feed-to-gain</a>
          <a href="#" class="nav-item">Profitability</a>
          <a href="#" class="nav-item">Sample data</a>
          <a href="#" class="nav-item">Delivery brief</a>
        </nav>
      </div>

      <div class="header-right">
        <!-- Maya Chen real photograph -->
        <img src="https://lh3.googleusercontent.com/aida/AEtjO1XAa7uvZd7Xq8LVl_nyzCwqfifo5S6bt0Dwmj_uVv_13qIjTopbTcMRV94ox3iN8ULgXo2vznLkVlz31bs8teT8by1wA62yy1ry7klO75WokSA-IkFpyxbACGxhtheKwKQX-e88klqVxhe4IxXXXTx6bgUwQnd4nbYU7L7R4lck42xeScWus_KDd37-Jw-7tv9p2AbMuB-8Dq5qiCKYc7nOWvqfL-_dbCLyq5SIYcAB8211dHwunN_vaPqG" alt="Maya Chen portrait" class="user-avatar">
        <div class="user-meta">
          <span class="user-name">Maya Chen</span>
          <span class="user-role">Yard manager</span>
        </div>
      </div>
    </div>
  </header>

  <!-- Main Content -->
  <main class="animate-enter">

    <!-- One single page heading -->
    <h1 class="page-title">Feeding</h1>

    <!-- Inline Error State Notification with Retry Action -->
    <div class="error-banner">
      <div class="error-banner-content">
        <div class="status-dot failed"></div>
        <div>
          <div class="error-banner-title">
            <span>Failed — Telemetry & feeding connection error</span>
            <span class="error-code">ERR_FEED_TELEMETRY_DISCONNECTED</span>
          </div>
          <p class="error-banner-text">
            The yard feeding telemetry and scale ingestion service failed to return real-time bunk telemetry for Red Mesa Yard. Displaying cached baseline ration and draft feeding data.
          </p>
        </div>
      </div>
      <div>
        <button type="button" class="btn btn-primary" onclick="window.location.reload()">
          Retry connection
        </button>
      </div>
    </div>

    <!-- Step Flow: Record Pen-and-Lot Feeding Activity -->
    <section class="panel">
      <div class="panel-header">
        <div>
          <h2 class="panel-title">Record Pen & Lot Feeding</h2>
          <p class="panel-subtitle">Red Mesa Yard • America/Denver (Mountain Time) • Active pens: P-04, P-07, P-12</p>
        </div>
        <div class="badge-status">
          <span class="status-dot waiting live-status-dot"></span>
          <span>Draft active</span>
        </div>
      </div>

      <!-- Touch-friendly Step Flow Header -->
      <div class="steps-indicator">
        <div class="step-item">
          <span class="step-num">Step 1</span>
          <span class="step-name">Choose date & pen</span>
        </div>
        <div class="step-item">
          <span class="step-num">Step 2</span>
          <span class="step-name">Assigned lots & ration</span>
        </div>
        <div class="step-item active">
          <span class="step-num">Step 3</span>
          <span class="step-name">Delivered quantity & lots</span>
        </div>
        <div class="step-item">
          <span class="step-num">Step 4</span>
          <span class="step-name">Review & save</span>
        </div>
      </div>

      <!-- Step 1 & Basic Selectors -->
      <div class="form-grid-top">
        <div class="field-group">
          <label class="field-label" for="feed-date">Feeding date & time (MT)</label>
          <input type="text" id="feed-date" class="field-input mono" value="2025-06-19 06:15 MT">
        </div>
        <div class="field-group">
          <label class="field-label" for="pen-select">Target pen</label>
          <select id="pen-select" class="field-select mono">
            <option value="P-04" selected>Pen P-04 (140 active head, cap 160)</option>
            <option value="P-07">Pen P-07 (126 active head, cap 150)</option>
            <option value="P-12">Pen P-12 (94 active head, cap 180)</option>
          </select>
        </div>
        <div class="field-group">
          <label class="field-label" for="operator-select">Recording operator</label>
          <select id="operator-select" class="field-select">
            <option selected>Eli Navarro — Pen operator</option>
            <option>Maya Chen — Yard manager</option>
          </select>
        </div>
