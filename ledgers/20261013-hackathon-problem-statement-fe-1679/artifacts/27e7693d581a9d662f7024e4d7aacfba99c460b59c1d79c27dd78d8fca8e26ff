      <div class="user-meta">
        <span class="user-name">Maya Chen</span>
        <span class="user-role">Yard manager</span>
      </div>
    </div>
  </header>

  <!-- Main Content Area -->
  <main>
    <!-- Page Heading -->
    <div class="page-title-row">
      <h1>Inventory</h1>
    </div>

    <!-- Error State Inline Alert with Retry Action -->
    <div class="error-banner">
      <div class="error-banner-content">
