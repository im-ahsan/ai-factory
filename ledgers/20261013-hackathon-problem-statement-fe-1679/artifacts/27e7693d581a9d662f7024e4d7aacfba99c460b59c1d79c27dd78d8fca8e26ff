<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Inventory — Range Ledger</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@600;650&family=IBM+Plex+Mono:wght@400;500;600&family=Source+Sans+3:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    /* Design Tokens */
    :root {
      --bg: #F5F5F5;
      --surface: #FFFFFF;
      --text: #262626;
      --text-quiet: #626262;
      --border: #D8D8D8;
      --primary: #B3473D;
      --status-good: #286143;
      --status-waiting: #805600;
      --status-failed: #A13D36;
      --radius: 4px;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      background-color: var(--bg);
      color: var(--text);
      font-family: 'Source Sans 3', sans-serif;
      font-size: 16px;
      line-height: 24px;
      -webkit-font-smoothing: antialiased;
      min-height: 100vh;
    }

    /* Typography */
    h1 {
      font-family: 'Hanken Grotesk', sans-serif;
      font-size: 32px;
      font-weight: 650;
      line-height: 40px;
      color: var(--text);
      letter-spacing: -0.02em;
    }

    h2 {
      font-family: 'Hanken Grotesk', sans-serif;
      font-size: 24px;
      font-weight: 600;
      line-height: 32px;
      color: var(--text);
      letter-spacing: -0.01em;
    }

    h3 {
      font-family: 'Hanken Grotesk', sans-serif;
      font-size: 18px;
      font-weight: 600;
      line-height: 26px;
      color: var(--text);
    }

    .mono {
      font-family: 'IBM Plex Mono', monospace;
    }

    /* Motion */
    @keyframes fadeInLoad {
      from { opacity: 0; transform: translateY(4px); }
      to { opacity: 1; transform: translateY(0); }
    }

    @keyframes live-breathe {
      0%, 100% { opacity: 0.82; }
      50% { opacity: 0.86; }
    }

    .animate-entrance {
      animation: fadeInLoad 400ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    .breathe-dot {
      animation: live-breathe 8s cubic-bezier(0.65, 0, 0.35, 1) infinite;
    }

    @media (prefers-reduced-motion: reduce) {
      *, ::before, ::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
        scroll-behavior: auto !important;
      }
    }

    /* Header */
    header {
      background-color: var(--surface);
      border-bottom: 1px solid var(--border);
      height: 64px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 24px;
      position: sticky;
      top: 0;
      z-index: 50;
    }

    .header-left {
      display: flex;
      align-items: center;
      gap: 32px;
      overflow-x: auto;
      scrollbar-width: none;
    }

    .header-left::-webkit-scrollbar {
      display: none;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 12px;
      text-decoration: none;
      color: var(--text);
      font-family: 'Hanken Grotesk', sans-serif;
      font-size: 18px;
      font-weight: 650;
      flex-shrink: 0;
    }

    .brand-mark {
      width: 28px;
      height: 28px;
      background-color: var(--text);
      color: #FFFFFF;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: 'Hanken Grotesk', sans-serif;
      font-weight: 650;
      font-size: 16px;
      border-radius: var(--radius);
    }

    nav {
      display: flex;
      align-items: center;
      gap: 4px;
    }

    nav a {
      text-decoration: none;
      color: var(--text-quiet);
      font-size: 14px;
      font-weight: 500;
      padding: 8px 12px;
      border-radius: var(--radius);
      white-space: nowrap;
      transition: color 150ms ease, background-color 150ms ease;
    }

    nav a:hover {
      color: var(--text);
      background-color: var(--bg);
    }

    nav a.active {
      color: var(--primary);
      font-weight: 600;
      border-bottom: 2px solid var(--primary);
      border-radius: 0;
      padding-bottom: 6px;
    }

    .header-user {
      display: flex;
      align-items: center;
      gap: 12px;
      flex-shrink: 0;
    }

    .user-avatar {
      width: 36px;
      height: 36px;
      border-radius: var(--radius);
      object-fit: cover;
      aspect-ratio: 1 / 1;
    }

    .user-meta {
      display: flex;
      flex-direction: column;
      line-height: 1.2;
    }

    .user-name {
      font-size: 14px;
      font-weight: 600;
      color: var(--text);
    }

    .user-role {
      font-size: 12px;
      color: var(--text-quiet);
    }

    /* Main Container */
    main {
      max-width: 1440px;
      margin: 0 auto;
      padding: 32px 24px 64px 24px;
      display: flex;
      flex-direction: column;
      gap: 24px;
    }

    /* Page Title & Context */
    .page-title-row {
      display: flex;
      flex-direction: column;
      gap: 4px;
    }

    /* Full-width 2px Group Separator */
    .group-separator {
      width: 100%;
      height: 2px;
      background-color: var(--border);
      margin: 8px 0;
    }

    /* Panels */
    .panel {
      background-color: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 24px;
      display: flex;
      flex-direction: column;
      gap: 20px;
    }

    /* Error Alert */
    .error-banner {
      background-color: var(--surface);
      border: 1px solid var(--status-failed);
      border-radius: var(--radius);
      padding: 20px 24px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 24px;
    }

    .error-banner-content {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    .error-headline {
      display: flex;
      align-items: center;
      gap: 8px;
      font-family: 'Hanken Grotesk', sans-serif;
      font-size: 16px;
      font-weight: 600;
      color: var(--status-failed);
    }

    .error-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background-color: var(--status-failed);
      display: inline-block;
    }

    .error-desc {
      font-size: 14px;
      color: var(--text-quiet);
      line-height: 20px;
    }

    /* Buttons & Controls */
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      height: 44px;
      padding: 0 16px;
      border-radius: var(--radius);
      font-family: 'Source Sans 3', sans-serif;
      font-size: 15px;
      font-weight: 600;
      cursor: pointer;
      text-decoration: none;
      transition: background-color 150ms ease, border-color 150ms ease, opacity 150ms ease;
    }

    .btn:focus-visible {
      outline: 2px solid var(--primary);
      outline-offset: 2px;
    }

    .btn-primary {
      background-color: var(--primary);
      color: #FFFFFF;
      border: 1px solid var(--primary);
    }

    .btn-primary:hover {
      background-color: #9c3c33;
      border-color: #9c3c33;
    }

    .btn-primary:active {
      background-color: #85332b;
    }

    .btn-secondary {
      background-color: var(--surface);
      color: var(--text);
      border: 1px solid var(--border);
    }

    .btn-secondary:hover {
      background-color: var(--bg);
      border-color: #c4c4c4;
    }

    .btn-secondary:active {
      background-color: #e8e8e8;
    }

    /* Headline Metric Card */
    .metric-hero {
      display: flex;
      flex-direction: column;
      gap: 8px;
      padding-bottom: 20px;
      border-bottom: 1px solid var(--border);
    }

    .metric-value-row {
      display: flex;
      align-items: baseline;
      gap: 12px;
      flex-wrap: wrap;
    }

    .headline-number {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 36px;
      font-weight: 600;
      line-height: 44px;
      color: var(--text);
      letter-spacing: -0.02em;
    }

    .headline-label {
      font-family: 'Hanken Grotesk', sans-serif;
      font-size: 20px;
      font-weight: 600;
      color: var(--text-quiet);
    }

    .metric-context {
      font-size: 14px;
      color: var(--text-quiet);
      display: flex;
      align-items: center;
      gap: 16px;
      flex-wrap: wrap;
    }

    .meta-tag {
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }

    /* Inventory Items Summary Strip */
    .stock-cards-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 16px;
    }

    .stock-summary-card {
      background-color: var(--bg);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 14px 16px;
      display: flex;
      flex-direction: column;
      gap: 4px;
    }

    .stock-summary-name {
      font-size: 13px;
      font-weight: 600;
      color: var(--text-quiet);
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }

    .stock-summary-qty {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 20px;
      font-weight: 600;
      color: var(--text);
    }

    .stock-summary-pct {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 12px;
      color: var(--text-quiet);
    }

    /* Controls Bar & Filters */
    .controls-bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      flex-wrap: wrap;
    }

    .filter-group {
      display: flex;
      align-items: center;
      gap: 12px;
      flex-wrap: wrap;
    }

    .filter-field {
      display: flex;
      flex-direction: column;
      gap: 4px;
    }

    .filter-label {
      font-size: 12px;
      font-weight: 600;
      color: var(--text-quiet);
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }

    select, input[type="text"], input[type="number"] {
      height: 44px;
      padding: 0 12px;
      background-color: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      color: var(--text);
      font-family: 'Source Sans 3', sans-serif;
      font-size: 14px;
      min-width: 170px;
    }

    select:focus, input:focus {
      outline: 2px solid var(--primary);
      outline-offset: 0;
      border-color: var(--primary);
    }

    .actions-group {
      display: flex;
      align-items: center;
      gap: 12px;
      flex-wrap: wrap;
    }

    .wastage-control {
      display: flex;
      align-items: center;
      gap: 8px;
      background-color: var(--bg);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 4px 12px;
      height: 44px;
    }

    .wastage-label {
      font-size: 13px;
      font-weight: 500;
      color: var(--text-quiet);
      white-space: nowrap;
    }

    .wastage-input {
      width: 70px;
      height: 34px;
      padding: 0 8px;
      background-color: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      font-family: 'IBM Plex Mono', monospace;
      font-size: 14px;
      font-weight: 600;
      color: var(--text);
      text-align: right;
    }

    /* Dense Formal Table */
    .table-container {
      width: 100%;
      overflow-x: auto;
      border: 1px solid var(--border);
      border-radius: var(--radius);
      background-color: var(--surface);
    }

    table {
      width: 100%;
      border-collapse: collapse;
      text-align: left;
    }

    thead {
      background-color: var(--bg);
      border-bottom: 1px solid var(--border);
    }

    th {
      padding: 12px 16px;
      font-size: 12px;
      font-weight: 600;
      color: var(--text-quiet);
      text-transform: uppercase;
      letter-spacing: 0.04em;
      white-space: nowrap;
      height: 44px;
    }

    td {
      padding: 12px 16px;
      font-size: 14px;
      color: var(--text);
      border-bottom: 1px solid var(--border);
      height: 48px;
      vertical-align: middle;
      white-space: nowrap;
    }

    tbody tr:last-child td {
      border-bottom: none;
    }

    tbody tr:hover {
      background-color: #FAFAFA;
    }

    /* Sample Record Highlighting */
    tr.sample-row {
      background-color: #FAF9F6;
    }

    .sample-pill {
      display: inline-flex;
      align-items: center;
      padding: 2px 6px;
      background-color: #EFECE6;
      border: 1px solid #D8D2C4;
      border-radius: var(--radius);
      font-size: 11px;
      font-weight: 600;
      color: #7A6F5D;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    /* Status indicators */
    .status-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: 13px;
      font-weight: 500;
    }

    .status-badge.good {
      color: var(--status-good);
    }

    .status-badge.waiting {
      color: var(--status-waiting);
    }

    .status-badge.failed {
      color: var(--status-failed);
    }

    .status-dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
    }

    .status-dot.good {
      background-color: var(--status-good);
    }

    .status-dot.waiting {
      background-color: var(--status-waiting);
    }

    .status-dot.failed {
      background-color: var(--status-failed);
    }

    /* Staff Avatar in Table */
    .staff-cell {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .staff-avatar {
      width: 24px;
      height: 24px;
      border-radius: var(--radius);
      object-fit: cover;
      aspect-ratio: 1 / 1;
    }

    .staff-name {
      font-size: 13px;
      font-weight: 500;
      color: var(--text);
    }

    /* Modal / Stepwise Form Drawer Simulation */
    .form-panel {
      border: 1px solid var(--border);
      border-radius: var(--radius);
      background-color: var(--bg);
      padding: 20px 24px;
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    .form-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .steps-indicator {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 12px;
      color: var(--text-quiet);
    }

    .step-item {
      display: flex;
      align-items: center;
      gap: 6px;
      font-weight: 500;
    }

    .step-item.active {
      font-weight: 600;
      color: var(--text);
    }

    .step-num {
      width: 20px;
      height: 20px;
      border-radius: 50%;
      background-color: var(--border);
      color: var(--text);
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: 'IBM Plex Mono', monospace;
      font-size: 11px;
      font-weight: 600;
    }

    .step-item.active .step-num {
      background-color: var(--primary);
      color: #FFFFFF;
    }

    .form-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 16px;
    }

    .field-label {
      font-size: 12px;
      font-weight: 600;
      color: var(--text-quiet);
      margin-bottom: 4px;
      display: block;
    }

    .form-actions {
      display: flex;
      align-items: center;
      justify-content: flex-end;
      gap: 12px;
      padding-top: 8px;
      border-top: 1px solid var(--border);
    }

    /* Mobile Responsive */
    @media (max-width: 768px) {
      header {
        padding: 0 16px;
      }

      .header-left {
        gap: 16px;
      }

      main {
        padding: 20px 16px 48px 16px;
      }

      .panel {
        padding: 16px;
      }

      .stock-cards-grid {
        grid-template-columns: 1fr;
      }

      .form-grid {
        grid-template-columns: 1fr;
      }

      .error-banner {
        flex-direction: column;
        align-items: flex-start;
      }

      .controls-bar {
        flex-direction: column;
        align-items: stretch;
      }

      .filter-group {
        flex-direction: column;
        align-items: stretch;
      }

      .filter-group select {
        width: 100%;
      }

      .actions-group {
        flex-direction: column;
        align-items: stretch;
      }

      .btn {
        height: 48px;
      }

      td {
        height: 56px;
      }
    }
  </style>
</head>
