            </select>
          </div>

          <div class="filter-field">
            <label class="filter-label" for="filter-type">Movement Category</label>
            <select id="filter-type">
              <option value="all">All categories</option>
              <option value="receipt">Intake receipt</option>
              <option value="feeding">Delivered feed</option>
              <option value="wastage">Actual wastage</option>
            </select>
          </div>

          <div class="filter-field">
            <label class="filter-label" for="filter-status">Record Type</label>
            <select id="filter-status">
              <option value="operational">Operational records (active)</option>
              <option value="all">All (including sample records)</option>
            </select>
          </div>
        </div>

        <div class="actions-group">
          <!-- Editable Wastage Setting -->
          <div class="wastage-control">
            <span class="wastage-label">Configured wastage:</span>
