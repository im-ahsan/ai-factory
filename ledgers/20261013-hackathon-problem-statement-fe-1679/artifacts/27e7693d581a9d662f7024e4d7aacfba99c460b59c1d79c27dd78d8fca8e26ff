        </div>
        <div class="stock-summary-card">
          <span class="stock-summary-name">Alfalfa hay</span>
          <span class="stock-summary-qty">18,400 lb</span>
          <span class="stock-summary-pct">13.4% of operational stock</span>
        </div>
        <div class="stock-summary-card">
          <span class="stock-summary-name">Mineral premix</span>
          <span class="stock-summary-qty">3,200 lb</span>
          <span class="stock-summary-pct">2.3% of operational stock</span>
        </div>
      </div>
    </div>

    <!-- Group Separator -->
    <div class="group-separator"></div>

    <!-- Primary Inventory Worklist & Operations Section -->
    <div class="panel">
      <div class="controls-bar">
        <div class="filter-group">
          <div class="filter-field">
            <label class="filter-label" for="filter-commodity">Commodity Item</label>
