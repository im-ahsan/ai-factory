ns\",\n  \"when\": \"The authorized user saves mappings or the other user's screen renders using returned permissions\"\n },\n {\n  \"req\": \"REQ-3\",\n  \"given\": \"An edited allocation conflicts with a PO line's returned head count or a pen's returned capacity and the mapping service refuses the save\",\n  \"id\": \"AC-3.4\",\n  \"level\": \"ui\",\n  \"then\": \"The screen displays the returned error and the last saved mapping values remain displayed\",\n  \"when\": \"The user submits the mapping changes\"\n },\n {\n  \"req\": \"REQ-4\",\n  \"given\": \"The import response identifies source records as matched to existing records\",\n  \"id\": \"AC-4.1\",\n  \"level\": \"ui\",\n  \"then\": \"The screen displays the matched record list and response status without displaying those records as newly created duplicates\",\n  \"when\": \"The repeated import completes\"\n },\n {\n  \"req\": \"REQ-4\",\n  \"given\": \"A repeated-import response updates a PO line's head count below its existing mapped allocation quantities and returns an allocation conflict\",\n  \"id\": \"AC-4.2\",\n  \"level\": \"ui\",\n  \"then\": \"The screen displays the matched record, returned head count, existing mapped quantities, and an allocation-conflict flag without presenting the record as a new duplicate\",\n  \"when\": \"The repeated import completes\"\n },\n {\n  \"req\": \"REQ-5\",\n  \"given\": \"The forecast response contains incoming animal data, yard defaults, and a lot-specific override\",\n  \"id\": \"AC-5.1\",\n  \"level\": \"ui\",\n  \"then\": \"The screen displays the returned incoming data, target weight, expected gain rate, projected market date, and forecast basis using the lot-specific override\",\n  \"when\": \"A user opens the lot forecast\"\n },\n {\n  \"req\": \"REQ-5\",\n  \"given\": \"A lot forecast has no positive gain rate available\",\n  \"id\": \"AC-5.2\",\n  \"level\": \"ui\",\n  \"then\": \"The projected date field displays an unavailable value on the screen\",\n