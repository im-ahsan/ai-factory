  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    :root {
      --bg-page: #F5F5F5;
      --bg-surface: #FFFFFF;
      --text-main: #262626;
      --text-muted: #626262;
      --border-color: #D8D8D8;
      --primary-accent: #B3473D;
      --status-good: #286143;
      --status-waiting: #805600;
      --status-failed: #A13D36;
    }

    body {
      background-color: var(--bg-page);
      color: var(--text-main);
      font-family: 'Source Sans 3', sans-serif;
      font-size: 16px;
      line-height: 24px;
      margin: 0;
      padding: 0;
      -webkit-font-smoothing: antialiased;
    }

    h1, h2, h3, .heading-font {
      font-family: 'Hanken Grotesk', sans-serif;
    }

    .num-font {
      font-family: 'IBM Plex Mono', monospace;
    }

    /* Motion Keyframes */
    @keyframes entranceFadeUp {
      from {
        opacity: 0;
        transform: translateY(6px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes live-breathe {
      0%, 100% {
        opacity: 0.82;
      }
      50% {
        opacity: 0.86;
      }
    }

    @keyframes track-fill {
      from {
        width: 0%;
      }
      to {
        width: 100%;
      }
    }

    .animate-entrance {
      animation: entranceFadeUp 420ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    .status-dot-pulse {
      animation: live-breathe 8s cubic-bezier(0.65, 0, 0.35, 1) infinite;
    }

    /* Track animation motion rule specified in prompt */
    .feeding-track {
      animation-timeline: view();
      animation-range: entry 0% entry 55%;
      animation-duration: 420ms;
      animation-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
    }

    /* Control interactive states */
    button, input, select, a {
      transition: background-color 150ms ease, border-color 150ms ease, color 150ms ease;
    }

    input:focus, select:focus, button:focus {
      outline: 2px solid var(--primary-accent);
      outline-offset: 1px;
    }

    @media (prefers-reduced-motion: reduce) {
      *, ::before, ::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
        scroll-behavior: auto !important;
      }
    }
  </style>
</head>
