+
+const fixtureSession: SessionState = {
+  accessToken: "demo-token-01",
+  id: 1,
+  name: "Riley Morgan",
+  email: "riley@example.test",
+  landingPage: "/yard",
+  permissions: ["yard.view", "inventory.view"],
+  authorizedYards: [{ id: 1, name: "North Yard" }],
+};
