+  const successFixture = fixtureKey === "successful-sign-in-routes-to-the-returned-landing-page" || fixtureKey === "successful-sign-in";
+  const routedFixture = useRef(false);
+  const [isSubmitting, setIsSubmitting] = useState(submittingFixture || successFixture);
+  const [serviceError, setServiceError] = useState(errorFixture ? fixtureError : "");
+  const [fieldErrors, setFieldErrors] = useState<{ email?: string; password?: string }>({});
+
+  useEffect(() => {
+    if (!successFixture || routedFixture.current) return;
+    routedFixture.current = true;
+    writeSession(fixtureSession);
+    go(fixtureSession.landingPage);
+  }, [go, successFixture]);
+
+  async function handleSubmit(event: FormEvent<HTMLFormElement>) {
+    event.preventDefault();
+    if (fixture !== undefined || isSubmitting) return;
+
+    const formData = new FormData(event.currentTarget);
+    const email = String(formData.get("email") ?? "").trim();
+    const password = String(formData.get("password") ?? "");
+    const nextFieldErrors: { email?: string; password?: string } = {};
+
+    if (!email) nextFieldErrors.email = "Email is required.";
