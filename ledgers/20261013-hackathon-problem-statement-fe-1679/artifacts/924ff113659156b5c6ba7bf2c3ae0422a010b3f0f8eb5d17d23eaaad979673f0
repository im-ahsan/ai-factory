+      if (response.status === 200) {
+        const { accessToken, user } = response.data;
+        writeSession({ accessToken, ...user });
+        go(user.landingPage);
+        return;
+      }
+
+      setServiceError(response.data.message);
+      setFieldErrors({
+        email: response.data.fieldErrors?.email,
+        password: response.data.fieldErrors?.password,
+      });
+    } catch {
+      setServiceError("Sign in could not be completed. Try again.");
+    } finally {
+      setIsSubmitting(false);
+    }
+  }
