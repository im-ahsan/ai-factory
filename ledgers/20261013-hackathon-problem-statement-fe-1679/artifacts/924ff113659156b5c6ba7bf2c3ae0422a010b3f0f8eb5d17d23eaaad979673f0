+          <Card className="grid gap-5 p-6 sm:p-8">
+            <div className="grid gap-2">
+              <h1 className="font-heading text-2xl font-semibold tracking-tight">Sign in</h1>
+              <p className="text-sm text-muted-foreground">Use your work account to open your yard.</p>
+            </div>
+            {serviceError && (
+              <Notice tone="bad">
+                <NoticeDescription>{serviceError}</NoticeDescription>
+              </Notice>
+            )}
+            {successFixture && (
+              <p role="status" className="text-sm text-muted-foreground">Signed in. Opening your yard…</p>
+            )}
+            <form className="grid gap-5" noValidate onSubmit={handleSubmit}>
+              <div className="grid gap-2">
+                <Label htmlFor={emailId}>Email</Label>
+                <Input
+                  id={emailId}
+                  name="email"
+                  type="email"
+                  autoComplete="email"
+                  required
+                  aria-invalid={fieldErrors.email ? true : undefined}
+                  aria-describedby={fieldErrors.email ? `${emailId}-error` : undefined}
+                />
+                {fieldErrors.email && <p id={`${emailId}-error`} className="text-sm text-destructive">{fieldErrors.email}</p>}
+              </div>
+              <div className="grid gap-2">
+                <Label htmlFor={passwordId}>Password</Label>
+                <Input
+                  id={passwordId}
+                  name="password"
+                  type="password"
+                  autoComplete="current-password"
+                  required
+                  aria-invalid={fieldErrors.password ? true : undefined}
+                  aria-describedby={fieldErrors.password ? `${passwordId}-error` : undefined}
+                />
+                {fieldErrors.password && <p id={`${passwordId}-error`} className="text-sm text-destructive">{fieldErrors.password}</p>}
+              </div>
+              <Button type="submit" size="lg" className="w-full" disabled={isSubmitting || fixture !== undefined}>
+                {isSubmitting ? "Signing in…" : "Sign in"}
+              </Button>
+            </form>
+          </Card>
+        </div>
+      </section>
     </main>
   );
 }
