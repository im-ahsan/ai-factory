+function normalizeState(state?: string) {
+  return state?.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "") ?? "";
+}
+
 export function SignInContainer({ fixture }: { fixture?: string }) {
+  const { go } = useNav();
+  const emailId = useId();
+  const passwordId = useId();
+  const fixtureKey = normalizeState(fixture);
+  const submittingFixture = fixtureKey === "submitting-credentials";
