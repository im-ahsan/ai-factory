+import { signIn } from "@/lib/api/client";
+import { writeSession } from "@/lib/auth/session";
+import { useNav } from "@/lib/nav";
+
+const fixtureMessage = "The email address or password you entered is incorrect.";
+
 export function SignInContainer({ fixture }: { fixture?: string }) {
+  const { go } = useNav();
+  const emailId = useId();
+  const passwordId = useId();
+  const fixtureKey = fixture?.toLowerCase() ?? "";
+  const fixtureSubmitting = /submitting|loading/.test(fixtureKey);
+  const fixtureError = /authentication|error|refused|failure/.test(fixtureKey);
+  const fixtureSuccess = /successful|success|landing|returned-landing/.test(fixtureKey);
+  const [email, setEmail] = useState("");
+  const [passphrase, setPassphrase] = useState("");
+  const [submitting, setSubmitting] = useState(fixtureSubmitting);
+  const [serviceError, setServiceError] = useState(fixtureError ? fixtureMessage : "");
+  const [emailError, setEmailError] = useState("");
+  const [passphraseError, setPassphraseError] = useState("");
+
+  async function submit(event: FormEvent<HTMLFormElement>) {
+    event.preventDefault();
+    if (fixture !== undefined) return;
+
+    const normalizedEmail = email.trim();
+    const emailIsValid = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(normalizedEmail);
+    const missingPassphrase = passphrase.length === 0;
+    setEmailError(!normalizedEmail ? "Enter your email address." : !emailIsValid ? "Enter a valid email address." : "");
+    setPassphraseError(missingPassphrase ? "Enter your password." : "");
+    setServiceError("");
+    if (!emailIsValid || missingPassphrase) return;
+
+    setSubmitting(true);
+    try {
+      const response = await signIn({ email: normalizedEmail, password: passphrase });
+      if (response.status === 200) {
+        writeSession({ accessToken: response.data.accessToken, ...response.data.user });
+        go(response.data.user.landingPage);
+        return;
+      }
+
+      const fieldErrors = response.data.fieldErrors;
+      setEmailError(fieldErrors?.email ?? "");
+      setPassphraseError(fieldErrors?.password ?? "");
+      setServiceError(response.data.message);
+    } catch {
+      setServiceError("Unable to sign in right now. Please try again.");
+    } finally {
+      setSubmitting(false);
+    }
+  }
+
   return (
-    <main data-screen="S-1" data-state={fixture ?? "default"}>
-      <h1>Sign in</h1>
-    </main>
+    <div data-screen="S-1" data-state={fixture ?? "default"} className="grid min-h-[calc(100dvh-3.5rem)] place-items-center bg-background px-4 py-10">
+      <div className="w-full max-w-sm">
+        <header className="mb-6 text-center">
+          <h2 className="font-heading text-2xl font-semibold">Range Ledger</h2>
+        </header>
+        <main aria-labelledby={`${emailId}-heading`}>
