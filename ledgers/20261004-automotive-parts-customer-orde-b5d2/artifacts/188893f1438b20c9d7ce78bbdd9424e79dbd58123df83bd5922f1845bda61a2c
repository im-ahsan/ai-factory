n    \"no repository: this is new build work\"\n   ],\n   \"span\": \"I-41\"\n  },\n  {\n   \"searched\": [\n    \"no repository: this is new build work\"\n   ],\n   \"span\": \"I-42\"\n  },\n  {\n   \"searched\": [\n    \"no repository: this is new build work\"\n   ],\n   \"span\": \"I-43\"\n  },\n  {\n   \"searched\": [\n    \"no repository: this is new build work\"\n   ],\n   \"span\": \"I-44\"\n  },\n  {\n   \"searched\": [\n    \"no repository: this is new build work\"\n   ],\n   \"span\": \"I-45\"\n  }\n ]\n}\n</artifact>\n\n<artifact id=\"sketches\" kind=\"sketches\" sha=\"\">\n[]\n</artifact>\n\n<artifact id=\"differences\" kind=\"differences\" sha=\"\">\n[\n {\n  \"id\": \"D-1.52\",\n  \"readings\": [\n   {\n    \"behaviour\": 0,\n    \"sketch\": 1,\n    \"summary\": \"Invalid login shows a clear 'incorrect credentials' style message\"\n   },\n   {\n    \"behaviour\": 0,\n    \"sketch\": 3,\n    \"summary\": \"Invalid login shows a generic 'invalid credentials' message without revealing whether username or password was wrong\"\n   }\n  ],\n  \"span\": \"52-error-handling\",\n  \"topic\": \"Invalid login message specificity\"\n },\n {\n  \"id\": \"D-2.54\",\n  \"readings\": [\n   {\n    \"behaviour\": 0,\n    \"sketch\": 1,\n    \"summary\": \"Loading indicators shown during async operations (catalogue, search, etc.)\"\n   },\n   {\n    \"behaviour\": 1,\n    \"sketch\": 3,\n    \"summary\": \"During order submission or checkout, submit control is disabled/hidden to prevent duplicate submissions while loading\"\n   }\n  ],\n  \"span\": \"54-loading-states\",\n  \"topic\": \"Duplicate submission prevention during loading\"\n },\n {\n  \"id\": \"D-3.56\",\n  \"readings\": [\n   {\n    \"behaviour\": 0,\n    \"sketch\": 2,\n    \"summary\": \"Staff can navigate to and use staff sign in as first screen in list of 11 staff screens\"\n   },\n   {\n    \"behaviour\": 1,\n    \"sketch\": 3,\n    \"summary\": \"Staff sign-in is a separate login flow/route from custom