ices.AddOpenApi();\",\n     \"symbol\": \"Program startup\"\n    },\n    {\n     \"lineEnd\": 31,\n     \"lineStart\": 27,\n     \"path\": \"App.Api/Program.cs\",\n     \"quote\": \"app.UseCors();\\napp.MapGet(\\\"/\\\", () => \\\"API is up\\\").ExcludeFromDescription();\\n// The API's own document (/openapi/v1.json) and a page to read and try it (/swagger). Keep both: the factory's product page links to the page.\\napp.MapOpenApi();\\napp.UseSwaggerUI(o => o.SwaggerEndpoint(\\\"/openapi/v1.json\\\", \\\"API\\\"));\",\n     \"symbol\": \"Program\"\n    }\n   ],\n   \"id\": \"C-1\",\n   \"spans\": [\n    \"I-1\"\n   ],\n   \"text\": \"The existing API is an ASP.NET Core .NET 9 project. Its startup registers OpenAPI and currently exposes a root health response plus OpenAPI and Swagger UI; this is an API shell rather than an implementation of the portal operations.\"\n  },\n  {\n   \"anchors\": [\n    {\n     \"lineEnd\": 12,\n     \"lineStart\": 1,\n     \"path\": \"contracts/openapi.yaml\",\n     \"quote\": \"openapi: 3.0.3\\ninfo:\\n  title: Meridian Cold Chain API\\n  version: 1.0.0\\n  description: \\\"Shared contract for the Meridian responsive web portal.\\\"\\nservers:\\n  - url: /api\\npaths:\\n  /auth/staff/authorization-url:\\n    get:\\n      operationId: getStaffAuthorizationUrl\\n      summary: \\\"Get the configured staff identity-provider authorization URL.\\\"\",\n     \"symbol\": \"OpenAPI paths\"\n    },\n    {\n     \"lineEnd\": 164,\n     \"lineStart\": 144,\n     \"path\": \"contracts/openapi.yaml\",\n     \"quote\": \"  /warehouse/receipts:\\n    get:\\n      operationId: listReceipts\\n      summary: \\\"List warehouse-scoped receipts using supplied filters.\\\"\\n      parameters:\\n        - $ref: \\\"#/components/parameters/Search\\\"\\n        - $ref: \\\"#/components/parameters/Status\\\"\\n        - $ref: \\\"#/components/parameters/DateFrom\\\"\\n        - $ref: \\\"#/components/parameters/DateTo\\\"\\n      responses:\\n        \\\"200\\