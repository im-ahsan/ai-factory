s\\n      summary: \\\"List warehouse-scoped receipts using supplied filters.\\\"\\n      parameters:\\n        - $ref: \\\"#/components/parameters/Search\\\"\\n        - $ref: \\\"#/components/parameters/Status\\\"\\n        - $ref: \\\"#/components/parameters/DateFrom\\\"\\n        - $ref: \\\"#/components/parameters/DateTo\\\"\\n      responses:\\n        \\\"200\\\":\\n          $ref: \\\"#/components/responses/Collection\\\"\\n        \\\"401\\\":\\n          $ref: \\\"#/components/responses/Unauthorized\\\"\\n        \\\"403\\\":\\n          $ref: \\\"#/components/responses/Forbidden\\\"\\n        \\\"500\\\":\\n          $ref: \\\"#/components/responses/ServerError\\\"\\n    post:\\n      operationId: createReceipt\\n      summary: \\\"Record and quarantine an inbound receipt.\\\"\",\n     \"symbol\": \"listReceipts / createReceipt\"\n    },\n    {\n     \"lineEnd\": 31,\n     \"lineStart\": 28,\n     \"path\": \"App.Api/Program.cs\",\n     \"quote\": \"app.MapGet(\\\"/\\\", () => \\\"API is up\\\").ExcludeFromDescription();\\n// The API's own document (/openapi/v1.json) and a page to read and try it (/swagger). Keep both: the factory's product page links to the page.\\napp.MapOpenApi();\\napp.UseSwaggerUI(o => o.SwaggerEndpoint(\\\"/openapi/v1.json\\\", \\\"API\\\"));\",\n     \"symbol\": \"Program\"\n    }\n   ],\n   \"id\": \"C-2\",\n   \"spans\": [\n    \"I-2\"\n   ],\n   \"text\": \"The locked contract is present as OpenAPI 3.0.3, rooted at `/api`, and specifies operations such as staff authorization and receipt listing/creation. The application does not map those contract operations: its only business route mapping is `GET /`, which is excluded from the generated description; it serves its own generated OpenAPI document and Swagger UI instead.\"\n  },\n  {\n   \"anchors\": [\n    {\n     \"lineEnd\": 7,\n     \"lineStart\": 5,\n     \"path\": \"App.Api/AppDb.cs\",\n     \"quote\": \"public class AppDb(DbContextOptions<AppDb> options) : DbContext(options