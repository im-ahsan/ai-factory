 \"contracts/openapi.yaml\",\n     \"lineStart\": 2575,\n     \"lineEnd\": 2585,\n     \"quote\": \"          example:\\n            items:\\n              - id: 3101\\n                name: \\\"Cedar Clinic receipt\\\"\\n                status: \\\"Quarantined\\\"\\n                productName: \\\"Vaccine Pack\\\"\\n                lotNumber: \\\"LOT-2026-041\\\"\\n                expiryDate: \\\"2027-06-30\\\"\\n                quantity: 24\"\n    },\n    {\n     \"path\": \"App.Api/Program.cs\",\n     \"lineStart\": 20,\n     \"lineEnd\": 24,\n     \"quote\": \"        using var scope = app.Services.CreateScope();\\n        var db = scope.ServiceProvider.GetRequiredService<AppDb>();\\n        db.Database.EnsureCreated();\\n        // sample rows, only when asked for (Seed__Demo=true): tests and the factory's own checks start on an empty database\\n        if (app.Configuration.GetValue<bool>(\\\"Seed:Demo\\\")) SeedData.Run(db);\"\n    }\n   ],\n   \"sources\": [\n    \"I-3\",\n    \"I-4\"\n   ],\n   \"acceptance\": [\n    {\n     \"id\": \"AC-3.1\",\n     \"given\": \"A configured PostgreSQL database, valid staff identity-provider settings, and `Seed:Demo` set to true.\",\n     \"when\": \"The API starts and a client requests `GET /`.\",\n     \"then\": \"The response status is 200.\",\n     \"level\": \"api\"\n    }\n   ],\n   \"stability\": 0.6666666666666666\n  },\n  {\n   \"id\": \"REQ-4\",\n   \"ears\": \"When `SeedData.Run` is called, the Meridian Cold Chain API shall add between two and five contract-example-based rows only to each empty contract-backed table, preserve existing rows, and create references that resolve to existing related rows.\",\n   \"op\": \"MODIFIED\",\n   \"anchors\": [\n    {\n     \"path\": \"App.Api/SeedData.cs\",\n     \"lineStart\": 5,\n     \"lineEnd\": 9,\n     \"quote\": \"public static class SeedData\\n{\\n    public static void Run(AppDb db)\\n    {\\n    }\"\n    }\n   ],\n   \"sources\": [\n    \"I-3\",\n    \"Q-2\",\n   