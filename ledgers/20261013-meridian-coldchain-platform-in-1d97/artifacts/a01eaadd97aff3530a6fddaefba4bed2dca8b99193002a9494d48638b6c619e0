d table.\",\n     \"level\": \"api\"\n    }\n   ],\n   \"stability\": 0.3333333333333333\n  },\n  {\n   \"id\": \"REQ-6\",\n   \"ears\": \"If a contract collection operation has no matching persisted records, then the Meridian API shall return an empty list rather than unpersisted sample records.\",\n   \"op\": \"MODIFIED\",\n   \"anchors\": [\n    {\n     \"path\": \"App.Api/Program.cs\",\n     \"lineStart\": 20,\n     \"lineEnd\": 24,\n     \"quote\": \"        using var scope = app.Services.CreateScope();\\n        var db = scope.ServiceProvider.GetRequiredService<AppDb>();\\n        db.Database.EnsureCreated();\\n        // sample rows, only when asked for (Seed__Demo=true): tests and the factory's own checks start on an empty database\\n        if (app.Configuration.GetValue<bool>(\\\"Seed:Demo\\\")) SeedData.Run(db);\"\n    }\n   ],\n   \"sources\": [\n    \"I-1\",\n    \"I-4\",\n    \"Q-4\"\n   ],\n   \"acceptance\": [\n    {\n     \"id\": \"AC-6.1\",\n     \"given\": \"The configured PostgreSQL database has no matching persisted records for a contract collection operation and `Seed:Demo` is false.\",\n     \"when\": \"A client calls that collection operation.\",\n     \"then\": \"The response status is the contract-declared success status, the returned list count is 0, and the database row count remains zero.\",\n     \"level\": \"api\"\n    }\n   ],\n   \"stability\": 1\n  },\n  {\n   \"id\": \"REQ-7\",\n   \"ears\": \"The Meridian API shall use the existing staff identity provider with its authorization URL and token-validation settings supplied by deployment configuration, including explicit valid settings for test and factory runs, return the configured URL from the contracted authorization-URL operation, and validate staff tokens using those settings.\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-1\",\n    \"Q-3\",\n    \"Q-5\"\n   ],\n   \"acceptance\": [\n    {\n     \"id\": \"AC-7.1\",\n     \"given\": \"Valid deployment configuration for the