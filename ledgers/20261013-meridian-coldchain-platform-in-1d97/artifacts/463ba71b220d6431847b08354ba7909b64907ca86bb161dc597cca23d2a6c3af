nents/responses/Unauthorized\\\"\\n        \\\"403\\\":\\n          $ref: \\\"#/components/responses/Forbidden\\\"\\n        \\\"500\\\":\\n          $ref: \\\"#/components/responses/ServerError\\\"\\n    post:\\n      operationId: createAccount\\n      summary: \\\"Create an account and assign its roles and access scope.\\\"\\n      requestBody:\\n        required: true\\n        content:\\n          application/json:\\n            schema:\\n              $ref: \\\"#/components/schemas/AccountInput\\\"\\n      responses:\\n        \\\"200\\\":\\n          $ref: \\\"#/components/responses/RecordResult\\\"\\n        \\\"400\\\":\\n          $ref: \\\"#/components/responses/BadRequest\\\"\\n        \\\"401\\\":\\n          $ref: \\\"#/components/responses/Unauthorized\\\"\\n        \\\"403\\\":\\n          $ref: \\\"#/components/responses/Forbidden\\\"\\n        \\\"409\\\":\\n          $ref: \\\"#/components/responses/Conflict\\\"\"\n    },\n    {\n     \"lineEnd\": 1060,\n     \"lineStart\": 1036,\n     \"path\": \"contracts/openapi.yaml\",\n     \"quote\": \"  /quality/recalls/{recallId}/write-offs:\\n    post:\\n      operationId: writeOffRecallRemainder\\n      summary: \\\"Submit a signed Quality Manager write-off for unaccounted recall quantity.\\\"\\n      parameters:\\n        - $ref: \\\"#/components/parameters/RecallId\\\"\\n      requestBody:\\n        required: true\\n        content:\\n          application/json:\\n            schema:\\n              $ref: \\\"#/components/schemas/WriteOffInput\\\"\\n      responses:\\n        \\\"200\\\":\\n          $ref: \\\"#/components/responses/RecordResult\\\"\\n        \\\"400\\\":\\n          $ref: \\\"#/components/responses/BadRequest\\\"\\n        \\\"401\\\":\\n          $ref: \\\"#/components/responses/Unauthorized\\\"\\n        \\\"403\\\":\\n          $ref: \\\"#/components/responses/Forbidden\\\"\\n        \\\"404\\\":\\n          $ref: \\\"#/components/responses/NotFound\\\"\\n        \\\"409\\\":\\n          $ref: \\\"#/components/responses/Conflict\\\"\"\n    }\n   ],\n   \"ears\": \"The Meridian API shall implement customer and staff authentication and authorization only through the locked contract, store customer passwords using a standard salted password-hashing algorithm rather than as plaintext, authorize callers only using the roles and scopes stated in the contract without a separate role-to-operation permission table, match staff token email claims to enabled account emails, deny access for unmatched or disabled accounts, and add no lockout or one-time-code policies beyond the contract.\",\n   \"id\": \"REQ-27\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-1\",\n    \"Q-1\",\n    \"Q-10\",\n    \"Q-11\",\n    \"Q-12\",\n    \"Q-13\"\n   ],\n   \"stability\": 0.3333333333333333\n  },\n  {\n   \"acceptance\": [\n    {\n     \"given\": \"A newly deployed PostgreSQL database has no account row and the deployment has the initial account details.\",\n     \"id\": \"AC-28.1\",\n     \"level\": \"job\",\n     \"then\": \"The PostgreSQL account row list contains the provisioned initial account.\",\n     \"when\": \"The deployment provisions the initial account.\"\n    }\n   ],\n   \"ears\": \"The Meridian deployment shall provision the initial PostgreSQL account outside the API rather than through an API bootstrap flow.\",\n   \"id\": \"REQ-28\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"Q-7\"\n   ],\n   \"stability\": 0.3333333333333333\n  }\n ],\n \"roundTrip\": {\n  \"droppedSpans\": [],\n  \"inventedCapabilities\": [\n   \"Expose the contracted API under `/api` while preserving the existing root health response, OpenAPI document, and Swagger UI.\",\n   \"Provide contracted staff authorization-URL lookup, customer email-and-password sign-in with one-time-code verification and resend, and password-reset request, token-inspection, and completion flows; deliver codes and reset links by email; and enforce configured verification and resend attempt limits.\"\n  ]\n },\n \"settled\": [\n  {\n   \"decision\": \"Should all 18 requirements be approved for this run, or should part of the scope be cut to fit? → Approve all 18 requirements as one run.\",\n   \"how\": \"answered\",\n   \"kind\": \"lint\",\n   \"problem\": \"L9 size: This spec has 18 requirements, about 3 runs' worth of work for a feature; approve it as one run or reject with which part to cut.\",\n   \"ref\": \"m1 Q-9\"\n  },\n  {\n   \"decision\": \"How should the authenticated logger-gateway operation handle missing or invalid credentials, unknown devices, and malformed batches? → Return an authentication error for missing or invalid credentials; reject the entire batch without storing readings if it contains an unknown device or malformed data.\",\n   \"how\": \"answered\",\n   \"kind\": \"critic\",\n   \"problem\": \"AC-12.8 only covers a gateway batch sent with valid configured credentials for known devices; there is no AC for invalid or missing gateway credentials, unknown devices, or malformed batches.\",\n   \"ref\": \"m1 Q-10\"\n  },\n  {\n   \"decision\": \"Still open after 2 rounds of questions: carried as a risk\",\n   \"how\": \"open-risk\",\n   \"kind\": \"critic\",\n   \"problem\": \"REQ-5 checks staff identities against a 'Meridian Microsoft identity provider', but the accepted ASM-1 says email and password with no social or single sign-on; the spec's own assumption limits ASM-1 to customers, and no answer authorises that.\"\n  },\n  {\n   \"decision\": \"Still open after 2 rounds of questions: carried as a risk\",\n   \"how\": \"open-risk\",\n   \"kind\": \"invented\",\n   \"problem\": \"Expose the contracted API under `/api` while preserving the existing root health response, OpenAPI document, and Swagger UI.\"\n  },\n  {\n   \"decision\": \"Still open after 2 rounds of questions: carried as a risk\",\n   \"how\": \"open-risk\",\n   \"kind\": \"invented\",\n   \"problem\": \"Provide contracted staff authorization-URL lookup, customer email-and-password sign-in with one-time-code verification and resend, and password-reset request, token-inspection, and completion flows; deliver codes and reset links by email; and enforce configured verification and resend attempt limits.\"\n  },\n  {\n   \"decision\": \"How should schema changes be applied to databases that already exist when the new persistent tables are introduced? → Apply a reviewed database migration during deployment, preserving existing data; use EnsureCreated only for genuinely empty databases.\",\n   \"how\": \"answered\",\n   \"kind\": \"critic\",\n   \"problem\": \"The spec adds persistent entities but keeps startup on `EnsureCreated` (C-5), which does nothing once tables exist, and it has no migration or schema-evolution plan for existing databases despite the 'migration' risk tag.\",\n   \"ref\": \"m2 Q-6\"\n  },\n  {\n   \"decision\": \"With demo seeding disabled, how should the first PostgreSQL account be made available so the API can authorize callers? → Have deployment provision the initial account outside the API; do not add an API bootstrap flow.\",\n   \"how\": \"answered\",\n   \"kind\": \"critic\",\n   \"problem\": \"With Seed:Demo off and an empty database, no account exists, yet REQ-9 authorizes every caller from a PostgreSQL account record; the spec has no way to bootstrap the first account, and AC-5.1 assumes 'an account row provisioned by deployment' with no anchor for that process.\",\n   \"ref\": \"m2 Q-7\"\n  },\n  {\n   \"decision\": \"Which staff identity provider and concrete authorization-URL and token-validation settings should the API use? → Identify the organization's existing staff provider and supply its authorization URL and validation settings; do not introduce a new provider.\",\n   \"how\": \"answered\",\n   \"kind\": \"critic\",\n   \"problem\": \"REQ-7 has no anchors and refers to 'the existing staff identity provider', but current-behaviour shows no identity-provider integration or configuration anywhere in the codebase.\",\n   \"ref\": \"m2 Q-8\"\n  },\n  {\n   \"decision\": \"How should the test and factory runs obtain the valid nonproduction identity-provider settings required for startup? → Provide valid nonproduction settings for the chosen provider through test and factory configuration.\",\n   \"how\": \"answered\",\n   \"kind\": \"critic\",\n   \"problem\": \"Making startup fail on missing IdP settings will break the existing HealthTests.ApiIsUp and the factory runs, which supply no such settings today; REQ-7/REQ-8 claim these checks 'use valid nonproduction settings' without anchors and quietly require changing test and factory configuration.\",\n   \"ref\": \"m2 Q-9\"\n  },\n  {\n   \"decision\": \"How much customer-authentication behavior beyond the locked contract should be specified for failed logins and password storage? → Keep behavior limited to the locked contract; use standard secure password hashing for stored passwords, and do not add new lockout or one-time-code policies.\",\n   \"how\": \"answered\",\n   \"kind\": \"critic\",\n   \"problem\": \"REQ-9 has no error paths for customer authentication: wrong password, unknown email, wrong, expired or reused one-time code, and locked accounts are all missing; it also doesn't say how passwords are stored, despite the auth and pii risk tags.\",\n   \"ref\": \"m2 Q-10\"\n  },\n  {\n   \"decision\": \"Which token claim should identify the PostgreSQL staff account, and what should happen if a valid token has no matching or has a disabled account? → Match the token's email claim to the account email, and deny access when no matching enabled account exists.\",\n   \"how\": \"answered\",\n   \"kind\": \"critic\",\n   \"problem\": \"REQ-9 doesn't say how a staff IdP token maps to a PostgreSQL account record (which claim is matched), or what happens when a token is valid but has no account record, or a disabled one.\",\n   \"ref\": \"m2 Q-11\"\n  },\n  {\n   \"decision\": \"For a stock collection request whose filter names a warehouse outside the caller’s scope, what should the API return? → Return 200 OK with an empty list, applying the caller’s scope to the results.\",\n   \"how\": \"answered\",\n   \"kind\": \"critic\",\n   \"problem\": \"AC-9.1 says a stock request filtered to an out-of-scope warehouse returns 403, but AC-1.2 says scoped collection calls return a list limited to the caller's scope and the supplied filters, which implies 200 with an empty or filtered list.\",\n   \"ref\": \"m2 Q-12\"\n  },\n  {\n   \"decision\": \"Should authorization include a separate role-to-operation permission table beyond the roles and scopes stated in the locked contract? → Do not add a separate role-to-operation table; enforce only the role and scope restrictions stated by the locked contract.\",\n   \"how\": \"answered\",\n   \"kind\": \"critic\",\n   \"problem\": \"REQ-9 says callers are authorized by 'PostgreSQL account roles and scopes', but no role-to-operation permission table is given or anchored in the contract (AC-9.1 just says 'the role permitted for stock listing'), so the 403 behaviour of most operations is undefined.\",\n   \"ref\": \"m2 Q-13\"\n  },\n  {\n   \"decision\": \"How should startup determine whether a database qualifies for EnsureCreated, given that existing databases must use the reviewed deployment migration? → Use EnsureCreated only when the database has no tables; otherwise leave schema changes to the reviewed deployment migration.\",\n   \"how\": \"answered\",\n   \"kind\": \"critic\",\n   \"problem\": \"REQ-2 uses EnsureCreated for empty databases and reviewed migrations for existing ones, but EnsureCreated writes no migrations-history table, so a database it creates cannot later take a migration; the spec also never defines 'genuinely empty' or how startup detects it, even though Program.cs currently calls EnsureCreated every time.\",\n   \"ref\": \"m2 Q-14\"\n  },\n  {\n   \"decision\": \"Still open after 2 rounds of questions: carried as a risk\",\n   \"how\": \"open-risk\",\n   \"kind\": \"critic\",\n   \"problem\": \"REQ-2/AC-2.5 has EnsureCreated build the schema on a database with no tables, but EnsureCreated writes no EF migrations history, so a later 'reviewed deployment migration' (AC-2.4) on that same database will try to recreate tables that already exist, and the spec never says how the two schema paths are reconciled.\"\n  },\n  {\n   \"decision\": \"Still open after 2 rounds of questions: carried as a risk\",\n   \"how\": \"open-risk\",\n   \"kind\": \"critic\",\n   \"problem\": \"REQ-9 says to authorize 'only using the roles and scopes stated in the contract' and to add no permission table, but the anchored operations (for example createAccount and listReceipts) name no allowed roles, so the 403 path is undefined for most operations.\"\n  }\n ]\n}\n</artifact>\n\n<artifact id=\"cb\" kind=\"current-behaviour\" sha=\"\">\n{\n \"claims\": [\n  {\n   \"anchors\": [\n    {\n     \"lineEnd\": 3,\n     \"lineStart\": 1,\n     \"path\": \"App.Api/App.Api.csproj\",\n     \"quote\": \"<Project Sdk=\\\"Microsoft.NET.Sdk.Web\\\">\\n  <PropertyGroup>\\n    <TargetFramework>net9.0</TargetFramework>\",\n     \"symbol\": \"App.Api project\"\n    },\n    {\n     \"lineEnd\": 5,\n     \"lineStart\": 4,\n     \"path\": \"App.Api/Program.cs\",\n     \"quote\": \"var builder = WebApplication.CreateBuilder(args);\\nbuilder.Services.AddOpenApi();\",\n     \"symbol\": \"Program startup\"\n    },\n    {\n     \"lineEnd\": 31,\n     \"lineStart\": 27,\n     \"path\": \"App.Api/Program.cs\",\n     \"quote\": \"app.UseCors();\\napp.MapGet(\\\"/\\\", () => \\\"API is up\\\").ExcludeFromDescription();\\n// The API's own document (/openapi/v1.json) and a page to read and try it (/swagger). Keep both: the factory's product page links to the page.\\napp.MapOpenApi();\\napp.UseSwaggerUI(o => o.SwaggerEndpoint(\\\"/openapi/v1.json\\\", \\\"API\\\"));\",\n     \"symbol\": \"Program\"\n    }\n   ],\n   \"id\": \"C-1\",\n   \"spans\": [\n    \"I-1\"\n   ],\n   \"text\": \"The existing API is an ASP.NET Core .NET 9 project. Its startup registers OpenAPI and currently exposes a root health response plus OpenAPI and Swagger UI; this is an API shell rather than an implementation of the portal operations.\"\n  },\n  {\n   \"anchors\": [\n    {\n     \"lineEnd\": 12,\n     \"lineStart\": 1,\n     \"path\": \"contracts/openapi.yaml\",\n     \"quote\": \"openapi: 3.0.3\\ninfo:\\n  title: Meridian Cold Chain API\\n  version: 1.0.0\\n  description: \\\"Shared contract for the Meridian responsive web portal.\\\"\\nservers:\\n  - url: /api\\npaths:\\n  /auth/staff/authorization-url:\\n    get:\\n      operationId: getStaffAuthorizationUrl\\n      summary: \\\"Get the configured staff identity-provider authorization URL.\\\"\",\n     \"symbol\": \"OpenAPI paths\"\n    },\n    {\n     \"lineEnd\": 164,\n     \"lineStart\": 144,\n     \"path\": \"contracts/openapi.yaml\",\n     \"quote\": \"  /warehouse/receipts:\\n    get:\\n      operationId: listReceipts\\n      summary: \\\"List warehouse-scoped receipts using supplied filters.\\\"\\n      parameters:\\n        - $ref: \\\"#/components/parameters/Search\\\"\\n        - $ref: \\\"#/components/parameters/Status\\\"\\n        - $ref: \\\"#/components/parameters/DateFrom\\\"\\n        - $ref: \\\"#/components/parameters/DateTo\\\"\\n      responses:\\n        \\\"200\\\":\\n          $ref: \\\"#/components/responses/Collection\\\"\\n        \\\"401\\\":\\n          $ref: \\\"#/components/responses/Unauthorized\\\"\\n        \\\"403\\\":\\n          $ref: \\\"#/components/responses/Forbidden\\\"\\n        \\\"500\\\":\\n          $ref: \\\"#/components/responses/ServerError\\\"\\n    post:\\n      operationId: createReceipt\\n      summary: \\\"Record and quarantine an inbound receipt.\\\"\",\n     \"symbol\": \"listReceipts / createReceipt\"\n    },\n    {\n     \"lineEnd\": 31,\n     \"lineStart\": 28,\n     \"path\": \"App.Api/Program.cs\",\n     \"quote\": \"app.MapGet(\\\"/\\\", () => \\\"API is up\\\").ExcludeFromDescription();\\n// The API's own document (/openapi/v1.json) and a page to read and try it (/swagger). Keep both: the factory's product page links to the page.\\napp.MapOpenApi();\\napp.UseSwaggerUI(o => o.SwaggerEndpoint(\\\"/openapi/v1.json\\\", \\\"API\\\"));\",\n     \"symbol\": \"Program\"\n    }\n   ],\n   \"id\": \"C-2\",\n   \"spans\": [\n    \"I-2\"\n   ],\n   \"text\": \"The locked contract is present as OpenAPI 3.0.3, rooted at `/api`, and specifies operations such as staff authorization and receipt listing/creation. The application does not map those contract operations: its only business route mapping is `GET /`, which is excluded from the generated description; it serves its own generated OpenAPI document and Swagger UI instead.\"\n  },\n  {\n   \"anchors\": [\n    {\n     \"lineEnd\": 7,\n     \"lineStart\": 5,\n     \"path\": \"App.Api/AppDb.cs\",\n     \"quote\": \"public class AppDb(DbContextOptions<AppDb> options) : DbContext(options)\\n{\\n}\",\n     \"symbol\": \"AppDb\"\n    },\n    {\n     \"lineEnd\": 24,\n     \"lineStart\": 20,\n     \"path\": \"App.Api/Program.cs\",\n     \"quote\": \"        using var scope = app.Services.CreateScope();\\n        var db = scope.ServiceProvider.GetRequiredService<AppDb>();\\n        db.Database.EnsureCreated();\\n        // sample rows, only when asked for (Seed__Demo=true): tests and the factory's own checks start on an empty database\\n        if (app.Configuration.GetValue<bool>(\\\"Seed:Demo\\\")) SeedData.Run(db);\",\n     \"symbol\": \"Program\"\n    },\n    {\n     \"lineEnd\": 28,\n     \"lineStart\": 28,\n     \"path\": \"App.Api/Program.cs\",\n     \"quote\": \"app.MapGet(\\\"/\\\", () => \\\"API is up\\\").ExcludeFromDescription();\",\n     \"symbol\": \"Program\"\n    }\n   ],\n   \"id\": \"C-3\",\n   \"spans\": [\n    \"I-3\"\n   ],\n   \"text\": \"There is no implemented data model behind the contract operations: `AppDb` is 