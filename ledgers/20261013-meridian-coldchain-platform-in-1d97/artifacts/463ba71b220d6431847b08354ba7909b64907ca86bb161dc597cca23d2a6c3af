          - actionType\n              - occurredAt\n              - payload\n            properties:\n              actionId:\n                type: string\n              actionType:\n                type: string\n                enum:\n                  - loading\n                  - handover\n                  - refusal\n              occurredAt:\n                type: string\n                format: date-time\n              payload:\n                type: object\n    HandoverInput:\n      type: object\n      required:\n        - handoverId\n        - routeId\n        - stopId\n        - receiverName\n        - acknowledged\n        - signature\n        - photo\n        - completedAt\n        - locationAvailable\n        - boxes\n      properties:\n        handoverId:\n          type: string\n        routeId:\n          type: integer\n        stopId:\n          type: integer\n        receiverName:\n          type: string\n        acknowledged:\n          type: boolean\n        signature:\n          type: string\n        photo:\n          type: string\n          format: byte\n        completedAt:\n          type: string\n          format: date-time\n        locationAvailable:\n          type: boolean\n        latitude:\n          type: decimal\n        longitude:\n          type: decimal\n        boxes:\n          type: array\n          items:\n            type: object\n            required:\n              - boxId\n              - deliveredQuantity\n              - refused\n            properties:\n              boxId:\n                type: integer\n              deliveredQuantity:\n                type: integer\n              refused:\n                type: boolean\n              refusalReason:\n                type: string\n    DispositionInput:\n      type: object\n      required:\n        - disposition\n        - reason\n        - identityConfirmation\n      properties:\n        disposition:\n          type: string\n        reason:\n          type: string\n        justification:\n          type: string\n        identityConfirmation:\n          type: string\n    ApprovalInput:\n      type: object\n      required:\n        - decision\n        - identityConfirmation\n        - reason\n      properties:\n        decision:\n          type: string\n          enum:\n            - approve\n            - return\n        identityConfirmation:\n          type: string\n        reason:\n          type: string\n    DestructionInput:\n      type: object\n      required:\n        - destructionDate\n        - quantity\n        - witness\n      properties:\n        destructionDate:\n          type: string\n          format: date\n        quantity:\n          type: integer\n        witness:\n          type: string\n    RecallStartInput:\n      type: object\n      required:\n        - productId\n        - lotIds\n        - reason\n        - severity\n        - identityConfirmation\n      properties:\n        productId:\n          type: integer\n        lotIds:\n          type: array\n          items:\n            type: integer\n        reason:\n          type: string\n        severity:\n          type: string\n        identityConfirmation:\n          type: string\n    SignedAction:\n      type: object\n      required:\n        - identityConfirmation\n        - reason\n      properties:\n        identityConfirmation:\n          type: string\n        reason:\n          type: string\n    WriteOffInput:\n      type: object\n      required:\n        - quantity\n        - category\n        - justification\n        - identityConfirmation\n      properties:\n        quantity:\n          type: integer\n        category:\n          type: string\n        justification:\n          type: string\n        identityConfirmation:\n          type: string\n    OrderInput:\n      type: object\n      required:\n        - lines\n        - addressId\n        - requestedDeliveryDate\n        - fulfillmentPreference\n      properties:\n        lines:\n          type: array\n          items:\n            type: object\n            required:\n              - productId\n              - quantity\n            properties:\n              productId:\n                type: integer\n              quantity:\n                type: integer\n        addressId:\n          type: integer\n        requestedDeliveryDate:\n          type: string\n          format: date\n        fulfillmentPreference:\n          type: string\n          enum:\n            - partial\n            - complete\n    RecallResponseInput:\n      type: object\n      required:\n        - onHandQuantity\n        - usedQuantity\n        - destroyedQuantity\n        - statedDisposition\n      properties:\n        onHandQuantity:\n          type: integer\n        usedQuantity:\n          type: integer\n        destroyedQuantity:\n          type: integer\n        statedDisposition:\n          type: string\n    AccountPreference:\n      type: object\n      required:\n        - language\n      properties:\n        language:\n          type: string\n          enum:\n            - en\n            - ar\n    AddressInput:\n      type: object\n      required:\n        - facilityName\n        - streetAddress\n        - locality\n        - receivingContact\n      properties:\n        facilityName:\n          type: string\n        streetAddress:\n          type: string\n        locality:\n          type: string\n        receivingContact:\n          type: string\n    InvitationInput:\n      type: object\n      required:\n        - email\n        - role\n      properties:\n        email:\n          type: string\n          format: email\n        role:\n          type: string\n    ProductInput:\n      type: object\n      required:\n        - name\n        - packSpecification\n        - profileId\n        - defaultLocation\n      properties:\n        name:\n          type: string\n        packSpecification:\n          type: string\n        profileId:\n          type: integer\n        defaultLocation:\n          type: string\n        handlingNotes:\n          type: string\n    ProfileInput:\n      type: object\n      required:\n        - effectiveDate\n        - label\n        - lowerLimit\n        - upperLimit\n        - tiers\n        - reason\n      properties:\n        effectiveDate:\n          type: string\n          format: date\n        label:\n          type: string\n        lowerLimit:\n          type: decimal\n        upperLimit:\n          type: decimal\n        tiers:\n          type: array\n          items:\n            type: object\n            required:\n              - sequence\n              - lowerBoundary\n              - upperBoundary\n              - allowance\n              - designation\n            properties:\n              sequence:\n                type: integer\n              lowerBoundary:\n                type: decimal\n              upperBoundary:\n                type: decimal\n              allowance:\n                type: decimal\n              designation:\n                type: string\n        reason:\n          type: string\n    ShelfLifeInput:\n      type: object\n      required:\n        - minimumRemainingDays\n      properties:\n        minimumRemainingDays:\n          type: integer\n    AccountInput:\n      type: object\n      required:\n        - fullName\n        - email\n        - roles\n      properties:\n        fullName:\n          type: string\n        email:\n          type: string\n          format: email\n        roles:\n          type: array\n          items:\n            type: string\n            enum:\n              - Driver\n              - Dispatcher\n              - Quality Officer\n              - Quality Manager\n              - Auditor\n              - System Administrator\n              - Customer Administrator\n              - Customer\n        warehouseIds:\n          type: array\n          items:\n            type: integer\n        organizationIds:\n          type: array\n          items:\n            type: integer\n  responses:\n    Collection:\n      description: \"Filtered records returned for the authenticated caller.\"\n      content:\n        application/json:\n          schema:\n            $ref: \"#/components/schemas/CollectionEnvelope\"\n          example:\n            items:\n              - id: 3101\n                name: \"Cedar Clinic receipt\"\n                status: \"Quarantined\"\n                productName: \"Vaccine Pack\"\n                lotNumber: \"LOT-2026-041\"\n                expiryDate: \"2027-06-30\"\n                quantity: 24\n                warehouse: \"Central Warehouse\"\n                location: \"Cold Room C2 / Shelf A3\"\n                receivedAt: \"2026-10-12T09:15:00Z\"\n                updatedAt: \"2026-10-12T09:20:00Z\"\n    RecordResult:\n      description: \"The requested record and returned status fields.\"\n      content:\n        application/json:\n          schema:\n            $ref: \"#/components/schemas/RecordEnvelope\"\n          example:\n            record:\n              id: 3101\n              name: \"Cedar Clinic delivery\"\n              status: \"In transit\"\n              productName: \"Vaccine Pack\"\n              lotNumber: \"LOT-2026-041\"\n              expiryDate: \"2027-06-30\"\n              quantity: 24\n              warehouse: \"Central Warehouse\"\n              location: \"Cold Room C2 / Shelf A3\"\n              receivedAt: \"2026-10-12T09:15:00Z\"\n              updatedAt: \"2026-10-12T10:20:00Z\"\n              actor: \"Leila Haddad\"\n              recipientName: \"Cedar Clinic\"\n              message: \"Temperature within permitted range\"\n    ActionResult:\n      description: \"The action result returned by the service.\"\n      content:\n        application/json:\n          schema:\n            $ref: \"#/components/schemas/ActionEnvelope\"\n          example:\n            id: 3101\n            status: \"Accepted\"\n            message: \"The request was recorded\"\n    AuthResult:\n      description: \"Authentication challenge or configured staff authorization result.\"\n      content:\n        application/json:\n          schema:\n            $ref: \"#/components/schemas/ActionEnvelope\"\n          example:\n            id: 3101\n            status: \"Challenge sent\"\n            message: \"Enter the one-time code sent to the account\"\n    BadRequest:\n      description: \"The request is invalid.\"\n      content:\n        application/json:\n          schema:\n            $ref: \"#/components/schemas/Problem\"\n          example:\n            code: \"validation_error\"\n            message: \"Check the highlighted fields and try again\"\n    Unauthorized:\n      description: \"Authentication is required or has expired.\"\n      content:\n        application/json:\n          schema:\n            $ref: \"#/components/schemas/Problem\"\n          example:\n            code: \"unauthorized\"\n            message: \"Sign in to continue\"\n    Forbidden:\n      description: \"The authenticated caller is not permitted to access this record or action.\"\n      content:\n        application/json:\n          schema:\n            $ref: \"#/components/schemas/Problem\"\n          example:\n            code: \"access_denied\"\n            message: \"You do not have access to this record\"\n    NotFound:\n      description: \"The requested record was not found or is not visible to this caller.\"\n      content:\n        application/json:\n          schema:\n            $ref: \"#/components/schemas/Problem\"\n          example:\n            code: \"not_found\"\n            message: \"The requested record could not be found\"\n    Conflict:\n      description: \"The action conflicts with current record state.\"\n      content:\n        application/json:\n          schema:\n            $ref: \"#/components/schemas/Problem\"\n          example:\n            code: \"state_conflict\"\n            message: \"The action cannot be completed in the current state\"\n    ServerError:\n      description: \"The service could not complete the request.\"\n      content:\n        application/json:\n          schema:\n            $ref: \"#/components/schemas/Problem\"\n          example:\n            code: \"server_error\"\n            message: \"The service could not complete the request\"\n\n\nDATA MODEL. Give \"dataModel\": the tables this plan sets up or changes, as the database will hold them. A person approves it as a diagram with the plan, the factory keeps it in contracts/data-model.yaml, and after every build the database the code creates is compared with it: a missing table, a different key or a different relation fails the task.\n- Each table: name, purpose (one line), and every column with its type (string, text, int, long, decimal, bool, date, datetime, time, uuid, json, enum), required (false when it may be empty), pk on the primary-key column(s), unique where no two rows may share the value, values for an enum.\n- A relation is a foreign key: \"references\" on the column that holds it, naming the table and column it points at (a primary key or a unique column of the same type), and onDelete where it matters. A many-to-many relation is its own table with a foreign key to each side. A key over several columns together goes in the table's \"uniques\".\n- Every table has a primary key. Use the names the code will use for the tables and columns.\n- Model what is stored, not what the API returns: a field worked out on each request has no column.\n- No task writes contracts/data-model.yaml: it is the factory's file. Put the entities, the database setup and any migration in the fileScope of the first task that uses each table.\n\nRepository map:\nApp.Api/AppDb.cs\n  class AppDb\nApp.Api/Program.cs\n  class Program\nApp.Api/SeedData.cs\n  class SeedData\n    void Run(AppDb db)\nApp.Tests/HealthTests.cs\n  class HealthTests\n    Task ApiIsUp()","tools":["read_file","search","repo_map"],"user":"<artifact id=\"spec\" kind=\"spec\" sha=\"\">\n{\n \"assumptions\": [\n  \"ASM-1's email-and-password, one-time-code, and password-reset-link assumption applies only to customer accounts; its exclusion of social sign-in and alternate single sign-on applies only to customers. Staff sign-in remains separate and uses the Meridian Microsoft identity provider required for staff.\",\n  \"Deployment supplies database connection, email sender, Meridian Microsoft identity-provider configuration, and the initial System Administrator identity, warehouse and customer-organisation bootstrap records. No legacy business data is imported. Operational business records are entered through contracted API operations. Explicitly enabling `Seed:Demo` loads deployment-supplied demo rows only for demo/test use.\",\n  \"The configured logger supplier gateway submits telemetry through the locked authenticated contract operation using gateway credentials/configuration supplied for deployment; no additional public HTTP operation or vendor-specific client is added. Email is the only notification channel, using fixed templates; no SMS or push.\",\n  \"Temperature-history and excursion behavior operates on data available through contracted receipt logger uploads, the configured authenticated gateway operation, and persisted contracted records.\",\n  \"Expiry processing is an application-side scheduled check and records dispatcher alerts; test time may be controlled.\",\n  \"Warehouse-specific cut-off times, safety margins, local time zones, working days, and holiday calendars are supplied through deployment-managed warehouse configuration; no configuration API or screen is added.\",\n  \"The existing root health response, generated OpenAPI document, and Swagger UI remain available.\",\n  \"Email and password with an emailed reset link and one-time code are used for customer authentication; no social sign-in or alternate single sign-on is used for customer accounts.\",\n  \"By what channel must the API deliver operational alerts to drivers, dispatchers, and Quality Officers when the requirements say they must be alerted? → assumed: Email only, from fixed templates; no SMS or push.\",\n  \"Use each warehouse's configured local time zone and a calendar maintained in warehouse configuration.\",\n  \"ASM-1: For this specification, “a few” sample rows means between two and five rows per empty contract-backed table.\"\n ],\n \"critic\": [\n  {\n   \"finding\": \"REQ-5 checks staff identities against a 'Meridian Microsoft identity provider', but the accepted ASM-1 says email and password with no social or single sign-on; the spec's own assumption limits ASM-1 to customers, and no answer authorises that.\",\n   \"reqId\": \"REQ-5\",\n   \"rubric\": 1,\n   \"severity\": \"high\"\n  },\n  {\n   \"finding\": \"The spec says staff 'must' use a Microsoft identity provider, but nothing in the intent, answers, assumptions or the quoted contract text names Microsoft; the contract only says 'configured staff identity-provider authorization URL', so the vendor choice has no anchor.\",\n   \"reqId\": \"REQ-5\",\n   \"rubric\": 5,\n   \"severity\": \"medium\"\n  },\n  {\n   \"finding\": \"AC-1.3 requires 404/405 for any path and method not in the contract, but REQ-2/AC-2.1 requires `/`, `/openapi/v1.json` and `/swagger`, none of which are in the contract, to return 200.\",\n   \"reqId\": \"REQ-1\",\n   \"rubric\": 1,\n   \"severity\": \"medium\"\n  },\n  {\n   \"finding\": \"AC-2.1 checks only that the generated `/openapi/v1.json` 'includes' the contracted operations, so it can drift from the locked contract (for example `/api`-prefixed paths versus contract paths relative to `servers: /api`), even though REQ-1 says 'exactly as written'.\",\n   \"reqId\": \"REQ-2\",\n   \"rubric\": 1,\n   \"severity\": \"low\"\n  },\n  {\n   \"finding\": \"REQ-9 and the spec's assumptions say cut-off, working-day and holiday values come from deployment configuration with 'no configuration API or screen', which contradicts the accepted ASM-6 that administrators maintain them in the same app on admin-only screens.\",\n   \"reqId\": \"REQ-9\",\n   \"rubric\": 1,\n   \"severity\": \"medium\"\n  },\n  {\n   \"finding\": \"REQ-7, REQ-8 and REQ-13 are marked op MODIFIED, but current behaviour (C-3) shows an empty AppDb and no receipt, expiry or quality behaviour, so there is nothing to modify and the anchors (an empty context, contract text) don't support it.\",\n   \"reqId\": \"REQ-7\",\n   \"rubric\": 5,\n   \"severity\": \"medium\"\n  },\n  {\n   \"finding\": \"AC-7.6 and REQ-7 lean on 'a condition requiring a two-person quality decision' but never define which receipt conditions send a release into the two-person workflow, so it can't be determined which transition from Quarantined applies.\",\n   \"reqId\": \"REQ-7\",\n   \"rubric\": 6,\n   \"severity\": \"medium\"\n  },\n  {\n   \"finding\": \"AC-7.4 and AC-3.2 cover only valid logger and evidence files; there is no AC for a malformed supplier-format file, an unsupported type, an oversize file, or an upload to a receipt that doesn't exist.\",\n   \"reqId\": \"REQ-7\",\n   \"rubric\": 2,\n   \"severity\": \"medium\"\n  },\n  {\n   \"finding\": \"AC-8.1's precondition is a handling unit that is allocated to an order while possibly Quarantined, but REQ-10 allocates only Released stock, so that state can't occur.\",\n   \"reqId\": \"REQ-8\",\n   \"rubric\": 1,\n   \"severity\": \"low\"\n  },\n  {\n   \"finding\": \"The expiry transition says what happens to Quarantined, On Hold and Released stock but not to stock that is already packed in a sealed box, on a route, Rejected, Destroyed or Delivered when its expiry date passes.\",\n   \"reqId\": \"REQ-8\",\n   \"rubric\": 6,\n   \"severity\": \"medium\"\n  },\n  {\n   \"finding\": \"AC-8.1–8.3 (and AC-12.4, AC-12.5, AC-11.7) are checked through an internal 'email call record' or 'alert row' that no contracted operation exposes, so the outcome isn't observable at a public surface.\",\n   \"reqId\": \"REQ-8\",\n   \"rubric\": 3,\n   \"severity\": \"medium\"\n  },\n  {\n   \"finding\": \"AC-9.1 covers only a repeat with the same idempotency key and same payload; nothing says what happens when the same key is reused with a different payload or by a different organisation.\",\n   \"reqId\": \"REQ-9\",\n   \"rubric\": 2,\n   \"severity\": \"medium\"\n  },\n  {\n   \"finding\": \"AC-9.4's 'response status and order status value reflect the applicable lifecycle rule' names no status code or resulting state for a change or cancellation after Packed, and AC-9.3's 'response record accepts no date earlier than…' names no observable rejection.\",\n   \"reqId\": \"REQ-9\",\n   \"rubric\": 3,\n   \"severity\": \"medium\"\n  },\n  {\n   \"finding\": \"AC-9.1 requires an idempotency key, but no contract anchor shows that the order operation declares an idempotency header or field; adding one would break the rule to implement the contract 'exactly as written'.\",\n   \"reqId\": \"REQ-9\",\n   \"rubric\": 5,\n   \"severity\": \"low\"\n  },\n  {\n   \"finding\": \"Q-2 requires staff-role enforcement, but the only role-denial AC covers the Auditor (AC-5.3); nothing checks that, for example, a Warehouse Operator calling dispatcher route or override operations, or a non-Quality Officer releasing stock, gets 403.\",\n   \"reqId\": \"REQ-5\",\n   \"rubric\": 2,\n   \"severity\": \"medium\"\n  },\n  {\n   \"finding\": \"AC-11.4 checks only that a driver sees their own route; nothing says what a driver gets when requesting, scanning or syncing another driver's route.\",\n   \"reqId\": \"REQ-11\",\n   \"rubric\": 2,\n   \"severity\": \"medium\"\n  },\n  {\n   \"finding\": \"AC-11.7 covers route changes only before the driver has left for the affected stop; it gives no rejection outcome for changes after departure, and AC-11.6 gives no error for refused or delivered quantities that exceed the packed quantities or for missing signature or photo evidence.\",\n   \"reqId\": \"REQ-11\",\n   \"rubric\": 2,\n   \"severity\": \"low\"\n  },\n  {\n   \"finding\": \"AC-11.1 puts the 409 failure cases (reused logger, incompatible packing) in 'then' while its given/when describe only a valid box, so the failure condition is never actually set up.\",\n   \"reqId\": \"REQ-11\",\n   \"rubric\": 3,\n   \"severity\": \"low\"\n  },\n  {\n   \"finding\": \"AC-12.4 puts 'affected stock' On Hold on any excursion trigger without saying what happens to stock that is Quarantined, Expired, Rejected, Destroyed or Delivered, or to excursions found in historical receipt logger uploads.\",\n   \"reqId\": \"REQ-12\",\n   \"rubric\": 6,\n   \"severity\": \"medium\"\n  },\n  {\n   \"finding\": \"Operational thresholds are fixed in the ACs (15-minute silence, 25 percent tier allowance, three consecutive in-band readings, and the 30-day release-expiry window in AC-7.3), while comparable values such as safety margins and attempt limits are configuration.\",\n   \"reqId\": \"REQ-12\",\n   \"rubric\": 8,\n   \"severity\": \"low\"\n  },\n  {\n   \"finding\": \"'5,000 devices reporting at once' has no reading rate, latency, error-rate or duration target, so it can't be verified.\",\n   \"reqId\": \"NFR-2\",\n   \"rubric\": 3,\n   \"severity\": \"medium\"\n  },\n  {\n   \"finding\": \"REQ-13 says the two-person approval applies, yet AC-13.2 lets any 'authorized caller' supersede a disposition with a single signed decision, which bypasses that approval.\",\n   \"reqId\": \"REQ-13\",\n   \"rubric\": 1,\n   \"severity\": \"medium\"\n  },\n  {\n   \"finding\": \"REQ-13 makes the latest decision authoritative for extant stock, but AC-13.2 returns 409 whenever a decision 'would change' destroyed or delivered quantity, so a partly destroyed or delivered unit has no defined transition; a supersede back to Released also has no defined back-order effect.\",\n   \"reqId\": \"REQ-13\",\n   \"rubric\": 6,\n   \"severity\": \"medium\"\n  },\n  {\n   \"finding\": \"AC-13.3 gives no error for destroying more than the rejected quantity, destroying non-Rejected stock, or omitting the witness, and AC-13.1 gives no outcome for approval by a non-Quality Manager or a failed identity confirmation.\",\n   \"reqId\": \"REQ-13\",\n   \"rubric\": 2,\n   \"severity\": \"medium\"\n  },\n  {\n   \"finding\": \"AC-14.1 blocks only 'held' recalled stock; it doesn't say what happens to affected stock that is already allocated, packed or out on a route when the recall starts, or which status recalled stock moves to.\",\n   \"reqId\": \"REQ-14\",\n   \"rubric\": 6,\n   \"severity\": \"medium\"\n  },\n  {\n   \"finding\": \"AC-14.2 gives no error when a customer's recall response quantities exceed the delivered quantity, and AC-14.1 gives no denial path for a non-eligible starter.\",\n   \"reqId\": \"REQ-14\",\n   \"rubric\": 2,\n   \"severity\": \"low\"\n  },\n  {\n   \"finding\": \"AC-15.2 and AC-15.3 cover only cross-organisation access; nothing checks that a non-administrator customer user is denied address and team administration, or covers removing oneself or the last Customer Administrator.\",\n   \"reqId\": \"REQ-15\",\n   \"rubric\": 2,\n   \"severity\": \"medium\"\n  },\n  {\n   \"finding\": \"AC-16.2 lets administrators change an organisation's minimum shelf life and deactivate accounts or products (AC-6.1) without saying what happens to existing allocations, open orders, or confirmed routes assigned to a deactivated driver.\",\n   \"reqId\": \"REQ-16\",\n   \"rubric\": 6,\n   \"severity\": \"medium\"\n  },\n  {\n   \"finding\": \"AC-16.2 has no invalid-input or conflict outcomes, such as a negative shelf life, a duplicate account email, or an unknown warehouse assignment, and AC-16.3 says 'permitted date range' but gives no rejection for an unpermitted one.\",\n   \"reqId\": \"REQ-16\",\n   \"rubric\": 2,\n   \"severity\": \"medium\"\n  },\n  {\n   \"finding\": \"AC-17.2 expects 403 for a write to an audit event, but if the contract declares no audit write operation, AC-1.3 requires 404/405 for that path and method.\",\n   \"reqId\": \"REQ-17\",\n   \"rubric\": 1,\n   \"severity\": \"medium\"\n  },\n  {\n   \"finding\": \"'Consequential contracted change or decision' is never listed, so AC-17.1 and AC-17.3 and NFR-3 can't be checked for completeness, and AC-17.2's 'time passes' gives no measurable duration.\",\n   \"reqId\": \"REQ-17\",\n   \"rubric\": 3,\n   \"severity\": \"medium\"\n  },\n  {\n   \"finding\": \"AC-4.1 and AC-4.3 assume email delivery works; nothing covers a failed code or reset-link send, an expired reset token, a reset request for an unknown email (enumeration), or when attempt-limit counters reset.\",\n   \"reqId\": \"REQ-4\",\n   \"rubric\": 2,\n   \"severity\": \"medium\"\n  },\n  {\n   \"finding\": \"Startup relies on EF Core `EnsureCreated` (C-5), which doesn't evolve an existing schema, yet the spec adds the full data model under a 'migration' risk tag without saying how schema changes reach already-created databases.\",\n   \"reqId\": \"REQ-3\",\n   \"rubric\": 6,\n   \"severity\": \"medium\"\n  },\n  {\n   \"finding\": \"AC-3.3 checks for data that is never submitted ('legacy data exists outside the database'), so it passes trivially and verifies nothing.\",\n   \"reqId\": \"REQ-3\",\n   \"rubric\": 3,\n   \"severity\": \"low\"\n  },\n  {\n   \"finding\": \"AC-6.3 adds profile versions with effective dates but doesn't say whether existing handling units' tier budgets and allowances are recalculated or stay on the version they were received under.\",\n   \"reqId\": \"REQ-6\",\n   \"rubric\": 6,\n   \"severity\": \"medium\"\n  },\n  {\n   \"finding\": \"AC-18.2 requires a contract-defined `server_error` code with no contract anchor, and AC-18.1 doesn't define 'invalid' configuration beyond the existing missing-connection-string check (for example an unreachable database at startup).\",\n   \"reqId\": \"REQ-18\",\n   \"rubric\": 5,\n   \"severity\": \"low\"\n  },\n  {\n   \"finding\": \"REQ-2/AC-2.5 has EnsureCreated build the schema on a database with no tables, but EnsureCreated writes no EF migrations history, so a later 'reviewed deployment migration' (AC-2.4) on that same database will try to recreate tables that already exist, and the spec never says how the two schema paths are reconciled.\",\n   \"reqId\": \"REQ-20\",\n   \"rubric\": 6,\n   \"severity\": \"high\"\n  },\n  {\n   \"finding\": \"AC-2.6 starts the new API against an older schema with a migration still pending and only checks that GET / returns 200; it never defines what contract operations return when their tables or columns don't exist yet.\",\n   \"reqId\": \"REQ-20\",\n   \"rubric\": 2,\n   \"severity\": \"medium\"\n  },\n  {\n   \"finding\": \"REQ-9 says to authorize 'only using the roles and scopes stated in the contract' and to add no permission table, but the anchored operations (for example createAccount and listReceipts) name no allowed roles, so the 403 path is undefined for most operations.\",\n   \"reqId\": \"REQ-27\",\n   \"rubric\": 2,\n   \"severity\": \"high\"\n  },\n  {\n   \"finding\": \"AC-9.1 depends on a 'stock collection' operation with a `warehouseId` filter, but it names no operationId and has no anchor; the only anchored collection parameters are Search, Status, DateFrom and DateTo.\",\n   \"reqId\": \"REQ-27\",\n   \"rubric\": 5,\n   \"severity\": \"medium\"\n  },\n  {\n   \"finding\": \"AC-9.4 depends on 'a contract-defined password-setting operation' with no anchor, and the anchored AccountInput schema has no password field, so it is unclear whether such an operation exists.\",\n   \"reqId\": \"REQ-27\",\n   \"rubric\": 5,\n   \"severity\": \"medium\"\n  },\n  {\n   \"finding\": \"AC-9.2 requires 403 for a customer reading another organization's order, while the contract lists both 403 and 404 for getCustomerOrder and nothing in the contract or the answers picks 403; that conflicts with REQ-1's 'exactly as the contract says'.\",\n   \"reqId\": \"REQ-27\",\n   \"rubric\": 1,\n   \"severity\": \"medium\"\n  },\n  {\n   \"finding\": \"The contract's customer sign-in 'begins one-time-code verification', but the spec never says how codes are issued or delivered, or when they expire or fail, and AC-9.2 just assumes 'a valid one-time code available'.\",\n   \"reqId\": \"REQ-27\",\n   \"rubric\": 2,\n   \"severity\": \"medium\"\n  },\n  {\n   \"finding\": \"REQ-9 denies access to 'disabled' accounts, but no requirement says how an account becomes enabled or disabled (AccountInput has no such field), or what happens to tokens already issued to a customer whose account is then disabled.\",\n   \"reqId\": \"REQ-27\",\n   \"rubric\": 6,\n   \"severity\": \"low\"\n  },\n  {\n   \"finding\": \"AC-7.1 claims the authorization URL comes back in a response field `message`, and AC-7.3 refers vaguely to 'the response field'; neither quotes the getStaffAuthorizationUrl response schema.\",\n   \"reqId\": \"REQ-25\",\n   \"rubric\": 5,\n   \"severity\": \"medium\"\n  },\n  {\n   \"finding\": \"REQ-4 cites ASM-1 to fix 'a few' at two to five rows, but the accepted-assumptions list is empty, so the spec adds a constraint the human never agreed to.\",\n   \"reqId\": \"REQ-22\",\n   \"rubric\": 4,\n   \"severity\": \"medium\"\n  },\n  {\n   \"finding\": \"REQ-4 seeds only empty tables yet requires references to resolve to existing rows, so when a parent table already holds real data, seeded child rows would point at non-demo records; AC-4.2 also never checks the references in the tables it does seed.\",\n   \"reqId\": \"REQ-22\",\n   \"rubric\": 6,\n   \"severity\": \"medium\"\n  },\n  {\n   \"finding\": \"AC-4.1's 'the rows are based on contract examples' has no observable pass/fail test, such as matching specific example field values.\",\n   \"reqId\": \"REQ-22\",\n   \"rubric\": 3,\n   \"severity\": \"low\"\n  },\n  {\n   \"finding\": \"AC-3.1 only checks that GET / returns 200 with Seed:Demo true, which tells you nothing about whether SeedData.Run actually ran.\",\n   \"reqId\": \"REQ-21\",\n   \"rubric\": 3,\n   \"severity\": \"medium\"\n  },\n  {\n   \"finding\": \"AC-8.1 and AC-8.2 are near-duplicates, and neither defines what makes an identity-provider setting 'invalid' (malformed URL, unreachable issuer, missing audience), so the failure path can't be tested consistently.\",\n   \"reqId\": \"REQ-26\",\n   \"rubric\": 2,\n   \"severity\": \"low\"\n  },\n  {\n   \"finding\": \"REQ-10 provisions the initial account but never says its roles or scopes, or where its email comes from, so under REQ-9's email matching it isn't clear that the first account can ever authorize admin operations.\",\n   \"reqId\": \"REQ-28\",\n   \"rubric\": 2,\n   \"severity\": \"medium\"\n  },\n  {\n   \"finding\": \"AC-10.1 is a deployment 'job' check that just reads the account table, with no defined mechanism or artifact in this repo, so it can't be observed at the API surface.\",\n   \"reqId\": \"REQ-28\",\n   \"rubric\": 3,\n   \"severity\": \"low\"\n  },\n  {\n   \"finding\": \"AC-1.1 asks for every response case of every operation to be tested, including the 500 ServerError responses, which can't be triggered deliberately, so the AC can't be verified as written.\",\n   \"reqId\": \"REQ-19\",\n   \"rubric\": 3,\n   \"severity\": \"low\"\n  }\n ],\n \"header\": {\n  \"createdAt\": \"2026-10-13T13:06:47.080Z\",\n  \"inputsHash\": \"\",\n  \"kind\": \"spec\",\n  \"producedBy\": {\n   \"stage\": \"specify\"\n  },\n  \"runId\": \"20261013-meridian-coldchain-platform-in-1d97\",\n  \"schemaVersion\": 1\n },\n \"lint\": [\n  {\n   \"check\": \"L1 ids\",\n   \"details\": \"ok\",\n   \"passed\": true\n  },\n  {\n   \"check\": \"L2 req-ac\",\n   \"details\": \"ok\",\n   \"passed\": true\n  },\n  {\n   \"check\": \"L3 ears\",\n   \"details\": \"ok\",\n   \"passed\": true\n  },\n  {\n   \"check\": \"L4 vague\",\n   \"details\": \"ok\",\n   \"passed\": true\n  },\n  {\n   \"check\": \"L5 nfr\",\n   \"details\": \"ok\",\n   \"passed\": true\n  },\n  {\n   \"check\": \"L6 scope\",\n   \"details\": \"ok\",\n   \"passed\": true\n  },\n  {\n   \"check\": \"L8 anchors\",\n   \"details\": \"ok\",\n   \"passed\": true\n  },\n  {\n   \"check\": \"L9 size\",\n   \"details\": \"This spec has 18 requirements, about 3 runs' worth of work for a feature; approve it as one run or reject with which part to cut.\",\n   \"passed\": true\n  },\n  {\n   \"check\": \"L10 trace\",\n   \"details\": \"ok\",\n   \"passed\": true\n  },\n  {\n   \"check\": \"L11 observable\",\n   \"details\": \"ok\",\n   \"passed\": true\n  },\n  {\n   \"check\": \"L12 literals\",\n   \"details\": \"ok\",\n   \"passed\": true\n  }\n ],\n \"nfrs\": [\n  {\n   \"id\": \"NFR-1\",\n   \"metric\": \"No later than 120 seconds after the triggering reading is received by the operation.\",\n   \"text\": \"Excursion alerts are sent through the configured email channel to the driver when applicable, dispatcher, and warehouse Quality Officers after the triggering reading is received through the contracted authenticated logger-gateway operation.\"\n  },\n  {\n   \"id\": \"NFR-2\",\n   \"metric\": \"5,000 devices reporting at once.\",\n   \"text\": \"The contracted authenticated logger-gateway operation and temperature-data processing capability support concurrent readings from logger and cold-room devices.\"\n  },\n  {\n   \"id\": \"NFR-3\",\n   \"metric\": \"100% of audit rows created by consequential-operation tests have non-empty actor and event-time fields; 0 audit rows are automatically expired.\",\n   \"text\": \"Consequential-operation audit events contain an actor and event time and are retained without automatic expiry.\"\n  }\n ],\n \"outOfScope\": [\n  \"Portal, customer-portal, staff web, and mobile-application screens or client-side offline storage; this run implements the API side only.\",\n  \"Uncontracted API operations and broader workflows not exposed by contracts/openapi.yaml.\",\n  \"Legacy spreadsheet or paper-process data migration.\",\n  \"SMS and push notification delivery, social sign-in, alternate single sign-on, and vendor-specific logger clients.\",\n  \"An additional general inbound logger or temperature-ingestion API not present in the locked contract.\",\n  \"Portal screens and web-app implementation (I-5, Q-1).\",\n  \"Product-story behavior that is not defined by the locked OpenAPI contract (Q-1).\"\n ],\n \"requirements\": [\n  {\n   \"acceptance\": [\n    {\n     \"given\": \"Every operation in the locked contract has a valid authorized request and record fixtures.\",\n     \"id\": \"AC-1.1\",\n     \"level\": \"api\",\n     \"then\": \"The response status, media type, and body fields match the operation's declared successful response.\",\n     \"when\": \"A client calls each declared operation using its method, path, parameters, headers, and request media type.\"\n    },\n    {\n     \"given\": \"An operation declares invalid-input, authentication, authorization, not-found, conflict, or server-error responses.\",\n     \"id\": \"AC-1.2\",\n     \"level\": \"api\",\n     \"then\": \"The response status and error body match a response declared for that operation.\",\n     \"when\": \"The corresponding condition is sent through that operation.\"\n    },\n    {\n     \"given\": \"A path and method are absent from the locked contract.\",\n     \"id\": \"AC-1.3\",\n     \"level\": \"api\",\n     \"then\": \"The response status is 404 or 405 and no business record is created.\",\n     \"when\": \"A request is sent to that path and method.\"\n    }\n   ],\n   \"ears\": \"The Meridian API in the existing ASP.NET Core .NET 9 project shall implement every method, path, parameter, header, request and response schema, media type, and status defined in `contracts/openapi.yaml`, without adding uncontracted business operations.\",\n   \"id\": \"REQ-1\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-1\",\n    \"I-2\",\n    \"Q-1\"\n   ],\n   \"stability\": 1\n  },\n  {\n   \"acceptance\": [\n    {\n     \"given\": \"The API is running.\",\n     \"id\": \"AC-2.1\",\n     \"level\": \"api\",\n     \"then\": \"Each response status is 200, the root response value is `API is up`, and the OpenAPI response includes the contracted `/api` operations.\",\n     \"when\": \"A client calls `/`, `/openapi/v1.json`, and `/swagger`.\"\n    }\n   ],\n   \"ears\": \"The Meridian API shall implement the locked contract under the `/api` path prefix, expose no uncontracted business operation, and preserve the existing root health response, OpenAPI document, and Swagger UI.\",\n   \"id\": \"REQ-2\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-1\",\n    \"I-2\",\n    \"Q-1\",\n    \"ASM-7\"\n   ],\n   \"stability\": 0.6666666666666666\n  },\n  {\n   \"acceptance\": [\n    {\n     \"given\": \"A valid contracted create or update request is made against a configured database.\",\n     \"id\": \"AC-3.1\",\n     \"level\": \"api\",\n     \"then\": \"The response status is successful and the returned record fields match the persisted row.\",\n     \"when\": \"The request succeeds, the application restarts, and the resource is fetched through its contracted read operation.\"\n    },\n    {\n     \"given\": \"A contracted upload operation receives a valid evidence or logger file.\",\n     \"id\": \"AC-3.2\",\n     \"level\": \"api\",\n     \"then\": \"The response status is successful and the returned file or record fields match the uploaded content and metadata.\",\n     \"when\": \"The API restarts and the related contracted read or download operation is called.\"\n    },\n    {\n     \"given\": \"Legacy spreadsheet or paper-process data exists outside a new configured database and has not been submitted through contracted operations.\",\n     \"id\": \"AC-3.3\",\n     \"level\": \"api\",\n     \"then\": \"The database contains no imported legacy business row and response lists contain no imported legacy records.\",\n     \"when\": \"The API starts and contracted collections are queried.\"\n    },\n    {\n     \"given\": \"Deployment bootstrap configuration supplies the initial System Administrator identity, warehouse records, and customer-organisation records.\",\n     \"id\": \"AC-3.4\",\n     \"level\": \"api\",\n     \"then\": \"The database contains rows for the configured initial administrator, warehouses, and organisations before contracted operations are served.\",\n     \"when\": \"The API starts against an empty database.\"\n    },\n    {\n     \"given\": \"A deployment supplies demo seed records and `Seed:Demo` is explicitly enabled or disabled.\",\n     \"id\": \"AC-3.5\",\n     \"level\": \"api\",\n     \"then\": \"The database contains the configured demo seed rows only when `Seed:Demo` is enabled, and contains no demo seed rows when it is disabled.\",\n     \"when\": \"The API starts against an empty database.\"\n    }\n   ],\n   \"ears\": \"The Meridian API shall persist records, relationships, state changes, and file artifacts required by contracted operations in the configured shared database, keep successful mutations available after process restart, avoid importing legacy spreadsheet or paper-process business data, and support deployment bootstrap and explicitly enabled demo seed data.\",\n   \"id\": \"REQ-3\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-2\",\n    \"I-3\",\n    \"Q-1\",\n    \"Q-7\",\n    \"ASM-2\"\n   ],\n   \"stability\": 1\n  },\n  {\n   \"acceptance\": [\n    {\n     \"given\": \"An active customer account has valid credentials and configured email delivery.\",\n     \"id\": \"AC-4.1\",\n     \"level\": \"api\",\n     \"then\": \"The response contains a challenge identifier, an email message contains the one-time code, and no authenticated customer result is issued before code verification.\",\n     \"when\": \"The customer submits credentials to the contracted sign-in operation.\"\n    },\n    {\n     \"given\": \"A customer challenge is pending.\",\n     \"id\": \"AC-4.2\",\n     \"level\": \"api\",\n     \"then\": \"Each response status and returned authentication or challenge value reflects the contract-defined outcome, and only a valid unused code produces an authenticated customer result.\",\n     \"when\": \"The customer verifies a valid code, submits an invalid or reused code, or requests a resend.\"\n    },\n    {\n     \"given\": \"A customer account requests a password reset.\",\n     \"id\": \"AC-4.3\",\n     \"level\": \"api\",\n     \"then\": \"The response values identify token usability, the reset link is sent by email, and a consumed or invalid token cannot reset the password again.\",\n     \"when\": \"The account requests, inspects, and completes a reset using the issued token.\"\n    },\n    {\n     \"given\": \"The staff identity-provider authorization URL is configured.\",\n     \"id\": \"AC-4.4\",\n     \"level\": \"api\",\n     \"then\": \"The response status is 200 and the returned value is the configured URL.\",\n     \"when\": \"An unauthenticated client calls the staff authorization-URL operation.\"\n    },\n    {\n     \"given\": \"A customer submits an unknown email address or an incorrect password.\",\n     \"id\": \"AC-4.5\",\n     \"level\": \"api\",\n     \"then\": \"The response status and error body are the same for both cases, and no challenge value or authenticated result is returned.\",\n     \"when\": \"The customer calls the sign-in operation for each case.\"\n    },\n    {\n     \"given\": \"A customer submits an expired or previously used code, attempts sign-in for a deactivated account, or calls the staff authorization-URL operation while its URL is unconfigured.\",\n     \"id\": \"AC-4.6\",\n     \"level\": \"api\",\n     \"then\": \"The response status and error body match a declared failure response, and no authenticated result or unusable authorization URL is returned.\",\n     \"when\": \"The corresponding contracted operation is called.\"\n    },\n    {\n     \"given\": \"A customer has exceeded the deployment-configured verification or resend attempt limit.\",\n     \"id\": \"AC-4.7\",\n     \"level\": \"api\",\n     \"then\": \"The response status is a declared failure status and no authenticated result or additional one-time-code email message is issued.\",\n     \"when\": \"The customer submits another code verification or resend request.\"\n    }\n   ],\n   \"ears\": \"The Meridian API shall provide contracted staff authorization-URL lookup, customer email-and-password sign-in with one-time-code verification and resend, and password-reset request, token-inspection, and completion flows, deliver customer codes and reset links by email, and enforce configured verification and resend attempt limits.\",\n   \"id\": \"REQ-4\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-2\",\n    \"I-3\",\n    \"ASM-1\",\n    \"ASM-9\"\n   ],\n   \"stability\": 1\n  },\n  {\n   \"acceptance\": [\n    {\n     \"given\": \"Customer organisations have separate orders, deliveries, certificates, or recall records.\",\n     \"id\": \"AC-5.1\",\n     \"level\": \"api\",\n     \"then\": \"The response status is 403 or the contract-defined not-found status and contains no other-organisation record.\",\n     \"when\": \"An authenticated user from one organisation lists or requests another organisation's records.\"\n    },\n    {\n     \"given\": \"A staff member is assigned to one warehouse and another warehouse has records.\",\n     \"id\": \"AC-5.2\",\n     \"level\": \"api\",\n     \"then\": \"The response list contains only assigned-warehouse records and an inaccessible-record response contains no record value.\",\n     \"when\": \"The staff member lists or requests warehouse-scoped stock, receipts, orders, routes, or quality records outside the assignment.\"\n    },\n    {\n     \"given\": \"An Auditor is authenticated and a record is available.\",\n     \"id\": \"AC-5.3\",\n     \"level\": \"api\",\n     \"then\": \"The read response contains the record and each prohibited write response status is 403.\",\n     \"when\": \"The Auditor reads the record and attempts a contracted create, update, or delete operation.\"\n    },\n    {\n     \"given\": \"An account has been deactivated or removed.\",\n     \"id\": \"AC-5.4\",\n     \"level\": \"api\",\n     \"then\": \"The response status is 401 or 403 and contains no protected record.\",\n     \"when\": \"That account makes a subsequent authenticated request to a protected contracted operation.\"\n    },\n    {\n     \"given\": \"A Quality Manager or Auditor is authenticated and requests a record in a warehouse outside an ordinary staff member's assignment.\",\n     \"id\": \"AC-5.5\",\n     \"level\": \"api\",\n     \"then\": \"The response status is successful and the returned record belongs to the requested warehouse.\",\n     \"when\": \"The account reads that record.\"\n    },\n    {\n     \"given\": \"A request supplies a valid token issued by the configured Meridian Microsoft identity provider for an active staff account, or supplies an invalid, untrusted, unknown-account, or deactivated-account identity.\",\n     \"id\": \"AC-5.6\",\n     \"level\": \"api\",\n     \"then\": \"The response status and accessible records reflect the matched persisted account's roles and warehouse assignments, and an invalid or inactive identity receives status 401 or 403 with no protected record.\",\n     \"when\": \"The caller invokes a protected contracted staff operation.\"\n    }\n   ],\n   \"ears\": \"The Meridian API shall validate staff identities using the configured Meridian Microsoft identity provider, separately from customer email-and-password authentication, map authenticated staff identities to active persisted accounts, and enforce contracted customer-organisation, staff-role, warehouse-scope, Auditor read-only, and account-status restrictions on every operation.\",\n   \"id\": \"REQ-5\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-2\",\n    \"I-3\",\n    \"Q-2\",\n    \"ASM-1\"\n   ],\n   \"stability\": 1\n  },\n  {\n   \"acceptance\": [\n    {\n     \"given\": \"A System Administrator creates or searches for a product.\",\n     \"id\": \"AC-6.1\",\n     \"level\": \"api\",\n     \"then\": \"The response record contains the submitted product specification and active state, and searches return matching product records.\",\n     \"when\": \"The product is submitted, listed, retrieved, or deactivated through contracted operations.\"\n    },\n    {\n     \"given\": \"A product has no valid temperature profile or a profile has overlapping or discontinuous tier boundaries.\",\n     \"id\": \"AC-6.2\",\n     \"level\": \"api\",\n     \"then\": \"The response status is 400 and the response error identifies the invalid profile or tier values.\",\n     \"when\": \"The product or profile is submitted.\"\n    },\n    {\n     \"given\": \"A valid profile change includes an effective date, label, limits, tiers, and reason.\",\n     \"id\": \"AC-6.3\",\n     \"level\": \"api\",\n     \"then\": \"The response record and profile list contain the new version, reason, effective date, and actor, while the previous version remains returned unchanged.\",\n     \"when\": \"A System Administrator creates the profile version and later lists versions.\"\n    },\n    {\n     \"given\": \"A product has an earlier profile version.\",\n     \"id\": \"AC-6.4\",\n     \"level\": \"api\",\n     \"then\": \"The response status is 409 and the earlier profile record remains unchanged.\",\n     \"when\": \"A caller attempts to alter that earlier version rather than create a new version.\"\n    },\n    {\n     \"given\": \"A product is deactivated.\",\n     \"id\": \"AC-6.5\",\n     \"level\": \"api\",\n     \"then\": \"The response status is 400 or 409 as declared by the operation and the response does not report a successful order.\",\n     \"when\": \"A customer submits an order line for that product.\"\n    }\n   ],\n   \"ears\": \"The Meridian API shall persist searchable products and immutable versioned temperature profiles, require a profile for each product, and validate profile tiers and governance history.\",\n   \"id\": \"REQ-6\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-2\",\n    \"I-3\",\n    \"Q-1\",\n    \"Q-5\"\n   ],\n   \"stability\": 1\n  },\n  {\n   \"acceptance\": [\n    {\n     \"given\": \"A permitted Warehouse Operator submits a valid receipt with product, lot number, expiry date, quantity, supplier, and location.\",\n     \"id\": \"AC-7.1\",\n     \"level\": \"api\",\n     \"then\": \"The response record contains the submitted values and a Quarantined status.\",\n     \"when\": \"The operator creates the receipt and retrieves it.\"\n    },\n    {\n     \"given\": \"A product and lot number already have a receipt.\",\n     \"id\": \"AC-7.2\",\n     \"level\": \"api\",\n     \"then\": \"The response contains a distinct receipt identifier and the stock list reports both quantities without merging receipt records.\",\n     \"when\": \"A second permitted receipt with the same product and lot number is submitted.\"\n    },\n    {\n     \"given\": \"A receipt expiry date is before the current date, or release is attempted when expiry is within 30 days of receipt.\",\n     \"id\": \"AC-7.3\",\n     \"level\": \"api\",\n     \"then\": \"The response status is 400 or 409 as defined by the operation and the receipt or release status value is not changed to Released.\",\n     \"when\": \"The receipt or release action is submitted.\"\n    },\n    {\n     \"given\": \"A valid supplier-format logger file or separate evidence file is available for an existing receipt.\",\n     \"id\": \"AC-7.4\",\n     \"level\": \"api\",\n     \"then\": \"The response contains the receipt record or action result and a subsequent receipt response contains the stored file-related record or processed readings.\",\n     \"when\": \"The file is uploaded through its contracted receipt operation and the receipt is subsequently fetched.\"\n    },\n    {\n     \"given\": \"A handling unit has positive available quantity at a warehouse location.\",\n     \"id\": \"AC-7.5\",\n     \"level\": \"api\",\n     \"then\": \"The response record contains the resulting quantity and location, and a movement record contains actor, time, source, destination, and moved quantity.\",\n     \"when\": \"A permitted move or opening-stock operation is submitted.\"\n    },\n    {\n     \"given\": \"A receipt is quarantined, meets the expiry restrictions, and has no condition requiring a two-person quality decision.\",\n     \"id\": \"AC-7.6\",\n     \"level\": \"api\",\n     \"then\": \"The response record contains the Quality Officer as the decision actor and the stock status is Released; this receipt release does not bypass a separately required two-person decision.\",\n     \"when\": \"An authorized Quality Officer releases the receipt through its contracted workflow.\"\n    }\n   ],\n   \"anchors\": [\n    {\n     \"lineEnd\": 164,\n     \"lineStart\": 144,\n     \"path\": \"contracts/openapi.yaml\",\n     \"quote\": \"  /warehouse/receipts:\\n    get:\\n      operationId: listReceipts\\n      summary: \\\"List warehouse-scoped receipts using supplied filters.\\\"\\n      parameters:\\n        - $ref: \\\"#/components/parameters/Search\\\"\\n        - $ref: \\\"#/components/parameters/Status\\\"\\n        - $ref: \\\"#/components/parameters/DateFrom\\\"\\n        - $ref: \\\"#/components/parameters/DateTo\\\"\\n      responses:\\n        \\\"200\\\":\\n          $ref: \\\"#/components/responses/Collection\\\"\\n        \\\"401\\\":\\n          $ref: \\\"#/components/responses/Unauthorized\\\"\\n        \\\"403\\\":\\n          $ref: \\\"#/components/responses/Forbidden\\\"\\n        \\\"500\\\":\\n          $ref: \\\"#/components/responses/ServerError\\\"\\n    post:\\n      operationId: createReceipt\\n      summary: \\\"Record and quarantine an inbound receipt.\\\"\"\n    }\n   ],\n   \"ears\": \"The Meridian API shall persist separate contracted receipt, receipt-logger, receipt-evidence, stock, movement, and opening-stock records and enforce receipt traceability, quarantine, expiry validation, and Quality Officer release, while allowing a Quality Officer to release an ordinary eligible receipt without the separate two-person approval required for decisions that invoke that workflow.\",\n   \"id\": \"REQ-7\",\n   \"op\": \"MODIFIED\",\n   \"sources\": [\n    \"I-2\",\n    \"I-3\",\n    \"Q-2\",\n    \"Q-3\",\n    \"Q-7\"\n   ],\n   \"stability\": 1\n  },\n  {\n   \"acceptance\": [\n    {\n     \"given\": \"A handling unit is allocated to an order and its expiry date ends in the warehouse's configured local time zone.\",\n     \"id\": \"AC-8.1\",\n     \"level\": \"job\",\n     \"then\": \"The stock row has Expired status even if it was Quarantined or On Hold, its allocation rows are removed, the order row reflects any replacement allocation, and an audit event and dispatcher alert email call record the change.\",\n     \"when\": \"The scheduled expiry check runs at the start of the next local calendar day.\"\n    },\n    {\n     \"given\": \"A released handling unit is allocated to an order and has passed its expiry date in the warehouse's configured local time zone.\",\n     \"id\": \"AC-8.2\",\n     \"level\": \"job\",\n     \"then\": \"The stock row has Expired status, the allocation count for that unit is zero unless eligible replacement stock is allocated, the affected order status and outstanding quantity reflect the replacement outcome, and a dispatcher alert row identifies the expiry notification.\",\n     \"when\": \"The scheduled expiry check runs.\"\n    },\n    {\n     \"given\": \"An order contains an allocation that expires and no suitable replacement stock is available.\",\n     \"id\": \"AC-8.3\",\n     \"level\": \"job\",\n     \"then\": \"A partial order response shows Partly Allocated status and the outstanding quantity, while a complete-only order row has no allocations and Submitted status; the expired stock row has Expired status and a dispatcher alert row records the outcome.\",\n     \"when\": \"The scheduled expiry check runs.\"\n    }\n   ],\n   \"anchors\": [\n    {\n     \"lineEnd\": 7,\n     \"lineStart\": 5,\n     \"path\": \"App.Api/AppDb.cs\",\n     \"quote\": \"public class AppDb(DbContextOptions<AppDb> options) : DbContext(options)\\n{\\n}\"\n    }\n   ],\n   \"ears\": \"When a handling unit reaches the end of its expiry date in its warehouse's configured local time zone, the Meridian API shall mark it Expired even if it is Quarantined or On Hold, remove it from allocations, apply the contracted replacement-allocation and order-status rules, record the change, and alert the dispatcher.\",\n   \"id\": \"REQ-8\",\n   \"op\": \"MODIFIED\",\n   \"sources\": [\n    \"I-2\",\n    \"I-3\",\n    \"Q-3\",\n    \"ASM-5\",\n    \"ASM-10\",\n    \"ASM-11\"\n   ],\n   \"stability\": 1\n  },\n  {\n   \"acceptance\": [\n    {\n     \"given\": \"An authenticated customer submits an order with at least one line, positive pack quantities, an organisation-owned address, and an idempotency key.\",\n     \"id\": \"AC-9.1\",\n     \"level\": \"api\",\n     \"then\": \"Both response bodies return the same order identifier and the order list contains one order.\",\n     \"when\": \"The order is submitted twice with the same key and payload.\"\n    },\n    {\n     \"given\": \"A customer submits an invalid line, another organisation's address, a date earlier than permitted, or a product inactive for ordering.\",\n     \"id\": \"AC-9.2\",\n     \"level\": \"api\",\n     \"then\": \"The response status is 400 or 409 and no order row is created.\",\n     \"when\": \"The customer places the order.\"\n    },\n    {\n     \"given\": \"The serving warehouse has deployment-supplied cut-off, working-day, holiday, and local time-zone configuration.\",\n     \"id\": \"AC-9.3\",\n     \"level\": \"api\",\n     \"then\": \"The response record accepts no date earlier than the next working day before cut-off or the working day after that when submitted after cut-off.\",\n     \"when\": \"A customer requests an order delivery date before or after cut-off.\"\n    },\n    {\n     \"given\": \"An order is not yet Packed or has already reached Packed status.\",\n     \"id\": \"AC-9.4\",\n     \"level\": \"api\",\n     \"then\": \"The response status and order status value reflect the applicable lifecycle rule, and successful cancellation returns the allocated quantity to available stock.\",\n     \"when\": \"The customer attempts to change or cancel it.\"\n    }\n   ],\n   \"ears\": \"The Meridian API shall persist customer orders and dispatch allocations using the serving warehouse's deployment-configured cut-off, working-day, holiday, time-zone, and customer shelf-life rules, and enforce idempotency, order validation, pre-packing customer changes, and cancellation rules.\",\n   \"id\": \"REQ-9\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-2\",\n    \"I-3\",\n    \"Q-2\",\n    \"Q-4\",\n    \"Q-5\",\n    \"ASM-6\",\n    \"ASM-11\"\n   ],\n   \"stability\": 1\n  },\n  {\n   \"acceptance\": [\n    {\n     \"given\": \"Released stock is available for an order from its serving warehouse and has eligible lots.\",\n     \"id\": \"AC-10.1\",\n     \"level\": \"api\",\n     \"then\": \"The response record shows earliest-expiry eligible lots first, applies minimum remaining shelf life, uses greater stability-budget usage first for tied expiry dates, and exposes each allocation and outstanding quantity.\",\n     \"when\": \"The order is allocated.\"\n    },\n    {\n     \"given\": \"Suitable stock is insufficient for a partial order or any line of a complete-only order.\",\n     \"id\": \"AC-10.2\",\n     \"level\": \"api\",\n     \"then\": \"The partial order response shows allocated and outstanding quantities without over-allocating stock, while the complete-only order holds no stock until every line can be fully allocated.\",\n     \"when\": \"Allocation is attempted.\"\n    },\n    {\n     \"given\": \"Multiple orders are submitted concurrently against the same available handling units.\",\n     \"id\": \"AC-10.3\",\n     \"level\": \"api\",\n     \"then\": \"The response records and stock list show no unit allocated to more than one order and total allocated quantity does not exceed physical available quantity.\",\n     \"when\": \"The allocations are committed.\"\n    },\n    {\n     \"given\": \"A dispatcher submits an allocation override with a reason, without a reason, or to stock violating Released status or customer shelf life.\",\n     \"id\": \"AC-10.4\",\n     \"level\": \"api\",\n     \"then\": \"The valid response record includes the reason and changed allocation, while each invalid response status is 400 or 409 and the original allocation remains unchanged.\",\n     \"when\": \"The override operation is called.\"\n    },\n    {\n     \"given\": \"Suitable stock is released for waiting back orders.\",\n     \"id\": \"AC-10.5\",\n     \"level\": \"api\",\n     \"then\": \"The order response records show oldest-first back-order allocation.\",\n     \"when\": \"The allocation service updates affected orders.\"\n    },\n    {\n     \"given\": \"An older back order awaits suitable stock or a complete-only order cannot be fully allocated.\",\n     \"id\": \"AC-10.6\",\n     \"level\": \"api\",\n     \"then\": \"The response record shows eligible back orders filled in submission order and no stock held by the incomplete complete-only order.\",\n     \"when\": \"Suitable stock is released or allocation is attempted.\"\n    }\n   ],\n   \"ears\": \"The Meridian API shall allocate only released, physically available stock meeting customer minimum remaining shelf life, select earliest expiry first with the specified stability-budget tie-break, and apply complete-order, partial-order, back-order, and override rules.\",\n   \"id\": \"REQ-10\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-2\",\n    \"I-3\",\n    \"Q-4\",\n    \"Q-5\"\n   ],\n   \"stability\": 1\n  },\n  {\n   \"acceptance\": [\n    {\n     \"given\": \"A Warehouse Operator submits a pack request for allocated stock.\",\n     \"id\": \"AC-11.1\",\n     \"level\": \"api\",\n     \"then\": \"The response record contains the box, logger, lot quantities, operator, and seal time; a reused logger or incompatible packing response status is 409.\",\n     \"when\": \"The requested box contains one logger, products with the same storage band, and a compatible box type.\"\n    },\n    {\n     \"given\": \"A dispatcher submits a route with date, vehicle, driver, ordered stops, and planned arrival times.\",\n     \"id\": \"AC-11.2\",\n     \"level\": \"api\",\n     \"then\": \"The response record contains the requested route values and a conflicting driver or vehicle assignment returns status 409.\",\n     \"when\": \"The route is created, updated, or confirmed.\"\n    },\n    {\n     \"given\": \"A route's packed box would exceed qualified duration less the configured safety margin at a planned arrival.\",\n     \"id\": \"AC-11.3\",\n     \"level\": \"api\",\n     \"then\": \"The response status is 409 and the response message identifies the box and qualification shortfall or duration overrun.\",\n     \"when\": \"The route confirmation operation is called.\"\n    },\n    {\n     \"given\": \"A driver calls route listing, route detail, scan, departure, or synchronization operations for the authenticated driver's route.\",\n     \"id\": \"AC-11.4\",\n     \"level\": \"api\",\n     \"then\": \"The response list or record contains only that driver's authorized route, ordered stops, expected boxes, scans, and departure state.\",\n     \"when\": \"The driver supplies contracted date, action identifiers, or route data.\"\n    },\n    {\n     \"given\": \"A driver synchronizes queued actions with distinct action identifiers or repeats an action identifier.\",\n     \"id\": \"AC-11.5\",\n     \"level\": \"api\",\n     \"then\": \"The response record contains accepted and conflicting actions, and the resulting route history contains each accepted action only once.\",\n     \"when\": \"The synchronization operation is called.\"\n    },\n    {\n     \"given\": \"A driver submits a handover with receiver, acknowledgement, signature, photo, completion time, and box delivery or refusal quantities.\",\n     \"id\": \"AC-11.6\",\n     \"level\": \"api\",\n     \"then\": \"The response record and delivery-evidence response contain persisted evidence and quantities, and refused quantities retain the refusal reason.\",\n     \"when\": \"The handover operation is called and authorized delivery evidence is subsequently fetched.\"\n    },\n    {\n     \"given\": \"A confirmed route is changed before its driver has left for the affected stop.\",\n     \"id\": \"AC-11.7\",\n     \"level\": \"api\",\n     \"then\": \"The response record contains the changed schedule or stop order and an email call or driver-change event is recorded.\",\n     \"when\": \"A dispatcher updates the route schedule or stop order.\"\n    }\n   ],\n   \"ears\": \"The Meridian API shall persist compatible box packing and route plans, enforce box and route qualification, and record driver loading, departure, synchronization, handover, refusal, and delivery-evidence operations.\",\n   \"id\": \"REQ-11\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-2\",\n    \"I-3\",\n    \"Q-1\",\n    \"Q-2\",\n    \"Q-5\",\n    \"ASM-3\",\n    \"ASM-6\"\n   ],\n   \"stability\": 1\n  },\n  {\n   \"acceptance\": [\n    {\n     \"given\": \"A contracted receipt logger upload contains repeated, late, out-of-order, future-dated, or pre-sealing readings.\",\n     \"id\": \"AC-12.1\",\n     \"level\": \"api\",\n     \"then\": \"The response record places readings at their occurred times, stores a duplicate once, flags future and pre-sealing readings as excluded from calculations, and shows unavailable-reading gaps.\",\n     \"when\": \"The file is processed and temperature history is requested for its entity and date range.\"\n    },\n    {\n     \"given\": \"Three consecutive in-band readings follow an out-of-band reading in persisted history.\",\n     \"id\": \"AC-12.2\",\n     \"level\": \"api\",\n     \"then\": \"The response records show the excursion open from the first out-of-band reading until the third consecutive in-band reading and show time charged to each applicable tier.\",\n     \"when\": \"The related temperature history and handling-unit record are requested.\"\n    },\n    {\n     \"given\": \"A handling unit has excursion history or a late reading changes that history.\",\n     \"id\": \"AC-12.3\",\n     \"level\": \"api\",\n     \"then\": \"The response record shows separate budgets for portions with different histories, updated remaining tier allowances, excursion links, holds, and an audit event for the correction.\",\n     \"when\": \"The handling-unit or temperature-history operation is called after recalculation.\"\n    },\n    {\n     \"given\": \"An excursion begins, a tier allowance falls below 25 percent, a tier is exhausted, or a not-permitted range is reached.\",\n     \"id\": \"AC-12.4\",\n     \"level\": \"job\",\n     \"then\": \"An email call is recorded within 120 seconds for the required driver when on-route, dispatcher, and warehouse Quality Officers, and affected stock response records have On Hold status pending a decision.\",\n     \"when\": \"The triggering reading is received and processed.\"\n    },\n    {\n     \"given\": \"A logger has sent no reading for 15 minutes and its box is out for delivery.\",\n     \"id\": \"AC-12.5\",\n     \"level\": \"job\",\n     \"then\": \"The response record marks the device silent, shows the gap, and an alert email call is recorded.\",\n     \"when\": \"The silent-device check runs and temperature history is requested.\"\n    },\n    {\n     \"given\": \"A cold room or its temperature records are available.\",\n     \"id\": \"AC-12.6\",\n     \"level\": \"api\",\n     \"then\": \"The response list or record contains the latest reading, status, gaps, alerts, history timestamps, and applicable band and excursion markers.\",\n     \"when\": \"A caller lists cold rooms, retrieves a cold room, or requests temperature history for a room, box, lot, handling unit, or device.\"\n    },\n    {\n     \"given\": \"A handling unit has recorded temperature history with an interval containing no readings and a stored profile band.\",\n     \"id\": \"AC-12.7\",\n     \"level\": \"api\",\n     \"then\": \"The response contains readings in recorded-time order, an explicit gap, and temperature-band and excursion fields for the requested interval.\",\n     \"when\": \"The caller fetches temperature history for the unit or its box, lot, device, or cold room.\"\n    },\n    {\n     \"given\": \"The configured authenticated logger gateway has a batch of readings for known devices, including duplicate, late, or out-of-order readings.\",\n     \"id\": \"AC-12.8\",\n     \"level\": \"api\",\n     \"then\": \"The persisted reading rows contain each valid reading once at its occurred time, and contracted temperature-history responses show the same ordered readings and calculated history regardless of batch arrival order.\",\n     \"when\": \"The gateway submits the batch through the locked contract operation using its configured credentials.\"\n    },\n    {\n     \"given\": \"A logger-gateway batch contains readings for a known device, but the request has missing or invalid gateway credentials.\",\n     \"id\": \"AC-12.9\",\n     \"level\": \"api\",\n     \"then\": \"The response status is 401 and a subsequent temperature-history response contains no reading from the batch.\",\n     \"when\": \"The gateway submits the batch through the locked contract operation.\"\n    },\n    {\n     \"given\": \"A logger-gateway batch contains at least one valid reading for a known device and also contains a reading for an unknown device or malformed reading data.\",\n     \"id\": \"AC-12.10\",\n     \"level\": \"api\",\n     \"then\": \"The response status is 400 and subsequent temperature-history responses contain none of the readings from the rejected batch.\",\n     \"when\": \"The gateway submits the batch through the locked contract operation using valid credentials.\"\n    }\n   ],\n   \"ears\": \"The Meridian API shall process readings from contracted receipt logger uploads and from the configured authenticated logger gateway through the locked contract operation, expose temperature histories for contracted entity types, and persist available readings, gaps, excursions, tier-by-tier handling-unit budgets, related holds, and corrected history when readings arrive late or out of order.\",\n   \"id\": \"REQ-12\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-2\",\n    \"I-3\",\n    \"Q-1\",\n    \"Q-3\",\n    \"ASM-4\",\n    \"ASM-8\",\n    \"ASM-10\",\n    \"Q-10\"\n   ],\n   \"stability\": 1\n  },\n  {\n   \"acceptance\": [\n    {\n     \"given\": \"A Quality Officer submits a disposition proposal subject to the two-person approval workflow, with disposition, reason, and identity confirmation.\",\n     \"id\": \"AC-13.1\",\n     \"level\": \"api\",\n     \"then\": \"The response record contains the proposal and actor, the proposing officer cannot approve their own proposal, and a different eligible manager's approval or return is recorded without replacing the proposal; this approval restriction does not apply to an ordinary receipt release under AC-7.6.\",\n     \"when\": \"The proposal is retrieved or a decision is submitted by the proposing officer or an eligible different Quality Manager.\"\n    },\n    {\n     \"given\": \"A quality decision exists for stock that has not been destroyed or delivered, and an authorized caller submits a separately signed superseding decision.\",\n     \"id\": \"AC-13.2\",\n     \"level\": \"api\",\n     \"then\": \"The response record contains the new current decision and the earlier decision remains in the returned decision history; the stock status reflects the superseding disposition, a change away from Released removes remaining allocations and applies the contracted replacement-allocation rules, and a decision that would change the status of destroyed or delivered quantity returns status 409 with the prior decision and stock status unchanged.\",\n     \"when\": \"The supersede operation is called and the decision and affected stock are subsequently retrieved.\"\n    },\n    {\n     \"given\": \"Rejected stock has a positive quantity to destroy.\",\n     \"id\": \"AC-13.3\",\n     \"level\": \"api\",\n     \"then\": \"The response record contains those values and the destroyed quantity is removed from available stock.\",\n     \"when\": \"An authorized caller submits a destruction date, quantity, and witness.\"\n    },\n    {\n     \"given\": \"A handling unit has tiered budget usage and a related quality case.\",\n     \"id\": \"AC-13.4\",\n     \"level\": \"api\",\n     \"then\": \"The response contains the used and remaining value for each tier and linked case telemetry and decision fields.\",\n     \"when\": \"An authorized Quality Officer fetches the unit and quality case.\"\n    }\n   ],\n   \"anchors\": [\n    {\n     \"lineEnd\": 7,\n     \"lineStart\": 5,\n     \"path\": \"App.Api/AppDb.cs\",\n     \"quote\": \"public class AppDb(DbContextOptions<AppDb> options) : DbContext(options)\\n{\\n}\"\n    }\n   ],\n   \"ears\": \"The Meridian API shall persist quality cases, signed proposals and decisions, superseding decisions, and destruction records, apply the required two-person quality approval, make the latest valid signed disposition authoritative for extant stock, and preserve prior decision history without restoring stock already destroyed or delivered.\",\n   \"id\": \"REQ-13\",\n   \"op\": \"MODIFIED\",\n   \"sources\": [\n    \"I-2\",\n    \"I-3\",\n    \"Q-2\",\n    \"Q-3\",\n    \"Q-5\",\n    \"Q-6\"\n   ],\n   \"stability\": 1\n  },\n  {\n   \"acceptance\": [\n    {\n     \"given\": \"An eligible Quality Manager starts a signed recall for selected product lots.\",\n     \"id\": \"AC-14.1\",\n     \"level\": \"api\",\n     \"then\": \"The response records identify affected stock, warehouse locations, boxes, routes, deliveries, customer response progress, and recalled held stock is unavailable for allocation.\",\n     \"when\": \"The recall is started and its record and trace are requested.\"\n    },\n    {\n     \"given\": \"A customer submits or updates a recall response for an authorized delivery.\",\n     \"id\": \"AC-14.2\",\n     \"level\": \"api\",\n     \"then\": \"The response record contains on-hand, used, destroyed, and stated-disposition values and recall progress reflects the submitted quantities.\",\n     \"when\": \"The recall response operation is called.\"\n    },\n    {\n     \"given\": \"A recall has unaccounted quantity or all quantity is accounted for.\",\n     \"id\": \"AC-14.3\",\n     \"level\": \"api\",\n     \"then\": \"The response status is 409 for closure with unaccounted quantity and no valid write-off, or the response record contains the signed closure or write-off when preconditions are met.\",\n     \"when\": \"A Quality Manager submits closure or a signed write-off.\"\n    },\n    {\n     \"given\": \"A started recall has affected warehouse, box, route, and delivery records.\",\n     \"id\": \"AC-14.4\",\n     \"level\": \"api\",\n     \"then\": \"The response lists contain the chronological trace of the lot through warehouse, boxes, routes, deliveries, movements, and destruction records.\",\n     \"when\": \"Recall-trace and lot-history operations are called.\"\n    }\n   ],\n   \"ears\": \"The Meridian API shall persist signed recalls, trace selected lots through affected stock and delivery records, block affected stock still held, and record customer responses and signed closure or write-off decisions until quantities are accounted for.\",\n   \"id\": \"REQ-14\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-2\",\n    \"I-3\",\n    \"Q-1\",\n    \"Q-2\",\n    \"Q-3\",\n    \"Q-5\",\n    \"Q-6\"\n   ],\n   \"stability\": 1\n  },\n  {\n   \"acceptance\": [\n    {\n     \"given\": \"An authenticated customer requests orders, deliveries, delivery details, certificates, certificate files, or recall notices.\",\n     \"id\": \"AC-15.1\",\n     \"level\": \"api\",\n     \"then\": \"The response list, record, or PDF file contains only records belonging to that customer's organisation.\",\n     \"when\": \"The corresponding customer operation is called.\"\n    },\n    {\n     \"given\": \"A Customer Administrator submits a valid saved address or invitation, changes an address, or removes an address or team member within their organisation.\",\n     \"id\": \"AC-15.2\",\n     \"level\": \"api\",\n     \"then\": \"The response record or action result identifies the change and subsequent lists contain the updated organisation-scoped address or team record.\",\n     \"when\": \"The contracted customer-administration operation is called.\"\n    },\n    {\n     \"given\": \"A Customer Administrator attempts to edit or remove an address or member belonging to another organisation.\",\n     \"id\": \"AC-15.3\",\n     \"level\": \"api\",\n     \"then\": \"The response status is 403 or the contract-defined not-found status and no other-organisation row is changed.\",\n     \"when\": \"The contracted customer-administration operation is called.\"\n    },\n    {\n     \"given\": \"An authenticated customer account has a saved language preference.\",\n     \"id\": \"AC-15.4\",\n     \"level\": \"api\",\n     \"then\": \"The response record contains the saved language value and a value outside the contract enum returns status 400.\",\n     \"when\": \"The account is retrieved and patched with `en` or `ar`.\"\n    }\n   ],\n   \"ears\