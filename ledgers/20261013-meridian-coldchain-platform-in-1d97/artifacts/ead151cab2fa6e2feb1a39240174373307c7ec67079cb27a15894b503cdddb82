\"\n    },\n    {\n     \"lineEnd\": 24,\n     \"lineStart\": 20,\n     \"path\": \"App.Api/Program.cs\",\n     \"quote\": \"        using var scope = app.Services.CreateScope();\\n        var db = scope.ServiceProvider.GetRequiredService<AppDb>();\\n        db.Database.EnsureCreated();\\n        // sample rows, only when asked for (Seed__Demo=true): tests and the factory's own checks start on an empty database\\n        if (app.Configuration.GetValue<bool>(\\\"Seed:Demo\\\")) SeedData.Run(db);\",\n     \"symbol\": \"Program\"\n    },\n    {\n     \"lineEnd\": 28,\n     \"lineStart\": 28,\n     \"path\": \"App.Api/Program.cs\",\n     \"quote\": \"app.MapGet(\\\"/\\\", () => \\\"API is up\\\").ExcludeFromDescription();\",\n     \"symbol\": \"Program\"\n    }\n   ],\n   \"id\": \"C-3\",\n   \"spans\": [\n    \"I-3\"\n   ],\n   \"text\": \"There is no implemented data model behind the contract operations: `AppDb` is an empty EF Core context, and the mapped API route is only the root health response. Startup configures PostgreSQL and calls `EnsureCreated`, but the current context declares no entity sets.\"\n  },\n  {\n   \"anchors\": [\n    {\n     \"lineEnd\": 1135,\n     \"lineStart\": 1107,\n     \"path\": \"contracts/openapi.yaml\",\n     \"quote\": \"  /customer/orders/{orderId}:\\n    get:\\n      operationId: getCustomerOrder\\n      summary: \\\"Get an order scoped to the authenticated customer.\\\"\\n      parameters:\\n        - $ref: \\\"#/components/parameters/OrderId\\\"\\n      responses:\\n        \\\"200\\\":\\n          $ref: \\\"#/components/responses/RecordResult\\\"\\n        \\\"401\\\":\\n          $ref: \\\"#/components/responses/Unauthorized\\\"\\n        \\\"403\\\":\\n          $ref: \\\"#/components/responses/Forbidden\\\"\\n        \\\"404\\\":\\n          $ref: \\\"#/components/responses/NotFound\\\"\\n        \\\"500\\\":\\n          $ref: \\\"#/components/responses/ServerError\\\"\\n    patch:\\n      operationId: changeCustomerOrder\\n   