"\n ],\n \"source\": \"cli\",\n \"spans\": [\n  {\n   \"id\": \"I-1\",\n   \"text\": \"A web front end with a small API and a database behind it.\"\n  },\n  {\n   \"id\": \"I-2\",\n   \"text\": \"The app ships with exactly 8 requests.\"\n  },\n  {\n   \"id\": \"I-3\",\n   \"text\": \"Requests are stored in the database and survive a reload and a restart.\"\n  },\n  {\n   \"id\": \"I-4\",\n   \"text\": \"The API needs these four operations and no others: list, create, get by ID, and change status.\"\n  },\n  {\n   \"id\": \"I-5\",\n   \"text\": \"Requests screen with status filters, create dialog, and loading, empty, and error states.\"\n  },\n  {\n   \"id\": \"I-6\",\n   \"text\": \"Request detail screen with status-appropriate action, update failure state, and not-found state.\"\n  },\n  {\n   \"id\": \"I-7\",\n   \"text\": \"Clean light theme, responsive layout, accessible controls, and specified badge colors.\"\n  },\n  {\n   \"id\": \"I-8\",\n   \"text\": \"Automated tests for the business rules and one end-to-end workflow.\"\n  }\n ],\n \"touchesUi\": true\n}\n</artifact>\n\n<artifact id=\"answers\" kind=\"answers\" sha=\"\">\n[\n {\n  \"id\": \"Q-1\",\n  \"question\": \"If the user creates a request while a status filter other than All is selected, how should the list behave after successful creation?\",\n  \"answer\": \"Switch the filter to All so the new Open request appears at the top.\",\n  \"by\": \"Hamza (via web)\"\n },\n {\n  \"id\": \"Q-2\",\n  \"question\": \"Which browsers must the web app support?\",\n  \"answer\": \"No specific browser support target beyond browsers compatible with the chosen implementation.\",\n  \"by\": \"Hamza (via web)\"\n },\n {\n  \"id\": \"Q-3\",\n  \"question\": \"If the create API call fails for a reason other than field validation, what should the dialog show?\",\n  \"answer\": \"Show “Could not create request.” in the dialog, keep the entered values, and allow retry.\",\n  \"by\": \"Hamza (via web)\"\n },\n {\n  \"id\": \"Q-4\",\n  \"question\": \"How should surrounding whitespace in a title affect requiredness, length validation, and the stored title?\",\n  \"answer\": \"Trim surrounding whitespace before validating and storing the title.\",\n  \"by\": \"Hamza (via web)\"\n },\n {\n  \"id\": \"Q-5\",\n  \"question\": \"After a successful status change on the detail screen, what should happen to the Requests list when the user returns to it?\",\n  \"answer\": \"Keep the selected filter and refresh the list; the request may disappear if it no longer matches the filter.\",\n  \"by\": \"Hamza (via web)\"\n },\n {\n  \"id\": \"Q-6\",\n  \"question\": \"Should the 1280 px table-layout target be configurable, or remain the fixed target specified for this release?\",\n  \"answer\": \"Keep 1280 px as the fixed table-layout target.\",\n  \"by\": \"Hamza (via web)\"\n },\n {\n  \"id\": \"Q-7\",\n  \"question\": \"Should the request detail screen add states for loading a request and for failures other than not-found?\",\n  \"answer\": \"Keep the specified detail behavior: show the request on success and “Request not found.” for an unknown ID; add no other fetch states.\",\n  \"by\": \"Hamza (via web)\"\n }\n]\n</artifact>\n\n<artifact id=\"assumptions\" kind=\"assumptions\" sha=\"\">\n[]\n</artifact>\n\n<artifact id=\"cb\" kind=\"current-behaviour\" sha=\"\">\n{\n \"claims\": [],\n \"header\": {\n  \"createdAt\": \"2026-10-10T16:03:23.865Z\",\n  \"inputsHash\": \"\",\n  \"kind\": \"current-behaviour\",\n  \"producedBy\": {\n   \"stage\": \"ground\"\n  },\n  \"runId\": \"20261010-co-working-space-maintenance-e182\",\n  \"schemaVersion\": 1\n },\n \"notFound\": [\n  {\n   \"searched\": [\n    \"no repository: this is new build work\"\n   ],\n   \"span\": \"I-1\"\n  },\n  {\n   \"searched\": [\n    \"no repository: this is new build work\"\n   ],\n   \"span\": \"I-2\"\n  },\n  {\n   \"searched\": [\n    \"no repository: this is new build work\"\n   ],\n   \"span\": \"I-3\"\n  },\n  {\n   \"searched\": [\n    \"no repository: this is new build work\"\n   ],\n   \"span\": \"I-4\"\n  },\n  {\n   \"searched\": [\n    \"no repository: this is new build work\"\n   ],\n   \"span\": \"I-5\"\n  },\n  {\n   \"searched\": [\n    \"no repository: this is new build work\"\n   ],\n   \"span\": \"I-6\"\n  },\n  {\n   \"searched\": [\n    \"no repository: this is new build work\"\n   ],\n   \"span\": \"I-7\"\n  },\n  {\n   \"searched\": [\n    \"no repository: this is new build work\"\n   ],\n   \"span\": \"I-8\"\n  }\n ]\n}\n</artifact>\n\n<artifact id=\"spec\" kind=\"spec\" sha=\"\">\n{\n \"requirements\": [\n  {\n   \"id\": \"REQ-1\",\n   \"ears\": \"The maintenance request system shall provide a browser-accessible web front end, an HTTP API, and a database that stores request records.\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-1\"\n   ],\n   \"acceptance\": [\n    {\n     \"id\": \"AC-1.1\",\n     \"given\": \"The application and database are running.\",\n     \"when\": \"A client creates a request through the HTTP API and retrieves it by its returned ID.\",\n     \"then\": \"The database row and response record contain the same generated ID and request field values.\",\n     \"level\": \"api\"\n    },\n    {\n     \"id\": \"AC-1.2\",\n     \"given\": \"The application is running.\",\n     \"when\": \"A user opens the application in a browser.\",\n     \"then\": \"The Requests screen is displayed.\",\n     \"level\": \"manual\"\n    }\n   ]\n  },\n  {\n   \"id\": \"REQ-2\",\n   \"ears\": \"When an empty database is initialized, the maintenance request system shall seed exactly eight requests: four Open including exactly one Urgent, two In progress, and two Done, with every supported area represented.\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-2\"\n   ],\n   \"acceptance\": [\n    {\n     \"id\": \"AC-2.1\",\n     \"given\": \"The database is empty before first initialization.\",\n     \"when\": \"The application initializes and a client lists all requests through the API.\",\n     \"then\": \"The response list has a count of 8, with status counts of 4 Open, 2 In progress, and 2 Done; exactly one Open request has Urgent priority, and the list includes every supported area.\",\n     \"level\": \"api\"\n    }\n   ]\n  },\n  {\n   \"id\": \"REQ-3\",\n   \"ears\": \"The maintenance request system shall persist request records across browser reloads and application restarts.\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-3\"\n   ],\n   \"acceptance\": [\n    {\n     \"id\": \"AC-3.1\",\n     \"given\": \"A request has been created and its ID recorded.\",\n     \"when\": \"The application service is restarted and a client retrieves that ID through the API.\",\n     \"then\": \"The response record contains the created request's ID and field values.\",\n     \"level\": \"api\"\n    },\n    {\n     \"id\": \"AC-3.2\",\n     \"given\": \"A request is visible in the Requests list.\",\n     \"when\": \"The browser page is reloaded.\",\n     \"then\": \"The screen shows the persisted request row.\",\n     \"level\": \"manual\"\n    }\n   ]\n  },\n  {\n   \"id\": \"REQ-4\",\n   \"ears\": \"The API shall expose exactly four request operations and no others: list requests, create a request, get a request by ID, and change a request's status.\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-4\"\n   ],\n   \"acceptance\": [\n    {\n     \"id\": \"AC-4.1\",\n     \"given\": \"The API is available.\",\n     \"when\": \"A client invokes list, create, get by ID, and change status using HTTP calls.\",\n     \"then\": \"Each call returns a response for its corresponding request operation.\",\n     \"level\": \"api\"\n    },\n    {\n     \"id\": \"AC-4.2\",\n     \"given\": \"A request exists and its current record has been retrieved.\",\n     \"when\": \"A client attempts to edit a fixed request field or delete the request through the API.\",\n     \"then\": \"Each call returns an error response and the request record remains unchanged.\",\n     \"level\": \"api\"\n    }\n   ]\n  },\n  {\n   \"id\": \"REQ-5\",\n   \"ears\": \"When a client lists requests, the API shall return all requests or only requests matching one requested status, ordered newest first.\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-4\"\n   ],\n   \"acceptance\": [\n    {\n     \"id\": \"AC-5.1\",\n     \"given\": \"Requests with different statuses and creation times exist.\",\n     \"when\": \"A client lists requests without a status and then lists requests with one status filter.\",\n     \"then\": \"The first response list contains all requests newest first, and the filtered response list contains only matching statuses newest first.\",\n     \"level\": \"api\"\n    }\n   ]\n  },\n  {\n   \"id\": \"REQ-6\",\n   \"ears\": \"When a client creates a valid request, the maintenance request system shall assign an ID and UTC creation time and set its status to Open.\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-4\"\n   ],\n   \"acceptance\": [\n    {\n     \"id\": \"AC-6.1\",\n     \"given\": \"A client has valid request fields.\",\n     \"when\": \"The client creates a request through the API.\",\n     \"then\": \"The response record contains a system-generated ID, a UTC creation time, and status Open.\",\n     \"level\": \"api\"\n    }\n   ]\n  },\n  {\n   \"id\": \"REQ-7\",\n   \"ears\": \"When a client submits a request for creation, the maintenance request system shall require a title trimmed to 3 to 80 characters, an area of Kitchen, Meeting room, Open desk, Washroom, or Reception, a priority of Low, Normal, or Urgent, and an optional description of at most 500 characters, rejecting invalid values with an error naming the field.\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-4\",\n    \"Q-4\"\n   ],\n   \"acceptance\": [\n    {\n     \"id\": \"AC-7.1\",\n     \"given\": \"A client submits requests with a missing title, a two-character title, a title over 80 characters, a missing or unsupported area, a missing or unsupported priority, or a description over 500 characters.\",\n     \"when\": \"The client sends each request to the create API operation.\",\n     \"then\": \"Each invalid response contains an error naming the invalid field, and the two-character title response contains “Title must be 3 to 80 characters.”\",\n     \"level\": \"api\"\n    },\n    {\n     \"id\": \"AC-7.2\",\n     \"given\": \"A client submits a title with surrounding whitespace that leaves 3 to 80 characters after trimming, and a title containing only whitespace in a separate request.\",\n     \"when\": \"The client creates both requests through the API.\",\n     \"then\": \"The valid response record contains the trimmed title, and the invalid response contains a Title error.\",\n     \"level\": \"api\"\n    }\n   ]\n  },\n  {\n   \"id\": \"REQ-8\",\n   \"ears\": \"The API shall keep title, area, priority, and description fixed after creation and reject attempts to change those fields or delete a request.\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-4\"\n   ],\n   \"acceptance\": [\n    {\n     \"id\": \"AC-8.1\",\n     \"given\": \"A request exists with known title, area, priority, and description values.\",\n     \"when\": \"A client attempts to change each of those fields or delete the request through the API.\",\n     \"then\": \"The response is an error and the retrieved record retains its original field values.\",\n     \"level\": \"api\"\n    }\n   ]\n  },\n  {\n   \"id\": \"REQ-9\",\n   \"ears\": \"The maintenance request API shall accept the transitions Open to In progress, In progress to Done, and Done to Open and reject all other status changes; a status change for an unknown request ID shall return a not-found response, and a missing status body or unrecognized status value shall return an error without changing any request.\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-4\"\n   ],\n   \"acceptance\": [\n    {\n     \"id\": \"AC-9.1\",\n     \"given\": \"A request has status Open.\",\n     \"when\": \"A client changes its status to In progress through the API.\",\n     \"then\": \"The response record has status In progress.\",\n     \"level\": \"api\"\n    },\n    {\n     \"id\": \"AC-9.2\",\n     \"given\": \"A request has status In progress.\",\n     \"when\": \"A client changes its status to Done through the API.\",\n     \"then\": \"The response record has status Done.\",\n     \"level\": \"api\"\n    },\n    {\n     \"id\": \"AC-9.3\",\n     \"given\": \"A request has status Done.\",\n     \"when\": \"A client changes its status to Open through the API.\",\n     \"then\": \"The response record has status Open.\",\n     \"level\": \"api\"\n    },\n    {\n     \"id\": \"AC-9.4\",\n     \"given\": \"A request has status Open.\",\n     \"when\": \"A client attempts to change its status directly to Done.\",\n     \"then\": \"The response is an error and the retrieved record still has status Open.\",\n     \"level\": \"api\"\n    },\n    {\n     \"id\": \"AC-9.5\",\n     \"given\": \"No request has the ID supplied to the status-change operation.\",\n     \"when\": \"A client attempts to change status for that ID through the API.\",\n     \"then\": \"The response identifies the request as not found.\",\n     \"level\": \"api\"\n    },\n    {\n     \"id\": \"AC-9.6\",\n     \"given\": \"A request exists and its current record has been retrieved.\",\n     \"when\": \"A client sends a status-change request with no body.\",\n     \"then\": \"The response is an error and the request row retains its original status.\",\n     \"level\": \"api\"\n    },\n    {\n     \"id\": \"AC-9.7\",\n     \"given\": \"A request exists and its current record has been retrieved.\",\n     \"when\": \"A client sends a status-change request with an unrecognized status value.\",\n     \"then\": \"The response is an error and the request row retains its original status.\",\n     \"level\": \"api\"\n    }\n   ]\n  },\n  {\n   \"id\": \"REQ-10\",\n   \"ears\": \"The Requests screen shall display the Hive Works wordmark, the signed-in demo user's initials SC, a status filter with All, Open, In progress, and Done choices with All selected initially, a New request button, and a newest-first request list.\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-5\"\n   ],\n   \"acceptance\": [\n    {\n     \"id\": \"AC-10.1\",\n     \"given\": \"The Requests screen has loaded.\",\n     \"when\": \"A user views the screen before changing any filter.\",\n     \"then\": \"The screen displays the Hive Works wordmark, SC, the four filter choices with All selected, the New request button, and the request list.\",\n     \"level\": \"manual\"\n    }\n   ]\n  },\n  {\n   \"id\": \"REQ-11\",\n   \"ears\": \"When a user selects a status filter or returns from request detail, the Requests screen shall load the list for the selected filter and retain that filter on return from detail.\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-5\",\n    \"Q-5\"\n   ],\n   \"acceptance\": [\n    {\n     \"id\": \"AC-11.1\",\n     \"given\": \"The Requests screen is showing a selected status filter.\",\n     \"when\": \"The user opens a request detail screen, changes its status successfully, and returns to the Requests screen.\",\n     \"then\": \"The screen retains the selected filter and displays a refreshed list in which a request that no longer matches may be absent.\",\n     \"level\": \"manual\"\n    },\n    {\n     \"id\": \"AC-11.2\",\n     \"given\": \"The Requests screen is loaded.\",\n     \"when\": \"The user selects a status filter.\",\n     \"then\": \"The screen displays the refreshed list for that filter.\",\n     \"level\": \"manual\"\n    }\n   ]\n  },\n  {\n   \"id\": \"REQ-12\",\n   \"ears\": \"When the user opens New request, the Requests screen shall show a dialog with Title, Area, Priority defaulting to Normal, and Description fields, plus Create and Cancel controls.\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-5\"\n   ],\n   \"acceptance\": [\n    {\n     \"id\": \"AC-12.1\",\n     \"given\": \"The Requests screen is displayed.\",\n     \"when\": \"The user activates New request.\",\n     \"then\": \"The screen shows a dialog with labeled Title, Area, Priority, and Description fields, Normal selected for Priority, and Create and Cancel controls.\",\n     \"level\": \"manual\"\n    }\n   ]\n  },\n  {\n   \"id\": \"REQ-13\",\n   \"ears\": \"When valid request creation succeeds, the Requests screen shall close the dialog, select All, and show the new Open request at the top of the list.\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-5\",\n    \"Q-1\"\n   ],\n   \"acceptance\": [\n    {\n     \"id\": \"AC-13.1\",\n     \"given\": \"The create dialog is open and a filter other than All is selected.\",\n     \"when\": \"The user submits valid request fields and the create API call succeeds.\",\n     \"then\": \"The screen closes the dialog, selects All, and shows the new Open request row at the top of the list.\",\n     \"level\": \"manual\"\n    }\n   ]\n  },\n  {\n   \"id\": \"REQ-14\",\n   \"ears\": \"When a create field fails validation, the Requests screen shall keep the dialog open and display the field's error message under that field.\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-5\"\n   ],\n   \"acceptance\": [\n    {\n     \"id\": \"AC-14.1\",\n     \"given\": \"The create dialog is open.\",\n     \"when\": \"The user submits a title of two characters.\",\n     \"then\": \"The screen keeps the dialog open and displays “Title must be 3 to 80 characters.” under the Title field.\",\n     \"level\": \"manual\"\n    }\n   ]\n  },\n  {\n   \"id\": \"REQ-15\",\n   \"ears\": \"When the create API call fails for a reason other than field validation, the Requests screen shall show “Could not create request.” in the dialog, retain entered values, and allow retry.\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-5\",\n    \"Q-3\"\n   ],\n   \"acceptance\": [\n    {\n     \"id\": \"AC-15.1\",\n     \"given\": \"The create dialog contains entered values.\",\n     \"when\": \"The create API call fails for a non-validation reason.\",\n     \"then\": \"The screen displays “Could not create request.” in the dialog, retains the entered field values, and shows an enabled retry path through Create.\",\n     \"level\": \"manual\"\n    }\n   ]\n  },\n  {\n   \"id\": \"REQ-16\",\n   \"ears\": \"While requests are loading, absent for the selected filter, or fail to load, the Requests screen shall display the corresponding loading, empty, or error state with retry available for load errors.\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-5\"\n   ],\n   \"acceptance\": [\n    {\n     \"id\": \"AC-16.1\",\n     \"given\": \"The Requests list request is in progress.\",\n     \"when\": \"The user views the Requests screen.\",\n     \"then\": \"The screen displays “Loading requests…”.\",\n     \"level\": \"manual\"\n    },\n    {\n     \"id\": \"AC-16.2\",\n     \"given\": \"No requests match the selected filter.\",\n     \"when\": \"The Requests screen finishes loading the list.\",\n     \"then\": \"The screen displays “No requests here.”\",\n     \"level\": \"manual\"\n    },\n    {\n     \"id\": \"AC-16.3\",\n     \"given\": \"The list API call fails.\",\n     \"when\": \"The Requests screen handles the failure.\",\n     \"then\": \"The screen displays “Could not load requests.” and a Retry button.\",\n     \"level\": \"manual\"\n    }\n   ]\n  },\n  {\n   \"id\": \"REQ-17\",\n   \"ears\": \"When a request exists, the request detail screen shall display a back link, its title, area, priority badge, status badge, created date, and description or “No description.” when the description is empty.\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-6\",\n    \"Q-7\"\n   ],\n   \"acceptance\": [\n    {\n     \"id\": \"AC-17.1\",\n     \"given\": \"A request with a description and a request without a description both exist.\",\n     \"when\": \"The user opens each request detail screen.\",\n     \"then\": \"Each screen displays the request fields, badges, created date, and back link, and the screen for the request without a description displays “No description.”\",\n     \"level\": \"manual\"\n    }\n   ]\n  },\n  {\n   \"id\": \"REQ-18\",\n   \"ears\": \"The request detail screen shall show Start work for Open, Mark done for In progress, and Reopen for Done.\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-6\"\n   ],\n   \"acceptance\": [\n    {\n     \"id\": \"AC-18.1\",\n     \"given\": \"Requests exist in Open, In progress, and Done statuses.\",\n     \"when\": \"The user opens each request detail screen.\",\n     \"then\": \"The screen shows Start work, Mark done, and Reopen for the corresponding statuses.\",\n     \"level\": \"manual\"\n    }\n   ]\n  },\n  {\n   \"id\": \"REQ-19\",\n   \"ears\": \"When a status change succeeds or fails, the request detail screen shall show the new status and corresponding action only after success, or show “Could not update the request.” while retaining the prior status after failure.\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-6\"\n   ],\n   \"acceptance\": [\n    {\n     \"id\": \"AC-19.1\",\n     \"given\": \"A request detail screen shows its current status and action button.\",\n     \"when\": \"The user activates the button and the status API call succeeds.\",\n     \"then\": \"After the response, the screen displays the new status badge and the corresponding next action button.\",\n     \"level\": \"manual\"\n    },\n    {\n     \"id\": \"AC-19.2\",\n     \"given\": \"A request detail screen shows its current status and action button.\",\n     \"when\": \"The user activates the button and the status API call fails.\",\n     \"then\": \"The screen displays “Could not update the request.” and retains the prior status badge.\",\n     \"level\": \"manual\"\n    }\n   ]\n  },\n  {\n   \"id\": \"REQ-20\",\n   \"ears\": \"When a request ID does not exist, the request detail screen shall display “Request not found.” and a link back to the Requests screen.\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-6\",\n    \"Q-7\"\n   ],\n   \"acceptance\": [\n    {\n     \"id\": \"AC-20.1\",\n     \"given\": \"No request has the ID in the address.\",\n     \"when\": \"The user opens the detail screen for that ID.\",\n     \"then\": \"The screen displays “Request not found.” and a link back to the Requests screen.\",\n     \"level\": \"manual\"\n    },\n    {\n     \"id\": \"AC-20.2\",\n     \"given\": \"No request has the requested ID.\",\n     \"when\": \"A client gets that ID through the API.\",\n     \"then\": \"The response identifies the request as not found.\",\n     \"level\": \"api\"\n    }\n   ]\n  },\n  {\n   \"id\": \"REQ-21\",\n   \"ears\": \"The maintenance request screens shall use one light theme, one sans-serif font, a neutral background, near-black text, and the specified status and priority badge colors with text labels on every badge.\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-7\"\n   ],\n   \"acceptance\": [\n    {\n     \"id\": \"AC-21.1\",\n     \"given\": \"The Requests and request detail screens are displayed.\",\n     \"when\": \"A person inspects the theme and badges.\",\n     \"then\": \"The screens show a light theme, sans-serif text, neutral background, near-black text, Open blue, In progress amber, Done green, Urgent red, Low and Normal neutral, and readable text on every badge.\",\n     \"level\": \"manual\"\n    }\n   ]\n  },\n  {\n   \"id\": \"REQ-22\",\n   \"ears\": \"The maintenance request screens shall show request dates as date-only values, use stacked cards at 375 px and table rows at the fixed 1280 px target, avoid horizontal page scrolling at those widths, label every field, and make every control keyboard reachable with WCAG AA text contrast.\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-5\",\n    \"I-6\",\n    \"I-7\",\n    \"Q-