/components/responses/ServerError'\n  /lots:\n    get:\n      operationId: listLots\n      summary: \"List active lots with procurement traceability and pen allocations.\"\n      responses:\n        '200':\n          description: \"Lots and their PO-line and pen relationships.\"\n          content:\n            application/json:\n              schema:\n                $ref: '#/components/schemas/LotList'\n              example:\n                lots:\n                  - id: 241\n                    lotCode: L-241\n                    sourceId: PO-7301-1\n                    sourceRecordId: REC-5518\n                    supplier: Prairie Cattle Co.\n                    receivedDate: '2026-02-01'\n                    breed: Angus\n                    sex: Unknown\n                    receivedHead: 40\n                    purchaseCostAllocation: 600\n                    pen: North 2\n                    penCapacity: 120\n                    penCount: 80\n                    targetWeightLb: 1250\n        '401':\n          $ref: '#/components/responses/Unauthorized'\n        '403':\n          $ref: '#/components/responses/Forbidden'\n        '500':\n          $ref: '#/components/responses/ServerError'\n  /lots/{lotId}/lifecycle:\n    get:\n      operationId: getLotLifecycle\n      summary: \"Get lifecycle milestones and market projection for a lot.\"\n      parameters:\n        - $ref: '#/components/parameters/LotId'\n      responses:\n        '200':\n          description: \"Lifecycle, target, growth assumption, and projection.\"\n          content:\n            application/json:\n              schema:\n                $ref: '#/components/schemas/Lifecycle'\n              example:\n                lotId: 241\n                lotCode: L-241\n                receivedDate: '2026-02-01'\n                targetWeightLb: 1250\n                targetWeightSource: Lot target\n                growthAssumption: Measured ADG\n                growthRateLbPerDay: 3.2\n                projectedMarketDate: '2026-07-10'\n                milestones:\n                  - date: '2026-02-01'\n                    label: Received\n                    value: 620\n                    unit: lb average weight\n                  - date: '2026-04-10'\n                    label: Weight measurement\n                    value: 748\n                    unit: lb average weight\n                weightHistory:\n                  - date: '2026-04-10'\n                    daysOnFeed: 68\n                    averageWeightLb: 748\n                    periodGainLb: 128\n                    periodAdgLbPerDay: 3.2\n                    operator: Morgan Lee\n                    status: Accepted\n        '400':\n          $ref: '#/components/responses/BadRequest'\n        '401':\n          $ref: '#/components/responses/Unauthorized'\n        '403':\n          $ref: '#/components/responses/Forbidden'\n        '404':\n          $ref: '#/components/responses/NotFound'\n  /inventory:\n    get:\n      operationId: listInventory\n      summary: \"List feed inventory with units, nutrition, cost, and stock movements.\"\n      responses:\n        '200':\n          description: \"Inventory items and current movement totals.\"\n          content:\n            application/json:\n              schema:\n                $ref: '#/components/schemas/InventoryList'\n              example:\n                items:\n                  - id: 401\n                    item: Ground corn\n                    category: Grain\n                    supplier: Prairie Feed\n                    availableQuantity: 6.2\n                    enteredUnit: ton\n                    normalizedPounds: 12400\n                    cost: 360\n                    costUnit: USD per ton\n                    normalizedCostUsdPerLb: 0.18\n                    dryMatterPercent: 88\n                    energyMcalPerLb: 1.52\n                    storageLocation: Bin 2\n                    openingLb: 10000\n                    receivedLb: 5000\n                    consumedLb: 2600\n                    closingLb: 12400\n                    movements:\n                      - date: '2026-04-12'\n                        type: Receipt\n                        quantityLb: 5000\n                      - date: '2026-04-14'\n                        type: Feed consumption\n                        quantityLb: 2600\n        '401':\n          $ref: '#/components/responses/Unauthorized'\n        '403':\n          $ref: '#/components/responses/Forbidden'\n        '500':\n          $ref: '#/components/responses/ServerError'\n  /inventory/receipts:\n    post:\n      operationId: createInventoryReceipt\n      summary: \"Record a feed receipt while retaining its entered unit.\"\n      requestBody:\n        required: true\n        content:\n          application/json:\n            schema:\n              $ref: '#/components/schemas/InventoryReceiptRequest'\n            example:\n              itemName: Ground corn\n              supplier: Prairie Feed\n              quantity: 2\n              enteredUnit: ton\n              normalizedPounds: 4000\n              cost: 360\n              costUnit: USD per ton\n              receivedDate: '2026-04-14'\n      responses:\n        '201':\n          description: \"Receipt accepted with normalized stock values.\"\n          content:\n            application/json:\n              schema:\n                $ref: '#/components/schemas/InventoryReceiptResult'\n              example:\n                item:\n                  id: 401\n                  item: Ground corn\n                  enteredQuantity: 2\n                  enteredUnit: ton\n                  normalizedPounds: 4000\n                  enteredCost: 360\n                  costUnit: USD per ton\n                  normalizedCostUsdPerLb: 0.18\n                  receivedDate: '2026-04-14'\n                  closingLb: 16400\n                message: Receipt recorded\n        '400':\n          $ref: '#/components/r