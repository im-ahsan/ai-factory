 }\n    }\n}\n\npublic sealed class AC11_1Tests(AppFactory factory) : IClassFixture<AppFactory>\n{\n    [Fact]\n    public async Task AC_11_1_ReceiptInTonsRetainsUnitAndNormalizesPounds()\n    {\n        using var api = new Part4Api(factory);\n        using var receipt = await Part4Http.PostCreatedAsync(api.Client, \"/api/v1/inventory/receipts\", new\n        {\n            itemName = \"Ground corn\",\n            supplier = \"Part4 Feed Supplier\",\n            quantity = 2,\n            enteredUnit = \"ton\",\n            normalizedPounds = 4000,\n            cost = 360,\n            costUnit = \"USD per ton\",\n            receivedDate = \"2026-04-14\"\n        });\n\n        var receiptItem = receipt.RootElement.GetProperty(\"item\");\n        Assert.Equal(\"ton\", receiptItem.GetProperty(\"enteredUnit\").GetString());\n        Assert.Equal(2m, receiptItem.GetProperty(\"enteredQuantity\").GetDecimal());\n        Assert.Equal(4000m, receiptItem.GetProperty(\"normalizedPounds\").GetDecimal());\n\n        using var inventoryResponse = await api.Client.GetAsync(\"/api/v1/inventory\");\n        Assert.Equal(HttpStatusCode.OK, inventoryResponse.StatusCode);\n        using var inventory = await inventoryResponse.Content.ReadFromJsonAsync<JsonDocument>();\n        Assert.NotNull(inventory);\n        var groundCorn = inventory.RootElement.GetProperty(\"items\").EnumerateArray()\n            .Single(item => item.GetProperty(\"item\").GetString() == \"Ground corn\");\n        Assert.Equal(2m, groundCorn.GetProperty(\"availableQuantity\").GetDecimal());\n        Assert.Equal(\"ton\", groundCorn.GetProperty(\"enteredUnit\").GetString());\n        Assert.Equal(4000m, groundCorn.GetProperty(\"normalizedPounds\").GetDecimal());\n        Assert.Equal(4000m, groundCorn.GetProperty(\"closingLb\").GetDecimal());\n    }\n}\n\npublic sealed class AC11_2Tests(AppFactory factory) : IClassFixture<AppFactory>\n{\n    [Fact]\n    public async Task AC_11_2_TonRationIngredientUsesPoundsForCostAndFeeding()\n    {\n        using var api = new Part4Api(factory);\n        var setup = await Part4Database.SeedFeedDataAsync(api.ConnectionString, 60, 40, 20_000m);\n        using var rationResponse = await Part4Http.PostCreatedAsync(api.Client, \"/api/v1/rations\", new\n        {\n            name = \"Part4 ton ration\",\n            rationType = \"Grower\",\n            intendedAnimalRange = \"650-900 lb cattle\",\n            ingredients = new[]\n            {\n                new { ingredientId = setup.InventoryItemId, name = \"Ground corn\", quantity = 2, enteredUnit = \"ton\", proportionPercent = 100 }\n            }\n        });\n\n        var ration = rationResponse.RootElement.GetProperty(\"ration\");\n        var ingredient = ration.GetProperty(\"ingredients\").EnumerateArray().Single();\n        Assert.Equal(2m, ingredient.GetProperty(\"quantity\").GetDecimal());\n        Assert.Equal(\"ton\", ingredient.GetProperty(\"enteredUnit\").GetString());\n        Assert.Equal(4000m, ingredient.GetProperty(\"normalizedQuantityLb\").GetDecimal());\n        Part4Http.AssertNear(720m, ingredient.GetProperty(\"totalCostUsd\").GetDecimal());\n        Part4Http.AssertNear(0.18m, ration.GetProperty(\"costUsdPerLb\").GetDecimal());\n\n        using var activityResponse = await Part4Http.PostCreatedAsync(api.Client, \"/api/v1/feeding-activities\", new\n        {\n            date = \"2026-04-14\",\n            penId = setup.PenId,\n            rationId = ration.GetProperty(\"id\").GetInt32(),\n            bunkRateLbPerHeadPerDay = 10,\n            headCount = 100,\n            actualQuantityDeliveredLb = 1000,\n            lotAllocations = new[]\n            {\n                new { lotId = setup.FirstLotId, deliveredQuantityLb = 600 },\n                new { lotId = setup.SecondLotId, deliveredQuantityLb = 400 }\n            }\n        });\n\n        var activity = activityResponse.RootElement.GetProperty(\"activity\");\n        var consumption = activity.GetProperty(\"inventoryConsumption\").EnumerateArray().Single();\n        Assert.Equal(\"Ground corn\", consumption.GetProperty(\"ingredient\").GetString());\n        Assert.Equal(1000m, consumption.GetProperty(\"quantityLb\").GetDecimal());\n        var inventoryTotal = activityResponse.RootElement.GetProperty(\"inventoryTotals\").EnumerateArray().Single();\n        Assert.Equal(\"Ground corn\", inventoryTotal.GetProperty(\"item\").GetString());\n        Assert.Equal(19_000m, inventoryTotal.GetProperty(\"closingLb\").GetDecimal());\n    }\n}\n\npublic sealed class AC11_3Tests(AppFactory factory) : IClassFixture<AppFactory>\n{\n    [Fact]\n    public async Task AC_11_3_TonRationFeedingDeductsPoundsAndKeepsDisplayUnit()\n    {\n        using var api = new Part4Api(factory);\n        var setup = await Part4Database.SeedFeedDataAsync(api.ConnectionString, 60, 40, 20_000m);\n        using var rationResponse = await Part4Http.PostCreatedAsync(api.Client, \"/api/v1/rations\", new\n        {\n            name = \"Part4 ration display units\",\n            rationType = \"Grower\",\n            intendedAnimalRange = \"650-900 lb cattle\",\n            ingredients = new[]\n            {\n                new { ingredientId = setup.InventoryItemId, name = \"Ground corn\", quantity = 1, enteredUnit = \"ton\", proportionPercent = 100 }\n            }\n        });\n        var rationId = rationResponse.RootElement.GetProperty(\"ration\").GetProperty(\"id\").GetInt32();\n        var rationIngredient = rationResponse.RootElement.GetProperty(\"ration\").GetProperty(\"ingredients\").EnumerateArray().Single();\n        Assert.Equal(1m, rationIngredient.GetProperty(\"quantity\").GetDecimal());\n        Assert.Equal(\"ton\", rationIngredient.GetProperty(\"enteredUnit\").GetString());\n        Assert.Equal(2000m, rationIngredient.GetProperty(\"normalizedQuantityLb\").GetDecimal());\n\n        using var activityResponse = await Part4Http.PostCreatedAsync(api.Client, \"/api/v1/feeding-activities\", new\n        {\n            date = \"2026-04-15\",\n            penId = setup.PenId,\n            rationId,\n            bunkRateLbPerHeadPerDay = 10,\n            headCount = 100,\n            actualQuantityDeliveredLb = 1000,\n            lotAllocations = new[]\n            {\n                new { lotId = setup.FirstLotId, deliveredQuantityLb = 600 },\n                new { lotId = setup.SecondLotId, deliveredQuantityLb = 400 }\n            }\n        });\n        var createdActivityId = activityResponse.RootElement.GetProperty(\"activity\").GetProperty(\"id\").GetInt32();\n        var activityConsumption = activityResponse.RootElement.GetProperty(\"activity\").GetProperty(\"inventoryConsumption\").EnumerateArray().Single();\n        Assert.Equal(1000m, activityConsumption.GetProperty(\"quantityLb\").GetDecimal());\n\n        using var inventoryResponse = await api.Client.GetAsync(\"/api/v1/inventory\");\n        Assert.Equal(HttpStatusCode.OK, inventoryResponse.StatusCode);\n        using var inventory = await inventoryResponse.Content.ReadFromJsonAsync<JsonDocument>();\n        Assert.NotNull(inventory);\n        var item = inventory.RootElement.GetProperty(\"items\").EnumerateArray()\n            .Single(row => row.GetProperty(\"item\").GetString() == \"Ground corn\");\n        Assert.Equal(\"ton\", item.GetProperty(\"enteredUnit\").GetString());\n        Assert.Equal(9.5m, item.GetProperty(\"availableQuantity\").GetDecimal());\n        Assert.Equal(19_000m, item.GetProperty(\"normalizedPounds\").GetDecimal());\n        Assert.Equal(19_000m, item.GetProperty(\"closingLb\").GetDecimal());\n\n        using var activitiesResponse = await api.Client.GetAsync(\"/api/v1/feeding-activities\");\n        Assert.Equal(HttpStatusCode.OK, activitiesResponse.StatusCode);\n        using var activities = await activitiesResponse.Content.ReadFromJsonAsync<JsonDocument>();\n        Assert.NotNull(activities);\n        var listedActivity = activities.RootElement.GetProperty(\"activities\").EnumerateArray()\n            .Single(row => row.GetProperty(\"id\").GetInt32() == createdActivityId);\n        Assert.Equal(1000m, listedActivity.GetProperty(\"inventoryConsumption\").EnumerateArray().Single().GetProperty(\"quantityLb\").GetDecimal());\n    }\n}\n\npublic sealed class AC12_1Tests(AppFactory factory) : IClassFixture<AppFactory>\n{\n    [Fact]\n    public async Task AC_12_1_ActivityAttributesEachLotShareAndRollup()\n    {\n        using var api = new Part4Api(factory);\n        var setup = await Part4Database.SeedFeedDataAsync(api.ConnectionString, 60, 40, 20_000m, seedRation: true);\n        using var response = await Part4Http.PostCreatedAsync(api.Client, \"/api/v1/feeding-activities\", Part4Http.ActivityRequest(setup, 9.5m, 100, 950, 570, 380, \"2026-04-14\"));\n\n        var activity = response.RootElement.GetProperty(\"activity\");\n        var allocations = activity.GetProperty(\"lotAllocations\").EnumerateArray().ToArray();\n        Assert.Equal(2, allocations.Length);\n        Assert.Equal(570m, Part4Http.FindById(allocations, setup.FirstLotId).GetProperty(\"deliveredQuantityLb\").GetDecimal());\n        Assert.Equal(380m, Part4Http.FindById(allocations, setup.SecondLotId).GetProperty(\"deliveredQuantityLb\").GetDecimal());\n\n        var rollups = activity.GetProperty(\"lotRollups\").EnumerateArray().ToArray();\n        Assert.Equal(2, rollups.Length);\n        Assert.Equal(570m, Part4Http.FindById(rollups, setup.FirstLotId).GetProperty(\"totalFeedConsumedLb\").GetDecimal());\n        Assert.Equal(380m, Part4Http.FindById(rollups, setup.SecondLotId).GetProperty(\"totalFeedConsumedLb\").GetDecimal());\n    }\n}\n\npublic sealed class AC12_2Tests(AppFactory factory) : IClassFixture<AppFactory>\n{\n    [Fact]\n    public async Task AC_12_2_OverPlanDeliveryReturnsLotSharesSummingToActual()\n    {\n        using var api = new Part4Api(factory);\n        var setup = await Part4Database.SeedFeedDataAsync(api.ConnectionString, 60, 40, 20_