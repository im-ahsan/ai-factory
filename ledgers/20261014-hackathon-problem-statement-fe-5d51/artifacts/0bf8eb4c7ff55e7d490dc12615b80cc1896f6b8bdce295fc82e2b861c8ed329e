{"ts":1791996024443,"kind":"call","tool":"Bash","input":"{\"command\":\"cat contracts/openapi.yaml\"}","output":"openapi: 3.0.3\ninfo:\n  title: Feedlot Operations API\n  version: 1.0.0\n  description: \"Shared API contract for the responsive Feedlot web application and API implementation.\"\nservers:\n  - url: /api/v1\nsecurity:\n  - bearerAuth: []\npaths:\n  /auth/sign-in:\n    post:\n      operationId: signIn\n      summary: \"Sign in with an administrator-managed account.\"\n      security: []\n      requestBody:\n        required: true\n        content:\n          application/json:\n            schema:\n              $ref: '#/components/schemas/SignInRequest'\n            example:\n              email: operator@example.com\n              password: «SECRET_1»      responses:\n        '200':\n          description: \"Signed-in account and role.\"\n          content:\n            application/json:\n              schema:\n                $ref: '#/components/schemas/Session'\n              example:\n                user:\n                  id: 18\n                  name: Morgan Lee\n                  email: operator@example.com\n                  role: Operator\n                accessToken: «SECRET_2»                availablePages:\n                  - Overview\n                  - Lots\n                  - Inventory\n                  - Rations\n                  - Feeding plans\n                  - Feeding log\n                  - Lot weights\n                  - Yard summary\n                  - Feed-to-Gain\n        '400':\n          $ref: '#/components/responses/BadRequest'\n        '401':\n          $ref: '#/components/responses/Unauthorized'\n        '403':\n          $ref: '#/components/responses/Forbidden'\n        '503':\n          $ref: '#/components/responses/Unavailable'\n  /overview:\n    get:\n      operationId: getOverview\n      summary: \"Get operational overview tables and headline values.\"\n      responses:\n        '200':\n          description