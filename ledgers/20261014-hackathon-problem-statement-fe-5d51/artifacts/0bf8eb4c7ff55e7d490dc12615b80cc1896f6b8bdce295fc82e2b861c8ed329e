tityLb: 500\n                      proportionPercent: 50\n                      unitCostUsdPerLb: 0.18\n                      totalCostUsd: 90\n        '400':\n          $ref: '#/components/responses/BadRequest'\n        '401':\n          $ref: '#/components/responses/Unauthorized'\n        '403':\n          $ref: '#/components/responses/Forbidden'\n        '422':\n          $ref: '#/components/responses/ValidationError'\n  /rations/optimization:\n    post:\n      operationId: optimizeRation\n      summary: \"Return candidate mixes for submitted nutrition or animal-range constraints.\"\n      requestBody:\n        required: true\n        content:\n          application/json:\n            schema:\n              $ref: '#/components/schemas/OptimizationRequest'\n            example:\n              intendedAnimalRange: 650-900 lb cattle\n              minimumCrudeProteinPercent: 12\n              minimumTdnPercent: 68\n              maximumCostUsdPerLb: 0.22\n      responses:\n        '200':\n          description: \"Unsaved candidate mixes and their trade-offs.\"\n          content:\n            application/json:\n              schema:\n                $ref: '#/components/schemas/CandidateList'\n              example:\n                candidates:\n                  - id: 71\n                    name: Balanced grower mix\n                    ingredients:\n                      - name: Ground corn\n                        proportionPercent: 55\n                      - name: Alfalfa meal\n                        proportionPercent: 45\n                    costUsdPerLb: 0.2\n                    crudeProteinPercent: 13.1\n                    tdnPercent: 69\n                    netEnergyMcalPerLb: 1.38\n                    tradeoff: Higher protein with a modest cost increase\n                    status: Candidate\n        '400':\n          $ref: '#/components/responses/BadRequest'\n        '401':\n          $ref: '#/components/responses/Unauthorized'\n        '403':\n          $ref: '#/components/responses/Forbidden'\n        '422':\n          $ref: '#/components/responses/ValidationError'\n  /rations/candidates/{candidateId}/save:\n    post:\n      operationId: saveRationCandidate\n      summary: \"Explicitly save an optimization candidate.\"\n      parameters:\n        - $ref: '#/components/parameters/CandidateId'\n      requestBody:\n        required: true\n        content:\n          application/json:\n            schema:\n              $ref: '#/components/schemas/CandidateActionRequest'\n            example:\n              name: Balanced grower mix\n      responses:\n        '200':\n          description: \"Candidate saved after explicit acceptance.\"\n          content:\n            application/json:\n              schema:\n                $ref: '#/components/schemas/CandidateActionResult'\n              example:\n                candidateId: 71\n                status: Saved\n                message: Candidate saved\n        '400':\n          $ref: '#/components/responses/BadRequest'\n        '401':\n          $ref: '#/components/responses/Unauthorized'\n        '403':\n          $ref: '#/components/responses/Forbidden'\n        '404':\n          $ref: '#/components/responses/NotFound'\n  /rations/candidates/{candidateId}/assign:\n    post:\n      operationId: assignRationCandidate\n      summary: \"Explicitly assign an optimization candidate.\"\n      parameters:\n        - $ref: '#/components/parameters/CandidateId'\n      requestBody:\n        required: true\n        content:\n          application/json:\n            schema:\n              $ref: '#/components/schemas/CandidateAssignRequest'\n            example:\n              penId: 12\n              effectiveDate: '2026-04-15'\n      responses:\n        '200':\n          description: \"Candidate assignment accepted.\"\n          content:\n            application/json:\n              schema:\n                $ref: '#/components/schemas/CandidateActionResult'\n              example:\n                candidateId: 71\n                status: Assigned\n                message: Candidate assigned to North 2\n        '400':\n          $ref: '#/components/responses/BadRequest'\n        '401':\n          $ref: '#/components/responses/Unauthorized'\n        '403':\n          $ref: '#/components/responses/Forbidden'\n        '404':\n          $ref: '#/components/responses/NotFound'\n  /feeding-plans:\n    get:\n      operationId: listFeedingPlans\n      summary: \"List dated pen feeding plans and schedule status.\"\n      responses:\n        '200':\n          description: \"Plans ordered by delivery date and pen.\"\n          content:\n            application/json:\n              schema:\n                $ref: '#/components/schemas/FeedingPlanList'\n              example:\n                plans:\n                  - id: 801\n                    date: '2026-04-14'\n                    penId: 12\n                    pen: North 2\n                    rationId: 61\n                    ration: Grower 2\n                    bunkRateLbPerHeadPerDay: 25\n                    plannedHeadCount: 40\n                    plannedQuantityLb: 1000\n                    feedingTime: '06:30'\n                    costUsd: 190\n                    expectedEnergyMcal: 1420\n                    status: Planned\n                    lotAllocations:\n                      - lotId: 241\n                        lotCode: L-241\n                        plannedQuantityLb: 600\n        '401':\n          $ref: '#/components/responses/Unauthorized'\n        '403':\n          $ref: '#/components/responses/Forbidden'\n        '500':\n          $ref: '#/components/responses/ServerError'\n    post:\n      operationId: createFeedingPlan\n      summary: \"Generate a dated pen feeding plan.\"\n      requestBody:\n        required: true\n        content:\n          application/json:\n            schema:\n              $ref: '#/components/schemas/FeedingPlanRequest'\n            example:\n