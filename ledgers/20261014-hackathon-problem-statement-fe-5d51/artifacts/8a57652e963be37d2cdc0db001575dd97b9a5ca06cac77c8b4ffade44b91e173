rty(\"error\").GetString());\n        Assert.Equal(\"INSUFFICIENT_STOCK\", error.RootElement.GetProperty(\"code\").GetString());\n\n        using var inventoryAfterResponse = await client.GetAsync(\"/api/v1/inventory\");\n        Assert.Equal(HttpStatusCode.OK, inventoryAfterResponse.StatusCode);\n        using var inventoryAfter = await Part2Json.ReadAsync(inventoryAfterResponse);\n        var afterItem = Assert.Single(inventoryAfter.RootElement.GetProperty(\"items\").EnumerateArray());\n        Assert.Equal(beforeItemJson, afterItem.GetRawText());\n        using var activitiesAfterResponse = await client.GetAsync(\"/api/v1/feeding-activities\");\n        Assert.Equal(HttpStatusCode.OK, activitiesAfterResponse.StatusCode);\n        using var activitiesAfter = await Part2Json.ReadAsync(activitiesAfterResponse);\n        Assert.Equal(beforeActivitiesJson, activitiesAfter.RootElement.GetProperty(\"activities\").GetRawText());\n    }\n}\n\npublic sealed class WeightMeasurementListAcceptanceTests(AppFactory factory) : Part2ApiTestBase(factory)\n{\n    [Fact]\n    public async Task AC_4_1_ReturnsMeasurementsAndTrendsForAllLotsOrOneLot()\n    {\n        using var app = Start();\n        using var client = CreateClient(app);\n        await Part2Data.SeedOperationsAsync(Factory.ConnectionString, seedMeasurements: true);\n\n        using var allResponse = await client.GetAsync(\"/api/v1/weight-measurements\");\n        Assert.Equal(HttpStatusCode.OK, allResponse.StatusCode);\n        using var all = await Part2Json.ReadAsync(allResponse);\n        var allMeasurements = all.RootElement.GetProperty(\"measurements\").EnumerateArray().ToArray();\n        var allTrend = all.RootElement.GetProperty(\"trend\").EnumerateArray().ToArray();\n        Assert.Equal(6, allMeasurements.Length);\n        Assert.NotEmpty(allTrend);\n        Assert.All(allTrend, point => Part2Json.HasProperties(point, \"date\", \"averageWeightLb\"));\n        Assert.Contains(allTrend, point => point.GetProperty(\"date\").GetString() == \"2026-01-31\" && point.GetProperty(\"averageWeightLb\").GetDecimal() is >= 520m and <= 522m);\n        Assert.Contains(allTrend, point => point.GetProperty(\"date\").GetString() == \"2026-02-28\" && point.GetProperty(\"averageWeightLb\").GetDecimal() is >= 560m and <= 562m);\n        foreach (var (lotId, firstAverage, secondAverage) in new[] { (101, 520m, 560m), (102, 521m, 561m), (103, 522m, 562m) })\n        {\n            var lotRows = allMeasurements.Where(row => row.GetProperty(\"lotId\").GetInt32() == lotId).ToArray();\n            Assert.Equal(2, lotRows.Length);\n            Assert.Equal(firstAverage, Assert.Single(lotRows, row => row.GetProperty(\"date\").GetString() == \"2026-01-31\").GetProperty(\"averageWeightLb\").GetDecimal());\n            Assert.Equal(secondAverage, Assert.Single(lotRows, row => row.GetProperty(\"date\").GetString() == \"2026-02-28\").GetProperty(\"averageWeightLb\").GetDecimal());\n        }\n\n        using var lotResponse = await client.GetAsync(\"/api/v1/weight-measurements?lotId=101\");\n        Assert.Equal(HttpStatusCode.OK, lotResponse.StatusCode);\n        using var lot = await Part2Json.ReadAsync(lotResponse);\n        var filtered = lot.RootElement.GetProperty(\"measurements\").EnumerateArray().ToArray();\n        Assert.Equal(2, filtered.Length);\n        Assert.All(filtered, measurement => Assert.Equal(101, measurement.GetProperty(\"lotId\").GetInt32()));\n        var filteredTrend = lot.RootElement.GetProperty(\"trend\").EnumerateArray().ToArray();\n        Assert.Equal(2, filteredTrend.Length);\n        Assert.Equal(520m, Assert.Single(filteredTrend, point => point.GetProperty(\"date\").GetString() == \"2026-01-31\").GetProperty(\"averageWeightLb\").GetDecimal());\n        Assert.Equal(560m, Assert.Single(filteredTrend, point => point.GetProperty(\"date\").GetString() == \"2026-02-28\").GetProperty(\"averageWeightLb\").GetDecimal());\n    }\n}\n\npublic sealed class CreateAndCorrectWeightMeasurementAcceptanceTests(AppFactory factory) : Part2ApiTestBase(factory)\n{\n    [Fact]\n    public async Task AC_4_2_CreatesAndCorrectsMeasurementsWithMetricsAndTrend()\n    {\n        using var app = Start();\n        using var client = CreateClient(app);\n        await Part2Data.SeedOperationsAsync(Factory.ConnectionString);\n        var request = new\n        {\n            lotId = 101,\n            date = \"2026-04-15\",\n            animalsWeighed = 30,\n            averageWeightLb = 610m,\n            totalLotWeightLb = 18300m,\n            gainSincePriorLb = 110m,\n            notes = \"Part two acceptance weighing\"\n        };\n\n        using var create = await client.PostAsJsonAsync(\"/api/v1/weight-measurements\", request);\n        Assert.Equal(HttpStatusCode.Created, create.StatusCode);\n        using var created = await Part2Json.ReadAsync(create);\n        var createdMeasurement = created.RootElement.GetProperty(\"measurement\");\n        var measurementId = createdMeasurement.GetProperty(\"id\").GetInt32();\n        Assert.Equal(101, createdMeasurement.GetProperty(\"lotId\").GetInt32());\n        Assert.Equal(\"Cattle-101\", createdMeasurement.GetProperty(\"lotCode\").GetString());\n        Assert.Equal(\"2026-04-15\", createdMeasurement.GetProperty(\"date\").GetString());\n        Assert.Equal(30, createdMeasurement.GetProperty(\"animalsWeighed\").GetInt32());\n        Assert.Equal(610m, createdMeasurement.GetProperty(\"averageWeightLb\").GetDecimal());\n        Assert.Equal(18300m, createdMeasurement.GetProperty(\"totalLotWeightLb\").GetDecimal());\n        Assert.Equal(110m, createdMeasurement.GetProperty(\"gainSincePriorLb\").GetDecimal());\n        Assert.Equal(\"Part two acceptance weighing\", createdMeasurement.GetProperty(\"notes\").GetString());\n        Assert.Equal(\"Accepted\", createdMeasurement.GetProperty(\"result\").GetString());\n        Part2Json.HasProperties(created.RootElement, \"metrics\", \"trend\");\n        var createdMetrics = created.RootElement.GetProperty(\"metrics\");\n        Assert.Equal(110m, createdMetrics.GetProperty(\"totalGainLb\").GetDecimal());\n        Assert.Equal(110m / 104m, createdMetrics.GetProperty(\"adgLbPerDay\").GetDecimal(), 8);\n        var createdTrend = Assert.Single(created.RootElement.GetProperty(\"trend\").EnumerateArray());\n        Assert.Equal(\"2026-04-15\", createdTrend.GetProperty(\"date\").GetString());\n        Assert.Equal(610m, createdTrend.GetProperty(\"averageWeightLb\").GetDecimal());\n\n        using var correction = await client.PatchAsJsonAsync($\"/api/v1/weight-measurements/{measurementId}\", new\n        {\n            lotId = 101,\n            date = \"2026-04-15\",\n            animalsWeighed = 30,\n            averageWeightLb = 615m,\n            totalLotWeightLb = 18450m,\n            gainSincePriorLb = 115m,\n            notes = \"Corrected acceptance weighing\"\n        });\n        Assert.Equal(HttpStatusCode.OK, correction.StatusCode);\n        using var corrected = await Part2Json.ReadAsync(correction);\n        var correctedMeasurement = corrected.RootElement.GetProperty(\"measurement\");\n        Assert.Equal(measurementId, correctedMeasurement.GetProperty(\"id\").GetInt32());\n        Assert.Equal(101, correctedMeasurement.GetProperty(\"lotId\").GetInt32());\n        Assert.Equal(\"Cattle-101\", correctedMeasurement.GetProperty(\"lotCode\").GetString());\n        Assert.Equal(\"2026-04-15\", correctedMeasurement.GetProperty(\"date\").GetString());\n        Assert.Equal(30, correctedMeasurement.GetProperty(\"animalsWeighed\").GetInt32());\n        Assert.Equal(615m, correctedMeasurement.GetProperty(\"averageWeightLb\").GetDecimal());\n        Assert.Equal(18450m, correctedMeasurement.GetProperty(\"totalLotWeightLb\").GetDecimal());\n        Assert.Equal(115m, correctedMeasurement.GetProperty(\"gainSincePriorLb\").GetDecimal());\n        Assert.Equal(\"Corrected acceptance weighing\", correctedMeasurement.GetProperty(\"notes\").GetString());\n        Assert.Equal(\"Corrected\", correctedMeasurement.GetProperty(\"result\").GetString());\n        Part2Json.HasProperties(corrected.RootElement, \"metrics\", \"trend\");\n        var correctedMetrics = corrected.RootElement.GetProperty(\"metrics\");\n        Assert.Equal(115m, correctedMetrics.GetProperty(\"totalGainLb\").GetDecimal());\n        Assert.Equal(115m / 104m, correctedMetrics.GetProperty(\"adgLbPerDay\").GetDecimal(), 8);\n        var correctedTrend = Assert.Single(corrected.RootElement.GetProperty(\"trend\").EnumerateArray());\n        Assert.Equal(\"2026-04-15\", correctedTrend.GetProperty(\"date\").GetString());\n        Assert.Equal(615m, correctedTrend.GetProperty(\"averageWeightLb\").GetDecimal());\n    }\n}\n\npublic sealed class YardSummaryAcceptanceTests(AppFactory factory) : Part2ApiTestBase(factory)\n{\n    [Fact]\n    public async Task AC_4_3_ReturnsYardTotalsAndActivePenAndLotSummaries()\n    {\n\ninternal static class Part2Json\n{\n    public static async Task<JsonDocument> ReadAsync(HttpResponseMessage response) => JsonDocument.Parse(await response.Content.ReadAsStringAsync());\n\n    public static void HasProperties(JsonElement value, params string[] names)\n    {\n        foreach (var name in names) Assert.True(value.TryGetProperty(name, out _), $\"Expected JSON property '{name}'.\");\n    }\n}\n\ninternal static class Part2Reports\n{\n    public static async Task<JsonDocument> GetDocumentAsync(HttpClient client, string filters)\n    {\n        using var response = await client.GetAsync($\"/api/v1/reports/feed-to-gain?{filters}\");\n        Assert.Equal(HttpStatusCode.OK, response.StatusCode);\n        return await Part2Json.ReadAsync(response);\n    }\n\n    public static async Task<JsonElement[]> GetRowsAsync(HttpClient client, string filters)\n    {\n        using var document = await GetDocumentAsync(client, filters);\n        return document.RootElement.GetProperty(\"rows\").EnumerateArray().Select(row => row.Clone()).ToArray();\n    }\n\n    public static string[] LotCodes(JsonElement[] rows) => rows\n        .Select(row => row.GetProperty(\"lotCode\").GetString()!)\n        .OrderBy(code => code, StringComparer.Ordinal)\n        .ToArray();\n\n    public static void AssertReportContents(string content)\n    {\n        foreach (var lotCode in new[] { \"Cattle-101\", \"Cattle-102\", \"Cattle-103\" }) Assert.Contains(lotCode, content);\n        Assert.DoesNotContain(\"Cattle-104\", content);\n    }\n}\n\ninternal static class Part2Data\n{\n    public const string ProcurementRecordsJson = \"\"\"\n        {\n          \"records\": [\n            { \"sourceId\": \"PO-P2-1\", \"sourceRecordId\": \"REC-P2-1\", \"vendor\": \"Prairie Part Two\", \"costUsd\": 600, \"headCount\": 30, \"averageWeightLb\": 500, \"breed\": \"Angus\", \"ageMonths\": 16, \"sex\": \"Female\" },\n            { \"sourceId\": \"PO-P2-2\", \"sourceRecordId\": \"REC-P2-2\", \"vendor\": \"Prairie Part Two\", \"costUsd\": 400, \"headCount\": 20, \"averageWeightLb\": 510, \"breed\": \"Angus\", \"ageMonths\": 15, \"sex\": \"Female\" },\n            { \"sourceId\": \"PO-P2-3\", \"sourceRecordId\": \"REC-P2-3\", \"vendor\": \"Range Part Two\", \"costUsd\": 300, \"headCount\": 15, \"averageWeightLb\": 490, \"breed\": \"Hereford\", \"ageMonths\": 17, \"sex\": \"Male\" }\n          ]\n        }\n        \"\"\";\n\n    public static async Task SeedOperationsAsync(\n        string connectionString,\n        int totalLots = 3,\n        int matchingLots = 2,\n        decimal openingLb = 5000m,\n        bool seedPlans = true,\n        bool seedMeasurements = false,\n        bool seedPerformanceActivities = false)\n    {\n        await using var connection = await OpenAsync(connectionString);\n        await ExecuteAsync(connection, \"INSERT INTO \\\"Pens\\\" (\\\"id\\\", \\\"name\\\", \\\"capacity\\\") VALUES (1, 'North Pen', 200), (2, 'South Pen', 200)\");\n        await ExecuteAsync(connection, \"\"\"\n            INSERT INTO \"InventoryItems\"\n                (\"id\", \"item\", \"category\", \"supplier\", \"enteredQuantity\", \"enteredUnit\", \"normalizedPounds\", \"cost\", \"costUnit\", \"normalizedCostUsdPerLb\", \"dryMatterPercent\", \"energyMcalPerLb\", \"crudeProteinPercent\", \"tdnPercent\", \"storageLocation\", \"openingLb\")\n            VALUES (401, 'Ground corn', 'Grain', 'Part Two Feed', 5000, 'lb', 5000, 0.20, 'USD per lb', 0.20, 88, 1.5, 8, 85, 'Bin P2', @opening)\n            \"\"\", openingLb);\n        await ExecuteAsync(connection, \"INSERT INTO \\\"Rations\\\" (\\\"id\\\", \\\"name\\\", \\\"rationType\\\", \\\"intendedAnimalRange\\\") VALUES (61, 'Grower 2', 'Grower', '500-900 lb cattle')\");\n        await ExecuteAsync(connection, \"\"\"\n            INSERT INTO \"RationIngredients\" (\"id\", \"rationId\", \"inventoryItemId\", \"name\", \"quantity\", \"enteredUnit\", \"proportionPercent\")\n            VALUES (701, 61, 401, 'Ground corn', 1, 'lb', 100)\n            \"\"\");\n\n        var headCounts = new[] { 30, 20, 25, 10, 12, 14 };\n        for (var index = 0; index < totalLots; index++)\n        {\n            var id = 101 + index;\n            var isMatching = index < matchingLots;\n            var penId = isMatching ? 1 : 2;\n            var breed = isMatching ? \"Angus\" : \"Hereford\";\n            var sex = isMatching ? \"Female\" : \"Male\";\n            var headCount = headCounts[index % headCounts.Length];\n            await ExecuteAsync(connection, \"\"\"\n                INSERT INTO \"Lots\"\n                    (\"id\", \"lotCode\", \"sourceId\", \"sourceRecordId\", \"supplier\", \"receivedDate\", \"breed\", \"sex\", \"receivedHead\", \"purchaseCostAllocation\", \"receivedAverageWeightLb\", \"targetWeightLb\", \"ageMonths\", \"status\")\n                VALUES (@id, @lotCode, @sourceId, @sourceRecordId, 'Part Two Ranch', DATE '2026-01-01', @breed, @sex, @head, 600, 500, 1200, 16, 'Active')\n                \"\"\", id, $\"Cattle-{id}\", $\"SRC-{id}\", $\"REC-{id}\", breed, sex, headCount);\n            await ExecuteAsync(connection, \"INSERT INTO \\\"PenLotAllocations\\\" (\\\"id\\\", \\\"penId\\\", \\\"lotId\\\", \\\"headCount\\\") VALUES (@allocationId, @penId, @lotId, @head)\",\n                1001 + index, penId, id, headCount);\n        }\n\n        if (seedPlans)\n        {\n            for (var index = 0; index < 3; index++)\n            {\n                var planId = 801 + index;\n                var date = new DateTime(2026, 4, 14 + index);\n                await ExecuteAsync(connection, \"\"\"\n                    INSERT INTO \"FeedingPlans\" (\"id\", \"date\", \"penId\", \"rationId\", \"bunkRateLbPerHeadPerDay\", \"plannedHeadCount\", \"feedingTime\", \"status\")\n                    VALUES (@id, @date, 1, 61, 18, 50, TIME '06:30', 'Planned')\n                    \"\"\", planId, date);\n                await ExecuteAsync(connection, \"INSERT INTO \\\"PlanLotAllocations\\\" (\\\"id\\\", \\\"planId\\\", \\\"lotId\\\", \\\"plannedQuantityLb\\\") VALUES (@id1, @planId, 101, 540), (@id2, @planId, 102, 360)\",\n                    9011 + index * 2, planId, 9012 + index * 2);\n            }\n        }\n\n        if (seedMeasurements) await SeedMeasurementsAsync(connection, totalLots);\n        if (seedPerformanceActivities) await SeedPerformanceActivitiesAsync(connection, totalLots);\n    }\n\n    public static async Task SeedReportDataAsync(string connectionString) =>\n        await SeedOperationsAsync(connectionString, totalLots: 4, matchingLots: 3, seedPlans: false, seedMeasurements: true, seedPerformanceActivities: true);\n\n    public static async Task SeedAccountsAsync(string connectionString)\n    {\n        await using var connection = await OpenAsync(connectionString);\n        var rows = new[]\n        {\n            (1, \"Part Two One\", \"Feeding\", \"part2-one@example.test\", \"Operator\"),\n            (2, \"Part Two Two\", \"Operations\", \"part2-two@example.test\", \"Administrator\"),\n            (3, \"Part Two Three\", \"Yard\", \"part2-three@example.test\", \"Operator\")\n        };\n        foreach (var row in rows)\n            await ExecuteAsync(connection, \"\"\"\n                INSERT INTO \"Accounts\" (\"id\", \"name\", \"department\", \"email\", \"passwordHash\", \"role\", \"status\")\n                VALUES (@id, @name, @department, @email, 'part-two-test-hash', @role, 'Active')\n                \"\"\", row.Item1, row.Item2, row.Item3, row.Item4, row.Item5);\n    }\n\n    public static async Task<int> InsertAccountAsync(string connectionString, string name, string department, string email, string role)\n    {\n        await using var connection = await OpenAsync(connectionString);\n        await using var command = new NpgsqlCommand(\"\"\"\n            INSERT INTO \"Accounts\" (\"name\", \"department\", \"email\", \"passwordHash\", \"role\", \"status\")\n            VALUES (@name, @department, @email, 'part-two-test-hash', @role, 'Active')\n            RETURNING \"id\"\n            \"\"\", connection);\n        command.Parameters.AddWithValue(\"name\", name);\n        command.Parameters.AddWithValue(\"department\", department);\n        command.Parameters.AddWithValue(\"email\", email);\n        command.Parameters.AddWithValue(\"role\", role);\n        return (int)(await command.ExecuteScalarAsync() ?? throw new InvalidOperationException(\"Account fixture insert returned no id.\"));\n    }\n\n    public static async Task MoveReportOutlierDatesAsync(string connectionString)\n    {\n        await using var connection = await OpenAsync(connectionString);\n        await ExecuteAsync(connection, \"UPDATE \\\"Lots\\\" SET \\\"receivedDate\\\" = DATE '2026-04-15' WHERE \\\"id\\\" = 104\");\n        await ExecuteAsync(connection, \"UPDATE \\\"WeightMeasurements\\\" SET \\\"date\\\" = DATE '2026-04-16' WHERE \\\"lotId\\\" = 104\");\n        await ExecuteAsync(connection, \"UPDATE \\\"FeedingActivities\\\" SET \\\"date\\\" = DATE '2026-04-17' WHERE \\\"lotId\\\" = 104\");\n    }\n\n    private static async Task SeedMeasurementsAsync(NpgsqlConnection connection, int totalLots)\n    {\n        var dates = new[] { new DateTime(2026, 1, 31), new DateTime(2026, 2, 28), new DateTime(2026, 3, 31) };\n        var weights = new[] { 520m, 560m, 600m };\n        for (var lotIndex = 0; lotIndex < totalLots; lotIndex++)\n        {\n            var lotId = 101 + lotIndex;\n            var animals = new[] { 30, 20, 25, 10, 12, 14 }[lotIndex % 6];\n            for (var measurementIndex = 0; measurementIndex < 2; measurementIndex++)\n            {\n                var average = weights[measurementIndex] + lotIndex;\n                var gain = measurementIndex == 0 ? 20m : 40m;\n                await ExecuteAsync(connection, \"\"\"\n                    INSERT INTO \"WeightMeasurements\"\n                        (\"id\", \"lotId\", \"date\", \"animalsWeighed\", \"averageWeightLb\", \"totalLotWeightLb\", \"gainSincePriorLb\", \"notes\", \"recorder\", \"result\")\n                    VALUES (@id, @lotId, @date, @animals, @average, @total, @gain, @notes, 'Part Two Recorder', 'Accepted')\n                    \"\"\", 1201 + lotIndex * 2 + measurementIndex, lotId, dates[measurementIndex], ... (12201 more characters not kept)","chars":32201,"exitCode":0}
