dAnimalRange: 650-900 lb cattle\n                    dryMatterPercent: 88\n                    energyMcalPerLb: 1.42\n                    costUsdPerLb: 0.19\n                    ingredients:\n                      - name: Ground corn\n                        quantity: 500\n                        enteredUnit: lb\n                        normalizedQuantityLb: 500\n                        proportionPercent: 50\n                        unitCostUsdPerLb: 0.18\n                        totalCostUsd: 90\n        '401':\n          $ref: '#/components/responses/Unauthorized'\n        '403':\n          $ref: '#/components/responses/Forbidden'\n        '500':\n          $ref: '#/components/responses/ServerError'\n    post:\n      operationId: createRation\n      summary: \"Create a ration from ingredient proportions and animal range.\"\n      requestBody:\n        required: true\n        content:\n          application/json:\n            schema:\n              $ref: '#/components/schemas/RationRequest'\n            example:\n              name: Grower 2\n              rationType: Grower\n              intendedAnimalRange: 650-900 lb cattle\n              ingredients:\n                - ingredientId: 401\n                  name: Ground corn\n                  quantity: 500\n                  enteredUnit: lb\n                  proportionPercent: 50\n      responses:\n        '201':\n          description: \"Saved ration and normalized nutrition/cost values.\"\n          content:\n            application/json:\n              schema:\n                $ref: '#/components/schemas/RationResult'\n              example:\n                ration:\n                  id: 61\n                  name: Grower 2\n                  intendedAnimalRange: 650-900 lb cattle\n                  dryMatterPercent: 88\n                  energyMcalPerLb: 1.42\n                  costUsdPerLb: 0.19\n                  ingredients:\n                    - name: Ground corn\n                      quantity: 500\n                      enteredUnit: lb\n                      normalizedQuantityLb: 500\n                      proportionPercent: 50\n                      unitCostUsdPerLb: 0.18\n                      totalCostUsd: 90\n        '400':\n          $ref: '#/components/responses/BadRequest'\n        '401':\n          $ref: '#/components/responses/Unauthorized'\n        '403':\n          $ref: '#/components/responses/Forbidden'\n        '422':\n          $ref: '#/components/responses/ValidationError'\n  /rations/optimization:\n    post:\n      operationId: optimizeRation\n      summary: \"Return candidate mixes for submitted nutrition or animal-range constraints.\"\n      requestBody:\n        required: true\n        content:\n          application/json:\n            schema:\n              $ref: '#/components/schemas/OptimizationRequest'\n            example:\n              intendedAnimalRange: 650-900 lb cattle\n              minimumCrudeProteinPercent: 12\n              minimumTdnPercent: 68\n              maximumCostUsdPerLb: 0.22\n      responses:\n        '200':\n          description: \"Unsaved candidate mixes and their trade-offs.\"\n          content:\n            application/json:\n              schema:\n                $ref: '#/components/schemas/CandidateList'\n              example:\n                candidates:\n                  - id: 71\n                    name: Balanced grower mix\n                    ingredients:\n                      - name: Ground corn\n                        proportionPercent: 55\n                      - name: Alfalfa meal\n                        proportionPercent: 45\n                    costUsdPerLb: 0.2\n                    crudeProteinPercent: 13.1\n                    tdnPercent: 69\n                    netEnergyMcalPerLb: 1.38\n                    tradeoff: Higher protein with a modest cost increase\n                    status: Candidate\n        '400':\n          $ref: '#/components/responses/BadRequest'\n        '401':\n   