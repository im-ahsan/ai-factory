line, \"^    ([A-Za-z0-9]+):$\");\n            if (schemaMatch.Success)\n            {\n                currentSchema = new ContractSchemaShape();\n                schemas.Add(schemaMatch.Groups[1].Value, currentSchema);\n                inProperties = false;\n                inRequired = false;\n                currentProperty = null;\n                continue;\n            }\n            if (currentSchema is null) continue;\n\n            if (line == \"      properties:\")\n            {\n                inProperties = true;\n                inRequired = false;\n                currentProperty = null;\n                continue;\n            }\n            if (line == \"      required:\")\n            {\n                inProperties = false;\n                inRequired = true;\n                currentProperty = null;\n                continue;\n            }\n            if (Regex.IsMatch(line, \"^      [A-Za-z][A-Za-z0-9]*:\"))\n            {\n                inProperties = false;\n                inRequired = false;\n                currentProperty = null;\n            }\n\n            if (line == \"      type: object\") currentSchema.Type = \"object\";\n\n            if (inRequired)\n            {\n                var requiredMatch = Regex.Match(line, \"^        - ([A-Za-z0-9]+)$\");\n                if (requiredMatch.Success) currentSchema.Required.Add(requiredMatch.Groups[1].Value);\n            }\n\n            if (!inProperties) continue;\n            var propertyMatch = Regex.Match(line, \"^        ([A-Za-z0-9]+):$\");\n            if (propertyMatch.Success)\n            {\n                currentProperty = new ContractPropertyShape();\n                currentSchema.Properties.Add(propertyMatch.Groups[1].Value, currentProperty);\n                continue;\n            }\n            if (currentProperty is null) continue;\n            var typeMatch = Regex.Match(line, \"^          type: ([A-Za-z]+)$\");\n            if (typeMatch.Success) currentProperty.Type = typeMatch.Groups[1].Value;\n            var referenceMatch = Regex.Match(line, \"^          \\\\$ref: '([^']+)'$\");\n            if (referenceMatch.Success) currentProperty.Reference = referenceMatch.Groups[1].Value;\n        }\n\n        return schemas;\n    }\n\n    private static string FindContractPath()\n    {\n        foreach (var startingPath in new[] { Directory.GetCurrentDirectory(), AppContext.BaseDirectory })\n        {\n            var directory = new DirectoryInfo(startingPath);\n            while (directory is not null)\n            {\n                var candidate = Path.Combine(directory.FullName, \"contracts\", \"openapi.yaml\");\n                if (File.Exists(candidate)) return candidate;\n                directory = directory.Parent;\n            }\n        }\n        throw new FileNotFoundException(\"Could not find contracts/openapi.yaml from the test working directory.\");\n    }\n\n    private static string RequestPath(string contractPath)\n    {\n        var path = contractPath\n            .Replace(\"{lotId}\", int.MaxValue.ToString(CultureInfo.InvariantCulture), StringComparison.Ordinal)\n            .Replace(\"{candidateId}\", int.MaxValue.ToString(CultureInfo.InvariantCulture), StringComparison.Ordinal)\n            .Replace(\"{activityId}\", int.MaxValue.ToString(CultureInfo.InvariantCulture), StringComparison.Ordinal)\n            .Replace(\"{measurementId}\", int.MaxValue.ToString(CultureInfo.InvariantCulture), StringComparison.Ordinal)\n            .Replace(\"{accountId}\", int.MaxValue.ToString(CultureInfo.InvariantCulture), StringComparison.Ordinal);\n        if (contractPath == \"/reports/feed-to-gain/export\")\n            path += \"?format=csv\";\n        return ApiRoot + path;\n    }\n\n    private static object ContractRequest(string operationId) => operationId switch\n    {\n        \"signIn\" => new { email = \"not-provisioned@example.test\", password = \"invalid-password\" },\n        \"createInventoryReceipt\" => new 