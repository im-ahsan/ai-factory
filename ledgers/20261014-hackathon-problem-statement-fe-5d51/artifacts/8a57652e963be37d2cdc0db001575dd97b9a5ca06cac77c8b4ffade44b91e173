{"ts":1791996907984,"kind":"call","tool":"Bash","input":"{\"command\":\"wc -l App.Tests/AcceptancePart*.cs App.Tests/AppFactory.cs App.Tests/HealthTests.cs; cat App.Tests/App.Tests.csproj; sed -n '1,260p' App.Tests/AcceptancePart1Tests.cs\"}","output":"   717 App.Tests/AcceptancePart1Tests.cs\n   712 App.Tests/AcceptancePart2Tests.cs\n   398 App.Tests/AcceptancePart3Tests.cs\n   535 App.Tests/AcceptancePart4Tests.cs\n    67 App.Tests/AppFactory.cs\n    18 App.Tests/HealthTests.cs\n  2447 total\n<Project Sdk=\"Microsoft.NET.Sdk\">\n  <PropertyGroup>\n    <TargetFramework>net9.0</TargetFramework>\n    <Nullable>enable</Nullable>\n    <ImplicitUsings>enable</ImplicitUsings>\n    <IsPackable>false</IsPackable>\n  </PropertyGroup>\n  <ItemGroup>\n    <PackageReference Include=\"Microsoft.NET.Test.Sdk\" Version=\"17.11.1\" />\n    <PackageReference Include=\"xunit\" Version=\"2.9.2\" />\n    <PackageReference Include=\"xunit.runner.visualstudio\" Version=\"2.8.2\" />\n    <PackageReference Include=\"Microsoft.AspNetCore.Mvc.Testing\" Version=\"9.0.0\" />\n  </ItemGroup>\n  <ItemGroup>\n    <ProjectReference Include=\"../App.Api/App.Api.csproj\" />\n  </ItemGroup>\n</Project>\nusing System.Globalization;\nusing System.Net;\nusing System.Net.Http.Headers;\nusing System.Net.Http.Json;\nusing System.Text.Json;\nusing App.Tests;\nusing Microsoft.AspNetCore.Identity;\nusing Npgsql;\nusing Xunit;\n\nnamespace App.Tests.Part1;\n\npublic sealed class AcceptancePart1Tests : IClassFixture<AppFactory>\n{\n    private const string ApiRoot = \"/api/v1\";\n    private const string TestPassword = \"Part1-test-password-9!\";\n    private static readonly DateTime FixtureDate = new(2026, 1, 15, 0, 0, 0, DateTimeKind.Utc);\n\n    private readonly AppFactory _factory;\n\n    public AcceptancePart1Tests(AppFactory factory) => _factory = factory;\n\n    [Fact]\n    public async Task AC_1_1_OpenApiDocumentListsEveryContractOperationSchemaResponseAndSecurityRule()\n    {\n        using var api = new TestApi(_factory);\n        using var response = await api.Client.GetAsync(\"/openapi/v1.json\");\n        Assert.Equal(HttpStatusCode.OK, response.StatusCode);\n        Assert.Equal(\"application/json\", response.Content.Headers.ContentType?.MediaType);\n\n        using var document = JsonDocument.Parse(await response.Content.ReadAsStringAsync());\n        var root = document.RootElement;\n        Assert.Equal(\"3.0.3\", root.GetProperty(\"openapi\").GetString());\n        Assert.Equal(\"Feedlot Operations API\", root.GetProperty(\"info\").GetProperty(\"title\").GetString());\n        Assert.Equal(\"1.0.0\", root.GetProperty(\"info\").GetProperty(\"version\").GetString());\n        Assert.Equal(\"/api/v1\", root.GetProperty(\"servers\")[0].GetProperty(\"url\").GetString());\n        Assert.Equal(\"bearerAuth\", root.GetProperty(\"security\")[0].EnumerateObject().Single().Name);\n\n        var paths = root.GetProperty(\"paths\");\n        Assert.Equal(Operations.Select(operation => operation.Path).Distinct().Count(), paths.EnumerateObject().Count());\n        foreach (var pathGroup in Operations.GroupBy(operation => operation.Path, StringComparer.Ordinal))\n        {\n            var actualMethods = paths.GetProperty(pathGroup.Key).EnumerateObject()\n                .Where(property => HttpMethods.Contains(property.Name, StringComparer.OrdinalIgnoreCase))\n                .Select(property => property.Name.ToUpperInvariant())\n                .OrderBy(value => value);\n            Assert.Equal(pathGroup.Select(operation => operation.Method).OrderBy(value => value), actualMethods);\n        }\n        foreach (var operation in Operations)\n        {\n            var item = paths.GetProperty(operation.Path);\n            var actual = item.GetProperty(operation.Method.ToLowerInvariant());\n            Assert.Equal(operation.OperationId, actual.GetProperty(\"operationId\").GetString());\n            Assert.Equal(operation.Statuses.OrderBy(value => value), actual.GetProperty(\"responses\").EnumerateObject().Select(property => property.Name).OrderBy(value => value));\n\n            if (operation.RequestSchema is not null)\n            {\n                var requestSchema = actual.GetProperty(\"requestBody\").GetProperty(\"content\").GetProperty(\"application/json\").GetProperty(\"schema\").GetProperty(\"$ref\").GetString();\n                Assert.Equal($\"#/components/schemas/{operation.RequestSchema}\", requestSchema);\n            }\n\n            foreach (var status in operation.Statuses.Where(status => status != operation.SuccessStatus))\n            {\n                var responseName = ContractResponseNames[status];\n                Assert.Equal($\"#/components/responses/{responseName}\", actual.GetProperty(\"responses\").GetProperty(status).GetProperty(\"$ref\").GetString());\n            }\n\n            if (operation.OperationId == \"signIn\")\n            {\n                Assert.True(actual.TryGetProperty(\"security\", out var security));\n                Assert.Empty(security.EnumerateArray());\n            }\n            else\n            {\n                Assert.False(actual.TryGetProperty(\"security\", out _));\n            }\n\n            var success = actual.GetProperty(\"responses\").GetProperty(operation.SuccessStatus);\n            var content = success.GetProperty(\"content\");\n            if (operation.SuccessSchema is not null)\n            {\n                Assert.Equal($\"#/components/schemas/{operation.SuccessSchema}\", content.GetProperty(\"application/json\").GetProperty(\"schema\").GetProperty(\"$ref\").GetString());\n            }\n            else\n            {\n                Assert.Equal(\"string\", content.GetProperty(\"text/csv\").GetProperty(\"schema\").GetProperty(\"type\").GetString());\n                Assert.Equal(\"binary\", content.GetProperty(\"application/pdf\").GetProperty(\"schema\").GetProperty(\"format\").GetString());\n            }\n        }\n\n        var schemas = root.GetProperty(\"components\").GetProperty(\"schemas\");\n        Assert.Equal(ContractSchemaNames.Length, schemas.EnumerateObject().Count());\n        foreach (var schemaName in ContractSchemaNames)\n            Assert.True(schemas.TryGetProperty(schemaName, out _), $\"Missing contract schema {schemaName}.\");\n\n        var responseComponents = root.GetProperty(\"components\").GetProperty(\"responses\");\n        Assert.Equal(ContractResponseNames.Values.Distinct(StringComparer.Ordinal).Count(), responseComponents.EnumerateObject().Count());\n        foreach (var responseName in ContractResponseNames.Values.Distinct(StringComparer.Ordinal))\n        {\n            var responseSchema = responseComponents.GetProperty(responseName).GetProperty(\"content\").GetProperty(\"application/json\").GetProperty(\"schema\").GetProperty(\"$ref\").GetString();\n            Assert.Equal(\"#/components/schemas/ErrorResponse\", responseSchema);\n        }\n\n        var bearer = root.GetProperty(\"components\").GetProperty(\"securitySchemes\").GetProperty(\"bearerAuth\");\n        Assert.Equal(\"http\", bearer.GetProperty(\"type\").GetString());\n        Assert.Equal(\"bearer\", bearer.GetProperty(\"scheme\").GetString());\n        Assert.Equal(\"JWT\", bearer.GetProperty(\"bearerFormat\").GetString());\n    }\n\n    [Fact]\n    public async Task AC_1_2_EveryContractOperationReturnsItsDeclaredAuthenticationErrorWithoutCredentials()\n    {\n        using var api = new TestApi(_factory);\n        foreach (var operation in Operations)\n        {\n            using var request = new HttpRequestMessage(new HttpMethod(operation.Method), RequestPath(operation.Path));\n            if (operation.Method is \"POST\" or \"PATCH\")\n            {\n                request.Content = JsonContent.Create(ContractRequest(operation.OperationId));\n            }\n\n            using var response = await api.Client.SendAsync(request);\n            Assert.Equal(HttpStatusCode.Unauthorized, response.StatusCode);\n            Assert.Equal(\"application/json\", response.Content.Headers.ContentType?.MediaType);\n            using var body = JsonDocument.Parse(await response.Content.ReadAsStringAsync());\n            Assert.Equal(\"Invalid email or password\", body.RootElement.GetProperty(\"error\").GetString());\n            Assert.Equal(\"UNAUTHORIZED\", body.RootElement.GetProperty(\"code\").GetString());\n        }\n\n        using var operatorApi = await CreateAuthenticatedApiAsync(\"Operator\");\n        using var adminRequest = new HttpRequestMessage(HttpMethod.Get, $\"{ApiRoot}/admin/accounts\");\n        using var forbidden = await operatorApi.Client.SendAsync(adminRequest);\n        Assert.Equal(HttpStatusCode.Forbidden, forbidden.StatusCode);\n        Assert.Equal(\"application/json\", forbidden.Content.Headers.ContentType?.MediaType);\n        using var forbiddenBody = JsonDocument.Parse(await forbidden.Content.ReadAsStringAsync());\n        Assert.Equal(\"Administrator access required\", forbiddenBody.RootElement.GetProperty(\"error\").GetString());\n        Assert.Equal(\"FORBIDDEN\", forbiddenBody.RootElement.GetProperty(\"code\").GetString());\n\n        using var administratorApi = await CreateAuthenticatedApiAsync(\"Administrator\");\n        using var allowed = await administratorApi.Client.GetAsync($\"{ApiRoot}/admin/accounts\");\n        Assert.Equal(HttpStatusCode.OK, allowed.StatusCode);\n    }\n\n    [Fact]\n    public async Task AC_1_3_SignInAndOperationalLotResponsesExposeTheirContractFields()\n    {\n        using var api = await CreateAuthenticatedApiAsync(\"Operator\");\n        await InsertLotFixturesAsync(_factory.ConnectionString, 3);\n\n        using var overview = await GetJsonAsync(api.Client, $\"{ApiRoot}/overview\", HttpStatusCode.OK);\n        AssertHasProperties(overview.RootElement, \"headline\", \"activeLots\", \"activePens\", \"lots\", \"inventory\", \"rationFeeding\", \"estimatedEnergyMcal\", \"recentActivity\", \"recentSync\");\n        AssertHasProperties(overview.RootElement.GetProperty(\"headline\"), \"label\", \"value\", \"unit\");\n\n        using var lots = await GetJsonAsync(api.Client, $\"{ApiRoot}/lots\", HttpStatusCode.OK);\n        var lotRows = lots.RootElement.GetProperty(\"lots\").EnumerateArray().ToArray();\n        Assert.True(lotRows.Length >= 3, \"The test created three lots for the list response.\");\n        foreach (var lot in lotRows.Where(row => row.GetProperty(\"lotCode\").GetString()!.StartsWith(\"P1-\", StringComparison.Ordinal)))\n        {\n            AssertHasProperties(lot, \"id\", \"lotCode\", \"sourceId\", \"sourceRecordId\", \"supplier\", \"receivedDate\", \"breed\", \"sex\", \"receivedHead\", \"purchaseCostAllocation\", \"pen\", \"penCapacity\", \"penCount\", \"targetWeightLb\");\n            var lotId = lot.GetProperty(\"id\").GetInt32();\n\n            using var lifecycle = await GetJsonAsync(api.Client, $\"{ApiRoot}/lots/{lotId}/lifecycle\", HttpStatusCode.OK);\n            AssertHasProperties(lifecycle.RootElement, \"lotId\", \"lotCode\", \"receivedDate\", \"targetWeightLb\", \"targetWeightSource\", \"growthAssumption\", \"growthRateLbPerDay\", \"projectedMarketDate\", \"milestones\", \"weightHistory\");\n            Assert.True(lifecycle.RootElement.GetProperty(\"weightHistory\").GetArrayLength() >= 3);\n            foreach (var entry in lifecycle.RootElement.GetProperty(\"weightHistory\").EnumerateArray())\n                AssertHasProperties(entry, \"date\", \"daysOnFeed\", \"averageWeightLb\", \"periodGainLb\", \"periodAdgLbPerDay\", \"operator\", \"status\");\n\n            using var performance = await GetJsonAsync(api.Client, $\"{ApiRoot}/lots/{lotId}/performance\", HttpStatusCode.OK);\n            AssertHasProperties(performance.RootElement, \"lotId\", \"lotCode\", \"refreshedAt\", \"daysOnFeed\", \"totalWeightGainLb\", \"adgLbPerDay\", \"totalAsFedFeedConsumedLb\", \"fcr\", \"feedCostOfGainUsdPerLb\", \"projectedShipDate\", \"events\");\n            Assert.True(performance.RootElement.GetProperty(\"events\").GetArrayLength() >= 3);\n            foreach (var entry in performance.RootElement.GetProperty(\"events\").EnumerateArray())\n                AssertHasProperties(entry, \"date\", \"averageWeightLb\", \"periodGainLb\", \"periodAdgLbPerDay\", \"headCount\", \"operator\", \"status\");\n\n            using var financials = await GetJsonAsync(api.Client, $\"{ApiRoot}/lots/{lotId}/financials\", HttpStatusCode.OK);\n            AssertHasProperties(financials.RootElement, \"lotId\", \"lotCode\", \"feedCostOfGainUsdPerLb\", \"purchaseCostUsd\", \"feedCostUsd\", \"saleRevenueUsd\", \"broaderRoiStatus\", \"broaderRoiUsd\", \"costBreakdown\", \"recommendations\", \"projectedShipDate\", \"targetWeightLb\");\n            foreach (var row in financials.RootElement.GetProperty(\"costBreakdown\").EnumerateArray())\n                AssertHasProperties(row, \"itemDescription\", \"accountingDetail\", \"recordedAmountUsd\", \"status\");\n            foreach (var row in financials.RootElement.GetProperty(\"recommendations\").EnumerateArray())\n                AssertHasProperties(row, \"type\", \"description\");\n        }\n    }\n\n    [Fact]\n    public async Task AC_1_4_UnknownLotLifecycleReturnsContractNotFoundError()\n    {\n        using var api = await CreateAuthenticatedApiAsync(\"Operator\");\n        using var response = await api.Client.GetAsync($\"{ApiRoot}/lots/{int.MaxValue}/lifecycle\");\n        Assert.Equal(HttpStatusCode.NotFound, response.StatusCode);\n        Assert.Equal(\"application/json\", response.Content.Headers.ContentType?.MediaType);\n        using var body = JsonDocument.Parse(await response.Content.ReadAsStringAsync());\n        Assert.Equal(\"Record not found\", body.RootElement.GetProperty(\"error\").GetString());\n        Assert.Equal(\"NOT_FOUND\", body.RootElement.GetProperty(\"code\").GetString());\n    }\n\n    [Fact]\n    public async Task AC_2_1_InventoryAndProjectionsExposeStockMovementsAndAllHorizons()\n    {\n        using var api = await CreateAuthenticatedApiAsync(\"Operator\");\n        var items = await InsertInventoryFixturesAsync(_factory.ConnectionString, \"AC21\", 3, withMovements: true);\n\n        using var inventory = await GetJsonAsync(api.Client, $\"{ApiRoot}/inventory\", HttpStatusCode.OK);\n        var itemRows = inventory.RootElement.GetProperty(\"items\").EnumerateArray().ToArray();\n        var ownItems = itemRows.Where(row => items.Any(item => item.Name == row.GetProperty(\"item\").GetString())).ToArray();\n        Assert.Equal(3, ownItems.Length);\n        foreach (var item in ownItems)\n        {\n            AssertHasProperties(item, \"item\", \"availableQuantity\", \"enteredUnit\", \"normalizedPounds\", \"cost\", \"costUnit\", \"normalizedCostUsdPerLb\", \"openingLb\", \"receivedLb\", \"consumedLb\", \"closingLb\", \"movements\");\n            Assert.True(item.GetProperty(\"movements\").GetArrayLength() >= 2);\n            foreach (var movement in item.GetProperty(\"movements\").EnumerateArray())\n                AssertHasProperties(movement, \"date\", \"type\", \"quantityLb\");\n        }\n\n        using var projections = await GetJsonAsync(api.Client, $\"{ApiRoot}/inventory/projections\", HttpStatusCode.OK);\n        AssertHasProperties(projections.RootElement, \"wastageRatio\", \"projections\", \"movements\");\n        var projectionRows = projections.RootElement.GetProperty(\"projections\").EnumerateArray().ToArray();\n        var ownProjections = projectionRows.Where(row => items.Any(item => item.Name == row.GetProperty(\"ingredient\").GetString())).ToArray();\n        Assert.Equal(3, ownProjections.Length);\n        foreach (var projection in ownProjections)\n            AssertHasProperties(projection, \"ingredient\", \"remainingStockLb\", \"dailyLb\", \"weeklyLb\", \"monthlyLb\", \"quarterlyLb\", \"sixMonthLb\", \"annualLb\");\n        Assert.True(projections.RootElement.GetProperty(\"movements\").GetArrayLength() >= 6);\n    }\n\n    [Fact]\n    public async Task AC_2_2_TonReceiptRetainsEnteredValuesAndReportsNormalizedPrice()\n    {\n        using var api = await CreateAuthenticatedApiAsync(\"Operator\");\n        var item = (await InsertInventoryFixturesAsync(_factory.ConnectionString, \"AC22\", 1, withMovements: false))[0];\n        using var response = await api.Client.PostAsJsonAsync($\"{ApiRoot}/inventory/receipts\", new\n        {\n            itemName = item.Name,\n            supplier = item.Supplier,\n            quantity = 2,\n            enteredUnit = \"ton\",\n            normalizedPounds = 4000,\n            cost = 360,\n            costUnit = \"USD per ton\",\n            receivedDate = \"2026-04-14\"\n        });\n\n        Assert.Equal(HttpStatusCode.Created, response.StatusCode);\n        using var body = JsonDocument.Parse(await response.Content.ReadAsStringAsync());\n        var received = body.RootElement.GetProperty(\"item\");\n        Assert.Equal(2m, received.GetProperty(\"enteredQuantity\").GetDecimal());\n        Assert.Equal(\"ton\", received.GetProperty(\"enteredUnit\").GetString());\n        Assert.Equal(4000m, received.GetProperty(\"normalizedPounds\").GetDecimal());\n        Assert.InRange(received.GetProperty(\"normalizedCostUsdPerLb\").GetDecimal(), 0.1799m, 0.1801m);\n    }\n\n    [Fact]\n    public async Task AC_2_3_SavedRationListIncludesEnteredAndNormalizedIngredientPricing()\n    {\n        using var api = await CreateAuthenticatedApiAsync(\"Operator\");\n        var items = await InsertInventoryFixturesAsync(_factory.ConnectionString, \"AC23\", 3, withMovements: false);\n        var rationNames = new HashSet<string>(StringComparer.Ordinal);\n        for (var index = 0; index < items.Count; index++)\n        {\n            var rationName = $\"Part1 saved ration {Guid.NewGuid():N}\";\n            rationNames.Add(rationName);\n            using var created = await api.Client.PostAsJsonAsync($\"{ApiRoot}/rations\", new\n            {\n","