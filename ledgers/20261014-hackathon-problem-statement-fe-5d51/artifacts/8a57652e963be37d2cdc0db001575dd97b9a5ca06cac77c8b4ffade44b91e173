String, string email, string role, string password)\n    {\n        var hash = new PasswordHasher<object>().HashPassword(new object(), password);\n        await using var connection = new NpgsqlConnection(connectionString);\n        await connection.OpenAsync();\n        var roleValue = role switch\n        {\n            \"Administrator\" => \"'Administrator'\",\n            \"Operator\" => \"'Operator'\",\n            _ => throw new ArgumentOutOfRangeException(nameof(role), role, \"Unsupported contract role.\")\n        };\n        await using var command = new NpgsqlCommand($\"INSERT INTO \\\"Accounts\\\" (\\\"name\\\", \\\"department\\\", \\\"email\\\", \\\"passwordHash\\\", \\\"role\\\", \\\"status\\\") VALUES (@name, @department, @email, @passwordHash, {roleValue}, 'Active')\", connection);\n        command.Parameters.AddWithValue(\"name\", \"Part 1 test account\");\n        command.Parameters.AddWithValue(\"department\", \"Testing\");\n        command.Parameters.AddWithValue(\"email\", email);\n        command.Parameters.AddWithValue(\"passwordHash\", hash);\n        await command.ExecuteNonQueryAsync();\n    }\n\n    private static async Task<List<InventoryFixture>> InsertInventoryFixturesAsync(string connectionString, string label, int count, bool withMovements)\n    {\n        var result = new List<InventoryFixture>();\n        await using var connection = new NpgsqlConnection(connectionString);\n        await connection.OpenAsync();\n        for (var index = 1; index <= count; index++)\n        {\n            var name = $\"{label} feed {index} {Guid.NewGuid():N}\";\n            var supplier = $\"{label} supplier {index}\";\n            await using var insert = new NpgsqlCommand(\"INSERT INTO \\\"InventoryItems\\\" (\\\"item\\\", \\\"category\\\", \\\"supplier\\\", \\\"enteredQuantity\\\", \\\"enteredUnit\\\", \\\"normalizedPounds\\\", \\\"cost\\\", \\\"costUnit\\\", \\\"normalizedCostUsdPerLb\\\", \\\"dryMatterPercent\\\", \\\"energyMcalPerLb\\\", \\\"crudeProteinPercent\\\", \\\"tdnPercent\\\", \\\"storageLocation\\\", \\\"openingLb\\\") VALUES (@item, @category, @supplier, @enteredQuantity, @enteredUnit, @normalizedPounds, @cost, @costUnit, @normalizedCostUsdPerLb, @dryMatterPercent, @energyMcalPerLb, @crudeProteinPercent, @tdnPercent, @storageLocation, @openingLb) RETURNING \\\"id\\\"\", connection);\n            insert.Parameters.AddWithValue(\"item\", name);\n            insert.Parameters.AddWithValue(\"category\", \"Feed\");\n            insert.Parameters.AddWithValue(\"supplier\", supplier);\n            insert.Parameters.AddWithValue(\"enteredQuantity\", 1m);\n            insert.Parameters.AddWithValue(\"enteredUnit\", \"lb\");\n            insert.Parameters.AddWithValue(\"normalizedPounds\", 1m);\n            insert.Parameters.AddWithValue(\"cost\", 0.25m + index / 100m);\n            insert.Parameters.AddWithValue(\"costUnit\", \"USD per lb\");\n            insert.Parameters.AddWithValue(\"normalizedCostUsdPerLb\", 0.25m + index / 100m);\n            insert.Parameters.AddWithValue(\"dryMatterPercent\", 88m - index);\n            insert.Parameters.AddWithValue(\"energyMcalPerLb\", 1.4m + index / 10m);\n            insert.Parameters.AddWithValue(\"crudeProteinPercent\", 12m + index);\n            insert.Parameters.AddWithValue(\"tdnPercent\", 68m + index);\n            insert.Parameters.AddWithValue(\"storageLocation\", $\"Bin {index}\");\n            insert.Parameters.AddWithValue(\"openingLb\", 1000m + index * 100m);\n            var id = (int)(await insert.ExecuteScalarAsync() ?? throw new InvalidOperationException(\"Inventory fixture insert returned no id.\"));\n            result.Add(new InventoryFixture(id, name, supplier));\n\n            if (withMovements)\n            {\n                await InsertMovementAsync(connection, id, \"Receipt\", 500m + index, 1m + index, \"ton\");\n                await InsertMovementAsync(connection, id, \"Feed consumption\", 100m + index, null, null);\n            }\n        }\n        return result;\n    }\n\n    private static async Task InsertMovementAsync(NpgsqlConnection connection, int inventoryItemId, string type, decimal quantityLb, decimal? enteredQuantity, string? enteredUnit)\n    {\n            var movementType = type switch\n            {\n                \"Receipt\" => \"'Receipt'\",\n                \"Feed consumption\" => \"'Feed consumption'\",\n                _ => throw new ArgumentOutOfRangeException(nameof(type), type, \"Unsupported contract movement type.\")\n            };\n            await using var command = new NpgsqlCommand($\"INSERT INTO \\\"InventoryMovements\\\" (\\\"inventoryItemId\\\", \\\"date\\\", \\\"type\\\", \\\"quantityLb\\\", \\\"enteredQuantity\\\", \\\"enteredUnit\\\") VALUES (@inventoryItemId, @date, {movementType}, @quantityLb, @enteredQuantity, @enteredUnit)\", connection);\n        command.Parameters.AddWithValue(\"inventoryItemId\", inventoryItemId);\n        command.Parameters.AddWithValue(\"date\", FixtureDate.Date);\n        command.Parameters.AddWithValue(\"quantityLb\", quantityLb);\n        command.Parameters.AddWithValue(\"enteredQuantity\", enteredQuantity is null ? DBNull.Value : enteredQuantity);\n        command.Parameters.AddWithValue(\"enteredUnit\", enteredUnit is null ? DBNull.Value : enteredUnit);\n        await command.ExecuteNonQueryAsync();\n    }\n\n    private static async Task InsertLotFixturesAsync(string connectionString, int count)\n    {\n        await using var connection = new NpgsqlConnection(connectionString);\n        await connection.OpenAsync();\n        for (var index = 1; index <= count; index++)\n        {\n            var suffix = Guid.NewGuid().ToString(\"N\", CultureInfo.InvariantCulture);\n            var penId = await InsertPenAsync(connection, $\"P1 pen {suffix}\", 100 + index);\n            await using var lotInsert = new NpgsqlCommand(\"INSERT INTO \\\"Lots\\\" (\\\"lotCode\\\", \\\"sourceId\\\", \\\"sourceRecordId\\\", \\\"supplier\\\", \\\"receivedDate\\\", \\\"breed\\\", \\\"sex\\\", \\\"receivedHead\\\", \\\"purchaseCostAllocation\\\", \\\"receivedAverageWeightLb\\\", \\\"targetWeightLb\\\", \\\"ageMonths\\\", \\\"status\\\") VALUES (@lotCode, @sourceId, @sourceRecordId, @supplier, @receivedDate, @breed, @sex, @receivedHead, @purchaseCostAllocation, @receivedAverageWeightLb, @targetWeightLb, @ageMonths, 'Active') RETURNING \\\"id\\\"\", connection);\n            lotInsert.Parameters.AddWithValue(\"lotCode\", $\"P1-{index}-{suffix[..8]}\");\n            lotInsert.Parameters.AddWithValue(\"sourceId\", $\"P1 source {suffix}\");\n            lotInsert.Parameters.AddWithValue(\"sourceRecordId\", $\"P1 record {suffix}\");\n            lotInsert.Parameters.AddWithValue(\"supplier\", $\"P1 supplier {index}\");\n            lotInsert.Parameters.AddWithValue(\"receivedDate\", new DateTime(2026, 1, 1));\n            lotInsert.Parameters.AddWithValue(\"breed\", index % 2 == 0 ? \"Angus\" : \"Hereford\");\n            lotInsert.Parameters.AddWithValue(\"sex\", index % 2 == 0 ? \"Female\" : \"Male\");\n            lotInsert.Parameters.AddWithValue(\"receivedHead\", 30 + index);\n            lotInsert.Parameters.AddWithValue(\"purchaseCostAllocation\", 600m + index * 10m);\n            lotInsert.Parameters.AddWithValue(\"receivedAverageWeightLb\", 600m + index * 10m);\n            lotInsert.Parameters.AddWithValue(\"targetWeightLb\", 1200m + index * 10m);\n            lotInsert.Parameters.AddWithValue(\"ageMonths\", 8 + index);\n            var lotId = (int)(await lotInsert.ExecuteScalarAsync() ?? throw new InvalidOperationException(\"Lot fixture insert returned no id.\"));\n\n            await using var allocation = new NpgsqlCommand(\"INSERT INTO \\\"PenLotAllocations\\\" (\\\"penId\\\", \\\"lotId\\\", \\\"headCount\\\") VALUES (@penId, @lotId, @headCount)\", connection);\n            allocation.Parameters.AddWithValue(\"penId\", penId);\n            allocation.Parameters.AddWithValue(\"lotId\", lotId);\n            allocation.Parameters.AddWithValue(\"headCount\", 30 + index);\n            await allocation.ExecuteNonQueryAsync();\n\n            for (var measurement = 0; measurement < 3; measurement++)\n            {\n                var averageWeight = 650m + index * 10m + measurement * 35m;\n                await using var weight = new NpgsqlCommand(\"INSERT INTO \\\"WeightMeasurements\\\" (\\\"lotId\\\", \\\"date\\\", \\\"animalsWeighed\\\", \\\"averageWeightLb\\\", \\\"totalLotWeightLb\\\", \\\"gainSincePriorLb\\\", \\\"notes\\\", \\\"recorder\\\", \\\"result\\\") VALUES (@lotId, @date, @animalsWeighed, @averageWeightLb, @totalLotWeightLb, @gainSincePriorLb, @notes, @recorder, 'Accepted')\", connection);\n                weight.Parameters.AddWithValue(\"lotId\", lotId);\n                weight.Parameters.AddWithValue(\"date\", new DateTime(2026, 2 + measurement, 1));\n                weight.Parameters.AddWithValue(\"animalsWeighed\", 5 + index);\n                weight.Parameters.AddWithValue(\"averageWeightLb\", averageWeight);\n                weight.Parameters.AddWithValue(\"totalLotWeightLb\", averageWeight * (30 + index));\n                weight.Parameters.AddWithValue(\"gainSincePriorLb\", measurement == 0 ? 0m : 35m);\n                weight.Parameters.AddWithValue(\"notes\", $\"Part 1 fixture measurement {measurement + 1}\");\n                weight.Parameters.AddWithValue(\"recorder\", \"Part 1 tester\");\n                await weight.ExecuteNonQueryAsync();\n            }\n        }\n    }\n\n    private static Task<int> InsertPenAsync(string connectionString, string name, int capacity)\n    {\n        return InsertPenAsync(new NpgsqlConnection(connectionString), name, capacity, ownsConnection: true);\n    }\n\n    private static async Task<int> InsertPenAsync(NpgsqlConnection connection, string name, int capacity)\n    {\n        if (connection.State != System.Data.ConnectionState.Open)\n            await connection.OpenAsync();\n        return await InsertPenAsync(connection, name, capacity, ownsConnection: false);\n    }\n\n    private static async Task<int> InsertPenAsync(NpgsqlConnection connection, string name, int capacity, bool ownsConnection)\n    {\n        try\n        {\n            if (connection.State != System.Data.ConnectionState.Open)\n                await connection.OpenAsync();\n            await using var command = new NpgsqlCommand(\"INSERT INTO \\\"Pens\\\" (\\\"name\\\", \\\"capacity\\\") VALUES (@name, @capacity) RETURNING \\\"id\\\"\", connection);\n            command.Parameters.AddWithValue(\"name\", name);\n            command.Parameters.AddWithValue(\"capacity\", capacity);\n            return (int)(await command.ExecuteScalarAsync() ?? throw new InvalidOperationException(\"Pen fixture insert returned no id.\"));\n        }\n        finally\n        {\n            if (ownsConnection)\n                await connection.DisposeAsync();\n        }\n    }\n\n    private static async Task<JsonDocument> GetJsonAsync(HttpClient client, string path, HttpStatusCode expectedStatus)\n    {\n        using var response = await client.GetAsync(path);\n        Assert.Equal(expectedStatus, response.StatusCode);\n        Assert.Equal(\"application/json\", response.Content.Headers.ContentType?.MediaType);\n        return JsonDocument.Parse(await response.Content.ReadAsStringAsync());\n    }\n\n    private static void AssertHasProperties(JsonElement element, params string[] propertyNames)\n    {\n        Assert.Equal(JsonValueKind.Object, element.ValueKind);\n        foreach (var name in propertyNames)\n            Assert.True(element.TryGetProperty(name, out _), $\"Missing JSON property '{name}'.\");\n    }\n\n    private static Dictionary<string, ContractSchemaShape> ReadContractSchemaShapes()\n    {\n        var contractPath = FindContractPath();\n        var schemas = new Dictionary<string, ContractSchemaShape>(StringComparer.Ordinal);\n        var inSchemas = false;\n        var inProperties = false;\n