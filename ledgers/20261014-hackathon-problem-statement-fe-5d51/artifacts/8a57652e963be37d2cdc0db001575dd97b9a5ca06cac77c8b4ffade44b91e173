{"ts":1791997401448,"kind":"call","tool":"Bash","input":"{\"command\":\"sed -n '555,980p' App.Tests/AcceptancePart2Tests.cs && sed -n '190,260p' App.Tests/AcceptancePart4Tests.cs && sed -n '1,190p' App.Tests/AcceptancePart4Tests.cs\"}","output":"        Assert.True(records.Length >= 3);\n        foreach (var record in records)\n            Part2Json.HasProperties(record, \"sourceId\", \"sourceRecordId\", \"result\", \"targetLots\", \"error\");\n    }\n}\n\npublic sealed class DemoMaterialsAndFlowAcceptanceTests(AppFactory factory) : Part2ApiTestBase(factory)\n{\n    [Fact]\n    public async Task AC_5_4_ReturnsDemoMaterialsAndStartsTheGuidedFlow()\n    {\n        using var app = Start();\n        using var client = CreateClient(app);\n\n        using var materialsResponse = await client.GetAsync(\"/api/v1/admin/demo\");\n        Assert.Equal(HttpStatusCode.OK, materialsResponse.StatusCode);\n        using var materials = await Part2Json.ReadAsync(materialsResponse);\n        Part2Json.HasProperties(materials.RootElement, \"operationalData\", \"rules\", \"sections\");\n        Part2Json.HasProperties(materials.RootElement.GetProperty(\"operationalData\"), \"activeLots\", \"activePens\", \"totalHead\", \"totalFeedCostUsd\");\n        Assert.NotEmpty(materials.RootElement.GetProperty(\"rules\").EnumerateArray());\n        Assert.NotEmpty(materials.RootElement.GetProperty(\"sections\").EnumerateArray());\n\n        using var flowResponse = await client.PostAsJsonAsync(\"/api/v1/admin/demo/flow\", new { start = true });\n        Assert.Equal(HttpStatusCode.OK, flowResponse.StatusCode);\n        using var flow = await Part2Json.ReadAsync(flowResponse);\n        Part2Json.HasProperties(flow.RootElement, \"started\", \"currentStep\", \"stepTitle\", \"status\");\n        Assert.True(flow.RootElement.GetProperty(\"started\").GetBoolean());\n    }\n}\n\npublic sealed class AdminAuthorizationAcceptanceTests(AppFactory factory) : Part2ApiTestBase(factory)\n{\n    [Fact]\n    public async Task AC_5_5_RejectsAnOperatorFromAnAdministratorOperation()\n    {\n        using var app = Start();\n        using var client = CreateClient(app, role: \"Operator\");\n\n        using var response = await client.GetAsync(\"/api/v1/admin/accounts\");\n        Assert.Equal(HttpStatusCode.Forbidden, response.StatusCode);\n        using var document = await Part2Json.ReadAsync(response);\n        Assert.Equal(\"Administrator access required\", document.RootElement.GetProperty(\"error\").GetString());\n        Assert.Equal(\"FORBIDDEN\", document.RootElement.GetProperty(\"code\").GetString());\n    }\n}\n\ninternal static class Part2Host\n{\n    public static WebApplicationFactory<Program> Start(AppFactory factory, IProcurementSource? source)\n    {\n        var restarted = factory.Restarted();\n        return restarted.WithWebHostBuilder(builder => builder.ConfigureTestServices(services =>\n        {\n            services.AddAuthentication(options =>\n            {\n                options.DefaultAuthenticateScheme = Part2AuthHandler.SchemeName;\n                options.DefaultChallengeScheme = Part2AuthHandler.SchemeName;\n                options.DefaultScheme = Part2AuthHandler.SchemeName;\n            }).AddScheme<AuthenticationSchemeOptions, Part2AuthHandler>(Part2AuthHandler.SchemeName, _ => { });\n            if (source is not null)\n            {\n                services.RemoveAll<IProcurementSource>();\n                services.AddSingleton<IProcurementSource>(source);\n            }\n        }));\n    }\n}\n\ninternal sealed class Part2AuthHandler : AuthenticationHandler<AuthenticationSchemeOptions>\n{\n    public const string SchemeName = \"Part2Test\";\n\n    public Part2AuthHandler(IOptionsMonitor<AuthenticationSchemeOptions> options, ILoggerFactory logger, System.Text.Encodings.Web.UrlEncoder encoder)\n        : base(options, logger, encoder) { }\n\n    protected override Task<AuthenticateResult> HandleAuthenticateAsync()\n    {\n        if (!Request.Headers.ContainsKey(\"Authorization\")) return Task.FromResult(AuthenticateResult.NoResult());\n        var role = Request.Headers[\"X-Part2-Role\"].FirstOrDefault() ?? \"Operator\";\n        var claims = new[]\n        {\n            new Claim(ClaimTypes.NameIdentifier, \"1\"),\n            new Claim(ClaimTypes.Name, \"Part Two Test User\"),\n            new Claim(ClaimTypes.Role, role),\n            new Claim(\"role\", role)\n        };\n        var identity = new ClaimsIdentity(claims, SchemeName);\n        var ticket = new AuthenticationTicket(new ClaimsPrincipal(identity), SchemeName);\n        return Task.FromResult(AuthenticateResult.Success(ticket));\n    }\n}\n\ninternal sealed class RecordingProcurementSource(string json) : IProcurementSource\n{\n    private int _callCount;\n    public int CallCount => Volatile.Read(ref _callCount);\n\n    public Task<string> FetchRecordsJsonAsync(CancellationToken cancellationToken)\n    {\n        Interlocked.Increment(ref _callCount);\n        return Task.FromResult(json);\n    }\n}\n\ninternal static class Part2Activity\n{\n    public static object Request(int planId, string date, decimal quantity, decimal firstLotQuantity, decimal secondLotQuantity) => new\n    {\n        planId,\n        date,\n        penId = 1,\n        rationId = 61,\n        bunkRateLbPerHeadPerDay = 18m,\n        headCount = 50,\n        actualQuantityDeliveredLb = quantity,\n        lotAllocations = new[]\n        {\n            new { lotId = 101, deliveredQuantityLb = firstLotQuantity },\n            new { lotId = 102, deliveredQuantityLb = secondLotQuantity }\n        }\n    };\n\n    public static Task<HttpResponseMessage> PostAsync(HttpClient client, int planId, string date, decimal quantity, decimal firstLotQuantity, decimal secondLotQuantity) =>\n        client.PostAsJsonAsync(\"/api/v1/feeding-activities\", Request(planId, date, quantity, firstLotQuantity, secondLotQuantity));\n}\n\ninternal static class Part2Json\n{\n    public static async Task<JsonDocument> ReadAsync(HttpResponseMessage response) => JsonDocument.Parse(await response.Content.ReadAsStringAsync());\n\n    public static void HasProperties(JsonElement value, params string[] names)\n    {\n        foreach (var name in names) Assert.True(value.TryGetProperty(name, out _), $\"Expected JSON property '{name}'.\");\n    }\n}\n\ninternal static class Part2Reports\n{\n    public static async Task<JsonDocument> GetDocumentAsync(HttpClient client, string filters)\n    {\n        using var response = await client.GetAsync($\"/api/v1/reports/feed-to-gain?{filters}\");\n        Assert.Equal(HttpStatusCode.OK, response.StatusCode);\n        return await Part2Json.ReadAsync(response);\n    }\n\n    public static async Task<JsonElement[]> GetRowsAsync(HttpClient client, string filters)\n    {\n        using var document = await GetDocumentAsync(client, filters);\n        return document.RootElement.GetProperty(\"rows\").EnumerateArray().Select(row => row.Clone()).ToArray();\n    }\n\n    public static string[] LotCodes(JsonElement[] rows) => rows\n        .Select(row => row.GetProperty(\"lotCode\").GetString()!)\n        .OrderBy(code => code, StringComparer.Ordinal)\n        .ToArray();\n\n    public static void AssertReportContents(string content)\n    {\n        foreach (var lotCode in new[] { \"Cattle-101\", \"Cattle-102\", \"Cattle-103\" }) Assert.Contains(lotCode, content);\n        Assert.DoesNotContain(\"Cattle-104\", content);\n    }\n}\n\ninternal static class Part2Data\n{\n    public const string ProcurementRecordsJson = \"\"\"\n        {\n          \"records\": [\n            { \"sourceId\": \"PO-P2-1\", \"sourceRecordId\": \"REC-P2-1\", \"vendor\": \"Prairie Part Two\", \"costUsd\": 600, \"headCount\": 30, \"averageWeightLb\": 500, \"breed\": \"Angus\", \"ageMonths\": 16, \"sex\": \"Female\" },\n            { \"sourceId\": \"PO-P2-2\", \"sourceRecordId\": \"REC-P2-2\", \"vendor\": \"Prairie Part Two\", \"costUsd\": 400, \"headCount\": 20, \"averageWeightLb\": 510, \"breed\": \"Angus\", \"ageMonths\": 15, \"sex\": \"Female\" },\n            { \"sourceId\": \"PO-P2-3\", \"sourceRecordId\": \"REC-P2-3\", \"vendor\": \"Range Part Two\", \"costUsd\": 300, \"headCount\": 15, \"averageWeightLb\": 490, \"breed\": \"Hereford\", \"ageMonths\": 17, \"sex\": \"Male\" }\n          ]\n        }\n        \"\"\";\n\n    public static async Task SeedOperationsAsync(\n        string connectionString,\n        int totalLots = 3,\n        int matchingLots = 2,\n        decimal openingLb = 5000m,\n        bool seedPlans = true,\n        bool seedMeasurements = false,\n        bool seedPerformanceActivities = false)\n    {\n        await using var connection = await OpenAsync(connectionString);\n        await ExecuteAsync(connection, \"INSERT INTO \\\"Pens\\\" (\\\"id\\\", \\\"name\\\", \\\"capacity\\\") VALUES (1, 'North Pen', 200), (2, 'South Pen', 200)\");\n        await ExecuteAsync(connection, \"\"\"\n            INSERT INTO \"InventoryItems\"\n                (\"id\", \"item\", \"category\", \"supplier\", \"enteredQuantity\", \"enteredUnit\", \"normalizedPounds\", \"cost\", \"costUnit\", \"normalizedCostUsdPerLb\", \"dryMatterPercent\", \"energyMcalPerLb\", \"crudeProteinPercent\", \"tdnPercent\", \"storageLocation\", \"openingLb\")\n            VALUES (401, 'Ground corn', 'Grain', 'Part Two Feed', 5000, 'lb', 5000, 0.20, 'USD per lb', 0.20, 88, 1.5, 8, 85, 'Bin P2', @opening)\n            \"\"\", openingLb);\n        await ExecuteAsync(connection, \"INSERT INTO \\\"Rations\\\" (\\\"id\\\", \\\"name\\\", \\\"rationType\\\", \\\"intendedAnimalRange\\\") VALUES (61, 'Grower 2', 'Grower', '500-900 lb cattle')\");\n        await ExecuteAsync(connection, \"\"\"\n            INSERT INTO \"RationIngredients\" (\"id\", \"rationId\", \"inventoryItemId\", \"name\", \"quantity\", \"enteredUnit\", \"proportionPercent\")\n            VALUES (701, 61, 401, 'Ground corn', 1, 'lb', 100)\n            \"\"\");\n\n        var headCounts = new[] { 30, 20, 25, 10, 12, 14 };\n        for (var index = 0; index < totalLots; index++)\n        {\n            var id = 101 + index;\n            var isMatching = index < matchingLots;\n            var penId = isMatching ? 1 : 2;\n            var breed = isMatching ? \"Angus\" : \"Hereford\";\n            var sex = isMatching ? \"Female\" : \"Male\";\n            var headCount = headCounts[index % headCounts.Length];\n            await ExecuteAsync(connection, \"\"\"\n                INSERT INTO \"Lots\"\n                    (\"id\", \"lotCode\", \"sourceId\", \"sourceRecordId\", \"supplier\", \"receivedDate\", \"breed\", \"sex\", \"receivedHead\", \"purchaseCostAllocation\", \"receivedAverageWeightLb\", \"targetWeightLb\", \"ageMonths\", \"status\")\n                VALUES (@id, @lotCode, @sourceId, @sourceRecordId, 'Part Two Ranch', DATE '2026-01-01', @breed, @sex, @head, 600, 500, 1200, 16, 'Active')\n                \"\"\", id, $\"Cattle-{id}\", $\"SRC-{id}\", $\"REC-{id}\", breed, sex, headCount);\n            await ExecuteAsync(connection, \"INSERT INTO \\\"PenLotAllocations\\\" (\\\"id\\\", \\\"penId\\\", \\\"lotId\\\", \\\"headCount\\\") VALUES (@allocationId, @penId, @lotId, @head)\",\n                1001 + index, penId, id, headCount);\n        }\n\n        if (seedPlans)\n        {\n            for (var index = 0; index < 3; index++)\n            {\n                var planId = 801 + index;\n                var date = new DateTime(2026, 4, 14 + index);\n                await ExecuteAsync(connection, \"\"\"\n                    INSERT INTO \"FeedingPlans\" (\"id\", \"date\", \"penId\", \"rationId\", \"bunkRateLbPerHeadPerDay\", \"plannedHeadCount\", \"feedingTime\", \"status\")\n                    VALUES (@id, @date, 1, 61, 18, 50, TIME '06:30', 'Planned')\n                    \"\"\", planId, date);\n                await ExecuteAsync(connection, \"INSERT INTO \\\"PlanLotAllocations\\\" (\\\"id\\\", \\\"planId\\\", \\\"lotId\\\", \\\"plannedQuantityLb\\\") VALUES (@id1, @planId, 101, 540), (@id2, @planId, 102, 360)\",\n                    9011 + index * 2, planId, 9012 + index * 2);\n            }\n        }\n\n        if (seedMeasurements) await SeedMeasurementsAsync(connection, totalLots);\n        if (seedPerformanceActivities) await SeedPerformanceActivitiesAsync(connection, totalLots);\n    }\n\n    public static async Task SeedReportDataAsync(string connectionString) =>\n        await SeedOperationsAsync(connectionString, totalLots: 4, matchingLots: 3, seedPlans: false, seedMeasurements: true, seedPerformanceActivities: true);\n\n    public static async Task SeedAccountsAsync(string connectionString)\n    {\n        await using var connection = await OpenAsync(connectionString);\n        var rows = new[]\n        {\n            (1, \"Part Two One\", \"Feeding\", \"part2-one@example.test\", \"Operator\"),\n            (2, \"Part Two Two\", \"Operations\", \"part2-two@example.test\", \"Administrator\"),\n            (3, \"Part Two Three\", \"Yard\", \"part2-three@example.test\", \"Operator\")\n        };\n        foreach (var row in rows)\n            await ExecuteAsync(connection, \"\"\"\n                INSERT INTO \"Accounts\" (\"id\", \"name\", \"department\", \"email\", \"passwordHash\", \"role\", \"status\")\n                VALUES (@id, @name, @department, @email, 'part-two-test-hash', @role, 'Active')\n                \"\"\", row.Item1, row.Item2, row.Item3, row.Item4, row.Item5);\n    }\n\n    public static async Task<int> InsertAccountAsync(string connectionString, string name, string department, string email, string role)\n    {\n        await using var connection = await OpenAsync(connectionString);\n        await using var command = new NpgsqlCommand(\"\"\"\n            INSERT INTO \"Accounts\" (\"name\", \"department\", \"email\", \"passwordHash\", \"role\", \"status\")\n            VALUES (@name, @department, @email, 'part-two-test-hash', @role, 'Active')\n            RETURNING \"id\"\n            \"\"\", connection);\n        command.Parameters.AddWithValue(\"name\", name);\n        command.Parameters.AddWithValue(\"department\", department);\n        command.Parameters.AddWithValue(\"email\", email);\n        command.Parameters.AddWithValue(\"role\", role);\n        return (int)(await command.ExecuteScalarAsync() ?? throw new InvalidOperationException(\"Account fixture insert returned no id.\"));\n    }\n\n    public static async Task MoveReportOutlierDatesAsync(string connectionString)\n    {\n        await using var connection = await OpenAsync(connectionString);\n        await ExecuteAsync(connection, \"UPDATE \\\"Lots\\\" SET \\\"receivedDate\\\" = DATE '2026-04-15' WHERE \\\"id\\\" = 104\");\n        await ExecuteAsync(connection, \"UPDATE \\\"WeightMeasurements\\\" SET \\\"date\\\" = DATE '2026-04-16' WHERE \\\"lotId\\\" = 104\");\n        await ExecuteAsync(connection, \"UPDATE \\\"FeedingActivities\\\" SET \\\"date\\\" = DATE '2026-04-17' WHERE \\\"lotId\\\" = 104\");\n    }\n\n    private static async Task SeedMeasurementsAsync(NpgsqlConnection connection, int totalLots)\n    {\n        var dates = new[] { new DateTime(2026, 1, 31), new DateTime(2026, 2, 28), new DateTime(2026, 3, 31) };\n        var weights = new[] { 520m, 560m, 600m };\n        for (var lotIndex = 0; lotIndex < totalLots; lotIndex++)\n        {\n            var lotId = 101 + lotIndex;\n            var animals = new[] { 30, 20, 25, 10, 12, 14 }[lotIndex % 6];\n            for (var measurementIndex = 0; measurementIndex < 2; measurementIndex++)\n            {\n                var average = weights[measurementIndex] + lotIndex;\n                var gain = measurementIndex == 0 ? 20m : 40m;\n                await ExecuteAsync(connection, \"\"\"\n                    INSERT INTO \"WeightMeasurements\"\n                        (\"id\", \"lotId\", \"date\", \"animalsWeighed\", \"averageWeightLb\", \"totalLotWeightLb\", \"gainSincePriorLb\", \"notes\", \"recorder\", \"result\")\n                    VALUES (@id, @lotId, @date, @animals, @average, @total, @gain, @notes, 'Part Two Recorder', 'Accepted')\n                    \"\"\", 1201 + lotIndex * 2 + measurementIndex, lotId, dates[measurementIndex], animals, average, average * animals, gain, $\"Part two weigh {lotId}-{measurementIndex}\");\n            }\n        }\n    }\n\n    private static async Task SeedPerformanceActivitiesAsync(NpgsqlConnection connection, int totalLots)\n    {\n        for (var lotIndex = 0; lotIndex < totalLots; lotIndex++)\n        {\n            var id = 1401 + lotIndex;\n            var lotId = 101 + lotIndex;\n            var penId = lotIndex < 3 ? 1 : 2;\n            var headCount = new[] { 30, 20, 25, 10, 12, 14 }[lotIndex % 6];\n            var groupId = Guid.Parse($\"00000000-0000-0000-0000-{id:D12}\");\n            var date = new DateTime(2026, 3, 15);\n            await ExecuteAsync(connection, \"\"\"\n                INSERT INTO \"FeedingActivities\"\n                    (\"id\", \"activityGroupId\", \"planId\", \"date\", \"penId\", \"rationId\", \"lotId\", \"bunkRateLbPerHeadPerDay\", \"headCount\", \"plannedQuantityLb\", \"actualQuantityLb\", \"status\", \"planMismatch\")\n                VALUES (@id, @group, NULL, @date, @penId, 61, @lotId, 18, @head, 400, 400, 'Completed', FALSE)\n                \"\"\", id, groupId, date, penId, lotId, headCount);\n            await ExecuteAsync(connection, \"\"\"\n                INSERT INTO \"InventoryMovements\" (\"id\", \"inventoryItemId\", \"date\", \"type\", \"quantityLb\", \"enteredQuantity\", \"enteredUnit\", \"activityGroupId\")\n                VALUES (@id, 401, @date, 'Feed consumption', 400, NULL, NULL, @group)\n                \"\"\", 1601 + lotIndex, date, groupId);\n        }\n    }\n\n    private static async Task<NpgsqlConnection> OpenAsync(string connectionString)\n    {\n        var connection = new NpgsqlConnection(connectionString);\n        await connection.OpenAsync();\n        return connection;\n    }\n\n    private static async Task ExecuteAsync(NpgsqlConnection connection, string sql, params object?[] values)\n    {\n        await using var command = new NpgsqlCommand(sql, connection);\n        var names = Regex.Matches(sql, @\"@[A-Za-z_][A-Za-z0-9_]*\").Select(match => match.Value).Distinct().ToArray();\n        if (names.Length != values.Length) throw new InvalidOperationException($\"Expected {names.Length} SQL values but received {values.Length}.\");\n        for (var index = 0; index < values.Length; index++) command.Parameters.AddWithValue(names[index][1..], values[index] ?? DBNull.Value);\n        await command.ExecuteNonQueryAsync();\n    }\n}\n    {\n        using var app = await RunningApi.StartAsync(_fixture);\n        var setup = await CreateFeedingSetupAsync(app, \"AC13 Ground corn\", openingLb: 10000, rationQuantity: 2);\n\n        using var postResponse = await PostActivityAsync(app, setup, 1000,\n            (setup.Lots[0].Id, 600), (setup.Lots[1].Id, 400));\n        using var posted = await ReadJsonAsync(postResponse, HttpStatusCode.Created);\n        var postAllocations = posted.RootElement.GetProperty(\"activity\").GetProperty(\"lotAllocations\").EnumerateArray().ToArray();\n        AssertAllocationShares(postAllocations, setup.Lots, (600, 400), \"deliveredQuantityLb\");\n\n        using var listResponse = await app.Client.GetAsync(\"/api/v1/feeding-activities\");\n        using var list = await ReadJsonAsync(listResponse, HttpStatusCode.OK);\n        var matching = list.RootElement.GetProperty(\"activities\").EnumerateArray()\n            .Where(row => Text(row, \"ration\") == setup.RationName && Text(row, \"date\") == ActivityDate.ToString(\"yyyy-MM-dd\"))\n            .ToArray();\n        Assert.Equal(2, matching.Length);\n\n        var byLot = new Dictionary<int, double>();\n        foreach (var activity in matching)\n        {\n            var activityAllocations = activity.GetProperty(\"lotAllocations\").EnumerateArray().ToArray();\n            Assert.Single(activityAllocations);\n            var allocation = activityAllocations[0];\n            var lotId = (int)Number(allocation, \"lotId\");\n            Assert.Contains(setup.Lots, lot => lot.Id == lotId);\n            var share = Number(allocation, \"deliveredQuantityLb\");\n            Assert.Equal(share, Number(activity, \"actualQuantityLb\"));\n            Assert.DoesNotContain(byLot.Keys, existingLotId => existingLotId == lotId);\n            byLot.Add(lotId, share);\n        }\n        Assert.Equal(2, byLot.Count);\n        Assert.Equal(1000d, matching.Sum(row => Number(row, \"actualQuantityLb\")));\n        Assert.Equal(1000d, byLot.Values.Sum());\n        Assert.Equal(600d, byLot[setup.Lots[0].Id]);\n        Assert.Equal(400d, byLot[setup.Lots[1].Id]);\n    }\n\n    [Fact]\n    public async Task AC_16_2_OpenApiPathsContainApiOperationsOnly()\n    {\n        using var app = await RunningApi.StartAsync(_fixture);\n\n        using var response = await app.Client.GetAsync(\"/openapi/v1.json\");\n        using var document = await ReadJsonAsync(response, HttpStatusCode.OK);\n        var paths = document.RootElement.GetProperty(\"paths\").EnumerateObject().ToArray();\n        Assert.NotEmpty(paths);\n\n        va... (11307 more characters not kept)","chars":31307,"exitCode":0}
