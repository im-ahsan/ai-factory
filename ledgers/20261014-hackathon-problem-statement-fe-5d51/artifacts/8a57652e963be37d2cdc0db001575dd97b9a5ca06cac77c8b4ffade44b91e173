operty(\"inventoryConsumption\"), \"Ground corn\", \"ingredient\");\n        Assert.Equal(500d, Number(postedConsumption, \"quantityLb\"));\n\n        using var rationResponse = await app.Client.GetAsync(\"/api/v1/rations\");\n        using var rationList = await ReadJsonAsync(rationResponse, HttpStatusCode.OK);\n        var ration = SingleByName(rationList.RootElement.GetProperty(\"rations\"), setup.RationName, \"name\");\n        var ingredient = SingleByName(ration.GetProperty(\"ingredients\"), \"Ground corn\", \"name\");\n        Assert.Equal(1.5d, Number(ingredient, \"quantity\"));\n        Assert.Equal(\"ton\", Text(ingredient, \"enteredUnit\"));\n        Assert.Equal(3000d, Number(ingredient, \"normalizedQuantityLb\"));\n\n        using var inventoryResponse = await app.Client.GetAsync(\"/api/v1/inventory\");\n        using var inventory = await ReadJsonAsync(inventoryResponse, HttpStatusCode.OK);\n        var item = SingleByName(inventory.RootElement.GetProperty(\"items\"), \"Ground corn\", \"item\");\n        Assert.Equal(6500d, Number(item, \"closingLb\"));\n        Assert.Equal(500d, Number(item, \"consumedLb\"));\n\n        using var activitiesResponse = await app.Client.GetAsync(\"/api/v1/feeding-activities\");\n        using var activities = await ReadJsonAsync(activitiesResponse, HttpStatusCode.OK);\n        Assert.Contains(activities.RootElement.GetProperty(\"activities\").EnumerateArray(), row =>\n            Text(row, \"ration\") == setup.RationName && Number(row, \"actualQuantityLb\") == 500d);\n    }\n\n    [Fact]\n    public async Task AC_12_1_AttributesDeliveredFeedAndRollupsToEachLot()\n    {\n        using var app = await RunningApi.StartAsync(createAdmin: true);\n        var setup = await CreateFeedingSetupAsync(app, \"Ground corn\", openingLb: 10000, rationQuantity: 2);\n\n        using var response = await PostActivityAsync(app, setup, 950,\n            (setup.Lots[0].Id, 570), (setup.Lots[1].Id, 380));\n        using var document = await 