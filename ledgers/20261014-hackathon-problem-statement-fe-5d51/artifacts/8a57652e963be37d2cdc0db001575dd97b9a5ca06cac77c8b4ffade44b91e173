t.Equal(\"2026-01-01\", lot.GetProperty(\"receivedDate\").GetString());\n            Assert.Equal(\"P1 supplier \" + lot.GetProperty(\"lotCode\").GetString()!.Split('-')[1], lot.GetProperty(\"supplier\").GetString());\n            Assert.Equal(30 + int.Parse(lot.GetProperty(\"lotCode\").GetString()!.Split('-')[1], CultureInfo.InvariantCulture), lot.GetProperty(\"receivedHead\").GetInt32());\n            Assert.Equal(600m + int.Parse(lot.GetProperty(\"lotCode\").GetString()!.Split('-')[1], CultureInfo.InvariantCulture) * 10m, lot.GetProperty(\"purchaseCostAllocation\").GetDecimal());\n            Assert.Equal(1200m + int.Parse(lot.GetProperty(\"lotCode\").GetString()!.Split('-')[1], CultureInfo.InvariantCulture) * 10m, lot.GetProperty(\"targetWeightLb\").GetDecimal());\n            var lotId = lot.GetProperty(\"id\").GetInt32();\n\n            using var lifecycle = await GetJsonAsync(api.Client, $\"{ApiRoot}/lots/{lotId}/lifecycle\", HttpStatusCode.OK);\n            AssertHasProperties(lifecycle.RootElement, \"lotId\", \"lotCode\", \"receivedDate\", \"targetWeightLb\", \"targetWeightSource\", \"growthAssumption\", \"growthRateLbPerDay\", \"projectedMarketDate\", \"milestones\", \"weightHistory\");\n            Assert.Equal(lotId, lifecycle.RootElement.GetProperty(\"lotId\").GetInt32());\n            Assert.Equal(lot.GetProperty(\"lotCode\").GetString(), lifecycle.RootElement.GetProperty(\"lotCode\").GetString());\n            Assert.Equal(lot.GetProperty(\"targetWeightLb\").GetDecimal(), lifecycle.RootElement.GetProperty(\"targetWeightLb\").GetDecimal());\n            Assert.NotEmpty(lifecycle.RootElement.GetProperty(\"milestones\").EnumerateArray());\n            Assert.True(lifecycle.RootElement.GetProperty(\"weightHistory\").GetArrayLength() >= 3);\n            foreach (var entry in lifecycle.RootElement.GetProperty(\"weightHistory\").EnumerateArray())\n                AssertHasProperties(entry, \"date\", \"daysOnFeed\", \"averageWeightLb\", \"periodGainLb\", \"periodAdgLbPerDay\", \"operator\", \"status\");\n\n            using var performance = await GetJsonAsync(api.Client, $\"{ApiRoot}/lots/{lotId}/performance\", HttpStatusCode.OK);\n            AssertHasProperties(performance.RootElement, \"lotId\", \"lotCode\", \"refreshedAt\", \"daysOnFeed\", \"totalWeightGainLb\", \"adgLbPerDay\", \"totalAsFedFeedConsumedLb\", \"fcr\", \"feedCostOfGainUsdPerLb\", \"projectedShipDate\", \"events\");\n            Assert.Equal(lotId, performance.RootElement.GetProperty(\"lotId\").GetInt32());\n            Assert.Equal(lot.GetProperty(\"lotCode\").GetString(), performance.RootElement.GetProperty(\"lotCode\").GetString());\n            Assert.True(performance.RootElement.GetProperty(\"events\").GetArrayLength() >= 3);\n            foreach (var entry in performance.RootElement.GetProperty(\"events\").EnumerateArray())\n                AssertHasProperties(entry, \"date\", \"averageWeightLb\", \"periodGainLb\", \"periodAdgLbPerDay\", \"headCount\", \"operator\", \"status\");\n\n            using var financials = await GetJsonAsync(api.Client, $\"{ApiRoot}/lots/{lotId}/financials\", HttpStatusCode.OK);\n            AssertHasProperties(financials.RootElement, \"lotId\", \"lotCode\", \"feedCostOfGainUsdPerLb\", \"purchaseCostUsd\", \"feedCostUsd\", \"saleRevenueUsd\", \"broaderRoiStatus\", \"broaderRoiUsd\", \"costBreakdown\", \"recommendations\", \"projectedShipDate\", \"targetWeightLb\");\n            Assert.Equal(lotId, financials.RootElement.GetProperty(\"lotId\").GetInt32());\n            Assert.Equal(lot.GetProperty(\"lotCode\").GetString(), financials.RootElement.GetProperty(\"lotCode\").GetString());\n            Assert.Equal(lot.GetProperty(\"purchaseCostAllocation\").GetDecimal(), financials.RootElement.GetProperty(\"purchaseCostUsd\").GetDecimal());\n            Assert.Equal(lot.GetProperty(\"targetWeightLb\").GetDecimal(), financials.RootElement.GetProperty(\"targetWeightLb\").GetDecimal());\n            Assert.NotEmpty(financials.RootElement.GetProperty(\"costBreakdown\").EnumerateArray());\n            Assert.NotEmpty(financials.RootElement.GetProperty(\"recommendations\").EnumerateArray());\n            foreach (var row in financials.RootElement.GetProperty(\"costBreakdown\").EnumerateArray())\n                AssertHasProperties(row, \"itemDescription\", \"accountingDetail\", \"recordedAmountUsd\", \"status\");\n            foreach (var row in financials.RootElement.GetProperty(\"recommendations\").EnumerateArray())\n                AssertHasProperties(row, \"type\", \"description\");\n        }\n    }\n\n    [Fact]\n    public async Task AC_1_4_UnknownLotLifecycleReturnsContractNotFoundError()\n    {\n        using var api = await CreateAuthenticatedApiAsync(\"Operator\");\n        using var response = await api.Client.GetAsync($\"{ApiRoot}/lots/{int.MaxValue}/lifecycle\");\n        Assert.Equal(HttpStatusCode.NotFound, response.StatusCode);\n        Assert.Equal(\"application/json\", response.Content.Headers.ContentType?.MediaType);\n        using var body = JsonDocument.Parse(await response.Content.ReadAsStringAsync());\n        Assert.Equal(\"Record not found\", body.RootElement.GetProperty(\"error\").GetString());\n        Assert.Equal(\"NOT_FOUND\", body.RootElement.GetProperty(\"code\").GetString());\n    }\n\n    [Fact]\n    public async Task AC_2_1_InventoryAndProjectionsExposeStockMovementsAndAllHorizons()\n    {\n        using var api = await CreateAuthenticatedApiAsync(\"Operator\");\n        var items = await InsertInventoryFixturesAsync(_factory.ConnectionString, \"AC21\", 3, withMovements: true);\n\n        using var inventory = await GetJsonAsync(api.Client, $\"{ApiRoot}/inventory\", HttpStatusCode.OK);\n        var itemRows = inventory.RootElement.GetProperty(\"items\").EnumerateArray().ToArray();\n        var ownItems = itemRows.Where(row => items.Any(item => item.Name == row.GetProperty(\"item\").GetString())).ToArray();\n        Assert.Equal(3, ownItems.Length);\n      