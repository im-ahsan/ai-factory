n        {\n            intendedAnimalRange = \"650-900 lb cattle\",\n            minimumCrudeProteinPercent = 12,\n            minimumTdnPercent = 68,\n            maximumCostUsdPerLb = 0.22\n        });\n\n        Assert.Equal(HttpStatusCode.OK, response.StatusCode);\n        using var body = JsonDocument.Parse(await response.Content.ReadAsStringAsync());\n        var candidates = body.RootElement.GetProperty(\"candidates\").EnumerateArray().ToArray();\n        Assert.NotEmpty(candidates);\n        foreach (var candidate in candidates)\n        {\n            AssertHasProperties(candidate, \"id\", \"name\", \"ingredients\", \"costUsdPerLb\", \"crudeProteinPercent\", \"tdnPercent\", \"netEnergyMcalPerLb\", \"tradeoff\", \"status\");\n            Assert.Equal(\"Candidate\", candidate.GetProperty(\"status\").GetString());\n            Assert.NotEmpty(candidate.GetProperty(\"ingredients\").EnumerateArray());\n            foreach (var ingredient in candidate.GetProperty(\"ingredients\").EnumerateArray())\n                AssertHasProperties(ingredient, \"name\", \"proportionPercent\");\n        }\n    }\n\n    [Fact]\n    public async Task AC_2_6_ExplicitCandidateSaveAndAssignReturnTheRequestedIdAndStatus()\n    {\n        using var api = await CreateAuthenticatedApiAsync(\"Operator\");\n        await InsertInventoryFixturesAsync(_factory.ConnectionString, \"AC26\", 3, withMovements: false);\n        var penId = await InsertPenAsync(_factory.ConnectionString, $\"Part1 assignment pen {Guid.NewGuid():N}\", 100);\n        using var optimized = await api.Client.PostAsJsonAsync($\"{ApiRoot}/rations/optimization\", new\n        {\n            intendedAnimalRange = \"650-900 lb cattle\",\n            minimumCrudeProteinPercent = 12,\n            minimumTdnPercent = 68,\n            maximumCostUsdPerLb = 0.22\n        });\n        Assert.Equal(HttpStatusCode.OK, optimized.StatusCode);\n        using var candidatesDocument = JsonDocument.Parse(await optimized.Content.ReadAsStringAsync());\n        var candidates = candidatesDocument.RootElement.GetProperty(\"candidates\").EnumerateArray().ToArray();\n        Assert.NotEmpty(candidates);\n        var candidateId = candidates[0].GetProperty(\"id\").GetInt32();\n        var candidateName = candidates[0].GetProperty(\"name\").GetString()!;\n\n        using var saved = await api.Client.PostAsJsonAsync($\"{ApiRoot}/rations/candidates/{candidateId}/save\", new { name = candidateName });\n        Assert.Equal(HttpStatusCode.OK, saved.StatusCode);\n        using var savedBody = JsonDocument.Parse(await saved.Content.ReadAsStringAsync());\n        Assert.Equal(candidateId, savedBody.RootElement.GetProperty(\"candidateId\").GetInt32());\n        Assert.Equal(\"Saved\", savedBody.RootElement.GetProperty(\"status\").GetString());\n\n        using var assigned = await api.Client.PostAsJsonAsync($\"{ApiRoot}/rations/candidates/{candidateId}/assign\", new { penId, effectiveDate = \"2026-04-15\" });\n        Assert.Equal(HttpStatusCode.OK, assigned.StatusCode);\n        using var assignedBody = JsonDocument.Parse(await assigned.Content.ReadAsStringAsync());\n        Assert.Equal(candidateId, assignedBody.RootElement.GetProperty(\"candidateId\").GetInt32());\n        Assert.Equal(\"Assigned\", assignedBody.RootElement.GetProperty(\"status\").GetString());\n    }\n\n    [Fact]\n    public async Task AC_2_7_InvalidReceiptReturnsContractValidationErrorAndFieldDetails()\n    {\n        using var api = await CreateAuthenticatedApiAsync(\"Operator\");\n        var item = (await InsertInventoryFixturesAsync(_factory.ConnectionString, \"AC27\", 1, withMovements: false))[0];\n        using var response = await api.Client.PostAsJsonAsync($\"{ApiRoot}/inventory/receipts\", new\n        {\n            itemName = item.Name,\n            supplier = item.Supplier,\n            quantity = 0,\n            enteredUnit = \"ton\",\n            normalizedPounds = 0,\n            cost = 360,\n            costUnit = \"USD per ton\",\n            receivedDate = \"2026-04-14\"\n        });\n\n        Assert.Equal((HttpStatusCode)422, response.StatusCode);\n        Assert.Equal(\"application/json\", response.Content.Headers.ContentType?.MediaType);\n        using var body = JsonDocument.Parse(await response.Content.ReadAsStringAsync());\n        Assert.Equal(\"Invalid field values\", body.RootElement.GetProperty(\"error\").GetString());\n        Assert.Equal(\"VALIDATION_ERROR\", body.RootElement.GetProperty(\"code\").GetString());\n        Assert.True(body.RootElement.GetProperty(\"fields\").TryGetProperty(\"quantity\", out var quantityError));\n        Assert.False(string.IsNullOrWhiteSpace(quantityError.GetString()));\n    }\n\n    [Fact]\n    public async Task CHAR_RootEndpointRemainsAvailable()\n    {\n        using var api = new TestApi(_factory);\n        using var response = await api.Client.GetAsync(\"/\");\n        Assert.Equal(HttpStatusCode.OK, response.StatusCode);\n        Assert.Equal(\"API is up\", await response.Content.ReadAsStringAsync());\n    }\n\n    private async Task<TestApi> CreateAuthenticatedApiAsync(string role)\n    {\n        var email = $\"part1-{Guid.NewGuid():N}@example.test\";\n        using (var bootstrap = new TestApi(_factory))\n        {\n            using var started = await bootstrap.Client.GetAsync(\"/\");\n            Assert.Equal(HttpStatusCode.OK, started.StatusCode);\n            await InsertAccountAsync(_factory.ConnectionString, email, role, TestPassword);\n        }\n\n        var api = new TestApi(_factory);\n        try\n        {\n            using var signIn = await api.Client.PostAsJsonAsync($\"{ApiRoot}/auth/sign-in\", new { email, password = «SECRET_6» });\n            Assert.Equal(HttpStatusCode.OK, signIn.StatusCode);\n            using var body = JsonDocument.Parse(await signIn.Content.ReadAsStringAsync());\n            var session = body.RootElement;\n            AssertHasProperties(session, \"user\", \"accessToken\", \"availablePages\");\n            AssertHasProperties(session.GetProperty(\"user\"), \"id\", \"name\", \"email\", \"role\");\n            Assert.Equal(role, session.GetProperty(\"user\").GetProperty(\"role\").GetString());\n            Assert.NotEmpty(session.GetProperty(\"availablePages\").EnumerateArray());\n            api.Client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue(\"Bearer\", session.GetProperty(\"accessToken\").GetString());\n            return api;\n        }\n        catch\n        {\n            api.Dispose();\n            throw;\n        }\n    }\n\n    private static async Task InsertAccountAsync(string connectionString, string email, string role, string password)\n    {\n        var hash = new PasswordHasher<object>().HashPassword(new object(), password);\n        await using var connection = new NpgsqlConnection(connectionString);\n        await connection.OpenAsync();\n        var roleValue = role switch\n        {\n            \"Administrator\" => \"'Administrator'\",\n            \"Operator\" => \"'Operator'\",\n            _ => throw new ArgumentOutOfRangeException(nameof(role), role, \"Unsupported contract role.\")\n        };\n        await using var command = new NpgsqlCommand($\"INSERT INTO \\\"Accounts\\\" (\\\"name\\\", \\\"department\\\", \\\"email\\\", \\\"passwordHash\\\", \\\"role\\\", \\\"status\\\") VALUES (@name, @department, @email, @passwordHash, {roleValue}, 'Active')\", connection);\n        command.Parameters.AddWithValue(\"name\", \"Part 1 test account\");\n        command.Parameters.AddWithValue(\"department\", \"Testing\");\n        command.Parameters.AddWithValue(\"email\", email);\n        command.Parameters.AddWithValue(\"passwordHash\", hash);\n        await command.ExecuteNonQueryAsync();\n    }\n\n    private static async Task<List<InventoryFixture>> InsertInventoryFixturesAsync(string connectionString, string label, int count, bool withMovements)\n    {\n        var result = new List<InventoryFixture>();\n        await using var connection = new NpgsqlConnection(connectionString);\n        await connection.OpenAsync();\n        for (var index = 1; index <= count; index++)\n        {\n            var name = $\"{label} feed {index} {Guid.NewGuid():N}\";\n            var supplier = $\"{label} supplier {index}\";\n            await using var insert = new NpgsqlCommand(\"INSERT INTO \\\"InventoryItems\\\" (\\\"item\\\", \\\"category\\\", \\\"supplier\\\", \\\"enteredQuantity\\\", \\\"enteredUnit\\\", \\\"normalizedPounds\\\", \\\"cost\\\", \\\"costUnit\\\", \\\"normalizedCostUsdPerLb\\\", \\\"dryMatterPercent\\\", \\\"energyMcalPerLb\\\", \\\"crudeProteinPercent\\\", \\\"tdnPercent\\\", \\\"storageLocation\\\", \\\"openingLb\\\") VALUES (@item, @category, @supplier, @enteredQuantity, @enteredUnit, @normalizedPounds, @cost, @costUnit, @normalizedCostUsdPerLb, @dryMatterPercent, @energyMcalPerLb, @crudeProteinPercent, @tdnPercent, @storageLocation, @openingLb) RETURNING \\\"id\\\"\", connection);\n            insert.Parameters.AddWithValue(\"item\", name);\n            insert.Parameters.AddWithValue(\"category\", \"Feed\");\n            insert.Parameters.AddWithValue(\"supplier\", supplier);\n            insert.Parameters.AddWithValue(\"enteredQuantity\", 1m);\n            insert.Parameters.AddWithValue(\"enteredUnit\", \"lb\");\n            insert.Parameters.AddWithValue(\"normalizedPounds\", 1m);\n            insert.Parameters.AddWithValue(\"cost\", 0.25m + index / 100m);\n            insert.Parameters.AddWithValue(\"costUnit\", \"USD per lb\");\n            insert.Parameters.AddWithValue(\"normalizedCostUsdPerLb\", 0.25m + index / 100m);\n            insert.Parameters.AddWithValue(\"dryMatterPercent\", 88m - index);\n            insert.Parameters.AddWithValue(\"energyMcalPerLb\", 1.4m + index / 10m);\n            insert.Parameters.AddWithValue(\"crudeProteinPercent\", 12m + index);\n            insert.Parameters.AddWithValue(\"tdnPercent\", 68m + index);\n            insert.Parameters.AddWithValue(\"storageLocation\", $\"Bin {index}\");\n            insert.Parameters.AddWithValue(\"openingLb\", 1000m + index * 100m);\n            var id = (int)(await insert.ExecuteScalarAsync() ?? throw new InvalidOperationException(\"Inventory fixture insert returned no id.\"));\n            result.Add(new InventoryFixture(id, name, supplier));\n\n            if (withMovements)\n            {\n                await InsertMovementAsync(connection, id, \"Receipt\", 500m + index, 1m + index, \"ton\");\n                await InsertMovementAsync(connection, id, \"Feed consumption\", 100m + index, null, null);\n            }\n        }\n        return result;\n    }\n\n    private static async Task InsertMovementAsync(NpgsqlConnection connection, int inventoryItemId, string type, decimal quantityLb, decimal? enteredQuantity, string? enteredUnit)\n    {\n            var movementType = type switch\n            {\n                \"Receipt\" => \"'Receipt'\",\n                \"Feed consumption\" => \"'Feed consumption'\",\n                _ => throw new ArgumentOutOfRangeException(nameof(type), type, \"Unsupported contract movement type.\")\n            };\n            await using var command = new NpgsqlCommand($\"INSERT INTO \\\"InventoryMovements\\\" (\\\"inventoryItemId\\\", \\\"date\\\", \\\"type\\\", \\\"quantityLb\\\", \\\"enteredQuantity\\\", \\\"enteredUnit\\\") VALUES (@inventoryItemId, @date, {movementType}, @quantityLb, @enteredQuantity, @enteredUnit)\", connection);\n        command.Parameters.AddWithValue(\"inventoryItemId\", inventoryItemId);\n        command.Parameters.AddWithValue(\"date\", FixtureDate.Date);\n        command.Parameters.AddWithValue(\"quantityLb\", quantityLb);\n        command.Parameters.AddWithValue(\"enteredQuantity\", enteredQuantity is null ? DBNull.Value : enteredQuantity);\n        command.Parameters.AddWithValue(\"enteredUnit\", enteredUnit is null ? DBNull.Value : enteredUnit);\n        await command.ExecuteNonQueryAsync();\n    }\n\n    private static async Task InsertLotFixturesAsync(string connectionString, int count)\n    {\n        await using var connection = new NpgsqlConnection(connectionString);\n        await connection.OpenAsync();\n        for (var index = 1; index <= count; index++)\n        {\n            var suffix = Guid.NewGuid().ToString(\"N\", CultureInfo.InvariantCulture);\n            var penId = await InsertPenAsync(connection, $\"P1 pen {suffix}\", 100 + index);\n            await using var lotInsert = new NpgsqlCommand(\"INSERT INTO \\\"Lots\\\" (\\\"lotCode\\\", \\\"sourceId\\\", \\\"sourceRecordId\\\", \\\"supplier\\\", \\\"receivedDate\\\", \\\"breed\\\", \\\"sex\\\", \\\"receivedHead\\\", \\\"purchaseCostAllocation\\\", \\\"receivedAverageWeightLb\\\", \\\"targetWeightLb\\\", \\\"ageMonths\\\", \\\"status\\\") VALUES (@lotCode, @sourceId, @sourceRecordId, @supplier, @receivedDate, @breed, @sex, @receivedHead, @purchaseCostAllocation, @receivedAverageWeightLb, @targetWeightLb, @ageMonths, 'Active') RETURNING \\\"id\\\"\", connection);\n            lotInsert.Parameters.AddWithValue(\"lotCode\", $\"P1-{index}-{suffix[..8]}\");\n            lotInsert.Parameters.AddWithValue(\"sourceId\", $\"P1 source {suffix}\");\n            lotInsert.Parameters.AddWithValue(\"sourceRecordId\", $\"P1 record {suffix}\");\n            lotInsert.Parameters.AddWithValue(\"supplier\", $\"P1 supplier {index}\");\n            lotInsert.Parameters.AddWithValue(\"receivedDate\", new DateTime(2026, 1, 1));\n            lotInsert.Parameters.AddWithValue(\"breed\", index % 2 == 0 ? \"Angus\" : \"Hereford\");\n            lotInsert.Parameters.AddWithValue(\"sex\", index % 2 == 0 ? \"Female\" : \"Male\");\n            lotInsert.Parameters.AddWithValue(\"receivedHead\", 30 + index);\n            lotInsert.Parameters.AddWithValue(\"purchaseCostAllocation\", 600m + index * 10m);\n            lotInsert.Parameters.AddWithValue(\"receivedAverageWeightLb\", 600m + index * 10m);\n            lotInsert.Parameters.AddWithValue(\"targetWeightLb\", 1200m + index * 10m);\n            lotInsert.Parameters.AddWithValue(\"ageMonths\", 8 + index);\n            var lotId = (int)(await lotInsert.ExecuteScalarAsync() ?? throw new InvalidOperationException(\"Lot fixture insert returned no id.\"));\n\n            await using var allocation = new NpgsqlCommand(\"INSERT INTO \\\"PenLotAllocations\\\" (\\\"penId\\\", \\\"lotId\\\", \\\"headCount\\\") VALUES (@penId, @lotId, @headCount)\", connection);\n            allocation.Parameters.AddWithValue(\"penId\", penId);\n            allocation.Parameters.AddWithValue(\"lotId\", lotId);\n            allocation.Parameters.AddWithValue(\"headCount\", 30 + index);\n            await allocation.ExecuteNonQueryAsync();\n\n            for (var measurement = 0; measurement < 3; measurement++)\n            {\n                var averageWeight = 650m + index * 10m + measurement * 35m;\n                await using var weight = new NpgsqlCommand(\"INSERT INTO \\\"WeightMeasurements\\\" (\\\"lotId\\\", \\\"date\\\", \\\"animalsWeighed\\\", \\\"averageWeightLb\\\", \\\"totalLotWeightLb\\\", \\\"gainSincePriorLb\\\", \\\"notes\\\", \\\"recorder\\\", \\\"result\\\") VALUES (@lotId, @date, @animalsWeighed, @averageWeightLb, @totalLotWeightLb, @gainSincePriorLb, @notes, @recorder, 'Accepted')\", connection);\n                weight.Parameters.AddWithValue(\"lotId\", lotId);\n                weight.Parameters.AddWithValue(\"date\", new DateTime(2026, 2 + measurement, 1));\n                weight.Parameters.AddWithValue(\"animalsWeighed\", 5 + index);\n                weight.Parameters.AddWithValue(\"averageWeightLb\", averageWeight);\n                weight.Parameters.AddWithValue(\"totalLotWeightLb\", averageWeight * (30 + index));\n                weight.Parameters.AddWithValue(\"gainSincePriorLb\", measurement == 0 ? 0m : 35m);\n                weight.Parameters.AddWithValue(\"gainSincePriorLb\", measurement == 0 ? 0m : 35m);\n                weight.Parameters.AddWithValue(\"notes\", $\"Part 1 fixture measurement {measurement + 1}\");\n                weight.Parameters.AddWithValue(\"recorder\", \"Part 1 tester\");\n                await weight.ExecuteNonQueryAsync();\n            }\n        }\n    }\n\n    private static Task<int> InsertPenAsync(string connectionString, string name, int capacity)\n    {\n        return InsertPenAsync(new NpgsqlConnection(connectionString), name, capacity, ownsConnection: true);\n    }\n\n    private static async Task<int> InsertPenAsync(NpgsqlConnection connection, string name, int capacity)\n    {\n        if (connection.State != System.Data.ConnectionState.Open)\n            await connection.OpenAsync();\n        return await InsertPenAsync(connection, name, capacity, ownsConnection: false);\n    }\n\n    private static async Task<int> InsertPenAsync(NpgsqlConnection connection, string name, int capacity, bool ownsConnection)\n    {\n        try\n        {\n            if (connection.State != System.Data.ConnectionState.Open)\n                await connection.OpenAsync();\n            await using var command = new NpgsqlCom... (11363 more characters not kept)","chars":31363,"exitCode":0}
{"ts":1791996912490,"kind":"call","tool":"Bash","input":"{\"command\":\"cat App.Tests/AppFactory.cs; sed -n '1,260p' App.Tests/AcceptancePart2Tests.cs; sed -n '260,540p' App.Tests/AcceptancePart2Tests.cs; sed -n '1,430p' App.Tests/AcceptancePart3Tests.cs\"}","output":"using Microsoft.AspNetCore.Hosting;\nusing Microsoft.AspNetCore.Mvc.Testing;\nusing Microsoft.Extensions.Configuration;\nusing Npgsql;\n\nnamespace App.Tests;\n\n/// <summary>\n/// The app for one test class, on a database of its own that starts empty: no other test class, and no earlier run, can leave\n/// rows in it. Use it as the class fixture: <c>public class OrdersTests : IClassFixture&lt;AppFactory&gt;</c>. A test that\n/// restarts the app makes a second one on the same database: <c>using var again = factory.Restarted();</c>\n/// The server and login come from ConnectionStrings__App, which the factory sets; only the database is new.\n/// </summary>\npublic class AppFactory : WebApplicationFactory<Program>\n{\n    private readonly string _server;\n    private readonly bool _owns;\n    public string ConnectionString { get; }\n\n    public AppFactory() : this(null) { }\n\n    private AppFactory(string? database)\n    {\n        _server = Environment.GetEnvironmentVariable(\"ConnectionStrings__App\")\n            ?? throw new InvalidOperationException(\"ConnectionStrings__App is not set: the tests need a PostgreSQL server.\");\n        _owns = database is null;\n        var name = database ?? $\"t_{Guid.NewGuid():N}\";\n        if (_owns) Exec(_server, $\"CREATE DATABASE \\\"{name}\\\"\");\n        ConnectionString = new NpgsqlConnectionStringBuilder(_server) { Database = name }.ConnectionString;\n    }\n\n    /// <summary>The app started again on this class's database, as after a restart.</summary>\n    public AppFactory Restarted() => new(new NpgsqlConnectionStringBuilder(ConnectionString).Database);\n\n    protected override void ConfigureWebHost(IWebHostBuilder builder) =>\n        builder.ConfigureAppConfiguration((_, c) => c.AddInMemoryCollection(new Dictionary<string, string?> { [\"ConnectionStrings:App\"] = ConnectionString }));\n\n    // xUnit ends a class fixture with DisposeAsync; Dispose covers a test that ends one itself with using\n    public override async ValueTask DisposeAsync()\n    {\n        await base.DisposeAsync();\n        Drop();\n    }\n\n    protected override void Dispose(bool disposing)\n    {\n        base.Dispose(disposing);\n        if (disposing) Drop();\n    }\n\n    private bool _dropped;\n    private void Drop()\n    {\n        if (!_owns || _dropped) return;\n        _dropped = true;\n        NpgsqlConnection.ClearAllPools();\n        Exec(_server, $\"DROP DATABASE IF EXISTS \\\"{new NpgsqlConnectionStringBuilder(ConnectionString).Database}\\\" WITH (FORCE)\");\n    }\n\n    private static void Exec(string connection, string sql)\n    {\n        using var c = new NpgsqlConnection(connection);\n        c.Open();\n        using var cmd = new NpgsqlCommand(sql, c);\n        cmd.ExecuteNonQuery();\n    }\n}\nusing System.Net;\nusing System.Net.Http.Headers;\nusing System.Net.Http.Json;\nusing System.Security.Claims;\nusing System.Text;\nusing System.Text.Json;\nusing System.Text.RegularExpressions;\nusing App.Api.External;\nusing Microsoft.AspNetCore.Authentication;\nusing Microsoft.AspNetCore.Hosting;\nusing Microsoft.AspNetCore.Mvc.Testing;\nusing Microsoft.AspNetCore.TestHost;\nusing Microsoft.Extensions.DependencyInjection;\nusing Microsoft.Extensions.DependencyInjection.Extensions;\nusing Microsoft.Extensions.Logging;\nusing Microsoft.Extensions.Options;\nusing Npgsql;\nusing Xunit;\n\nnamespace App.Tests.Part2;\n\npublic abstract class Part2ApiTestBase : IClassFixture<AppFactory>\n{\n    protected AppFactory Factory { get; }\n\n    protected Part2ApiTestBase(AppFactory factory) => Factory = factory;\n\n    protected WebApplicationFactory<Program> Start(IProcurementSource? source = null) => Part2Host.Start(Factory, source);\n\n    protected static HttpClient CreateClient(WebApplicationFactory<Program> app, string role = \"Administrator\")\n    {\n        var client = app.CreateClient();\n        client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue(\"Bearer\", \"part2-test-token\");\n        client.DefaultRequestHeaders.Add(\"X-Part2-Role\", role);\n        return client;\n    }\n}\n\npublic sealed class FeedingPlanAcceptanceTests(AppFactory factory) : Part2ApiTestBase(factory)\n{\n    [Fact]\n    public async Task AC_3_1_ListsPlansAndReturnsSeparateProportionalLotAllocations()\n    {\n        using var app = Start();\n        using var client = CreateClient(app);\n        await Part2Data.SeedOperationsAsync(Factory.ConnectionString);\n\n        using var post = await client.PostAsJsonAsync(\"/api/v1/feeding-plans\", new\n        {\n            date = \"2026-04-20\",\n            penId = 1,\n            rationId = 61,\n            bunkRateLbPerHeadPerDay = 20m,\n            plannedHeadCount = 50\n        });\n        Assert.Equal(HttpStatusCode.Created, post.StatusCode);\n        using var created = await Part2Json.ReadAsync(post);\n        var plan = created.RootElement.GetProperty(\"plan\");\n        Assert.Equal(1000m, plan.GetProperty(\"plannedQuantityLb\").GetDecimal());\n        var allocations = plan.GetProperty(\"lotAllocations\").EnumerateArray().ToArray();\n        Assert.Equal(2, allocations.Length);\n        Assert.Equal(1000m, allocations.Sum(a => a.GetProperty(\"plannedQuantityLb\").GetDecimal()));\n        Assert.Contains(allocations, a => a.GetProperty(\"lotId\").GetInt32() == 101);\n        Assert.Contains(allocations, a => a.GetProperty(\"lotId\").GetInt32() == 102);\n\n        using var get = await client.GetAsync(\"/api/v1/feeding-plans\");\n        Assert.Equal(HttpStatusCode.OK, get.StatusCode);\n        using var listed = await Part2Json.ReadAsync(get);\n        var plans = listed.RootElement.GetProperty(\"plans\").EnumerateArray().ToArray();\n        Assert.True(plans.Length >= 3);\n        var matching = Assert.Single(plans, p => p.GetProperty(\"date\").GetString() == \"2026-04-20\");\n        Part2Json.HasProperties(matching, \"date\", \"pen\", \"ration\", \"plannedQuantityLb\", \"status\", \"lotAllocations\");\n    }\n}\n\npublic sealed class FeedingActivityListAcceptanceTests(AppFactory factory) : Part2ApiTestBase(factory)\n{\n    [Fact]\n    public async Task AC_3_2_ListsSavedActivitiesWithInventoryAndLotTotals()\n    {\n        using var app = Start();\n        using var client = CreateClient(app);\n        await Part2Data.SeedOperationsAsync(Factory.ConnectionString);\n        foreach (var (planId, date) in new[] { (801, \"2026-04-14\"), (802, \"2026-04-15\"), (803, \"2026-04-16\") })\n        {\n            using var post = await Part2Activity.PostAsync(client, planId, date, 900m, 540m, 360m);\n            Assert.Equal(HttpStatusCode.Created, post.StatusCode);\n        }\n\n        using var response = await client.GetAsync(\"/api/v1/feeding-activities\");\n        Assert.Equal(HttpStatusCode.OK, response.StatusCode);\n        using var document = await Part2Json.ReadAsync(response);\n        var activities = document.RootElement.GetProperty(\"activities\").EnumerateArray().ToArray();\n        Assert.True(activities.Length >= 3);\n        foreach (var activity in activities.Where(a => a.GetProperty(\"date\").GetString() is \"2026-04-14\" or \"2026-04-15\" or \"2026-04-16\"))\n        {\n            Part2Json.HasProperties(activity, \"plannedQuantityLb\", \"actualQuantityLb\", \"varianceLb\", \"inventoryConsumption\", \"feedCostUsd\", \"energyMcal\", \"lotAllocations\");\n            Assert.Equal(2, activity.GetProperty(\"lotAllocations\").GetArrayLength());\n        }\n    }\n}\n\npublic sealed class CreateFeedingActivityAcceptanceTests(AppFactory factory) : Part2ApiTestBase(factory)\n{\n    [Fact]\n    public async Task AC_3_3_RecordsVarianceAndTwoDeliveredLotShares()\n    {\n        using var app = Start();\n        using var client = CreateClient(app);\n        await Part2Data.SeedOperationsAsync(Factory.ConnectionString);\n\n        using var response = await Part2Activity.PostAsync(client, 801, \"2026-04-14\", 950m, 570m, 380m);\n        Assert.Equal(HttpStatusCode.Created, response.StatusCode);\n        using var document = await Part2Json.ReadAsync(response);\n        var activity = document.RootElement.GetProperty(\"activity\");\n        Assert.Equal(50m, activity.GetProperty(\"varianceLb\").GetDecimal());\n        var allocations = activity.GetProperty(\"lotAllocations\").EnumerateArray().ToArray();\n        Assert.Equal(2, allocations.Length);\n        Assert.Equal(950m, allocations.Sum(a => a.GetProperty(\"deliveredQuantityLb\").GetDecimal()));\n        Assert.Contains(allocations, a => a.GetProperty(\"lotId\").GetInt32() == 101);\n        Assert.Contains(allocations, a => a.GetProperty(\"lotId\").GetInt32() == 102);\n    }\n}\n\npublic sealed class UpdateAndCancelFeedingActivityAcceptanceTests(AppFactory factory) : Part2ApiTestBase(factory)\n{\n    [Fact]\n    public async Task AC_3_4_RecalculatesAnUpdateAndReversesInventoryWhenCanceled()\n    {\n        using var app = Start();\n        using var client = CreateClient(app);\n        await Part2Data.SeedOperationsAsync(Factory.ConnectionString, openingLb: 2000m);\n\n        using var create = await Part2Activity.PostAsync(client, 801, \"2026-04-14\", 950m, 570m, 380m);\n        Assert.Equal(HttpStatusCode.Created, create.StatusCode);\n        using var created = await Part2Json.ReadAsync(create);\n        var activityId = created.RootElement.GetProperty(\"activity\").GetProperty(\"id\").GetInt32();\n\n        using var update = await client.PatchAsJsonAsync($\"/api/v1/feeding-activities/{activityId}\", Part2Activity.Request(801, \"2026-04-14\", 960m, 576m, 384m));\n        Assert.Equal(HttpStatusCode.OK, update.StatusCode);\n        using var updated = await Part2Json.ReadAsync(update);\n        var updatedActivity = updated.RootElement.GetProperty(\"activity\");\n        Assert.Equal(60m, updatedActivity.GetProperty(\"varianceLb\").GetDecimal());\n        Assert.Equal(960m, updatedActivity.GetProperty(\"actualQuantityLb\").GetDecimal());\n        Part2Json.HasProperties(updated.RootElement, \"inventoryTotals\", \"message\");\n\n        using var cancel = await client.DeleteAsync($\"/api/v1/feeding-activities/{activityId}\");\n        Assert.Equal(HttpStatusCode.OK, cancel.StatusCode);\n        using var canceled = await Part2Json.ReadAsync(cancel);\n        Assert.Equal(\"Canceled\", canceled.RootElement.GetProperty(\"activity\").GetProperty(\"status\").GetString());\n        var inventory = Assert.Single(canceled.RootElement.GetProperty(\"inventoryTotals\").EnumerateArray());\n        Assert.Equal(\"Ground corn\", inventory.GetProperty(\"item\").GetString());\n        Assert.Equal(2000m, inventory.GetProperty(\"closingLb\").GetDecimal());\n    }\n}\n\npublic sealed class InsufficientInventoryAcceptanceTests(AppFactory factory) : Part2ApiTestBase(factory)\n{\n    [Fact]\n    public async Task AC_3_5_RejectsInsufficientStockWithoutChangingInventoryOrActivities()\n    {\n        using var app = Start();\n        using var client = CreateClient(app);\n        await Part2Data.SeedOperationsAsync(Factory.ConnectionString, openingLb: 10m);\n        using var inventoryBeforeResponse = await client.GetAsync(\"/api/v1/inventory\");\n        Assert.Equal(HttpStatusCode.OK, inventoryBeforeResponse.StatusCode);\n        using var inventoryBefore = await Part2Json.ReadAsync(inventoryBeforeResponse);\n        var beforeItem = Assert.Single(inventoryBefore.RootElement.GetProperty(\"items\").EnumerateArray());\n        var opening = beforeItem.GetProperty(\"closingLb\").GetDecimal();\n        using var activitiesBeforeResponse = await client.GetAsync(\"/api/v1/feeding-activities\");\n        Assert.Equal(HttpStatusCode.OK, activitiesBeforeResponse.StatusCode);\n        using var activitiesBefore = await Part2Json.ReadAsync(activitiesBeforeResponse);\n        var beforeActivities = activitiesBefore.RootElement.GetProperty(\"activities\").GetArrayLength();\n\n        using var refused = await Part2Activity.PostAsync(client, 801, \"2026-04-14\", 20m, 12m, 8m);\n        Assert.Equal(HttpStatusCode.Conflict, refused.StatusCode);\n        using var error = await Part2Json.ReadAsync(refused);\n        Assert.Equal(\"Insufficient stock for Ground corn\", error.RootElement.GetProperty(\"error\").GetString());\n        Assert.Equal(\"INSUFFICIENT_STOCK\", error.RootElement.GetProperty(\"code\").GetString());\n\n        using var inventoryAfterResponse = await client.GetAsync(\"/api/v1/inventory\");\n        Assert.Equal(HttpStatusCode.OK, inventoryAfterResponse.StatusCode);\n        using var inventoryAfter = await Part2Json.ReadAsync(inventoryAfterResponse);\n        var afterItem = Assert.Single(inventoryAfter.RootElement.GetProperty(\"items\").EnumerateArray());\n        Assert.Equal(opening, afterItem.GetProperty(\"closingLb\").GetDecimal());\n        using var activitiesAfterResponse = await client.GetAsync(\"/api/v1/feeding-activities\");\n        Assert.Equal(HttpStatusCode.OK, activitiesAfterResponse.StatusCode);\n        using var activitiesAfter = await Part2Json.ReadAsync(activitiesAfterResponse);\n        Assert.Equal(beforeActivities, activitiesAfter.RootElement.GetProperty(\"activities\").GetArrayLength());\n    }\n}\n\npublic sealed class WeightMeasurementListAcceptanceTests(AppFactory factory) : Part2ApiTestBase(factory)\n{\n    [Fact]\n    public async Task AC_4_1_ReturnsMeasurementsAndTrendsForAllLotsOrOneLot()\n    {\n        using var app = Start();\n        using var client = CreateClient(app);\n        await Part2Data.SeedOperationsAsync(Factory.ConnectionString, seedMeasurements: true);\n\n        using var allResponse = await client.GetAsync(\"/api/v1/weight-measurements\");\n        Assert.Equal(HttpStatusCode.OK