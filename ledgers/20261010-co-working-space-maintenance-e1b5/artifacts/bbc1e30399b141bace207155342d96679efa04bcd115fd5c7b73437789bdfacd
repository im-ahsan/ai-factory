{"files":[{"added":["using System.Text.Json;","using Microsoft.EntityFrameworkCore;","","namespace App.Api.Endpoints;","","// The ChangeRequestStatus of contracts/openapi.yaml, as documentation of the body; the handler reads and checks the body itself.","public sealed record ChangeRequestStatus(RequestStatus Status);","","// PATCH /api/requests/{id}/status (changeRequestStatus): Open -> In progress -> Done -> Open, and nothing else.","public sealed class ChangeRequestStatusEndpoint : IEndpointRegistrar","{","    private const string NotFound = \"Request not found.\";","    private const string Invalid = \"Status must be Open, In progress, or Done; only status may be changed.\";","","    public void Map(RouteGroupBuilder api)","    {","        api.MapPatch(\"/requests/{id:long}/status\", Handle)","            .WithName(\"changeRequestStatus\")","            .WithSummary(\"Change a request's status\")","            .Accepts<ChangeRequestStatus>(\"application/json\")","            .Produces<MaintenanceRequestResource>()","            .Produces<ErrorResponse>(StatusCodes.Status400BadRequest)","            .Produces<ErrorResponse>(StatusCodes.Status404NotFound)","            .Produces<ErrorResponse>(StatusCodes.Status409Conflict)","            .Produces<ErrorResponse>(StatusCodes.Status500InternalServerError);","","        api.MapPatch(\"/requests/{id}/status\", () => Results.NotFound(new ErrorResponse(NotFound)))","            .ExcludeFromDescription();","    }","","    private static RequestStatus PreviousStatus(RequestStatus next) => next switch","    {","        RequestStatus.InProgress => RequestStatus.Open,","        RequestStatus.Done => RequestStatus.InProgress,","        _ => RequestStatus.Done,","    };","","    private static async Task<IResult> Handle(long id, HttpRequest request, AppDb db, CancellationToken ct)","    {","        JsonDocument doc;","        try","        {","            doc = await JsonDocument.ParseAsync(request.Body, cancellationToken: ct);","        }","        catch (JsonException)","        {","            return Results.BadRequest(new ErrorResponse(Invalid));","        }","","        RequestStatus next;","        using (doc)","        {","            if (doc.RootElement.ValueKind != JsonValueKind.Object)","                return Results.BadRequest(new ErrorResponse(Invalid));","","            var errors = new Dictionary<string, string[]>();","            RequestStatus? parsed = null;","            foreach (var p in doc.RootElement.EnumerateObject())","            {","                if (p.Name == \"status\")","                {","                    if (p.Value.ValueKind == JsonValueKind.String && ContractName<RequestStatus>.TryParse(p.Value.GetString(), out var s)) parsed = s;","                    else errors[\"status\"] = [\"Unsupported status value.\"];","                }","                else errors[p.Name] = [\"Only status may be changed.\"];","            }","            if (parsed is null && !errors.ContainsKey(\"status\")) errors[\"status\"] = [\"Status is required.\"];","            if (errors.Count > 0) return Results.BadRequest(new ErrorResponse(Invalid, errors));","            next = parsed!.Value;","        }","","        if (id < 1) return Results.NotFound(new ErrorResponse(NotFound));","","        try","        {","            var previous = PreviousStatus(next);","            var updated = await db.MaintenanceRequests","                .Where(r => r.Id == id && r.Status == previous)","                .ExecuteUpdateAsync(s => s.SetProperty(r => r.Status, next), ct);","","            var row = await db.MaintenanceRequests.AsNoTracking().FirstOrDefaultAsync(r => r.Id == id, ct);","            if (row is null) return Results.NotFound(new ErrorResponse(NotFound));","            return updated == 0","                ? Results.Json(new ErrorResponse(\"This status transition is not allowed.\"), statusCode: StatusCodes.Status409Conflict)","                : Results.Ok(MaintenanceRequestResource.From(row));","        }","        catch (Exception) when (!ct.IsCancellationRequested)","        {","            return Results.Json(new ErrorResponse(\"Could not update the request.\"), statusCode: StatusCodes.Status500InternalServerError);","        }","    }","}"],"path":"App.Api/Endpoints/ChangeRequestStatusEndpoint.cs","removed":[],"status":"A"}],"from":"38cedf25bbc8238e4aa631990dd8e0c3541d8ee5","lockedNow":{"App.Tests/CharacterisationTests.cs":"802a9e778408f451c01fa708a73c71ce45d861ca9ae036871d91bc378f428836","App.Tests/PersistenceAndSeedTests.cs":"a97ff7c1e1cbf41ef532b1d8cb9261129ece53b6a9a5b734e78351a0da14d156","App.Tests/RequestApiTests.cs":"18c95b9785157471859c5d8f894bd3b267704fed4e5186207f07b69c10200d0a","App.Tests/TestSupport.cs":"ff3c90493707bc7f260a2df96af7a95cb7f8a2bbb8c5bcbbcde06eec6280cf8d","contracts/data-model.yaml":"a97fbc7cd1d9e269d81f5b1a016224ac7f8153d24dd765923f5ea183914afb91","contracts/openapi.yaml":"2cf06dc03513489ad19f5631d6cb9d0e0227d2ddaad4d32406639075a9ba2585"},"to":"29c30f3cbe6bfd9aa572aca03f099c3a9f405b6e"}