+namespace App.Api;
+
+public interface IEndpointRegistrar
+{
+    void Map(RouteGroupBuilder api);
+}
+
+public static class EndpointRegistration
+{
+    public static void MapRegistrars(this RouteGroupBuilder api)
+    {
+        var registrars = typeof(IEndpointRegistrar).Assembly.GetTypes()
+            .Where(t => t is { IsClass: true, IsAbstract: false } && t.IsAssignableTo(typeof(IEndpointRegistrar)))
+            .OrderBy(t => t.FullName, StringComparer.Ordinal);
+        foreach (var type in registrars) ((IEndpointRegistrar)Activator.CreateInstance(type)!).Map(api);
+    }
+}
