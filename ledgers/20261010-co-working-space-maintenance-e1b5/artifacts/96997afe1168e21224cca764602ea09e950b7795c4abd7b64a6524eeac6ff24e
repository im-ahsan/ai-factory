+using Microsoft.AspNetCore.Mvc;
+using Microsoft.EntityFrameworkCore;
+
+namespace App.Api.Endpoints;
+
+public class ListRequestsEndpoint : IEndpointRegistrar
+{
+    private static readonly string[] Statuses = ["Open", "In progress", "Done"];
+
+    public void Map(RouteGroupBuilder api)
+    {
+        api.MapGet("/requests", async ([FromQuery] string? status, AppDb db, CancellationToken ct) =>
+        {
+            if (status != null && !Statuses.Contains(status))
+                return Results.Json(new ErrorResponse("Status must be Open, In progress, or Done.",
+                    new() { ["status"] = ["Unsupported status filter."] }), statusCode: StatusCodes.Status400BadRequest);
+            try
+            {
+                var query = db.MaintenanceRequests.AsNoTracking();
+                if (status != null) query = query.Where(r => r.Status == status);
+                var rows = await query.OrderByDescending(r => r.CreatedAt).ThenByDescending(r => r.Id).ToListAsync(ct);
+                return Results.Ok(new RequestList(rows.Select(MaintenanceRequestResource.From).ToList()));
+            }
+            catch (Exception) when (!ct.IsCancellationRequested)
+            {
+                return Results.Json(new ErrorResponse("Could not load requests."), statusCode: StatusCodes.Status500InternalServerError);
+            }
+        })
+        .WithName("listRequests")
+        .Produces<RequestList>(StatusCodes.Status200OK)
+        .Produces<ErrorResponse>(StatusCodes.Status400BadRequest)
+        .Produces<ErrorResponse>(StatusCodes.Status500InternalServerError);
+    }
+}
