+using System.Text.Json.Serialization;
+
+namespace App.Api;
+
+public enum RequestArea
+{
+    Kitchen,
+    [JsonStringEnumMemberName("Meeting room")] MeetingRoom,
+    [JsonStringEnumMemberName("Open desk")] OpenDesk,
+    Washroom,
+    Reception,
+}
+
+public enum RequestPriority { Low, Normal, Urgent }
+
+public enum RequestStatus
+{
+    Open,
+    [JsonStringEnumMemberName("In progress")] InProgress,
+    Done,
+}
+
+public record MaintenanceRequestResource(
+    long Id,
+    DateTime CreatedAt,
+    string Title,
+    RequestArea Area,
+    RequestPriority Priority,
+    RequestStatus Status,
+    [property: JsonIgnore(Condition = JsonIgnoreCondition.WhenWritingNull)] string? Description)
+{
+    public static MaintenanceRequestResource From(MaintenanceRequest r) => new(
+        r.Id,
+        DateTime.SpecifyKind(r.CreatedAt, DateTimeKind.Utc),
+        r.Title,
+        r.Area switch
+        {
+            "Kitchen" => RequestArea.Kitchen,
+            "Meeting room" => RequestArea.MeetingRoom,
+            "Open desk" => RequestArea.OpenDesk,
+            "Washroom" => RequestArea.Washroom,
+            _ => RequestArea.Reception,
+        },
+        r.Priority switch
+        {
+            "Low" => RequestPriority.Low,
+            "Normal" => RequestPriority.Normal,
+            _ => RequestPriority.Urgent,
+        },
+        r.Status switch
+        {
+            "Open" => RequestStatus.Open,
+            "In progress" => RequestStatus.InProgress,
+            _ => RequestStatus.Done,
+        },
+        r.Description);
+}
+
+public record RequestList(List<MaintenanceRequestResource> Requests);
+
+public record ErrorResponse(
+    string Message,
+    [property: JsonIgnore(Condition = JsonIgnoreCondition.WhenWritingNull)] Dictionary<string, string[]>? Errors = null);
