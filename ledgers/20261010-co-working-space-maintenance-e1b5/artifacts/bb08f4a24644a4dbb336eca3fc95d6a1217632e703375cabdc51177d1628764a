tic readonly Dictionary<T, string> Names = Enum.GetValues<T>().ToDictionary(v => v,\n+        v => typeof(T).GetField(v.ToString())!.GetCustomAttribute<JsonStringEnumMemberNameAttribute>()?.Name ?? v.ToString());\n+\n+    public static string Of(T value) => Names[value];\n+\n+    public static bool TryParse(string? name, out T value)\n+    {\n+        foreach (var (v, n) in Names)\n+            if (n == name)\n+            {\n+                value = v;\n+                return true;\n+            }\n+        value = default;\n+        return false;\n+    }\n+\n+    public static T Parse(string name) =>\n+        TryParse(name, out var value) ? value : throw new FormatException($\"'{name}' is not a {typeof(T).Name}.\");\n+}\ndiff --git a/App.Api/MaintenanceRequestResource.cs b/App.Api/MaintenanceRequestResource.cs\nnew file mode 100644\nindex 0000000..d9e4a29\n--- /dev/null\n+++ b/App.Api/MaintenanceRequestResource.cs\n@@ -0,0 +1,25 @@\n+using System.Text.Json.Serialization;\n+\n+namespace App.Api;\n+\n+// The MaintenanceRequest of contracts/openapi.yaml: what the API returns for a stored request; a missing description is left out.\n+public sealed record MaintenanceRequestResource(\n+    long Id,\n+    DateTime CreatedAt,\n+    string Title,\n+    RequestArea Area,\n+    RequestPriority Priority,\n+    RequestStatus Status)\n+{\n+    [JsonIgnore(Condition = JsonIgnoreCondition.WhenWritingNull)]\n+    public string? Description { get; init; }\n+\n+    public static MaintenanceRequestResource From(MaintenanceRequest r) =>\n+        new(r.Id, DateTime.SpecifyKind(r.CreatedAt, DateTimeKind.Utc), r.Title, r.Area, r.Priority, r.Status) { Description = r.Description };\n+}\n+\n+public sealed record RequestList(IReadOnlyList<MaintenanceRequestResource> Requests);\n+\n+public sealed record ErrorResponse(\n+    string Message,\n+    [property: JsonIgnore(Condition = JsonIgnoreCondition.WhenWritingNull)] Dictionary<string, string[]>? Errors = null);\ndiff --git a/App.Api/Progr