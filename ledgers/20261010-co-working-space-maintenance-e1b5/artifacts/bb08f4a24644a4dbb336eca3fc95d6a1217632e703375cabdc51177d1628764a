a, string Priority, string Status, string? Description);\n+\n+// A throwaway PostgreSQL database created from the server named by ConnectionStrings__App.\n+public sealed class TestDb : IDisposable\n+{\n+    private readonly string _name = \"hw_\" + Guid.NewGuid().ToString(\"N\");\n+    private readonly string _admin;\n+    public string ConnectionString { get; }\n+\n+    public TestDb()\n+    {\n+        var baseCs = Environment.GetEnvironmentVariable(\"ConnectionStrings__App\")\n+            ?? throw new InvalidOperationException(\"ConnectionStrings__App is not set.\");\n+        _admin = new NpgsqlConnectionStringBuilder(baseCs) { Database = \"postgres\", Pooling = false }.ConnectionString;\n+        Exec(_admin, $\"CREATE DATABASE \\\"{_name}\\\"\");\n+        ConnectionString = new NpgsqlConnectionStringBuilder(baseCs) { Database = _name }.ConnectionString;\n+    }\n+\n+    public static void Exec(string cs, string sql)\n+    {\n+        using var conn = new NpgsqlConnection(cs);\n+        conn.Open();\n+        using var cmd = new NpgsqlCommand(sql, conn);\n+        cmd.ExecuteNonQuery();\n+    }\n+\n+    public void Exec(string sql) => Exec(ConnectionString, sql);\n+\n+    public long Insert(string title, string area, string priority, string status, DateTime createdAtUtc, string? description = null)\n+    {\n+        using var conn = new NpgsqlConnection(ConnectionString);\n+        conn.Open();\n+        using var cmd = new NpgsqlCommand(\n+            \"INSERT INTO \\\"MaintenanceRequests\\\" (\\\"CreatedAt\\\",\\\"Title\\\",\\\"Area\\\",\\\"Priority\\\",\\\"Status\\\",\\\"Description\\\",\\\"IsDemo\\\") \" +\n+            \"VALUES (@c::timestamp,@t,@a,@p,@s,@d,false) RETURNING \\\"Id\\\"\", conn);\n+        cmd.Parameters.AddWithValue(\"c\", DateTime.SpecifyKind(createdAtUtc, DateTimeKind.Unspecified));\n+        cmd.Parameters.AddWithValue(\"t\", title);\n+        cmd.Parameters.AddWithValue(\"a\", area);\n+        cmd.Parameters.AddWithValue(\"p\", priority);\n+        cmd.Parameters.AddWithValue(\"s\", status);\n+        cmd.Parameters.AddWithValue(\"d\", (object?)description ?? DBNull.Value);\n+        return (long)cmd.ExecuteScalar()!;\n+    }\n+\n+    public long Count()\n+    {\n+        using var conn = new NpgsqlConnection(ConnectionString);\n+        conn.Open();\n+        using var cmd = new NpgsqlCommand(\"SELECT count(*) FROM \\\"MaintenanceRequests\\\"\", conn);\n+        return (long)cmd.ExecuteScalar()!;\n+    }\n+\n+    public List<StoredRow> Rows()\n+    {\n+        using var conn = new NpgsqlConnection(ConnectionString);\n+        conn.Open();\n+        using var cmd = new NpgsqlCommand(\n+            \"SELECT \\\"Id\\\",\\\"CreatedAt\\\",\\\"Title\\\",\\\"Area\\\",\\\"Priority\\\",\\\"Status\\\",\\\"Description\\\" FROM \\\"MaintenanceRequests\\\" ORDER BY \\\"Id\\\"\", conn);\n+        using var r = cmd.ExecuteReader();\n+        var list = new List<StoredRow>();\n+        while (r.Read())\n+            list.Add(new StoredRow(r.GetInt64(0), r.GetDateTime(1), r.GetString(2), r.GetString(3), r.GetString(4), r.GetString(5),\n+                r.IsDBNull(6) ? null : r.GetString(6)));\n+        return list;\n+    }\n+\n+    public StoredRow? Row(long id) => Rows().FirstOrDefault(x => x.Id == id);\n+\n+    public void Dispose()\n+    {\n+        try\n+        {\n+            NpgsqlConnection.ClearAllPools();\n+            Exec(_admin, $\"DROP DATABASE IF EXISTS \\\"{_name}\\\" WITH (FORCE)\");\n+        }\n+        catch\n+        {\n+        }\n+    }\n+}\n+\n+public static class Hosting\n+{\n+    public static WebApplicationFactory<Program> Create(string connectionString) =>\n+        new WebApplicationFactory<Program>().WithWebHostBuilder(b =>\n+        {\n+            b.UseSetting(\"ConnectionStrings:App\", connectionString);\n+            b.UseSetting(\"Seed:Demo\", \"false\");\n+            b.UseSetting(\"Cors:Origin\", \"http://localhost:3000\");\n+            b.ConfigureAppConfiguration((_, c) =>