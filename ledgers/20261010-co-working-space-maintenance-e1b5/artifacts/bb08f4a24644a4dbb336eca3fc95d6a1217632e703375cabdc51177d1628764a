stStatus(RequestStatus Status);\n+\n+// PATCH /api/requests/{id}/status (changeRequestStatus): Open -> In progress -> Done -> Open, and nothing else.\n+public sealed class ChangeRequestStatusEndpoint : IEndpointRegistrar\n+{\n+    private const string NotFound = \"Request not found.\";\n+    private const string Invalid = \"Status must be Open, In progress, or Done; only status may be changed.\";\n+\n+    public void Map(RouteGroupBuilder api)\n+    {\n+        api.MapPatch(\"/requests/{id:long}/status\", Handle)\n+            .WithName(\"changeRequestStatus\")\n+            .WithSummary(\"Change a request's status\")\n+            .Accepts<ChangeRequestStatus>(\"application/json\")\n+            .Produces<MaintenanceRequestResource>()\n+            .Produces<ErrorResponse>(StatusCodes.Status400BadRequest)\n+            .Produces<ErrorResponse>(StatusCodes.Status404NotFound)\n+            .Produces<ErrorResponse>(StatusCodes.Status409Conflict)\n+            .Produces<ErrorResponse>(StatusCodes.Status500InternalServerError);\n+\n+        api.MapPatch(\"/requests/{id}/status\", () => Results.NotFound(new ErrorResponse(NotFound)))\n+            .ExcludeFromDescription();\n+    }\n+\n+    private static RequestStatus PreviousStatus(RequestStatus next) => next switch\n+    {\n+        RequestStatus.InProgress => RequestStatus.Open,\n+        RequestStatus.Done => RequestStatus.InProgress,\n+        _ => RequestStatus.Done,\n+    };\n+\n+    private static async Task<IResult> Handle(long id, HttpRequest request, AppDb db, CancellationToken ct)\n+    {\n+        JsonDocument doc;\n+        try\n+        {\n+            doc = await JsonDocument.ParseAsync(request.Body, cancellationToken: ct);\n+        }\n+        catch (JsonException)\n+        {\n+            return Results.BadRequest(new ErrorResponse(Invalid));\n+        }\n+\n+        RequestStatus next;\n+        using (doc)\n+        {\n+            if (doc.RootElement.ValueKind != JsonValueKind.Object)\n+           