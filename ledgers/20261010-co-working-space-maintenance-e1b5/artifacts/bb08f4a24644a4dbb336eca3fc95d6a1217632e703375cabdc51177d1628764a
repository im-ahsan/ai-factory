e = \"Projector won't power on\",\n+                Area = RequestArea.MeetingRoom,\n+                Priority = RequestPriority.Normal,\n+                Status = RequestStatus.InProgress,\n+                IsDemo = true,\n+            },\n+            new MaintenanceRequest\n+            {\n+                CreatedAt = new DateTime(2026, 3, 16, 9, 0, 0, DateTimeKind.Utc),\n+                Title = \"Wobbly desk B-14\",\n+                Area = RequestArea.OpenDesk,\n+                Priority = RequestPriority.Low,\n+                Status = RequestStatus.Open,\n+                IsDemo = true,\n+            },\n+        };\n+\n+        var titles = examples.Select(e => e.Title).ToList();\n+        var existing = db.MaintenanceRequests.Where(r => r.IsDemo && titles.Contains(r.Title)).Select(r => r.Title).ToHashSet();\n+        var missing = examples.Where(e => !existing.Contains(e.Title)).ToList();\n+        if (missing.Count == 0) return;\n+\n+        db.MaintenanceRequests.AddRange(missing);\n+        db.SaveChanges();\n     }\n }\ndiff --git a/App.Tests/CharacterisationTests.cs b/App.Tests/CharacterisationTests.cs\nnew file mode 100644\nindex 0000000..6172f1f\n--- /dev/null\n+++ b/App.Tests/CharacterisationTests.cs\n@@ -0,0 +1,54 @@\n+using System.Net;\n+using Xunit;\n+\n+namespace App.Tests;\n+\n+// Behaviour that exists today and must not change.\n+public class CharacterisationTests\n+{\n+    [Fact]\n+    public async Task CHAR_RootReturnsApiIsUpAsPlainText()\n+    {\n+        using var e = new Env();\n+\n+        var res = await e.Client.GetAsync(\"/\");\n+\n+        Assert.Equal(HttpStatusCode.OK, res.StatusCode);\n+        Assert.Equal(\"API is up\", await res.Content.ReadAsStringAsync());\n+    }\n+\n+    [Fact]\n+    public async Task CHAR_UnknownRouteReturns404()\n+    {\n+        using var e = new Env();\n+\n+        var res = await e.Client.GetAsync(\"/no-such-route\");\n+\n+        Assert.Equal(HttpStatusCode.NotFound, res.StatusCode);\n+    }\n+\n+   