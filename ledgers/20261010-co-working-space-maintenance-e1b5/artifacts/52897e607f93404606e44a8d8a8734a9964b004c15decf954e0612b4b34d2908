age. The API assigns id, createdAt, and Open status itself; optional caller-supplied values for those system-controlled fields are ignored. A description that is absent or blank after trimming is omitted from the resource.\n64\t      requestBody:\n65\t        required: true\n66\t        content:\n67\t          application/json:\n68\t            schema:\n69\t              $ref: '#/components/schemas/CreateRequest'\n70\t            example:\n71\t              title: Kitchen tap leaking\n72\t              area: Kitchen\n73\t              priority: Urgent\n74\t              description: Water is pooling under the sink.\n75\t      responses:\n76\t        '201':\n77\t          description: The created request with system-assigned fields.\n78\t          content:\n79\t            application/json:\n80\t              schema:\n81\t                $ref: '#/components/schemas/MaintenanceRequest'\n82\t              example:\n83\t                id: 13\n84\t                createdAt: '2026-03-19T10:30:00Z'\n85\t                title: Kitchen tap leaking\n86\t                area: Kitchen\n87\t                priority: Urgent\n88\t                status: Open\n89\t                description: Water is pooling under the sink.\n90\t        '400':\n91\t          description: Malformed JSON, invalid field types, missing or invalid fields, or invalid values. No request is created.\n92\t          content:\n93\t            application/json:\n94\t              schema:\n95\t                $ref: '#/components/schemas/ErrorResponse'\n96\t              example:\n97\t                message: Request validation failed.\n98\t                errors:\n99\t                  title: [Title must be 3 to 80 characters.]\n100\t                  area: [Area is required.]\n101\t                  description: [Description must be at most 500 characters.]\n102\t        '500':\n103\t          description: The request could not be created.\n104\t          content:\n105\t            application/json:\n106\t              schema:\n107\t                $ref: '#/components/schemas/ErrorResponse'\n108\t              example:\n109\t                message: Could not create the request.\n110\t  /requests/{id}:\n111\t    parameters:\n112\t      - name: id\n113\t        in: path\n114\t        required: true\n115\t        description: System-generated integer request ID.\n116\t        schema:\n117\t          type: integer\n118\t          format: int64\n119\t          minimum: 1\n120\t    get:\n121\t      operationId: getRequest\n122\t      summary: Get a maintenance request\n123\t      responses:\n124\t        '200':\n125\t          description: The matching request.\n126\t          content:\n127\t            application/json:\n128\t              schema:\n129\t                $ref: '#/components/schemas/MaintenanceRequest'\n130\t              example:\n131\t                id: 2\n132\t                createdAt: '2026-03-17T09:00:00Z'\n133\t                title: \"Projector won't power on\"\n134\t                area: Meeting room\n135\t                priority: Normal\n136\t                status: In progress\n137\t        '404':\n138\t          description: No request has this ID.\n139\t          content:\n140\t            application/json:\n141\t              schema:\n142\t                $ref: '#/components/schemas/ErrorResponse'\n143\t              example:\n144\t                message: Request not found.\n145\t        '500':\n146\t          description: The request could not be loaded for a non-not-found reason.\n147\t          content:\n148\t            application/json:\n149\t              schema:\n150\t                $ref: '#/components/schemas/ErrorResponse'\n151\t              example:\n152\t                message: Could not load the request.\n153\t  /requests/{id}/status:\n154\t    parameters:\n155\t      - name: id\n156\t        in: path\n157\t        required: true\n158\t        description: System-generated integer request ID.\n159\t        schema:\n160\t          type: integer\n161\t          format: int64\n162\t          minimum: 1\n163\t    patch:\n164\t      operationId: changeRequestStatus\n165\t      summary: Change a request's status\n166\t      description: Only status is mutable. Allowed transitions are Open to In progress, In progress to Done, and Done to Open. Requests with immutable fields or other extra properties are rejected.\n167\t      requestBody:\n168\t        required: true\n169\t        content:\n170\t          application/json:\n171\t            schema:\n172\t              $ref: '#/components/schemas/ChangeRequestStatus'\n173\t            example:\n174\t              status: Done\n175\t      responses:\n176\t        '200':\n177\t          description: The request with its updated status.\n178\t          content:\n179\t            application/json:\n180\t              schema:\n181\t                $ref: '#/components/schemas/MaintenanceRequest'\n182\t              example:\n183\t                id: 2\n184\t                createdAt: '2026-03-17T09:00:00Z'\n185\t                title: \"Projector won't power on\"\n186\t                area: Meeting room\n187\t                priority: Normal\n188\t                status: Done\n189\t        '400':\n190\t          description: Unsupported status value or attempt to change an immutable field.\n191\t          content:\n192\t            application/json:\n193\t              schema:\n194\t                $ref: '#/components/schemas/ErrorResponse'\n195\t              example:\n196\t                message: Status must be Open, In progress, or Done; only status may be changed.\n197\t                errors:\n198\t                  status: [Unsupported status value.]\n199\t        '404':\n200\t          description: No request has this ID.\n201\t          content:\n202\t            application/json:\n203\t              schema:\n204\t                $ref: '#/components/schemas/ErrorResponse'\n205\t              example:\n206\t                message: Request not found.\n207\t        '409':\n208\t          description: The requested status transition is not allowed from the current status.\n209\t          content:\n210\t            application/json:\n211\t              schema:\n212\t                $ref: '#/components/schemas/ErrorResponse'\n213\t              example:\n214\t                message: This status transition is not allowed.\n215\t        '500':\n216\t          description: The status could not be updated.\n217\t          content:\n218\t            application/json:\n219\t              schema:\n220\t                $ref: '#/components/schemas/ErrorResponse'\n221\t              example:\n222\t                message: Could not update the request.\n223\tcomponents:\n224\t  schemas:\n225\t    RequestArea:\n226\t      type: string\n227\t      enum: [Kitchen, Meeting room, Open desk, Washroom, Reception]\n228\t    RequestPriority:\n229\t      type: string\n230\t      enum: [Low, Normal, Urgent]\n231\t    RequestStatus:\n232\t      type: string\n233\t      enum: [Open, In progress, Done]\n234\t    MaintenanceRequest:\n235\t      type: object\n236\t      additionalProperties: false\n237\t      required: [id, createdAt, title, area, priority, status]\n238\t      properties:\n239\t        id:\n240\t          type: integer\n241\t          format: int64\n242\t          minimum: 1\n243\t          description: System-generated request ID.\n244\t        createdAt:\n245\t          type: string\n246\t          format: date-time\n247\t          description: System-generated UTC timestamp.\n248\t        title:\n249\t          type: string\n250\t          minLength: 3\n251\t          maxLength: 80\n252\t        area:\n253\t          $ref: '#/components/schemas/RequestArea'\n254\t        priority:\n255\t          $ref: '#/components/schemas/RequestPriority'\n256\t        status:\n257\t          $ref: '#/components/schemas/RequestStatus'\n258\t        description:\n259\t          type: string\n260\t          maxLength: 500\n261\t    CreateRequest:\n262\t      type: object\n263\t      additionalProperties: false\n264\t      required: [title, area, priority]\n265\t      description: Title and description are trimmed before validation and storage. Optional id, createdAt, or status inputs are ignored and replaced by system values.\n266\t      properties:\n267\t        title:\n268\t          type: string\n269\t          minLength: 3\n270\t          maxLength: 80\n271\t        area:\n272\t          $ref: '#/components/schemas/RequestArea'\n273\t        priority:\n274\t          $ref: '#/components/schemas/RequestPriority'\n275\t        description:\n276\t          type: string\n277\t          maxLength: 500\n278\t        id:\n279\t          type: integer\n280\t          format: int64\n281\t          description: Optional caller-supplied value is ignored.\n282\t        createdAt:\n283\t          type: string\n284\t          format: date-time\n285\t          description: Optional caller-supplied value is ignored.\n286\t        status:\n287\t          allOf:\n288\t            - $ref: '#/components/schemas/RequestStatus'\n289\t          description: Optional caller-supplied value is ignored; created requests start Open.\n290\t    ChangeRequestStatus:\n291\t      type: object\n292\t      additionalProperties: false\n293\t      required: [status]\n294\t      properties:\n295\t        status:\n296\t          $ref: '#/components/schemas/RequestStatus'\n297\t    RequestList:\n298\t      type: object\n299\t      additionalProperties: false\n300\t      required: [requests]\n301\t      properties:\n302\t        requests:\n303\t          type: array\n304\t          items:\n305\t            $ref: '#/components/schemas/MaintenanceRequest'\n306\t    ErrorResponse:\n307\t      type: object\n308\t      additionalProperties: false\n309\t      required: [message]\n310\t      properties:\n311\t        message:\n312\t          type: string\n313\t        errors:\n314\t          type: object\n315\t          description: Field-keyed validation messages when applicable.\n316\t          additionalProperties:\n317\t            type: array\n318\t            items:\n319\t              type: string\n320\t\n</untrusted_document>"
