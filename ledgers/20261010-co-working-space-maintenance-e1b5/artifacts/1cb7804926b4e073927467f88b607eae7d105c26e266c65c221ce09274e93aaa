+namespace App.Api;
+
+// One stored maintenance request. IsDemo marks the sample rows SeedData adds; it never leaves the API.
+public class MaintenanceRequest
+{
+    public long Id { get; set; }
+    public DateTime CreatedAt { get; set; }
+    public string Title { get; set; } = "";
+    public string Area { get; set; } = "";
+    public string Priority { get; set; } = "";
+    public string Status { get; set; } = "";
+    public string? Description { get; set; }
+    public bool IsDemo { get; set; }
+}
+
+// The values the contract allows, spelled as the API sends and stores them.
+public static class RequestValues
+{
+    public static readonly string[] Areas = ["Kitchen", "Meeting room", "Open desk", "Washroom", "Reception"];
+    public static readonly string[] Priorities = ["Low", "Normal", "Urgent"];
+    public static readonly string[] Statuses = ["Open", "In progress", "Done"];
+}
