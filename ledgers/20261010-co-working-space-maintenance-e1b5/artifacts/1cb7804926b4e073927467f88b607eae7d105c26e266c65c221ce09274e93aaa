+using System.ComponentModel.DataAnnotations;
+using Microsoft.EntityFrameworkCore;
+
+namespace App.Api.Endpoints;
+
+// GET /api/requests: every request, or those with one status, newest first.
+public class ListRequestsEndpoint : IEndpoint
+{
+    public void Map(IEndpointRouteBuilder api) =>
+        api.MapGet("/requests", Handle)
+            .WithName("listRequests")
+            .WithSummary("List maintenance requests")
+            .Produces<RequestList>(StatusCodes.Status200OK)
+            .Produces<ErrorResponse>(StatusCodes.Status400BadRequest)
+            .Produces<ErrorResponse>(StatusCodes.Status500InternalServerError);
+
+    private static async Task<IResult> Handle([AllowedValues("Open", "In progress", "Done")] string? status, AppDb db)
+    {
+        if (status != null && !RequestValues.Statuses.Contains(status))
+            return ErrorResponse.Result(StatusCodes.Status400BadRequest, "Status must be Open, In progress, or Done.",
+                new() { ["status"] = ["Unsupported status filter."] });
+        try
+        {
+            var query = db.MaintenanceRequests.AsNoTracking();
+            if (status != null) query = query.Where(x => x.Status == status);
+            var rows = await query.OrderByDescending(x => x.CreatedAt).ThenByDescending(x => x.Id).ToListAsync();
+            return Results.Ok(new RequestList { Requests = rows.Select(MaintenanceRequestResource.From).ToList() });
+        }
+        catch (Exception)
+        {
+            return ErrorResponse.Result(StatusCodes.Status500InternalServerError, "Could not load requests.");
+        }
+    }
+}
