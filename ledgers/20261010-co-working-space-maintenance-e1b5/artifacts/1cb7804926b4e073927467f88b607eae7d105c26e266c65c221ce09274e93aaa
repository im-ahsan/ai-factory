+using System.ComponentModel.DataAnnotations;
+using System.Reflection;
+using System.Text.Json.Serialization;
+using Microsoft.AspNetCore.Mvc.Infrastructure;
+using Microsoft.AspNetCore.OpenApi;
+using Microsoft.OpenApi.Any;
+
+namespace App.Api;
+
+// One operation of the contract, in its own file under Endpoints/. MapEndpoints finds every one in this assembly and maps it
+// under /api, so a new operation needs only its own class.
+public interface IEndpoint
+{
+    void Map(IEndpointRouteBuilder api);
+}
+
+public static class EndpointRegistration
+{
+    public static void MapEndpoints(this WebApplication app)
+    {
+        var api = app.MapGroup("/api");
+        var endpoints = typeof(IEndpoint).Assembly.GetTypes()
+            .Where(t => t is { IsClass: true, IsAbstract: false } && typeof(IEndpoint).IsAssignableFrom(t))
+            .OrderBy(t => t.FullName, StringComparer.Ordinal);
+        foreach (var type in endpoints) ((IEndpoint)Activator.CreateInstance(type)!).Map(api);
+    }
+
+    // The contract names the response schema MaintenanceRequest and lists the allowed values of area, priority and status:
+    // write [AllowedValues] properties and parameters as enums so the API's document says the same.
+    public static void UseContractSchemas(this OpenApiOptions o)
+    {
+        o.CreateSchemaReferenceId = t => t.Type == typeof(MaintenanceRequestResource)
+            ? "MaintenanceRequest"
+            : OpenApiOptions.CreateDefaultSchemaReferenceId(t);
+        o.AddSchemaTransformer((schema, context, _) =>
+        {
+            var allowed = context.JsonPropertyInfo?.AttributeProvider?.GetCustomAttributes(typeof(AllowedValuesAttribute), true)
+                    .OfType<AllowedValuesAttribute>().FirstOrDefault()
+                ?? (context.ParameterDescription?.ParameterDescriptor as IParameterInfoParameterDescriptor)?.ParameterInfo
+                    .GetCustomAttribute<AllowedValuesAttribute>();
+            if (allowed != null) schema.Enum = allowed.Values.Select(v => (IOpenApiAny)new OpenApiString((string)v!)).ToList();
+            // a property left out when null is optional in the contract, never null
+            if (context.JsonPropertyInfo?.AttributeProvider?.IsDefined(typeof(JsonIgnoreAttribute), true) == true) schema.Nullable = false;
+            return Task.CompletedTask;
+        });
+    }
+}
