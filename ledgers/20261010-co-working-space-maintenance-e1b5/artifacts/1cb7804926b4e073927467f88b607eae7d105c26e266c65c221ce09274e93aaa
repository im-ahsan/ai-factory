 using Microsoft.EntityFrameworkCore;
+using Microsoft.EntityFrameworkCore.Infrastructure;
+using Microsoft.EntityFrameworkCore.Storage;
 
 namespace App.Api;
 
 public class AppDb(DbContextOptions<AppDb> options) : DbContext(options)
 {
+    public DbSet<MaintenanceRequest> MaintenanceRequests => Set<MaintenanceRequest>();
+
+    // EnsureCreated adds no table to a database that already holds others, so add ours to such a database as well,
+    // leaving its other tables alone.
+    public void CreateMissingTables()
+    {
+        if (Database.EnsureCreated()) return;
+        var missing = Database.SqlQuery<bool>($"SELECT to_regclass('\"MaintenanceRequests\"') IS NULL AS \"Value\"").Single();
+        if (missing) Database.GetService<IRelationalDatabaseCreator>().CreateTables();
+    }
+
+    protected override void OnModelCreating(ModelBuilder modelBuilder)
+    {
+        modelBuilder.Entity<MaintenanceRequest>(e =>
+        {
+            e.Property(x => x.Title).HasMaxLength(80);
+            e.Property(x => x.Area).HasMaxLength(20);
+            e.Property(x => x.Priority).HasMaxLength(20);
+            e.Property(x => x.Status).HasMaxLength(20);
+            // stored as UTC without a zone, so rows written by hand read back the same; read back marked as UTC
+            e.Property(x => x.CreatedAt).HasColumnType("timestamp without time zone")
+                .HasConversion(v => DateTime.SpecifyKind(v, DateTimeKind.Unspecified), v => DateTime.SpecifyKind(v, DateTimeKind.Utc));
+        });
+    }
 }
