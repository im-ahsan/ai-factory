+using System.ComponentModel.DataAnnotations;
+using System.Text.Json.Serialization;
+
+namespace App.Api;
+
+// A request as the contract's MaintenanceRequest schema sends it: no IsDemo, and no description when there is none.
+public sealed class MaintenanceRequestResource
+{
+    public required long Id { get; init; }
+    public required DateTime CreatedAt { get; init; }
+    public required string Title { get; init; }
+    [AllowedValues("Kitchen", "Meeting room", "Open desk", "Washroom", "Reception")]
+    public required string Area { get; init; }
+    [AllowedValues("Low", "Normal", "Urgent")]
+    public required string Priority { get; init; }
+    [AllowedValues("Open", "In progress", "Done")]
+    public required string Status { get; init; }
+    [JsonIgnore(Condition = JsonIgnoreCondition.WhenWritingNull)]
+    public string? Description { get; init; }
+
+    public static MaintenanceRequestResource From(MaintenanceRequest r) => new()
+    {
+        Id = r.Id,
+        CreatedAt = DateTime.SpecifyKind(r.CreatedAt, DateTimeKind.Utc),
+        Title = r.Title,
+        Area = r.Area,
+        Priority = r.Priority,
+        Status = r.Status,
+        Description = r.Description,
+    };
+}
+
+public sealed class RequestList
+{
+    public required IReadOnlyList<MaintenanceRequestResource> Requests { get; init; }
+}
+
+// The contract's ErrorResponse: a message, and field-keyed messages when a field was at fault.
+public sealed class ErrorResponse
+{
+    public required string Message { get; init; }
+    [JsonIgnore(Condition = JsonIgnoreCondition.WhenWritingNull)]
+    public Dictionary<string, string[]>? Errors { get; init; }
+
+    public static IResult Result(int statusCode, string message, Dictionary<string, string[]>? errors = null) =>
+        Results.Json(new ErrorResponse { Message = message, Errors = errors }, statusCode: statusCode);
+}
