+using System.Text.Json.Serialization;
+using System.Text.Json.Serialization.Metadata;
+using Microsoft.AspNetCore.OpenApi;
+using Microsoft.OpenApi.Any;
+using Microsoft.OpenApi.Models;
+
+namespace App.Api;
+
+// Every class that implements this and sits in this assembly is found and mapped under /api at startup.
+public interface IEndpointRegistrar
+{
+    void Map(RouteGroupBuilder api);
+}
+
+public static class EndpointRegistration
+{
+    public static void MapEndpointRegistrars(this WebApplication app)
+    {
+        var api = app.MapGroup("/api");
+        var registrars = typeof(IEndpointRegistrar).Assembly.GetTypes()
+            .Where(t => t is { IsClass: true, IsAbstract: false } && typeof(IEndpointRegistrar).IsAssignableFrom(t))
+            .OrderBy(t => t.FullName, StringComparer.Ordinal);
+        foreach (var type in registrars) ((IEndpointRegistrar)Activator.CreateInstance(type)!).Map(api);
+    }
+}
+
+// Makes the generated OpenAPI document say what contracts/openapi.yaml says where the C# types cannot.
+public static class ContractOpenApi
+{
+    private static readonly Dictionary<string, string[]> Enums = new()
+    {
+        ["area"] = ["Kitchen", "Meeting room", "Open desk", "Washroom", "Reception"],
+        ["priority"] = ["Low", "Normal", "Urgent"],
+        ["status"] = ["Open", "In progress", "Done"],
+    };
+
+    private static List<IOpenApiAny> EnumValues(string name) => Enums[name].Select(v => (IOpenApiAny)new OpenApiString(v)).ToList();
+
+    private static bool OmittedWhenNull(JsonPropertyInfo p) =>
+        p.AttributeProvider?.GetCustomAttributes(typeof(JsonIgnoreAttribute), true)
+            .OfType<JsonIgnoreAttribute>().Any(a => a.Condition == JsonIgnoreCondition.WhenWritingNull) == true;
+
+    public static Task Schema(OpenApiSchema schema, OpenApiSchemaTransformerContext context, CancellationToken ct)
+    {
+        if (context.JsonPropertyInfo is { } property)
+        {
+            if (OmittedWhenNull(property)) { schema.Nullable = false; schema.Default = null; }
+            if (property.DeclaringType == typeof(MaintenanceRequestResource) && Enums.ContainsKey(property.Name)) schema.Enum = EnumValues(property.Name);
+        }
+        else if (context.JsonTypeInfo.Kind == JsonTypeInfoKind.Object)
+        {
+            foreach (var property2 in context.JsonTypeInfo.Properties.Where(OmittedWhenNull)) schema.Required.Remove(property2.Name);
+        }
+        return Task.CompletedTask;
+    }
+
+    public static Task Operation(OpenApiOperation operation, OpenApiOperationTransformerContext context, CancellationToken ct)
+    {
+        foreach (var parameter in operation.Parameters.Where(p => p.In == ParameterLocation.Query && p.Name == "status"))
+            parameter.Schema.Enum = EnumValues("status");
+        return Task.CompletedTask;
+    }
+}
