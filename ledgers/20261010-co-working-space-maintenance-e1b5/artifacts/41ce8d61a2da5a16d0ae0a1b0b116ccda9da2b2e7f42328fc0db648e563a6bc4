+using Microsoft.EntityFrameworkCore;
+
+namespace App.Api.Endpoints;
+
+public class ListRequestsEndpoint : IEndpointRegistrar
+{
+    private static readonly string[] Statuses = ["Open", "In progress", "Done"];
+
+    public void Map(RouteGroupBuilder api) =>
+        api.MapGet("/requests", List)
+            .WithName("listRequests")
+            .Produces<RequestListResource>(StatusCodes.Status200OK)
+            .Produces<ErrorResponse>(StatusCodes.Status400BadRequest)
+            .Produces<ErrorResponse>(StatusCodes.Status500InternalServerError);
+
+    private static async Task<IResult> List(AppDb db, string? status, CancellationToken ct)
+    {
+        if (status is not null && !Statuses.Contains(status))
+            return Results.Json(
+                new ErrorResponse("Status must be Open, In progress, or Done.",
+                    new() { ["status"] = ["Unsupported status filter."] }),
+                statusCode: StatusCodes.Status400BadRequest);
+        try
+        {
+            var query = db.MaintenanceRequests.AsNoTracking();
+            if (status is not null) query = query.Where(r => r.Status == status);
+            var requests = await query
+                .OrderByDescending(r => r.CreatedAt).ThenByDescending(r => r.Id)
+                .Select(r => new MaintenanceRequestResource(r.Id, r.CreatedAt, r.Title, r.Area, r.Priority, r.Status, r.Description))
+                .ToListAsync(ct);
+            return Results.Ok(new RequestListResource(requests));
+        }
+        catch (Exception) when (!ct.IsCancellationRequested)
+        {
+            return Results.Json(new ErrorResponse("Could not load requests."), statusCode: StatusCodes.Status500InternalServerError);
+        }
+    }
+}
