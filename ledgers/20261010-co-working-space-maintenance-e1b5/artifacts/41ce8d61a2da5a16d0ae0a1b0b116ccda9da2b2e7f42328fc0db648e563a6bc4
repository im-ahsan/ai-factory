+using System.Text.Json.Serialization;
+
+namespace App.Api;
+
+// What the API returns for a request: the internal demo marker is not part of it.
+public record MaintenanceRequestResource(
+    long Id,
+    DateTime CreatedAt,
+    string Title,
+    string Area,
+    string Priority,
+    string Status,
+    [property: JsonIgnore(Condition = JsonIgnoreCondition.WhenWritingNull)] string? Description);
+
+public record RequestListResource(List<MaintenanceRequestResource> Requests);
+
+public record ErrorResponse(
+    string Message,
+    [property: JsonIgnore(Condition = JsonIgnoreCondition.WhenWritingNull)] Dictionary<string, string[]>? Errors = null);
