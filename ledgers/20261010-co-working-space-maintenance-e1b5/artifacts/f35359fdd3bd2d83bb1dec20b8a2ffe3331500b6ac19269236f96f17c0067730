{"partial":true,"path":"App.Api/openapi/built.json","text":"{\n  \"openapi\": \"3.0.1\",\n  \"info\": {\n    \"title\": \"App.Api | v1\",\n    \"version\": \"1.0.0\"\n  },\n  \"paths\": {\n    \"/api/requests\": {\n      \"get\": {\n        \"tags\": [\n          \"ListRequestsEndpoint\"\n        ],\n        \"summary\": \"List maintenance requests\",\n        \"operationId\": \"listRequests\",\n        \"parameters\": [\n          {\n            \"name\": \"status\",\n            \"in\": \"query\",\n            \"schema\": {\n              \"enum\": [\n                \"Open\",\n                \"In progress\",\n                \"Done\"\n              ],\n              \"type\": \"string\"\n            }\n          }\n        ],\n        \"responses\": {\n          \"200\": {\n            \"description\": \"OK\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/RequestList\"\n                }\n              }\n            }\n          },\n          \"400\": {\n            \"description\": \"Bad Request\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/ErrorResponse\"\n                }\n              }\n            }\n          },\n          \"500\": {\n            \"description\": \"Internal Server Error\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/ErrorResponse\"\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  },\n  \"components\": {\n    \"schemas\": {\n      \"ErrorResponse\": {\n        \"required\": [\n          \"message\"\n        ],\n        \"type\": \"object\",\n        \"properties\": {\n          \"message\": {\n            \"type\": \"string\"\n          },\n          \"errors\": {\n            \"type\": \"object\",\n            \"additionalProperties\": {\n              \"type\": \"array\",\n              \"items\": {\n                \"type\": \"string\"\n              }\n            }\n          }\n        }\n      },\n      \"MaintenanceRequest\": {\n        \"required\": [\n          \"id\",\n          \"createdAt\",\n          \"title\",\n          \"area\",\n          \"priority\",\n          \"status\"\n        ],\n        \"type\": \"object\",\n        \"properties\": {\n          \"id\": {\n            \"type\": \"integer\",\n            \"format\": \"int64\"\n          },\n          \"createdAt\": {\n            \"type\": \"string\",\n            \"format\": \"date-time\"\n          },\n          \"title\": {\n            \"type\": \"string\"\n          },\n          \"area\": {\n            \"enum\": [\n              \"Kitchen\",\n              \"Meeting room\",\n              \"Open desk\",\n              \"Washroom\",\n              \"Reception\"\n            ],\n            \"type\": \"string\"\n          },\n          \"priority\": {\n            \"enum\": [\n              \"Low\",\n              \"Normal\",\n              \"Urgent\"\n            ],\n            \"type\": \"string\"\n          },\n          \"status\": {\n            \"enum\": [\n              \"Open\",\n              \"In progress\",\n              \"Done\"\n            ],\n            \"type\": \"string\"\n          },\n          \"description\": {\n            \"type\": \"string\"\n          }\n        }\n      },\n      \"RequestList\": {\n        \"required\": [\n          \"requests\"\n        ],\n        \"type\": \"object\",\n        \"properties\": {\n          \"requests\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"$ref\": \"#/components/schemas/MaintenanceRequest\"\n            }\n          }\n        }\n      }\n    }\n  },\n  \"tags\": [\n    {\n      \"name\": \"ListRequestsEndpoint\"\n    }\n  ]\n}"}