+using Microsoft.EntityFrameworkCore;
+
+namespace App.Api.Endpoints;
+
+// GET /api/requests/{id} (getRequest): one request by id; an id that is not a positive integer matches no request.
+public sealed class GetRequestEndpoint : IEndpointRegistrar
+{
+    private const string NotFound = "Request not found.";
+
+    public void Map(RouteGroupBuilder api)
+    {
+        api.MapGet("/requests/{id:long}", Handle)
+            .WithName("getRequest")
+            .WithSummary("Get a maintenance request")
+            .Produces<MaintenanceRequestResource>()
+            .Produces<ErrorResponse>(StatusCodes.Status404NotFound)
+            .Produces<ErrorResponse>(StatusCodes.Status500InternalServerError);
+
+        api.MapGet("/requests/{id}", () => Results.NotFound(new ErrorResponse(NotFound)))
+            .ExcludeFromDescription();
+    }
+
+    private static async Task<IResult> Handle(long id, AppDb db, CancellationToken ct)
+    {
+        if (id < 1) return Results.NotFound(new ErrorResponse(NotFound));
+
+        try
+        {
+            var row = await db.MaintenanceRequests.AsNoTracking().FirstOrDefaultAsync(r => r.Id == id, ct);
+            return row is null
+                ? Results.NotFound(new ErrorResponse(NotFound))
+                : Results.Ok(MaintenanceRequestResource.From(row));
+        }
+        catch (Exception) when (!ct.IsCancellationRequested)
+        {
+            return Results.Json(new ErrorResponse("Could not load the request."), statusCode: StatusCodes.Status500InternalServerError);
+        }
+    }
+}
