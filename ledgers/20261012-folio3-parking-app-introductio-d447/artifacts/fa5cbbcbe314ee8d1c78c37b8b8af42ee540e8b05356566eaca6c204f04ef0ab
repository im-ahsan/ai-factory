<div class="max-w-[1400px] mx-auto flex flex-col sm:flex-row items-center justify-between text-dim-grey text-xs font-mono">
<div>© 2025 Folio3 Bay Control — Corporate Facility Parking System</div>
<div class="mt-1 sm:mt-0 text-[11px] tracking-wider text-dim-grey/70">TABULAR LIVE STREAM ACTIVE</div>
</div>
</footer>
