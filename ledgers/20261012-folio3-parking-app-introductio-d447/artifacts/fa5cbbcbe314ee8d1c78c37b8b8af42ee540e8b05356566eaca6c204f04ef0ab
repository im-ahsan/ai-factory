<!-- System Security Verification Micro-Footnote -->
<div class="mt-5 flex items-center justify-center space-x-2 text-dim-grey seq-3">
<span class="material-symbols-outlined text-xs leading-none" data-icon="verified_user">verified_user</span>
<span class="font-mono text-[11px] tracking-wide">Synced with Folio3 Barrier Gate Subsystem v2.4</span>
</div>
</div>
