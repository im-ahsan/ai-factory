<style>
    :root {
      --dur-instant: 90ms;
      --dur-quick: 160ms;
      --dur-base: 260ms;
      --dur-slow: 420ms;
      --dur-scene: 800ms;
      --ease-out: cubic-bezier(0.16, 1, 0.3, 1);
      --ease-in: cubic-bezier(0.7, 0, 0.84, 0);
      --ease-inout: cubic-bezier(0.65, 0, 0.35, 1);
      --travel: 8px;
      --bay-cyan: #2BA8D6;
      --deep-bay: #0A1013;
      --bay-panel: #0F181C;
      --bay-lift: #152227;
      --hairline: rgba(196, 228, 240, 0.09);
      --hairline-strong: rgba(196, 228, 240, 0.18);
    }

    /* Ambient breathing ring on live telemetry dot */
    @keyframes breathe {
      0%, 100% {
        transform: scale(1);
        opacity: 0.95;
      }
      50% {
        transform: scale(1.25);
        opacity: 0.4;
      }
    }

    .live-dot-pulse {
      position: relative;
    }
    .live-dot-pulse::after {
      content: "";
      position: absolute;
      inset: -3px;
      border-radius: 9999px;
      border: 1px solid var(--bay-cyan);
      animation: breathe 6s var(--ease-inout) infinite;
      pointer-events: none;
    }

    /* Staggered entrance sequence */
    @keyframes rise-in {
      from {
        opacity: 0;
        transform: translateY(var(--travel));
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .seq-0 {
      animation: rise-in var(--dur-slow) var(--ease-out) 0ms both;
    }
    .seq-1 {
      animation: rise-in var(--dur-slow) var(--ease-out) 70ms both;
    }
    .seq-2 {
      animation: rise-in var(--dur-slow) var(--ease-out) 140ms both;
    }
    .seq-3 {
      animation: rise-in var(--dur-slow) var(--ease-out) 210ms both;
    }

    /* Tabular mono inputs */
    .mono-plate-input {
      font-variant-numeric: tabular-nums;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    /* Subtle hair-rule border utility */
    .hairline-border {
      border: 1px solid var(--hairline);
    }
    .hairline-strong-border {
      border: 1px solid var(--hairline-strong);
    }

    /* Bay stencil badge top border */
    .stencil-indicator {
      border-top: 3px solid var(--bay-cyan);
    }

    /* Focus and active transitions */
    .instrument-input {
      transition: border-color var(--dur-quick) var(--ease-out), box-shadow var(--dur-quick) var(--ease-out);
    }
    .instrument-input:focus {
      outline: none;
      border-color: var(--bay-cyan);
      box-shadow: 0 0 0 2px rgba(43, 168, 214, 0.25);
    }

    .btn-action {
      transition: background-color var(--dur-quick) var(--ease-out), transform var(--dur-instant) var(--ease-out), opacity var(--dur-quick) var(--ease-out);
    }
    .btn-action:hover {
      background-color: #3bb8e6;
    }
    .btn-action:active {
      transform: scale(0.98);
      background-color: #2497c2;
    }

    @media (prefers-reduced-motion: reduce) {
      *, .live-dot-pulse::after, .seq-0, .seq-1, .seq-2, .seq-3, .btn-action {
        animation: none !important;
        transition: opacity 120ms linear !important;
        transform: none !important;
      }
    }
  </style>
</head>
<body class="bg-deep-bay text-signal-ink font-body min-h-screen antialiased flex flex-col justify-between selection:bg-primary-container selection:text-deep-bay">
<!-- TOP STRIP: Header utility bar (Full width container, max-w-[1400px], no generic nav links) -->
<header class="w-full bg-deep-bay border-b border-[rgba(196,228,240,0.08)] seq-0">
<div class="max-w-[1400px] mx-auto px-6 h-14 flex items-center justify-between">
<!-- Left: Wordmark & Live Telemetry Badge -->
<div class="flex items-center space-x-4">
<div class="flex items-center space-x-2">
<span class="font-headline text-xs font-semibold tracking-wider text-signal-ink uppercase">FOLIO3 PARKING</span>
<span class="text-dim-grey text-xs font-mono select-none">/</span>
<span class="font-headline text-xs font-medium text-instrument-grey tracking-tight">Bay Control</span>
</div>
<!-- Telemetry Live Status Dot Indicator -->
<div class="flex items-center space-x-2 pl-3 border-l border-[rgba(196,228,240,0.1)]">
<div class="relative flex items-center justify-center w-2.5 h-2.5">
<span class="live-dot-pulse w-1.5 h-1.5 rounded-full bg-bay-cyan block"></span>
</div>
<span class="font-mono text-[11px] uppercase tracking-widest text-instrument-grey select-none">LIVE</span>
</div>
</div>
<!-- Right: Single Strict Navigation Link worded exactly "Sign out" -->
<div>
<a class="font-headline text-xs font-medium text-instrument-grey hover:text-signal-ink transition-colors duration-160 inline-flex items-center tracking-tight active:scale-[0.98]" href="#signout">
          Sign out
        </a>
</div>
</div>
</header>
<!-- MAIN VIEWPORT CANVAS: Centered single-column container (560px max width) -->
<main class="flex-1 flex flex-col justify-center items-center px-4 py-8 sm:py-12 w-full">
<div class="w-full max-w-[560px] flex flex-col">
<!-- HERO SECTION -->
<section class="mb-7 seq-1">
<div class="inline-flex items-center space-x-2 mb-3">
<span class="font-mono text-[10px] tracking-widest uppercase text-bay-cyan px-1.5 py-0.5 rounded-sm bg-[rgba(43,168,214,0.12)] border border-[rgba(43,168,214,0.25)]">
            STEP 01 // FIRST REGISTRATION
          </span>
</div>
<h1 class="font-headline text-2xl sm:text-[26px] font-semibold text-signal-ink tracking-tight leading-snug">
          Add your car to start claiming spaces
        </h1>
<p class="font-body text-sm text-instrument-grey mt-2 leading-relaxed">
          The entrance camera only opens for the plate you choose when you claim, so we need at least one car on file.
        </p>
</section>
<!-- VEHICLE DETAILS FORM CARD -->
<section class="bg-bay-panel rounded-md hairline-border p-6 sm:p-7 relative seq-2 stencil-indicator">
<form action="#" class="space-y-6" method="POST" onsubmit="return false;">
<!-- LICENSE PLATE FIELD -->
<div class="space-y-2">
<div class="flex items-center justify-between">
<label class="font-headline text-[11px] font-medium uppercase tracking-[0.08em] text-instrument-grey" for="plate-input">
                Licence plate <span class="text-bay-cyan font-mono text-[10px] lowercase tracking-normal">(required)</span>
</label>
<span class="font-mono text-[10px] text-dim-grey uppercase tracking-wider">ANPR READY</span>
</div>
<!-- License plate cockpit frame -->
<div class="relative">
<input autocomplete="off" class="instrument-input w-full bg-deep-bay text-signal-ink font-mono text-2xl sm:text-3xl font-semibold px-4 py-3 rounded-md hairline-strong-border mono-plate-input placeholder:text-dim-grey/50 placeholder:font-normal focus:bg-deep-bay" id="plate-input" name="plate" placeholder="BKR-417" required="" spellcheck="false" type="text"/>
<div class="absolute right-3.5 top-1/2 -translate-y-1/2 pointer-events-none">
<span class="material-symbols-outlined text-dim-grey text-xl select-none" data-icon="directions_car">directions_car</span>
</div>
</div>
<p class="font-body text-xs text-instrument-grey leading-normal pt-0.5">
              Letters and numbers as on the plate; spacing and case don't matter.
            </p>
</div>
<!-- THREE OPTIONAL FIELDS: 3-Column Split -->
<div class="pt-2 border-t border-[rgba(196,228,240,0.06)]">
<div class="mb-3 flex items-center justify-between">
<span class="font-headline text-[11px] font-medium uppercase tracking-[0.08em] text-dim-grey">
                Vehicle Specifications <span class="text-dim-grey font-mono text-[10px] lowercase tracking-normal">(optional)</span>
</span>
</div>
<div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
<!-- Field 1: Make -->
<div class="space-y-1.5">
<label class="block font-headline text-[11px] font-medium uppercase tracking-[0.08em] text-instrument-grey" for="make-input">
                  Make
                </label>
<input class="instrument-input w-full bg-deep-bay text-signal-ink text-sm px-3 h-10 rounded-md hairline-strong-border placeholder:text-dim-grey focus:bg-deep-bay" id="make-input" name="make" placeholder="Toyota" type="text"/>
</div>
<!-- Field 2: Model -->
<div class="space-y-1.5">
<label class="block font-headline text-[11px] font-medium uppercase tracking-[0.08em] text-instrument-grey" for="model-input">
                  Model
                </label>
<input class="instrument-input w-full bg-deep-bay text-signal-ink text-sm px-3 h-10 rounded-md hairline-strong-border placeholder:text-dim-grey focus:bg-deep-bay" id="model-input" name="model" placeholder="Corolla" type="text"/>
</div>
<!-- Field 3: Colour -->
<div class="space-y-1.5">
<label class="block font-headline text-[11px] font-medium uppercase tracking-[0.08em] text-instrument-grey" for="colour-input">
