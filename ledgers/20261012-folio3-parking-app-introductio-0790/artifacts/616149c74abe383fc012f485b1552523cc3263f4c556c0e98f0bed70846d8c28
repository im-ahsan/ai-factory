<!DOCTYPE html>
<html lang="en" class="h-full bg-[#fbf9f6] text-neutral-800">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Available spaces - Folio3 Parking</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:ital,wght@0,300..800;1,300..800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['"Hanken Grotesk"', 'sans-serif'],
            mono: ['"JetBrains Mono"', 'monospace'],
          },
          colors: {
            brand: {
              DEFAULT: '#A95540',
              hover: '#934734',
              active: '#7d3a29',
              subtle: '#FAF0ED',
              border: '#E8CEC5',
            }
          }
        }
      }
    }
  </script>
  <style>
    @keyframes pageEntrance {
      0% { opacity: 0; transform: translateY(6px); }
      100% { opacity: 1; transform: translateY(0); }
    }
    @keyframes evalDotPulse {
      0%, 100% { opacity: 0.76; }
      50% { opacity: 1.0; }
    }

    body {
      font-family: 'Hanken Grotesk', sans-serif;
      animation: pageEntrance 320ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    .font-mono {
      font-family: 'JetBrains Mono', monospace;
    }

    .ambient-dot {
      animation: evalDotPulse 7.5s cubic-bezier(0.65, 0, 0.35, 1) infinite;
    }

    @media (prefers-reduced-motion: reduce) {
      body, .ambient-dot, .signature-motion {
        animation: none !important;
        transition: none !important;
      }
    }
  </style>
</head>
<body class="min-h-full flex flex-col bg-[#FAF8F5] text-neutral-800 antialiased selection:bg-stone-200">

  <!-- Shared Header -->
  <header class="w-full bg-white border-b border-neutral-200 sticky top-0 z-50">
    <div class="max-w-6xl mx-auto px-6 h-16 flex items-center justify-between">
      <!-- Left: Brand & Menu -->
      <div class="flex items-center gap-8">
        <a href="#" class="font-semibold text-lg text-neutral-900 tracking-tight shrink-0">
          Folio3 Parking
        </a>
        <nav class="hidden md:flex items-center gap-6 text-sm" aria-label="Main menu">
          <a href="#" class="text-neutral-600 hover:text-neutral-900 transition-colors py-5 border-b-2 border-transparent">Parking home</a>
          <a href="#" class="text-neutral-900 font-semibold py-5 border-b-2 border-[#A95540]" aria-current="page">Available spaces</a>
          <a href="#" class="text-neutral-600 hover:text-neutral-900 transition-colors py-5 border-b-2 border-transparent">Give up my space today</a>
          <a href="#" class="text-neutral-600 hover:text-neutral-900 transition-colors py-5 border-b-2 border-transparent">Schedule releases</a>
          <a href="#" class="text-neutral-600 hover:text-neutral-900 transition-colors py-5 border-b-2 border-transparent">Add or update a vehicle</a>
        </nav>
      </div>

      <!-- Right: Rohan Mehta Profile Menu -->
      <div class="flex items-center gap-3">
        <div class="flex items-center gap-2.5 text-right">
          <div class="hidden sm:block">
            <div class="text-sm font-semibold text-neutral-900 leading-snug">Rohan Mehta</div>
            <div class="text-xs text-neutral-500">Employee</div>
          </div>
          <img src="https://lh3.googleusercontent.com/aida-public/AB6AXuD2o0oNc7OL60DDqx6VTnC8JekrlS1U2Z5VKbCXCtEXgA2WQ4HuZqr-JnjFdQruChsmEAfhF0YlcFpnmsardmqWPBLD8QukZprW_YEBED63NdzZxk1oTDJWu8HdzpyDNxYiJHWNMB1YPk4RE-aGayJ8AiSxuk-WWJ-JH1XjLdx814nwUt3xQuIw0uzOCu91ofP1uBah2AL4TIYFSW-X_vW3UqT4JTZOcPtsLNmYQEfGb9WHs2a26aeJcPOh578V5Ccq5ZdT58SS" alt="Rohan Mehta" class="w-9 h-9 rounded-full object-cover border border-neutral-200 shadow-sm" />
        </div>
      </div>
    </div>
  </header>

  <!-- Mobile Navigation Bar -->
  <div class="md:hidden w-full bg-white border-b border-neutral-200 px-6 py-2 overflow-x-auto">
    <div class="flex items-center gap-5 text-sm whitespace-nowrap">
      <a href="#" class="text-neutral-600 py-1.5">Parking home</a>
      <a href="#" class="text-neutral-900 font-semibold border-b-2 border-[#A95540] py-1.5">Available spaces</a>
      <a href="#" class="text-neutral-600 py-1.5">Give up my space today</a>
      <a href="#" class="text-neutral-600 py-1.5">Schedule releases</a>
      <a href="#" class="text-neutral-600 py-1.5">Add or update a vehicle</a>
    </div>
  </div>

  <!-- Main Content Container -->
  <main class="flex-1 max-w-6xl w-full mx-auto px-6 py-8 md:py-10">

    <!-- Eligible Employee Context Strip -->
    <section class="bg-white border border-neutral-200/90 rounded-lg p-5 mb-8 shadow-[0_1px_2px_rgba(0,0,0,0.03)] flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div class="flex items-center gap-4">
        <img src="https://lh3.googleusercontent.com/aida-public/AB6AXuD2o0oNc7OL60DDqx6VTnC8JekrlS1U2Z5VKbCXCtEXgA2WQ4HuZqr-JnjFdQruChsmEAfhF0YlcFpnmsardmqWPBLD8QukZprW_YEBED63NdzZxk1oTDJWu8HdzpyDNxYiJHWNMB1YPk4RE-aGayJ8AiSxuk-WWJ-JH1XjLdx814nwUt3xQuIw0uzOCu91ofP1uBah2AL4TIYFSW-X_vW3UqT4JTZOcPtsLNmYQEfGb9WHs2a26aeJcPOh578V5Ccq5ZdT58SS" alt="Rohan Mehta portrait" class="w-12 h-12 rounded-full object-cover border border-neutral-200 shrink-0" />
        <div>
          <div class="flex items-center gap-2">
            <h1 class="text-base font-semibold text-neutral-900">Rohan Mehta</h1>
            <span class="text-xs bg-neutral-100 text-neutral-600 font-medium px-2 py-0.5 rounded">Engineering</span>
          </div>
          <p class="text-xs text-neutral-500 mt-0.5">
            Eligible employee · No dedicated space assignment
          </p>
        </div>
      </div>

      <div class="flex items-center gap-6 border-t sm:border-t-0 sm:border-l border-neutral-100 pt-3 sm:pt-0 sm:pl-6 text-xs text-neutral-600">
        <div>
          <span class="block text-neutral-400 font-medium text-[11px] uppercase tracking-wider">Registered Vehicle</span>
          <span class="font-mono font-semibold text-neutral-800 text-sm">KA05PQ7712</span>
        </div>
        <div>
          <span class="block text-neutral-400 font-medium text-[11px] uppercase tracking-wider">Daily Cutoff Rule</span>
          <span class="font-medium text-neutral-700">Released daily at 9:00 AM IST</span>
        </div>
      </div>
    </section>

    <!-- Page Title & Primary Eyeball Readout -->
    <div class="mb-6">
      <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-2 border-b border-neutral-200/80 pb-4">
        <div>
          <div class="flex items-baseline gap-3">
            <h2 class="text-3xl font-bold tracking-tight text-neutral-900">
              0 spaces free
            </h2>
            <span class="text-sm font-medium text-neutral-500">
              for Tue 19 May 2026 at <span class="font-mono text-neutral-700 font-medium">9:15 AM IST</span>
            </span>
          </div>
          <p class="text-sm text-neutral-600 mt-1">
            Claim a released space for today.
          </p>
        </div>

        <!-- Evaluation dot status indicator -->
        <div class="inline-flex items-center gap-2 text-xs font-medium text-neutral-600 bg-neutral-100/90 px-3 py-1.5 rounded-full self-start sm:self-auto border border-neutral-200/60">
          <span class="w-2 h-2 rounded-full bg-emerald-600 ambient-dot"></span>
          <span>Bengaluru Office pool evaluated</span>
        </div>
      </div>
    </div>

    <!-- Desktop Grid: Count & Eligibility Note beside list / Stacks on phone -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">

      <!-- Left / Primary Column: Empty State List Area (7 cols on desktop) -->
      <section class="lg:col-span-8 flex flex-col">
        <div class="bg-white border border-neutral-200 rounded-lg p-8 sm:p-12 shadow-[0_1px_2px_rgba(0,0,0,0.03)] text-center flex flex-col items-center justify-center min-h-[340px]">
          <div class="w-12 h-12 rounded-full bg-neutral-100 flex items-center justify-center text-neutral-400 mb-4">
            <span class="material-symbols-outlined text-2xl">local_parking</span>
          </div>
          <h3 class="text-base font-semibold text-neutral-900 mb-1">
            No released spaces available right now
          </h3>
          <p class="text-sm text-neutral-500 max-w-md mx-auto mb-6 leading-relaxed">
            All campus stalls across levels P1 and P2 are currently occupied or assigned for today. Stalls are released by colleagues when working remotely or on leave.
          </p>

          <!-- The single action that adds the first record -->
          <button 
            type="button"
            class="inline-flex items-center justify-center px-4 py-2.5 rounded-md bg-[#A95540] hover:bg-[#934734] active:bg-[#7d3a29] text-white text-sm font-medium shadow-sm transition-colors focus:outline-none focus:ring-2 focus:ring-[#A95540] focus:ring-offset-2 touch-manipulation">
            Give up my space today
          </button>
        </div>

        <div class="mt-4 flex items-center justify-between text-xs text-neutral-500 px-1">
          <span>First accepted claim gets the space.</span>
          <span>Once claimed, this space can’t be cancelled.</span>
        </div>
      </section>

      <!-- Right Column: Eligibility Note & Policy details (4 cols on desktop) -->
      <aside class="lg:col-span-4 flex flex-col gap-5">
        
        <!-- Eligibility Card -->
        <div class="bg-white border border-neutral-200 rounded-lg p-5 shadow-[0_1px_2px_rgba(0,0,0,0.03)]">
          <h3 class="text-xs font-semibold text-neutral-400 uppercase tracking-wider mb-3">
            Eligibility & Allocation Rules
          </h3>
          <ul class="space-y-3 text-xs text-neutral-600 leading-normal">
            <li class="flex items-start gap-2">
              <span class="material-symbols-outlined text-neutral-400 text-sm mt-0.5 shrink-0">check_circle</span>
              <span>Available to eligible employees without dedicated stall assignments.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="material-symbols-outlined text-neutral-400 text-sm mt-0.5 shrink-0">schedule</span>
              <span>Daily unassigned pool releases automatically at <strong class="text-neutral-800 font-mono">9:00 AM IST</strong> every Monday–Friday.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="material-symbols-outlined text-neutral-400 text-sm mt-0.5 shrink-0">bolt</span>
              <span><strong>First accepted claim gets the space:</strong> Once verified, your registered plate (<span class="font-mono text-neutral-800 font-semibold">KA05PQ7712</span>) is instantly authorized at the boom barrier.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="material-symbols-outlined text-neutral-400 text-sm mt-0.5 shrink-0">lock</span>
              <span><strong>Non-cancellable policy:</strong> Once claimed, this space can’t be cancelled for the day to avoid hold-ups in redistribution.</span>
            </li>
          </ul>
        </div>

        <!-- Campus Capacity Summary Card -->
        <div class="bg-white border border-neutral-200 rounded-lg p-5 shadow-[0_1px_2px_rgba(0,0,0,0.03)] text-xs text-neutral-600">
          <div class="flex items-center justify-between mb-3">
            <span class="font-semibold text-neutral-900 text-sm">Campus Capacity</span>
            <span class="font-mono text-neutral-500 font-medium">70 total spaces</span>
          </div>

          <div class="space-y-2 mb-4">
            <div class="flex justify-between items-center text-xs">
              <span class="text-neutral-600">Level P1 (40 stalls)</span>
              <span class="font-mono font-medium text-neutral-700">40 allocated</span>
            </div>
            <div class="w-full bg-neutral-100 rounded-full h-1.5 overflow-hidden">
              <div class="bg-neutral-800 h-1.5 rounded-full w-full"></div>
            </div>

            <div class="flex justify-between items-center text-xs pt-1">
              <span class="text-neutral-600">Level P2 (30 stalls)</span>
              <span class="font-mono font-medium text-neutral-700">30 allocated</span>
            </div>
            <div class="w-full bg-neutral-100 rounded-full h-1.5 overflow-hidden">
              <div class="bg-neutral-800 h-1.5 rounded-full w-full"></div>
            </div>
          </div>

          <div class="pt-3 border-t border-neutral-100 text-neutral-500 leading-relaxed text-[11px]">
            Bengaluru Office campus parking is fully booked today. Check back if colleagues submit last-minute release schedules.
          </div>
        </div>

      </aside>

    </div>

  </main>

</body>
</html>