<style>
    :root {
      --dur-instant: 90ms;
      --dur-quick: 160ms;
      --dur-base: 260ms;
      --dur-slow: 420ms;
      --dur-scene: 800ms;
      --ease-out: cubic-bezier(0.16, 1, 0.3, 1);
      --ease-in: cubic-bezier(0.7, 0, 0.84, 0);
      --ease-inout: cubic-bezier(0.65, 0, 0.35, 1);
      --ease-spring: linear(0, 0.009, 0.035 2.1%, 0.141, 0.281 6.7%, 0.723 12.9%, 0.938 16.7%, 1.017, 1.077 21.4%, 1.121 24%, 1.149 27%, 1.159, 1.154 33%, 1.051 43.2%, 1.013 49.5%, 0.996 57%, 1.001 72%, 1);
    }

    @keyframes entrance {
      0% {
        opacity: 0.84;
        transform: translateY(6px);
      }
      100% {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes active-check {
      0%, 100% {
        opacity: 0.76;
      }
      50% {
        opacity: 1;
      }
    }

    .sign-in-panel {
      animation: entrance var(--dur-slow) var(--ease-out) both;
    }

    .breathe-pulse {
      animation: active-check 7.5s var(--ease-inout) infinite;
    }

    .parking-bay-indicator::before,
    .parking-bay-indicator::after {
      content: '';
      position: absolute;
      top: 50%;
      width: 4px;
      height: 14px;
      transform: translateY(-50%);
      background-color: #dac1bb;
      border-radius: 1px;
    }
    .parking-bay-indicator::before {
      left: -9px;
    }
    .parking-bay-indicator::after {
      right: -9px;
    }

    @media (prefers-reduced-motion: reduce) {
      .sign-in-panel,
      .breathe-pulse {
        animation: none !important;
        opacity: 1 !important;
        transform: none !important;
      }
      *, *::before, *::after {
        scroll-behavior: auto !important;
        transition-duration: 120ms !important;
      }
    }
  </style>
</head>
