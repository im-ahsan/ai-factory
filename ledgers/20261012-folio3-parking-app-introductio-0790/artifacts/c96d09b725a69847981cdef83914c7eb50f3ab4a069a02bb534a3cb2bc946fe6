<style>
    :root {
      --dur-instant: 90ms;
      --dur-quick: 160ms;
      --dur-base: 260ms;
      --dur-slow: 420ms;
      --dur-scene: 700ms;
      --ease-out: cubic-bezier(0.16, 1, 0.3, 1);
      --ease-inout: cubic-bezier(0.65, 0, 0.35, 1);
      --travel: 8px;
    }

    /* Tabular numeric rendering */
    .tabular-nums {
      font-variant-numeric: tabular-nums;
    }

    /* Motion Entrance */
    @keyframes page-enter {
      from {
        opacity: 0;
        transform: translateY(var(--travel));
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .animate-page-enter {
      animation: page-enter var(--dur-scene) var(--ease-out) forwards;
    }

    .animate-stagger-1 {
      animation: page-enter var(--dur-scene) var(--ease-out) 60ms forwards;
      opacity: 0;
    }

    .animate-stagger-2 {
      animation: page-enter var(--dur-scene) var(--ease-out) 120ms forwards;
      opacity: 0;
    }

    /* Ambient Live Breathing Indicator: exactly opacity 0.94 -> 1 on 7.5s cycle */
    @keyframes breathe {
      0%, 100% {
        opacity: 0.94;
      }
      50% {
        opacity: 1;
      }
    }

    .live-status-breathe {
      animation: breathe 7.5s ease-in-out infinite;
    }

    /* Signature Bay-Mark Transition */
    .record-title,
    .record-rule {
      view-transition-name: parking-record;
    }

    ::view-transition-old(parking-record),
    ::view-transition-new(parking-record) {
      animation-duration: var(--dur-slow);
      animation-timing-function: var(--ease-inout);
    }

    /* Prefers-reduced-motion: fully disable loops and translate */
    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        scroll-behavior: auto !important;
        animation-duration: 1ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 120ms !important;
      }
      .live-status-breathe {
        animation: none !important;
        opacity: 1 !important;
      }
      .animate-page-enter,
      .animate-stagger-1,
      .animate-stagger-2 {
        animation: none !important;
        opacity: 1 !important;
        transform: none !important;
      }
    }
