  <style>
    /* Design System Motion Tokens & Keyframes (Pure CSS, no JS) */
    :root {
      --motion-dur-entrance: 420ms;
      --motion-ease-entrance: cubic-bezier(0.16, 1, 0.3, 1);
      --motion-dur-handoff: 420ms;
      --motion-ease-handoff: cubic-bezier(0.65, 0, 0.35, 1);
    }

    @keyframes pageEntrance {
      from {
        opacity: 0;
        transform: translateY(6px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes liveStatusBreathe {
      0%, 100% {
        opacity: 0.94;
      }
      50% {
        opacity: 1;
      }
    }

    /* Page load entrance sequence */
    .animate-entrance {
      animation: pageEntrance var(--motion-dur-entrance) var(--motion-ease-entrance) forwards;
    }

    /* Signature Motion: Bay-mark handoff view transition token */
    .parking-record-handoff {
      view-transition-name: parking-record;
      transition: all var(--motion-dur-handoff) var(--motion-ease-handoff);
    }

    /* The one genuine ambient animation: Live availability indicator dot (7.5s cycle) */
    .live-dot-breathe {
      animation: liveStatusBreathe 7.5s ease-in-out infinite;
    }

    /* Interactive control states: Hover, Focus, Pressed */
    .interactive-control {
      transition: background-color 150ms ease, border-color 150ms ease, color 150ms ease, transform 90ms ease, box-shadow 150ms ease;
    }
    .interactive-control:hover {
      border-color: rgba(63, 167, 122, 0.4);
    }
    .interactive-control:focus-visible {
      outline: 2px solid #3FA77A;
      outline-offset: 2px;
    }
    .interactive-control:active {
      transform: scale(0.98);
    }

    /* Select element subtle arrow styling */
    select {
      background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' fill='none' viewBox='0 0 20 20'%3e%3cpath stroke='%239CA3AF' stroke-linecap='round' stroke-linejoin='round' stroke-width='1.5' d='M6 8l4 4 4-4'/%3e%3c/svg%3e");
      background-position: right 0.75rem center;
      background-repeat: no-repeat;
      background-size: 1.25em 1.25em;
      padding-right: 2.25rem;
    }

    /* Prefers-reduced-motion override */
    @media (prefers-reduced-motion: reduce) {
      .animate-entrance,
      .live-dot-breathe,
      .parking-record-handoff {
        animation: none !important;
        transition: none !important;
      }
    }
