<style>
    :root {
      --dur-instant: 90ms;
      --dur-quick: 160ms;
      --dur-base: 260ms;
      --dur-slow: 420ms;
      --dur-scene: 800ms;
      --ease-out: cubic-bezier(0.16, 1, 0.3, 1);
      --ease-in: cubic-bezier(0.7, 0, 0.84, 0);
      --ease-inout: cubic-bezier(0.65, 0, 0.35, 1);
    }

    @keyframes settle-in {
      from {
        opacity: 0.84;
        transform: translateY(6px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes active-check {
      0%, 100% {
        opacity: 0.76;
      }
      50% {
        opacity: 1;
      }
    }

    .page-intro {
      animation: settle-in var(--dur-slow) var(--ease-out) both;
    }

    .entry-check-live {
      animation: active-check 7.5s var(--ease-inout) infinite;
    }

    /* Parking bay stall mark indicator styling */
    .parking-bay-mark {
      position: relative;
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
    }
    .parking-bay-mark::before,
    .parking-bay-mark::after {
      content: '';
      display: inline-block;
      width: 3px;
      height: 18px;
      background-color: #D8DEDB;
      border-radius: 1px;
    }

    /* Interactive press */
    .btn-press:active {
      transform: scale(0.97);
      transition-duration: 90ms;
    }

    @media (prefers-reduced-motion: reduce) {
      .page-intro,
      .entry-check-live {
        animation: none !important;
        opacity: 1 !important;
        transform: none !important;
      }
      *, *::before, *::after {
        scroll-behavior: auto !important;
        transition-duration: 120ms !important;
      }
    }
  </style>
</head>
