<!-- Inline Interaction for Immediate Single-Action Processing -->
<script>
    document.addEventListener('DOMContentLoaded', () => {
      const releaseBtn = document.getElementById('releaseActionBtn');
      
      if (releaseBtn) {
        releaseBtn.addEventListener('click', () => {
          // Disable button immediately to prevent double processing
          releaseBtn.disabled = true;
          releaseBtn.classList.add('opacity-70', 'cursor-not-allowed');
          releaseBtn.innerText = 'Releasing stall...';

          setTimeout(() => {
            // Transition in-place without popup or modal
            releaseBtn.classList.remove('bg-clay', 'hover:bg-[#964a37]');
            releaseBtn.classList.add('bg-neutralFill', 'text-ink', 'border', 'border-rule');
            releaseBtn.innerText = 'Stall P1-12 released for today';
            
            const warningEl = releaseBtn.parentElement.querySelector('.text-slate');
            if (warningEl) {
              warningEl.innerHTML = '<span class="material-symbols-outlined text-base text-ink shrink-0">check_circle</span><span class="font-body text-sm font-medium text-ink">Released at 09:15 AM IST &bull; Allocated to daily pool</span>';
            }
          }, 450);
        });
      }
    });
  </script>
