</main>
<script>
    // Lightweight toast/feedback micro-interaction
    const saveBtn = document.getElementById('saveBtn');
    const resetBtn = document.getElementById('resetBtn');

    if (saveBtn) {
      saveBtn.addEventListener('click', () => {
        const originalText = saveBtn.innerHTML;
        saveBtn.innerHTML = `
          <span class="material-symbols-outlined text-base" data-icon="check">check</span>
          Saved successfully
        `;
        saveBtn.style.backgroundColor = '#006056';
        
        setTimeout(() => {
          saveBtn.innerHTML = originalText;
          saveBtn.style.backgroundColor = '';
        }, 1800);
      });
    }

    if (resetBtn) {
      resetBtn.addEventListener('click', () => {
        document.getElementById('stallInput').value = 'P1-12';
        document.getElementById('floorSelect').value = 'P1';
        document.getElementById('plateInput').value = 'KA03MN4821';
        document.getElementById('adminNotes').value = 'Confirmed clearance with facility team. Space P1-12 reserved through Q2 review cycle.';
      });
    }
  </script>
