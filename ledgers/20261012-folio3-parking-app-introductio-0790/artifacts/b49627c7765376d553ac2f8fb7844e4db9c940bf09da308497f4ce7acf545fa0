<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Folio3 Parking — Sign In (Error State)</title>
  
  <!-- Fonts: Hanken Grotesk, Source Sans 3, IBM Plex Mono -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@600&family=IBM+Plex+Mono:wght@400;500;600&family=Source+Sans+3:wght@400;500;600&display=swap" rel="stylesheet">
  
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  
  <style>
    /* Design System Tokens */
    :root {
      --bg-page: #F3F6F8;
      --bg-surface: #FFFFFF;
      --text-main: #25313B;
      --text-muted: #5D6A75;
      --border-rule: #D6DEE5;
      --primary: #356F9A;
      
      --status-good: #2D6F4F;
      --status-waiting: #8A5C14;
      --status-failed: #A53B36;
      
      --motion-duration-fast: 150ms;
      --motion-duration-normal: 250ms;
      --motion-duration-slow: 400ms;
      --motion-ease-standard: cubic-bezier(0.2, 0, 0, 1);
      --motion-ease-entrance: cubic-bezier(0, 0, 0.2, 1);
      --motion-ease-settle: cubic-bezier(0.16, 1, 0.3, 1);
      --motion-ease-breathe: cubic-bezier(0.65, 0, 0.35, 1);
    }
    
    body {
      background-color: var(--bg-page);
      color: var(--text-main);
      font-family: 'Source Sans 3', sans-serif;
      font-size: 14px;
      line-height: 22px;
      margin: 0;
      padding: 0;
      -webkit-font-smoothing: antialiased;
    }
    
    .font-heading {
      font-family: 'Hanken Grotesk', sans-serif;
    }
    
    .font-mono-code {
      font-family: 'IBM Plex Mono', monospace;
    }
    
    /* Keyframes */
    @keyframes panelEntrance {
      from {
        opacity: 0;
        transform: translateY(8px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
    
    @keyframes parkingRecordSettle {
      from {
        opacity: 0;
        transform: translateY(8px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
    
    @keyframes statusDotBreathe {
      0%, 100% {
        opacity: 0.96;
      }
      50% {
        opacity: 1;
      }
    }
    
    /* Entrance Animation */
    .entrance-animate {
      animation: panelEntrance var(--motion-duration-normal) var(--motion-ease-settle) forwards;
    }
    
    /* Interactive Controls */
    .btn-action {
      transition: background-color var(--motion-duration-fast) var(--motion-ease-standard),
                  border-color var(--motion-duration-fast) var(--motion-ease-standard),
                  color var(--motion-duration-fast) var(--motion-ease-standard),
                  box-shadow var(--motion-duration-fast) var(--motion-ease-standard),
                  transform var(--motion-duration-fast) var(--motion-ease-standard);
    }
    
    .btn-action:hover {
      background-color: #F8FAFC;
      border-color: #BAC7D5;
    }
    
    .btn-action:active {
      transform: scale(0.98);
      background-color: #EEF2F6;
    }
    
    .btn-action:focus-visible {
      outline: none;
      box-shadow: 0 0 0 2px #FFFFFF, 0 0 0 4px var(--primary);
    }
    
    .retry-btn {
      transition: background-color var(--motion-duration-fast) var(--motion-ease-standard),
                  border-color var(--motion-duration-fast) var(--motion-ease-standard),
                  color var(--motion-duration-fast) var(--motion-ease-standard),
                  transform var(--motion-duration-fast) var(--motion-ease-standard);
    }
    
    .retry-btn:hover {
      background-color: #FFFFFF;
      border-color: #BAC7D5;
      color: var(--text-main);
    }
    
    .retry-btn:active {
      transform: scale(0.96);
    }
    
    .retry-btn:focus-visible {
      outline: none;
      box-shadow: 0 0 0 2px #FFFFFF, 0 0 0 4px var(--primary);
    }

    @media (prefers-reduced-motion: reduce) {
      .entrance-animate,
      .btn-action,
      .retry-btn {
        animation: none !important;
        transition: none !important;
        transform: none !important;
      }
    }
  </style>
</head>
<body class="min-h-screen flex items-center justify-center p-4 sm:p-6 md:p-8">

  <!-- Centered ~440px wide panel -->
  <main class="w-full max-w-[440px] bg-white rounded-[8px] border border-[#D6DEE5] p-8 sm:p-10 shadow-none entrance-animate">
    
    <!-- Folio3 Parking Wordmark & Small Square P Mark -->
    <div class="flex items-center gap-3 mb-8">
      <div class="w-8 h-8 rounded-[8px] bg-[#356F9A] flex items-center justify-center flex-shrink-0">
        <span class="font-heading text-white text-[17px] font-semibold leading-none select-none">P</span>
      </div>
      <span class="font-heading text-[#25313B] text-[18px] font-semibold tracking-[-0.01em]">Folio3 Parking</span>
    </div>

    <!-- Inline Error Alert: The data failed to load -->
    <div class="rounded-[8px] border border-[#A53B36]/30 bg-[#A53B36]/[0.04] p-4 mb-6 border-l-[3px] border-l-[#A53B36]">
      <div class="flex items-start justify-between gap-3">
        <div class="flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-[#A53B36] inline-block flex-shrink-0"></span>
          <span class="font-mono-code text-[11px] font-semibold uppercase tracking-wider text-[#A53B36]">failed</span>
        </div>
        <button type="button" class="retry-btn inline-flex items-center gap-1.5 px-2.5 py-1 rounded-[6px] border border-[#D6DEE5] bg-white text-[12px] font-medium text-[#5D6A75] leading-normal" onclick="window.location.reload()">
          <svg class="w-3.5 h-3.5 text-[#5D6A75]" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
            <path d="M2.5 8a5.5 5.5 0 0 1 9.35-3.92L13.5 5.5M13.5 2v3.5H10"/>
            <path d="M13.5 8a5.5 5.5 0 0 1-9.35 3.92L2.5 10.5M2.5 14v-3.5H6"/>
          </svg>
          Retry
        </button>
      </div>
      <div class="mt-2 text-[14px] font-semibold text-[#25313B] leading-[20px]">
        The data failed to load
      </div>
      <div class="mt-0.5 text-[13px] text-[#5D6A75] leading-[18px]">
        Please check your connection and try again.
      </div>
    </div>

    <!-- Page Heading: Sign in (Largest type on page: 28px/600) -->
    <h1 class="font-heading text-[28px] font-semibold text-[#25313B] leading-[36px] tracking-[-0.02em] mb-2">
      Sign in
    </h1>

    <!-- One sentence description -->
    <p class="text-[#5D6A75] text-[14px] leading-[22px] mb-8">
      Use your Folio3 Google account to manage parking.
    </p>

    <!-- Sole primary action: Continue with Google -->
    <button type="button" class="btn-action w-full h-[44px] rounded-[8px] border border-[#D6DEE5] bg-white text-[#25313B] font-medium text-[14px] flex items-center justify-center gap-3 px-4 shadow-none">
      <!-- Google 'G' multicolored SVG -->
      <svg class="w-4 h-4 flex-shrink-0" viewBox="0 0 24 24">
        <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
        <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
        <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
        <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
      </svg>
      <span>Continue with Google</span>
    </button>

    <!-- One quiet line explaining employee access policy -->
    <p class="mt-6 text-[#5D6A75] text-[13px] leading-[20px]">
      Access is for active Folio3 employees.
    </p>

  </main>

</body>
</html>
