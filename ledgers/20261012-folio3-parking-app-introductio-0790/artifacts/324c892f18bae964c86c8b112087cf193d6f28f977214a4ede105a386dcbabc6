<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Folio3 Parking — My vehicles</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@600&family=IBM+Plex+Mono:wght@400;500;600&family=Source+Sans+3:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg-color: #F3F6F8;
      --panel-bg: #FFFFFF;
      --text-main: #25313B;
      --text-quiet: #5D6A75;
      --border-rule: #D6DEE5;
      --brand-primary: #356F9A;
      --status-good: #2D6F4F;
      --status-waiting: #8A5C14;
      --status-refused: #A53B36;
    }

    body {
      background-color: var(--bg-color);
      color: var(--text-main);
      font-family: 'Source Sans 3', sans-serif;
      font-size: 14px;
      line-height: 22px;
      margin: 0;
      padding: 0;
      -webkit-font-smoothing: antialiased;
    }

    h1, h2, h3, .heading-font {
      font-family: 'Hanken Grotesk', sans-serif;
    }

    .mono-font {
      font-family: 'IBM Plex Mono', monospace;
    }

    /* Motion Tokens & Keyframes */
    @keyframes entrancePage {
      from {
        opacity: 0;
        transform: translateY(6px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes parkingRecordSettle {
      from {
        opacity: 0;
        transform: translateY(8px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes entryCheckBreathe {
      0%, 100% {
        opacity: 0.96;
      }
      50% {
        opacity: 1;
      }
    }

    .animate-entrance {
      animation: entrancePage 240ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    .animate-record-settle {
      animation: parkingRecordSettle 160ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    .animate-entry-breathe {
      animation: entryCheckBreathe 8s cubic-bezier(0.65, 0, 0.35, 1) infinite;
    }

    /* Interactive States */
    .interactive-action {
      transition: background-color 140ms ease, border-color 140ms ease, color 140ms ease, box-shadow 140ms ease;
    }

    .interactive-action:focus-visible {
      outline: none;
      box-shadow: 0 0 0 2px #FFFFFF, 0 0 0 4px var(--brand-primary);
    }

    .primary-btn {
      background-color: var(--brand-primary);
      color: #FFFFFF;
      height: 44px;
      border-radius: 8px;
      border: 1px solid var(--brand-primary);
    }
    .primary-btn:hover {
      filter: brightness(0.94);
    }
    .primary-btn:active {
      filter: brightness(0.88);
    }

    .nav-item {
      transition: color 140ms ease, background-color 140ms ease;
      border-radius: 8px;
    }
    .nav-item:focus-visible {
      outline: none;
      box-shadow: 0 0 0 2px #FFFFFF, 0 0 0 4px var(--brand-primary);
    }

    .input-field {
      height: 44px;
      border-radius: 8px;
      border: 1px solid var(--border-rule);
      background-color: #FFFFFF;
      color: var(--text-main);
      padding: 0 14px;
      transition: border-color 140ms ease, box-shadow 140ms ease;
    }
    .input-field:hover {
      border-color: #BAC7D3;
    }
    .input-field:focus {
      outline: none;
      border-color: var(--brand-primary);
      box-shadow: 0 0 0 1px var(--brand-primary);
    }

    @media (prefers-reduced-motion: reduce) {
      *, ::before, ::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
        scroll-behavior: auto !important;
      }
    }
  </style>
</head>
<body class="min-h-screen flex flex-col">

  <!-- Shared Header -->
  <header class="w-full bg-[#FFFFFF] border-b border-[#D6DEE5] h-16 px-6 lg:px-12 flex items-center justify-between z-20">
    <div class="flex items-center gap-8">
      <!-- Wordmark and Square P Logo -->
      <div class="flex items-center gap-3 select-none">
        <div class="w-8 h-8 rounded-[8px] bg-[#25313B] flex items-center justify-center text-white font-semibold text-base leading-none" style="font-family: 'Hanken Grotesk', sans-serif;">
          P
        </div>
        <span class="text-[#25313B] text-lg font-semibold tracking-tight" style="font-family: 'Hanken Grotesk', sans-serif;">
          Folio3 Parking
        </span>
      </div>

      <!-- Employee Navigation Menu (Desktop/Tablet) -->
      <nav class="hidden md:flex items-center gap-1" aria-label="Employee Menu">
        <a href="#" class="nav-item px-3.5 py-2 text-sm font-medium text-[#5D6A75] hover:text-[#25313B] hover:bg-[#F3F6F8]">
          My space
        </a>
        <a href="#" class="nav-item px-3.5 py-2 text-sm font-medium text-[#5D6A75] hover:text-[#25313B] hover:bg-[#F3F6F8]">
          Free spaces
        </a>
        <a href="#" class="nav-item px-3.5 py-2 text-sm font-semibold text-[#356F9A] bg-[#F3F6F8] rounded-[8px]" aria-current="page">
          My vehicles
        </a>
      </nav>
    </div>

    <!-- Right Header: Employee Profile & Mobile Menu -->
    <div class="flex items-center gap-4">
      <!-- Signed-in Employee Profile -->
      <div class="flex items-center gap-3">
        <img
          src="https://lh3.googleusercontent.com/aida-public/AB6AXuD4D6nA9wNWCGzj7VcXHJ8UJ1xrdDpmWCdcsbCYU6z4HkZlII6qh3TnVnYfKsUIpfvDESoltXIkc2u-KOrh5oNV8jrm13eZqHkQ79p024EWCdo8UsRn2IsTP2RyH2F-X_2xlAANnVU71aJ92NL-nIViIw40XklBTkCuIpNVj0l8J75PYk4VCXjF-ZirOh78w7dHaXcC7xIbyaoBpKYsFaiV1v4fDpRd7kyhRCAg3j75et9JhNbu8nA8S7TnmPqtaOvlYz6gppauH-4"
          alt="Elliot Kim"
          class="w-10 h-10 rounded-full object-cover border border-[#D6DEE5]"
        />
        <div class="flex flex-col text-right sm:text-left">
          <span class="text-sm font-semibold text-[#25313B] leading-snug">Elliot Kim</span>
          <span class="text-xs text-[#5D6A75] leading-none">Employee</span>
        </div>
      </div>

      <!-- Mobile Touch-Sized Menu Button -->
      <button
        type="button"
        class="md:hidden w-11 h-11 flex items-center justify-center rounded-[8px] border border-[#D6DEE5] text-[#25313B] hover:bg-[#F3F6F8] interactive-action"
        aria-label="Open navigation menu"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </header>

  <!-- Main Content Canvas -->
  <main class="flex-1 w-full max-w-7xl mx-auto px-6 lg:px-12 py-10 animate-entrance">
    <!-- Page Heading -->
    <h1 class="text-[28px] font-semibold text-[#25313B] leading-tight mb-8">
      My vehicles
    </h1>

    <!-- Notice Banner -->
    <div class="w-full max-w-[480px] bg-[#FFFFFF] border border-[#D6DEE5] rounded-[8px] p-4 mb-6">
      <div class="text-[#25313B] font-semibold text-sm leading-snug mb-1">
        Add a license plate before using parking.
      </div>
      <p class="text-xs text-[#5D6A75] leading-normal">
        At least one valid license plate is required before release or claim operations. Release and claim operations remain unavailable until a vehicle plate is registered.
      </p>
    </div>

    <!-- Registration Form Section -->
    <section class="w-full max-w-[480px] bg-[#FFFFFF] border border-[#D6DEE5] rounded-[8px] p-6 mb-10">
      <h2 class="text-[20px] font-semibold text-[#25313B] leading-snug mb-4">
        Register vehicle
      </h2>

      <form action="#" method="POST" onsubmit="event.preventDefault();" class="space-y-4">
        <!-- License Plate Field (Required) -->
        <div>
          <label for="license-plate" class="block text-xs font-semibold uppercase tracking-wider text-[#5D6A75] mb-1.5">
            License plate <span class="text-[#A53B36] font-normal lowercase">*</span>
          </label>
          <input
            type="text"
            id="license-plate"
            name="license_plate"
            required
            placeholder="e.g. 7MJR482"
            class="input-field w-full mono-font uppercase text-sm font-medium tracking-wide placeholder:normal-case placeholder:font-sans placeholder:text-[#5D6A75]"
          />
        </div>

        <!-- Vehicle Field (Optional) -->
        <div>
          <label for="vehicle-model" class="block text-xs font-semibold uppercase tracking-wider text-[#5D6A75] mb-1.5">
            Vehicle <span class="text-xs font-normal lowercase text-[#5D6A75]">(optional)</span>
          </label>
          <input
            type="text"
            id="vehicle-model"
            name="vehicle_model"
            placeholder="e.g. Make and model (Subaru Crosstrek, Honda Civic)"
            class="input-field w-full text-sm placeholder:text-[#5D6A75]"
          />
        </div>

        <!-- Primary Action -->
        <div class="pt-2">
          <button
            type="submit"
            class="primary-btn interactive-action w-full font-semibold text-sm flex items-center justify-center cursor-pointer"
          >
            Save vehicle
          </button>
        </div>
      </form>
    </section>

    <!-- 20px Deliberate Ledger Pause -->
    <div class="h-5" aria-hidden="true"></div>

    <!-- Registered-Vehicle List (Empty State in Normal State) -->
    <section class="w-full max-w-[720px] animate-record-settle">
      <div class="flex items-center justify-between pb-3 border-b border-[#D6DEE5] mb-0">
        <h2 class="text-sm font-semibold uppercase tracking-wider text-[#5D6A75]">
          Registered vehicles
        </h2>
        <span class="mono-font text-xs text-[#5D6A75]">
          0 registered
        </span>
      </div>

      <!-- Empty State Record Container -->
      <div class="bg-[#FFFFFF] border border-[#D6DEE5] border-t-0 rounded-b-[8px] p-8 text-center">
        <p class="text-sm font-medium text-[#25313B] mb-1">
          No registered vehicles
        </p>
        <p class="text-xs text-[#5D6A75] max-w-sm mx-auto leading-relaxed">
          Elliot Kim currently has no active license plates associated with his profile. Registered vehicles will appear here once saved.
        </p>
      </div>
    </section>

  </main>

</body>
</html>
