<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>My space — Folio3 Parking</title>
  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@600&family=IBM+Plex+Mono:wght@400;500;600&family=Source+Sans+3:wght@400;600&display=swap" rel="stylesheet">
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    /* Design System Tokens & Base */
    :root {
      --bg: #F3F6F8;
      --surface: #FFFFFF;
      --text: #25313B;
      --text-quiet: #5D6A75;
      --border: #D6DEE5;
      --primary: #356F9A;
      --status-good: #2D6F4F;
      --status-waiting: #8A5C14;
      --status-refused: #A53B36;
    }

    body {
      background-color: var(--bg);
      color: var(--text);
      font-family: 'Source Sans 3', sans-serif;
      font-size: 14px;
      line-height: 22px;
      margin: 0;
      padding: 0;
      -webkit-font-smoothing: antialiased;
    }

    h1, h2, h3 {
      font-family: 'Hanken Grotesk', sans-serif;
      font-weight: 600;
      color: var(--text);
    }

    .font-mono-num {
      font-family: 'IBM Plex Mono', monospace;
    }

    /* Motion Tokens */
    @keyframes entranceFadeUp {
      from {
        opacity: 0;
        transform: translateY(8px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes recordSettle {
      from {
        opacity: 0;
        transform: translateY(8px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes ambientBreathe {
      0%, 100% {
        opacity: 1;
      }
      50% {
        opacity: 0.96;
      }
    }

    .animate-entrance {
      animation: entranceFadeUp 200ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    .animate-settle {
      animation: recordSettle 160ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    .status-dot-pulse {
      animation: ambientBreathe 8s cubic-bezier(0.65, 0, 0.35, 1) infinite;
    }

    /* Interactive state styles */
    .btn-primary {
      background-color: var(--primary);
      color: #FFFFFF;
      border-radius: 8px;
      height: 44px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-weight: 600;
      font-size: 14px;
      transition: background-color 120ms ease, box-shadow 120ms ease, transform 120ms ease;
      cursor: pointer;
      text-decoration: none;
      width: 100%;
    }
    .btn-primary:hover {
      background-color: #2e6085;
    }
    .btn-primary:focus {
      outline: none;
      box-shadow: 0 0 0 2px #FFFFFF, 0 0 0 4px var(--primary);
    }
    .btn-primary:active {
      transform: scale(0.99);
      background-color: #275271;
    }

    .touch-target {
      min-height: 44px;
      display: inline-flex;
      align-items: center;
    }

    /* Accessibility */
    @media (prefers-reduced-motion: reduce) {
      *, ::before, ::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
      }
    }
  </style>
</head>
<body class="min-h-screen text-[#25313B] bg-[#F3F6F8]">

  <!-- Shared Header -->
  <header class="bg-[#FFFFFF] border-b border-[#D6DEE5] sticky top-0 z-50">
    <div class="max-w-[390px] mx-auto px-4 h-14 flex items-center justify-between">
      <!-- Left: Brand mark with white 'P' + Folio3 Parking wordmark -->
      <div class="flex items-center gap-2.5">
        <div class="w-7 h-7 rounded-[8px] bg-[#356F9A] flex items-center justify-center flex-shrink-0" aria-label="Logo icon">
          <span class="text-white font-bold text-sm leading-none font-sans">P</span>
        </div>
        <span class="font-['Hanken_Grotesk'] font-semibold text-[15px] tracking-tight text-[#25313B]">Folio3 Parking</span>
      </div>

      <!-- Right: Touch-sized Menu Button (Phone collapse) with headshot & role info -->
      <div class="flex items-center gap-3">
        <!-- User identity display -->
        <div class="flex items-center gap-2">
          <img 
            src="https://lh3.googleusercontent.com/aida/AEtjO1W-2LmS0gi0rlqanztR876-bTNv1ClkF-M-sLPPQrTuEoLPYNXoF0CcvxoL3wggfwKydwlUGah1QhKvH63Bhq6juvjc81WumZIbTy21pNYSFPTzFjDBsbDDdDWjQF8xXZ9NzeCtq-CrC_IHDnQ4uoa4R6r_4Z1ARfYZDxKHjmB8rfWF3ubbJWNM5MnuPxv_WuRpDdbk44NwE52Ut2ab2nxmWJEOI_331bLxogh6t2UYdbQTZLyVlxRPRHo" 
            alt="Maya Chen" 
            class="w-7 h-7 rounded-full object-cover border border-[#D6DEE5]"
          />
          <div class="hidden sm:flex flex-col text-left leading-tight">
            <span class="font-semibold text-xs text-[#25313B]">Maya Chen</span>
            <span class="text-[11px] text-[#5D6A75]">Employee</span>
          </div>
        </div>

        <!-- Phone touch-sized menu toggle button -->
        <button 
          id="menuToggle"
          type="button"
          class="w-10 h-10 flex items-center justify-center rounded-[8px] border border-[#D6DEE5] text-[#25313B] hover:bg-[#F3F6F8] focus:outline-none focus:ring-2 focus:ring-[#356F9A] touch-target"
          aria-label="Toggle navigation menu"
          aria-expanded="false"
          onclick="toggleMenu()"
        >
          <svg class="w-5 h-5 text-[#25313B]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>
      </div>
    </div>

    <!-- Collapsible Employee Menu (order: My space, Free spaces, My vehicles) -->
    <nav id="mobileNav" class="hidden border-t border-[#D6DEE5] bg-[#FFFFFF] px-4 py-2" aria-label="Employee navigation">
      <div class="max-w-[390px] mx-auto flex flex-col space-y-1">
        <!-- Active menu item: My space -->
        <a 
          href="#" 
          class="px-3 h-[44px] flex items-center text-[14px] font-semibold text-[#356F9A] bg-[#F3F6F8] rounded-[8px] transition-colors"
          aria-current="page"
        >
          My space
        </a>
        <a 
          href="#" 
          class="px-3 h-[44px] flex items-center text-[14px] text-[#25313B] hover:bg-[#F3F6F8] rounded-[8px] transition-colors"
        >
          Free spaces
        </a>
        <a 
          href="#" 
          class="px-3 h-[44px] flex items-center text-[14px] text-[#25313B] hover:bg-[#F3F6F8] rounded-[8px] transition-colors"
        >
          My vehicles
        </a>
        <!-- Mobile signed-in indicator -->
        <div class="pt-2 pb-1 border-t border-[#D6DEE5] flex items-center gap-2.5 px-3">
          <img 
            src="https://lh3.googleusercontent.com/aida/AEtjO1W-2LmS0gi0rlqanztR876-bTNv1ClkF-M-sLPPQrTuEoLPYNXoF0CcvxoL3wggfwKydwlUGah1QhKvH63Bhq6juvjc81WumZIbTy21pNYSFPTzFjDBsbDDdDWjQF8xXZ9NzeCtq-CrC_IHDnQ4uoa4R6r_4Z1ARfYZDxKHjmB8rfWF3ubbJWNM5MnuPxv_WuRpDdbk44NwE52Ut2ab2nxmWJEOI_331bLxogh6t2UYdbQTZLyVlxRPRHo" 
            alt="Maya Chen" 
            class="w-6 h-6 rounded-full object-cover border border-[#D6DEE5]"
          />
          <div class="text-xs leading-none">
            <span class="font-semibold text-[#25313B]">Maya Chen</span>
            <span class="text-[#5D6A75] ml-1">· Employee</span>
          </div>
        </div>
      </div>
    </nav>
  </header>

  <!-- Main Content Container: Phone width (390px single column stack) -->
  <main class="max-w-[390px] mx-auto px-4 pt-6 pb-12 animate-entrance">
    
    <!-- Title Section: Left-aligned title and single prominent status line -->
    <section class="mb-6">
      <h1 class="text-[28px] leading-[34px] font-semibold text-[#25313B] tracking-tight mb-2">
        My space
      </h1>
      
      <!-- Single prominent status line: "Reserved today" for P2-08, Floor 2 -->
      <div class="bg-[#FFFFFF] border border-[#D6DEE5] rounded-[8px] p-4 flex items-center justify-between">
        <div>
          <div class="flex items-center gap-2 mb-1">
            <span class="w-2 h-2 rounded-full bg-[#2D6F4F] status-dot-pulse"></span>
            <span class="font-semibold text-[15px] text-[#2D6F4F]">Reserved today</span>
          </div>
          <div class="text-[13px] text-[#5D6A75]">
            Dedicated space
          </div>
        </div>
        <div class="text-right">
          <div class="font-mono-num font-semibold text-[18px] text-[#25313B] leading-tight">P2-08</div>
          <div class="text-[12px] text-[#5D6A75]">Floor <span class="font-mono-num">2</span></div>
        </div>
      </div>
    </section>

    <!-- Compact Assignment Row -->
    <section class="mb-6">
      <div class="bg-[#FFFFFF] border border-[#D6DEE5] rounded-[8px] overflow-hidden">
        <!-- Header / Label -->
        <div class="px-4 py-2.5 bg-[#FFFFFF] border-b border-[#D6DEE5] flex items-center justify-between">
          <span class="text-xs font-semibold text-[#5D6A75] uppercase tracking-wider">Assignment Details</span>
          <span class="font-mono-num text-xs text-[#5D6A75]">12 May 2025, 10:15 PDT</span>
        </div>

        <!-- 44px rows divider structure -->
        <div class="divide-y divide-[#D6DEE5] text-[14px]">
          <!-- Date & Time Row -->
          <div class="px-4 min-h-[44px] py-2.5 flex items-center justify-between">
            <span class="text-[#5D6A75]">Today</span>
            <span class="font-mono-num text-[#25313B] text-right">Monday, 12 May 2025, 10:15 PDT</span>
          </div>

          <!-- Daily Release Time Row -->
          <div class="px-4 min-h-[44px] py-2.5 flex items-center justify-between">
            <span class="text-[#5D6A75]">Daily release time</span>
            <span class="font-mono-num text-[#25313B] font-medium">09:00</span>
          </div>

          <!-- Registered Vehicle Row -->
          <div class="px-4 min-h-[44px] py-2.5 flex items-center justify-between">
            <span class="text-[#5D6A75]">Registered vehicle</span>
            <span class="text-[#25313B] font-medium text-right">
              Ford Escape, plate <span class="font-mono-num font-semibold">8KVL291</span>
            </span>
          </div>
        </div>

        <!-- Car Photograph in 4:3 Crop -->
        <div class="border-t border-[#D6DEE5] bg-[#FFFFFF] p-3">
          <div class="relative w-full aspect-[4/3] rounded-[8px] overflow-hidden border border-[#D6DEE5] bg-[#F3F6F8]">
            <img 
              src="https://lh3.googleusercontent.com/aida/AEtjO1VJw6pEU7qXBMTuESbjoCtafDUsGx6ojyySTfSQS1Q8u8nCq8LKji9jKI0dSma1MObIb2Ze1KZuzJmuNypEVdP3nPoVny4SErMxdiQEJ6kMW8rC04F8ut5Y4FgyNrLLCsVj4-XaY3J_gJS1XHlM4gwlVRlOODrNEyVgTUTWR63m465oPF7oqGzmnL1nqgJvDbQp6VWblKGmZtk7N1fe_fxYX_uhqIfhU_y0Voh7w2MH7jlkzWFi0hrApTQ" 
              alt="Maya Chen's silver Ford Escape parked in designated stall with California plate 8KVL291 readable" 
              class="w-full h-full object-cover"
            />
          </div>
          <p class="text-xs text-[#5D6A75] mt-2 text-center">
            Folio3 San Francisco office · Registered Ford Escape (<span class="font-mono-num">8KVL291</span>)
          </p>
        </div>
      </div>
    </section>

    <!-- Primary Action: Release my space today -->
    <section class="mb-6">
      <div class="bg-[#FFFFFF] border border-[#D6DEE5] rounded-[8px] p-4">
        <button 
          type="button" 
          class="btn-primary"
        >
          Release my space today
        </button>
        <p class="text-[13px] leading-[19px] text-[#5D6A75] mt-3">
          Because it is after <span class="font-mono-num font-medium text-[#25313B]">09:00</span>, the space becomes claimable immediately. This action records one release for today.
        </p>
      </div>
    </section>

    <!-- 20px deliberate pause / rhythmic spacing before ledger section -->
    <div class="h-5"></div>

    <!-- Upcoming Release Dates Section -->
    <section>
      <div class="flex items-center justify-between mb-3 px-1">
        <h2 class="text-[16px] leading-[22px] font-semibold text-[#25313B]">
          Upcoming release dates
        </h2>
        <a 
          href="#" 
          class="text-[14px] text-[#356F9A] font-semibold hover:underline focus:outline-none focus:ring-1 focus:ring-[#356F9A] rounded touch-target"
        >
          Set release dates
        </a>
      </div>

      <div class="bg-[#FFFFFF] border border-[#D6DEE5] rounded-[8px] overflow-hidden">
        <div class="divide-y divide-[#D6DEE5]">
          <!-- Row 1: 15 May 2025 -->
          <div class="px-4 h-[44px] flex items-center justify-between animate-settle">
            <div class="flex items-center gap-2">
              <span class="font-mono-num text-[14px] text-[#25313B]">15 May 2025</span>
            </div>
            <div class="inline-flex items-center px-2 py-0.5 rounded-[8px] border border-[#8A5C14]/40 bg-[#FFFFFF]">
              <span class="text-xs font-medium text-[#8A5C14]">Scheduled</span>
            </div>
          </div>

          <!-- Row 2: 21 May 2025 -->
          <div class="px-4 h-[44px] flex items-center justify-between animate-settle" style="animation-delay: 40ms;">
            <div class="flex items-center gap-2">
              <span class="font-mono-num text-[14px] text-[#25313B]">21 May 2025</span>
            </div>
            <div class="inline-flex items-center px-2 py-0.5 rounded-[8px] border border-[#8A5C14]/40 bg-[#FFFFFF]">
              <span class="text-xs font-medium text-[#8A5C14]">Scheduled</span>
            </div>
          </div>
        </div>
      </div>
    </section>

  </main>

  <!-- Lightweight inline interaction for mobile menu toggle -->
  <script>
    function toggleMenu() {
      const nav = document.getElementById('mobileNav');
      const btn = document.getElementById('menuToggle');
      const isExpanded = btn.getAttribute('aria-expanded') === 'true';
      if (isExpanded) {
        nav.classList.add('hidden');
        btn.setAttribute('aria-expanded', 'false');
      } else {
        nav.classList.remove('hidden');
        btn.setAttribute('aria-expanded', 'true');
      }
    }
  </script>
</body>
</html>
