<style>
    :root {
      --dur-instant: 90ms;
      --dur-quick: 160ms;
      --dur-base: 260ms;
      --dur-slow: 420ms;
      --dur-scene: 700ms;
      --ease-out: cubic-bezier(0.16, 1, 0.3, 1);
      --ease-in: cubic-bezier(0.7, 0, 0.84, 0);
      --ease-inout: cubic-bezier(0.65, 0, 0.35, 1);
      --travel: 8px;
    }

    /* Tabular figures for numbers, codes, and timestamps */
    .tabular-nums {
      font-variant-numeric: tabular-nums;
    }

    /* Page Entrance Animation */
    @keyframes entrance {
      from {
        opacity: 0;
        transform: translateY(var(--travel));
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .animate-entrance {
      animation: entrance var(--dur-scene) var(--ease-out) forwards;
    }

    .stagger-1 {
      animation-delay: 60ms;
    }

    .stagger-2 {
      animation-delay: 120ms;
    }

    /* Ambient live availability pulse: the single ambient animation on page */
    @keyframes live-pulse {
      0%, 100% {
        opacity: 0.94;
      }
      50% {
        opacity: 1;
      }
    }

    .live-status {
      animation: live-pulse 7.5s ease-in-out infinite;
    }

    /* Bay-mark handoff view transition token */
    .record-title, .record-rule {
      view-transition-name: parking-record;
    }

    ::view-transition-old(parking-record),
    ::view-transition-new(parking-record) {
      animation-duration: var(--dur-slow);
      animation-timing-function: var(--ease-inout);
    }

    /* Button and Interactive control states */
    button, a, input, select {
      transition: background-color var(--dur-quick) ease, border-color var(--dur-quick) ease, color var(--dur-quick) ease, transform var(--dur-instant) ease;
    }

    button:active, a:active {
      transform: scale(0.98);
    }

    /* Focus visible standard */
    button:focus-visible, a:focus-visible, input:focus-visible {
      outline: 2px solid #3FA77A;
      outline-offset: 2px;
    }

    /* Prefers-reduced-motion reset */
    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        scroll-behavior: auto !important;
        animation-duration: 1ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 120ms !important;
      }
      .live-status {
        animation: none !important;
      }
      .animate-entrance {
        animation: none !important;
        opacity: 1 !important;
        transform: none !important;
      }
    }
