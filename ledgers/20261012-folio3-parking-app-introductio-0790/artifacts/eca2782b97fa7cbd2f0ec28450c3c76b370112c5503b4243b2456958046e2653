  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    :root {
      --font-sans: 'Hanken Grotesk', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      --font-mono: 'JetBrains Mono', monospace;
      --color-primary: #A95540;
      --color-primary-dark: #8c3f2d;
      --color-primary-light: #fbf5f3;
      --color-surface: #ffffff;
      --color-surface-subtle: #fcfbf9;
      --color-border: #e6e2dc;
      --color-border-subtle: #f0ede8;
      --color-text-primary: #211d19;
      --color-text-secondary: #6e675f;
      --color-text-tertiary: #9c958c;
      --color-success: #1e7e4e;
      --color-success-bg: #eef8f2;
      --color-danger: #b33924;
      --color-danger-bg: #fdf2f0;
      --color-neutral-badge: #f1ede8;
    }

    body {
      font-family: var(--font-sans);
      background-color: #faf8f5;
      color: var(--color-text-primary);
      -webkit-font-smoothing: antialiased;
    }

    .font-mono {
      font-family: var(--font-mono);
    }

    /* Motion specifications */
    @keyframes pageEntrance {
      0% {
        opacity: 0;
        transform: translateY(6px);
      }
      100% {
        opacity: 1;
        transform: translateY(0);
      }
    }

    /* The one ambient animation: Only while an entry check is actively evaluated, its status dot breathes opacity 0.76→1→0.76 on a 7.5s cubic-bezier(0.65, 0, 0.35, 1) cycle */
    @keyframes dotBreathe {
      0%, 100% {
        opacity: 0.76;
      }
      50% {
        opacity: 1;
      }
    }

    .animate-entrance {
      animation: pageEntrance 400ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    .active-evaluating-dot {
      animation: dotBreathe 7.5s cubic-bezier(0.65, 0, 0.35, 1) infinite;
    }

    /* Interactive control states: hover, focus, pressed */
    .interactive-btn {
      transition: background-color 150ms ease, border-color 150ms ease, box-shadow 150ms ease, transform 90ms ease;
    }
    .interactive-btn:hover {
      background-color: var(--color-primary-dark);
    }
    .interactive-btn:focus-visible {
      outline: 2px solid var(--color-primary);
      outline-offset: 2px;
    }
    .interactive-btn:active {
      transform: scale(0.98);
    }

    .interactive-link {
      transition: color 140ms ease, border-color 140ms ease;
    }
    .interactive-link:hover {
      color: var(--color-primary);
    }
    .interactive-link:focus-visible {
      outline: 2px solid var(--color-primary);
      outline-offset: 2px;
    }
    .interactive-link:active {
      opacity: 0.85;
    }

    .interactive-input {
      transition: border-color 140ms ease, box-shadow 140ms ease;
    }
    .interactive-input:hover {
      border-color: #d1cbc2;
    }
    .interactive-input:focus {
      outline: none;
      border-color: var(--color-primary);
      box-shadow: 0 0 0 2px rgba(169, 85, 64, 0.15);
    }

    @media (prefers-reduced-motion: reduce) {
      *, ::before, ::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
      }
    }
  </style>
</head>
