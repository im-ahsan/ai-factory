  <style>
    :root {
      --dur-instant: 90ms;
      --dur-quick: 160ms;
      --dur-base: 260ms;
      --dur-slow: 420ms;
      --dur-scene: 800ms;
      --ease-out: cubic-bezier(0.16, 1, 0.3, 1);
      --ease-in: cubic-bezier(0.7, 0, 0.84, 0);
      --ease-inout: cubic-bezier(0.65, 0, 0.35, 1);
    }

    /* Page Entrance Animation */
    @keyframes settle-in {
      from { opacity: 0.84; transform: translateY(6px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .page-intro {
      animation: settle-in var(--dur-slow) var(--ease-out) both;
    }

    /* Signature motion: bar fill settles from scaleX(1.04) to scaleX(1) over 600ms cubic-bezier(0.16, 1, 0.3, 1), staggered 40ms */
    @keyframes bar-settle {
      from { transform: scaleX(1.04); }
      to { transform: scaleX(1); }
    }
    .bar-anim {
      transform-origin: left center;
      animation: bar-settle 600ms cubic-bezier(0.16, 1, 0.3, 1) both;
    }
    .bar-delay-0 { animation-delay: 0ms; }
    .bar-delay-1 { animation-delay: 40ms; }
    .bar-delay-2 { animation-delay: 80ms; }
    .bar-delay-3 { animation-delay: 120ms; }
    .bar-delay-4 { animation-delay: 160ms; }
    .bar-delay-5 { animation-delay: 200ms; }

    /* The one ambient animation: actively evaluated status dot breathes opacity 0.76->1->0.76 on 7.5s cycle */
    @keyframes dot-breathe {
      0%, 100% { opacity: 0.76; }
      50% { opacity: 1; }
    }
    .status-dot-evaluating {
      animation: dot-breathe 7.5s cubic-bezier(0.65, 0, 0.35, 1) infinite;
    }

    /* Tactile interaction tokens */
    .btn-press {
      transition: transform var(--dur-instant), background-color var(--dur-quick), border-color var(--dur-quick);
    }
    .btn-press:active {
      transform: scale(0.97);
    }
    
    .nav-link {
      transition: color var(--dur-quick) ease;
    }
    .nav-link:hover {
      color: #222927;
    }

    .row-hover {
      transition: background-color var(--dur-quick) ease;
    }
    .row-hover:hover {
      background-color: #F8F9F9;
    }

    .focus-ring:focus-visible {
      outline: 2px solid #A95540;
      outline-offset: 2px;
    }

    /* Tabular numeric rendering */
    .t-num {
      font-variant-numeric: tabular-nums;
    }

    @media (prefers-reduced-motion: reduce) {
      .page-intro, .bar-anim, .status-dot-evaluating {
        animation: none !important;
        opacity: 1 !important;
        transform: none !important;
      }
      *, *::before, *::after {
        scroll-behavior: auto !important;
        transition-duration: 120ms !important;
      }
    }
  </style>
</head>

