  <style>
    /* Design System Motion Tokens & View Transitions */
    @keyframes fadeInSlideUp {
      0% {
        opacity: 0;
        transform: translateY(6px);
      }
      100% {
        opacity: 1;
        transform: translateY(0);
      }
    }

    /* Ambient live breathing dot: 7.5s ease-in-out infinite, opacity 0.94 to 1 */
    @keyframes liveBreathing {
      0%, 100% {
        opacity: 0.94;
        transform: scale(1);
      }
      50% {
        opacity: 1;
        transform: scale(1.08);
      }
    }

    .live-dot-pulse {
      animation: liveBreathing 7.5s ease-in-out infinite;
    }

    /* Entrance sequence on load */
    .entrance-nav {
      animation: fadeInSlideUp 300ms cubic-bezier(0.16, 1, 0.3, 1) both;
    }
    .entrance-header {
      animation: fadeInSlideUp 340ms cubic-bezier(0.16, 1, 0.3, 1) 60ms both;
    }
    .entrance-body {
      animation: fadeInSlideUp 380ms cubic-bezier(0.16, 1, 0.3, 1) 120ms both;
    }
    .entrance-footer {
      animation: fadeInSlideUp 400ms cubic-bezier(0.16, 1, 0.3, 1) 180ms both;
    }

    /* Bay-mark handoff signature transition name */
    .bay-mark-handoff {
      view-transition-name: parking-record;
      transition: all 420ms cubic-bezier(0.65, 0, 0.35, 1);
    }

    /* Interactive state micro-transitions */
    button, a, input, select {
      transition: all 160ms cubic-bezier(0.4, 0, 0.2, 1);
    }
    button:active, a:active {
      transform: scale(0.98);
    }

    @media (prefers-reduced-motion: reduce) {
      *, ::before, ::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
        scroll-behavior: auto !important;
      }
      .live-dot-pulse {
        animation: none !important;
        opacity: 1 !important;
      }
    }
  </style>
