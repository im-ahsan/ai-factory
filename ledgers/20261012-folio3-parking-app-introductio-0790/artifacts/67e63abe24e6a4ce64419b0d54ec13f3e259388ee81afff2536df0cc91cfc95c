    /* Keyframes */
    @keyframes page-enter {
      from {
        opacity: 0;
        transform: translateY(var(--travel));
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes status-breathe {
      0%, 100% {
        opacity: 0.94;
      }
      50% {
        opacity: 1;
