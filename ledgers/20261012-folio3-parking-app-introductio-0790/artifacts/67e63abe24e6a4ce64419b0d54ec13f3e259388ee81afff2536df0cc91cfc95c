    /* Motion Sequencing */
    .animate-enter-1 {
      animation: page-enter var(--dur-slow) var(--ease-out) forwards;
    }

    .animate-enter-2 {
      animation: page-enter var(--dur-slow) var(--ease-out) 60ms forwards;
      opacity: 0;
    }

    .animate-enter-3 {
      animation: page-enter var(--dur-slow) var(--ease-out) 120ms forwards;
      opacity: 0;
    }

    /* The one and only permissible ambient pulse */
    .live-status-dot {
      animation: status-breathe 7.5s ease-in-out infinite;
    }

    /* Signature Motion: Bay-mark handoff rule */
    .record-title, .record-rule {
      view-transition-name: parking-record;
    }

    ::view-transition-old(parking-record),
    ::view-transition-new(parking-record) {
      animation-duration: var(--dur-slow);
      animation-timing-function: var(--ease-inout);
    }

    /* Reduced Motion Safety */
    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        scroll-behavior: auto !important;
        animation-duration: 1ms !important;
        animation-iteration-count: 1 !important;
