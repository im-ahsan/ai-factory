<style>
    /* Design System Motion Tokens & Signature Motions */
    :root {
      --motion-timing-standard: cubic-bezier(0.65, 0, 0.35, 1);
      --motion-duration-entrance: 420ms;
    }

    @keyframes entranceFadeIn {
      0% {
        opacity: 0;
        transform: translateY(6px);
      }
      100% {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes ambientStatusBreath {
      0%, 100% {
        opacity: 0.94;
      }
      50% {
        opacity: 1;
      }
    }

    /* Page Entrance Sequence */
    .animate-entrance {
      animation: entranceFadeIn var(--motion-duration-entrance) var(--motion-timing-standard) forwards;
    }

    .stagger-1 { animation-delay: 40ms; }
    .stagger-2 { animation-delay: 90ms; }
    .stagger-3 { animation-delay: 150ms; }

