      animation: ambientStatusBreath 7.5s ease-in-out infinite;
    }

    /* Interactive state controls */
    .interactive-btn {
      transition: background-color 160ms ease, border-color 160ms ease, transform 90ms ease, box-shadow 160ms ease;
    }
    .interactive-btn:hover {
      background-color: #1B2022;
    }
    .interactive-btn:focus-visible {
      outline: 2px solid #3FA77A;
      outline-offset: 2px;
    }
    .interactive-btn:active {
      transform: scale(0.97);
    }

    .interactive-primary {
      transition: background-color 160ms ease, transform 90ms ease, box-shadow 160ms ease;
    }
    .interactive-primary:hover {
      background-color: #359269;
    }
    .interactive-primary:focus-visible {
      outline: 2px solid #3FA77A;
      outline-offset: 2px;
    }
    .interactive-primary:active {
      transform: scale(0.97);
    }

    /* Reduced Motion preference */
    @media (prefers-reduced-motion: reduce) {
      *, ::before, ::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
        scroll-behavior: auto !important;
      }
      .live-status-dot {
        animation: none !important;
        opacity: 1 !important;
      }
    }
  </style>
