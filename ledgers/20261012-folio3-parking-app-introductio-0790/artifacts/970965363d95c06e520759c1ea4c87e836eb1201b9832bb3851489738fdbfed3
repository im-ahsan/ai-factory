<style>
    :root {
      --dur-instant: 90ms;
      --dur-quick: 160ms;
      --dur-base: 260ms;
      --dur-slow: 420ms;
      --dur-scene: 700ms;
      --ease-out: cubic-bezier(0.16, 1, 0.3, 1);
      --ease-in: cubic-bezier(0.7, 0, 0.84, 0);
      --ease-inout: cubic-bezier(0.65, 0, 0.35, 1);
      --travel: 8px;
    }

    /* Motion System Keyframes */
    @keyframes page-enter {
      from {
        opacity: 0;
        transform: translateY(var(--travel));
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes status-breathe {
      0%, 100% {
        opacity: 0.94;
      }
      50% {
        opacity: 1.0;
      }
    }

    /* Staggered entrance animation for admin workspace */
    .animate-enter-header {
      animation: page-enter var(--dur-base) var(--ease-out) forwards;
    }

    .animate-enter-main {
      animation: page-enter var(--dur-slow) var(--ease-out) 60ms forwards;
      opacity: 0;
    }

    .animate-enter-side {
      animation: page-enter var(--dur-slow) var(--ease-out) 120ms forwards;
      opacity: 0;
    }

    /* Single ambient breathing indicator (live operational sync) */
    .live-status-dot {
      animation: status-breathe 7.5s ease-in-out infinite;
    }

    /* Signature Bay-mark transition token */
    .record-title, .record-rule {
      view-transition-name: parking-record;
    }
    ::view-transition-old(parking-record),
    ::view-transition-new(parking-record) {
      animation-duration: var(--dur-slow);
      animation-timing-function: var(--ease-inout);
    }

    /* Reduced Motion Compliance */
    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        scroll-behavior: auto !important;
        animation-duration: 1ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 120ms !important;
      }
      .live-status-dot {
        animation: none !important;
      }
      .animate-enter-header,
      .animate-enter-main,
      .animate-enter-side {
        animation: none !important;
        opacity: 1 !important;
        transform: none !important;
      }
    }

    /* Tabular numeric rendering across numeric/timestamp elements */
    .tabular-numbers {
      font-variant-numeric: tabular-nums;
    }

    /* Precise button pressing feedback */
    .press-scale {
      transition: transform var(--dur-instant) ease-out, background-color var(--dur-quick) ease, border-color var(--dur-quick) ease;
    }
    .press-scale:active {
      transform: scale(0.97);
    }
  </style>
