  <!-- Font imports: Hanken Grotesk, Source Sans 3, IBM Plex Mono -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@600&family=IBM+Plex+Mono:wght@400;500;600&family=Source+Sans+3:wght@400;500;600&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    /* Design system rules & exact values */
    :root {
      --bg-page: #F3F6F8;
      --bg-surface: #FFFFFF;
      --text-main: #25313B;
      --text-quiet: #5D6A75;
      --border-rule: #D6DEE5;
      --brand-primary: #356F9A;
      --status-good: #2D6F4F;
      --status-waiting: #8A5C14;
      --status-refused: #A53B36;
    }

    body {
      background-color: var(--bg-page);
      color: var(--text-main);
      font-family: 'Source Sans 3', sans-serif;
      font-size: 14px;
      line-height: 22px;
      margin: 0;
      padding: 0;
      -webkit-font-smoothing: antialiased;
    }

    h1, h2, h3, .font-heading {
      font-family: 'Hanken Grotesk', sans-serif;
    }

    .font-mono-code {
      font-family: 'IBM Plex Mono', monospace;
    }

    /* Motion specifications */
    @keyframes entranceFadeIn {
      0% {
        opacity: 0;
        transform: translateY(8px);
      }
      100% {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes parkingRecordSettle {
      0% {
        opacity: 0;
        transform: translateY(8px);
      }
      100% {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes entryCheckBreathe {
      0%, 100% {
        opacity: 0.96;
      }
      50% {
        opacity: 1;
      }
    }

    .animate-entrance {
      animation: entranceFadeIn 160ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    .record-settle {
      animation: parkingRecordSettle 160ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    .status-dot-breathe {
      animation: entryCheckBreathe 8s cubic-bezier(0.65, 0, 0.35, 1) infinite;
    }

    @media (prefers-reduced-motion: reduce) {
      *, ::before, ::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
        scroll-behavior: auto !important;
      }
    }

    /* Interaction states */
    button, input, a {
      transition: background-color 120ms ease, border-color 120ms ease, color 120ms ease, opacity 120ms ease;
    }

    button:focus-visible, a:focus-visible, input:focus-visible {
      outline: 2px solid var(--brand-primary);
      outline-offset: 2px;
    }

    .primary-btn {
      background-color: var(--brand-primary);
      color: #FFFFFF;
      height: 44px;
      border-radius: 8px;
      font-weight: 600;
      border: 1px solid var(--brand-primary);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 0 20px;
    }

    .primary-btn:hover {
      opacity: 0.92;
    }

    .primary-btn:active {
      opacity: 0.84;
    }

    .secondary-btn {
      background-color: #FFFFFF;
      color: var(--text-main);
      height: 44px;
      border-radius: 8px;
      font-weight: 500;
      border: 1px solid var(--border-rule);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 0 16px;
    }

    .secondary-btn:hover {
      border-color: #B2C0CC;
      background-color: #FAFCFD;
    }

    .secondary-btn:active {
      background-color: #F0F4F8;
    }

    .cancel-btn {
      height: 36px;
      border-radius: 8px;
      border: 1px solid var(--border-rule);
      background-color: #FFFFFF;
      color: var(--text-main);
      font-weight: 500;
      padding: 0 14px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }

    .cancel-btn:hover {
      border-color: var(--status-refused);
      color: var(--status-refused);
      background-color: #FFF9F9;
    }

    .cancel-btn:active {
      background-color: #FDF0F0;
    }

    /* Calendar styling */
    .cal-day {
      width: 40px;
      height: 40px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border-radius: 8px;
      font-size: 13px;
      user-select: none;
      transition: all 120ms ease;
    }
    .cal-day.selectable:hover {
      background-color: #EBF2F7;
      cursor: pointer;
    }
    .cal-day.selected {
      background-color: var(--brand-primary);
      color: #FFFFFF;
      font-weight: 600;
    }
    .cal-day.existing-scheduled {
      border: 1px solid #2D6F4F;
      color: #2D6F4F;
      font-weight: 600;
      background-color: #F3F9F5;
    }
    .cal-day.disabled {
      color: #A4B0BA;
      cursor: not-allowed;
    }
  </style>
</head>
