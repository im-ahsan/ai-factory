<style>
    :root {
      --dur-instant: 90ms;
      --dur-quick: 160ms;
      --dur-base: 260ms;
      --dur-slow: 420ms;
      --dur-scene: 700ms;
      --ease-out: cubic-bezier(0.16, 1, 0.3, 1);
      --ease-in: cubic-bezier(0.7, 0, 0.84, 0);
      --ease-inout: cubic-bezier(0.65, 0, 0.35, 1);
      --travel: 8px;
    }

    /* Tabular figures for operational timestamps and identifiers */
    .tabular-nums {
      font-variant-numeric: tabular-nums;
    }

    /* Ambient live facility status pulse - ONLY perpetual loop allowed */
    @keyframes status-breathe {
      0%, 100% { opacity: 0.94; transform: scale(1); }
      50% { opacity: 1; transform: scale(1.06); }
    }
    .live-status-dot {
      animation: status-breathe 7.5s ease-in-out infinite;
    }

    /* Entrance sequencing */
    @keyframes page-enter {
      from {
        opacity: 0;
        transform: translateY(var(--travel));
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .enter-stagger-1 {
      animation: page-enter var(--dur-slow) var(--ease-out) forwards;
    }
    .enter-stagger-2 {
      animation: page-enter var(--dur-slow) var(--ease-out) 60ms forwards;
      opacity: 0;
    }
    .enter-stagger-3 {
      animation: page-enter var(--dur-slow) var(--ease-out) 120ms forwards;
      opacity: 0;
    }

    /* Micro-interactions: pressed scale */
    .btn-press:active {
      transform: scale(0.97);
    }

    /* Focus visible ring conformant to DS specifications */
    .action-focus:focus-visible {
      outline: 2px solid #3FA77A;
      outline-offset: 2px;
    }

    /* Signature Bay-Mark record view transition */
    .record-title, .record-rule {
      view-transition-name: parking-record;
    }
    ::view-transition-old(parking-record),
    ::view-transition-new(parking-record) {
      animation-duration: var(--dur-slow);
      animation-timing-function: var(--ease-inout);
    }

    /* Strict accessibility reduced motion override */
    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        scroll-behavior: auto !important;
        animation-duration: 1ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 120ms !important;
      }
      .live-status-dot {
        animation: none !important;
      }
      .enter-stagger-1, .enter-stagger-2, .enter-stagger-3 {
        opacity: 1 !important;
        transform: none !important;
      }
    }
  </style>
