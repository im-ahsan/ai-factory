  <!-- Interactive Filter & Drawer JavaScript -->
  <script>
    // Responsive drawer toggle
    const mobileMenuBtn = document.getElementById('mobileMenuBtn');
    const mobileMenu = document.getElementById('mobileMenu');
    if (mobileMenuBtn && mobileMenu) {
      mobileMenuBtn.addEventListener('click', () => {
        const isExpanded = mobileMenuBtn.getAttribute('aria-expanded') === 'true';
        mobileMenuBtn.setAttribute('aria-expanded', !isExpanded);
        mobileMenu.classList.toggle('hidden');
      });
    }

    // Instant filter logic without Apply button
    const searchInput = document.getElementById('searchInput');
    const deptFilter = document.getElementById('deptFilter');
    const roleFilter = document.getElementById('roleFilter');
    const spaceFilter = document.getElementById('spaceFilter');
    const employeeItems = document.querySelectorAll('.employee-item');
    const noMatchState = document.getElementById('noMatchState');

    function applyFilters() {
      const query = (searchInput.value || '').trim().toLowerCase();
      const selectedDept = deptFilter.value;
      const selectedRole = roleFilter.value;
      const selectedSpace = spaceFilter.value;

      let visibleCount = 0;

      employeeItems.forEach(item => {
        const name = item.getAttribute('data-name').toLowerCase();
        const dept = item.getAttribute('data-dept');
        const role = item.getAttribute('data-role');
        const space = item.getAttribute('data-space');
        const vehicle = item.getAttribute('data-vehicle').toLowerCase();

        const matchesQuery = !query || name.includes(query) || dept.toLowerCase().includes(query) || role.toLowerCase().includes(query) || vehicle.includes(query);
        const matchesDept = (selectedDept === 'all') || (dept === selectedDept);
        const matchesRole = (selectedRole === 'all') || (role === selectedRole);
        const matchesSpace = (selectedSpace === 'all') || (space === selectedSpace);

        if (matchesQuery && matchesDept && matchesRole && matchesSpace) {
          item.classList.remove('hidden');
          // Re-trigger subtle settle animation
          item.classList.remove('settle-row');
          void item.offsetWidth; // trigger reflow
          item.classList.add('settle-row');
          visibleCount++;
        } else {
          item.classList.add('hidden');
        }
      });

      if (noMatchState) {
        if (visibleCount === 0) {
          noMatchState.classList.remove('hidden');
        } else {
          noMatchState.classList.add('hidden');
        }
      }
    }

    if (searchInput) searchInput.addEventListener('input', applyFilters);
    if (deptFilter) deptFilter.addEventListener('change', applyFilters);
    if (roleFilter) roleFilter.addEventListener('change', applyFilters);
    if (spaceFilter) spaceFilter.addEventListener('change', applyFilters);
  </script>
