  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    :root {
      --bg: #F3F6F8;
      --surface: #FFFFFF;
      --text: #25313B;
      --quiet: #5D6A75;
      --border: #D6DEE5;
      --primary: #356F9A;
      --status-good: #2D6F4F;
      --status-waiting: #8A5C14;
      --status-failed: #A53B36;
    }

    body {
      background-color: var(--bg);
      color: var(--text);
      font-family: 'Source Sans 3', sans-serif;
      font-size: 14px;
      line-height: 22px;
      margin: 0;
      padding: 0;
      -webkit-font-smoothing: antialiased;
    }

    h1, h2, h3, .heading-font {
      font-family: 'Hanken Grotesk', sans-serif;
    }

    .mono-num {
      font-family: 'IBM Plex Mono', monospace;
    }

    /* Motion specifications */
    @keyframes entranceFadeUp {
      0% {
        opacity: 0;
        transform: translateY(8px);
      }
      100% {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes breatheStatus {
      0%, 100% {
        opacity: 0.96;
      }
      50% {
        opacity: 1;
      }
    }

    .page-enter {
      animation: entranceFadeUp 160ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    .settle-row {
      animation: entranceFadeUp 160ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    .status-pulse {
      animation: breatheStatus 8s cubic-bezier(0.65, 0, 0.35, 1) infinite;
    }

    @media (prefers-reduced-motion: reduce) {
      *, ::before, ::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
      }
    }

    /* Interactive state tokens */
    a, button, input, select {
      transition: background-color 120ms ease, border-color 120ms ease, color 120ms ease, box-shadow 120ms ease;
    }

    a:focus-visible, button:focus-visible, input:focus-visible, select:focus-visible {
      outline: none;
      box-shadow: 0 0 0 2px var(--primary);
    }

    .row-link {
      display: block;
      color: inherit;
      text-decoration: none;
    }

    .row-link:hover {
      background-color: #F8FAFC;
    }

    .row-link:active {
      background-color: #EEF3F7;
    }
  </style>
</head>
