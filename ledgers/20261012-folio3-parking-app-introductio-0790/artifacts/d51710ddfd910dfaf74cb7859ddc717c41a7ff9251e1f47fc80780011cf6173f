<style>
    :root {
      --dur-instant: 90ms;
      --dur-quick: 160ms;
      --dur-base: 260ms;
      --dur-slow: 420ms;
      --dur-scene: 700ms;
      --ease-out: cubic-bezier(0.16, 1, 0.3, 1);
      --ease-in: cubic-bezier(0.7, 0, 0.84, 0);
      --ease-inout: cubic-bezier(0.65, 0, 0.35, 1);
      --travel: 8px;
    }

    /* Page Entrance Animation */
    @keyframes page-enter {
      from {
        opacity: 0;
        transform: translateY(var(--travel));
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .animate-entrance {
      animation: page-enter var(--dur-slow) var(--ease-out) forwards;
    }

    .stagger-1 {
      animation: page-enter var(--dur-slow) var(--ease-out) 60ms forwards;
      opacity: 0;
    }

    .stagger-2 {
      animation: page-enter var(--dur-slow) var(--ease-out) 120ms forwards;
      opacity: 0;
    }

    /* The Only Ambient Animation: Live availability dot breathes subtly */
    @keyframes status-breathe {
      0%, 100% { opacity: 0.94; transform: scale(1); }
      50% { opacity: 1; transform: scale(1.08); }
    }

    .live-status-dot {
      animation: status-breathe 7.5s ease-in-out infinite;
    }

    /* Tabular figures for operational timestamps and identifiers */
    .tabular-nums {
      font-variant-numeric: tabular-nums;
    }

    /* Signature Motion: Bay-mark handoff */
    .record-title, .record-rule {
      view-transition-name: parking-record;
    }

    ::view-transition-old(parking-record),
    ::view-transition-new(parking-record) {
      animation-duration: var(--dur-slow);
      animation-timing-function: var(--ease-inout);
    }

    /* Painted bay-edge styling: slim accent edge */
    .bay-edge-indicator {
      box-shadow: inset 2px 0 0 0 #3fa77a;
    }

    /* Reduced Motion */
    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        scroll-behavior: auto !important;
        animation-duration: 1ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0ms !important;
      }
      .live-status-dot {
        animation: none !important;
        opacity: 1 !important;
      }
      .animate-entrance, .stagger-1, .stagger-2 {
        animation: none !important;
        opacity: 1 !important;
        transform: none !important;
      }
    }
  </style>
</head>
