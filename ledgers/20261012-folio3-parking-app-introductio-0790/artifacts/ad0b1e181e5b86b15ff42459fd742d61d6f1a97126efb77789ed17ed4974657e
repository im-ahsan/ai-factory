  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    /* Design Tokens */
    :root {
      --bg-page: #F3F6F8;
      --bg-surface: #FFFFFF;
      --text-main: #25313B;
      --text-muted: #5D6A75;
      --border-color: #D6DEE5;
      --primary-accent: #356F9A;
      --status-good: #2D6F4F;
      --status-waiting: #8A5C14;
      --status-failed: #A53B36;
    }

    body {
      background-color: var(--bg-page);
      color: var(--text-main);
      font-family: 'Source Sans 3', sans-serif;
      font-size: 14px;
      line-height: 22px;
      margin: 0;
      padding: 0;
      -webkit-font-smoothing: antialiased;
    }

    h1, h2, h3, .font-heading {
      font-family: 'Hanken Grotesk', sans-serif;
    }

    .font-mono-code {
      font-family: 'IBM Plex Mono', monospace;
    }

    /* Motion Tokens & Keyframes */
    @keyframes pageFadeIn {
      from {
        opacity: 0;
        transform: translateY(6px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes parkingRecordSettle {
      from {
        opacity: 0;
        transform: translateY(8px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes statusBreathe {
      0%, 100% {
        opacity: 1;
      }
      50% {
        opacity: 0.96;
      }
    }

    .animate-page-entrance {
      animation: pageFadeIn 220ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    .record-settle {
      animation: parkingRecordSettle 160ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    .status-pulse-ambient {
      animation: statusBreathe 8s cubic-bezier(0.65, 0, 0.35, 1) infinite;
    }

    /* Controls: hover, focus, pressed states */
    .btn-primary {
      background-color: var(--primary-accent);
      color: #FFFFFF;
      height: 44px;
      border-radius: 8px;
      font-weight: 600;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 0 20px;
      transition: background-color 120ms ease, transform 80ms ease;
      outline: none;
    }
    .btn-primary:hover {
      background-color: #2b5c82;
    }
    .btn-primary:active {
      transform: scale(0.99);
      background-color: #244e6f;
    }
    .btn-primary:focus-visible {
      box-shadow: 0 0 0 3px rgba(53, 111, 154, 0.35);
    }

    .filter-select {
      height: 44px;
      border: 1px solid var(--border-color);
      border-radius: 8px;
      background-color: var(--bg-surface);
      color: var(--text-main);
      padding: 0 36px 0 12px;
      font-size: 14px;
      font-family: 'Source Sans 3', sans-serif;
      outline: none;
      appearance: none;
      background-image: url("data:image/svg2+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' fill='none' viewBox='0 0 24 24' stroke='%235D6A75'%3E%3Cpath stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M19 9l-7 7-7-7'%3E%3C/path%3E%3C/svg%3E");
      background-repeat: no-repeat;
      background-position: right 12px center;
      background-size: 16px;
      transition: border-color 120ms ease, box-shadow 120ms ease;
    }
    .filter-select:hover {
      border-color: #b8c7d4;
    }
    .filter-select:focus {
      border-color: var(--primary-accent);
      box-shadow: 0 0 0 3px rgba(53, 111, 154, 0.25);
    }

    .nav-item {
      padding: 8px 14px;
      border-radius: 8px;
      font-size: 14px;
      font-weight: 600;
      color: var(--text-muted);
      text-decoration: none;
      transition: color 120ms ease, background-color 120ms ease;
      display: inline-flex;
      align-items: center;
    }
    .nav-item:hover {
      color: var(--text-main);
      background-color: rgba(0, 0, 0, 0.03);
    }
    .nav-item.active {
      color: var(--primary-accent);
      background-color: #EAF2F7;
    }

    .sort-header {
      cursor: pointer;
      user-select: none;
      transition: color 120ms ease;
    }
    .sort-header:hover {
      color: var(--text-main);
    }

    @media (prefers-reduced-motion: reduce) {
      *, ::before, ::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
      }
    }
  </style>
</head>
