  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:ital,wght@0,300..800;1,300..800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
  
  <style>
    body {
      font-family: 'Hanken Grotesk', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      color: #1f2937;
    }
    .font-mono {
      font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    }

    /* Motion Tokens & Keyframes */
    @keyframes pageEnter {
      0% { opacity: 0; transform: translateY(6px); }
      100% { opacity: 1; transform: translateY(0); }
    }

    @keyframes barSettle {
      0% { transform: scaleX(1.04); }
      100% { transform: scaleX(1.0); }
    }

    @keyframes dotBreathe {
      0%, 100% { opacity: 0.76; }
      50% { opacity: 1; }
    }

    .animate-page-enter {
      animation: pageEnter 360ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    /* Signature motion: bar settle */
    .bar-settle {
      transform-origin: left center;
      animation: barSettle 600ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
    .bar-delay-1 { animation-delay: 0ms; }
    .bar-delay-2 { animation-delay: 40ms; }
    .bar-delay-3 { animation-delay: 80ms; }
    .bar-delay-4 { animation-delay: 120ms; }
    .bar-delay-5 { animation-delay: 160ms; }

    /* Ambient animation for active entry check status dot */
    .dot-evaluating {
      animation: dotBreathe 7.5s cubic-bezier(0.65, 0, 0.35, 1) infinite;
    }

    /* Interactive state styles */
    .ctrl-interactive {
      transition: background-color 150ms ease, border-color 150ms ease, box-shadow 150ms ease, transform 90ms ease;
    }
    .ctrl-interactive:hover {
      background-color: #f7f3ee;
    }
    .ctrl-interactive:focus-visible {
      outline: 2px solid #a95540;
      outline-offset: 2px;
    }
    .ctrl-interactive:active {
      transform: scale(0.985);
    }

    .btn-primary {
      background-color: #a95540;
      color: #ffffff;
      transition: background-color 150ms ease, box-shadow 150ms ease, transform 90ms ease;
    }
    .btn-primary:hover {
      background-color: #924532;
    }
    .btn-primary:focus-visible {
      outline: 2px solid #a95540;
      outline-offset: 2px;
    }
    .btn-primary:active {
      transform: scale(0.985);
      background-color: #7d3a2a;
    }

    @media (prefers-reduced-motion: reduce) {
      *, ::before, ::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
        scroll-behavior: auto !important;
      }
    }
  </style>
</head>
