  <style>
    /* Design System Motion Tokens & Signature Rules */
    :root {
      --duration-handoff: 420ms;
      --ease-handoff: cubic-bezier(0.65, 0, 0.35, 1);
      --pulse-ease: ease-in-out;
    }

    /* Bay-mark handoff signature token */
    .bay-mark-handoff {
      view-transition-name: parking-record;
      transition: all var(--duration-handoff) var(--ease-handoff);
    }

    /* Single allowed ambient animation: Live availability status breathing dot (7.5s cycle) */
    @keyframes liveStatusBreathe {
      0%, 100% {
        opacity: 0.94;
        transform: scale(1);
      }
      50% {
        opacity: 1.0;
        transform: scale(1.06);
      }
    }

    .ambient-live-dot {
      animation: liveStatusBreathe 7.5s var(--pulse-ease) infinite;
    }

    /* Entrance sequence on load */
    @keyframes entranceFadeUp {
      from {
        opacity: 0;
        transform: translateY(8px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .animate-entrance-1 {
      animation: entranceFadeUp 320ms cubic-bezier(0.16, 1, 0.3, 1) both;
    }
    .animate-entrance-2 {
      animation: entranceFadeUp 360ms cubic-bezier(0.16, 1, 0.3, 1) 70ms both;
    }
    .animate-entrance-3 {
      animation: entranceFadeUp 400ms cubic-bezier(0.16, 1, 0.3, 1) 140ms both;
    }
    .animate-entrance-4 {
      animation: entranceFadeUp 440ms cubic-bezier(0.16, 1, 0.3, 1) 210ms both;
    }

    /* Interactive state micro-transitions */
    .control-interactive {
      transition: background-color 160ms cubic-bezier(0.2, 0, 0, 1),
                  border-color 160ms cubic-bezier(0.2, 0, 0, 1),
                  color 160ms cubic-bezier(0.2, 0, 0, 1),
                  box-shadow 160ms cubic-bezier(0.2, 0, 0, 1),
                  transform 120ms cubic-bezier(0.2, 0, 0, 1);
    }
    .control-interactive:active {
      transform: scale(0.985);
    }

    /* Accessibility: prefers-reduced-motion */
    @media (prefers-reduced-motion: reduce) {
      *, ::before, ::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
      }
      .ambient-live-dot {
        animation: none !important;
        opacity: 1 !important;
      }
    }
  </style>
</head>
<body class="bg-[#0c0e12] text-slate-200 min-h-screen font-sans selection:bg-[#3FA77A]/30 selection:text-white flex flex-col justify-between antialiased">

