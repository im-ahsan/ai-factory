<style>
    /* Design System Motion Tokens & Keyframes */
    @keyframes pageFadeIn {
      0% {
        opacity: 0;
        transform: translateY(6px);
      }
      100% {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes ambientBreathe {
      0%, 100% {
        opacity: 0.76;
      }
      50% {
        opacity: 1.0;
      }
    }

    .animate-page-entrance {
      animation: pageFadeIn 0.35s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    .ambient-pulse {
      animation: ambientBreathe 7.5s cubic-bezier(0.65, 0, 0.35, 1) infinite;
    }

    /* Hairline borders */
    .border-hairline {
      border-color: #E6E5E0;
    }
    .divide-hairline > * + * {
      border-color: #EFEFEA;
    }

    /* Interactive control states: hover, focus, pressed */
    .btn-action {
      transition: background-color 150ms cubic-bezier(0.16, 1, 0.3, 1),
                  color 150ms cubic-bezier(0.16, 1, 0.3, 1),
                  border-color 150ms cubic-bezier(0.16, 1, 0.3, 1),
                  transform 100ms cubic-bezier(0.16, 1, 0.3, 1);
    }
    .btn-action:hover {
      background-color: #F8F7F3;
      border-color: #D6D4CE;
    }
    .btn-action:focus-visible {
      outline: 2px solid #A95540;
      outline-offset: 1px;
    }
    .btn-action:active {
      transform: scale(0.98);
      background-color: #EFEFEA;
    }

    .btn-action-primary {
      transition: background-color 150ms cubic-bezier(0.16, 1, 0.3, 1),
                  transform 100ms cubic-bezier(0.16, 1, 0.3, 1),
                  box-shadow 150ms cubic-bezier(0.16, 1, 0.3, 1);
    }
    .btn-action-primary:hover {
      background-color: #8E4331;
    }
    .btn-action-primary:focus-visible {
      outline: 2px solid #733526;
      outline-offset: 2px;
    }
    .btn-action-primary:active {
      transform: scale(0.98);
      background-color: #733526;
    }

    .input-field {
      transition: border-color 150ms cubic-bezier(0.16, 1, 0.3, 1),
                  box-shadow 150ms cubic-bezier(0.16, 1, 0.3, 1);
    }
    .input-field:focus {
      border-color: #A95540;
      outline: none;
      box-shadow: 0 0 0 1px #A95540;
    }

    .nav-link {
      transition: color 150ms ease, border-color 150ms ease;
    }
    .nav-link:focus-visible {
      outline: 2px solid #A95540;
      outline-offset: -2px;
    }

    /* Accessibility: Reduced motion query */
    @media (prefers-reduced-motion: reduce) {
      .animate-page-entrance,
      .ambient-pulse,
      .btn-action,
      .btn-action-primary,
      .input-field,
      .nav-link {
        animation: none !important;
        transition: none !important;
      }
    }
  </style>
