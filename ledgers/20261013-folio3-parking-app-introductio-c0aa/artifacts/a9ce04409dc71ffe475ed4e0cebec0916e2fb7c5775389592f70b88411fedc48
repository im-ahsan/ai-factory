   $ref: '#/components/schemas/RegisterVehicleRequest'\\n            example:\\n              plate: \\\"RWP-3168\\\"\\n              make: \\\"Suzuki\\\"\\n              model: \\\"Swift\\\"\\n              color: \\\"Blue\\\"\\n      responses:\\n        '201':\\n          description: \\\"Vehicle registered and active\\\"\\n          content:\\n            application/json:\\n              schema:\\n                $ref: '#/components/schemas/Vehicle'\\n              example:\\n                id: 1003\\n                plate: \\\"RWP-3168\\\"\\n                make: \\\"Suzuki\\\"\\n                model: \\\"Swift\\\"\\n                color: \\\"Blue\\\"\\n                status: \\\"Active\\\"\\n        '400':\\n          $ref: '#/components/responses/InvalidRequest'\\n        '401':\\n          $ref: '#/components/responses/Unauthorized'\\n  /parking/working-days:\\n    get:\\n      operationId: getWorkingDays\\n      summary: \\\"Evaluate weekday availability for an office-local date range\\\"\\n      parameters:\\n        - name: startDate\\n          in: query\\n          required: true\\n          schema:\\n            type: string\\n            format: date\\n          example: \\\"2026-06-15\\\"\\n        - name: endDate\\n          in: query\\n          required: true\\n          schema:\\n            type: string\\n            format: date\\n          example: \\\"2026-06-21\\\"\\n      responses:\\n        '200':\\n          description: \\\"Office-local working-day values\\\"\\n          content:\\n            application/json:\\n              schema:\\n                $ref: '#/components/schemas/WorkingDayList'\\n              example:\\n                timezone: \\\"Asia/Karachi\\\"\\n                days:\\n                  - date: \\\"2026-06-15\\\"\\n                    workingDay: true\\n                  - date: \\\"2026-06-16\\\"\\n                    workingDay: true\\n                  - date: \\\"2026-06-17\\\"\\n                    workingDay: true\\n                  - date: \\\"2026-06-18\\\"\\n                    workingDay: true\\n                  - date: \\\"2026-06-19\\\"\\n                    workingDay: true\\n                  - date: \\\"2026-06-20\\\"\\n                    workingDay: false\\n                  - date: \\\"2026-06-21\\\"\\n                    workingDay: false\\n        '400':\\n          $ref: '#/components/responses/InvalidRequest'\\n        '401':\\n          $ref: '#/components/responses/Unauthorized'\\n  /parking/today:\\n    get:\\n      operationId: getParkingToday\\n      summary: \\\"Get today's parking dashboard data\\\"\\n      responses:\\n        '200':\\n          description: \\\"Employee parking summary and availability\\\"\\n          content:\\n            application/json:\\n              schema:\\n                $ref: '#/components/schemas/ParkingToday'\\n              example:\\n                officeDate: \\\"2026-06-16\\\"\\n                timezone: \\\"Asia/Karachi\\\"\\n                assignedParking: true\\n                assignedFloor: \\\"B2\\\"\\n                assignedSpace: \\\"B2-114\\\"\\n                spaceStatus: \\\"Reserved\\\"\\n                releaseTime: \\\"08:00\\\"\\n                availableSpaceCount: 3\\n                vehicle:\\n                  id: 1001\\n                  plate: \\\"KLG-4821\\\"\\n                  make: \\\"Honda\\\"\\n                  model: \\\"Civic\\\"\\n                  color: \\\"White\\\"\\n                  status: \\\"Active\\\"\\n                workingDaysText: \\\"Monday-Friday, including holidays\\\"\\n        '401':\\n          $ref: '#/components/responses/Unauthorized'\\n        '404':\\n          $ref: '#/components/responses/NotFound'\\n  /parking/releases/today:\\n    post:\\n      operationId: releaseParkingToday\\n      summary: \\\"Release today's dedicated parking space\\\"\\n      requestBody:\\n        required: true\\n        content:\\n          application/json:\\n            schema:\\n              $ref: '#/components/schemas/ReleaseTodayRequest'\\n            example:\\n              date: \\\"2026-06-16\\\"\\n      responses:\\n        '200':\\n          description: \\\"Today's space released\\\"\\n          content:\\n            application/json:\\n              schema:\\n                $ref: '#/components/schemas/Release'\\n              example:\\n                id: 501\\n                date: \\\"2026-06-16\\\"\\n                space: \\\"B2-114\\\"\\n                status: \\\"Released\\\"\\n                claimableAt: \\\"2026-06-16T08:00:00+05:00\\\"\\n                timezone: \\\"Asia/Karachi\\\"\\n        '400':\\n          $ref: '#/components/responses/InvalidRequest'\\n        '401':\\n          $ref: '#/components/responses/Unauthorized'\\n        '403':\\n          $ref: '#/components/responses/Forbidden'\\n        '409':\\n          $ref: '#/components/responses/Conflict'\\n  /parking/releases:\\n    get:\\n      operationId: listMyReleases\\n      summary: \\\"List the signed-in employee's scheduled parking releases\\\"\\n      responses:\\n        '200':\\n          description: \\\"Scheduled and claimed release records\\\"\\n          content:\\n            application/json:\\n              schema:\\n                $ref: '#/components/schemas/ReleaseList'\\n              example:\\n                timezone: \\\"Asia/Karachi\\\"\\n                dailyReleaseTime: \\\"08:00\\\"\\n                schedulingWindowDays: 30\\n                releases:\\n                  - id: 502\\n                    date: \\\"2026-06-18\\\"\\n                    space: \\\"B2-114\\\"\\n                    status: \\\"Scheduled\\\"\\n                    claimableAt: \\\"2026-06-18T08:00:00+05:00\\\"\\n                    timezone: \\\"Asia/Karachi\\\"\\n                  - id: 503\\n                    date: \\\"2026-06-22\\\"\\n                    space: \\\"B2-114\\\"\\n                    status: \\\"Claimed\\\"\\n                    claimableAt: \\\"2026-06-22T08:00:00+05:00\\\"\\n                    timezone: \\\"Asia/Karachi\\\"\\n        '401':\\n          $ref: '#/components/responses/Unauthorized'\\n        '403':\\n          $ref: '#/components/responses/Forbidden'\\n    post:\\n      operationId: scheduleReleases\\n      summary: \\\"Schedule one or more release dates\\\"\\n      requestBody:\\n        required: true\\n        content:\\n          application/json:\\n            schema:\\n              $ref: '#/components/schemas/ScheduleReleasesRequest'\\n            example:\\n              dates:\\n                - \\\"2026-06-18\\\"\\n                - \\\"2026-06-25\\\"\\n      responses:\\n        '201':\\n          description: \\\"Release dates saved\\\"\\n          content:\\n            application/json:\\n              schema:\\n                $ref: '#/components/schemas/ReleaseList'\\n              example:\\n                timezone: \\\"Asia/Karachi\\\"\\n                dailyReleaseTime: \\\"08:00\\\"\\n                schedulingWindowDays: 30\\n                releases:\\n                  - id: 502\\n                    date: \\\"2026-06-18\\\"\\n                    space: \\\"B2-114\\\"\\n                    status: \\\"Scheduled\\\"\\n                    claimableAt: \\\"2026-06-18T08:00:00+05:00\\\"\\n                    timezone: \\\"Asia/Karachi\\\"\\n                  - id: 504\\n                    date: \\\"2026-06-25\\\"\\n                    space: \\\"B2-114\\\"\\n                    status: \\\"Scheduled\\\"\\n                    claimableAt: \\\"2026-06-25T08:00:00+05:00\\\"\\n                    timezone: \\\"Asia/Karachi\\\"\\n        '400':\\n          $ref: '#/components/responses/InvalidRequest'\\n        '401':\\n          $ref: '#/components/responses/Unauthorized'\\n        '403':\\n          $ref: '#/components/responses/Forbidden'\\n        '409':\\n          $ref: '#/components/responses/Conflict'\\n  /parking/releases/{releaseId}:\\n    delete:\\n      operationId: cancelScheduledRelease\\n      summary: \\\"Cancel an unclaimed scheduled release\\\"\\n      parameters:\\n        - name: releaseId\\n          in: path\\n          required: true\\n          schema:\\n            type: integer\\n          example: 502\\n      responses:\\n        '200':\\n          description: \\\"Release cancelled and audit recorded\\\"\\n          content:\\n            application/json:\\n              schema:\\n                $ref: '#/components/schemas/ReleaseCancellation'\\n              example:\\n                release:\\n                  id: 502\\n                  date: \\\"2026-06-18\\\"\\n                  space: \\\"B2-114\\\"\\n                  status: \\\"Reserved\\\"\\n                  claimableAt: \\\"2026-06-18T08:00:00+05:00\\\"\\n                  timezone: \\\"Asia/Karachi\\\"\\n                auditEvents:\\n                  - id: 7001\\n                    event: \\\"Scheduled\\\"\\n                    date: \\\"2026-06-16T10:12:00+05:00\\\"\\n                  - id: 7002\\n                    event: \\\"Cancelled\\\"\\n                    date: \\\"2026-06-16T10:15:00+05:00\\\"\\n        '401':\\n          $ref: '#/components/responses/Unauthorized'\\n        '403':\\n          $ref: '#/components/responses/Forbidden'\\n        '404':\\n          $ref: '#/components/responses/NotFound'\\n        '409':\\n          $ref: '#/components/responses/Conflict'\\n  /parking/availability:\\n    get:\\n      operationId: getParkingAvailability\\n      summary: \\\"Get currently claimable temporary parking spaces\\\"\\n      responses:\\n        '200':\\n          description: \\\"Office-local availability and claimable releases\\\"\\n          content:\\n            application/json:\\n              schema:\\n                $ref: '#/components/schemas/ParkingAvailability'\\n              example:\\n                officeDate: \\\"2026-06-16\\\"\\n                timezone: \\\"Asia/Karachi\\\"\\n                availableSpaceCount: 3\\n                releases:\\n                  - id: 601\\n                    date: \\\"2026-06-16\\\"\\n                    space: \\\"B1-08\\\"\\n                    status: \\\"Released\\\"\\n                    claimableAt: \\\"2026-06-16T08:00:00+05:00\\\"\\n                    timezone: \\\"Asia/Karachi\\\"\\n        '401':\\n          $ref: '#/components/responses/Unauthorized'\\n  /parking/claims:\\n    post:\\n      operationId: claimParkingSpace\\n      summary: \\\"Claim the next eligible temporary parking space\\\"\\n      requestBody:\\n        required: true\\n        content:\\n          application/json:\\n            schema:\\n              $ref: '#/components/schemas/ClaimParkingRequest'\\n            example:\\n              vehicleId: 1001\\n      responses:\\n        '201':\\n          description: \\\"Temporary parking allocation created\\\"\\n          content:\\n            application/json:\\n              schema:\\n                $ref: '#/components/schemas/ParkingClaim'\\n              example:\\n                id: 801\\n                officeDate: \\\"2026-06-16\\\"\\n                timezone: \\\"Asia/Karachi\\\"\\n                space: \\\"B1-08\\\"\\n                floor: \\\"B1\\\"\\n                vehicle:\\n                  id: 1001\\n                  plate: \\\"KLG-4821\\\"\\n                  make: \\\"Toyota\\\"\\n                  model: \\\"Corolla\\\"\\n                  color: \\\"Silver\\\"\\n                  status: \\\"Active\\\"\\n                authorizedPlate: \\\"KLG-4821\\\"\\n                status: \\\"Active\\\"\\n                entryStatus: \\\"Awaiting detection\\\"\\n                floorCapacities:\\n                  - floor: \\\"B1\\\"\\n                    free: 8\\n                    total: 28\\n                  - floor: \\\"B2\\\"\\n                    free: 8\\n                    total: 28\\n                  - floor: \\\"B3\\\"\\n                    free: 5\\n                    total: 20\\n                allocationRule: \\\"Highest free count; ties go to lowest floor code\\\"\\n        '400':\\n          $ref: '#/components/responses/InvalidRequest'\\n        '401':\\n          $ref: '#/components/responses/Unauthorized'\\n        '403':\\n          $ref: '#/components/responses/Forbidden'\\n        '409':\\n          $ref: '#/components/responses/Conflict'\\n  /parking/claims/today:\\n    get:\\n      operationId: getMyClaimToday\\n      summary: \\\"Get the signed-in employee's temporary parking pass for today\\\"\\n      responses:\\n        '200':\\n          description: \\\"Today's temporary allocation\\\"\\n          content:\\n            application/json:\\n              schema:\\n                $ref: '#/components/schemas/ParkingClaim'\\n              example:\\n                id: 801\\n                officeDate: \\\"2026-06-16\\\"\\n                timezone: \\\"Asia/Karachi\\\"\\n                space: \\\"B1-08\\\"\\n                floor: \\\"B1\\\"\\n                vehicle:\\n                  id: 1001\\n                  plate: \\\"KLG-4821\\\"\\n                  make: \\\"Toyota\\\"\\n                  model: \\\"Corolla\\\"\\n                  color: \\\"Silver\\\"\\n                  status: \\\"Active\\\"\\n                authorizedPlate: \\\"KLG-4821\\\"\\n                status: \\\"Active\\\"\\n                entryStatus: \\\"Awaiting detection\\\"\\n                floorCapacities:\\n                  - floor: \\\"B1\\\"\\n                    free: 8\\n                    total: 28\\n                  - floor: \\\"B2\\\"\\n                    free: 8\\n                    total: 28\\n                  - floor: \\\"B3\\\"\\n                    free: 5\\n                    total: 20\\n                allocationRule: \\\"Highest free count; ties go to lowest floor code\\\"\\n        '401':\\n          $ref: '#/components/responses/Unauthorized'\\n        '404':\\n          $ref: '#/components/responses/NotFound'\\n  /parking/claims/cancel:\\n    post:\\n      operationId: cancelTemporaryClaim\\n      summary: \\\"Reject employee cancellation of a Phase 1 temporary claim\\\"\\n      requestBody:\\n        required: true\\n        content:\\n          application/json:\\n            schema:\\n              $ref: '#/components/schemas/CancelClaimRequest'\\n            example:\\n              claimId: 801\\n      responses:\\n        '409':\\n          description: \\\"Temporary claim cancellation is unavailable in Phase 1\\\"\\n          content:\\n            application/json:\\n              schema:\\n                $ref: '#/components/schemas/ErrorResponse'\\n              example:\\n                code: \\\"CLAIM_CANCELLATION_UNAVAILABLE\\\"\\n                message: \\\"Employee cancellation of temporary claims is not available in Phase 1.\\\"\\n                field: \\\"claimId\\\"\\n        '401':\\n          $ref: '#/components/responses/Unauthorized'\\n        '404':\\n          $ref: '#/components/responses/NotFound'\\n  /admin/roster:\\n    get:\\n      operationId: listEmployeeRoster\\n      summary: \\\"Search and page through the employee parking roster\\\"\\n      parameters:\\n        - name: search\\n          in: query\\n          required: false\\n          schema:\\n            type: string\\n          example: \\\"Aisha\\\"\\n        - name: assignment\\n          in: query\\n          required: false\\n          schema:\\n            type: string\\n            enum:\\n              - \\\"All\\\"\\n              - \\\"Dedicated\\\"\\n              - \\\"Non-dedicated\\\"\\n          example: \\\"All\\\"\\n        - name: page\\n          in: query\\n          required: false\\n          schema:\\n            type: integer\\n          example: 1\\n        - name: pageSize\\n          in: query\\n          required: false\\n          schema:\\n            type: integer\\n          example: 10\\n      responses:\\n        '200':\\n          description: \\\"Authorized roster page\\\"\\n          content:\\n            application/json:\\n              schema:\\n                $ref: '#/components/schemas/RosterPage'\\n              example:\\n                page: 1\\n                pages: 18\\n                rows:\\n                  - employeeId: 101\\n                    employeeName: \\\"Aisha Rahman\\\"\\n                    corporateEmail: \\\"aisha.rahman@folio3.com\\\"\\n                    assignment: \\\"Dedicated · B2-114\\\"\\n                    vehiclePlate: \\\"KLG-4821\\\"\\n                    access: \\\"Employee\\\"\\n                  - employeeId: 102\\n                    employeeName: \\\"Bilal Ahmed\\\"\\n                    corporateEmail: \\\"bilal.ahmed@folio3.com\\\"\\n                    assignment: \\\"Non-dedicated\\\"\\n                    vehiclePlate: \\\"LEA-9073\\\"\\n                    access: \\\"Employee\\\"\\n        '401':\\n          $ref: '#/components/responses/Unauthorized'\\n        '403':\\n          $ref: '#/components/responses/Forbidden'\\n  /entrance/verifications:\\n    post:\\n      operationId: verifyEntranceDetection\\n      summary: \\\"Verify an LPR detection and request an indicator outcome\\\"\\n      requestBody:\\n        required: true\\n        content:\\n          application/json:\\n            schema:\\n              $ref: '#/components/schemas/EntranceVerificationRequest'\\n            example:\\n              objectType: \\\"Car\\\"\\n              plate: \\\"KLG-4821\\\"\\n              detectedAt: \\\"2026-06-16T08:12:00+05:00\\\"\\n              cameraStatus: \\\"Available\\\"\\n              recognitionStatus: \\\"Readable\\\"\\n              networkStatus: \\\"Available\\\"\\n              indicatorStatus: \\\"Available\\\"\\n      responses:\\n        '200':\\n          description: \\\"Recorded authorization, denial, non-car, or unsuccessful result\\\"\\n          content:\\n            application/json:\\n              schema:\\n                $ref: '#/components/schemas/EntranceVerification'\\n              example:\\n                id: 9001\\n                officeDate: \\\"2026-06-16\\\"\\n                officeTime: \\\"08:12\\\"\\n                plate: \\\"KLG-4821\\\"\\n                verification: \\\"Authorized\\\"\\n                entryStatus: \\\"Green requested\\\"\\n                detail: \\\"Active temporary allocation\\\"\\n                greenRequested: true\\n        '400':\\n          $ref: '#/components/responses/InvalidRequest'\\n        '401':\\n          $ref: '#/components/responses/Unauthorized'\\n        '503':\\n          $ref: '#/components/responses/ServiceUnavailable'\\n  /entrance/permanent-detections:\\n    post:\\n      operationId: recordPermanentDetection\\n      summary: \\\"Record a permanent-sticker vehicle detection without temporary authorization\\\"\\n      requestBody:\\n        required: true\\n        content:\\n          application/json:\\n            schema:\\n              $ref: '#/components/schemas/PermanentDetectionRequest'\\n            example:\\n              plate: \\\"ICT-6612\\\"\\n              detectedAt: \\\"2026-06-16T07:54:00+05:00\\\"\\n      responses:\\n        '200':\\n          description: \\\"Permanent detection recorded for utilization\\\"\\n          content:\\n            application/json:\\n              schema:\\n                $ref: '#/components/schemas/PermanentDetection'\\n              example:\\n                id: 9002\\n                officeDate: \\\"2026-06-16\\\"\\n                officeTime: \\\"07:54\\\"\\n                plate: \\\"ICT-6612\\\"\\n                verification: \\\"Permanent sticker\\\"\\n                entryStatus: \\\"Not blocked\\\"\\n                utilizationRecorded: true\\n                cancelledClaimId: null\\n        '400':\\n          $ref: '#/components/responses/InvalidRequest'\\n        '401':\\n          $ref: '#/components/responses/Unauthorized'\\n        '503':\\n          $ref: '#/components/responses/ServiceUnavailable'\\n  /admin/entry-checks:\\n    get:\\n      operationId: listEntryChecks\\n      summary: \\\"List recorded entrance verification activity for administrators\\\"\\n      parameters:\\n        - name: search\\n          in: query\\n          required: false\\n          schema:\\n            type: string\\n          example: \\\"KLG-4821\\\"\\n        - name: result\\n          in: query\\n          required: false\\n          schema:\\n            type: string\\n            enum:\\n              - \\\"All results\\\"\\n              - \\\"Authorized\\\"\\n              - \\\"Denied\\\"\\n              - \\\"Permanent sticker\\\"\\n              - \\\"Unsuccessful\\\"\\n          example: \\\"All results\\\"\\n        - name: page\\n          in: query\\n          required: false\\n          schema:\\n            type: integer\\n          example: 1\\n      responses:\\n        '200':\\n          description: \\\"Administrator entry-check page\\\"\\n          content:\\n            application/json:\\n              schema:\\n                $ref: '#/components/schemas/EntryCheckPage'\\n              example:\\n                page: 1\\n                pages: 4\\n                rows:\\n                  - id: 9001\\n                    officeDate: \\\"2026-06-16\\\"\\n                    officeTime: \\\"08:12\\\"\\n                    plate: \\\"KLG-4821\\\"\\n                    verification: \\\"Authorized\\\"\\n                    entryStatus: \\\"Green requested\\\"\\n                    detail: \\\"Active temporary allocation\\\"\\n                  - id: 9003\\n                    officeDate: \\\"2026-06-16\\\"\\n                    officeTime: \\\"08:06\\\"\\n                    plate: \\\"LEA-9073\\\"\\n                    verification: \\\"Denied\\\"\\n                    entryStatus: \\\"Blocked\\\"\\n                    detail: \\\"No active allocation\\\"\\n 