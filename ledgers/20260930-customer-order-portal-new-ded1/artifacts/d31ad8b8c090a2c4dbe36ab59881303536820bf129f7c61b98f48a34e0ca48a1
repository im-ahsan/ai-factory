{"changeClass":"feature","header":{"createdAt":"2026-09-30T20:43:56.121Z","inputsHash":"","kind":"intent","producedBy":{"model":"claude-haiku-4-5","stage":"intake"},"runId":"20260930-customer-order-portal-new-ded1","schemaVersion":1},"rigor":"full","risk":"high","riskTags":["auth","pii","public-api","payments"],"source":"cli","spans":[{"id":"I-1","text":"A web portal for a mid-size food distributor. Buyers place and track orders online"},{"id":"I-2","text":"A buyer signs in with email and password, and can reset a forgotten password by email"},{"id":"I-3","text":"An admin invites staff and buyers by email; an invited person sets their own password"},{"id":"I-4","text":"A buyer can only see their own company's orders, invoices and addresses"},{"id":"I-5","text":"After 5 failed sign-ins the account locks for 15 minutes"},{"id":"I-6","text":"A buyer browses the catalogue by category and searches by name or product code"},{"id":"I-7","text":"Each product shows unit, pack size, price for this customer and stock status"},{"id":"I-8","text":"A buyer adds products to a basket, changes quantities, and places the order with a delivery date"},{"id":"I-9","text":"A buyer can repeat a previous order; out-of-stock lines are flagged before placing"},{"id":"I-10","text":"A buyer can save a basket as a named template and reuse it"},{"id":"I-11","text":"A buyer sees their orders with status and can cancel until confirmed"},{"id":"I-12","text":"The buyer gets an email when the order is confirmed and when it goes out for delivery"},{"id":"I-13","text":"Staff see a queue of new orders, filter by customer, date and status, and confirm, amend or reject each one"},{"id":"I-14","text":"Staff can create an order on behalf of a customer taken by phone"},{"id":"I-15","text":"Staff export the day's delivery list as a CSV"},{"id":"I-16","text":"An invoice is created automatically when an order is marked delivered"},{"id":"I-17","text":"A buyer views and downloads invoices as PDF and sees which are paid, unpaid or overdue"},{"id":"I-18","text":"An admin manages the catalogue: add, edit and retire products"},{"id":"I-19","text":"An admin manages customer price lists and assigns one to each customer"},{"id":"I-20","text":"Staff see orders per day, top products and revenue per customer for a chosen date range"}],"touchesUi":true}