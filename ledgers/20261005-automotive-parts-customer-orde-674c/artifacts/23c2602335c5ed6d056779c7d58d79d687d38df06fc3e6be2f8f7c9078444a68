an\": \"I-42\"\n  },\n  {\n   \"searched\": [\n    \"no repository: this is new build work\"\n   ],\n   \"span\": \"I-43\"\n  },\n  {\n   \"searched\": [\n    \"no repository: this is new build work\"\n   ],\n   \"span\": \"I-44\"\n  },\n  {\n   \"searched\": [\n    \"no repository: this is new build work\"\n   ],\n   \"span\": \"I-45\"\n  }\n ]\n}\n</artifact>\n\n<artifact id=\"sketches\" kind=\"sketches\" sha=\"\">\n[\n {\n  \"spans\": [\n   {\n    \"id\": \"I-1\",\n    \"behaviours\": [\n     {\n      \"text\": \"Customer can sign in, browse catalogue, build a basket, and submit an order entirely through the web portal without phoning or emailing the office.\",\n      \"kind\": \"happy\"\n     },\n     {\n      \"text\": \"Each self-service order creates an order record with an order number, replacing a manual order-entry log.\",\n      \"kind\": \"data\"\n     },\n     {\n      \"text\": \"Staff can still create orders on behalf of customers for phone-in cases, but system flags these as staff-created.\",\n      \"kind\": \"happy\"\n     },\n     {\n      \"text\": \"If the portal is unavailable, there is no automatic fallback - customers would need to contact the office directly (out of scope for the system itself).\",\n      \"kind\": \"error\"\n     }\n    ],\n    \"readingChosen\": \"Portal fully replaces phone/email ordering as the primary channel for placing orders; customers self-serve end-to-end from browsing to order placement without staff phone/email intervention.\"\n   },\n   {\n    \"id\": \"I-2\",\n    \"behaviours\": [\n     {\n      \"text\": \"Customer enters a full or partial product name and sees matching products.\",\n      \"kind\": \"happy\"\n     },\n     {\n      \"text\": \"Customer enters a full or partial part number/product code and sees matching products.\",\n      \"kind\": \"happy\"\n     },\n     {\n      \"text\": \"Customer enters a manufacturer part number and sees matching products.\",\n      \"kind\": \"happy\"\n     },\n     {\n      \"text\": \"Customer selects a category and sees only products in that category; can change or clear the category filter.\",\n      \"kind\": \"happy\"\n     },\n     {\n      \"text\": \"Customer selects vehicle attributes (make, model, year, engine, fuel type, variant) and sees products marked compatible with that vehicle.\",\n      \"kind\": \"happy\"\n     },\n     {\n      \"text\": \"Search and vehicle-filter results reflect only active (non-retired) products.\",\n      \"kind\": \"data\"\n     },\n     {\n      \"text\": \"Search with no matches returns an empty result state rather than an error.\",\n      \"kind\": \"error\"\n     },\n     {\n      \"text\": \"Vehicle search with no compatible products shown informs the customer none are found.\",\n      \"kind\": \"error\"\n     }\n    ],\n    \"readingChosen\": \"Search/filter is multi-faceted: by part number/code, by product name, by category, and by vehicle details (make/model/year/engine/fuel/variant).\"\n   },\n   {\n    \"id\": \"I-3\",\n    \"behaviours\": [\n     {\n      \"text\": \"Catalogue list, product detail, basket, and checkout all display the price from the price list assigned to the signed-in customer's company.\",\n      \"kind\": \"happy\"\n     },\n     {\n      \"text\": \"Product shows stock status of In stock, Low stock, or Out of stock, derived from the latest successful ERP import.\",\n      \"kind\": \"happy\"\n     },\n     {\n      \"text\": \"A buyer cannot view pricing associated with any other customer company.\",\n      \"kind\": \"permission\"\n     },\n     {\n      \"text\": \"If a product has no price in the customer's assigned price list, the product's price is not shown as if it were free/zero (treated as unavailable/needs admin fix) rather than silently defaulting.\",\n      \"kind\": \"error\"\n     },\n     {\n      \"text\": \"Order-time price is captured and stored on the order line independent of later price-list changes.\",\n      \"kind\": \"data\"\n     }\n    ],\n    \"readingChosen\": \"Each customer, wherever pricing/stock appears (catalogue list, product detail, basket, checkout, order), sees the price from their assigned price list and current stock status, never another customer's pricing.\"\n   },\n   {\n    \"id\": \"I-4\",\n    \"behaviours\": [\n     {\n      \"text\": \"Orders placed by customers arrive directly in the staff order queue without staff needing to type them in from a phone call or email.\",\n      \"kind\": \"happy\"\n     },\n     {\n      \"text\": \"Staff can confirm an order with validation of stock/customer info in a single action rather than manual re-entry.\",\n      \"kind\": \"happy\"\n     },\n     {\n      \"text\": \"Staff can amend quantities/lines/delivery details on an existing order rather than recreating it from scratch.\",\n      \"kind\": \"happy\"\n     },\n     {\n      \"text\": \"Staff-created orders (phone-in) are flagged as staff-created and auditable, distinguishing manual entries from self-service ones.\",\n      \"kind\": \"data\"\n     }\n    ],\n    \"readingChosen\": \"Reduce office staff manual order-entry by having customers enter orders themselves; staff only need to review/confirm/edit rather than re-key orders from phone/email.\"\n   },\n   {\n    \"id\": \"I-5\",\n    \"behaviours\": [\n     {\n      \"text\": \"Customer views list of their company's orders with order number, date, delivery date, address, total, status.\",\n      \"kind\": \"happy\"\n     },\n     {\n      \"text\": \"Customer opens an order detail page showing status timeline (status, date/time, who/what performed transition).\",\n      \"kind\": \"happy\"\n     },\n     {\n      \"text\": \"Customer views list of invoices and opens invoice detail with payment status (Paid/Unpaid/Overdue).\",\n      \"kind\": \"happy\"\n     },\n     {\n      \"text\": \"Customer downloads invoice as PDF.\",\n      \"kind\": \"happy\"\n     },\n     {\n      \"text\": \"A buyer cannot view orders or invoices belonging to another customer company.\",\n      \"kind\": \"permission\"\n     }\n    ],\n    \"readingChosen\": \"Customers can view the status/timeline of their own orders and view/download their own invoices with payment status.\"\n   },\n   {\n    \"id\": \"I-6\",\n    \"behaviours\": [\n     {\n      \"text\": \"Staff view an order queue listing order number, customer, order date, requested delivery date, total, and current status.\",\n      \"kind\": \"happy\"\n     },\n     {\n      \"text\": \"Staff filter the queue by customer, date, and status.\",\n      \"kind\": \"happy\"\n     },\n     {\n      \"text\": \"Staff open an order from the queue to view/edit/confirm/reject it.\",\n      \"kind\": \"happy\"\n     },\n     {\n      \"text\": \"Staff export today's delivery list as a CSV containing order number, customer, delivery address, contact info, delivery date, lines/summary, notes, and delivery status.\",\n      \"kind\": \"happy\"\n     },\n     {\n      \"text\": \"Only office staff and administrators can access the order queue and delivery export, not customers.\",\n      \"kind\": \"permission\"\n     }\n    ],\n    \"readingChosen\": \"Staff see an operational queue of orders (filterable) and can export delivery information for drivers.\"\n   },\n   {\n    \"id\": \"I-7\",\n    \"behaviours\": [\n     {\n      \"text\": \"Staff dashboard shows counts/lists of new orders, orders awaiting confirmation, orders in picking, orders out for delivery, today's deliveries, outstanding invoices, and failed ERP imports.\",\n      \"kind\": \"happy\"\n     },\n     {\n      \"text\": \"Reporting data is derived from stored order, invoice, and stock-import records rather than manually compiled.\",\n      \"kind\": \"data\"\n     },\n     {\n      \"text\": \"Only office staff/admin roles can view the dashboard and reports, not customers.\",\n      \"kind\": \"permission\"\n     }\n    ],\n    \"readingChosen\": \"Management-facing reporting is delivered via a staff dashboard with operational/sales/product counts; detailed report types are open/minimal for first release.\"\n   },\n   {\n    \"id\": \"I-8\",\n    \"behaviours\": [\n     {\n      \"text\": \"Each order status transition is recorded with status, date/time, and user/system that performed it, retained as a timeline.\",\n      \"kind\": \"data\"\n     },\n     {\n      \"text\": \"Each invoice payment recording stores payment date and the user who recorded it.\",\n      \"kind\": \"data\"\n     },\n     {\n      \"text\": \"Staff amendments to an order (quantity/line/date/address/note changes) are stored as an audit history on the order.\",\n      \"kind\": \"data\"\n     },\n     {\n      \"text\": \"Catalogue changes (admin add/edit/retire of products, categories, prices) are recorded for administrative history viewing.\",\n      \"kind\": \"data\"\n     },\n     {\n      \"text\": \"Deactivating a user does not delete their historical order/invoice records; they remain visible to admins/staff.\",\n      \"kind\": \"data\"\n     },\n     {\n      \"text\": \"Administrators can view administrative/audit history information for these changes.\",\n      \"kind\": \"happy\"\n     }\n    ],\n    \"readingChosen\": \"The system records an immutable audit trail: who/when for order status transitions, invoice payment recording, customer account changes, and catalogue (product/price/category) changes.\"\n   },\n   {\n    \"id\": \"I-9\",\n    \"behaviours\": [\n     {\n      \"text\": \"User signs in with email and password and is granted a session; incorrect credentials show an invalid-credentials message without revealing which field was wrong.\",\n      \"kind\": \"happy\"\n     },\n     {\n      \"text\": \"Sign-in attempt for an inactive/deactivated account is blocked with an account-status message.\",\n      \"kind\": \"error\"\n     },\n     {\n      \"text\": \"User signs out, ending their session.\",\n      \"kind\": \"happy\"\n     },\n     {\n      \"text\": \"Unauthenticated users cannot access any protected pages (catalogue, basket, orders, invoices, admin) and are redirected to sign-in.\",\n      \"kind\": \"permission\"\n     },\n     {\n      \"text\": \"User requests password reset via email; receives reset email with link; sets new password; can then sign in with new password.\",\n      \"kind\": \"happy\"\n     },\n     {\n      \"text\": \"Invalid or expired reset link is rejected with an error message.\",\n      \"kind\": \"error\"\n     },\n     {\n      \"text\": \"After 5 consecutive failed sign-in attempts, the account is locked for 15 minutes, with further attempts blocked and the user informed of the temporary lock; successful sign-in after lock period restores normal access.\",\n      \"kind\": \"error\"\n     },\n     {\n      \"text\": \"A deactivated user cannot sign in and cannot place new orders, but their historical orders/invoices remain visible to staff/admin.\",\n      \"kind\": \"permission\"\n     }\n    ],\n    \"readingChosen\": \"Full authentication lifecycle: sign-in with email/password, forgot-password flow with emailed reset link, and account management including lockout and deactivation handling.\"\n   },\n   {\n    \"id\": \"I-10\",\n    \"behaviours\": [\n     {\n      \"text\": \"Each product record stores name, internal ID, manufacturer part number, distributor product code, description, category, manufacturer/brand, unit of sale, pack size, image, active/retired status, and compatibility links.\",\n      \"kind\": \"happy\"\n     },\n     {\n      \"text\": \"Customer browses a paginated/listed catalogue showing image, name, code, manufacturer, unit/pack size, price, stock status, and add-to-basket control per product.\",\n      \"kind\": \"happy\"\n     },\n     {\n      \"text\": \"Admin creates, edits, and retires categories; assigns products to categories.\",\n      \"kind\": \"happy\"\n     },\n     {\n      \"text\": \"Retired products no longer appear in catalogue browsing/search but remain intact in historical orders.\",\n      \"kind\": \"data\"\n     },\n     {\n      \"text\": \"Customer searches/filters as described in I-2 behaviours (name, code, manufacturer part number, brand, category, vehicle).\",\n      \"kind\": \"happy\"\n     },\n     {\n      \"text\": \"Product detail page shows image, name, code, manufacturer, description, unit, pack size, price, stock status, vehicle compatibility list, quantity selector, add-to-basket.\",\n      \"kind\": \"happy\"\n     }\n    ],\n    \"readingChosen\": \"Build the product catalogue data model and browsing UI: product fields, categories (flat, admin-managed), search, filters, and vehicle-compatibility matching.\"\n   },\n   {\n    \"id\": \"I-11\",\n    \"behaviours\": [\n     {\n      \"text\": \"Admin creates a price list and names it.\",\n      \"kind\": \"happy\"\n     },\n     {\n      \"text\": \"Admin adds products to a price list and sets a price for each.\",\n      \"kind\": \"happy\"\n     },\n     {\n      \"text\": \"Admin edits an existing product's price within a price list.\",\n      \"kind\": \"happy\"\n     },\n     {\n      \"text\": \"Admin removes a product from a price list.\",\n      \"kind\": \"happy\"\n     },\n     {\n      \"text\": \"Admin assigns a price list to a customer company and can change the assignment later.\",\n      \"kind\": \"happy\"\n     },\n     {\n      \"text\": \"Admin deactivates a price list, preventing its further assignment/use for display.\",\n      \"kind\": \"happy\"\n     },\n     {\n      \"text\": \"Changing a customer's price-list assignment or editing prices does not alter prices already stored on existing orders.\",\n      \"kind\": \"data\"\n     },\n     {\n      \"text\": \"If a product has no price entry in the customer's assigned price list, the product is treated as unpriced/unavailable for that customer rather than shown with a default price.\",\n      \"kind\": \"error\"\n     }\n    ],\n    \"readingChosen\": \"One price per product per price list; admin manages price lists and assigns them to customers; customer sees only their assigned list's prices.\"\n   },\n   {\n    \"id\": \"I-12\",\n    \"behaviours\": [\n     {\n      \"text\": \"A scheduled job ingests the nightly ERP CSV, validates the file format and product identifiers, and updates stock quantities/status (In stock/Low stock/Out of stock) for matching products.\",\n      \"kind\": \"happy\"\n     },\n     {\n      \"text\": \"Each import run records a success or failure outcome with timestamp, visible to staff/admin.\",\n      \"kind\": \"data\"\n     },\n     {\n      \"text\": \"If the CSV is invalid or incomplete, the import is rejected, the previous valid stock data remains in effect, and the failure is logged and visible to staff/admin (e.g. on dashboard).\",\n      \"kind\": \"error\"\n     },\n     {\n      \"text\": \"The portal never writes stock data back to the ERP; it only reads/imports the file.\",\n      \"kind\": \"permission\"\n     },\n     {\n      \"text\": \"After a successful import, the catalogue and product pages reflect the newly imported stock status immediately.\",\n      \"kind\": \"happy\"\n     }\n    ],\n    \"readingChosen\": \"Stock availability is driven solely by a nightly ERP CSV import process; portal is read-only with respect to ERP stock, and import failures are handled gracefully.\"\n   },\n   {\n    \"id\": \"I-13\",\n    \"behaviours\": [\n     {\n      \"text\": \"Customer adds a product to basket, changes line quantity, or removes a line; basket shows line price, line total, and subtotal.\",\n      \"kind\": \"happy\"\n     },\n     {\n      \"text\": \"Basket persists while the customer navigates the site within their session.\",\n      \"kind\": \"happy\"\n     },\n     {\n      \"text\": \"At checkout, customer selects one of their company's eligible delivery addresses and an available delivery date computed per the cutoff rule (before 14:00 -> next working 