\n  {\n   \"searched\": [\n    \"no repository: this is new build work\"\n   ],\n   \"span\": \"I-45\"\n  }\n ]\n}\n</artifact>\n\n<artifact id=\"spec\" kind=\"spec\" sha=\"\">\n{\n \"requirements\": [\n  {\n   \"acceptance\": [\n    {\n     \"given\": \"An active Buyer account buyer@a.test with a known password, linked to an active company\",\n     \"id\": \"AC-1.1\",\n     \"level\": \"api\",\n     \"then\": \"The response status is 200 and the response contains a session token and the role value \\\"Buyer\\\"\",\n     \"when\": \"POST /auth/sign-in with that email and password\"\n    },\n    {\n     \"given\": \"The session token returned in AC-1.1\",\n     \"id\": \"AC-1.2\",\n     \"level\": \"api\",\n     \"then\": \"The response status is 200 and the returned email field is buyer@a.test\",\n     \"when\": \"The user requests their own account details with that token\"\n    }\n   ],\n   \"ears\": \"When a user submits an email address and password that match an active account, the portal shall start an authenticated session and return the user's role.\",\n   \"id\": \"REQ-1\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-9\",\n    \"I-1\",\n    \"Q-1\"\n   ],\n   \"stability\": 1\n  },\n  {\n   \"acceptance\": [\n    {\n     \"given\": \"An active account buyer@a.test\",\n     \"id\": \"AC-2.1\",\n     \"level\": \"api\",\n     \"then\": \"The response status is 401, the error message is \\\"Invalid email or password\\\" and no session token is returned\",\n     \"when\": \"POST /auth/sign-in with a wrong password\"\n    },\n    {\n     \"given\": \"No account exists for ghost@x.test\",\n     \"id\": \"AC-2.2\",\n     \"level\": \"api\",\n     \"then\": \"The response status is 401 and the error message is identical to the one in AC-2.1\",\n     \"when\": \"POST /auth/sign-in with ghost@x.test and any password\"\n    }\n   ],\n   \"ears\": \"If a sign-in attempt uses an unknown email address or a wrong password, then the portal shall reject it with one identical invalid-credentials error message and return no session token.\",\n   \"id\": \"REQ-2\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-9\"\n   ],\n   \"stability\": 1\n  },\n  {\n   \"acceptance\": [\n    {\n     \"given\": \"An active account that has just had 4 consecutive failed sign-in attempts\",\n     \"id\": \"AC-3.1\",\n     \"level\": \"api\",\n     \"then\": \"The response status is 423 and the error message says the account is temporarily locked\",\n     \"when\": \"A 5th sign-in with a wrong password is made\"\n    },\n    {\n     \"given\": \"An account that has just had 5 consecutive failed sign-in attempts\",\n     \"id\": \"AC-3.2\",\n     \"level\": \"api\",\n     \"then\": \"The response status is 423 and the error message says the account is temporarily locked\",\n     \"when\": \"A sign-in with the correct password is made 1 minute later\"\n    },\n    {\n     \"given\": \"An account locked at time T\",\n     \"id\": \"AC-3.3\",\n     \"level\": \"api\",\n     \"then\": \"The response status is 200 and a session token is returned\",\n     \"when\": \"The correct password is submitted at T + 15 minutes + 1 second (test clock)\"\n    },\n    {\n     \"given\": \"An account with 4 failed attempts followed by 1 successful sign-in\",\n     \"id\": \"AC-3.4\",\n     \"level\": \"api\",\n     \"then\": \"Each response status is 401 (not 423) and the account record lock field is empty\",\n     \"when\": \"4 more failed attempts are made\"\n    },\n    {\n     \"given\": \"The account from AC-3.4 after its 4 further failed attempts\",\n     \"id\": \"AC-3.5\",\n     \"level\": \"api\",\n     \"then\": \"The response status is 200, showing the failure count was reset by the earlier successful sign-in\",\n     \"when\": \"The correct password is submitted\"\n    }\n   ],\n   \"ears\": \"If an account has 5 consecutive failed sign-in attempts, then the portal shall lock the account for 15 minutes from the fifth failure and reject every sign-in attempt during the lock with a temporary-lock error.\",\n   \"id\": \"REQ-3\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-9\",\n    \"ASM-37\"\n   ],\n   \"stability\": 1\n  },\n  {\n   \"acceptance\": [\n    {\n     \"given\": \"A user deactivated by an administrator\",\n     \"id\": \"AC-4.1\",\n     \"level\": \"api\",\n     \"then\": \"The response status is 403 and the error message says the account is inactive\",\n     \"when\": \"The user signs in with the correct password\"\n    },\n    {\n     \"given\": \"An active Buyer whose customer company has been set inactive\",\n     \"id\": \"AC-4.2\",\n     \"level\": \"api\",\n     \"then\": \"The response status is 403 and no session token is returned\",\n     \"when\": \"The Buyer signs in with the correct password\"\n    },\n    {\n     \"given\": \"A Buyer holding a valid session token\",\n     \"id\": \"AC-4.3\",\n     \"level\": \"api\",\n     \"then\": \"The response status is 401\",\n     \"when\": \"An administrator deactivates the Buyer and the Buyer then requests the order list with the same token\"\n    },\n    {\n     \"given\": \"A Buyer holding a session token issued before an administrator deactivated them\",\n     \"id\": \"AC-4.4\",\n     \"level\": \"api\",\n     \"then\": \"The response status is 401 and no order row is created\",\n     \"when\": \"POST /orders is called with that token and a valid basket\"\n    },\n    {\n     \"given\": \"A Buyer of Fleet Co holding a session from before the company was set inactive\",\n     \"id\": \"AC-4.5\",\n     \"level\": \"api\",\n     \"then\": \"The response status is 401 or 403 and no order row is created\",\n     \"when\": \"POST /orders is called\"\n    }\n   ],\n   \"ears\": \"If a user is deactivated or belongs to an inactive customer company, then the portal shall reject that user's sign-in attempts and every request, including order submission, made with that user's existing sessions.\",\n   \"id\": \"REQ-4\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-9\",\n    \"I-17\",\n    \"Q-5\"\n   ],\n   \"stability\": 1\n  },\n  {\n   \"acceptance\": [\n    {\n     \"given\": \"A user with a valid session token\",\n     \"id\": \"AC-5.1\",\n     \"level\": \"api\",\n     \"then\": \"The sign-out response status is a success status (200 or 204) and the GET /orders response status is 401\",\n     \"when\": \"The user calls POST /auth/sign-out and then requests GET /orders with the same token\"\n    }\n   ],\n   \"ears\": \"When a signed-in user signs out, the portal shall invalidate that user's session token.\",\n   \"id\": \"REQ-5\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-9\"\n   ],\n   \"stability\": 1\n  },\n  {\n   \"acceptance\": [\n    {\n     \"given\": \"No session token\",\n     \"id\": \"AC-6.1\",\n     \"level\": \"api\",\n     \"then\": \"Each response status is 401 and no product, order or invoice data is returned\",\n     \"when\": \"GET the catalogue, the order list, an order, the invoice list and an invoice PDF\"\n    }\n   ],\n   \"ears\": \"If a request to any endpoint other than sign-in, password reset and invitation acceptance carries no valid session token, then the portal shall reject it with status 401 without returning any record data.\",\n   \"id\": \"REQ-6\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-9\"\n   ],\n   \"stability\": 1\n  },\n  {\n   \"acceptance\": [\n    {\n     \"given\": \"A signed-in Buyer\",\n     \"id\": \"AC-7.1\",\n     \"level\": \"api\",\n     \"then\": \"The response status is 403\",\n     \"when\": \"The Buyer requests the staff order queue\"\n    },\n    {\n     \"given\": \"A signed-in Office Staff user\",\n     \"id\": \"AC-7.2\",\n     \"level\": \"api\",\n     \"then\": \"The response status is 403 and no price list record is created\",\n     \"when\": \"The user POSTs a new price list\"\n    },\n    {\n     \"given\": \"A signed-in Office Staff user\",\n     \"id\": \"AC-7.3\",\n     \"level\": \"api\",\n     \"then\": \"The response status is 403 and no product row is created\",\n     \"when\": \"POST /admin/products is called with a valid product\"\n    },\n    {\n     \"given\": \"A signed-in Administrator and an order in status Received\",\n     \"id\": \"AC-7.4\",\n     \"level\": \"api\",\n     \"then\": \"Both response statuses are 200 and the order record status value is \\\"Confirmed\\\"\",\n     \"when\": \"The Administrator requests the staff order queue and then confirms the order\"\n    }\n   ],\n   \"ears\": \"If a user calls an endpoint outside the capabilities of their role (Buyer, Office Staff or Administrator, where Administrator includes every Office Staff capability), then the portal shall reject the request with status 403.\",\n   \"id\": \"REQ-7\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-9\",\n    \"I-6\",\n    \"I-17\",\n    \"Q-1\",\n    \"ASM-28\"\n   ],\n   \"stability\": 1\n  },\n  {\n   \"id\": \"REQ-8\",\n   \"ears\": \"While a Buyer is signed in, the portal shall return only orders, invoices, prices, delivery addresses and account data that belong to the Buyer's own customer company, responding with status 404 to requests for such records of another company.\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-3\",\n    \"I-5\",\n    \"I-9\",\n    \"Q-2\"\n   ],\n   \"acceptance\": [\n    {\n     \"id\": \"AC-8.1\",\n     \"given\": \"Buyer A of company A and order ORD-000200 of company B\",\n     \"when\": \"Buyer A requests ORD-000200\",\n     \"then\": \"The response status is 404 and no order data is returned\",\n     \"level\": \"api\"\n    },\n    {\n     \"id\": \"AC-8.2\",\n     \"given\": \"Company B has invoice INV-000050\",\n     \"when\": \"Buyer A requests the PDF of INV-000050\",\n     \"then\": \"The response status is 404 and no file is returned\",\n     \"level\": \"api\"\n    },\n    {\n     \"id\": \"AC-8.3\",\n     \"given\": \"Company A has 3 orders (2 by Buyer A, 1 by colleague Buyer A2) and company B has 2 orders\",\n     \"when\": \"Buyer A lists orders\",\n     \"then\": \"The returned list contains exactly the 3 company A orders\",\n     \"level\": \"api\"\n    },\n    {\n     \"id\": \"AC-8.4\",\n     \"given\": \"Company B has a delivery address and a price list different from company A\",\n     \"when\": \"Buyer A lists delivery addresses and opens a product\",\n     \"then\": \"The returned address list contains only company A addresses and the returned price value comes from company A's price list\",\n     \"level\": \"api\"\n    }\n   ],\n   \"stability\": 1\n  },\n  {\n   \"id\": \"REQ-9\",\n   \"ears\": \"When a password reset is requested for an email address, the portal shall return the same response whether or not the email exists and send a reset email with a single-use link valid for the configured period (default 1 hour) only if the email belongs to an active (including temporarily locked) account whose customer company, if any, is active.\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-9\",\n    \"Q-5\",\n    \"ASM-18\",\n    \"ASM-19\"\n   ],\n   \"acceptance\": [\n    {\n     \"id\": \"AC-9.1\",\n     \"given\": \"An active account exists for buyer@a.test\",\n     \"when\": \"POST a password reset request for buyer@a.test\",\n     \"then\": \"The response status is 202 and exactly one email containing a reset link is sent to buyer@a.test\",\n     \"level\": \"api\"\n    },\n    {\n     \"id\": \"AC-9.2\",\n     \"given\": \"No account exists for ghost@x.test\",\n     \"when\": \"POST a password reset request for ghost@x.test\",\n     \"then\": \"The response status and body equal those of AC-9.1 and no email is sent\",\n     \"level\": \"api\"\n    },\n    {\n     \"id\": \"AC-9.3\",\n     \"given\": \"A user deactivated by an administrator\",\n     \"when\": \"POST a password reset request for that user's email\",\n     \"then\": \"The response status and body equal those of AC-9.1 and no email is sent\",\n     \"level\": \"api\"\n    },\n    {\n     \"id\": \"AC-9.4\",\n     \"given\": \"A pending invitee who has not yet accepted the invitation\",\n     \"when\": \"POST a password reset request for that invitee's email\",\n     \"then\": \"The response status and body equal those of AC-9.1, no email is sent and the user record status stays \\\"Pending\\\"\",\n     \"level\": \"api\"\n    },\n    {\n     \"id\": \"AC-9.5\",\n     \"given\": \"An active Buyer whose customer company has been set inactive\",\n     \"when\": \"POST a password reset request for that Buyer's email\",\n     \"then\": \"The response status and body equal those of AC-9.1 and no email is sent\",\n     \"level\": \"api\"\n    },\n    {\n     \"id\": \"AC-9.6\",\n     \"given\": \"An active account temporarily locked after 5 failed sign-in attempts\",\n     \"when\": \"POST a password reset request for that account's email\",\n     \"then\": \"The response status is 202 and exactly one reset email is sent to that address\",\n     \"level\": \"api\"\n    }\n   ],\n   \"stability\": 1\n  },\n  {\n   \"acceptance\": [\n    {\n     \"given\": \"A reset link issued 10 minutes ago\",\n     \"id\": \"AC-10.1\",\n     \"level\": \"api\",\n     \"then\": \"The reset response status is 200, the new-password sign-in response status is 200 and the old-password response status is 401\",\n     \"when\": \"The user submits a new password through it and then signs in with the new and the old password\"\n    },\n    {\n     \"given\": \"An account locked after 5 failed attempts and a valid reset link for it\",\n     \"id\": \"AC-10.2\",\n     \"level\": \"api\",\n     \"then\": \"The sign-in response status is 200\",\n     \"when\": \"The user completes a password reset and signs in with the new password within the 15-minute lock period\"\n    }\n   ],\n   \"ears\": \"When a user submits a new password through an unexpired, unused reset link, the portal shall replace the password, invalidate the link and clear any sign-in lock on the account.\",\n   \"id\": \"REQ-10\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-9\",\n    \"ASM-19\"\n   ],\n   \"stability\": 1\n  },\n  {\n   \"id\": \"REQ-11\",\n   \"ears\": \"If a reset link is expired or already used, or its user is pending, deactivated or belongs to an inactive customer company when the link is used, then the portal shall reject the password change, keeping the existing password and any sign-in lock unchanged.\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-9\",\n    \"Q-5\",\n    \"ASM-19\"\n   ],\n   \"acceptance\": [\n    {\n     \"id\": \"AC-11.1\",\n     \"given\": \"A reset link that has already been used\",\n     \"when\": \"A new password is submitted through it again\",\n     \"then\": \"The response status is 400 and the error message says the link is invalid or expired\",\n     \"level\": \"api\"\n    },\n    {\n     \"id\": \"AC-11.2\",\n     \"given\": \"A reset link issued 61 minutes ago with the default validity\",\n     \"when\": \"A new password is submitted through it and then sign-in with the old password is attempted\",\n     \"then\": \"The reset response status is 400 with an error saying the link is invalid or expired, and the old-password sign-in response status is 200\",\n     \"level\": \"api\"\n    },\n    {\n     \"id\": \"AC-11.3\",\n     \"given\": \"A reset link issued 5 minutes ago to an active Buyer, after which an administrator deactivated that Buyer\",\n     \"when\": \"A new password is submitted through the link\",\n     \"then\": \"The response status is 400 and the user record status value stays \\\"Deactivated\\\"\",\n     \"level\": \"api\"\n    },\n    {\n     \"id\": \"AC-11.4\",\n     \"given\": \"A reset link issued 5 minutes ago to a Buyer whose company was then set inactive\",\n     \"when\": \"A new password is submitted through the link and the company is later reactivated and the Buyer signs in with the old password\",\n     \"then\": \"The reset response status is 400 and the later old-password sign-in response status is 200\",\n     \"level\": \"api\"\n    }\n   ],\n   \"stability\": 1\n  },\n  {\n   \"acceptance\": [\n    {\n     \"given\": \"A signed-in Administrator and active company A\",\n     \"id\": \"AC-12.1\",\n     \"level\": \"api\",\n     \"then\": \"The response status is 201, the user record has status \\\"Pending\\\" and one invitation email is sent to new.buyer@a.test\",\n     \"when\": \"POST an invitation for new.buyer@a.test as Buyer of company A\"\n    },\n    {\n     \"given\": \"A signed-in Administrator\",\n     \"id\": \"AC-12.2\",\n     \"level\": \"api\",\n     \"then\": \"The response status is 400 and no user record is created\",\n     \"when\": \"POST an invitation with role \\\"Customer Account Manager\\\"\"\n    },\n    {\n     \"given\": \"A signed-in Administrator\",\n     \"id\": \"AC-12.3\",\n     \"level\": \"api\",\n     \"then\": \"The response is a validation error status (400/422) and the error names the company field\",\n     \"when\": \"POST an invitation for a Buyer without a customer company\"\n    }\n   ],\n   \"ears\": \"When an administrator invites a user with name, email and the role Buyer (linked to a customer company) or Office Staff, the portal shall create a pending account and send an invitation email with a link valid for the configured period (default 7 days).\",\n   \"id\": \"REQ-12\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-9\",\n    \"I-17\",\n    \"Q-1\",\n    \"ASM-19\"\n   ],\n   \"stability\": 1\n  },\n  {\n   \"acceptance\": [\n    {\n     \"given\": \"A signed-in Administrator\",\n     \"id\": \"AC-13.1\",\n     \"level\": \"api\",\n     \"then\": \"The response status is 201, the user record has status \\\"Pending\\\" and role \\\"Administrator\\\", and one invitation email is sent\",\n     \"when\": \"POST an invitation for new.admin@dist.test with role Administrator\"\n    }\n   ],\n   \"ears\": \"When an administrator invites a user with the role Administrator, the portal shall create a pending account and send an invitation email.\",\n   \"id\": \"REQ-13\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-9\",\n    \"I-17\"\n   ],\n   \"stability\": 0.3333333333333333\n  },\n  {\n   \"acceptance\": [\n    {\n     \"given\": \"An invitation sent 2 days ago\",\n     \"id\": \"AC-14.1\",\n     \"level\": \"api\",\n     \"then\": \"The user record status is \\\"Active\\\" and the sign-in response status is 200\",\n     \"when\": \"The invitee sets a password through the link and signs in\"\n    },\n    {\n     \"given\": \"An invitation sent 7 days and 1 minute ago with the default validity\",\n     \"id\": \"AC-14.2\",\n     \"level\": \"api\",\n     \"then\": \"The response status is 400 and the user record status stays \\\"Pending\\\"\",\n     \"when\": \"The invitee tries to set a password through the link\"\n    }\n   ],\n   \"ears\": \"When an invited user sets a password through an unexpired invitation link, the portal shall activate the account.\",\n   \"id\": \"REQ-14\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-9\",\n    \"ASM-19\"\n   ],\n   \"stability\": 1\n  },\n  {\n   \"acceptance\": [\n    {\n     \"given\": \"A pending account with an unused invitation link L1\",\n     \"id\": \"AC-15.1\",\n     \"level\": \"api\",\n     \"then\": \"A new invitation email is sent and the response to using L1 has status 400\",\n     \"when\": \"The administrator resends the invitation and the invitee then uses L1\"\n    },\n    {\n     \"given\": \"An expired pending invitation\",\n     \"id\": \"AC-15.2\",\n     \"level\": \"api\",\n     \"then\": \"A new invitation email is sent and the accept response status is 200\",\n     \"when\": \"The administrator resends it and the invitee accepts using the new link\"\n    }\n   ],\n   \"ears\": \"When an administrator resends the invitation of a pending account, the portal shall invalidate every previous invitation link for that user and send a new invitation email.\",\n   \"id\": \"REQ-15\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-9\",\n    \"I-17\",\n    \"ASM-19\"\n   ],\n   \"stability\": 1\n  },\n  {\n   \"acceptance\": [\n    {\n     \"given\": \"Users of several roles and statuses (Pending, Active, Deactivated)\",\n     \"id\": \"AC-16.1\",\n     \"level\": \"api\",\n     \"then\": \"Each returned row contains the role, company and status fields\",\n     \"when\": \"An administrator lists users\"\n    },\n    {\n     \"given\": \"Buyer B has placed 3 orders\",\n     \"id\": \"AC-16.2\",\n     \"level\": \"api\",\n     \"then\": \"B's user record status is \\\"Deactivated\\\" and the returned list still contains B's 3 orders with placedBy B\",\n     \"when\": \"An administrator deactivates B and a staff user lists orders filtered by B's company\"\n    },\n    {\n     \"given\": \"A deactivated Buyer of an active company\",\n     \"id\": \"AC-16.3\",\n     \"level\": \"api\",\n     \"then\": \"The user record status is \\\"Active\\\" and the sign-in response status is 200\",\n     \"when\": \"An administrator reactivates the user and the user signs in\"\n    },\n    {\n     \"given\": \"An Active Buyer of Acme Garage\",\n     \"id\": \"AC-16.4\",\n     \"level\": \"api\",\n     \"then\": \"The returned list contains only Fleet Co orders\",\n     \"when\": \"An Administrator changes the user's company to Fleet Co and the user then calls GET /orders\"\n    }\n   ],\n   \"ears\": \"The portal shall let administrators list users with role, customer company and account status, associate a Buyer with a customer company, deactivate a user and reactivate a deactivated user, without deleting any of the user's orders or invoices.\",\n   \"id\": \"REQ-16\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-9\",\n    \"I-17\",\n    \"I-8\",\n    \"Q-1\",\n    \"Q-5\"\n   ],\n   \"stability\": 1\n  },\n  {\n   \"acceptance\": [\n    {\n     \"given\": \"A Buyer user\",\n     \"id\": \"AC-17.1\",\n     \"level\": \"api\",\n     \"then\": \"The response status is 200\",\n     \"when\": \"An administrator changes the role to Office Staff and the user requests the staff order queue\"\n    }\n   ],\n   \"ears\": \"The portal shall let administrators change a user's role between Buyer and Office Staff.\",\n   \"id\": \"REQ-17\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-9\",\n    \"I-17\",\n    \"Q-1\"\n   ],\n   \"stability\": 1\n  },\n  {\n   \"acceptance\": [\n    {\n     \"given\": \"Office Staff user Sam\",\n     \"id\": \"AC-18.1\",\n     \"level\": \"api\",\n     \"then\": \"The response status is 201\",\n     \"when\": \"An Administrator changes Sam's role to Administrator and Sam calls POST /admin/categories\"\n    }\n   ],\n   \"ears\": \"The portal shall let administrators change a user's role to Administrator.\",\n   \"id\": \"REQ-18\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-9\",\n    \"I-17\",\n    \"Q-1\"\n   ],\n   \"stability\": 0.6666666666666666\n  },\n  {\n   \"acceptance\": [\n    {\n     \"given\": \"A deactivated Buyer of inactive company Fleet Co\",\n     \"id\": \"AC-19.1\",\n     \"level\": \"api\",\n     \"then\": \"The response status is 409 with error code COMPANY_INACTIVE\",\n     \"when\": \"POST /admin/users/{id}/reactivate is called\"\n    }\n   ],\n   \"ears\": \"If an administrator tries to reactivate a deactivated user whose customer company is inactive, then the portal shall reject the reactivation.\",\n   \"id\": \"REQ-19\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-17\",\n    \"I-9\"\n   ],\n   \"stability\": 0.3333333333333333\n  },\n  {\n   \"acceptance\": [\n    {\n     \"given\": \"Active products \\\"Brake Pad Set\\\" (code BP-100, part number 0986494, brand Bosch) and \\\"Oil Filter\\\" (code OF-20, brand Mann)\",\n     \"id\": \"AC-20.1\",\n     \"level\": \"api\",\n     \"then\": \"The returned list contains Brake Pad Set and does not contain Oil Filter\",\n     \"when\": \"A Buyer searches \\\"brak\\\"\"\n    },\n    {\n     \"given\": \"The products of AC-20.1\",\n     \"id\": \"AC-20.2\",\n     \"level\": \"api\",\n     \"then\": \"Each returned list contains Brake Pad Set\",\n     \"when\": \"A Buyer searches \\\"86494\\\", then \\\"bp-1\\\", then \\\"BOSCH\\\"\"\n    },\n    {\n     \"given\": \"A retired product \\\"Brake Drum\\\"\",\n     \"id\": \"AC-20.3\",\n     \"level\": \"api\",\n     \"then\": \"The returned list does not contain Brake Drum\",\n     \"when\": \"A Buyer searches \\\"brake\\\"\"\n    },\n    {\n     \"given\": \"The products of AC-20.1\",\n     \"id\": \"AC-20.4\",\n     \"level\": \"api\",\n     \"then\": \"The response status is 200 and the returned list is empty\",\n     \"when\": \"A Buyer searches \\\"zzzz\\\"\"\n    }\n   ],\n   \"ears\": \"When a Buyer searches the catalogue with a text term, the portal shall return active products whose name, distributor product code, manufacturer part number or brand contains the term, ignoring letter case.\",\n   \"id\": \"REQ-20\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-2\",\n    \"I-10\"\n   ],\n   \"stability\": 1\n  },\n  {\n   \"id\": \"REQ-21\",\n   \"ears\": \"When a Buyer filters the catalogue by a category, the portal shall return only active products assigned to that category that also match any supplied search term, returning all active products again once the category filter is cleared.\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-2\",\n    \"I-10\",\n    \"ASM-15\"\n   ],\n   \"acceptance\": [\n    {\n     \"id\": \"AC-21.1\",\n     \"given\": \"3 active products in Filters and 2 in Brake system\",\n     \"when\": \"A Buyer lists the catalogue filtered by Filters\",\n     \"then\": \"The returned list count is 3 and every returned product has the category value Filters\",\n     \"level\": \"api\"\n    },\n    {\n     \"id\": \"AC-21.2\",\n     \"given\": \"The products of AC-21.1\",\n     \"when\": \"A Buyer lists the catalogue with no category filter\",\n     \"then\": \"The returned list count is 5\",\n     \"level\": \"api\"\n    },\n    {\n     \"id\": \"AC-21.3\",\n     \"given\": \"Active products \\\"Oil Filter\\\" (Filters) and \\\"Oil Pump\\\" (Engine parts)\",\n     \"when\": \"A Buyer searches \\\"oil\\\" filtered by Filters\",\n     \"then\": \"The returned list contains Oil Filter only\",\n     \"level\": \"api\"\n    }\n   ],\n   \"stability\": 1\n  },\n  {\n   \"acceptance\": [\n    {\n     \"given\": \"Product P has a compatibility entry Ford, Focus, years 2015–2018, 1.0 EcoBoost, petrol\",\n     \"id\": \"AC-22.1\",\n     \"level\": \"api\",\n     \"then\": \"The returned list contains P\",\n     \"when\": \"A Buyer searches make Ford, model Focus, year 2017\"\n    },\n    {\n     \"given\": \"The same product P\",\n     \"id\": \"AC-22.2\",\n     \"level\": \"api\",\n     \"then\": \"The returned list does not contain P\",\n     \"when\": \"A Buyer searches make Ford, model Focus, year 2010\"\n    },\n    {\n     \"given\": \"P1 compatible with Ford Focus 2018 1.0 EcoBoost Petrol and P2 compatible with Ford Focus 2018 2.0 TDCi Diesel\",\n     \"id\": \"AC-22.3\",\n     \"level\": \"api\",\n     \"then\": \"The returned list contains P2 only\",\n     \"when\": \"A Buyer searches make Ford, model Focus, year 2018, fuel Diesel\"\n    },\n    {\n     \"given\": \"Product A compatible with Ford Focus 2018 and product B compatible with Ford Fiesta 2018\",\n     \"id\": \"AC-22.4\",\n     \"level\": \"api\",\n     \"then\": \"The returned list contains product A and not product B\",\n     \"when\": \"A Buyer searches make Ford, model Focus, year 2018\"\n    }\n   ],\n   \"ears\": \"When a Buyer searches by vehicle using any combination of make, model, year, engine, fuel type and variant, the portal shall return only active products with a compatibility entry that matches every supplied value.\",\n   \"id\": \"REQ-22\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-2\",\n    \"I-10\",\n    \"ASM-23\"\n   ],\n   \"stability\": 1\n  },\n  {\n   \"acceptance\": [\n    {\n     \"given\": \"An active product with all fields populated and a price on the Buyer's price list\",\n     \"id\": \"AC-23.1\",\n     \"level\": \"api\",\n     \"then\": \"The returned row for that product contains imageUrl, name, productCode, manufacturer, unit, packSize, price and stockStatus fields with the stored values\",\n     \"when\": \"A Buyer lists the catalogue\"\n    },\n    {\n     \"given\": \"Active product 'Brake Pad Set' and retired product 'Old Filter'\",\n     \"id\": \"AC-23.2\",\n     \"level\": \"api\",\n     \"then\": \"The returned list contains 'Brake Pad Set' and does not contain 'Old Filter'\",\n     \"when\": \"A Buyer lists the catalogue\"\n    }\n   ],\n   \"ears\": \"When a Buyer lists the catalogue, the portal shall return only active products, each with image URL, name, distributor product code, manufacturer, unit of sale, pack size, the Buyer's price and stock status.\",\n   \"id\": \"REQ-23\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-2\",\n    \"I-3\",\n    \"I-10\"\n   ],\n   \"stability\": 1\n  },\n  {\n   \"acceptance\": [\n    {\n     \"given\": \"An active product with 2 compatibility entries\",\n     \"id\": \"AC-24.1\",\n     \"level\": \"api\",\n     \"then\": \"The response status is 200 and the returned compatibility list has 2 entries alongside the other listed fields\",\n     \"when\": \"A Buyer opens the product\"\n    },\n    {\n     \"given\": \"An active product with imported quantity 0\",\n     \"id\": \"AC-24.2\",\n     \"level\": \"api\",\n     \"then\": \"The response status is 200 and the stockStatus value is \\\"Out of stock\\\"\",\n     \"when\": \"A Buyer opens the product\"\n    },\n    {\n     \"given\": \"A retired product\",\n     \"id\": \"AC-24.3\",\n     \"level\": \"api\",\n     \"then\": \"The response status is 404\",\n     \"when\": \"A Buyer opens the product\"\n    }\n   ],\n   \"ears\": \"When a Buyer opens an active product, the portal shall return its image, name, product code, manufacturer, description, unit, pack size, the Buyer's price, stock status and compatible vehicles.\",\n   \"id\": \"REQ-24\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-2\",\n    \"I-3\",\n    \"I-10\"\n   ],\n   \"stability\": 1\n  },\n  {\n   \"id\": \"REQ-25\",\n   \"ears\": \"The portal shall price every product shown to a Buyer, and every line of that company's basket, staff-created orders and repeat orders, from the price list assigned to the Buyer's customer company at the time of the request, so that a changed assignment applies from then on.\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-3\",\n    \"I-11\",\n    \"I-17\"\n   ],\n   \"acceptance\": [\n    {\n     \"id\": \"AC-25.1\",\n     \"given\": \"Product X costs 50.00 on Standard and 40.00 on Workshop A, and company A is assigned Workshop A\",\n     \"when\": \"A Buyer of company A opens product X\",\n     \"then\": \"The returned price value is 40.00 and the value 50.00 does not appear in the response\",\n     \"level\": \"api\"\n    },\n    {\n     \"id\": \"AC-25.2\",\n     \"given\": \"The setup of AC-25.1\",\n     \"when\": \"An administrator assigns Standard to company A and the Buyer opens product X again\",\n     \"then\": \"The returned price value is 50.00\",\n     \"level\": \"api\"\n    },\n    {\n     \"id\": \"AC-25.3\",\n     \"given\": \"Product BP-1001 priced 15.00 on Standard and 12.50 on Workshop A; company A on Workshop A and company B on Standard\",\n     \"when\": \"A Buyer of each company opens BP-1001\",\n     \"then\": \"The price value returned to company A's Buyer is 12.50 and to company B's Buyer is 15.00\",\n     \"level\": \"api\"\n    }\n   ],\n   \"stability\": 1\n  },\n  {\n   \"acceptance\": [\n    {\n     \"given\": \"Company A is assigned Workshop A with BP-1001 = 12.50 and a signed-in Office Staff user\",\n     \"id\": \"AC-26.1\",\n     \"level\": \"api\",\n     \"then\": \"The response status is 200 and the returned price value is 12.50\",\n     \"when\": \"The user requests the price of BP-1001 for company A\"\n    }\n   ],\n   \"ears\": \"The portal shall let Office Staff view the unit price a given customer company pays for a product, taken from that company's assigned price list.\",\n   \"id\": \"REQ-26\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-3\",\n    \"I-4\",\n    \"I-11\"\n   ],\n   \"stability\": 0.6666666666666666\n  },\n  {\n   \"acceptance\": [\n    {\n     \"given\": \"Active product Y with no price on company A's price list\",\n     \"id\": \"AC-27.1\",\n     \"level\": \"api\",\n     \"then\": \"The returned price field is null and the price label value is \\\"Price on request\\\"\",\n     \"when\": \"A Buyer of company A opens product Y\"\n    },\n    {\n     \"given\": \"The same product Y\",\n     \"id\": \"AC-27.2\",\n     \"level\": \"api\",\n     \"then\": \"The response is a rejection status (422/400), the error says the product has no price and the basket line count is unchanged\",\n     \"when\": \"The Buyer adds product Y with quantity 1 to the basket\"\n    }\n   ],\n   \"ears\": \"If a product has no price on the customer company's assigned price list, then the portal shall show the product as \\\"Price on request\\\" and reject adding it to a basket or order.\",\n   \"id\": \"REQ-27\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-3\",\n    \"I-11\",\n    \"ASM-3\"\n   ],\n   \"stability\": 1\n  },\n  {\n   \"acceptance\": [\n    {\n     \"given\": \"A signed-in Administrator\",\n     \"id\": \"AC-28.1\",\n     \"level\": \"api\",\n     \"then\": \"The Fleet price list has 1 row for product X with value 32.00\",\n     \"when\": \"The administrator creates price list \\\"Fleet\\\", sets product X to 30.00 and then sets product X to 32.00\"\n    },\n    {\n     \"given\": \"Price list Fleet already has a price for product X\",\n     \"id\": \"AC-28.2\",\n     \"level\": \"api\",\n     \"then\": \"The response status is 409 with error code DUPLICATE_PRICE\",\n     \"when\": \"POST /admin/price-lists/{Fleet}/prices is called again for X\"\n    },\n    {\n     \"given\": \"Price list Fleet containing product X and assigned to company F\",\n     \"id\": \"AC-28.3\",\n     \"level\": \"api\",\n     \"then\": \"The price list row count for product X is 0 and the returned price label value is \\\"Price on request\\\"\",\n     \"when\": \"The administrator removes product X from Fleet and a Buyer of company F opens X\"\n    },\n    {\n     \"given\": \"A deactivated price list\",\n     \"id\": \"AC-28.4\",\n     \"level\": \"api\",\n     \"then\": \"The response status is 422 and the company's assigned price list value is unchanged\",\n     \"when\": \"The administrator assigns it to a customer company\"\n    }\n   ],\n   \"ears\": \"The portal shall let administrators create, rename and deactivate price lists, set, edit and remove at most one price per product on a price list, and assign an active price list to a customer company.\",\n   \"id\": \"REQ-28\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-11\",\n    \"I-17\"\n   ],\n   \"stability\": 1\n  },\n  {\n   \"acceptance\": [\n    {\n     \"given\": \"Order ORD-000101 has a line for product X at unit price 40.00\",\n     \"id\": \"AC-29.1\",\n     \"level\": \"api\",\n     \"then\": \"The returned unit price value on the order line is 40.00\",\n     \"when\": \"The administrator changes product X to 45.00 on that price list and the order is opened\"\n    },\n    {\n     \"given\": \"Order ORD-000124 with BP-1001 at 12.50 for company A\",\n     \"id\": \"AC-29.2\",\n     \"level\": \"api\",\n     \"then\": \"The returned line unit price is 12.50 and the order total value is unchanged\",\n     \"when\": \"An administrator reassigns company A to Standard and the Buyer opens ORD-000124\"\n    }\n   ],\n   \"ears\": \"When a price on a price list is changed or a company's price list assignment changes, the portal shall leave the unit prices stored on existing orders and invoices unchanged.\",\n   \"id\": \"REQ-29\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-11\",\n    \"I-13\"\n   ],\n   \"stability\": 1\n  },\n  {\n   \"acceptance\": [\n    {\n     \"given\": \"Low-stock threshold 5\",\n     \"id\": \"AC-30.1\",\n     \"level\": \"unit\",\n     \"then\": \"The returned values are Out of stock, Low stock, Low stock and In stock\",\n     \"when\": \"The stock-status calculator is called with quantities 0, 1, 5 and 6\"\n    },\n    {\n     \"given\": \"Low-stock threshold 5\",\n     \"id\": \"AC-30.2\",\n     \"level\": \"unit\",\n     \"then\": \"The returned value is Out of stock\",\n     \"when\": \"The stock-status calculator is called for a product with no imported quantity\"\n    }\n   ],\n   \"ears\": \"The portal shall derive each product's stock status as Out of stock when its imported quantity is 0 or less or it has never been imported, Low stock when the quantity is from 1 up to the configured low-stock threshold, and In stock when the quantity is above that threshold.\",\n   \"id\": \"REQ-30\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-3\",\n    \"I-12\",\n    \"ASM-5\"\n   ],\n   \"stability\": 1\n  },\n  {\n   \"acceptance\": [\n    {\n     \"given\": \"Threshold 10, products BP-1001 (quantity 4) and FL-200 (quantity 0) and a valid CSV listing BP-1001=25 and FL-200=3\",\n     \"id\": \"AC-31.1\",\n     \"level\": \"job\",\n     \"then\": \"The BP-1001 row has quantity 25 and status \\\"In stock\\\", the FL-200 row has quantity 3 and status \\\"Low stock\\\", and an import log record has status \\\"Success\\\" with rows-applied count 2\",\n     \"when\": \"The stock import job runs\"\n    },\n    {\n     \"given\": \"No new file in the configured location since the last run\",\n     \"id\": \"AC-31.2\",\n     \"level\": \"job\",\n     \"then\": \"No stock quantity value changes\",\n     \"when\": \"The stock import job runs\"\n    }\n   ],\n   \"ears\": \"When the scheduled stock import finds a new ERP CSV file in the configured location that passes file validation, the portal shall replace the stored quantity and recalculate the stock status of each listed known product and record a successful import log entry with row counts.\",\n   \"id\": \"REQ-31\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-12\",\n    \"I-3\",\n    \"ASM-7\"\n   ],\n   \"stability\": 1\n  },\n  {\n   \"acceptance\": [\n    {\n     \"given\": \"A valid CSV with BP-100=12 and ZZ-999=5, where ZZ-999 is not a known product\",\n     \"id\": \"AC-32.1\",\n     \"level\": \"job\",\n     \"then\": \"BP-100's stored quantity value is 12 and the import log row has status \\\"Success\\\", rows-applied count 1 and ZZ-999 in its skipped-identifiers list\",\n     \"when\": \"The stock import job runs\"\n    }\n   ],\n   \"ears\": \"If a valid ERP CSV contains rows with unknown product identifiers, then the portal shall skip those rows, apply the other rows and list the unknown identifiers in the import log entry.\",\n   \"id\": \"REQ-32\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-12\",\n    \"ASM-6\"\n   ],\n   \"stability\": 1\n  },\n  {\n   \"acceptance\": [\n    {\n     \"given\": \"Stored quantity BP-100=12 and a CSV missing the quantity column\",\n     \"id\": \"AC-33.1\",\n     \"level\": \"job\",\n     \"then\": \"BP-100's stored quantity value is still 12 and an import log row has status \\\"Failed\\\" and a reason naming the missing column\",\n     \"when\": \"The stock import job runs\"\n    },\n    {\n     \"given\": \"Stored quantity BP-100=12 and a CSV where one row has quantity \\\"abc\\\" and another has BP-100=20\",\n     \"id\": \"AC-33.2\",\n     \"level\": \"job\",\n     \"then\": \"BP-100's stored quantity value is still 12 and the import log row has status \\\"Failed\\\" with a reason naming the bad row\",\n     \"when\": \"The stock import job runs\"\n    },\n    {\n     \"given\": \"An empty CSV file\",\n     \"id\": \"AC-33.3\",\n     \"level\": \"job\",\n     \"then\": \"No stored quantity value changes and the import log row has status \\\"Failed\\\"\",\n     \"when\": \"The stock import job runs\"\n    },\n    {\n     \"given\": \"No CSV file is present at the configured location\",\n     \"id\": \"AC-33.4\",\n     \"level\": \"job\",\n     \"then\": \"An import log record has status \\\"Failed\\\" with reason \\\"file missing\\\" and no stock row changes\",\n     \"when\": \"The stock import job runs\"\n    }\n   ],\n   \"ears\": \"If the ERP CSV file is missing, unreadable, empty, lacks a required column or contains a non-numeric or negative quantity, then the portal shall keep every previous stock quantity unchanged and record a failed import log entry with the failure reason.\",\n   \"id\": \"REQ-33\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-12\"\n   ],\n   \"stability\": 1\n  },\n  {\n   \"acceptance\": [\n    {\n     \"given\": \"One successful and one failed import\",\n     \"id\": \"AC-34.1\",\n     \"level\": \"api\",\n     \"then\": \"The response status is 200 and the returned list has 2 rows with time, status, rowsApplied, skippedIdentifiers and failureReason fields\",\n     \"when\": \"A staff user lists stock imports\"\n    },\n    {\n     \"given\": \"A signed-in Buyer\",\n     \"id\": \"AC-34.2\",\n     \"level\": \"api\",\n     \"then\": \"The response status is 403\",\n     \"when\": \"The Buyer lists stock imports\"\n    }\n   ],\n   \"ears\": \"When a staff user or administrator lists stock imports, the portal shall return each import's time, status, rows-applied count, skipped identifiers and failure reason.\",\n   \"id\": \"REQ-34\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-12\",\n    \"I-6\"\n   ],\n   \"stability\": 1\n  },\n  {\n   \"acceptance\": [\n    {\n     \"given\": \"Outbound traffic to the ERP host is recorded and the ERP CSV file checksum is noted\",\n     \"id\": \"AC-35.1\",\n     \"level\": \"job\",\n     \"then\": \"No outbound call to the ERP host is recorded and the CSV file checksum value is unchanged\",\n     \"when\": \"The stock import job runs and a Buyer submits an order\"\n    }\n   ],\n   \"ears\": \"The portal shall not send any create, update or delete request to the ERP system.\",\n   \"id\": \"REQ-35\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-12\"\n   ],\n   \"stability\": 0.3333333333333333\n  },\n  {\n   \"acceptance\": [\n    {\n     \"given\": \"Product X with quantity 7 and prices on Standard and Workshop A\",\n     \"id\": \"AC-36.1\",\n     \"level\": \"api\",\n     \"then\": \"The returned quantity value is 7 and the returned price list has 2 entries\",\n     \"when\": \"A staff user opens product X\"\n    },\n    {\n     \"given\": \"Product P imported with quantity 30 at 02:00\",\n     \"id\": \"AC-36.2\",\n     \"level\": \"api\",\n     \"then\": \"The response contains quantity 30, status \\\"In stock\\\" and last import time 02:00\",\n     \"when\": \"A staff user requests the stock of P\"\n    }\n   ],\n   \"ears\": \"When a staff user opens a product, the portal shall return its imported stock quantity, stock status, the time of the last successful import and its price on each price list.\",\n   \"id\": \"REQ-36\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-3\",\n    \"I-6\",\n    \"I-11\",\n    \"I-12\"\n   ],\n   \"stability\": 0.6666666666666666\n  },\n  {\n   \"acceptance\": [\n    {\n     \"given\": \"Product BP-100 with imported quantity 10\",\n     \"id\": \"AC-37.1\",\n     \"level\": \"api\",\n     \"then\": \"The response is a rejection status (422/400), the error message states 10 available and the line quantity value stays at its previous value\",\n     \"when\": \"A Buyer sets the basket quantity to 11\"\n    },\n    {\n     \"given\": \"The same product\",\n     \"id\": \"AC-37.2\",\n     \"level\": \"api\",\n     \"then\": \"The response status is 200 and the returned line quantity is 10\",\n     \"when\": \"A Buyer sets the basket quantity to 10\"\n    },\n    {\n     \"given\": \"Product FL-200 with imported quantity 0\",\n     \"id\": \"AC-37.3\",\n     \"level\": \"api\",\n     \"then\": \"The response is a rejection status and the basket list does not contain FL-200\",\n     \"when\": \"A Buyer adds FL-200 quantity 1 to the basket\"\n    },\n    {\n     \"given\": \"Product OF-20 with imported quantity 0\",\n     \"id\": \"AC-37.4\",\n     \"level\": \"api\",\n     \"then\": \"The response status is 422 and the error message says the product is out of stock\",\n     \"when\": \"A staff user adds 1 of OF-20 to an order being created for company A\"\n    }\n   ],\n   \"ears\": \"If a basket line, staff-created order line or staff amendment would set a quantity greater than the product's imported stock quantity, or the product is Out of stock, then the portal shall reject the change with an error stating the available quantity.\",\n   \"id\": \"REQ-37\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-3\",\n    \"I-12\",\n    \"I-13\",\n    \"ASM-4\"\n   ],\n   \"stability\": 1\n  },\n  {\n   \"id\": \"REQ-38\",\n   \"ears\": \"The portal shall keep each Buyer's basket for the duration of the Buyer's session only, letting the Buyer add products, change line quantities (minimum 1) and remove lines, and returning each line's unit price, quantity and line total and the tax-exclusive basket subtotal.\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-13\",\n    \"ASM-9\",\n    \"ASM-14\"\n   ],\n   \"acceptance\": [\n    {\n     \"id\": \"AC-38.1\",\n     \"given\": \"Product X at 12.50 and product Z at 4.00 on the Buyer's price list, both in stock\",\n     \"when\": \"The Buyer adds 2 of X and 3 of Z\",\n     \"then\": \"The returned line totals are 25.00 and 12.00 and the subtotal value is 37.00\",\n     \"level\": \"api\"\n    },\n    {\n     \"id\": \"AC-38.2\",\n     \"given\": \"The basket from AC-38.1\",\n     \"when\": \"The Buyer changes X to quantity 3 and removes the Z line\",\n     \"then\": \"The returned line count is 1, the line total is 37.50 and the subtotal value is 37.50\",\n     \"level\": \"api\"\n    },\n    {\n     \"id\": \"AC-38.3\",\n     \"given\": \"The basket from AC-38.1\",\n     \"when\": \"The Buyer sets X to quantity 0 or -1\",\n     \"then\": \"The response status is 422, the error names the quantity field and the line quantity value stays 2\",\n     \"level\": \"api\"\n    },\n    {\n     \"id\": \"AC-38.4\",\n     \"given\": \"A Buyer with 2 basket lines\",\n     \"when\": \"The Buyer lists the catalogue and then requests the basket in the same session\",\n     \"then\": \"The returned basket has the same 2 lines\",\n     \"level\": \"api\"\n    },\n    {\n     \"id\": \"AC-38.5\",\n     \"given\": \"A Buyer with 2 basket lines\",\n     \"when\": \"The Buyer signs out, signs in again and requests the basket\",\n     \"then\": \"The returned basket line count is 0\",\n     \"level\": \"api\"\n    }\n   ],\n   \"stability\": 1\n  },\n  {\n   \"acceptance\": [\n    {\n     \"given\": \"Cutoff 14:00, Saturday and Sunday non-working, Monday 5 Oct 2026 a working day\",\n     \"id\": \"AC-39.1\",\n     \"level\": \"unit\",\n     \"then\": \"The returned values are Tuesday 6 Oct, Wednesday 7 Oct and Wednesday 7 Oct\",\n     \"when\": \"The delivery-date calculator is called with Monday 13:00, Monday 14:00 and Monday 15:00\"\n    },\n    {\n     \"given\": \"Cutoff 14:00, weekends non-working\",\n     \"id\": \"AC-39.2\",\n     \"level\": \"unit\",\n     \"then\": \"The returned values are the following Monday and the following Tuesday\",\n     \"when\": \"The calculator is called with Friday 13:00 and Friday 15:00\"\n    },\n    {\n     \"given\": \"Cutoff 14:00 and Tuesday 6 Oct 2026 listed as a non-working date\",\n     \"id\": \"AC-39.3\",\n     \"level\": \"unit\",\n     \"then\": \"The returned value is Wednesday 7 Oct\",\n     \"when\": \"The calculator is called with Monday 5 Oct 13:00\"\n    },\n    {\n     \"given\": \"Timezone Europe/London and cutoff 14:00\",\n     \"id\": \"AC-39.4\",\n     \"level\": \"unit\",\n     \"then\": \"The returned value is Tuesday\",\n     \"when\": \"The calculator is called with Monday 12:30 UTC during British Summer Time (13:30 local)\"\n    },\n    {\n     \"given\": \"Timezone Europe/London and cutoff 14:00\",\n     \"id\": \"AC-39.5\",\n     \"level\": \"unit\",\n     \"then\": \"The returned value is Wednesday 7 Oct\",\n     \"when\": \"The calculator is called with Monday 5 Oct 2026 13:30 UTC (14:30 local)\"\n    }\n   ],\n   \"ears\": \"The portal shall calculate the earliest delivery date, in the configured timezone, as the next working day when the order time is before the configured cutoff (default 14:00) and as the working day after the next working day when the order time is at or after the cutoff, skipping configured non-working dates.\",\n   \"id\": \"REQ-39\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-13\",\n    \"ASM-11\",\n    \"ASM-36\"\n   ],\n   \"stability\": 1\n  },\n  {\n   \"id\": \"REQ-40\",\n   \"ears\": \"The portal shall accept as a delivery date for Buyer baskets, submitted orders and staff-created orders only a working day from the earliest delivery date up to the configured maximum number of days ahead, checked at submission time, offering exactly those dates as selectable and rejecting any other date with an error naming the delivery date.\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-13\",\n    \"ASM-12\"\n   ],\n   \"acceptance\": [\n    {\n     \"id\": \"AC-40.1\",\n     \"given\": \"Maximum 14 days ahead, weekends non-working, current time Monday 10:00\",\n     \"when\": \"A Buyer requests the selectable delivery dates\",\n     \"then\": \"The returned list starts with Tuesday, contains no Saturday or Sunday, and its last value is no later than 14 days after today\",\n     \"level\": \"api\"\n    },\n    {\n     \"id\": \"AC-40.2\",\n     \"given\": \"Now is Monday 2026-10-05 15:00, cutoff 14:00, maximum 30 days ahead\",\n     \"when\": \"The Buyer sets the basket delivery date to 2026-10-06, 2026-10-10 (Saturday) and 2026-11-20 in turn\",\n     \"then\": \"Each response is a validation error status with an error naming the date rule broken\",\n     \"level\": \"api\"\n    },\n    {\n     \"id\": \"AC-40.3\",\n     \"given\": \"The settings of AC-40.2\",\n     \"when\": \"The Buyer sets the basket delivery date to 2026-10-07\",\n     \"then\": \"The response status is 200 and the basket delivery date field is 2026-10-07\",\n     \"level\": \"api\"\n    },\n    {\n     \"id\": \"AC-40.4\",\n     \"given\": \"A Buyer basket with delivery date Tuesday chosen at Monday 13:50\",\n     \"when\": \"The Buyer submits the order at Monday 14:05\",\n     \"then\": \"The response status is 422, the error names the deliveryDate field and no order record is created\",\n     \"level\": \"api\"\n    }\n   ],\n   \"stability\": 1\n  },\n  {\n   \"acceptance\": [\n    {\n     \"given\": \"A Buyer of company A\",\n     \"id\": \"AC-41.1\",\n     \"level\": \"api\",\n     \"then\": \"The response status is 422, the error names the deliveryAddress field and no order record is created\",\n     \"when\": \"The Buyer submits an order using a delivery address id of company B\"\n    },\n    {\n     \"given\": \"Company A has addresses A1 and A2 and company B has address B1\",\n     \"id\": \"AC-41.2\",\n     \"level\": \"api\",\n     \"then\": \"The response status is 422 and the basket delivery address field is unchanged\",\n     \"when\": \"A Buyer of company A sets the basket delivery address to B1\"\n    },\n    {\n     \"given\": \"The data of AC-41.2\",\n     \"id\": \"AC-41.3\",\n     \"level\": \"api\",\n     \"then\": \"The response status is 200 and the basket delivery address field is A2\",\n     \"when\": \"A Buyer of company A sets the basket delivery address to A2\"\n    }\n   ],\n   \"ears\": \"If a basket, submitted order or order edit is given a delivery address that does not belong to the order's customer company, then the portal shall reject it with an error naming the delivery address.\",\n   \"id\": \"REQ-41\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-13\",\n    \"Q-4\",\n    \"Q-7\",\n    \"ASM-13\"\n   ],\n   \"stability\": 1\n  },\n  {\n   \"acceptance\": [\n    {\n     \"given\": \"A basket with 5 of BP-100 when 12 were in stock, and a stock import then sets BP-100 to 3\",\n     \"id\": \"AC-42.1\",\n     \"level\": \"api\",\n     \"then\": \"The response status is 409, the returned list of affected lines contains BP-100 with available quantity 3, and no order record is created\",\n     \"when\": \"The Buyer submits the order\"\n    },\n    {\n     \"given\": \"A basket line for product X at 40.00, and the administrator then changes X to 42.00\",\n     \"id\": \"AC-42.2\",\n     \"level\": \"api\",\n     \"then\": \"The response status is 409, the returned affected line shows current price 42.00 and no order record is created\",\n     \"when\": \"The Buyer submits the order\"\n    },\n    {\n     \"given\": \"A basket line whose product was retired after it was added\",\n     \"id\": \"AC-42.3\",\n     \"level\": \"api\",\n     \"then\": \"The response status is 409 and the response lists the line as unavailable\",\n     \"when\": \"The Buyer submits the order\"\n    }\n   ],\n   \"ears\": \"When a Buyer submits an order, the portal shall re-check every line's availability, stock limit and current company price and, if any line is unavailable, over stock or re-priced, reject the submission and list the affected lines with their current price and available quantity.\",\n   \"id\": \"REQ-42\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-3\",\n    \"I-13\",\n    \"ASM-4\"\n   ],\n   \"stability\": 1\n  },\n  {\n   \"acceptance\": [\n    {\n     \"given\": \"A Buyer with a 2-line basket, a selected address, date and note\",\n     \"id\": \"AC-43.1\",\n     \"level\": \"manual\",\n     \"then\": \"A person checks that the review page is shown with every listed item matching the basket, with the submit button below them, and that the order is only created after pressing submit\",\n     \"when\": \"The Buyer proceeds to checkout in a browser\"\n    },\n    {\n     \"given\": \"A basket with 2 lines, a chosen address, date and note 'Rear entrance'\",\n     \"id\": \"AC-43.2\",\n     \"level\": \"api\",\n     \"then\": \"The response contains both lines with prices and totals, the subtotal, the address, the date and the note value 'Rear entrance'\",\n     \"when\": \"GET /checkout/review is called\"\n    }\n   ],\n   \"ears\": \"When a Buyer proceeds to checkout, the portal shall display a final review page with the lines, quantities, unit prices, line totals, subtotal, delivery address, delivery date and note before the submit action.\",\n   \"id\": \"REQ-43\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-1\",\n    \"I-13\"\n   ],\n   \"stability\": 1\n  },\n  {\n   \"acceptance\": [\n    {\n     \"given\": \"Prefix ORD- and last order number ORD-000123\",\n     \"id\": \"AC-44.1\",\n     \"level\": \"api\",\n     \"then\": \"The response status is 201 and the returned order has number ORD-000124, status Received, 2 lines with the basket unit prices, the address, the date, the note value and 1 timeline entry naming the Buyer\",\n     \"when\": \"A Buyer submits a valid basket with 2 lines and note \\\"Leave at rear gate\\\"\"\n    },\n    {\n     \"given\": \"The order from AC-44.1\",\n     \"id\": \"AC-44.2\",\n     \"level\": \"api\",\n     \"then\": \"The queue list contains ORD-000124 and the returned basket line count is 0\",\n     \"when\": \"A staff user lists Received orders in the queue and the Buyer requests the basket\"\n    },\n    {\n     \"given\": \"A valid basket with no note\",\n     \"id\": \"AC-44.3\",\n     \"level\": \"api\",\n     \"then\": \"The response status is 201 and the order note field is empty\",\n     \"when\": \"The Buyer submits the order\"\n    }\n   ],\n   \"ears\": \"When a valid order is submitted, the portal shall create an order with the next sequential prefixed order number, its lines at order-time unit prices, a copy of the delivery address, the delivery date, the optional note, status Received and a first timeline entry, and then empty the basket.\",\n   \"id\": \"REQ-44\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-1\",\n    \"I-4\",\n    \"I-13\",\n    \"ASM-25\"\n   ],\n   \"stability\": 1\n  },\n  {\n   \"acceptance\": [\n    {\n     \"given\": \"Company A set inactive\",\n     \"id\": \"AC-45.1\",\n     \"level\": \"api\",\n     \"then\": \"The response is a rejection status (422/409), the error says the company is inactive and no order record is created\",\n     \"when\": \"A staff user submits a new order for company A with valid lines\"\n    },\n    {\n     \"given\": \"A Buyer whose session is still valid when the administrator deactivates them (race checked at submission)\",\n     \"id\": \"AC-45.2\",\n     \"level\": \"api\",\n     \"then\": \"The response status is 401 or 403 and no order record is created\",\n     \"when\": \"The order submission is processed after deactivation\"\n    }\n   ],\n   \"ears\": \"If a user of an inactive customer company or a deactivated user submits an order, or staff try to create an order for an inactive customer company, then the portal shall reject it with an error and create no order.\",\n   \"id\": \"REQ-45\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-4\",\n    \"I-9\",\n    \"I-13\",\n    \"Q-5\",\n    \"Q-8\"\n   ],\n   \"stability\": 1\n  },\n  {\n   \"acceptance\": [\n    {\n     \"given\": \"An order placed by Buyer Ann and confirmed by staff user Sam\",\n     \"id\": \"AC-46.1\",\n     \"level\": \"api\",\n     \"then\": \"The returned timeline list has 2 entries: 'Received' by Ann and 'Confirmed' by Sam, each with a timestamp\",\n     \"when\": \"The order is opened\"\n    }\n   ],\n   \"ears\": \"When an order changes status, the portal shall append a timeline entry recording the new status, the date and time, and the user who made the change or 'System'.\",\n   \"id\": \"REQ-46\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-5\",\n    \"I-8\",\n    \"I-14\"\n   ],\n   \"stability\": 0.6666666666666666\n  },\n  {\n   \"id\": \"REQ-47\",\n   \"ears\": \"The portal shall send each order email to the Buyer who placed the order while that Buyer is active and still linked to the order's customer company, and otherwise, including for orders created by staff, to the customer company's contact email.\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-4\",\n    \"I-14\",\n    \"ASM-17\",\n    \"ASM-33\"\n   ],\n   \"acceptance\": [\n    {\n     \"id\": \"AC-47.1\",\n     \"given\": \"An order placed by active Buyer buyer@a.test of company A\",\n     \"when\": \"Staff confirm the order\",\n     \"then\": \"The confirmation email is sent to buyer@a.test only\",\n     \"level\": \"api\"\n    },\n    {\n     \"id\": \"AC-47.2\",\n     \"given\": \"An order created by staff for company A whose contact email is orders@a.test\",\n     \"when\": \"Staff confirm the order\",\n     \"then\": \"The confirmation email is sent to orders@a.test and not to any Buyer\",\n     \"level\": \"api\"\n    },\n    {\n     \"id\": \"AC-47.3\",\n     \"given\": \"A Received order placed by Buyer ann@a.test of company A (contact email orders@a.test), after which an administrator deactivated Ann\",\n     \"when\": \"Staff confirm the order\",\n     \"then\": \"The confirmation email is sent to orders@a.test and no email is sent to ann@a.test\",\n     \"level\": \"api\"\n    },\n    {\n     \"id\": \"AC-47.4\",\n     \"given\": \"A Picking order placed by Buyer ann@a.test of company A (contact email orders@a.test), after which an administrator moved Ann to Fleet Co\",\n     \"when\": \"Staff set the order to Out for delivery\",\n     \"then\": \"The out-for-delivery email is sent to orders@a.test and no email is sent to ann@a.test\",\n     \"level\": \"api\"\n    }\n   ],\n   \"stability\": 1\n  },\n  {\n   \"acceptance\": [\n    {\n     \"given\": \"Company A has 1 order by Buyer A1, 1 by Buyer A2 and 1 created by staff\",\n     \"id\": \"AC-48.1\",\n     \"level\": \"api\",\n     \"then\": \"The returned list has 3 rows, each with orderNumber, orderDate, deliveryDate, deliveryAddress, total and status fields\",\n     \"when\": \"Buyer A1 lists orders\"\n    },\n    {\n     \"given\": \"Company A has one Delivered order by Buyer A2 and one Received order\",\n     \"id\": \"AC-48.2\",\n     \"level\": \"api\",\n     \"then\": \"The returned list contains only the Delivered order\",\n     \"when\": \"Buyer A1 lists orders filtered by status Delivered\"\n    }\n   ],\n   \"ears\": \"When a Buyer lists orders, the portal shall return every order of the Buyer's customer company, including orders placed by colleagues and by staff, with order number, order date, delivery date, delivery address, total and status, filterable by status and order date range.\",\n   \"id\": \"REQ-48\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-5\",\n    \"I-15\",\n    \"Q-2\"\n   ],\n   \"stability\": 1\n  },\n  {\n   \"acceptance\": [\n    {\n     \"given\": \"An order whose quantity of BP-1001 was amended by staff from 4 to 2 and which was then confirmed\",\n     \"id\": \"AC-49.1\",\n     \"level\": \"api\",\n     \"then\": \"The response status is 200, the returned timeline has entries for Received and Confirmed with time and actor, and the amendments list has an entry showing BP-1001 changed from 4 to 2 with the staff user and time\",\n     \"when\": \"A Buyer of that company opens the order\"\n    },\n    {\n     \"given\": \"An order containing a product that was later retired\",\n     \"id\": \"AC-49.2\",\n     \"level\": \"api\",\n     \"then\": \"The returned line still shows the product name, code and order-time unit price\",\n     \"when\": \"A Buyer opens the order\"\n    }\n   ],\n   \"ears\": \"When a Buyer of the order's company or a staff user opens an order, the portal shall return its number, order date, customer, delivery address, requested delivery date, current status, status timeline, lines with quantities, unit prices and line totals, order total, note and staff amendments.\",\n   \"id\": \"REQ-49\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-5\",\n    \"I-8\",\n    \"I-14\",\n    \"I-15\"\n   ],\n   \"stability\": 1\n  },\n  {\n   \"acceptance\": [\n    {\n     \"given\": \"A Received order of company A placed by Buyer A2\",\n     \"id\": \"AC-50.1\",\n     \"level\": \"api\",\n     \"then\": \"The response status is 200, the order status value is Cancelled and the last timeline entry names Buyer A1\",\n     \"when\": \"Buyer A1 cancels it\"\n    },\n    {\n     \"given\": \"A Received order created by staff for company A\",\n     \"id\": \"AC-50.2\",\n     \"level\": \"api\",\n     \"then\": \"The response status is 200 and the order status value is Cancelled\",\n     \"when\": \"Buyer A1 cancels it\"\n    }\n   ],\n   \"ears\": \"When a Buyer cancels an order of their own company that is in Received status, the portal shall set its status to Cancelled and add a timeline entry with the Buyer and time.\",\n   \"id\": \"REQ-50\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-15\",\n    \"Q-6\"\n   ],\n   \"stability\": 1\n  },\n  {\n   \"acceptance\": [\n    {\n     \"given\": \"A Confirmed order of the Buyer's company\",\n     \"id\": \"AC-51.1\",\n     \"level\": \"api\",\n     \"then\": \"The response status is 409, the error message tells the Buyer to contact the distributor office and the status value stays Confirmed\",\n     \"when\": \"The Buyer cancels it\"\n    }\n   ],\n   \"ears\": \"If a Buyer tries to cancel an order that is not in Received status, then the portal shall reject the request with an error telling the Buyer to contact the distributor office.\",\n   \"id\": \"REQ-51\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-15\"\n   ],\n   \"stability\": 1\n  },\n  {\n   \"acceptance\": [\n    {\n     \"given\": \"An old order with 4 of X (now 42.00, 10 in stock), 2 of R (now retired) and 6 of Z (now 3 in stock)\",\n     \"id\": \"AC-52.1\",\n     \"level\": \"api\",\n     \"then\": \"The returned basket has X with quantity 4 at 42.00, Z with quantity 3 flagged as reduced, and R listed as unavailable and not added\",\n     \"when\": \"The Buyer repeats the order\"\n    },\n    {\n     \"given\": \"A colleague's order with BP-1001 ×2 at 12.50 (now 13.00, stock 50) and FL-200 ×1 (now retired)\",\n     \"id\": \"AC-52.2\",\n     \"level\": \"api\",\n     \"then\": \"The response status is 200, the basket list contains BP-1001 quantity 2 at 13.00, the response flags FL-200 as unavailable, and the company's order count is unchanged\",\n     \"when\": \"The Buyer repeats it\"\n    }\n   ],\n   \"ears\": \"When a Buyer repeats an order of their company, the portal shall add each still-orderable line to the session basket at the current price and the original quantity, capped at available stock and flagged when reduced, and flag lines that are retired, out of stock or without a price as unavailable, without creating an order.\",\n   \"id\": \"REQ-52\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-15\",\n    \"Q-6\",\n    \"ASM-3\",\n    \"ASM-4\"\n   ],\n   \"stability\": 1\n  },\n  {\n   \"acceptance\": [\n    {\n     \"given\": \"Orders for companies A and B in statuses Received and Picking\",\n     \"id\": \"AC-53.1\",\n     \"level\": \"api\",\n     \"then\": \"Every returned row has customer A and status Received with the listed fields\",\n     \"when\": \"A staff user lists orders filtered by company A and status Received\"\n    },\n    {\n     \"given\": \"Orders dated 1, 5 and 9 October\",\n     \"id\": \"AC-53.2\",\n     \"level\": \"api\",\n     \"then\": \"The returned list contains only the 5 October order\",\n     \"when\": \"A staff user lists orders with order date range 4–6 October\"\n    }\n   ],\n   \"ears\": \"When a staff user lists orders, the portal shall return orders of all customers with order number, customer, order date, requested delivery date, total and status, filtered by any supplied customer, order date range and status.\",\n   \"id\": \"REQ-53\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-4\",\n    \"I-6\",\n    \"I-14\"\n   ],\n   \"stability\": 1\n  },\n  {\n   \"id\": \"REQ-54\",\n   \"ears\": \"When a staff user searches customers by partial company name or account number or opens a customer company, the portal shall return the matching customer companies or, for the opened company, its details, delivery addresses, assigned price list, users, active status, orders and invoices.\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-4\",\n    \"I-6\"\n   ],\n   \"acceptance\": [\n    {\n     \"id\": \"AC-54.1\",\n     \"given\": \"Companies \\\"Northside Motors\\\" (account C-1001) and \\\"Fleetline\\\" (C-2002)\",\n     \"when\": \"A staff user searches \\\"north\\\" and then \\\"C-2002\\\"\",\n     \"then\": \"The first returned list contains only Northside Motors and the second only Fleetline\",\n     \"level\": \"api\"\n    },\n    {\n     \"id\": \"AC-54.2\",\n     \"given\": \"Company Smith Motors with 2 addresses, 3 users, orders and invoices\",\n     \"when\": \"A staff user opens the company\",\n     \"then\": \"The response contains the company fields, an addresses list of count 2, the price list name, a users list of count 3, the status, and orders and invoices lists\",\n     \"level\": \"api\"\n    }\n   ],\n   \"stability\": 1\n  },\n  {\n   \"id\": \"REQ-55\",\n   \"ears\": \"The portal shall let staff edit an order only while it is in Received status, limited to changing line quantities, removing lines, changing the note, changing the delivery address to another address of the same company and changing the delivery date to a date selectable at the time of the edit.\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-4\",\n    \"I-14\",\n    \"Q-4\",\n    \"ASM-35\"\n   ],\n   \"acceptance\": [\n    {\n     \"id\": \"AC-55.1\",\n     \"given\": \"A Received order with delivery date Thursday\",\n     \"when\": \"At Monday 15:00 staff change the date to Wednesday, then to Tuesday\",\n     \"then\": \"The Wednesday change response status is 200 and the Tuesday change response status is 422 with an error naming the deliveryDate field\",\n     \"level\": \"api\"\n    },\n    {\n     \"id\": \"AC-55.2\",\n     \"given\": \"A Received order of company A\",\n     \"when\": \"Staff change the delivery address to an address of company B\",\n     \"then\": \"The response status is 422 and the order's address value is unchanged\",\n     \"level\": \"api\"\n    },\n    {\n     \"id\": \"AC-55.3\",\n     \"given\": \"A Received order with 2 lines\",\n     \"when\": \"Staff remove one line and change the note\",\n     \"then\": \"The response status is 200 and the order record has 1 line, the new note and a recalculated total\",\n     \"level\": \"api\"\n    },\n    {\n     \"id\": \"AC-55.4\",\n     \"given\": \"A Confirmed order\",\n     \"when\": \"Staff change a line quantity\",\n     \"then\": \"The response status is 409 and the line quantity value is unchanged\",\n     \"level\": \"api\"\n    }\n   ],\n   \"stability\": 1\n  },\n  {\n   \"acceptance\": [\n    {\n     \"given\": \"A Received order with 5 of X\",\n     \"id\": \"AC-56.1\",\n     \"level\": \"api\",\n     \"then\": \"An amendment record shows X 5 → 3 with the staff user and time, and one email naming X, 5 and 3 is sent to the order recipient\",\n     \"when\": \"Staff change the quantity of X to 3\"\n    },\n    {\n     \"given\": \"A Received order placed by Buyer Ann with BP-1001 ×4 and FL-200 ×1\",\n     \"id\": \"AC-56.2\",\n     \"level\": \"api\",\n     \"then\": \"An email is sent to Ann listing BP-1001 4→2 and FL-200 1→0\",\n     \"when\": \"Staff set BP-1001 to 2 and remove FL-200\"\n    },\n    {\n     \"given\": \"A Received order\",\n     \"id\": \"AC-56.3\",\n     \"level\": \"api\",\n     \"then\": \"No email is sent\",\n     \"when\": \"Staff change only the delivery date, delivery address or note\"\n    }\n   ],\n   \"ears\": \"When staff change a line quantity or remove a line on a Received order, the portal shall record the amendment with old and new quantity, staff user and time, and send the order recipient an email listing each changed line with its old and new quantity.\",\n   \"id\": \"REQ-56\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-8\",\n    \"I-14\",\n    \"ASM-17\",\n    \"ASM-33\",\n    \"ASM-35\"\n   ],\n   \"stability\": 1\n  },\n  {\n   \"acceptance\": [\n    {\n     \"given\": \"A Received order with all lines in stock\",\n     \"id\": \"AC-57.1\",\n     \"level\": \"api\",\n     \"then\": \"The response status is 200, the status value is Confirmed and the timeline entry records the staff user and time\",\n     \"when\": \"Staff confirm it\"\n    },\n    {\n     \"given\": \"A Received order with 5 of BP-100 while only 3 are in stock\",\n     \"id\": \"AC-57.2\",\n     \"level\": \"api\",\n     \"then\": \"The response status is 409, the error lists BP-100 with available quantity 3 and the status value stays Received\",\n     \"when\": \"Staff confirm it\"\n    },\n    {\n     \"given\": \"An order in status Picking\",\n     \"id\": \"AC-57.3\",\n     \"level\": \"api\",\n     \"then\": \"The response status is 409\",\n     \"when\": \"Staff confirm it\"\n    }\n   ],\n   \"ears\": \"When staff confirm an order in Received status whose lines are all active and within available stock and whose delivery address still exists, the portal shall set the status to Confirmed and add a timeline entry with the staff user and time, and otherwise reject the confirmation listing the failing lines.\",\n   \"id\": \"REQ-57\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-4\",\n    \"I-14\",\n    \"ASM-33\"\n   ],\n   \"stability\": 1\n  },\n  {\n   \"acceptance\": [\n    {\n     \"given\": \"Received order ORD-000124 placed by Buyer Ann where staff reduced BP-1001 from 4 to 2\",\n     \"id\": \"AC-58.1\",\n     \"level\": \"api\",\n     \"then\": \"One email is sent to Ann containing ORD-000124, the lines, the total, the delivery date and address, and the change of BP-1001 from 4 to 2\",\n     \"when\": \"Staff confirm it\"\n    }\n   ],\n   \"ears\": \"When an order becomes Confirmed, the portal shall send a confirmation email to the order recipient containing the order number, lines with quantities and unit prices, order total, delivery address, delivery date and every quantity change staff made before confirmation.\",\n   \"id\": \"REQ-58\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-5\",\n    \"I-14\",\n    \"ASM-17\",\n    \"ASM-33\"\n   ],\n   \"stability\": 1\n  },\n  {\n   \"acceptance\": [\n    {\n     \"given\": \"A Confirmed order\",\n     \"id\": \"AC-59.1\",\n     \"level\": \"api\",\n     \"then\": \"The response status is 200 and the last timeline entry has status Picking, the staff user and the time\",\n     \"when\": \"Staff set it to Picking\"\n    },\n    {\n     \"given\": \"A Confirmed order\",\n     \"id\": \"AC-59.2\",\n     \"level\": \"api\",\n     \"then\": \"The response status is 409 and the status value stays Confirmed\",\n     \"when\": \"Staff set it to Out for delivery\"\n    },\n    {\n     \"given\": \"A Picking order\",\n     \"id\": \"AC-59.3\",\n     \"level\": \"api\",\n     \"then\": \"The response status is 409\",\n     \"when\": \"Staff set it back to Confirmed\"\n    },\n    {\n     \"given\": \"A Picking order\",\n     \"id\": \"AC-59.4\",\n     \"level\": \"api\",\n     \"then\": \"The response status is 200 and the status value is Out for delivery\",\n     \"when\": \"Staff set it to Out for delivery\"\n    }\n   ],\n   \"ears\": \"When staff advance an order's status, the portal shall accept only the next status in the sequence Confirmed, Picking, Out for delivery, Delivered (or a cancellation) and add a timeline entry with the staff user and time, rejecting any other change and leaving the status unchanged.\",\n   \"id\": \"REQ-59\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-14\",\n    \"Q-3\"\n   ],\n   \"stability\": 1\n  },\n  {\n   \"acceptance\": [\n    {\n     \"given\": \"A Picking order ORD-000124\",\n     \"id\": \"AC-60.1\",\n     \"level\": \"api\",\n     \"then\": \"One email containing ORD-000124 and the text \\\"out for delivery\\\" is sent to the order recipient\",\n     \"when\": \"Staff set it to Out for delivery\"\n    }\n   ],\n   \"ears\": \"When an order's status changes to Out for delivery, the portal shall send the order recipient an email identifying the order number and stating it is out for delivery.\",\n   \"id\": \"REQ-60\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-5\",\n    \"I-14\",\n    \"ASM-17\",\n    \"ASM-33\"\n   ],\n   \"stability\": 1\n  },\n  {\n   \"acceptance\": [\n    {\n     \"given\": \"An Out for delivery order\",\n     \"id\": \"AC-61.1\",\n     \"level\": \"api\",\n     \"then\": \"The status value is Cancelled, the timeline entry records the reason, staff user and time, and an email containing \\\"Customer closed\\\" is sent\",\n     \"when\": \"Staff cancel it with reason \\\"Customer closed\\\"\"\n    },\n    {\n     \"given\": \"A Picking order placed by Buyer Ann\",\n     \"id\": \"AC-61.2\",\n     \"level\": \"api\",\n     \"then\": \"The response status is 200, the status value is Cancelled, the order row stores the reason, and an email containing 'Supplier recall' is sent to Ann\",\n     \"when\": \"Staff cancel it with reason 'Supplier recall'\"\n    },\n    {\n     \"given\": \"A Received order\",\n     \"id\": \"AC-61.3\",\n     \"level\": \"api\",\n     \"then\": \"The response is a validation error status (400/422) and the status value stays Received\",\n     \"when\": \"Staff reject it with an empty reason\"\n    },\n    {\n     \"given\": \"A Delivered order\",\n     \"id\": \"AC-61.4\",\n     \"level\": \"api\",\n     \"then\": \"The response status is 409 and the status value stays Delivered\",\n     \"when\": \"Staff cancel it with a reason\"\n    }\n   ],\n   \"ears\": \"When staff cancel or reject an order that is neither Delivered nor Cancelled, the portal shall require a reason, set the status to Cancelled, record the reason, staff user and time, and send the order recipient a cancellation email containing the reason.\",\n   \"id\": \"REQ-61\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-14\",\n    \"Q-3\",\n    \"ASM-16\",\n    \"ASM-33\",\n    \"ASM-34\"\n   ],\n   \"stability\": 1\n  },\n  {\n   \"acceptance\": [\n    {\n     \"given\": \"Active company A on price list Workshop A\",\n     \"id\": \"AC-62.1\",\n     \"level\": \"api\",\n     \"then\": \"The response status is 201, the order has status Received, the line unit price comes from Workshop A and the createdBy field names the staff user\",\n     \"when\": \"A staff user submits an order for company A with 2 of X and a valid address and date\"\n    },\n    {\n     \"given\": \"The order from AC-62.1\",\n     \"id\": \"AC-62.2\",\n     \"level\": \"api\",\n     \"then\": \"The returned list contains the order\",\n     \"when\": \"A Buyer of company A lists orders\"\n    }\n   ],\n   \"ears\": \"When staff submit an order on behalf of an active customer company with a company delivery address, products, quantities, a valid delivery date and optional note, the portal shall create it in Received status under the same price, stock, address and delivery-date rules as a Buyer order, marked as created by that staff user.\",\n   \"id\": \"REQ-62\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-4\",\n    \"I-14\",\n    \"ASM-12\"\n   ],\n   \"stability\": 1\n  },\n  {\n   \"acceptance\": [\n    {\n     \"given\": \"A Picking order of a company that has been set inactive\",\n     \"id\": \"AC-63.1\",\n     \"level\": \"api\",\n     \"then\": \"The response status is 200\",\n     \"when\": \"Staff set it to Out for delivery\"\n    },\n    {\n     \"given\": \"An Out for delivery order of an inactive company\",\n     \"id\": \"AC-63.2\",\n     \"level\": \"api\",\n     \"then\": \"The response status is 200 and one invoice record is created for that order\",\n     \"when\": \"Staff set it to Delivered\"\n    },\n    {\n     \"given\": \"Inactive company Fleet Co with orders and invoices\",\n     \"id\": \"AC-63.3\",\n     \"level\": \"api\",\n     \"then\": \"Both response statuses are 200 and the returned lists include Fleet Co's orders and invoices\",\n     \"when\": \"Staff list orders and invoices filtered by Fleet Co\"\n    }\n   ],\n   \"ears\": \"While a customer company is inactive, the portal shall keep its existing orders and invoices visible to staff and let staff progress, cancel and invoice its open orders.\",\n   \"id\": \"REQ-63\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-14\",\n    \"I-16\",\n    \"I-17\",\n    \"Q-5\",\n    \"Q-8\"\n   ],\n   \"stability\": 1\n  },\n  {\n   \"acceptance\": [\n    {\n     \"given\": \"For 8 Oct: one Confirmed order, one Out for delivery order and one Cancelled order; for 9 Oct: 1 order\",\n     \"id\": \"AC-64.1\",\n     \"level\": \"api\",\n     \"then\": \"The returned file is CSV (content type text/csv) with a header row and exactly 2 data rows, for the Confirmed and Out for delivery orders, each with the listed columns\",\n     \"when\": \"Staff export the delivery list for 8 Oct\"\n    },\n    {\n     \"given\": \"An order for today\",\n     \"id\": \"AC-64.2\",\n     \"level\": \"api\",\n     \"then\": \"The returned file contains that order\",\n     \"when\": \"Staff export the delivery list without a date\"\n    }\n   ],\n   \"ears\": \"When staff export the delivery list for a date (default today), the portal shall return a CSV file with one row per non-Cancelled order whose requested delivery date is that date, containing order number, customer name, delivery address, address contact name and phone, delivery date, line summary, order note and status.\",\n   \"id\": \"REQ-64\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-6\",\n    \"ASM-27\"\n   ],\n   \"stability\": 1\n  },\n  {\n   \"acceptance\": [\n    {\n     \"given\": \"3 Received, 1 Picking and 2 Out for delivery orders, 2 non-Cancelled orders due today, 4 Unpaid and 1 Overdue invoice\",\n     \"id\": \"AC-65.1\",\n     \"level\": \"api\",\n     \"then\": \"The returned count fields for received, picking, outForDelivery, dueToday, unpaid and overdue are 3, 1, 2, 2, 4 and 1\",\n     \"when\": \"A staff user requests the dashboard\"\n    }\n   ],\n   \"ears\": \"When a staff user opens the dashboard, the portal shall return counts of orders in Received, Picking and Out for delivery status, non-Cancelled orders due for delivery today, and Unpaid and Overdue invoices.\",\n   \"id\": \"REQ-65\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-6\"\n   ],\n   \"stability\": 1\n  },\n  {\n   \"acceptance\": [\n    {\n     \"given\": \"1 Confirmed order\",\n     \"id\": \"AC-66.1\",\n     \"level\": \"api\",\n     \"then\": \"The returned confirmed count field is 1\",\n     \"when\": \"A staff user requests the dashboard\"\n    }\n   ],\n   \"ears\": \"When a staff user opens the dashboard, the portal shall return the count of orders in Confirmed status.\",\n   \"id\": \"REQ-66\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-6\"\n   ],\n   \"stability\": 0.3333333333333333\n  },\n  {\n   \"acceptance\": [\n    {\n     \"given\": \"1 failed import after the last successful import\",\n     \"id\": \"AC-67.1\",\n     \"level\": \"api\",\n     \"then\": \"The returned failedImports count field is 1\",\n     \"when\": \"A staff user requests the dashboard\"\n    }\n   ],\n   \"ears\": \"When a staff user opens the dashboard, the portal shall return the count of failed stock imports since the last successful import.\",\n   \"id\": \"REQ-67\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-6\",\n    \"I-12\"\n   ],\n   \"stability\": 0.3333333333333333\n  },\n  {\n   \"acceptance\": [\n    {\n     \"given\": \"The latest import log record has status 'Failed'\",\n     \"id\": \"AC-69.1\",\n     \"level\": \"api\",\n     \"then\": \"The dashboard response field latestImportFailed is true and the returned import list shows the failed record with time and reason\",\n     \"when\": \"A staff user requests the dashboard and the stock import list\"\n    }\n   ],\n   \"ears\": \"When the most recent stock import has failed, the portal shall show the latest import result, with failure time and reason, on the staff dashboard.\",\n   \"id\": \"REQ-69\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-6\",\n    \"I-12\"\n   ],\n   \"stability\": 0.3333333333333333\n  },\n  {\n   \"acceptance\": [\n    {\n     \"given\": \"An Out for delivery order with net total 100.00, tax rate 20% and last invoice INV-000049\",\n     \"id\": \"AC-70.1\",\n     \"level\": \"api\",\n     \"then\": \"One invoice record exists with number INV-000050, net 100.00, tax rate 20%, tax 20.00, gross 120.00 and status Unpaid\",\n     \"when\": \"Staff set it to Delivered\"\n    },\n    {\n     \"given\": \"A Picking order\",\n     \"id\": \"AC-70.2\",\n     \"level\": \"api\",\n     \"then\": \"The returned list contains no invoice for that order\",\n     \"when\": \"The Buyer lists invoices\"\n    }\n   ],\n   \"ears\": \"When an order's status becomes Delivered, the portal shall create one invoice for it with the next sequential prefixed invoice number, customer, the company's billing address, the order number, the invoice date, the order lines at order-time prices, the net total, the configured tax rate and tax amount, the gross total and payment status Unpaid.\",\n   \"id\": \"REQ-70\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-5\",\n    \"I-16\",\n    \"Q-8\",\n    \"ASM-2\",\n    \"ASM-9\",\n    \"ASM-25\"\n   ],\n   \"stability\": 1\n  },\n  {\n   \"acceptance\": [\n    {\n     \"given\": \"Overdue days 30 and an unpaid invoice dated 1 March\",\n     \"id\": \"AC-71.1\",\n     \"level\": \"unit\",\n     \"then\": \"The returned values are Unpaid and Overdue\",\n     \"when\": \"The invoice-status calculator is called for 31 March and for 1 April\"\n    },\n    {\n     \"given\": \"An invoice dated 1 January that is marked paid\",\n     \"id\": \"AC-71.2\",\n     \"level\": \"unit\",\n     \"then\": \"The returned value is Paid\",\n     \"when\": \"The invoice-status calculator is called for 1 April\"\n    }\n   ],\n   \"ears\": \"The portal shall report an unpaid invoice's payment status as Overdue once more than the configured number of days have passed since its invoice date, as Unpaid before that, and as Paid once payment is recorded.\",\n   \"id\": \"REQ-71\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-16\",\n    \"ASM-8\"\n   ],\n   \"stability\": 1\n  },\n  {\n   \"acceptance\": [\n    {\n     \"given\": \"Company A has 2 invoices for orders placed by different Buyers, company B has 1\",\n     \"id\": \"AC-72.1\",\n     \"level\": \"api\",\n     \"then\": \"The returned list has 2 rows with invoiceNumber, orderNumber, invoiceDate, grossTotal and status fields\",\n     \"when\": \"Buyer A1 lists invoices\"\n    },\n    {\n     \"given\": \"The same invoices\",\n     \"id\": \"AC-72.2\",\n     \"level\": \"api\",\n     \"then\": \"The returned list has 3 rows\",\n     \"when\": \"A staff user lists invoices\"\n    }\n   ],\n   \"ears\": \"When a user lists invoices, the portal shall return invoice number, order number, invoice date, gross total and payment status for every invoice of the Buyer's own company, or of all companies for staff.\",\n   \"id\": \"REQ-72\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-5\",\n    \"I-16\",\n    \"Q-2\",\n    \"ASM-32\"\n   ],\n   \"stability\": 