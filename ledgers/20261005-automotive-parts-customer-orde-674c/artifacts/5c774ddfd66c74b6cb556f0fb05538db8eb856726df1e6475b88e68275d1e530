"Price lists\",\n   \"route\": \"/office/price-lists\",\n   \"app\": \"office\"\n  },\n  {\n   \"id\": \"S-31\",\n   \"title\": \"Price list\",\n   \"route\": \"/office/price-lists/:priceListId\",\n   \"app\": \"office\"\n  },\n  {\n   \"id\": \"S-32\",\n   \"title\": \"Stock imports\",\n   \"route\": \"/office/imports\",\n   \"app\": \"office\"\n  },\n  {\n   \"id\": \"S-33\",\n   \"title\": \"Users\",\n   \"route\": \"/office/users\",\n   \"app\": \"office\"\n  },\n  {\n   \"id\": \"S-34\",\n   \"title\": \"Invite user\",\n   \"route\": \"/office/users/invite\",\n   \"app\": \"office\"\n  },\n  {\n   \"id\": \"S-35\",\n   \"title\": \"User\",\n   \"route\": \"/office/users/:userId\",\n   \"app\": \"office\"\n  },\n  {\n   \"id\": \"S-36\",\n   \"title\": \"Audit log\",\n   \"route\": \"/office/audit\",\n   \"app\": \"office\"\n  },\n  {\n   \"id\": \"S-37\",\n   \"title\": \"Settings\",\n   \"route\": \"/office/settings\",\n   \"app\": \"office\"\n  }\n ]\n}\n</artifact>\n\n<artifact id=\"this-page\" kind=\"design-plan\" sha=\"\">\n{\n \"id\": \"S-26\",\n \"route\": \"/office/products\",\n \"file\": \"src/pages/office/Products.tsx\",\n \"reqs\": [\n  \"REQ-30\",\n  \"REQ-75\",\n  \"REQ-120\"\n ],\n \"states\": [\n  \"loading\",\n  \"empty\"\n ],\n \"size\": \"new\",\n \"frames\": [],\n \"app\": \"office\",\n \"group\": \"Catalogue\",\n \"title\": \"Products\",\n \"purpose\": \"Staff list products, active and retired, with code, category, brand, stock quantity and status. Admins can start adding a product.\"\n}\n</artifact>\n\n<artifact id=\"requirements\" kind=\"spec\" sha=\"\">\n[\n {\n  \"id\": \"REQ-30\",\n  \"ears\": \"The portal shall derive each product's stock status as Out of stock when its imported quantity is 0 or less or it has never been imported, Low stock when the quantity is from 1 up to the configured low-stock threshold, and In stock when the quantity is above that threshold.\"\n },\n {\n  \"id\": \"REQ-75\",\n  \"ears\": \"The portal shall let administrators add, edit and retire products with name, internal product ID, manufacturer part number, unique distributor product code, description, category, manufacturer/brand, unit of sale and pack size, keeping retired products out of the catalogue but on existing orders and invoices.\"\n },\n {\n  \"id\": \"REQ-120\",\n  \"ears\": \"While a list or search has no results, the portal shall display an empty-state message specific to that list (search results, basket, orders, invoices, templates, products, report results).\"\n }\n]\n</artifact>\n\nDraw page S-26, \"Products\"."}