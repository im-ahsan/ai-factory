\": [\n  \"Where assumptions conflict, the later clarification round wins: ASM-49 (holiday list) over ASM-19, ASM-50 (no tax lines) over ASM-23, ASM-41 (PDF rendered per download) over ASM-4, Q-7 over ASM-8, ASM-2 plus ASM-39 combined.\",\n  \"Report 'order value' and 'revenue' = sum of order line quantity × unit price, excluding tax and excluding Cancelled orders (ASM-44 gave no rule).\",\n  \"Report date range filters on order submission date in the business timezone, inclusive of both ends (ASM-45).\",\n  \"Order emails go to the user who placed the order (ASM-12 gave no rule).\",\n  \"A failed email does not roll back the triggering action and is recorded as Failed (ASM-48 gave no rule).\",\n  \"Cross-customer access returns 404 rather than 403 to avoid revealing record existence.\",\n  \"Intent span IDs I-1..I-45 were mapped to request sections in order since span text was not supplied.\"\n ],\n \"nfrs\": [\n  {\n   \"id\": \"NFR-1\",\n   \"metric\": \"p95 server response ≤ 1.5 s at 50 concurrent users\",\n   \"text\": \"Catalogue browsing, search, product detail, basket operations, checkout, order history and staff order queue respond quickly at expected load (300 buyers, 15 staff, 150 orders/day).\"\n  },\n  {\n   \"id\": \"NFR-2\",\n   \"metric\": \"0 serious or critical automated accessibility violations on main flows; manual keyboard-only completion of 100% of main flows\",\n   \"text\": \"Main customer and staff flows meet WCAG 2.1 AA.\"\n  },\n  {\n   \"id\": \"NFR-3\",\n   \"metric\": \"Records retained ≥ 7 years from creation\",\n   \"text\": \"Order, invoice and audit data retention.\"\n  },\n  {\n   \"id\": \"NFR-4\",\n   \"metric\": \"100% of stored passwords use bcrypt/argon2 with cost ≥ 10; 0 plaintext\",\n   \"text\": \"Passwords stored hashed.\"\n  },\n  {\n   \"id\": \"NFR-5\",\n   \"metric\": \"Report results include orders saved ≥ 5 s before the request\",\n   \"text\": \"Reports reflect current data.\"\n  }\n ],\n \"outOfScope\": [\n  \"Online card payments\",\n  \"Native iOS and Android apps\",\n  \"Multi-language support (English only, ASM-34)\",\n  \"Delivery route planning and driver route optimisation\",\n  \"Returns management, customer self-service returns and credit notes\",\n  \"Direct ERP inventory write-back\",\n  \"Marketplace functionality\",\n  \"Promotions, coupons, volume, tiered and contract-specific pricing\",\n  \"Social sign-in and SSO (ASM-1)\",\n  \"SMS and push notifications (ASM-10)\",\n  \"Custom report builder and extra report filters by customer/product/category (ASM-5)\",\n  \"Dark mode (ASM-35) and offline use (ASM-36)\",\n  \"Data migration; system starts empty with seed data (ASM-33)\",\n  \"Full-text search engine (ASM-37)\"\n ],\n \"requirements\": [\n  {\n   \"acceptance\": [\n    {\n     \"given\": \"2 non-cancelled orders on 2026-03-02 with line totals 100.00 and 50.00, and 1 order on 2026-03-03 for 20.00\",\n     \"id\": \"AC-1.1\",\n     \"level\": \"api\",\n     \"then\": \"The response status is 200 and the returned rows are (2026-03-02, 2, 150.00) and (2026-03-03, 1, 20.00)\",\n     \"when\": \"staff calls GET /reports/orders-per-day?start=2026-03-02&end=2026-03-03\"\n    }\n   ],\n   \"ears\": \"When a staff or admin user requests the Orders per Day report for a date range, the portal shall return one row per date with the number of orders and the order value.\",\n   \"id\": \"REQ-1\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-1\",\n    \"Q-1\",\n    \"ASM-44\"\n   ]\n  },\n  {\n   \"acceptance\": [\n    {\n     \"given\": \"Product A sold 5 units at 10.00 and Product B sold 1 unit at 80.00 in the range\",\n     \"id\": \"AC-2.1\",\n     \"level\": \"api\",\n     \"then\": \"The returned list is [(B, 1, 80.00), (A, 5, 50.00)]\",\n     \"when\": \"staff calls GET /reports/top-products for that range\"\n    }\n   ],\n   \"ears\": \"When a staff or admin user requests the Top Products report for a date range, the portal shall return one row per product with quantity sold and revenue, ordered by revenue descending.\",\n   \"id\": \"REQ-2\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-1\",\n    \"Q-1\",\n    \"ASM-44\"\n   ]\n  },\n  {\n   \"acceptance\": [\n    {\n     \"given\": \"Customer A has 2 orders totalling 300.00 and Customer B has 1 cancelled order in the range\",\n     \"id\": \"AC-3.1\",\n     \"level\": \"api\",\n     \"then\": \"The returned rows contain (A, 2, 300.00) and no row for Customer B\",\n     \"when\": \"staff calls GET /reports/revenue-per-customer for that range\"\n    }\n   ],\n   \"ears\": \"When a staff or admin user requests the Revenue per Customer report for a date range, the portal shall return one row per customer with the number of orders and revenue.\",\n   \"id\": \"REQ-3\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-1\",\n    \"Q-1\",\n    \"ASM-44\"\n   ]\n  },\n  {\n   \"acceptance\": [\n    {\n     \"given\": \"orders submitted on 2026-02-28, 2026-03-01 and 2026-03-31 and 2026-04-01\",\n     \"id\": \"AC-4.1\",\n     \"level\": \"api\",\n     \"then\": \"The returned rows cover only 2026-03-01 and 2026-03-31\",\n     \"when\": \"staff requests Orders per Day with start=2026-03-01 and end=2026-03-31\"\n    }\n   ],\n   \"ears\": \"When a report is requested with a start date and end date, the portal shall include only orders whose submission date, in the business timezone, falls within the inclusive range.\",\n   \"id\": \"REQ-4\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-2\",\n    \"ASM-45\",\n    \"I-33\"\n   ]\n  },\n  {\n   \"acceptance\": [\n    {\n     \"given\": \"a signed-in customer user\",\n     \"id\": \"AC-5.1\",\n     \"level\": \"api\",\n     \"then\": \"Both response statuses are 403 and no report data is returned\",\n     \"when\": \"they call GET /reports/top-products and GET /reports/top-products.csv\"\n    }\n   ],\n   \"ears\": \"If a customer user requests any report or report export, then the portal shall reject the request with status 403.\",\n   \"id\": \"REQ-5\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"Q-1\",\n    \"I-28\"\n   ]\n  },\n  {\n   \"acceptance\": [\n    {\n     \"given\": \"the Orders per Day report for a range has rows (2026-03-02, 2, 150.00)\",\n     \"id\": \"AC-6.1\",\n     \"level\": \"api\",\n     \"then\": \"The response file's first line is the header 'Date,Number of orders,Order value' and the next line is '2026-03-02,2,150.00'\",\n     \"when\": \"staff calls GET /reports/orders-per-day.csv for that range\"\n    }\n   ],\n   \"ears\": \"When a staff or admin user exports a report, the portal shall return a UTF-8 comma-separated CSV file with a header row, the on-screen columns in on-screen order, ISO 8601 dates and '.' as decimal separator.\",\n   \"id\": \"REQ-6\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-3\",\n    \"I-28\",\n    \"ASM-27\"\n   ]\n  },\n  {\n   \"acceptance\": [\n    {\n     \"given\": \"a staff user confirms order 42\",\n     \"id\": \"AC-7.1\",\n     \"level\": \"api\",\n     \"then\": \"An audit row exists with event 'Order confirmed', the staff user as actor, order 42 as target and a timestamp\",\n     \"when\": \"the confirm call returns 200\"\n    }\n   ],\n   \"ears\": \"When any of the listed business actions occurs (user invited or deactivated; product created, changed or retired; price or customer price list changed; order created, amended, confirmed, cancelled or status changed; invoice created or marked paid; ERP import succeeded or failed), the portal shall write an audit record with event type, actor, target record and timestamp.\",\n   \"id\": \"REQ-7\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-4\",\n    \"Q-7\"\n   ]\n  },\n  {\n   \"acceptance\": [\n    {\n     \"given\": \"a staff user and an admin user\",\n     \"id\": \"AC-8.1\",\n     \"level\": \"api\",\n     \"then\": \"The staff response status is 403 and the admin response status is 200 with a list of audit records\",\n     \"when\": \"each calls GET /admin/audit-logs\"\n    }\n   ],\n   \"ears\": \"If a non-admin user requests audit history, then the portal shall reject the request with status 403.\",\n   \"id\": \"REQ-8\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"Q-7\",\n    \"I-19\"\n   ]\n  },\n  {\n   \"acceptance\": [\n    {\n     \"given\": \"a customer user who placed order 42\",\n     \"id\": \"AC-9.1\",\n     \"level\": \"api\",\n     \"then\": \"The user record's status field is Deactivated, order 42 and its invoice are still returned to other users of that customer, and the user's sign-in returns an error\",\n     \"when\": \"an admin deactivates the user\"\n    }\n   ],\n   \"ears\": \"The portal shall retain order, invoice and audit records for at least 7 years and shall deactivate rather than delete users so their links to orders and invoices remain.\",\n   \"id\": \"REQ-9\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-8\",\n    \"Q-7\",\n    \"ASM-22\",\n    \"I-36\"\n   ]\n  },\n  {\n   \"acceptance\": [\n    {\n     \"given\": \"a stubbed email provider and order 42 in status Picking\",\n     \"id\": \"AC-10.1\",\n     \"level\": \"api\",\n     \"then\": \"One email with the 'Order out for delivery' template referencing order 42 is sent to the ordering user's address at the provider stub\",\n     \"when\": \"staff sets order 42 to Out for Delivery\"\n    }\n   ],\n   \"ears\": \"When a user is invited, a password reset is requested, or an order is confirmed, amended, out for delivery, cancelled or rejected, the portal shall send the matching template email through the configured email provider.\",\n   \"id\": \"REQ-10\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-5\",\n    \"I-6\",\n    \"ASM-11\",\n    \"ASM-12\",\n    \"I-37\"\n   ]\n  },\n  {\n   \"acceptance\": [\n    {\n     \"given\": \"the email provider stub returns an error\",\n     \"id\": \"AC-11.1\",\n     \"level\": \"api\",\n     \"then\": \"The response status is 200, order 42's status field is Confirmed, and an email notification row has status Failed with the error message\",\n     \"when\": \"staff confirms order 42\"\n    }\n   ],\n   \"ears\": \"If sending a notification email fails, then the portal shall still complete the triggering action and record the failed email with its error.\",\n   \"id\": \"REQ-11\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-14\",\n    \"ASM-48\",\n    \"ASM-10\"\n   ]\n  },\n  {\n   \"acceptance\": [\n    {\n     \"given\": \"products P1 (stock 5) and P2 (stock 9), and a file containing only 'P1,12'\",\n     \"id\": \"AC-12.1\",\n     \"level\": \"job\",\n     \"then\": \"P1's stock record value is 12 and P2's stock record value is still 9\",\n     \"when\": \"the stock import job runs\"\n    }\n   ],\n   \"ears\": \"When the scheduled stock import runs (default 02:00, configurable), the portal shall read the ERP CSV from the configured location and set stock quantity for each valid row's product, leaving products not in the file unchanged.\",\n   \"id\": \"REQ-12\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-7\",\n    \"ASM-13\",\n    \"ASM-15\",\n    \"ASM-16\",\n    \"I-24\",\n    \"I-25\"\n   ]\n  },\n  {\n   \"acceptance\": [\n    {\n     \"given\": \"a file with 4 rows: one valid, one unknown code, one quantity 'abc', one quantity -3\",\n     \"id\": \"AC-13.1\",\n     \"level\": \"job\",\n     \"then\": \"The import record shows received 4, processed 1, rejected 3 with one error detail per rejected row\",\n     \"when\": \"the stock import job runs\"\n    },\n    {\n     \"given\": \"a file with no header row\",\n     \"id\": \"AC-13.2\",\n     \"level\": \"job\",\n     \"then\": \"The import record status is Failed and no stock value changes\",\n     \"when\": \"the stock import job runs\"\n    }\n   ],\n   \"ears\": \"When the stock import validates a file, the portal shall reject the whole file if it is empty or missing required headers, and otherwise apply valid rows and reject rows with unknown or duplicate product codes or non-numeric or negative quantities, recording received, processed and rejected counts with error details.\",\n   \"id\": \"REQ-13\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-27\",\n    \"ASM-14\",\n    \"ASM-46\",\n    \"I-38\"\n   ]\n  },\n  {\n   \"acceptance\": [\n    {\n     \"given\": \"an ERP endpoint stub that records requests\",\n     \"id\": \"AC-14.1\",\n     \"level\": \"job\",\n     \"then\": \"The stub's recorded request count is 0\",\n     \"when\": \"the stock import job runs and an order is submitted and delivered\"\n    }\n   ],\n   \"ears\": \"The portal shall not send any stock or inventory write request to the ERP.\",\n   \"id\": \"REQ-14\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-7\",\n    \"I-30\"\n   ]\n  },\n  {\n   \"acceptance\": [\n    {\n     \"given\": \"a stock import that failed on missing headers\",\n     \"id\": \"AC-15.1\",\n     \"level\": \"job\",\n     \"then\": \"The returned latest import has status Failed with its error message, and an audit row 'ERP import failed' exists\",\n     \"when\": \"an admin calls GET /admin/imports\"\n    }\n   ],\n   \"ears\": \"When a stock import finishes, the portal shall show its status and counts on the System/Import status screen and write an 'ERP import succeeded' or 'ERP import failed' audit record.\",\n   \"id\": \"REQ-15\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"ASM-17\",\n    \"ASM-47\",\n    \"I-19\"\n   ]\n  },\n  {\n   \"acceptance\": [\n    {\n     \"given\": \"a buyer of Customer A and order 77 belonging to Customer B\",\n     \"id\": \"AC-16.1\",\n     \"level\": \"api\",\n     \"then\": \"Both response statuses are 404 and the responses contain no Customer B data\",\n     \"when\": \"the buyer calls GET /orders/77 and GET /invoices/{B's invoice id}\"\n    }\n   ],\n   \"ears\": \"If a customer user requests an order, invoice, address, price, user or account record belonging to another customer, then the portal shall return status 404 without the record's data.\",\n   \"id\": \"REQ-16\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-12\",\n    \"I-11\",\n    \"I-39\"\n   ]\n  },\n  {\n   \"acceptance\": [\n    {\n     \"given\": \"users U1 and U2 of Customer A each placed one order and Customer B has one order\",\n     \"id\": \"AC-17.1\",\n     \"level\": \"api\",\n     \"then\": \"The returned list contains exactly U1's and U2's orders\",\n     \"when\": \"U1 calls GET /orders\"\n    }\n   ],\n   \"ears\": \"When a customer user lists orders or invoices, the portal shall return all records of that user's customer company and no others.\",\n   \"id\": \"REQ-17\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"Q-8\",\n    \"I-12\",\n    \"I-29\"\n   ]\n  },\n  {\n   \"acceptance\": [\n    {\n     \"given\": \"an unauthenticated client, a customer user and a staff user\",\n     \"id\": \"AC-18.1\",\n     \"level\": \"api\",\n     \"then\": \"The response statuses are 401, 403 and 403 respectively\",\n     \"when\": \"each calls POST /admin/products\"\n    }\n   ],\n   \"ears\": \"If a user calls an endpoint outside their role (customer calling staff or admin endpoints, staff calling admin endpoints, or an unauthenticated caller), then the portal shall reject the request server-side with status 401 for unauthenticated and 403 otherwise.\",\n   \"id\": \"REQ-18\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-11\",\n    \"ASM-21\",\n    \"I-23\"\n   ]\n  },\n  {\n   \"acceptance\": [\n    {\n     \"given\": \"a known email with wrong password and an unknown email\",\n     \"id\": \"AC-19.1\",\n     \"level\": \"api\",\n     \"then\": \"Both response statuses are 401 with an identical error message\",\n     \"when\": \"each is submitted to POST /auth/sign-in\"\n    }\n   ],\n   \"ears\": \"If sign-in fails for any reason, then the portal shall return the same generic invalid-credentials error message without revealing whether the email exists.\",\n   \"id\": \"REQ-19\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"ASM-1\",\n    \"ASM-3\",\n    \"ASM-38\",\n    \"ASM-40\",\n    \"I-14\"\n   ]\n  },\n  {\n   \"acceptance\": [\n    {\n     \"given\": \"a reset token issued 61 minutes ago\",\n     \"id\": \"AC-20.1\",\n     \"level\": \"api\",\n     \"then\": \"The response status is 400 with error code 'link_expired' and the password is unchanged\",\n     \"when\": \"it is submitted to POST /auth/reset-password\"\n    }\n   ],\n   \"ears\": \"If a password-reset link older than its configured lifetime (default 1 hour) or an invitation older than its configured lifetime (default 7 days) is used, then the portal shall reject it with an expired-link error.\",\n   \"id\": \"REQ-20\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"ASM-25\",\n    \"I-11\",\n    \"I-24\"\n   ]\n  },\n  {\n   \"acceptance\": [\n    {\n     \"given\": \"the database is made unavailable\",\n     \"id\": \"AC-21.1\",\n     \"level\": \"api\",\n     \"then\": \"The response status is 500 and the body contains a message and reference id but no stack trace, SQL or file paths\",\n     \"when\": \"a client calls GET /orders\"\n    }\n   ],\n   \"ears\": \"If an unexpected server error occurs, then the portal shall return a generic error message with a reference id and no stack trace or internal details.\",\n   \"id\": \"REQ-21\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-14\"\n   ]\n  },\n  {\n   \"acceptance\": [\n    {\n     \"given\": \"order 42 in status Received\",\n     \"id\": \"AC-22.1\",\n     \"level\": \"api\",\n     \"then\": \"The response status is 409 and order 42's status field is still Received\",\n     \"when\": \"staff requests status Picking\"\n    }\n   ],\n   \"ears\": \"If an order status change is requested other than Received→Confirmed→Picking→Out for Delivery→Delivered or a permitted cancellation, then the portal shall reject it with status 409.\",\n   \"id\": \"REQ-22\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-20\",\n    \"Q-4\",\n    \"I-40\"\n   ]\n  },\n  {\n   \"acceptance\": [\n    {\n     \"given\": \"order 1 in Received and order 2 in Confirmed\",\n     \"id\": \"AC-23.1\",\n     \"level\": \"api\",\n     \"then\": \"Order 1 response is 200 with status Cancelled; order 2 response is 409 and its status stays Confirmed\",\n     \"when\": \"the customer calls POST /orders/{id}/cancel for each\"\n    }\n   ],\n   \"ears\": \"When a customer cancels an order, the portal shall set it to Cancelled only if its status is Received and otherwise reject the cancellation with status 409.\",\n   \"id\": \"REQ-23\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-20\",\n    \"I-29\",\n    \"I-34\",\n    \"I-41\"\n   ]\n  },\n  {\n   \"acceptance\": [\n    {\n     \"given\": \"order 1 in Confirmed and order 2 in Picking\",\n     \"id\": \"AC-24.1\",\n     \"level\": \"api\",\n     \"then\": \"Order 1 status field is Cancelled; order 2 response status is 409\",\n     \"when\": \"staff calls POST /staff/orders/{id}/reject for each\"\n    }\n   ],\n   \"ears\": \"When staff reject or cancel an order, the portal shall set it to Cancelled only if its status is Received or Confirmed and otherwise reject with status 409.\",\n   \"id\": \"REQ-24\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"ASM-18\",\n    \"I-20\"\n   ]\n  },\n  {\n   \"acceptance\": [\n    {\n     \"given\": \"order 42 in Out for Delivery\",\n     \"id\": \"AC-25.1\",\n     \"level\": \"api\",\n     \"then\": \"Order 42 status is Delivered and one invoice row linked to order 42 has status Unpaid\",\n     \"when\": \"staff sets it to Delivered\"\n    },\n    {\n     \"given\": \"invoice creation is forced to fail\",\n     \"id\": \"AC-25.2\",\n     \"level\": \"api\",\n     \"then\": \"The response is an error, order 42 status field is still Out for Delivery and no invoice row exists\",\n     \"when\": \"staff sets order 42 to Delivered\"\n    }\n   ],\n   \"ears\": \"When staff save an order as Delivered, the portal shall create a linked Unpaid invoice in the same transaction so that either both are saved or neither is.\",\n   \"id\": \"REQ-25\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"Q-3\",\n    \"Q-4\",\n    \"I-21\",\n    \"I-29\",\n    \"I-42\"\n   ]\n  },\n  {\n   \"acceptance\": [\n    {\n     \"given\": \"payment term 30 days, Unpaid invoices dated 31 and 29 days ago, and a Paid invoice dated 40 days ago\",\n     \"id\": \"AC-26.1\",\n     \"level\": \"job\",\n     \"then\": \"Only the 31-day invoice record's status is Overdue; the others are unchanged\",\n     \"when\": \"the overdue job runs\"\n    }\n   ],\n   \"ears\": \"When the daily overdue job runs, the portal shall mark Overdue every Unpaid invoice whose invoice date plus the system-wide payment term (default 30 days) has passed.\",\n   \"id\": \"REQ-26\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"Q-2\",\n    \"ASM-42\",\n    \"I-21\",\n    \"I-24\"\n   ]\n  },\n  {\n   \"acceptance\": [\n    {\n     \"given\": \"an Overdue invoice\",\n     \"id\": \"AC-27.1\",\n     \"level\": \"api\",\n     \"then\": \"The invoice record has status Paid, payment date 2026-03-10 and the staff user; a second mark-paid call returns status 409\",\n     \"when\": \"staff calls POST /staff/invoices/{id}/mark-paid with date 2026-03-10\"\n    }\n   ],\n   \"ears\": \"When staff mark an Unpaid or Overdue invoice paid, the portal shall record status Paid, the payment date and the staff user, and shall reject any status change of a Paid invoice with status 409.\",\n   \"id\": \"REQ-27\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"Q-5\",\n    \"ASM-43\",\n    \"I-21\",\n    \"I-29\"\n   ]\n  },\n  {\n   \"acceptance\": [\n    {\n     \"given\": \"invoice 9 of Customer A with 2 lines\",\n     \"id\": \"AC-28.1\",\n     \"level\": \"api\",\n     \"then\": \"The response status is 200, content type is application/pdf and the file text contains the invoice number and both line totals\",\n     \"when\": \"a Customer A user calls GET /invoices/9/pdf\"\n    }\n   ],\n   \"ears\": \"When an authorised user downloads an invoice PDF, the portal shall return a PDF rendered from the stored invoice record showing tax-exclusive line prices and no tax lines.\",\n   \"id\": \"REQ-28\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-26\",\n    \"ASM-41\",\n    \"ASM-50\",\n    \"I-25\"\n   ]\n  },\n  {\n   \"acceptance\": [\n    {\n     \"given\": \"no holidays configured\",\n     \"id\": \"AC-29.1\",\n     \"level\": \"unit\",\n     \"then\": \"The returned dates are Wed, Thu and Tue respectively\",\n     \"when\": \"the delivery-date calculation is called for Tue 13:59, Tue 14:00 and Sat 10:00\"\n    }\n   ],\n   \"ears\": \"When a customer submits an order, the portal shall set the earliest delivery date to the next working day if submitted on a working day before the configured cut-off (default 14:00 business time), and otherwise to the second working day, where working days are Monday–Friday excluding configured public holidays.\",\n   \"id\": \"REQ-29\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"ASM-49\",\n    \"ASM-20\",\n    \"I-29\",\n    \"I-34\",\n    \"I-43\"\n   ]\n  },\n  {\n   \"acceptance\": [\n    {\n     \"given\": \"Customer A on Price List A with Product X at 10.00 and an order placed at 10.00\",\n     \"id\": \"AC-30.1\",\n     \"level\": \"api\",\n     \"then\": \"The product response price is 12.00 and the order line price value is 10.00\",\n     \"when\": \"Price List A changes X to 12.00 and the customer calls GET /products/X and GET /orders/{id}\"\n    }\n   ],\n   \"ears\": \"When a customer views a product or places an order, the portal shall use the price from the customer's assigned price list and shall keep the placed order's line prices unchanged after later price-list changes.\",\n   \"id\": \"REQ-30\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-29\",\n    \"I-34\",\n    \"I-44\"\n   ]\n  },\n  {\n   \"acceptance\": [\n    {\n     \"given\": \"Product X with stock 2\",\n     \"id\": \"AC-31.1\",\n     \"level\": \"api\",\n     \"then\": \"The response status is 201 and the order record has status Received with quantity 5\",\n     \"when\": \"the customer submits an order for 5 of X\"\n    }\n   ],\n   \"ears\": \"When a customer submits an order with a quantity above the imported stock, the portal shall accept the order in status Received.\",\n   \"id\": \"REQ-31\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"Q-6\",\n    \"I-29\"\n   ]\n  },\n  {\n   \"acceptance\": [\n    {\n     \"given\": \"a basket just submitted as order 42\",\n     \"id\": \"AC-32.1\",\n     \"level\": \"api\",\n     \"then\": \"The response status is 409 and the customer's order count is unchanged\",\n     \"when\": \"the same basket submit request is sent again\"\n    }\n   ],\n   \"ears\": \"If a basket that has already been turned into an order is submitted again, then the portal shall reject the submission with status 409 without creating another order.\",\n   \"id\": \"REQ-32\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"ASM-2\",\n    \"I-23\",\n    \"I-33\"\n   ]\n  },\n  {\n   \"acceptance\": [\n    {\n     \"given\": \"a previous order with products X (now 12.00) and Y (retired)\",\n     \"id\": \"AC-33.1\",\n     \"level\": \"api\",\n     \"then\": \"The returned basket contains X at 12.00 and not Y, and the response notice field lists Y\",\n     \"when\": \"the customer calls POST /orders/{id}/repeat\"\n    }\n   ],\n   \"ears\": \"When a customer repeats an order or loads a saved basket template, the portal shall add the items at current price-list prices, skip retired products and return a notice listing skipped products.\",\n   \"id\": \"REQ-33\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"ASM-24\",\n    \"I-29\",\n    \"I-23\"\n   ]\n  },\n  {\n   \"acceptance\": [\n    {\n     \"given\": \"order 1 in Received and order 2 in Confirmed\",\n     \"id\": \"AC-34.1\",\n     \"level\": \"api\",\n     \"then\": \"Order 1 response is 200 with the new quantity; order 2 response status is 409\",\n     \"when\": \"staff change a line quantity on each\"\n    }\n   ],\n   \"ears\": \"If staff edit an order whose status is not Received, then the portal shall reject the edit with status 409.\",\n   \"id\": \"REQ-34\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-29\",\n    \"I-20\"\n   ]\n  },\n  {\n   \"acceptance\": [\n    {\n     \"given\": \"an admin user\",\n     \"id\": \"AC-35.1\",\n     \"level\": \"api\",\n     \"then\": \"Both response statuses are 400 with a validation error message\",\n     \"when\": \"they upload an 11 MB JPEG and a 1 MB .exe as product images\"\n    }\n   ],\n   \"ears\": \"If an uploaded file is not an image or PDF or exceeds 10 MB, then the portal shall reject the upload with status 400.\",\n   \"id\": \"REQ-35\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"ASM-30\",\n    \"I-11\",\n    \"I-25\"\n   ]\n  },\n  {\n   \"acceptance\": [\n    {\n     \"given\": \"each listed screen opened at 360 px, 768 px and 1280 px widths\",\n     \"id\": \"AC-36.1\",\n     \"level\": \"manual\",\n     \"then\": \"The task completes with no horizontal scrolling or clipped controls\",\n     \"when\": \"a tester completes the screen's main task\"\n    }\n   ],\n   \"ears\": \"The portal shall provide the listed customer, staff and admin screens, each usable at 360 px viewport width as well as tablet and desktop widths in the latest two versions of Chrome, Edge, Safari and Firefox.\",\n   \"id\": \"REQ-36\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-9\",\n    \"I-17\",\n    \"I-18\",\n    \"I-19\",\n    \"ASM-28\",\n    \"I-22\",\n    \"I-45\"\n   ]\n  },\n  {\n   \"acceptance\": [\n    {\n     \"given\": \"a customer with no orders and an empty basket\",\n     \"id\": \"AC-37.1\",\n     \"level\": \"manual\",\n     \"then\": \"Each screen shows its empty-state message instead of a blank list\",\n     \"when\": \"a tester opens My orders and Basket\"\n    }\n   ],\n   \"ears\": \"While a list or search has no results, the portal shall display an empty-state message specific to that list (search results, basket, orders, invoices, templates, products, report results).\",\n   \"id\": \"REQ-37\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-15\"\n   ]\n  },\n  {\n   \"acceptance\": [\n    {\n     \"given\": \"network throttled to slow 3G\",\n     \"id\": \"AC-38.1\",\n     \"level\": \"manual\",\n     \"then\": \"A loading indicator is shown and the submit button cannot be pressed again until the confirmation screen appears\",\n     \"when\": \"a tester submits an order\"\n    }\n   ],\n   \"ears\": \"While a catalogue, search, basket, checkout, order submission, invoice download, report or staff queue request is in progress, the portal shall display a loading indicator and keep the order submit button disabled until the submission completes.\",\n   \"id\": \"REQ-38\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-16\",\n    \"ASM-39\"\n   ]\n  },\n  {\n   \"acceptance\": [\n    {\n     \"given\": \"a merged change\",\n     \"id\": \"AC-39.1\",\n     \"level\": \"manual\",\n     \"then\": \"The change is deployed to staging then production, and the http request is redirected to https\",\n     \"when\": \"the pipeline runs and a tester requests the production URL over http\"\n    }\n   ],\n   \"ears\": \"The portal shall be deployable through the build pipeline to separate staging and production environments in one cloud region of the client's account, serving production only over HTTPS.\",\n   \"id\": \"REQ-39\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-32\",\n    \"ASM-31\",\n    \"ASM-32\",\n    \"I-10\",\n    \"I-13\",\n    \"I-31\",\n    \"I-35\"\n   ]\n  }\n ]\n}\n</artifact>\n\nReview the spec."}