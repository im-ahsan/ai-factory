<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Lot weights - Feedlot</title>
  <!-- Google Fonts: Hanken Grotesk, Source Sans 3, IBM Plex Mono -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&family=Source+Sans+3:wght@400;500;600&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    /* Design System exact colors and styles */
    :root {
      --bg-page: #F4F3EF;
      --bg-surface: #FFFFFF;
      --text-main: #262A2D;
      --text-quieter: #626A6F;
      --border-rule: #D9DAD7;
      --primary-accent: #526F82;
      --status-good: #356A55;
      --status-waiting: #986321;
      --status-refused: #B4473C;
    }

    body {
      background-color: var(--bg-page);
      color: var(--text-main);
      font-family: 'Source Sans 3', sans-serif;
      font-size: 14px;
      line-height: 1.5;
      margin: 0;
      padding: 0;
      -webkit-font-smoothing: antialiased;
    }

    h1, h2, h3, .font-heading {
      font-family: 'Hanken Grotesk', sans-serif;
    }

    .font-mono-num {
      font-family: 'IBM Plex Mono', monospace;
    }

    /* Motion Tokens & Keyframes (CSS only, no JS) */
    @keyframes entranceFadeUp {
      0% {
        opacity: 0;
        transform: translateY(6px);
      }
      100% {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes rollDigit {
      0% {
        opacity: 0;
        transform: translateY(0.65em);
      }
      100% {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes breatheDot {
      0%, 100% {
        transform: scale(1);
        opacity: 0.84;
      }
      50% {
        transform: scale(1.03);
        opacity: 1;
      }
    }

    .animate-entrance {
      animation: entranceFadeUp 0.35s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    .roll-digit {
      display: inline-block;
      animation: rollDigit 600ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    .roll-d-1 { animation-delay: 0ms; }
    .roll-d-2 { animation-delay: 35ms; }
    .roll-d-3 { animation-delay: 70ms; }
    .roll-d-4 { animation-delay: 105ms; }
    .roll-d-5 { animation-delay: 140ms; }

    .sync-breathe {
      animation: breatheDot 8s cubic-bezier(0.65, 0, 0.35, 1) infinite;
    }

    /* Touch controls and inputs */
    input, select, textarea, button {
      font-family: 'Source Sans 3', sans-serif;
    }

    .field-control {
      background-color: #FFFFFF;
      border: 1px solid var(--border-rule);
      border-radius: 6px;
      min-height: 44px;
      padding: 0.5rem 0.875rem;
      color: var(--text-main);
      font-size: 14px;
      transition: border-color 0.15s ease, box-shadow 0.15s ease;
      outline: none;
    }

    .field-control:hover {
      border-color: #B4B7B4;
    }

    .field-control:focus {
      border-color: var(--primary-accent);
      box-shadow: 0 0 0 2px var(--primary-accent);
    }

    .btn-primary {
      background-color: var(--primary-accent);
      color: #FFFFFF;
      border-radius: 6px;
      min-height: 44px;
      padding: 0 1.25rem;
      font-weight: 600;
      font-size: 14px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      transition: background-color 0.15s ease, transform 0.08s ease;
      border: none;
      cursor: pointer;
    }

    .btn-primary:hover {
      background-color: #435b6b;
    }

    .btn-primary:focus {
      outline: none;
      box-shadow: 0 0 0 2px var(--primary-accent);
    }

    .btn-primary:active {
      transform: scale(0.98);
    }

    /* Section divider rules */
    .section-hairline {
      height: 1px;
      background-color: var(--border-rule);
      width: 100%;
    }

    @media (prefers-reduced-motion: reduce) {
      *, ::before, ::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
        scroll-behavior: auto !important;
      }
    }
  </style>
</head>
<body class="min-h-screen flex flex-col">

  <!-- Shared Header -->
  <header class="bg-white border-b border-[#D9DAD7] sticky top-0 z-30">
    <div class="max-w-[1440px] mx-auto px-6 h-14 flex items-center justify-between">
      <!-- Left: Logo & Nav -->
      <div class="flex items-center space-x-8">
        <a href="#" class="flex items-center space-x-2 text-[#262A2D] focus:outline-none focus:ring-2 focus:ring-[#526F82] rounded">
          <div class="w-6 h-6 bg-[#526F82] rounded flex items-center justify-center text-white font-heading font-semibold text-xs leading-none">
            F
          </div>
          <span class="font-heading font-bold text-base tracking-tight">Feedlot</span>
        </a>

        <!-- Shared nav items in exact order -->
        <nav class="flex items-center space-x-6 text-[13px] font-medium">
          <a href="#" class="text-[#626A6F] hover:text-[#262A2D] py-4 transition-colors">Overview</a>
          <a href="#" class="text-[#626A6F] hover:text-[#262A2D] py-4 transition-colors">Lots</a>
          <a href="#" class="text-[#626A6F] hover:text-[#262A2D] py-4 transition-colors">Inventory</a>
          <a href="#" class="text-[#626A6F] hover:text-[#262A2D] py-4 transition-colors">Rations</a>
          <a href="#" class="text-[#626A6F] hover:text-[#262A2D] py-4 transition-colors">Feeding plans</a>
          <a href="#" class="text-[#626A6F] hover:text-[#262A2D] py-4 transition-colors">Feeding log</a>
          <a href="#" class="text-[#262A2D] font-semibold py-4 border-b-2 border-[#526F82]">Lot weights</a>
          <a href="#" class="text-[#626A6F] hover:text-[#262A2D] py-4 transition-colors">Yard summary</a>
          <a href="#" class="text-[#626A6F] hover:text-[#262A2D] py-4 transition-colors">Feed-to-Gain</a>
        </nav>
      </div>

      <!-- Right: User Avatar & Name/Role -->
      <div class="flex items-center space-x-3">
        <div class="w-8 h-8 rounded-full bg-[#E5E7EB] text-[#262A2D] flex items-center justify-center font-heading font-semibold text-xs">
          MC
        </div>
        <div class="text-left">
          <div class="text-xs font-semibold text-[#262A2D] leading-tight">Mara Chen</div>
          <div class="text-[11px] text-[#626A6F] leading-tight">Feed Operations, Administrator</div>
        </div>
      </div>
    </div>
  </header>

  <!-- Main Content Container -->
  <main class="flex-1 max-w-[1440px] w-full mx-auto px-6 py-7 animate-entrance">
    
    <!-- One Heading -->
    <div class="mb-7">
      <h1 class="text-[28px] leading-[34px] font-semibold text-[#262A2D]">Lot weights</h1>
      <div class="mt-2 text-sm text-[#626A6F] flex items-center gap-2">
        <span>Lot <strong class="text-[#262A2D] font-semibold">L-241</strong> · Angus steers · Pen 4 (64 head)</span>
        <span class="text-[#D9DAD7]">|</span>
        <span class="inline-flex items-center gap-1.5 text-xs font-mono-num text-[#626A6F]">
          <span class="w-1.5 h-1.5 rounded-full bg-[#356A55] sync-breathe inline-block"></span>
          America/Denver · Apr 17, 2025
        </span>
      </div>
    </div>

    <!-- Section: Weight History & Restrained Trend -->
    <section class="mb-7">
      <div class="flex items-baseline justify-between mb-3">
        <h2 class="text-[22px] leading-[28px] font-semibold text-[#262A2D]">Recorded weight history</h2>
        <div class="text-xs text-[#626A6F]">
          Market target: <span class="font-mono-num font-semibold text-[#262A2D]">1,350 lb</span> · Latest measured: <span class="font-mono-num font-semibold text-[#262A2D]">987 lb</span>
        </div>
      </div>
      <div class="section-hairline mb-6"></div>

      <!-- Compact table and restrained trend summary panel -->
      <div class="bg-white rounded-[8px] border border-[#D9DAD7] p-6 mb-7">
        
        <!-- Restrained Trend Visual / KPI Bar -->
        <div class="grid grid-cols-1 lg:grid-cols-4 gap-6 pb-6 border-b border-[#D9DAD7] mb-6 items-center">
          <div>
            <div class="text-xs text-[#626A6F] uppercase tracking-wider mb-1">Latest Recorded Average</div>
            <div class="flex items-baseline space-x-1">
              <span class="text-[28px] font-semibold text-[#262A2D] font-heading overflow-hidden leading-none">
                <span class="roll-digit roll-d-1">9</span>
                <span class="roll-digit roll-d-2">8</span>
                <span class="roll-digit roll-d-3">7</span>
              </span>
              <span class="text-base font-semibold text-[#626A6F]">lb</span>
            </div>
            <div class="text-xs text-[#626A6F] mt-1 font-mono-num">+205 lb total gain (99 DOF)</div>
          </div>

          <div>
            <div class="text-xs text-[#626A6F] uppercase tracking-wider mb-1">Measured Daily Gain</div>
            <div class="text-[24px] font-semibold text-[#262A2D] font-mono-num leading-none">2.07 <span class="text-sm font-normal text-[#626A6F]">lb/day</span></div>
            <div class="text-xs text-[#626A6F] mt-1">Weighted yard standard: <span class="font-mono-num">1.94 lb/day</span></div>
          </div>

          <!-- Restrained Minimal Sparkline / Trend visualization -->
          <div class="lg:col-span-2 flex flex-col justify-center">
            <div class="flex justify-between items-center text-xs text-[#626A6F] mb-1.5">
              <span>Weight Trajectory (4 weigh events)</span>
              <span class="font-mono-num text-[#262A2D]">782 lb &rarr; 987 lb</span>
            </div>
            <div class="w-full bg-[#F4F3EF] rounded h-8 px-3 flex items-center relative border border-[#D9DAD7]">
              <!-- SVG Sparkline Line -->
              <svg class="w-full h-5 overflow-visible" preserveAspectRatio="none" viewBox="0 0 300 20">
                <polyline fill="none" stroke="#526F82" stroke-width="2" points="10,18 95,11 185,6 290,1" />
                <circle cx="10" cy="18" r="3" fill="#526F82" />
                <circle cx="95" cy="11" r="3" fill="#526F82" />
                <circle cx="185" cy="6" r="3" fill="#526F82" />
                <circle cx="290" cy="1" r="3.5" fill="#356A55" />
              </svg>
            </div>
            <div class="flex justify-between items-center text-[11px] text-[#626A6F] mt-1 font-mono-num">
              <span>Jan 8 (782 lb)</span>
              <span>Feb 19 (870 lb)</span>
              <span>Mar 19 (932 lb)</span>
              <span class="text-[#262A2D] font-semibold">Apr 16 (987 lb)</span>
            </div>
          </div>
        </div>

        <!-- Compact Dated History Table -->
        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse">
            <thead>
              <tr class="border-b border-[#D9DAD7] text-xs font-semibold text-[#626A6F]">
                <th class="py-3 px-4 font-normal">RECORDED DATE</th>
                <th class="py-3 px-4 font-normal">AVERAGE WEIGHT</th>
                <th class="py-3 px-4 font-normal">MEASURED HEAD COUNT</th>
                <th class="py-3 px-4 font-normal">RECORDER</th>
                <th class="py-3 px-4 font-normal">RESULT</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-[#D9DAD7]">
              <!-- Normal state: Luis Ortega's Apr 16 measurement row -->
              <tr class="h-11 hover:bg-[#F4F3EF] transition-colors">
                <td class="py-2.5 px-4 font-mono-num text-[#262A2D]">Apr 16, 2025 · 07:10</td>
                <td class="py-2.5 px-4 font-mono-num font-semibold text-[#262A2D]">987 lb</td>
                <td class="py-2.5 px-4 font-mono-num text-[#262A2D]">64</td>
                <td class="py-2.5 px-4 text-[#262A2D]">Luis Ortega</td>
                <td class="py-2.5 px-4 text-[#262A2D]">
                  <span class="inline-flex items-center gap-1.5">
                    <span class="w-1.5 h-1.5 rounded-full bg-[#356A55]"></span>
                    <span>accepted</span>
                  </span>
                </td>
              </tr>
              <!-- Mar 19 -->
              <tr class="h-11 hover:bg-[#F4F3EF] transition-colors">
                <td class="py-2.5 px-4 font-mono-num text-[#262A2D]">Mar 19, 2025 · 07:00</td>
                <td class="py-2.5 px-4 font-mono-num font-semibold text-[#262A2D]">932 lb</td>
                <td class="py-2.5 px-4 font-mono-num text-[#262A2D]">64</td>
                <td class="py-2.5 px-4 text-[#262A2D]">Luis Ortega</td>
                <td class="py-2.5 px-4 text-[#262A2D]">
                  <span class="inline-flex items-center gap-1.5">
                    <span class="w-1.5 h-1.5 rounded-full bg-[#356A55]"></span>
                    <span>accepted</span>
                  </span>
                </td>
              </tr>
              <!-- Feb 19 -->
              <tr class="h-11 hover:bg-[#F4F3EF] transition-colors">
                <td class="py-2.5 px-4 font-mono-num text-[#262A2D]">Feb 19, 2025 · 07:00</td>
                <td class="py-2.5 px-4 font-mono-num font-semibold text-[#262A2D]">870 lb</td>
                <td class="py-2.5 px-4 font-mono-num text-[#262A2D]">64</td>
                <td class="py-2.5 px-4 text-[#262A2D]">Luis Ortega</td>
                <td class="py-2.5 px-4 text-[#262A2D]">
                  <span class="inline-flex items-center gap-1.5">
                    <span class="w-1.5 h-1.5 rounded-full bg-[#356A55]"></span>
                    <span>accepted</span>
                  </span>
                </td>
              </tr>
              <!-- Jan 8 -->
              <tr class="h-11 hover:bg-[#F4F3EF] transition-colors">
                <td class="py-2.5 px-4 font-mono-num text-[#262A2D]">Jan 8, 2025 · 08:20</td>
                <td class="py-2.5 px-4 font-mono-num font-semibold text-[#262A2D]">782 lb</td>
                <td class="py-2.5 px-4 font-mono-num text-[#262A2D]">64</td>
                <td class="py-2.5 px-4 text-[#262A2D]">Luis Ortega</td>
                <td class="py-2.5 px-4 text-[#262A2D]">
                  <span class="inline-flex items-center gap-1.5">
                    <span class="w-1.5 h-1.5 rounded-full bg-[#356A55]"></span>
                    <span>accepted</span>
                  </span>
                </td>
              </tr>
            </tbody>
          </table>
        </div>

      </div>
    </section>

    <!-- Section: Touch-Friendly Entry Form -->
    <section>
      <div class="flex items-baseline justify-between mb-3">
        <h2 class="text-[22px] leading-[28px] font-semibold text-[#262A2D]">Record lot weight</h2>
        <div class="text-xs text-[#626A6F]">
          Local yard date: <span class="font-mono-num text-[#262A2D]">Apr 17, 2025</span> · America/Denver
        </div>
      </div>
      <div class="section-hairline mb-6"></div>

      <!-- Touch-friendly Entry Card -->
      <div class="bg-white rounded-[8px] border border-[#D9DAD7] p-6 max-w-[840px]">
        <form onsubmit="return false;" class="space-y-6">
          
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <!-- Lot -->
            <div>
              <label for="lot-select" class="block text-xs font-semibold text-[#262A2D] mb-1.5">
                Lot
              </label>
              <select id="lot-select" class="field-control w-full appearance-none bg-no-repeat bg-[right_0.875rem_center] cursor-pointer" style="background-image: url('data:image/svg+xml;charset=US-ASCII,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20width%3D%2212%22%20height%3D%228%22%20viewBox%3D%220%200%2012%208%22%3E%3Cpath%20fill%3D%22%23262A2D%22%20d%3D%22M1.41%200L6%204.58L10.59%200L12%201.41l-6%206-6-6z%22%2F%3E%3C%2Fsvg%3E');">
                <option value="L-241" selected>L-241 (Angus steers · Pen 4 · 64 head)</option>
                <option value="L-242">L-242 (Angus heifers · Pen 4 · 32 head)</option>
                <option value="L-243">L-243 (Hereford steers · Pen 7 · 82 head)</option>
              </select>
            </div>

            <!-- Measurement date -->
            <div>
              <label for="measurement-date" class="block text-xs font-semibold text-[#262A2D] mb-1.5">
                Measurement date
              </label>
              <input type="date" id="measurement-date" value="2025-04-17" class="field-control w-full font-mono-num">
            </div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <!-- Average weight retaining entered units -->
            <div>
              <label for="avg-weight" class="block text-xs font-semibold text-[#262A2D] mb-1.5">
                Average weight
              </label>
              <div class="relative flex items-center">
                <input type="text" id="avg-weight" value="987" class="field-control w-full font-mono-num pr-14 text-base" placeholder="e.g. 987">
                <div class="absolute right-3.5 text-sm font-semibold text-[#626A6F] pointer-events-none">
                  lb
                </div>
              </div>
              <p class="text-[11px] text-[#626A6F] mt-1 font-mono-num">Retained unit: lb (pound as-measured)</p>
            </div>

            <!-- Head count -->
            <div>
              <label for="head-count" class="block text-xs font-semibold text-[#262A2D] mb-1.5">
                Head count
              </label>
              <input type="number" id="head-count" value="64" class="field-control w-full font-mono-num text-base" placeholder="64">
              <p class="text-[11px] text-[#626A6F] mt-1">Active lot count: <span class="font-mono-num">64 head</span> in Pen 4</p>
            </div>
          </div>

          <!-- Notes -->
          <div>
            <label for="notes" class="block text-xs font-semibold text-[#262A2D] mb-1.5">
              Notes
            </label>
            <textarea id="notes" rows="3" class="field-control w-full resize-y text-sm" placeholder="Observation notes, chute conditions, or scale check..."></textarea>
          </div>

          <!-- Single primary action: Save weight -->
          <div class="pt-2 flex items-center">
            <button type="submit" class="btn-primary">
              Save weight
            </button>
          </div>

        </form>
      </div>
    </section>

  </main>

</body>
</html>
