> {\n            const on = matches(i.route, path);\n            return <Link key={i.route} to={hrefFor(i.route)} aria-current={on ? \"page\" : undefined} className={cn(\"rounded-md px-2 py-1.5 text-sm hover:bg-muted\", on && \"bg-muted font-medium text-foreground\", !on && \"text-muted-foreground\")}>{t(i.label)}</Link>;\n          })}\n        </div>\n      ))}\n    </nav>\n  );\n}\n\nexport function AppFrame({ product, apps, children }: { product: string; apps: FrameApp[]; children: ReactNode }) {\n  const t = useT();\n  const { path } = useNav();\n  const app = apps.find((a) => a.routes.some((r) => matches(r, path))) ?? apps[0]!;\n  const name = apps.length > 1 ? app.name : product;\n  const side = (\n    <div className=\"grid content-start gap-4\">\n      <Brand name={name} />\n      {app.switcher && <SwitcherMenu s={app.switcher} />}\n      <NavList items={app.nav} path={path} vertical />\n/**\n * Generated by orval v7.21.0 🍺\n * Do not edit manually.\n * Feedlot Operations API\n * Shared API contract for the responsive Feedlot web application and API implementation.\n * OpenAPI spec version: 1.0.0\n */\nimport type {\n  AccountList,\n  AccountRequest,\n  AccountResult,\n  AccountUpdateRequest,\n  BadRequestResponse,\n  CandidateActionRequest,\n  CandidateActionResult,\n  CandidateAssignRequest,\n  CandidateList,\n  ConflictResponse,\n  DemoFlowRequest,\n  DemoFlowResult,\n  DemoMaterials,\n  ExportFeedToGainReportParams,\n  FeedToGainReport,\n  FeedingActivityList,\n  FeedingActivityRequest,\n  FeedingActivityResult,\n  FeedingPlanList,\n  FeedingPlanRequest,\n  FeedingPlanResult,\n  ForbiddenResponse,\n  GetFeedToGainReportParams,\n  InventoryList,\n  InventoryProjections,\n  InventoryReceiptRequest,\n  InventoryReceiptResult,\n  Lifecycle,\n  ListWeightMeasurementsParams,\n  LotFinancials,\n  LotList,\n  LotPerformance,\n  NotFoundResponse,\n  OptimizationRequest,\n  Overview,\n  RationList,\n  RationRequest,\n  RationResult,\n  ServerErrorResponse,\n  Session,\n  SignInRequest,\n  SyncResult,\n  UnauthorizedResponse,\n  UnavailableResponse,\n  ValidationErrorResponse,\n  WeightMeasurementList,\n  WeightMeasurementRequest,\n  WeightMeasurementResult,\n  YardSummary\n} from './client.schemas';\n\n\n/**\n * @summary Sign in with an administrator-managed account.\n */\nexport type signInResponse200 = {\n  data: Session\n  status: 200\n}\n\nexport type signInResponse400 = {\n  data: BadRequestResponse\n  status: 400\n}\n\nexport type signInResponse401 = {\n  data: UnauthorizedResponse\n  status: 401\n}\n\nexport type signInResponse403 = {\n  data: ForbiddenResponse\n  status: 403\n}\n\nexport type signInResponse503 = {\n  data: UnavailableResponse\n  status: 503\n}\n    \nexport type signInResponseSuccess = (signInResponse200) & {\n  headers: Headers;\n};\nexport type signInResponseError = (signInResponse400 | signInResponse401 | signInResponse403 | signInResponse503) & {\n  headers: Headers;\n};\n\nexport type signInResponse = (signInResponseSuccess | signInResponseError)\n\nexport const getSignInUrl = () => {\n\n\n  \n\n  return `http://localhost:5080/api/v1/auth/sign-in`\n}\n\nexport const signIn = async (signInRequest: SignInRequest, options?: RequestInit): Promise<signInResponse> => {\n  \n  const res = await fetch(getSignInUrl(),\n  {      \n    ...options,\n    method: 'POST',\n    headers: { 'Content-Type': 'application/json', ...options?.headers },\n    body: JSON.stringify(\n      signInRequest,)\n  }\n)\n\n  const body = [204, 205, 304].includes(res.status) ? null : await res.text();\n  \n  const data: signInResponse['data'] = body ? JSON.parse(body) : {}\n","chars":14200,"exitCode":0}
