: \"A ration's ingredients have costs entered in different supported weight units\",\n     \"id\": \"AC-7.2\",\n     \"level\": \"ui\",\n     \"then\": \"The screen shows the calculated cost in USD per pound and retains the entered units for display\",\n     \"when\": \"The user opens the ration cost details\"\n    }\n   ],\n   \"ears\": \"The Feedlot web app shall allow users to create and view rations with ingredient proportions, nutritional values, intended animal or weight range, and calculated cost per pound using normalized calculation units while retaining entered units for display.\",\n   \"id\": \"REQ-7\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-4\",\n    \"ASM-2\"\n   ],\n   \"stability\": 1\n  },\n  {\n   \"acceptance\": [\n    {\n     \"given\": \"A user has entered nutrition or animal-range constraints and candidate mixes are returned\",\n     \"id\": \"AC-8.1\",\n     \"level\": \"ui\",\n     \"then\": \"The screen shows each candidate's ingredient proportions, cost, and trade-offs without marking it saved or assigned\",\n     \"when\": \"The user requests and views candidate mixes\"\n    },\n    {\n     \"given\": \"An optimization candidate is displayed\",\n     \"id\": \"AC-8.2\",\n     \"level\": \"ui\",\n     \"then\": \"The screen shows the returned candidate as saved or assigned only after the action is accepted\",\n     \"when\": \"The user selects save or assign and that action is accepted\"\n    }\n   ],\n   \"ears\": \"When a user submits nutrition or animal-range constraints for ration optimization, the Feedlot web app shall display candidate ingredient mixes with costs and trade-offs and require an explicit save or assign action before a candidate is saved, assigned, or used.\",\n   \"id\": \"REQ-8\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-4\",\n    \"Q-1\"\n   ],\n   \"stability\": 1\n  },\n  {\n   \"acceptance\": [\n    {\n     \"given\": \"A pen plan uses a bunk rate of 25 pounds per animal per day and a planned a