<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Inventory Projections — Feedlot</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@500;600;700&family=IBM+Plex+Mono:wght@400;500;600&family=Source+Sans+3:wght@400;500;600&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    /* CSS Tokens & Strict Colors */
    :root {
      --bg-page: #F4F3EF;
      --bg-panel: #FFFFFF;
      --text-main: #262A2D;
      --text-quiet: #626A6F;
      --border-color: #D9DAD7;
      --primary-color: #526F82;
      --status-good: #356A55;
      --status-waiting: #986321;
      --status-failed: #B4473C;
    }

    body {
      background-color: var(--bg-page);
      color: var(--text-main);
      font-family: 'Source Sans 3', sans-serif;
      margin: 0;
      padding: 0;
      -webkit-font-smoothing: antialiased;
    }

    .font-hanken {
      font-family: 'Hanken Grotesk', sans-serif;
    }

    .font-mono-num {
      font-family: 'IBM Plex Mono', monospace;
      font-feature-settings: "tnum" 1;
    }

    /* Motion Tokens */
    @keyframes entranceFadeUp {
      0% {
        opacity: 0;
        transform: translateY(8px);
      }
      100% {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes digitRoll {
      0% {
        opacity: 0;
        transform: translateY(0.65em);
      }
      100% {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes ambientBreathe {
      0%, 100% {
        transform: scale(1);
        opacity: 0.84;
      }
      50% {
        transform: scale(1.03);
        opacity: 1;
      }
    }

    .animate-entrance {
      animation: entranceFadeUp 320ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    .digit-roll {
      display: inline-block;
      animation: digitRoll 600ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    .digit-roll-1 { animation-delay: 0ms; }
    .digit-roll-2 { animation-delay: 35ms; }
    .digit-roll-3 { animation-delay: 70ms; }
    .digit-roll-4 { animation-delay: 105ms; }
    .digit-roll-5 { animation-delay: 140ms; }
    .digit-roll-6 { animation-delay: 175ms; }
    .digit-roll-7 { animation-delay: 210ms; }

    /* Interactive States */
    .control-transition {
      transition: background-color 140ms ease, border-color 140ms ease, color 140ms ease, box-shadow 140ms ease, transform 90ms ease;
    }

    .control-transition:hover {
      opacity: 0.92;
    }

    .control-transition:focus-visible {
      outline: none;
      box-shadow: 0 0 0 2px var(--primary-color);
    }

    .control-transition:active {
      transform: scale(0.98);
    }

    @media (prefers-reduced-motion: reduce) {
      .animate-entrance,
      .digit-roll,
      .control-transition {
        animation: none !important;
        transition: none !important;
        transform: none !important;
        opacity: 1 !important;
      }
    }
  </style>
</head>
<body class="min-h-screen flex flex-col">

