<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Demo — Feedlot</title>
  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@600&family=IBM+Plex+Mono:wght@400;500;600&family=Source+Sans+3:wght@400;500;600&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    /* Design Tokens */
    :root {
      --bg-page: #F4F3EF;
      --bg-panel: #FFFFFF;
      --text-main: #262A2D;
      --text-quiet: #626A6F;
      --border-color: #D9DAD7;
      --primary-color: #526F82;
      --status-good: #356A55;
      --status-waiting: #986321;
      --status-failed: #B4473C;
    }

    body {
      background-color: var(--bg-page);
      color: var(--text-main);
      font-family: 'Source Sans 3', sans-serif;
      font-size: 14px;
      line-height: 1.6;
      margin: 0;
      padding: 0;
    }

    h1, h2, h3, .font-heading {
      font-family: 'Hanken Grotesk', sans-serif;
      font-weight: 600;
    }

    .font-mono {
      font-family: 'IBM Plex Mono', monospace;
    }

    /* Motion Tokens */
    @keyframes entranceFadeUp {
      from {
        opacity: 0;
        transform: translateY(8px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes digitRoll {
      from {
        opacity: 0;
        transform: translateY(0.65em);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes liveBreathe {
      0%, 100% {
        transform: scale(1);
        opacity: 0.84;
      }
      50% {
        transform: scale(1.03);
        opacity: 1;
      }
    }

    .animate-entrance {
      animation: entranceFadeUp 0.4s cubic-bezier(0.16, 1, 0.3, 1) backwards;
    }

    .digit-roll {
      display: inline-block;
      animation: digitRoll 600ms cubic-bezier(0.16, 1, 0.3, 1) backwards;
    }

    .digit-roll:nth-child(1) { animation-delay: 0ms; }
    .digit-roll:nth-child(2) { animation-delay: 35ms; }
    .digit-roll:nth-child(3) { animation-delay: 70ms; }
    .digit-roll:nth-child(4) { animation-delay: 105ms; }
    .digit-roll:nth-child(5) { animation-delay: 140ms; }

    .sync-live-dot {
      animation: liveBreathe 8s cubic-bezier(0.65, 0, 0.35, 1) infinite;
    }

    /* Interactive States */
    .btn-primary {
      background-color: var(--primary-color);
      color: #FFFFFF;
      height: 44px;
      padding: 0 24px;
      border-radius: 6px;
      font-family: 'Source Sans 3', sans-serif;
      font-weight: 600;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      transition: background-color 0.16s ease, transform 0.09s ease;
      cursor: pointer;
      border: none;
    }
    .btn-primary:hover {
      background-color: #435b6c;
    }
    .btn-primary:active {
      transform: scale(0.97);
    }
    .btn-primary:focus-visible {
      outline: 2px solid var(--primary-color);
      outline-offset: 2px;
    }

    .nav-item {
      font-family: 'Source Sans 3', sans-serif;
      font-size: 14px;
      font-weight: 500;
      color: var(--text-main);
      padding: 18px 0;
      text-decoration: none;
      transition: color 0.16s ease;
      position: relative;
    }
    .nav-item:hover {
      color: var(--primary-color);
    }
    .nav-item:focus-visible {
      outline: 2px solid var(--primary-color);
      outline-offset: 4px;
    }

    /* Typography hierarchy */
    h1 {
      font-size: 28px;
      line-height: 1.25;
      font-weight: 600;
    }
    h2 {
      font-size: 22px;
      line-height: 1.35;
      font-weight: 600;
    }
    h3 {
      font-size: 16px;
      line-height: 1.45;
      font-weight: 600;
    }

    .section-separator {
      margin-top: 28px;
      margin-bottom: 24px;
      border-bottom: 1px solid var(--border-color);
      padding-bottom: 8px;
    }

    @media (prefers-reduced-motion: reduce) {
      .animate-entrance,
      .digit-roll,
      .sync-live-dot {
        animation: none !important;
        transform: none !important;
        opacity: 1 !important;
      }
      .btn-primary {
        transition: none !important;
      }
    }
  </style>
</head>
<body class="min-h-screen">

  <!-- Header -->
  <header style="background-color: var(--bg-panel); border-bottom: 1px solid var(--border-color);" class="w-full">
    <div class="max-w-[1440px] mx-auto px-6 h-14 flex items-center justify-between">
      <!-- Left: Brand & Nav -->
      <div class="flex items-center space-x-8">
        <div class="flex items-center space-x-2">
          <!-- Small square grain mark with white F -->
          <div style="background-color: var(--primary-color);" class="w-6 h-6 rounded flex items-center justify-center">
            <span class="text-white font-heading font-semibold text-xs leading-none">F</span>
          </div>
          <span class="font-heading font-semibold text-lg tracking-tight" style="color: var(--text-main);">Feedlot</span>
        </div>

        <nav class="hidden md:flex items-center space-x-6">
          <a href="#" class="nav-item">Overview</a>
          <a href="#" class="nav-item">Lots</a>
          <a href="#" class="nav-item">Inventory</a>
          <a href="#" class="nav-item">Rations</a>
          <a href="#" class="nav-item">Feeding plans</a>
          <a href="#" class="nav-item">Feeding log</a>
          <a href="#" class="nav-item">Lot weights</a>
          <a href="#" class="nav-item">Yard summary</a>
          <a href="#" class="nav-item">Feed-to-Gain</a>
        </nav>
      </div>

      <!-- Right: User Avatar initials & Name/Role -->
      <div class="flex items-center space-x-3">
        <div style="background-color: #E2E4DE; color: var(--text-main);" class="w-8 h-8 rounded-full flex items-center justify-center font-heading font-semibold text-xs">
          MC
        </div>
        <div class="flex flex-col text-left">
          <span class="text-xs font-semibold leading-tight" style="color: var(--text-main);">Mara Chen</span>
          <span class="text-xs leading-tight" style="color: var(--text-quiet);">Feed Operations, Administrator</span>
        </div>
      </div>
    </div>
  </header>

  <!-- Main Content -->
  <main class="max-w-[1440px] mx-auto px-6 py-7">

    <!-- Page Heading -->
    <div class="flex items-center justify-between mb-6">
      <h1 style="color: var(--text-main);">Demo</h1>
      <button class="btn-primary">
        Start demo flow
      </button>
    </div>

    <!-- Intro / Demo Flow Sequence -->
    <div class="animate-entrance" style="background-color: var(--bg-panel); border: 1px solid var(--border-color); border-radius: 8px; padding: 24px;">
      <div class="flex flex-col md:flex-row md:items-baseline md:justify-between mb-4 pb-3" style="border-bottom: 1px solid var(--border-color);">
        <div>
          <h2 style="color: var(--text-main);">Guided Demo Sequence</h2>
          <p style="color: var(--text-quiet);" class="mt-1">Sequential walk-through demonstrating operational yard lifecycle tracking for North Yard using verified sample records.</p>
        </div>
        <div class="mt-2 md:mt-0 text-xs font-mono" style="color: var(--text-quiet);">
          Local date: Apr 17, 2025 · America/Denver
        </div>
      </div>

      <!-- Flow steps -->
      <div class="grid grid-cols-1 md:grid-cols-7 gap-3 mt-4">
        <div class="p-3 rounded flex flex-col justify-between" style="background-color: var(--bg-page); border: 1px solid var(--border-color);">
          <div>
            <div class="font-mono text-xs font-semibold" style="color: var(--primary-color);">01 · SYNC</div>
            <div class="font-semibold text-sm mt-1" style="color: var(--text-main);">Sync Purchase Orders</div>
            <p class="text-xs mt-1" style="color: var(--text-quiet);">Ingest PO-5817 &amp; PO-5831; reject unverified PO-5842.</p>
          </div>
          <div class="mt-3 flex items-center text-xs">
            <span class="w-2 h-2 rounded-full mr-1.5" style="background-color: var(--status-good);"></span>
            <span style="color: var(--text-main);">good</span>
          </div>
        </div>

        <div class="p-3 rounded flex flex-col justify-between" style="background-color: var(--bg-page); border: 1px solid var(--border-color);">
          <div>
            <div class="font-mono text-xs font-semibold" style="color: var(--primary-color);">02 · TRACE</div>
            <div class="font-semibold text-sm mt-1" style="color: var(--text-main);">Trace L-241 to Pen 4</div>
            <p class="text-xs mt-1" style="color: var(--text-quiet);">64 Angus steers allocated at $89,600 purchase cost.</p>
          </div>
          <div class="mt-3 flex items-center text-xs">
            <span class="w-2 h-2 rounded-full mr-1.5" style="background-color: var(--status-good);"></span>
            <span style="color: var(--text-main);">good</span>
          </div>
        </div>

        <div class="p-3 rounded flex flex-col justify-between" style="background-color: var(--bg-page); border: 1px solid var(--border-color);">
          <div>
            <div class="font-mono text-xs font-semibold" style="color: var(--primary-color);">03 · LIFECYCLE</div>
            <div class="font-semibold text-sm mt-1" style="color: var(--text-main);">Inspect Lifecycle</div>
            <p class="text-xs mt-1" style="color: var(--text-quiet);">99 DOF, ADG 2.07 lb/day, projected ship Oct 9, 2025.</p>
          </div>
          <div class="mt-3 flex items-center text-xs">
            <span class="w-2 h-2 rounded-full mr-1.5" style="background-color: var(--status-good);"></span>
            <span style="color: var(--text-main);">good</span>
          </div>
        </div>

        <div class="p-3 rounded flex flex-col justify-between" style="background-color: var(--bg-page); border: 1px solid var(--border-color);">
          <div>
            <div class="font-mono text-xs font-semibold" style="color: var(--primary-color);">04 · RATION</div>
            <div class="font-semibold text-sm mt-1" style="color: var(--text-main);">Review Finisher 18</div>
            <p class="text-xs mt-1" style="color: var(--text-quiet);">70% corn, 20% hay, 7% meal, 3% premix ($0.1254/lb).</p>
          </div>
          <div class="mt-3 flex items-center text-xs">
            <span class="w-2 h-2 rounded-full mr-1.5" style="background-color: var(--status-good);"></span>
            <span style="color: var(--text-main);">good</span>
          </div>
        </div>

        <div class="p-3 rounded flex flex-col justify-between" style="background-color: var(--bg-page); border: 1px solid var(--border-color);">
          <div>
            <div class="font-mono text-xs font-semibold" style="color: var(--primary-color);">05 · PLAN</div>
            <div class="font-semibold text-sm mt-1" style="color: var(--text-main);">Complete Feeding Plan</div>
            <p class="text-xs mt-1" style="color: var(--text-quiet);">Apr 17 Pen 4 actual 1,776 lb (+48 lb variance), accepted.</p>
          </div>
          <div class="mt-3 flex items-center text-xs">
            <span class="w-2 h-2 rounded-full mr-1.5" style="background-color: var(--status-good);"></span>
            <span style="color: var(--text-main);">good</span>
          </div>
        </div>

        <div class="p-3 rounded flex flex-col justify-between" style="background-color: var(--bg-page); border: 1px solid var(--border-color);">
          <div>
            <div class="font-mono text-xs font-semibold" style="color: var(--primary-color);">06 · SCALE</div>
            <div class="font-semibold text-sm mt-1" style="color: var(--text-main);">Enter Lot Weight</div>
            <p class="text-xs mt-1" style="color: var(--text-quiet);">Apr 16 weigh event 987 lb recorded by Luis Ortega.</p>
          </div>
          <div class="mt-3 flex items-center text-xs">
            <span class="w-2 h-2 rounded-full mr-1.5" style="background-color: var(--status-good);"></span>
            <span style="color: var(--text-main);">good</span>
          </div>
        </div>

        <div class="p-3 rounded flex flex-col justify-between" style="background-color: var(--bg-page); border: 1px solid var(--border-color);">
          <div>
            <div class="font-mono text-xs font-semibold" style="color: var(--primary-color);">07 · ANALYTICS</div>
            <div class="font-semibold text-sm mt-1" style="color: var(--text-main);">Compare Feed-to-Gain</div>
            <p class="text-xs mt-1" style="color: var(--text-quiet);">FCR 8.69 vs yard weighted average 8.80 F:G.</p>
          </div>
          <div class="mt-3 flex items-center text-xs">
            <span class="w-2 h-2 rounded-full mr-1.5" style="background-color: var(--status-good);"></span>
            <span style="color: var(--text-main);">good</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Section 1: Proposed Solution & Headline Figures -->
    <div class="section-separator flex items-baseline justify-between">
      <h2>Proposed Solution</h2>
      <span class="text-xs" style="color: var(--text-quiet);">Workmanlike single-source operations architecture</span>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-7">
      <div style="background-color: var(--bg-panel); border: 1px solid var(--border-color); border-radius: 8px; padding: 20px;">
        <div class="text-xs uppercase tracking-wider font-semibold" style="color: var(--text-quiet);">Active Yard Population</div>
        <div class="mt-2 text-3xl font-heading font-semibold overflow-hidden" style="color: var(--text-main);">
          <span class="digit-roll">1</span><span class="digit-roll">7</span><span class="digit-roll">8</span>
          <span class="text-base font-normal" style="color: var(--text-quiet);">head</span>
        </div>
        <div class="mt-1 text-xs" style="color: var(--text-quiet);">3 lots across Pen 4 &amp; Pen 7 (230 cap, 52 free)</div>
      </div>

      <div style="background-color: var(--bg-panel); border: 1px solid var(--border-color); border-radius: 8px; padding: 20px;">
        <div class="text-xs uppercase tracking-wider font-semibold" style="color: var(--text-quiet);">Weighted Average ADG</div>
        <div class="mt-2 text-3xl font-heading font-semibold" style="color: var(--text-main);">
          <span class="font-mono">1.94</span>
          <span class="text-base font-normal" style="color: var(--text-quiet);">lb/day</span>
        </div>
        <div class="mt-1 text-xs" style="color: var(--text-quiet);">L-241 leading at 2.07 lb/day across 99 DOF</div>
      </div>

      <div style="background-color: var(--bg-panel); border: 1px solid var(--border-color); border-radius: 8px; padding: 20px;">
        <div class="text-xs uppercase tracking-wider font-semibold" style="color: var(--text-quiet);">Weighted Cost of Gain</div>
        <div class="mt-2 text-3xl font-heading font-semibold" style="color: var(--text-main);">
          <span class="font-mono">$1.13</span>
          <span class="text-base font-normal" style="color: var(--text-quiet);">/lb</span>
        </div>
        <div class="mt-1 text-xs" style="color: var(--text-quiet);">Yard FCR 8.80 · Finisher 18 benchmark $0.1254/lb</div>
      </div>

      <div style="background-color: var(--bg-panel); border: 1px solid var(--border-color); border-radius: 8px; padding: 20px;">
        <div class="text-xs uppercase tracking-wider font-semibold" style="color: var(--text-quiet);">Total Feed Expenditure</div>
        <div class="mt-2 text-3xl font-heading font-semibold" style="color: var(--text-main);">
          <span class="font-mono">$29,425.36</span>
        </div>
        <div class="mt-1 text-xs" style="color: var(--text-quiet);">Returned operational rollups across active pens</div>
      </div>
    </div>

    <div style="background-color: var(--bg-panel); border: 1px solid var(--border-color); border-radius: 8px; padding: 24px;" class="mb-7">
      <h3 style="color: var(--text-main);" class="mb-2">Operational Integrity &amp; Domain Boundaries</h3>
      <p style="color: var(--text-main);" class="mb-3">
        Feedlot replaces disconnected spreadsheets and siloed mill scales with a single web-based operational system of record. Every event links to verifiable procurement line items (PO-5817, PO-5831) and scales directly into pen-level bunk calls. Lot metrics (ADG, FCR, cost of gain, inventory rollups) are strictly returned as operational records from validated yard ledger services, eliminating client-side drift and math fabrication.
      </p>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 pt-2">
        <div class="p-3 rounded" style="background-color: var(--bg-page); border: 1px solid var(--border-color);">
          <div class="font-semibold text-sm" style="color: var(--text-main);">Procurement-to-Pen Traceability</div>
          <p class="text-xs mt-1" style="color: var(--text-quiet);">Direct linkage from vendor delivery receipts to pen occupancy and cohort identification, tracking headcount, weight upon arrival, and unit acquisition costs.</p>
        </div>
        <div class="p-3 rounded" style="background-color: var(--bg-page); border: 1px solid var(--border-color);">
          <div class="font-semibold text-sm" style="color: var(--text-main);">Bunk Call Execution &amp; Bunk Splits</div>
          <p class="text-xs mt-1" style="color: var(--text-quiet);">Daily feeding plans calculate as-fed bunk drops proportional to lot headcount (e.g., Pen 4 split 64:32 between L-241 and L-242) while capturing load scale variance.</p>
        </div>
        <div class="p-3 rounded" style="background-color: var(--bg-page); border: 1px solid var(--border-color);">
          <div class="font-semibold text-sm" style="color: var(--text-main);">Growth &amp; Stock Depletion Benchmarks</div>
          <p class="text-xs mt-1" style="color: var(--text-quiet);">Real scale weights establish measured daily gains to project slaughter readiness dates without speculative extrapolation, applying configured 4% wastage rates to feed stocks.</p>
        </div>
      </div>
    </div>

    <!-- Section 2: Architecture Diagram -->
    <div class="section-separator flex items-baseline justify-between">
      <h2>Architecture Diagram</h2>
      <div class="flex items-center text-xs" style="color: var(--text-quiet);">
        <span class="sync-live-dot inline-block w-2 h-2 rounded-full mr-2" style="background-color: var(--status-good);"></span>
        <span>Operational Sync Active</span>
      </div>
    </div>

    <!-- Quiet margin around diagram as requested -->
    <div class="my-6 p-8 rounded-lg" style="background-color: var(--bg-panel); border: 1px solid var(--border-color);">
      <div class="text-xs font-semibold uppercase tracking-wider mb-6 text-center" style="color: var(--text-quiet);">
        Core Pipeline: Feedlot Web App → Configured Mock Procurement/Receiving Source → API &amp; Operational Records
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 items-center max-w-4xl mx-auto">
        <!-- Node 1 -->
        <div class="p-5 rounded-lg text-center" style="background-color: var(--bg-page); border: 1px solid var(--border-color);">
          <div class="w-10 h-10 mx-auto mb-3 rounded flex items-center justify-center font-heading font-semibold text-white" style="background-color: var(--primary-color);">
            UI
          </div>
          <div class="font-heading font-semibold text-base" style="color: var(--text-main);">Feedlot Web App</div>
          <div class="text-xs mt-1" style="color: var(--text-quiet);">Responsive Desktop &amp; Mobile Client</div>
          <div class="mt-3 pt-3 border-t text-xs font-mono text-left space-y-1" style="border-color: var(--border-color); color: var(--text-quiet);">
            <div>• Role-based directory (MC, LO, NB)</div>
            <div>• Feeding plan calculator &amp; bunk split</div>
            <div>• Real-time weigh ticket validation</div>
          </div>
        </div>

        <!-- Flow Connector 1 to 2 -->
        <div class="hidden md:flex flex-col items-center justify-center">
          <span class="text-xs font-mono font-semibold mb-1" style="color: var(--primary-color);">REST / SYNC</span>
          <div class="w-full flex items-center">
            <div class="h-0.5 flex-1" style="background-color: var(--border-color);"></div>
            <div class="w-2 h-2 border-t-2 border-r-2 transform rotate-45 -ml-1" style="border-color: var(--primary-color);"></div>
          </div>
          <span class="text-xs mt-1" style="color: var(--text-quiet);">PO-5817, PO-5831</span>
        </div>

        <!-- Node 2 -->
        <div class="p-5 rounded-lg text-center" style="background-color: var(--bg-page); border: 1px solid var(--border-color);">
          <div class="w-10 h-10 mx-auto mb-3 rounded flex items-center justify-center font-heading font-semibold text-white" style="background-color: #3B5364;">
            SRC
          </div>
          <div class="font-heading font-semibold text-base" style="color: var(--text-main);">Configured Mock Source</div>
          <div class="text-xs mt-1" style="color: var(--text-quiet);">Procurement &amp; Receiving Endpoint</div>
          <div class="mt-3 pt-3 border-t text-xs font-mono text-left space-y-1" style="border-color: var(--border-color); color: var(--text-quiet);">
            <div>• Prairie Creek PO-5817 line 2 (96 head)</div>
            <div>• Mesa Range PO-5831 line 1 (82 head)</div>
            <div>• Reject PO-5842 (zero qty guard)</div>
          </div>
        </div>
      </div>

      <!-- Arrow down to Records -->
      <div class="flex justify-center my-4">
        <div class="flex flex-col items-center">
          <div class="w-0.5 h-6" style="background-color: var(--border-color);"></div>
          <div class="w-2 h-2 border-b-2 border-r-2 transform rotate-45 -mt-1" style="border-color: var(--primary-color);"></div>
        </div>
      </div>

      <!-- Node 3: Database & API Records -->
      <div class="max-w-2xl mx-auto p-5 rounded-lg" style="background-color: var(--bg-page); border: 1px solid var(--border-color);">
        <div class="flex items-center space-x-3 mb-3">
          <div class="w-8 h-8 rounded flex items-center justify-center font-heading font-semibold text-white text-xs" style="background-color: #2F4250;">
            API
          </div>
          <div>
            <div class="font-heading font-semibold text-base" style="color: var(--text-main);">API &amp; Operational Records Service</div>
            <div class="text-xs" style="color: var(--text-quiet);">Ledger of Truth · North Yard America/Denver Instance</div>
          </div>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 text-xs font-mono pt-2 border-t" style="border-color: var(--border-color); color: var(--text-quiet);">
          <div class="p-2 rounded bg-white">
            <span class="font-semibold block text-neutral-800">Cattle Lots</span>
            L-241 (64 hd), L-242 (32 hd), L-243 (82 hd)
          </div>
          <div class="p-2 rounded bg-white">
            <span class="font-semibold block text-neutral-800">Stock Inventory</span>
            32,032.0 lb dry basis (corn, hay, meal, premix)
