        </div>
        <div class="data-row">
          <span class="data-label">Received Date</span>
          <span class="data-value mono">Mar 1, 2025</span>
        </div>
        <div class="data-row">
          <span class="data-label">Breed &amp; Sex</span>
          <span class="data-value">Hereford steers</span>
        </div>
        <div class="data-row">
          <span class="data-label">Received Head</span>
          <span class="data-value mono">82</span>
        </div>
        <div class="data-row">
          <span class="data-label">Pen Cap / Count</span>
          <span class="data-value mono">82 / 110 <span class="quieter">(28 free)</span></span>
        </div>
        <div class="data-row">
          <span class="data-label">Purchase Cost Allocation</span>
          <span class="data-value mono" style="font-weight: 600;">$119,720</span>
        </div>
      </div>

      <div class="lot-card-actions">
        <a href="#lifecycle-l243" class="btn-action">Lifecycle</a>
        <a href="#performance-l243" class="btn-action">Performance</a>
        <a href="#financials-l243" class="btn-action">Financials</a>
      </div>
    </article>

  </main>

</body>
</html>