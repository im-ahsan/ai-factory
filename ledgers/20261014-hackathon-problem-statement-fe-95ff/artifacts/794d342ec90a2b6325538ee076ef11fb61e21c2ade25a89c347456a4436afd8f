<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Lots - Feedlot</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@600&family=IBM+Plex+Mono:wght@400;500;600&family=Source+Sans+3:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      background-color: #F4F3EF;
      color: #262A2D;
      font-family: 'Source Sans 3', sans-serif;
      font-size: 14px;
      line-height: 1.5;
      min-height: 100vh;
      -webkit-font-smoothing: antialiased;
    }

    h1, h2, h3 {
      font-family: 'Hanken Grotesk', sans-serif;
      font-weight: 600;
      color: #262A2D;
    }

    h1 {
      font-size: 28px;
      line-height: 1.2;
    }

    h2 {
      font-size: 22px;
      line-height: 1.25;
    }

    h3 {
      font-size: 16px;
      line-height: 1.3;
    }

    .mono {
      font-family: 'IBM Plex Mono', monospace;
    }

    .quieter {
      color: #626A6F;
    }

    /* Motion Tokens & Keyframes */
    @keyframes entranceFadeUp {
      from {
        opacity: 0;
        transform: translateY(8px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes digitRoll {
      from {
        transform: translateY(0.65em);
        opacity: 0.2;
      }
      to {
        transform: translateY(0);
        opacity: 1;
      }
    }

    @keyframes syncBreathe {
      0%, 100% {
        transform: scale(1);
        opacity: 0.84;
      }
      50% {
        transform: scale(1.03);
        opacity: 1;
      }
    }

    .animate-entrance {
      animation: entranceFadeUp 400ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    .digit-roll-wrap {
      display: inline-flex;
      overflow: hidden;
      vertical-align: baseline;
      line-height: 1;
    }

    .digit-roll {
      display: inline-block;
      animation: digitRoll 600ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    .digit-roll.d-1 { animation-delay: 0ms; }
    .digit-roll.d-2 { animation-delay: 35ms; }
    .digit-roll.d-3 { animation-delay: 70ms; }

    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
        scroll-behavior: auto !important;
      }
      .digit-roll {
        transform: none !important;
        opacity: 1 !important;
      }
    }

    /* Interactive Elements: States */
    button, a {
      transition: background-color 160ms ease, border-color 160ms ease, color 160ms ease, transform 80ms ease;
    }

    button:focus-visible, a:focus-visible {
      outline: 2px solid #526F82;
      outline-offset: 2px;
    }

    button:active, a:active {
      transform: scale(0.98);
    }

    /* Primary & Outlined Buttons */
    .btn-action {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      height: 44px;
      padding: 0 16px;
      font-family: 'Source Sans 3', sans-serif;
      font-size: 14px;
      font-weight: 500;
      border-radius: 6px;
      text-decoration: none;
      cursor: pointer;
      flex: 1;
      background: #FFFFFF;
      color: #262A2D;
      border: 1px solid #D9DAD7;
    }

    .btn-action:hover {
      background-color: #F4F3EF;
      border-color: #626A6F;
    }

    /* Layout structure */
    .app-header {
      background-color: #FFFFFF;
      border-bottom: 1px solid #D9DAD7;
      padding: 0 16px;
      height: 60px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      position: sticky;
      top: 0;
      z-index: 20;
    }

    .brand-group {
      display: flex;
      align-items: center;
      gap: 10px;
      text-decoration: none;
      color: #262A2D;
    }

    .brand-mark {
      width: 28px;
      height: 28px;
      background-color: #526F82;
      border-radius: 4px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #FFFFFF;
      font-family: 'Hanken Grotesk', sans-serif;
      font-size: 15px;
      font-weight: 600;
      flex-shrink: 0;
    }

    .brand-name {
      font-family: 'Hanken Grotesk', sans-serif;
      font-size: 18px;
      font-weight: 600;
      letter-spacing: -0.2px;
    }

    .header-right {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .user-profile {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .avatar-initials {
      width: 32px;
      height: 32px;
      border-radius: 50%;
      background: #D9DAD7;
      color: #262A2D;
      font-family: 'Source Sans 3', sans-serif;
      font-weight: 600;
      font-size: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    .menu-btn {
      width: 44px;
      height: 44px;
      background: transparent;
      border: 1px solid #D9DAD7;
      border-radius: 6px;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      color: #262A2D;
    }

    .menu-btn:hover {
      background-color: #F4F3EF;
    }

    /* Main Container */
    .main-content {
      padding: 24px 16px 40px;
      max-width: 460px;
      margin: 0 auto;
    }

    /* Section divider line */
    .section-hairline {
      height: 1px;
      background-color: #D9DAD7;
      margin-top: 8px;
      margin-bottom: 24px;
      border: none;
    }

    /* Status Dot */
    .status-indicator {
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }

    .status-dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      display: inline-block;
      flex-shrink: 0;
    }

    .status-good {
      background-color: #356A55;
    }

    .status-waiting {
      background-color: #986321;
    }

    .status-failed {
      background-color: #B4473C;
    }

    /* Stacked Record Card (Phone View of dense table) */
    .lot-card {
      background-color: #FFFFFF;
      border: 1px solid #D9DAD7;
      border-radius: 8px;
      margin-bottom: 16px;
      overflow: hidden;
    }

    .lot-card-header {
      padding: 16px;
      background-color: #FFFFFF;
      border-bottom: 1px solid #D9DAD7;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .lot-badge {
      font-family: 'Hanken Grotesk', sans-serif;
      font-size: 18px;
      font-weight: 600;
      color: #262A2D;
    }

    .card-body {
      padding: 12px 16px;
    }

    .data-row {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      padding: 7px 0;
      border-bottom: 1px solid #F4F3EF;
      font-size: 13.5px;
    }

    .data-row:last-child {
      border-bottom: none;
    }

    .data-label {
      color: #626A6F;
      flex-shrink: 0;
    }

    .data-value {
      text-align: right;
      font-weight: 500;
      color: #262A2D;
    }

    .lot-card-actions {
      padding: 12px 16px;
      background-color: #FFFFFF;
      border-top: 1px solid #D9DAD7;
      display: flex;
      gap: 8px;
    }

    /* Summary Bar */
    .lead-metric-bar {
      display: flex;
      align-items: baseline;
      gap: 8px;
      margin-bottom: 20px;
    }

    .lead-metric-number {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 24px;
      font-weight: 600;
      color: #262A2D;
    }

    .lead-metric-sub {
      font-size: 14px;
      color: #262A2D;
    }
  </style>
</head>
<body>

  <!-- Shared Application Header -->
  <header class="app-header">
    <a href="#" class="brand-group" aria-label="Feedlot Home">
      <div class="brand-mark">F</div>
      <span class="brand-name">Feedlot</span>
    </a>

    <div class="header-right">
      <div class="user-profile">
        <div class="avatar-initials" title="Mara Chen — Feed Operations, Administrator">MC</div>
      </div>
      <button class="menu-btn" aria-label="Navigation menu" type="button">
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="#262A2D" stroke-width="1.75" stroke-linecap="round">
          <line x1="3" y1="5" x2="17" y2="5"></line>
          <line x1="3" y1="10" x2="17" y2="10"></line>
          <line x1="3" y1="15" x2="17" y2="15"></line>
        </svg>
      </button>
    </div>
  </header>

  <!-- Main Container -->
  <main class="main-content">

    <!-- Page Title -->
    <h1>Lots</h1>
    <div class="section-hairline"></div>

    <!-- Compact Lead Line with Roll Motion on Digits -->
    <div class="lead-metric-bar animate-entrance">
      <div class="lead-metric-number">
        <span class="digit-roll-wrap"><span class="digit-roll d-1">1</span></span><span class="digit-roll-wrap"><span class="digit-roll d-2">7</span></span><span class="digit-roll-wrap"><span class="digit-roll d-3">8</span></span>
      </div>
      <div class="lead-metric-sub">
        head across <span class="mono" style="font-weight: 600;">3</span> active lots
      </div>
    </div>

    <!-- Stacked Labeled Records (Mobile adaptation of dense table) -->
    
    <!-- Record 1: L-241 -->
    <article class="lot-card animate-entrance">
      <div class="lot-card-header">
        <div>
          <span class="quieter" style="font-size: 11px; text-transform: uppercase; letter-spacing: 0.5px; display: block;">Lot Identifier</span>
          <span class="lot-badge mono">L-241</span>
        </div>
        <div style="text-align: right;">
          <span class="quieter" style="font-size: 11px; text-transform: uppercase; letter-spacing: 0.5px; display: block;">Pen Location</span>
