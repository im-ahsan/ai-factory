        </div>
        <div class="data-row">
          <span class="data-label">Breed &amp; Sex</span>
          <span class="data-value">Angus steers</span>
        </div>
        <div class="data-row">
          <span class="data-label">Received Head</span>
          <span class="data-value mono">64</span>
        </div>
        <div class="data-row">
          <span class="data-label">Pen Cap / Count</span>
          <span class="data-value mono">96 / 120 <span class="quieter">(24 free)</span></span>
        </div>
        <div class="data-row">
          <span class="data-label">Purchase Cost Allocation</span>
          <span class="data-value mono" style="font-weight: 600;">$89,600</span>
        </div>
      </div>

      <div class="lot-card-actions">
        <a href="#lifecycle-l241" class="btn-action">Lifecycle</a>
        <a href="#performance-l241" class="btn-action">Performance</a>
        <a href="#financials-l241" class="btn-action">Financials</a>
      </div>
    </article>

    <!-- Record 2: L-242 -->
    <article class="lot-card animate-entrance">
      <div class="lot-card-header">
        <div>
          <span class="quieter" style="font-size: 11px; text-transform: uppercase; letter-spacing: 0.5px; display: block;">Lot Identifier</span>
          <span class="lot-badge mono">L-242</span>
        </div>
        <div style="text-align: right;">
          <span class="quieter" style="font-size: 11px; text-transform: uppercase; letter-spacing: 0.5px; display: block;">Pen Location</span>
          <span class="mono" style="font-weight: 600; font-size: 15px;">Pen 4</span>
        </div>
      </div>

      <div class="card-body">
        <div class="data-row">
          <span class="data-label">Source PO &amp; Line</span>
          <span class="data-value mono">PO-5817 line 2</span>
        </div>
        <div class="data-row">
          <span class="data-label">Supplier</span>
          <span class="data-value">Prairie Creek Cattle Co.</span>
        </div>
        <div class="data-row">
          <span class="data-label">Received Date</span>
          <span class="data-value mono">Jan 8, 2025</span>
        </div>
        <div class="data-row">
          <span class="data-label">Breed &amp; Sex</span>
          <span class="data-value">Angus heifers</span>
        </div>
        <div class="data-row">
          <span class="data-label">Received Head</span>
          <span class="data-value mono">32</span>
        </div>
        <div class="data-row">
          <span class="data-label">Pen Cap / Count</span>
          <span class="data-value mono">96 / 120 <span class="quieter">(24 free)</span></span>
        </div>
        <div class="data-row">
          <span class="data-label">Purchase Cost Allocation</span>
          <span class="data-value mono" style="font-weight: 600;">$44,800</span>
        </div>
      </div>

      <div class="lot-card-actions">
        <a href="#lifecycle-l242" class="btn-action">Lifecycle</a>
        <a href="#performance-l242" class="btn-action">Performance</a>
        <a href="#financials-l242" class="btn-action">Financials</a>
      </div>
    </article>

    <!-- Record 3: L-243 -->
    <article class="lot-card animate-entrance">
      <div class="lot-card-header">
        <div>
          <span class="quieter" style="font-size: 11px; text-transform: uppercase; letter-spacing: 0.5px; display: block;">Lot Identifier</span>
          <span class="lot-badge mono">L-243</span>
        </div>
        <div style="text-align: right;">
          <span class="quieter" style="font-size: 11px; text-transform: uppercase; letter-spacing: 0.5px; display: block;">Pen Location</span>
          <span class="mono" style="font-weight: 600; font-size: 15px;">Pen 7</span>
        </div>
      </div>

      <div class="card-body">
        <div class="data-row">
          <span class="data-label">Source PO &amp; Line</span>
          <span class="data-value mono">PO-5831 line 1</span>
        </div>
        <div class="data-row">
          <span class="data-label">Supplier</span>
