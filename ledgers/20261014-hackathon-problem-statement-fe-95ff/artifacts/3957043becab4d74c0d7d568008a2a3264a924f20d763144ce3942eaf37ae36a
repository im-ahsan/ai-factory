{"ts":1791996233471,"kind":"call","tool":"Bash","input":"{\"command\":\"sed -n '1,220p' tests/acceptance.part2.test.tsx && sed -n '220,520p' tests/acceptance.part2.test.tsx\"}","output":"// @vitest-environment jsdom\nimport { afterAll, afterEach, beforeAll, describe, expect, it, vi } from \"vitest\";\nimport { render, screen, within } from \"@testing-library/react\";\nimport userEvent from \"@testing-library/user-event\";\nimport { setupServer } from \"msw/node\";\nimport { at } from \"./support/screen\";\nimport {\n  feedlotOperationsAPIMock,\n  getAssignRationCandidateMockHandler,\n  getAssignRationCandidateResponseMock,\n  getCreateFeedingActivityMockHandler,\n  getCreateFeedingActivityResponseMock,\n  getCreateFeedingPlanMockHandler,\n  getCreateFeedingPlanResponseMock,\n  getCreateRationMockHandler,\n  getCreateRationResponseMock,\n  getGetInventoryProjectionsMockHandler,\n  getGetInventoryProjectionsResponseMock,\n  getListFeedingActivitiesMockHandler,\n  getListFeedingActivitiesResponseMock,\n  getListFeedingPlansMockHandler,\n  getListFeedingPlansResponseMock,\n  getListInventoryMockHandler,\n  getListInventoryResponseMock,\n  getListRationsMockHandler,\n  getListRationsResponseMock,\n  getOptimizeRationMockHandler,\n  getOptimizeRationResponseMock,\n  getSaveRationCandidateMockHandler,\n  getSaveRationCandidateResponseMock,\n} from \"@/lib/api/client.msw\";\nimport InventoryProjectionsContainer from \"@/components/screens/s-6/container\";\nimport RationsContainer from \"@/components/screens/s-7/container\";\nimport RationOptimizerContainer from \"@/components/screens/s-8/container\";\nimport FeedingPlansContainer from \"@/components/screens/s-9/container\";\nimport FeedingLogContainer from \"@/components/screens/s-10/container\";\n\nconst server = setupServer(...feedlotOperationsAPIMock);\n\nbeforeAll(() => server.listen({ onUnhandledRequest: \"error\" }));\nafterAll(() => server.close());\nafterEach(() => {\n  server.resetHandlers();\n  vi.restoreAllMocks();\n});\n\nfunction makeUser() {\n  return userEvent.setup({ advanceTimers: vi.advanceTimersByTime });\n}\n\nasync function enter(user: ReturnType<typeof makeUser>, label: string, value: string) {\n  const field = screen.getByLabelText(label);\n  await user.clear(field);\n  await user.type(field, value);\n}\n\nasync function choose(user: ReturnType<typeof makeUser>, label: string, optionName: string | RegExp) {\n  const field = screen.getByLabelText(label);\n  const option = within(field).getByRole(\"option\", { name: optionName });\n  await user.selectOptions(field, option);\n}\n\ndescribe(\"inventory projections\", () => {\n  it(\"AC_6_1_ShowsEveryProjectionHorizonAndWastageRatio\", async () => {\n    at(\"/inventory/projections\");\n    const response = getGetInventoryProjectionsResponseMock();\n    response.wastageRatio = 0.08;\n    response.projections = [{\n      ...response.projections[0],\n      dailyLb: 111,\n      weeklyLb: 777,\n      monthlyLb: 3333,\n      quarterlyLb: 9999,\n      sixMonthLb: 19998,\n      annualLb: 39996,\n    }];\n    server.use(getGetInventoryProjectionsMockHandler(response));\n\n    render(<InventoryProjectionsContainer />);\n\n    expect(await screen.findByRole(\"heading\", { name: \"Inventory projections\" })).toBeVisible();\n    expect(await screen.findByText(\"Ground corn\")).toBeVisible();\n    for (const estimate of [\"111\", \"777\", \"3333\", \"9999\", \"19998\", \"39996\"]) {\n      expect(screen.getByText(new RegExp(estimate))).toBeVisible();\n    }\n    expect(screen.getByText(/8%|0\\.08/)).toBeVisible();\n  });\n\n  it(\"AC_6_2_ShowsReturnedMovementsWithoutAWastageMovement\", async () => {\n    at(\"/inventory/projections\");\n    const response = getGetInventoryProjectionsResponseMock();\n    response.movements = [\n      { date: \"2026-04-12\", type: \"Receipt\", quantityLb: 5000 },\n      { date: \"2026-04-13\", type: \"Feed consumption\", quantityLb: 950 },\n      { date: \"2026-04-14\", type: \"Receipt\", quantityLb: 6500 },\n    ];\n    server.use(getGetInventoryProjectionsMockHandler(response));\n\n    render(<InventoryProjectionsContainer />);\n\n    expect(await screen.findAllByText(\"Receipt\")).toHaveLength(2);\n    expect(screen.getByText(\"Feed consumption\")).toBeVisible();\n    expect(screen.getByText(/5000/)).toBeVisible();\n    expect(screen.getByText(/950/)).toBeVisible();\n    expect(screen.getByText(/6500/)).toBeVisible();\n    expect(screen.queryByText(\"Wastage\")).not.toBeInTheDocument();\n  });\n});\n\ndescribe(\"rations\", () => {\n  it(\"AC_7_1_ShowsTheSavedRationsReturnedNutritionAndCost\", async () => {\n    at(\"/rations\");\n    const saved = getCreateRationResponseMock();\n    saved.ration.name = \"Finisher Mix\";\n    saved.ration.intendedAnimalRange = \"900-1200 lb cattle\";\n    saved.ration.dryMatterPercent = 91;\n    saved.ration.energyMcalPerLb = 1.61;\n    saved.ration.costUsdPerLb = 0.24;\n    saved.ration.ingredients = [{\n      name: \"Ground corn\",\n      quantity: 1000,\n      enteredUnit: \"lb\",\n      normalizedQuantityLb: 1000,\n      proportionPercent: 100,\n      unitCostUsdPerLb: 0.24,\n      totalCostUsd: 240,\n    }];\n    server.use(\n      getListInventoryMockHandler(getListInventoryResponseMock()),\n      getCreateRationMockHandler(saved),\n      getListRationsMockHandler({ rations: [saved.ration] }),\n    );\n\n    render(<RationsContainer />);\n    const user = makeUser();\n    await enter(user, \"Ration name\", \"Finisher Mix\");\n    await enter(user, \"Intended animal / weight range\", \"900-1200 lb cattle\");\n    await choose(user, \"Ingredient name\", \"Ground corn\");\n    await enter(user, \"Quantity\", \"1000\");\n    await choose(user, \"Entered unit\", \"lb\");\n    await enter(user, \"Proportion (%)\", \"100\");\n    const save = await screen.findByRole(\"button\", { name: \"Save ration\" });\n    await user.click(save);\n\n    expect(await screen.findByText(\"Finisher Mix\")).toBeVisible();\n    expect(screen.getByText(\"900-1200 lb cattle\")).toBeVisible();\n    expect(screen.getByText(\"Ground corn\")).toBeVisible();\n    expect(screen.getByText(/100%/)).toBeVisible();\n    expect(screen.getByText(/91%/)).toBeVisible();\n    expect(screen.getByText(/1\\.61/)).toBeVisible();\n    expect(screen.getByText(/0\\.24/)).toBeVisible();\n  });\n\n  it(\"AC_7_2_RetainsEnteredUnitsAndShowsCostsPerPound\", async () => {\n    at(\"/rations\");\n    const response = getListRationsResponseMock();\n    response.rations[0].ingredients = [\n      { name: \"Ground corn\", quantity: 1, enteredUnit: \"ton\", normalizedQuantityLb: 2000, proportionPercent: 50, unitCostUsdPerLb: 0.18, totalCostUsd: 360 },\n      { name: \"Alfalfa meal\", quantity: 25, enteredUnit: \"kg\", normalizedQuantityLb: 55.12, proportionPercent: 30, unitCostUsdPerLb: 0.32, totalCostUsd: 17.64 },\n      { name: \"Hay\", quantity: 20, enteredUnit: \"lb\", normalizedQuantityLb: 20, proportionPercent: 20, unitCostUsdPerLb: 0.12, totalCostUsd: 2.4 },\n    ];\n    response.rations[0].costUsdPerLb = 0.21;\n    server.use(getListRationsMockHandler(response));\n\n    render(<RationsContainer />);\n\n    const cornRow = (await screen.findByText(\"Ground corn\")).closest(\"tr\");\n    const alfalfaRow = screen.getByText(\"Alfalfa meal\").closest(\"tr\");\n    const hayRow = screen.getByText(\"Hay\").closest(\"tr\");\n    expect(cornRow).not.toBeNull();\n    expect(alfalfaRow).not.toBeNull();\n    expect(hayRow).not.toBeNull();\n    expect(within(cornRow as HTMLElement).getByText(\"ton\")).toBeVisible();\n    expect(within(alfalfaRow as HTMLElement).getByText(\"kg\")).toBeVisible();\n    expect(within(hayRow as HTMLElement).getByText(\"lb\")).toBeVisible();\n    expect(within(cornRow as HTMLElement).getByText(/0\\.18/)).toBeVisible();\n    expect(within(alfalfaRow as HTMLElement).getByText(/0\\.32/)).toBeVisible();\n    expect(within(hayRow as HTMLElement).getByText(/0\\.12/)).toBeVisible();\n    expect(screen.getByText(/0\\.21/)).toBeVisible();\n  });\n});\n\ndescribe(\"ration optimizer\", () => {\n  it(\"AC_8_1_ShowsEachOptimizationCandidateAndItsTradeOffs\", async () => {\n    at(\"/rations/optimize\");\n    const response = getOptimizeRationResponseMock();\n    const candidate = response.candidates[0];\n    response.candidates = [\n      candidate,\n      { ...candidate, id: 72, name: \"Lower cost mix\", costUsdPerLb: 0.17, tradeoff: \"Lower cost with less energy\", ingredients: [{ name: \"Ground corn\", proportionPercent: 70 }, { name: \"Alfalfa meal\", proportionPercent: 30 }] },\n      { ...candidate, id: 73, name: \"Higher protein mix\", costUsdPerLb: 0.23, tradeoff: \"More protein with a higher cost\", ingredients: [{ name: \"Ground corn\", proportionPercent: 40 }, { name: \"Alfalfa meal\", proportionPercent: 60 }] },\n    ];\n    server.use(getOptimizeRationMockHandler(response));\n\n    render(<RationOptimizerContainer />);\n\n    expect(await screen.findByRole(\"heading\", { name: \"Ration optimizer\" })).toBeVisible();\n    for (const [name, tradeoff, cost] of [\n      [\"Balanced grower mix\", \"Higher protein with a modest cost increase\", \"0.2\"],\n      [\"Lower cost mix\", \"Lower cost with less energy\", \"0.17\"],\n      [\"Higher protein mix\", \"More protein with a higher cost\", \"0.23\"],\n    ]) {\n      expect(await screen.findByText(name)).toBeVisible();\n      expect(screen.getByText(tradeoff)).toBeVisible();\n      expect(screen.getByText(new RegExp(cost))).toBeVisible();\n    }\n    expect(screen.getByText(/55%/)).toBeVisible();\n    expect(screen.getByText(/45%/)).toBeVisible();\n    expect(screen.queryByText(\"Saved\")).not.toBeInTheDocument();\n    expect(screen.queryByText(\"Assigned\")).not.toBeInTheDocument();\n  });\n\n  it(\"AC_8_2_UpdatesCandidateStatusOnlyAfterSaveIsAccepted\", async () => {\n    at(\"/rations/optimize\");\n    const candidateResponse = getOptimizeRationResponseMock();\n    const savedResponse = getSaveRationCandidateResponseMock();\n    server.use(\n      getOptimizeRationMockHandler(candidateResponse),\n      getSaveRationCandidateMockHandler(savedResponse),\n      getAssignRationCandidateMockHandler(getAssignRationCandidateResponseMock()),\n      getAssignRationCandidateMockHandler(getAssignRationCandidateResponseMock()),\n    );\n\n    render(<RationOptimizerContainer />);\n    const user = makeUser();\n    expect(await screen.findByText(\"Balanced grower mix\")).toBeVisible();\n    expect(screen.getByText(\"Candidate\")).toBeVisible();\n    expect(screen.queryByText(\"Saved\")).not.toBeInTheDocument();\n\n    await user.click(screen.getByRole(\"button\", { name: \"Save mix\" }));\n\n    expect(await screen.findByText(\"Candidate saved\")).toBeVisible();\n    expect(screen.getByText(\"Saved\")).toBeVisible();\n  });\n});\n\ndescribe(\"feeding plans\", () => {\n  it(\"AC_9_1_GeneratesAPlanForTheBunkRateAndAnimalCount\", async () => {\n    at(\"/feeding-plans\");\n    const createdPlan = getCreateFeedingPlanResponseMock();\n    createdPlan.plan.feedingTime = \"06:30\";\n    createdPlan.plan.costUsd = 190;\n    createdPlan.plan.expectedEnergyMcal = 1420;\n    let submittedPlan: unknown;\n    server.use(getCreateFeedingPlanMockHandler(async ({ request }) => {\n      submittedPlan = await request.json();\n      return createdPlan;\n    }));\n\n    render(<FeedingPlansContainer />);\n    const user = makeUser();\n    await enter(user, \"Date\", \"2026-04-15\");\n    await choose(user, \"Pen\", \"North 2\");\n    await choose(user, \"Ration\", \"Grower 2\");\n    await enter(user, \"Bunk rate (lb as-fed/hd/d)\", \"25\");\n    await enter(user, \"Planned head count\", \"40\");\n    await user.click(screen.getByRole(\"button\", { name: \"Generate plan\" }));\n\n    expect(await screen.findByText(/1000/)).toBeVisible();\n    expect(screen.getByText(\"2026-04-15\")).toBeVisible();\n    expect(screen.getByText(\"North 2\")).toBeVisible();\n    expect(screen.getByText(\"Grower 2\")).toBeVisible();\n    expect(screen.getByText(\"06:30\")).toBeVisible();\n    expect(screen.getByText(/190/)).toBeVisible();\n    expect(screen.getByText(/1420/)).toBeVisible();\n    expect(screen.getByText(\"Planned\")).toBeVisible();\n    expect(submittedPlan).toMatchObject({ bunkRateLbPerHeadPerDay: 25, plannedHeadCount: 40 });\n  });\n\n  it(\"AC_9_2_ShowsSeparateLotAllocationsForThePlan\", async () => {\n    at(\"/feeding-plans\");\n    const response = getListFeedingPlansResponseMock();\n    response.plans[0].plannedQuantityLb = 1000;\n    response.plans[0].lotAllocations = [\n      { lotId: 241, lotCode: \"L-241\", plannedQuantityLb: 600 },\n      { lotId: 242, lotCode: \"L-242\", plannedQuantityLb: 400 },\n    ];\n    server.use(getListFeedingPlansMockHandler(response));\n\n    render(<FeedingPlansContainer />);\n\n    const lotOne = await screen.findByText(\"L-241\");\n    const lotTwo = screen.getByText(\"L-242\");\n    expect(lotOne).toBeVisible();\n    expect(lotTwo).toBeVisible();\n    expect(screen.getByText(/600/)).toBeVisible();\n    expect(screen.getByText(/400/)).toBeVisible();\n  });\n\n  it(\"AC_10_1_ListsEachPlanWithItsDeliveryDetailsAndStatus\", async () => {\n    at(\"/feeding-plans\");\n    const base = getListFeedingPlansResponseMock().plans[0];\n    const response = {\n      plans: [\n        { ...base, id: 801, date: \"2026-04-14\", pen: \"North 2\", ration: \"Grower 2\", plannedQuantityLb: 1000, status: \"Planned\" as const },\n        { ...base, id: 802, date: \"2026-04-15\", pen: \"South 1\", ration: \"Starter 1\", plannedQuantityLb: 1200, status: \"In progress\" as const },\n        { ...base, id: 803, date: \"2026-04-16\", pen: \"West 3\", ration: \"Finisher 3\", plannedQuantityLb: 1400, status: \"Completed\" as const },\n        { ...base, id: 804, date: \"2026-04-17\", pen: \"East 4\", ration: \"Grower 4\", plannedQuantityLb: 1600, status: \"Skipped\" as const },\n      ],\n    };\n    server.use(getListFeedingPlansMockHandler(response));\n\n    render(<Fe