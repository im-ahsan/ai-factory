  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    /* Exact colors prescribed by specification */
    :root {
      --bg-page: #F4F3EF;
      --bg-panel: #FFFFFF;
      --text-main: #262A2D;
      --text-muted: #626A6F;
      --border-color: #D9DAD7;
      --brand-primary: #526F82;
      --status-good: #356A55;
      --status-waiting: #986321;
      --status-failed: #B4473C;
    }

    body {
      background-color: var(--bg-page);
      color: var(--text-main);
      font-family: 'Source Sans 3', sans-serif;
      font-size: 14px;
      line-height: 1.5;
      margin: 0;
      padding: 0;
      -webkit-font-smoothing: antialiased;
    }

    h1, h2, h3 {
      font-family: 'Hanken Grotesk', sans-serif;
      color: var(--text-main);
    }

    .font-mono-num {
      font-family: 'IBM Plex Mono', monospace;
    }

    /* Motion Tokens & Keyframes */
    @keyframes entranceFadeUp {
      from {
        opacity: 0;
        transform: translateY(8px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes rollDigitUp {
      from {
        opacity: 0;
        transform: translateY(0.65em);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes breatheSync {
      0%, 100% {
        transform: scale(1);
        opacity: 0.84;
      }
      50% {
        transform: scale(1.03);
        opacity: 1;
      }
    }

    .page-enter {
      animation: entranceFadeUp 400ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    .digit-roll {
      display: inline-block;
      animation: rollDigitUp 600ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
    .digit-roll-1 { animation-delay: 0ms; }
    .digit-roll-2 { animation-delay: 35ms; }
    .digit-roll-3 { animation-delay: 70ms; }
    .digit-roll-4 { animation-delay: 105ms; }

    .sync-breathe {
      animation: breatheSync 8s cubic-bezier(0.65, 0, 0.35, 1) infinite;
    }

    /* Controls: min 44px height, hover, focus, pressed */
    .btn-primary {
      background-color: var(--brand-primary);
      color: #FFFFFF;
      min-height: 44px;
      padding: 0 16px;
      border-radius: 6px;
      font-weight: 500;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      text-decoration: none;
      transition: background-color 160ms ease, transform 90ms ease;
    }
    .btn-primary:hover {
      background-color: #435c6d;
    }
    .btn-primary:active {
      transform: scale(0.98);
    }
    .btn-primary:focus-visible {
      outline: 2px solid var(--brand-primary);
      outline-offset: 2px;
    }

    .btn-secondary {
      background-color: transparent;
      color: var(--text-main);
      border: 1px solid var(--border-color);
      min-height: 44px;
      padding: 0 16px;
      border-radius: 6px;
      font-weight: 500;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      text-decoration: none;
      transition: background-color 160ms ease, border-color 160ms ease, transform 90ms ease;
    }
    .btn-secondary:hover {
      background-color: #FAF9F6;
      border-color: #c4c5c2;
    }
    .btn-secondary:active {
      transform: scale(0.98);
    }
    .btn-secondary:focus-visible {
      outline: 2px solid var(--brand-primary);
      outline-offset: 2px;
    }

    .nav-item {
      color: var(--text-muted);
      text-decoration: none;
      font-size: 14px;
      font-weight: 500;
      padding: 16px 0;
      display: inline-flex;
      align-items: center;
      border-bottom: 2px solid transparent;
      transition: color 140ms ease, border-color 140ms ease;
    }
    .nav-item:hover {
      color: var(--text-main);
    }
    .nav-item.active {
      color: var(--brand-primary);
      border-bottom-color: var(--brand-primary);
      font-weight: 600;
    }
    .nav-item:focus-visible {
      outline: 2px solid var(--brand-primary);
      outline-offset: 2px;
    }

    /* Accessibility */
    @media (prefers-reduced-motion: reduce) {
      *, ::before, ::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
        scroll-behavior: auto !important;
      }
    }
  </style>
</head>
