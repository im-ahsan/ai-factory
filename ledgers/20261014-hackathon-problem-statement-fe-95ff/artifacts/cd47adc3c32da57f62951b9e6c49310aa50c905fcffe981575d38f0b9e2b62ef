              <label for="acc_role" class="block text-xs font-semibold text-[#262A2D] mb-1.5">Assigned role</label>
              <select id="acc_role" class="form-select">
                <option value="Operator">Operator</option>
                <option value="Administrator">Administrator</option>
              </select>
              <p class="text-[11px] text-[#626A6F] mt-1">Limited to Administrator or Operator per yard security policy.</p>
            </div>

            <!-- Administrator-set password -->
            <div>
              <label for="acc_password" class="block text-xs font-semibold text-[#262A2D] mb-1.5">Administrator-set password</label>
              <input type="password" id="acc_password" placeholder="Enter temporary secure password" class="form-input font-mono-num" />
              <p class="text-[11px] text-[#626A6F] mt-1">Initial password provided directly to personnel upon activation.</p>
            </div>

            <!-- Primary Action: Add account -->
            <div class="pt-2">
              <button type="submit" class="btn-primary w-full text-center">
                Add account
