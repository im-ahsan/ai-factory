<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Accounts</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@600&family=IBM+Plex+Mono:wght@400;500;600&family=Source+Sans+3:wght@400;500;600&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    /* CSS Variables matching exact design system tokens */
    :root {
      --color-bg: #F4F3EF;
      --color-surface: #FFFFFF;
      --color-text: #262A2D;
      --color-text-muted: #626A6F;
      --color-border: #D9DAD7;
      --color-primary: #526F82;
      --color-status-good: #356A55;
      --color-status-waiting: #986321;
      --color-status-failed: #B4473C;
    }

    body {
      background-color: var(--color-bg);
      color: var(--color-text);
      font-family: 'Source Sans 3', sans-serif;
      font-size: 14px;
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
      margin: 0;
      padding: 0;
    }

    h1, h2, h3, .font-heading {
      font-family: 'Hanken Grotesk', sans-serif;
      font-weight: 600;
    }

    .font-mono-num {
      font-family: 'IBM Plex Mono', monospace;
    }

    /* Motion tokens */
    @keyframes entranceFadeUp {
      0% {
        opacity: 0;
        transform: translateY(8px);
      }
      100% {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes digitRoll {
      0% {
        opacity: 0;
        transform: translateY(0.65em);
      }
      100% {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes liveBreathe {
      0%, 100% {
        transform: scale(1);
        opacity: 0.84;
      }
      50% {
        transform: scale(1.03);
        opacity: 1;
      }
    }

    .animate-entrance {
      animation: entranceFadeUp 400ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    .digit-roll {
      display: inline-block;
      animation: digitRoll 600ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    .stagger-1 { animation-delay: 0ms; }
    .stagger-2 { animation-delay: 35ms; }
    .stagger-3 { animation-delay: 70ms; }

    .sync-dot-breathe {
      animation: liveBreathe 8s cubic-bezier(0.65, 0, 0.35, 1) infinite;
    }

    /* Interactive state styles */
    .btn-primary {
      background-color: #526F82;
      color: #FFFFFF;
      height: 44px;
      border-radius: 6px;
      padding: 0 16px;
      font-weight: 500;
      transition: background-color 150ms ease, transform 90ms ease;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border: 1px solid transparent;
    }
    .btn-primary:hover {
      background-color: #435b6b;
    }
    .btn-primary:active {
      transform: scale(0.98);
    }
    .btn-primary:focus-visible {
      outline: 2px solid #526F82;
      outline-offset: 2px;
    }

    .btn-secondary {
      background-color: #FFFFFF;
      color: #262A2D;
      height: 44px;
      border-radius: 6px;
      padding: 0 16px;
      font-weight: 500;
      border: 1px solid #D9DAD7;
      transition: background-color 150ms ease, border-color 150ms ease, transform 90ms ease;
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }
    .btn-secondary:hover {
      background-color: #F4F3EF;
      border-color: #C0C1BE;
    }
    .btn-secondary:active {
      transform: scale(0.98);
    }
    .btn-secondary:focus-visible {
      outline: 2px solid #526F82;
      outline-offset: 2px;
    }

    .btn-table-action {
      background-color: #FFFFFF;
      color: #262A2D;
      height: 36px;
      border-radius: 6px;
      padding: 0 12px;
      font-size: 13px;
      font-weight: 500;
      border: 1px solid #D9DAD7;
      transition: background-color 150ms ease, border-color 150ms ease;
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }
    .btn-table-action:hover {
      background-color: #F4F3EF;
    }
    .btn-table-action:focus-visible {
      outline: 2px solid #526F82;
      outline-offset: 2px;
    }

    .form-input, .form-select {
      background-color: #FFFFFF;
      border: 1px solid #D9DAD7;
      border-radius: 6px;
      height: 44px;
      padding: 0 12px;
      color: #262A2D;
      width: 100%;
      font-size: 14px;
      transition: border-color 150ms ease;
    }
    .form-input:focus, .form-select:focus {
      outline: 2px solid #526F82;
      outline-offset: 0;
      border-color: #526F82;
    }

    .panel-box {
      background-color: #FFFFFF;
      border: 1px solid #D9DAD7;
      border-radius: 8px;
    }

    @media (prefers-reduced-motion: reduce) {
      *, ::before, ::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
      }
    }
  </style>
</head>
