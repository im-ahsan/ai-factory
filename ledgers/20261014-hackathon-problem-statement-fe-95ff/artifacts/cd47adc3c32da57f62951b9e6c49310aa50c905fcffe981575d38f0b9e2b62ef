          <form class="space-y-4" onsubmit="return false;">
            <!-- Name -->
            <div>
              <label for="acc_name" class="block text-xs font-semibold text-[#262A2D] mb-1.5">Full name</label>
              <input type="text" id="acc_name" placeholder="e.g. Samuel Davis" class="form-input" />
            </div>

            <!-- Department -->
            <div>
              <label for="acc_dept" class="block text-xs font-semibold text-[#262A2D] mb-1.5">Department</label>
