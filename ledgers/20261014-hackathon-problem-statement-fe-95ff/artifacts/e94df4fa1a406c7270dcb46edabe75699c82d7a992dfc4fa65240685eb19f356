{"ts":1791997211080,"kind":"call","tool":"Bash","input":"{\"command\":\"nl -ba tests/acceptance.part1.test.tsx | sed -n '120,325p'\"}","output":"   120\t  const page = renderScreen(<SignInContainer />);\n   121\t  await user.type(screen.getByLabelText(\"Email\"), response.user.email);\n   122\t  await user.type(screen.getByLabelText(\"Password\"), \"managed-account-password\");\n   123\t  await user.click(screen.getByRole(\"button\", { name: \"Sign in\" }));\n   124\t  await screen.findByText(role);\n   125\t  page.unmount();\n   126\t}\n   127\t\n   128\tdescribe(\"REQ-1 managed accounts and access\", () => {\n   129\t  it(\"AC_1_1_ShowsManagedSignInAndSignedInPages\", async () => {\n   130\t    const signInResponse = getSignInResponseMock();\n   131\t    const submitted: unknown[] = [];\n   132\t    server.use(getSignInMockHandler(async ({ request }) => {\n   133\t      submitted.push(await request.clone().json());\n   134\t      return signInResponse;\n   135\t    }));\n   136\t    at(\"/sign-in\");\n   137\t    const user = userEvent.setup();\n   138\t    renderScreen(<SignInContainer />);\n   139\t\n   140\t    await user.type(screen.getByLabelText(\"Email\"), signInResponse.user.email);\n   141\t    await user.type(screen.getByLabelText(\"Password\"), \"managed-account-password\");\n   142\t    expect(screen.queryByRole(\"button\", { name: /register|sign up|sso|single sign-on/i })).not.toBeTruthy();\n   143\t    expect(screen.queryByRole(\"link\", { name: /register|sign up|sso|single sign-on/i })).not.toBeTruthy();\n   144\t    await user.click(screen.getByRole(\"button\", { name: \"Sign in\" }));\n   145\t\n   146\t    await screen.findByText(signInResponse.user.role);\n   147\t    expect(submitted).toEqual([{ email: signInResponse.user.email, password: \"managed-account-password\" }]);\n   148\t    for (const page of signInResponse.availablePages) {\n   149\t      expect(screen.getByRole(\"link\", { name: page })).toBeTruthy();\n   150\t    }\n   151\t  },);