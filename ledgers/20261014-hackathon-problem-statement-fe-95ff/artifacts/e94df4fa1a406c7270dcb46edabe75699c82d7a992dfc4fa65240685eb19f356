tityLb: 190, lotConsumptionLb: 188.1, feedCostUsd: 36.1 },\n    ];\n    response.activity.lotRollups = [\n      { lotId: 241, lotCode: \"L-241\", totalFeedConsumedLb: 18400, totalFeedCostUsd: 12480 },\n      { lotId: 242, lotCode: \"L-242\", totalFeedConsumedLb: 9200, totalFeedCostUsd: 6240 },\n      { lotId: 243, lotCode: \"L-243\", totalFeedConsumedLb: 4600, totalFeedCostUsd: 3120 },\n    ];\n    response.inventoryTotals = [\n      { item: \"Ground corn\", closingLb: 11877.5 },\n      { item: \"Alfalfa meal\", closingLb: 4211.25 },\n      { item: \"Soybean meal\", closingLb: 3790.5 },\n    ];\n    server.use(getCreateFeedingActivityMockHandler(response));\n\n    const user = userEvent.setup();\n    await renderFeedingLog();\n    await fillFeedingForm(user);\n    await user.click(await screen.findByRole(\"button\", { name: \"Save feeding\" }));\n\n    await screen.findByText(\"Activity recorded\");\n    await expectTextFragment(/522\\.5/);\n    await expectTextFragment(/110\\.25/);\n    await expectTextFragment(/80\\.75/);\n    await expectTextFragment(/564\\.3/);\n    await expectTextFragment(/376\\.2/);\n    await expectTextFragment(/188\\.1/);\n    for (const code of [\"L-241\", \"L-242\", \"L-243\"]) await expectTextFragment(new RegExp(code));\n    for (const quantity of [/570/, /380/, /190/]) await expectTextFragment(quantity);\n    for (const cost of [/108\\.3/, /72\\.2/, /36\\.1/]) await expectTextFragment(cost);\n    await expectTextFragment(/180\\.5/);\n    await expectTextFragment(/1,349|1349/);\n    await expectTextFragment(/18,400|18400/);\n    await expectTextFragment(/11,877\\.5|11877\\.5/);\n  });\n\n  it(\"AC_12_2_ShowsTheInventoryResultReturnedForTheSavedActivity\", async () => {\n    const response = getCreateFeedingActivityResponseMock();\n    response.activity.inventoryConsumption = [{ ingredient: \"Ground corn\", quantityLb: 544.25 }];\n    response.inventoryTotals = [{ item: \"Ground corn\", closingLb: 11779.25 }];\n    server.use(getCreateFee