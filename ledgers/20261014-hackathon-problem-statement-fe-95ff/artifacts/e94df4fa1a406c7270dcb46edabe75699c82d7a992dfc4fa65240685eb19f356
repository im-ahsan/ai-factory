"/admin/accounts\");\n    renderScreen(<AccountsContainer />);\n\n    const mainNav = screen.getByRole(\"navigation\", { name: \"Main\" });\n    for (const name of [\"Accounts\", \"Sync\", \"Demo\"]) {\n      expect(within(mainNav).queryByRole(\"link\", { name })).not.toBeTruthy();\n    }\n    for (const name of [\"Overview\", \"Feeding plans\", \"Feeding log\", \"Lot weights\", \"Feed-to-Gain\"]) {\n      expect(within(mainNav).getByRole(\"link\", { name })).toBeTruthy();\n    }\n    expect(screen.queryByRole(\"button\", { name: \"Add account\" })).not.toBeTruthy();\n    expect(screen.queryByLabelText(\"Email address\")).not.toBeTruthy();\n  });\n});\n\ndescribe(\"REQ-2 source synchronization\", () => {\n  it(\"AC_2_1_ShowsConfiguredSourceRecordsAndSyncStatuses\", async () => {\n    const base = getSynchronizeSourceRecordsResponseMock();\n    const first = base.records[0]!;\n    const answer = {\n      ...base,\n      records: [\n        first,\n        { ...first, sourceId: \"PO-7303-1\", sourceRecordId: \"REC-5521\", vendor: \"Red River Livestock\", costUsd: 840, headCount: 48, averageWeightLb: 655, breed: \"Hereford\", ageMonths: 18, result: \"Imported\" as const, targetLots: [\"L-243\"] },\n        { ...first, sourceId: \"PO-7304-1\", sourceRecordId: \"REC-5522\", vendor: \"Cedar Valley Ranch\", costUsd: 1260, headCount: 72, averageWeightLb: 610, breed: \"Charolais\", ageMonths: 15, result: \"Updated\" as const, targetLots: [\"L-244\"] },\n      ],\n    };\n    const requests: string[] = [];\n    server.use(getSynchronizeSourceRecordsMockHandler((info) => {\n      requests.push(info.request.url);\n      return answer;\n    }));\n    at(\"/admin/sync\");\n    const user = userEvent.setup();\n    renderScreen(<SyncContainer />);\n\n    await user.click(screen.getByRole(\"button\", { name: \"Sync now\" }));\n    expect(await screen.findByText(\"PO-7301-1\")).toBeTruthy();\n    expect(requests).toHaveLength(1);\n    expect(requests[0]).toMatch(/\\/admin\\/sync$/);\