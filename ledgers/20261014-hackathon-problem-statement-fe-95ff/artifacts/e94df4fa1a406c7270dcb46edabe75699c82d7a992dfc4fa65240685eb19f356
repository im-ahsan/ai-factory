igation\", { name: \"Main\" });\n   188\t    for (const name of [\"Accounts\", \"Sync\", \"Demo\"]) {\n   189\t      expect(within(mainNav).queryByRole(\"link\", { name })).not.toBeTruthy();\n   190\t    }\n   191\t    for (const name of [\"Overview\", \"Feeding plans\", \"Feeding log\", \"Lot weights\", \"Feed-to-Gain\"]) {\n   192\t      expect(within(mainNav).getByRole(\"link\", { name })).toBeTruthy();\n   193\t    }\n   194\t    expect(screen.queryByRole(\"button\", { name: \"Add account\" })).not.toBeTruthy();\n   195\t    expect(screen.queryByLabelText(\"Email address\")).not.toBeTruthy();\n   196\t  });\n   197\t});\n   198\t\n   199\tdescribe(\"REQ-2 source synchronization\", () => {\n   200\t  it(\"AC_2_1_ShowsConfiguredSourceRecordsAndSyncStatuses\", async () => {\n   201\t    const base = getSynchronizeSourceRecordsResponseMock();\n   202\t    const first = base.records[0]!;\n   203\t    const answer = {\n   204\t      ...base,\n   205\t      records: [\n   206\t        first,\n   207\t        { ...first, sourceId: \"PO-7303-1\", sourceRecordId: \"REC-5521\", vendor: \"Red River Livestock\", costUsd: 840, headCount: 48, averageWeightLb: 655, breed: \"Hereford\", ageMonths: 18, result: \"Imported\" as const, targetLots: [\"L-243\"] },\n   208\t        { ...first, sourceId: \"PO-7304-1\", sourceRecordId: \"REC-5522\", vendor: \"Cedar Valley Ranch\", costUsd: 1260, headCount: 72, averageWeightLb: 610, breed: \"Charolais\", ageMonths: 15, result: \"Updated\" as const, targetLots: [\"L-244\"] },\n   209\t      ],\n   210\t    };\n   211\t    const requests: string[] = [];\n   212\t    server.use(getSynchronizeSourceRecordsMockHandler((info) => {\n   213\t      requests.push(info.request.url);\n   214\t      return answer;\n   215\t    }));\n   216\t    at(\"/admin/sync\");\n   217\t    const user = userEvent.setup();\n   218\t    renderScreen(<SyncContainer />);\n   219\t\n   220\t    await user.click(screen.getByRole(\"button\", { name: \"Sync now\" }));\n   221\t    expect(await screen.findByText(\"PO-7301-1\")).toBeTruthy();\n   222\t    expect(requests).toHaveLength(1);\n   223\t    expect(requests[0]).toMatch(/\\/admin\\/sync$/);\n   224\t    expect(screen.getByText(answer.source)).toBeTruthy();\n   225\t    for (const [sourceId, recordId, vendor, cost, head, weight, breed, age, result] of [\n   226\t      [\"PO-7301-1\", \"REC-5518\", \"Prairie Cattle Co.\", \"1000\", \"60\", \"620\", \"Angus\", \"16\", \"Updated\"],\n   227\t      [\"PO-7303-1\", \"REC-5521\", \"Red River Livestock\", \"840\", \"48\", \"655\", \"Hereford\", \"18\", \"Imported\"],\n   228\t      [\"PO-7304-1\", \"REC-5522\", \"Cedar Valley Ranch\", \"1260\", \"72\", \"610\", \"Charolais\", \"15\", \"Updated\"],\n   229\t    ]) {\n   230\t      const row = rowContaining(sourceId);\n   231\t      for (const field of [recordId, vendor, cost, head, weight, breed, age, result]) {\n   232\t        expect(row.getByText(new RegExp(field.replace(/[.*+?^${}()|[\\]\\\\]/g, \"\\\\$&\")))).toBeTruthy();\n   233\t      }\n   234\t    }\n   235\t  });\n   236\t\n   237\t  it(\"AC_2_2_ShowsUpdatedImportAndFailedRecordWithoutSuccess\", async () => {\n   238\t    const base = getSynchronizeSourceRecordsResponseMock();\n   239\t    const answer = {\n   240\t      ...base,\n   241\t      records: [\n   242\t        base.records[0]!,\n   243\t        base.records[1]!,\n   244\t        { ...base.records[0]!, sourceId: \"PO-7303-1\", sourceRecordId: \"REC-5521\", result: \"Imported\" as const, targetLots: [\"L-243\"] },\n   245\t      ],\n   246\t    };\n   247\t    server.use(getSynchronizeSourceRecordsMockHandler(answer));\n   248\t    at(\"/admin/sync\");\n   249\t    const user = userEvent.setup();\n   250\t    renderScreen(<SyncContainer />);\n   251\t\n   252\t    await user.click(screen.getByRole(\"button\", { name: \"Sync now\" }));\n   253\t    const updatedRow = await screen.findByRole(\"row\", { name: /PO-7301-1/ });\n   254\t    expect(within(updatedRow).getByText(\"REC-5518\")).toBeTruthy();\n   255\t    expect(within(updatedRow).getByText(\"Updated\")).toBeTruthy();\n   256\t    const failedRow = screen.getByRole(\"row\", { name: /PO-7302-1/ });\n   257\t    expect(within(failedRow).getByText(\"REC-5520\")).toBeTruthy();\n   258\t    expect(within(failedRow).getByText(\"Failed\")).toBeTruthy();\n   259\t    expect(within(failedRow).getByText(\"Source record validation failed\")).toBeTruthy();\n   260\t    expect(within(failedRow).queryByText(\"Imported\")).not.toBeTruthy();\n   261\t    expect(within(failedRow).queryByText(\"Updated\")).not.toBeTruthy();\n   262\t  });\n   263\t});\n   264\t\n   265\tdescribe(\"REQ-3 procurement traceability\", () => {\n   266\t  it(\"AC_3_1_ShowsPOFieldsLotsPensAndPenCounts\", async () => {\n   267\t    server.use(getListLotsMockHandler({ lots: rowsWithLots() }));\n   268\t    at(\"/lots\");\n   269\t    renderScreen(<LotsContainer />);\n   270\t\n   271\t    const table = await screen.findByRole(\"table\");\n   272\t    for (const heading of [\"Source PO & Line\", \"Supplier\", \"Received Date\", \"Lot\", \"Breed & Sex\", \"Received Head\", \"Pen\", \"Purchase Cost Allocation\", \"Pen Cap / Count\", \"Actions\"]) {\n   273\t      expect(within(table).getByRole(\"columnheader\", { name: heading })).toBeTruthy();\n   274\t    }\n   275\t    const northLot = rowContaining(\"L-241\");\n   276\t    for (const value of [\"PO-7301-1\", \"REC-5518\", \"Prairie Cattle Co.\", \"2026-02-01\", \"Angus\", \"Female\", \"60\", \"North 2\", \"600\", \"120\", \"80\"]) {\n   277\t      expect(northLot.getByText(value)).toBeTruthy();\n   278\t    }\n   279\t    const southLot = rowContaining(\"L-242\");\n   280\t    for (const value of [\"PO-7301-1\", \"REC-5518\", \"Hereford\", \"Male\", \"40\", \"South 1\", \"80\", \"45\"]) {\n   281\t      expect(southLot.getByText(value)).toBeTruthy();\n   282\t    }\n   283\t    const thirdLot = rowContaining(\"L-243\");\n   284\t    for (const value of [\"PO-7302-1\", \"REC-5520\", \"Red River Livestock\", \"Charolais\", \"32\", \"East 4\", \"100\", \"70\"]) {\n   285\t      expect(thirdLot.getByText(value)).toBeTruthy();\n   286\t    }\n   287\t  });\n   288\t\n   289\t  it(\"AC_3_2_ShowsPurchaseCostAllocatedByReceivedHead\", async () => {\n   290\t    const lots = rowsWithLots().slice(0, 2);\n   291\t    server.use(getListLotsMockHandler({ lots }));\n   292\t    at(\"/lots\");\n   293\t    renderScreen(<LotsContainer />);\n   294\t\n   295\t    await screen.findByRole(\"table\");\n   296\t    expect(rowContaining(\"L-241\").getByText(/\\b600(?:\\.00)?\\b/)).toBeTruthy();\n   297\t    expect(rowContaining(\"L-242\").getByText(/\\b400(?:\\.00)?\\b/)).toBeTruthy();\n   298\t  });\n   299\t\n   300\t  it(\"AC_3_3_ShowsUnknownWhenAnimalSexIsMissing\", async () => {\n   301\t    const source = getListLotsResponseMock().lots[0]!;\n   302\t    server.use(getListLotsMockHandler({ lots: [{ ...source, sex: null }] }));\n   303\t    at(\"/lots\");\n   304\t    renderScreen(<LotsContainer />);\n   305\t\n   306\t    await screen.findByRole(\"table\");\n   307\t    const lot = rowContaining(\"L-241\");\n   308\t    expect(lot.getByText(\"Unknown\")).toBeTruthy();\n   309\t  });\n   310\t});\n   311\t\n   312\tdescribe(\"REQ-4 lifecycle projections\", () => {\n   313\t  it(\"AC_4_1_ShowsMeasuredADGAndLifecycleProjection\", async () => {\n   314\t    const lifecycle = getGetLotLifecycleResponseMock();\n   315\t    server.use(getGetLotLifecycleMockHandler({ ...lifecycle, targetWeightLb: 1250, growthAssumption: \"Measured ADG\", growthRateLbPerDay: 3.2, projectedMarketDate: \"2026-07-10\" }));\n   316\t    at(\"/lots/L-241/lifecycle\");\n   317\t    renderScreen(<LifecycleContainer />);\n   318\t\n   319\t    expect(await screen.findByRole(\"heading\", { name: \"Lifecycle\" })).toBeTruthy();\n   320\t    expect(screen.getByText(/1,?250/)).toBeTruthy();\n   321\t    expect(screen.getByText(\"Measured ADG\")).toBeTruthy();\n   322\t    expect(screen.getByText(\"3.2\")).toBeTruthy();\n   323\t    expect(screen.getByText(\"2026-07-10\")).toBeTruthy();\n   324\t    expect(screen.getByText(\"Received\")).toBeTruthy();\n   325\t    expect(screen.getByText(\"Weight measurement\")).toBeTruthy();\n","chars":11292,"exitCode":0}
