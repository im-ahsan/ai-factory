nction signInAs(role: \"Administrator\" | \"Operator\") {\n  const session = getSignInResponseMock();\n  const response = { ...session, user: { ...session.user, role } };\n  server.use(getSignInMockHandler(response));\n  at(\"/sign-in\");\n  const user = userEvent.setup();\n  const page = renderScreen(<SignInContainer />);\n  await user.type(screen.getByLabelText(\"Email\"), response.user.email);\n  await user.type(screen.getByLabelText(\"Password\"), \"managed-account-password\");\n  await user.click(screen.getByRole(\"button\", { name: \"Sign in\" }));\n  await screen.findByText(role);\n  page.unmount();\n}\n\ndescribe(\"REQ-1 managed accounts and access\", () => {\n  it(\"AC_1_1_ShowsManagedSignInAndSignedInPages\", async () => {\n    const signInResponse = getSignInResponseMock();\n  const page = renderScreen(<SignInContainer />);\n  await user.type(screen.getByLabelText(\"Email\"), response.user.email);\n  await user.type(screen.getByLabelText(\"Password\"), \"managed-account-password\");\n  await user.click(screen.getByRole(\"button\", { name: \"Sign in\" }));\n  await screen.findByText(role);\n  page.unmount();\n}\n\ndescribe(\"REQ-1 managed accounts and access\", () => {\n  it(\"AC_1_1_ShowsManagedSignInAndSignedInPages\", async () => {\n    const signInResponse = getSignInResponseMock();\n    const submitted: unknown[] = [];\n    server.use(getSignInMockHandler(async ({ request }) => {\n      submitted.push(await request.clone().json());\n      return signInResponse;\n    }));\n    at(\"/sign-in\");\n    const user = userEvent.setup();\n    renderScreen(<SignInContainer />);\n\n    await user.type(screen.getByLabelText(\"Email\"), signInResponse.user.email);\n    await user.type(screen.getByLabelText(\"Password\"), \"managed-account-password\");\n    expect(screen.queryByRole(\"button\", { name: /register|sign up|sso|single sign-on/i })).not.toBeTruthy();\n    expect(screen.queryByRole(\"link\", { name: /register|sign up|sso|single sign-on/i })).not.toBeTru