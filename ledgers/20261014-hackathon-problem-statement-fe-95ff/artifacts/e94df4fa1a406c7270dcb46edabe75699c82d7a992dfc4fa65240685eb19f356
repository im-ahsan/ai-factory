ledRow).queryByText(\"Imported\")).not.toBeTruthy();\n    expect(within(failedRow).queryByText(\"Updated\")).not.toBeTruthy();\n  });\n});\n\ndescribe(\"REQ-3 procurement traceability\", () => {\n  it(\"AC_3_1_ShowsPOFieldsLotsPensAndPenCounts\", async () => {\n    server.use(getListLotsMockHandler({ lots: rowsWithLots() }));\n    at(\"/lots\");\n    renderScreen(<LotsContainer />);\n\n    const table = await screen.findByRole(\"table\");\n    for (const heading of [\"Source PO & Line\", \"Supplier\", \"Received Date\", \"Lot\", \"Breed & Sex\", \"Received Head\", \"Pen\", \"Purchase Cost Allocation\", \"Pen Cap / Count\", \"Actions\"]) {\n      expect(within(table).getByRole(\"columnheader\", { name: heading })).toBeTruthy();\n    }\n    const northLot = rowContaining(\"L-241\");\n    for (const value of [\"PO-7301-1\", \"REC-5518\", \"Prairie Cattle Co.\", \"2026-02-01\", \"Angus\", \"Female\", \"60\", \"North 2\", \"600\", \"120\", \"80\"]) {\n      expect(northLot.getByText(value)).toBeTruthy();\n    }\n    const southLot = rowContaining(\"L-242\");\n    for (const value of [\"PO-7301-1\", \"REC-5518\", \"Hereford\", \"Male\", \"40\", \"South 1\", \"80\", \"45\"]) {\n      expect(southLot.getByText(value)).toBeTruthy();\n    }\n    const thirdLot = rowContaining(\"L-243\");\n    for (const value of [\"PO-7302-1\", \"REC-5520\", \"Red River Livestock\", \"Charolais\", \"32\", \"East 4\", \"100\", \"70\"]) {\n      expect(thirdLot.getByText(value)).toBeTruthy();\n    }\n  });\n\n  it(\"AC_3_2_ShowsPurchaseCostAllocatedByReceivedHead\", async () => {\n    const lots = rowsWithLots().slice(0, 2);\n    server.use(getListLotsMockHandler({ lots }));\n    at(\"/lots\");\n    renderScreen(<LotsContainer />);\n\n    await screen.findByRole(\"table\");\n    expect(rowContaining(\"L-241\").getByText(/\\b600(?:\\.00)?\\b/)).toBeTruthy();\n    expect(rowContaining(\"L-242\").getByText(/\\b400(?:\\.00)?\\b/)).toBeTruthy();\n  });\n\n  it(\"AC_3_3_ShowsUnknownWhenAnimalSexIsMis