erated financials page and exercised by UI tests."},{"content":"openapi: 3.0.3\ninfo:\n  title: Feedlot Operations API\n  version: 1.0.0\n  description: \"Shared API contract for the responsive Feedlot web application and API implementation.\"\nservers:\n  - url: /api/v1\nsecurity:\n  - bearerAuth: []\npaths:\n  /auth/sign-in:\n    post:\n      operationId: signIn\n      summary: \"Sign in with an administrator-managed account.\"\n      security: []\n      requestBody:\n        required: true\n        content:\n          application/json:\n            schema:\n              $ref: '#/components/schemas/SignInRequest'\n            example:\n              email: operator@example.com\n              password: valid-password\n      responses:\n        '200':\n          description: \"Signed-in account and role.\"\n          content:\n            application/json:\n              schema:\n                $ref: '#/components/schemas/Session'\n              example:\n                user:\n                  id: 18\n                  name: Morgan Lee\n                  email: operator@example.com\n                  role: Operator\n                accessToken: demo-token\n                availablePages:\n                  - Overview\n                  - Lots\n                  - Inventory\n                  - Rations\n                  - Feeding plans\n                  - Feeding log\n                  - Lot weights\n                  - Yard summary\n                  - Feed-to-Gain\n        '400':\n          $ref: '#/components/responses/BadRequest'\n        '401':\n          $ref: '#/components/responses/Unauthorized'\n        '403':\n          $ref: '#/components/responses/Forbidden'\n        '503':\n          $ref: '#/components/responses/Unavailable'\n  /overview:\n    get:\n      operationId: getOverview\n      summary: \"Get operational overview tables and headline values.\"\n      responses:\n        '200':\n          description: \"Overview values from the operations API.\"\n          content:\n            application/json:\n              schema:\n                $ref: '#/components/schemas/Overview'\n              example:\n                headline:\n                  label: Total feed cost today\n                  value: 4280.5\n                  unit: USD\n                activeLots: 3\n                activePens: 2\n                lots:\n                  - lotCode: L-241\n                    pen: North 2\n                    head: 40\n                    adg: 3.2\n                    fcr: 6.4\n                    costOfGain: 1.92\n                    feedCost: 12480\n                    rank: 1\n                    breed: Angus\n                    daysOnFeed: 72\n                    latestWeight: 748\n                inventory:\n                  - item: Ground corn\n                    closingLb: 12400\n                    dailyDemandLb: 1250\n                    date: '2026-04-14'\n                    status: Available\n                rationFeeding:\n                  - date: '2026-04-14'\n                    pen: North 2\n                    ration: Grower 2\n                    rateLbPerHeadPerDay: 25\n                    plannedLb: 1000\n                    actualLb: 950\n                    status: Completed\n                    time: '06:30'\n                estimatedEnergyMcal: 8420\n                recentActivity:\n                  - date: '2026-04-14'\n                    activity: Feeding recorded\n                    status: Completed\n                recentSync:\n                  - date: '2026-04-14'\n                    sourceId: PO-7301-1\n                    status: Updated\n        '401':\n          $ref: '#/components/responses/Unauthorized'\n        '403':\n          $ref: '#/components/responses/Forbidden'\n        '500':\n          $ref: '#/components/responses/ServerError'\n  /lots:\n    get:\n      operationId: listLots\n      summary: \"List active lots with procurement traceability and pen allocations.\"\n      responses:\n        '200':\n          description: \"Lots and their PO-line and pen relationships.\"\n          content:\n            application/json:\n              schema:\n                $ref: '#/components/schemas/LotList'\n              example:\n                lots:\n                  - id: 241\n                    lotCode: L-241\n                    sourceId: PO-7301-1\n                    sourceRecordId: REC-5518\n                    supplier: Prairie Cattle Co.\n                    receivedDate: '2026-02-01'\n                    breed: Angus\n                    sex: Unknown\n                    receivedHead: 40\n                    purchaseCostAllocation: 600\n                    pen: North 2\n                    penCapacity: 120\n                    penCount: 80\n                    targetWeightLb: 1250\n        '401':\n          $ref: '#/components/responses/Unauthorized'\n        '403':\n          $ref: '#/components/responses/Forbidden'\n        '500':\n          $ref: '#/components/responses/ServerError'\n  /lots/{lotId}/lifecycle:\n    get:\n      operationId: getLotLifecycle\n      summary: \"Get lifecycle milestones and market projection for a lot.\"\n      parameters:\n        - $ref: '#/components/parameters/LotId'\n      responses:\n        '200':\n          description: \"Lifecycle, target, growth assumption, and projection.\"\n          content:\n            application/json:\n              schema:\n                $ref: '#/components/schemas/Lifecycle'\n              example:\n                lotId: 241\n                lotCode: L-241\n                receivedDate: '2026-02-01'\n                targetWeightLb: 1250\n                targetWeightSource: Lot target\n                growthAssumption: Measured ADG\n                growthRateLbPerDay: 3.2\n                projectedMarketDate: '2026-07-10'\n                milestones:\n                  - date: '2026-02-01'\n                    label: Received\n                    value: 620\n                    unit: lb average weight\n                  - date: '2026-04-10'\n                    label: Weight measurement\n                    value: 748\n                    unit: lb average weight\n                weightHistory:\n                  - date: '2026-04-10'\n                    daysOnFeed: 68\n                    averageWeightLb: 748\n                    periodGainLb: 128\n                    periodAdgLbPerDay: 3.2\n                    operator: Morgan Lee\n                    status: Accepted\n        '400':\n          $ref: '#/components/responses/BadRequest'\n        '401':\n          $ref: '#/components/responses/Unauthorized'\n        '403':\n          $ref: '#/components/responses/Forbidden'\n        '404':\n          $ref: '#/components/responses/NotFound'\n  /inventory:\n    get:\n      operationId: listInventory\n      summary: \"List feed inventory with units, nutrition, cost, and stock movements.\"\n      responses:\n        '200':\n          description: \"Inventory items and current movement totals.\"\n          content:\n            application/json:\n              schema:\n                $ref: '#/components/schemas/InventoryList'\n              example:\n                items:\n                  - id: 401\n                    item: Ground corn\n                    category: Grain\n                    supplier: Prairie Feed\n                    availableQuantity: 6.2\n                    enteredUnit: ton\n                    normalizedPounds: 12400\n                    cost: 360\n                    costUnit: USD per ton\n                    normalizedCostUsdPerLb: 0.18\n                    dryMatterPercent: 88\n                    energyMcalPerLb: 1.52\n                    storageLocation: Bin 2\n                    openingLb: 10000\n                    receivedLb: 5000\n                    consumedLb: 2600\n                    closingLb: 12400\n                    movements:\n                      - date: '2026-04-12'\n                        type: Receipt\n                        quantityLb: 5000\n                      - date: '2026-04-14'\n                        type: Feed consumption\n                        quantityLb: 2600\n        '401':\n          $ref: '#/components/responses/Unauthorized'\n        '403':\n          $ref: '#/components/responses/Forbidden'\n        '500':\n          $ref: '#/components/responses/ServerError'\n  /inventory/receipts:\n    post:\n      operationId: createInventoryReceipt\n      summary: \"Record a feed receipt while retaining its entered unit.\"\n      requestBody:\n        required: true\n        content:\n          application/json:\n            schema:\n              $ref: '#/components/schemas/InventoryReceiptRequest'\n            example:\n              itemName: Ground corn\n              supplier: Prairie Feed\n              quantity: 2\n              enteredUnit: ton\n              normalizedPounds: 4000\n              cost: 360\n              costUnit: USD per ton\n              receivedDate: '2026-04-14'\n      responses:\n        '201':\n          description: \"Receipt accepted with normalized stock values.\"\n          content:\n            application/json:\n              schema:\n                $ref: '#/components/schemas/InventoryReceiptResult'\n              example:\n                item:\n                  id: 401\n                  item: Ground corn\n                  enteredQuantity: 2\n                  enteredUnit: ton\n                  normalizedPounds: 4000\n                  enteredCost: 360\n                  costUnit: USD per ton\n                  normalizedCostUsdPerLb: 0.18\n                  receivedDate: '2026-04-14'\n                  closingLb: 16400\n                message: Receipt recorded\n        '400':\n          $ref: '#/components/responses/BadRequest'\n        '401':\n          $ref: '#/components/responses/Unauthorized'\n        '403':\n          $ref: '#/components/responses/Forbidden'\n        '422':\n          $ref: '#/components/responses/ValidationError'\n  /inventory/projections:\n    get:\n      operationId: getInventoryProjections\n      summary: \"Get projected inventory horizons and stock movements.\"\n      responses:\n        '200':\n          description: \"Projection horizon estimates, wastage assumption, and movements.\"\n          content:\n            application/json:\n              schema:\n                $ref: '#/components/schemas/InventoryProjections'\n              example:\n                wastageRatio: 0.05\n                projections:\n                  - ingredient: Ground corn\n                    remainingStockLb: 12400\n                    dailyLb: 11800\n                    weeklyLb: 8150\n                    monthlyLb: 0\n                    quarterlyLb: 0\n                    sixMonthLb: 0\n                    annualLb: 0\n                movements:\n                  - date: '2026-04-14'\n                    type: Feed consumption\n                    quantityLb: 950\n                  - date: '2026-04-14'\n                    type: Receipt\n                    quantityLb: 5000\n        '401':\n          $ref: '#/components/responses/Unauthorized'\n        '403':\n          $ref: '#/components/responses/Forbidden'\n        '500':\n          $ref: '#/components/responses/ServerError'\n  /rations:\n    get:\n      operationId: listRations\n      summary: \"List saved rations and ingredient pricing details.\"\n      responses:\n        '200':\n          description: \"Saved ration values with entered and normalized ingredient units.\"\n          content:\n            application/json:\n              schema:\n                $ref: '#/components/schemas/RationList'\n              example:\n                rations:\n                  - id: 61\n                    name: Grower 2\n                    intendedAnimalRange: 650-900 lb cattle\n                    dryMatterPercent: 88\n                    energyMcalPerLb: 1.42\n                    costUsdPerLb: 0.19\n                    ingredients:\n                      - name: Ground corn\n                        quantity: 500\n                        enteredUnit: lb\n                        normalizedQuantityLb: 500\n                        proportionPercent: 50\n                        unitCostUsdPerLb: 0.18\n                        totalCostUsd: 90\n        '401':\n          $ref: '#/components/responses/Unauthorized'\n        '403':\n          $ref: '#/components/responses/Forbidden'\n        '500':\n          $ref: '#/components/responses/ServerError'\n    post:\n      operationId: createRation\n      summary: \"Create a ration from ingredient proportions and animal range.\"\n      requestBody:\n        required: true\n        content:\n          application/json:\n            schema:\n              $ref: '#/components/schemas/RationRequest'\n            example:\n              name: Grower 2\n              rationType: Grower\n              intendedAnimalRange: 650-900 lb cattle\n              ingredients:\n                - ingredientId: 401\n                  name: Ground corn\n                  quantity: 500\n                  enteredUnit: lb\n                  proportionPercent: 50\n      responses:\n        '201':\n          description: \"Saved ration and normalized nutrition/cost values.\"\n          content:\n            application/json:\n              schema:\n                $ref: '#/components/schemas/RationResult'\n              example:\n                ration:\n                  id: 61\n                  name: Grower 2\n                  intendedAnimalRange: 650-900 lb cattle\n                  dryMatterPercent: 88\n                  energyMcalPerLb: 1.42\n                  costUsdPerLb: 0.19\n                  ingredients:\n                    - name: Ground corn\n                      quantity: 500\n                      enteredUnit: lb\n                      normalizedQuantityLb: 500\n                      proportionPercent: 50\n                      unitCostUsdPerLb: 0.18\n                      totalCostUsd: 90\n        '400':\n          $ref: '#/components/responses/BadRequest'\n        '401':\n          $ref: '#/components/responses/Unauthorized'\n        '403':\n          $ref: '#/components/responses/Forbidden'\n        '422':\n          $ref: '#/components/responses/ValidationError'\n  /rations/optimization:\n    post:\n      operationId: optimizeRation\n      summary: \"Return candidate mixes for submitted nutrition or animal-range constraints.\"\n      requestBody:\n        required: true\n        content:\n          application/json:\n            schema:\n              $ref: '#/components/schemas/OptimizationRequest'\n            example:\n              intendedAnimalRange: 650-900 lb cattle\n              minimumCrudeProteinPercent: 12\n              minimumTdnPercent: 68\n              maximumCostUsdPerLb: 0.22\n      responses:\n        '200':\n          description: \"Unsaved candidate mixes and their trade-offs.\"\n          content:\n            application/json:\n              schema:\n                $ref: '#/components/schemas/CandidateList'\n              example:\n                candidates:\n                  - id: 71\n                    name: Balanced grower mix\n                    ingredients:\n                      - name: Ground corn\n                        proportionPercent: 55\n                      - name: Alfalfa meal\n                        proportionPercent: 45\n                    costUsdPerLb: 0.2\n                    crudeProteinPercent: 13.1\n                    tdnPercent: 69\n                    netEnergyMcalPerLb: 1.38\n                    tradeoff: Higher protein with a modest cost increase\n                    status: Candidate\n        '400':\n          $ref: '#/components/responses/BadRequest'\n        '401':\n          $ref: '#/components/responses/Unauthorized'\n        '403':\n          $ref: '#/components/responses/Forbidden'\n        '422':\n          $ref: '#/components/responses/ValidationError'\n  /rations/candidates/{candidateId}/save:\n    post:\n      operationId: saveRationCandidate\n      summary: \"Explicitly save an optimization candidate.\"\n      parameters:\n        - $ref: '#/components/parameters/CandidateId'\n      requestBody:\n        required: true\n        content:\n          application/json:\n            schema:\n              $ref: '#/components/schemas/CandidateActionRequest'\n            example:\n              name: Balanced grower mix\n      responses:\n        '200':\n          description: \"Candidate saved after explicit acceptance.\"\n          content:\n            application/json:\n              schema:\n                $ref: '#/components/schemas/CandidateActionResult'\n              example:\n                candidateId: 71\n                status: Saved\n                message: Candidate saved\n        '400':\n          $ref: '#/components/responses/BadRequest'\n        '401':\n          $ref: '#/components/responses/Unauthorized'\n        '403':\n          $ref: '#/components/responses/Forbidden'\n        '404':\n          $ref: '#/components/responses/NotFound'\n  /rations/candidates/{candidateId}/assign:\n    post:\n      operationId: assignRationCandidate\n      summary: \"Explicitly assign an optimization candidate.\"\n      parameters:\n        - $ref: '#/components/parameters/CandidateId'\n      requestBody:\n        required: true\n        content:\n          application/json:\n            schema:\n              $ref: '#/components/schemas/CandidateAssignRequest'\n            example:\n              penId: 12\n              effectiveDate: '2026-04-15'\n      responses:\n        '200':\n          description: \"Candidate assignment accepted.\"\n          content:\n            application/json:\n              schema:\n                $ref: '#/components/schemas/CandidateActionResult'\n              example:\n                candidateId: 71\n                status: Assigned\n                message: Candidate assigned to North 2\n        '400':\n          $ref: '#/components/responses/BadRequest'\n        '401':\n          $ref: '#/components/responses/Unauthorized'\n        '403':\n          $ref: '#/components/responses/Forbidden'\n        '404':\n          $ref: '#/components/responses/NotFound'\n  /feeding-plans:\n    get:\n      operationId: listFeedingPlans\n      summary: \"List dated pen feeding plans and schedule status.\"\n      responses:\n        '200':\n          description: \"Plans ordered by delivery date and pen.\"\n          content:\n            application/json:\n              schema:\n                $ref: '#/components/schemas/FeedingPlanList'\n              example:\n                plans:\n                  - id: 801\n                    date: '2026-04-14'\n                    penId: 12\n                    pen: North 2\n                    rationId: 61\n                    ration: Grower 2\n                    bunkRateLbPerHeadPerDay: 25\n                    plannedHeadCount: 40\n                    plannedQuantityLb: 1000\n                    feedingTime: '06:30'\n                    costUsd: 190\n                    expectedEnergyMcal: 1420\n                    status: Planned\n                    lotAllocations:\n                      - lotId: 241\n                        lotCode: L-241\n                        plannedQuantityLb: 600\n        '401':\n          $ref: '#/components/responses/Unauthorized'\n        '403':\n          $ref: '#/components/responses/Forbidden'\n        '500':\n          $ref: '#/components/responses/ServerError'\n    post:\n      operationId: createFeedingPlan\n      summary: \"Generate a dated pen feeding plan.\"\n      requestBody:\n        required: true\n        content:\n          application/json:\n            schema:\n              $ref: '#/components/schemas/FeedingPlanRequest'\n            example:\n              date: '2026-04-15'\n              penId: 12\n              rationId: 61\n              bunkRateLbPerHeadPerDay: 25\n              plannedHeadCount: 40\n      responses:\n        '201':\n          description: \"Plan and proportional lot allocations.\"\n          content:\n            application/json:\n              schema:\n                $ref: '#/components/schemas/FeedingPlanResult'\n              example:\n                plan:\n                  id: 802\n                  date: '2026-04-15'\n                  penId: 12\n                  pen: North 2\n                  rationId: 61\n                  ration: Grower 2\n                  bunkRateLbPerHeadPerDay: 25\n                  plannedHeadCount: 40\n                  plannedQuantityLb: 1000\n                  status: Planned\n                  lotAllocations:\n                    - lotId: 241\n                      lotCode: L-241\n                      plannedQuantityLb: 600\n                    - lotId: 242\n                      lotCode: L-242\n                      plannedQuantityLb: 400\n        '400':\n          $ref: '#/components/responses/BadRequest'\n        '401':\n          $ref: '#/components/responses/Unauthorized'\n        '403':\n          $ref: '#/components/responses/Forbidden'\n        '422':\n          $ref: '#/components/responses/ValidationError'\n  /feeding-activities:\n    get:\n      operationId: listFeedingActivities\n      summary: \"List feeding activities and returned inventory and lot outcomes.\"\n      responses:\n        '200':\n          description: \"Saved and unplanned feeding activities.\"\n          content:\n            application/json:\n              schema:\n                $ref: '#/components/schemas/FeedingActivityList'\n              example:\n                activities:\n                  - id: 901\n                    date: '2026-04-14'\n                    pen: North 2\n                    ration: Grower 2\n                    plannedQuantityLb: 900\n                    actualQuantityLb