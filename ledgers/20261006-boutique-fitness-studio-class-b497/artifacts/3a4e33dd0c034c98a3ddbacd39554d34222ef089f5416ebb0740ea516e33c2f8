me, type, intensity, startsAt, endsAt, durationMinutes, room, instructor, capacity, bookedCount, waitlistCount, status, availabilityLabel, capacityLabel, actionState, description, whatToBring, myBooking]\n      properties:\n        id: {type: integer}\n        name: {type: string}\n        type: {$ref: '#/components/schemas/ClassType'}\n        intensity: {$ref: '#/components/schemas/Intensity'}\n        startsAt: {type: string, format: date-time}\n        endsAt: {type: string, format: date-time}\n        durationMinutes:\n          type: integer\n          enum: [30, 45, 60, 75]\n        room: {$ref: '#/components/schemas/Room'}\n        instructor: {$ref: '#/components/schemas/Instructor'}\n        capacity: {type: integer}\n        bookedCount: {type: integer}\n        waitlistCount: {type: integer}\n        status: {$ref: '#/components/schemas/SessionStatus'}\n        availabilityLabel: {type: string}\n        capacityLabel: {type: string}\n        actionState: {$ref: '#/components/schemas/ActionState'}\n        description: {type: string}\n        whatToBring:\n          type: array\n          items: {$ref: '#/components/schemas/WhatToBringItem'}\n        myBooking:\n          allOf:\n            - $ref: '#/components/schemas/Booking'\n          nullable: true\n    BookingSession:\n      type: object\n      required: [id, name, type, startsAt, endsAt, durationMinutes, room, instructorName]\n      properties:\n        id: {type: integer}\n        name: {type: string}\n        type: {$ref: '#/components/schemas/ClassType'}\n        startsAt: {type: string, format: date-time}\n        endsAt: {type: string, format: date-time}\n        durationMinutes: {type: integer}\n        room: {$ref: '#/components/schemas/Room'}\n        instructorName: {type: string}\n    Booking:\n      type: object\n      required: [id, sessionId, status, badge, lateCancellation, lateIfCancelledNow, waitlistPosition, skipReason, createdAt, session]\n      properties:\n        id: {type: i