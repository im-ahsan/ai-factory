 [\n     \"I-2\",\n     \"I-3\",\n     \"ASM-9\",\n     \"ASM-20\"\n    ]\n   },\n   {\n    \"acceptance\": [\n     {\n      \"given\": \"A selected day with sessions of several types\",\n      \"id\": \"AC-25.1\",\n      \"level\": \"ui\",\n      \"then\": \"Only Yoga cards are shown, ordered by start time, and each card shows time, duration, name, 'Yoga' tag, intensity, instructor, room and a capacity bar\",\n      \"when\": \"The user selects the Yoga chip\"\n     },\n     {\n      \"given\": \"Sessions with 8 spots left, 2 spots left, full with waitlist count 4, and 'Cancelled by studio'\",\n      \"id\": \"AC-25.2\",\n      \"level\": \"ui\",\n      \"then\": \"Their availability labels are shown as '8 spots left', 'Only 2 left', 'Full · 4 on waitlist' and 'Cancelled', and the cancelled card's name is displayed struck through\",\n      \"when\": \"The Schedule screen is displayed\"\n     },\n     {\n      \"given\": \"Filters are selected\",\n      \"id\": \"AC-25.3\",\n      \"level\": \"ui\",\n      \"then\": \"All the day's sessions are shown again and no filter chip is shown selected\",\n      \"when\": \"The user activates 'Clear filters'\"\n     }\n    ],\n    \"ears\": \"The Schedule screen shall show a filter bar with multi-select class type chips in each type's accent colour, Low/Medium/High intensity chips, Morning/Afternoon/Evening chips and a 'Clear filters' action, and list the selected day's sessions as cards showing start time and duration, class name, colour-coded type tag with text, intensity indicator, instructor avatar and name, room, a capacity bar and an availability label.\",\n    \"id\": \"REQ-25\",\n    \"op\": \"ADDED\",\n    \"sources\": [\n     \"I-2\",\n     \"I-3\"\n    ]\n   },\n   {\n    \"acceptance\": [\n     {\n      \"given\": \"Sessions where Alex is not booked with spots, not booked and full, Booked, and Waitlisted #2\",\n      \"id\": \"AC-26.1\",\n      \"level\": \"ui\",\n      \"then\": \"The buttons are shown as 'Book', 'Join waitlist', 'Booked ✓' and 'Waitlisted #2' respectively\",\n      \"when\": \"The Schedule screen is displayed\"\n     },\n     {\n      \"given\": \"A session that started 5 minutes ago and a session starting in 8 days\",\n      \"id\": \"AC-26.2\",\n      \"level\": \"ui\",\n      \"then\": \"Both cards show a disabled action button\",\n      \"when\": \"The Schedule screen is displayed for their days\"\n     }\n    ],\n    \"ears\": \"The Schedule screen shall show on each card a primary action button labelled 'Book', 'Join waitlist', 'Booked ✓' or 'Waitlisted #N' according to Alex's state, or a disabled button when the session has started, is cancelled by the studio, or is outside the booking window.\",\n    \"id\": \"REQ-26\",\n    \"op\": \"ADDED\",\n    \"sources\": [\n     \"I-2\",\n     \"I-4\"\n    ]\n   },\n   {\n    \"acceptance\": [\n     {\n      \"given\": \"'Sunrise Vinyasa' on Monday 07:00 with 20 spots and 18 booked\",\n      \"id\": \"AC-27.1\",\n      \"level\": \"ui\",\n      \"then\": \"The card shows 'Booked ✓', the availability label reads '1 spot left', and a toast message \\\"You're booked for Sunrise Vinyasa · Mon 07:00\\\" is displayed with an Undo button\",\n      \"when\": \"The user activates 'Book' on its card\"\n     },\n     {\n      \"given\": \"The booking toast from AC-27.1 is displayed\",\n      \"id\": \"AC-27.2\",\n      \"level\": \"ui\",\n      \"then\": \"The card shows 'Book' again with '2 spots left', and My Bookings shows no Upcoming or Past entry for the class\",\n      \"when\": \"The user activates Undo within 5 seconds\"\n     },\n     {\n      \"given\": \"The user joins a waitlist from a card\",\n      \"id\": \"AC-27.3\",\n      \"level\": \"ui\",\n      \"then\": \"The toast is shown without an Undo button\",\n      \"when\": \"The confirmation toast appears\"\n     }\n    ],\n    \"ears\": \"When Alex books from a Schedule card, the app shall update the card at once and show a toast such as \\\"You're booked for Sunrise Vinyasa · Mon 07:00\\\" with an Undo action available for 5 seconds, while joining a waitlist, cancelling and leaving a waitlist show a confirmation toast without Undo.\",\n    \"id\": \"REQ-27\",\n    \"op\": \"ADDED\",\n    \"sources\": [\n     \"I-2\",\n     \"Q-3\",\n     \"ASM-17\"\n    ]\n   },\n   {\n    \"acceptance\": [\n     {\n      \"given\": \"A selected day with no sessions\",\n      \"id\": \"AC-28.1\",\n      \"level\": \"ui\",\n      \"then\": \"The message 'No classes on this day' is displayed with an icon\",\n      \"when\": \"The Schedule screen shows that day\"\n     },\n     {\n      \"given\": \"A day with only Yoga sessions\",\n      \"id\": \"AC-28.2\",\n      \"level\": \"ui\",\n      \"then\": \"The message 'No classes match your filters' and a Clear filters button are displayed\",\n      \"when\": \"The user selects only the Boxing chip\"\n     },\n     {\n      \"given\": \"Reading stored data fails\",\n      \"id\": \"AC-28.3\",\n      \"level\": \"ui\",\n      \"then\": \"An inline error message with a Retry button is displayed and no raw error text or stack trace is shown\",\n      \"when\": \"The Schedule screen loads\"\n     }\n    ],\n    \"ears\": \"The Schedule screen shall show skeleton cards while loading, 'No classes on this day' when the day has no sessions, 'No classes match your filters' with a Clear filters action when filters exclude every session, and an inline error message with Retry when loading fails.\",\n    \"id\": \"REQ-28\",\n    \"op\": \"ADDED\",\n    \"sources\": [\n     \"I-2\",\n     \"I-3\"\n    ]\n   },\n   {\n    \"acceptance\": [\n     {\n      \"given\": \"Schedule shows next Thursday with the Yoga filter selected\",\n      \"id\": \"AC-29.1\",\n      \"level\": \"ui\",\n      \"then\": \"The Schedule screen is displayed with next Thursday selected and the Yoga chip shown selected\",\n      \"when\": \"The user opens a card's Class Detail and then activates Back\"\n     },\n     {\n      