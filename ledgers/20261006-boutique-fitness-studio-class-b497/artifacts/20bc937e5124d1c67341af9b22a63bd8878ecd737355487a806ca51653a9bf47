t.\"\n  ],\n  \"nfrs\": [\n   {\n    \"id\": \"NFR-1\",\n    \"metric\": \"Time from day-chip tap to cards rendered < 1000 ms, measured in Chrome DevTools with 4× CPU throttling, median of 5 runs\",\n    \"text\": \"The Schedule for a selected day renders with seed data on a mid-range phone.\"\n   },\n   {\n    \"id\": \"NFR-2\",\n    \"metric\": \"Button/card state change visible ≤ 100 ms after tap, measured with a Performance trace, 95th percentile over 20 taps\",\n    \"text\": \"Book, cancel, join-waitlist and leave-waitlist actions give visual feedback optimistically.\"\n   },\n   {\n    \"id\": \"NFR-3\",\n    \"metric\": \"Contrast ≥ 4.5:1 for normal text, ≥ 3:1 for large text and UI components; 0 failures in an axe-core scan of all 3 screens in both themes\",\n    \"text\": \"All text and UI component colour pairs meet WCAG 2.1 AA in light and dark themes.\"\n   },\n   {\n    \"id\": \"NFR-4\",\n    \"metric\": \"100% of interactive elements have a hit area ≥ 44 × 44 CSS px at 360 px width\",\n    \"text\": \"Interactive targets are large enough for touch.\"\n   },\n   {\n    \"id\": \"NFR-5\",\n    \"metric\": \"Median time from app open to confirmed booking ≤ 30 s across 5 test participants\",\n    \"text\": \"Members can find and book a class quickly.\"\n   },\n   {\n    \"id\": \"NFR-6\",\n    \"metric\": \"End-to-end test passes on 100% of the latest 2 versions of Chrome, Edge, Safari and Firefox\",\n    \"text\": \"The app works in supported browsers (ASM-12).\"\n   },\n   {\n    \"id\": \"NFR-7\",\n    \"metric\": \"0 outbound network requests carrying booking or member data during the end-to-end test run\",\n    \"text\": \"Member and booking data stays on the device (PII).\"\n   },\n   {\n    \"id\": \"NFR-8\",\n    \"metric\": \"Deployed to exactly 1 cloud region\",\n    \"text\": \"Static hosting is in the client's cloud account (ASM-13).\"\n   }\n  ],\n  \"outOfScope\": [\n   \"Sign-in, sign-up and password reset; a single demo member is pre-signed-in (request §12)\",\n   \"Payments, credits, class packs and membership purchase (request §12)\",\n   \"Staff, instructor or admin screens, schedule editing, and any operation for the studio to cancel a class (request §12)\",\n   \"Email, SMS and push notifications (request §12)\",\n   \"Calendar export or sync (request §12)\",\n   \"Multiple studio locations (request §12)\",\n   \"Native mobile apps (request §12)\",\n   \"Multi-language support (request §12)\",\n   \"A backend server or database; persistence is browser local storage only (ASM-15)\",\n   \"Any visible UI for the waitlist promotion demo hook; it is for tests only (ASM-16)\"\n  ],\n  \"requirements\": [\n   {\n    \"acceptance\": [\n     {\n      \"given\": \"'Sunrise Vinyasa' has capacity 20 and booked count 18, starts in 2 days, and Alex holds no other bookings\",\n      \"id\": \"AC-1.1\",\n      \"level\": \"unit\",\n      \"then\": \"the returned booking has status Booked, a booking ID and a created date/time, and the session's booked count value is 19 (1 free spot)\",\n      \"when\": \"the booking module's book operation is called for that session\"\n     },\n     {\n      \"given\": \"the booking from AC-1.1 has been made\",\n      \"id\": \"AC-1.2\",\n      \"level\": \"unit\",\n      \"then\": \"the returned Upcoming list contains the Sunrise Vinyasa booking with status Booked\",\n      \"when\": \"the booking module's getMyBookings operation is called\"\n     }\n    ],\n    \"ears\": \"When the member books a Scheduled class session that has at least one free spot, starts between 15 minutes and 7×24 hours from now, does not overlap another Booked class, and the member holds fewer than 10 upcoming Booked classes, the booking module shall create a booking with status Booked and increase the session's booked count by one.\",\n    \"id\": \"REQ-1\",\n    \"op\": \"ADDED\",\n    \"sources\": [\n     \"I-2\",\n     \"I-4\",\n     \"ASM-6\"\n    ],\n    \"stability\": 0.9\n   },\n   {\n    \"ac