 id: 31, name: \"Grower 1\", type: \"Grower\", targetWeightMinLb: 548, targetWeightMaxLb: 900, operationalStatus: \"Active\", costPerLb: 0.15286, ingredients: SAMPLE_INGREDIENTS },\n  { id: 32, name: \"Finisher 2\", type: \"Finisher\", targetWeightMinLb: 900, targetWeightMaxLb: 1350, operationalStatus: \"Available\", costPerLb: 0.14956, ingredients: [\n    { ...SAMPLE_INGREDIENTS[0], proportionPercent: 65 },\n    { ...SAMPLE_INGREDIENTS[1], proportionPercent: 20 },\n    { ...SAMPLE_INGREDIENTS[2], proportionPercent: 12 },\n    { ...SAMPLE_INGREDIENTS[3], proportionPercent: 3 },\n  ] },\n];\n\nconst SAMPLE_CANDIDATE: RationCandidate = {\n  candidateId: 901,\n  feasible: true,\n  costPerLb: 0.1522,\n  ingredients: [\n    { ...SAMPLE_INGREDIENTS[0], proportionPercent: 57 },\n    { ...SAMPLE_INGREDIENTS[1], proportionPercent: 28 },\n    { ...SAMPLE_INGREDIENTS[2], proportionPercent: 12 },\n    { ...SAMPLE_INGREDIENTS[3], proportionPercent: 3 },\n  ],\n  predictedDryMatterPercent: 89.2,\n  predictedEnergyMcalPerKg: 3.4,\n};\n\nconst SAMPLE_INFEASIBLE: RationCandidate = {\n  candidateId: 902,\n  feasible: false,\n  costPerLb: 0.1486,\n  ingredients: [\n    { ...SAMPLE_INGREDIENTS[0], proportionPercent: 70 },\n    { ...SAMPLE_INGREDIENTS[1], proportionPercent: 18 },\n    { ...SAMPLE_INGREDIENTS[2], proportionPercent: 9 },\n    { ...SAMPLE_INGREDIENTS[3], proportionPercent: 3 },\n  ],\n  predictedDryMatterPercent: 87.4,\n  predictedEnergyMcalPerKg: 3.2,\n};\n\nconst SAMPLE_INVENTORY: InventoryItem[] = SAMPLE_INGREDIENTS.map((ingredient) => ({\n  id: ingredient.itemId,\n  name: ingredient.name,\n  category: \"Feed\",\n  availableQuantity: 100000,\n  unit: \"lb\",\n  unitCost: ingredient.costPerLb,\n  dryMatterPercent: ingredient.dryMatterPercent,\n  energyMcalPerKg: ingredient.energyMcalPerKg,\n  storageLocation: \"Feed storage\",\n  openingStockLb: 100000,\n  receivedStockLb: 0,\n  consumedStockLb: 0,\n  actualWastageLb: 0,\n  closingStockLb: 100000,\n  movements: [],\n}));\n\nconst formatNumber = (value: number, digits = 2) => new Intl.NumberFormat(\"en-US\", { maximumFractionDigits: digits }).format(value);\nconst formatCost = (value: number) => formatNumber(value, 5);\nconst asOption = (ingredient: RationIngredient): IngredientOption => ({ itemId: ingredient.itemId, name: ingredient.name, dryMatterPercent: ingredient.dryMatterPercent, energyMcalPerKg: ingredient.energyMcalPerKg, costPerLb: ingredient.costPerLb });\nconst asRange = (ration: Ration) => `${ration.targetWeightMinLb}-${ration.targetWeightMaxLb}`;\n\nfunction editorFor(ration: Ration | null, ingredients: IngredientOption[] = []): RationEditor {\n  const shares = Object.fromEntries(ingredients.map((ingredient) => [ingredient.itemId, \"0\"]));\n  ration?.ingredients.forEach((ingredient) => { shares[ingredient.itemId] = String(ingredient.proportionPercent); });\n  return {\n    name: ration?.name ?? \"\",\n    type: ration?.type ?? \"\",\n    weightRange: ration ? asRange(ration) : \"\",\n    operationalStatus: ration?.operationalStatus ?? \"Active\",\n    shares,\n  };\n}\n\nfunction FieldError({ children }: { children?: string }) {\n  return children ? <p className=\"text-sm text-destructive\" role=\"alert\">{children}</p> : null;\n}\n\nfunction editorIngredientLabel(name: string) {\n  if (name.toLowerCase().includes(\"corn\")) return \"Corn\";\n  if (name.toLowerCase().includes(\"hay\")) return \"Hay\";\n  if (name.toLowerCase().includes(\"soybean\")) return \"SBM\";\n  if (name.toLowerCase().includes(\"premix\")) return \"Premix\";\n  return name;\n}\n\nfunction NutritionValue({ label, value, unit }: { label: string; value: string; unit: string }) {\n  return <div className=\"grid gap-1 rounded-md bg-muted p-3\">\n    <span className=\"text-xs font-medium text-muted-foreground\">{label}</span>\n    <strong className=\"font-heading text-lg font-semibold\"><span>{value}</span><span className=\"ml-1 text-sm font-normal text-muted-foreground\">{unit}</span></strong>\n  </div>;\n}\n\nfunction IngredientTable({ ingredients, shares, editable, onShareChange }: {\n  ingredients: IngredientOption[];\n  shares?: Record<number, string>;\n  editable?: boolean;\n  onShareChange?: (itemId: number, value: string) => void;\n}) {\n  const sum = ingredients.reduce((total, ingredient) => total + Number(shares?.[ingredient.itemId] ?? 0), 0);\n  return <div className=\"grid gap-2\">\n    <div className=\"flex items-center justify-between gap-3\">\n      <h3 className=\"font-heading text-sm font-semibold\">Ingredient proportions</h3>\n      {(editable || Math.abs(sum - 100) < 0.05) && <span className=\"text-sm text-muted-foreground\">Sum: {formatNumber(sum, 1)}%</span>}\n    </div>\n    <div className=\"overflow-x-auto rounded-md border\">\n      <Table>\n        <TableHeader><TableRow><TableHead>Commodity</TableHead><TableHead>Inv. Cost</TableHead><TableHead>Share</TableHead></TableRow></TableHeader>\n        <TableBody>\n          {ingredients.map((ingredient) => <TableRow key={ingredient.itemId}>\n            <TableCell className=\"font-medium\">{ingredient.name}</TableCell>\n            <TableCell>${formatNumber(ingredient.costPerLb, 3)} /lb</TableCell>\n            <TableCell>{editable ? <div className=\"flex max-w-28 items-center gap-2\">\n              <Input aria-label={`${ingredient.name} share (%)`} type=\"number\" min=\"0\" max=\"100\" step=\"0.1\" value={shares?.[ingredient.itemId] ?? \"0\"} onChange={(event) => onShareChange?.(ingredient.itemId, event.target.value)} />\n              <span>%</span>\n            </div> : <>{formatNumber(Number(shares?.[ingredient.itemId] ?? 0), 1)}%</>}</TableCell>\n          </TableRow>)}\n          {ingredients.length === 0 && <TableRow><TableCell colSpan={3} className=\"text-muted-foreground\">No ingredient details available.</TableCell></TableRow>}\n        </TableBody>\n      </Table>\n    </div>\n  </div>;\n}\n\nfunction CandidateCard({ candidate, onSelect, selected, busy }: { candidate: RationCandidate; onSelect?: () => void; selected?: boolean; busy?: boolean }) {\n  const ingredients = candidate.ingredients;\n  return <Card className={selected ? \"border-primary\" : \"\"}>\n    <CardContent className=\"grid gap-4\">\n      <div className=\"flex flex-wrap items-start justify-between gap-3\">\n        <div>\n          <p className=\"text-xs font-semibold uppercase tracking-wide text-muted-foreground\">Optimizer proposal</p>\n          <h3 className=\"font-heading text-lg font-semibold\">{candidate.feasible ? \"Feasible least-cost candidate\" : \"Infeasible candidate\"}</h3>\n          <StatusBadge tone={candidate.feasible ? \"ok\" : \"warn\"}>{candidate.feasible ? \"Feasible\" : \"Infeasible\"}</StatusBadge>\n        </div>\n        <div className=\"text-right\">\n          <p className=\"font-heading text-xl font-semibold\">{candidate.feasible ? <><span>$</span><span>{formatCost(candidate.costPerLb)}</span> <span className=\"text-sm font-normal text-muted-foreground\">/lb</span></> : <span>Infeasible · ${formatCost(candidate.costPerLb)} /lb</span>}</p>\n          <p className=\"text-xs text-muted-foreground\">Predicted ration cost</p>\n        </div>\n      </div>\n      <div className=\"overflow-x-auto rounded-md border\">\n        <Table>\n          <TableHeader><TableRow><TableHead>Component</TableHead><TableHead>Candidate Proportion</TableHead><TableHead>Predicted Nutrition</TableHead></TableRow></TableHeader>\n          <TableBody>\n            {ingredients.map((ingredient) => <TableRow key={ingredient.itemId}>\n              <TableCell className=\"font-medium\">{`${ingredient.name} · $${formatNumber(ingredient.costPerLb, 3)}/lb`}</TableCell>\n              <TableCell><span>{formatNumber(ingredient.proportionPercent, 1)}</span><span>%</span></TableCell>\n              <TableCell className=\"text-sm\">DM: <span>{formatNumber(candidate.predictedDryMatterPercent, 1)}</span>% · Energy: <span>{formatNumber(candidate.predictedEnergyMcalPerKg, 2)}</span> Mcal/kg</TableCell>\n            </TableRow>)}\n          </TableBody>\n        </Table>\n      </div>\n      {candidate.feasible && <>\n        <Notice>\n          <NoticeTitle>Suggestion only</NoticeTitle>\n          <NoticeDescription>This calculated mix stays unapplied until you select it. Save the ration separately after reviewing the formula.</NoticeDescription>\n        </Notice>\n        <div className=\"flex flex-wrap items-center justify-between gap-3\">\n          <span className=\"text-sm text-muted-foreground\">{selected ? \"Selected for the editor · not saved\" : \"candidate only · unapplied\"}</span>\n          {onSelect && <Button type=\"button\" variant=\"outline\" disabled={busy || selected} onClick={onSelect}>{busy ? \"Selecting…\" : selected ? \"Mix selected\" : \"Select this mix\"}</Button>}\n        </div>\n      </>}\n    </CardContent>\n  </Card>;\n}\n\nexport function RationsContainer({ fixture }: { fixture?: string }) {\n  const fixtureMode = fixture !== undefined;\n  const fixtureValidation = Boolean(fixture && /validation|invalid/i.test(fixture));\n  const fixtureOptimization = Boolean(fixture && /optimizer|feasible|infeasible|optimization/i.test(fixture));\n  const fixtureSelected = Boolean(fixture && /selected|explicitly/i.test(fixture));\n  const fixtureSaved = Boolean(fixture && /saved|ration.list/i.test(fixture));\n  const [rations, setRations] = useState<Ration[]>(fixtureMode ? SAMPLE_RATIONS : []);\n  const [inventory, setInventory] = useState<InventoryItem[]>(fixtureMode ? SAMPLE_INVENTORY : []);\n  const [selectedId, setSelectedId] = useState<number | null>(fixtureMode ? SAMPLE_RATIONS[0].id : null);\n  const [editor, setEditor] = useState<RationEditor>(() => editorFor(fixtureMode ? SAMPLE_RATIONS[0] : null, SAMPLE_INGREDIENTS.map(asOption)));\n  const [dirty, setDirty] = useState(false);\n  const [validation, setValidation] = useState<Record<string, string>>({});\n  const [candidates, setCandidates] = useState<RationCandidate[]>(fixtureOptimization || fixtureSelected ? [SAMPLE_CANDIDATE] : []);\n  const [infeasibleCandidates, setInfeasibleCandidates] = useState<RationCandidate[]>(fixtureOptimization || fixtureSelected ? [SAMPLE_INFEASIBLE] : []);\n  const [selectedCandidate, setSelectedCandidate] = useState<RationCandidate | null>(fixtureSelected ? SAMPLE_CANDIDATE : null);\n  const [saving, setSaving] = useState(false);\n  const [optimizing, setOptimizing] = useState(false);\n  const [selecting, setSelecting] = useState(false);\n  const [loading, setLoading] = useState(!fixtureMode);\n  const [error, setError] = useState(\"\");\n  const [notice, setNotice] = useState(fixtureSaved ? \"Ration saved to the ration list.\" : \"\");\n  const [minimumDryMatter, setMinimumDryMatter] = useState(\"88\");\n  const [minimumEnergy, setMinimumEnergy] = useState(\"3.0\");\n\n  useEffect(() => {\n    if (fixtureMode) {\n      const displayedRations = fixtureSaved\n        ? [...SAMPLE_RATIONS, { ...SAMPLE_RATIONS[1], id: 33, name: \"Optimized Grower\", costPerLb: SAMPLE_CANDIDATE.costPerLb, ingredients: SAMPLE_CANDIDATE.ingredients }]\n        : SAMPLE_RATIONS;\n      const chosen = fixtureSaved ? displayedRations[2] : displayedRations[0];\n      setRations(displayedRations);\n      setInventory(SAMPLE_INVENTORY);\n      setSelectedId(chosen.id);\n      const fixtureEditor = editorFor(chosen, SAMPLE_INGREDIENTS.map(asOption));\n      if (fixtureSelected) fixtureEditor.shares = Object.fromEntries(SAMPLE_INGREDIENTS.map((ingredient) => [ingredient.itemId, String(SAMPLE_CANDIDATE.ingredients.find((entry) => entry.itemId === ingredient.itemId)?.proportionPercent ?? 0)]));\n      if (fixtureValidation) {\n        fixtureEditor.name = \"\";\n        fixtureEditor.weightRange = \"950-650\";\n      }\n      setEditor(fixtureEditor);\n      setDirty(fixtureSelected || fixtureSaved || fixtureValidation);\n      setValidation(fixtureValidation ? { name: \"Enter a ration name.\", weightRange: \"Enter a valid minimum and maximum weight.\", shares: \"Ingredient proportions must total 100%.\" } : {});\n      setCandidates(fixtureOptimization || fixtureSelected ? [SAMPLE_CANDIDATE] : []);\n      setInfeasibleCandidates(fixtureOptimization || fixtureSelected ? [SAMPLE_INFEASIBLE] : []);\n      setSelectedCandidate(fixtureSelected ? SAMPLE_CANDIDATE : null);\n      setNotice(fixtureSaved ? \"Ration saved to the ration list.\" : fixtureSelected ? \"Mix selected for the editor. Save the ration to add it to the list.\" : \"\");\n      setLoading(false);\n      return;\n    }\n\n    let active = true;\n    const load = async () => {\n      setLoading(true);\n      setError(\"\");\n      try {\n        const [rationResponse, inventoryResponse] = await Promise.all([getRations(), getInventoryItems()]);\n        if (rationResponse.status !== 200) throw new Error(\"Rations could not be loaded.\");\n        if (!active) return;\n        const rationData = rationResponse.data.rations;\n        const inventoryData = inventoryResponse.status === 200 ? inventoryResponse.data.items : [];\n        const optionMap = new Map<number, IngredientOption>();\n","chars":14527,"exitCode":0}
