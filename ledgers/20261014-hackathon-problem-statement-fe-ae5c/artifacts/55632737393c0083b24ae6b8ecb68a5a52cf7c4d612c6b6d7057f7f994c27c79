ed · New commodity load\", wastageCause: null };\n        sample = { ...sample, items: sample.items.map((item) => item.id === 11 ? { ...item, availableQuantity: item.availableQuantity + savedMovement.quantityLb, receivedStockLb: item.receivedStockLb + savedMovement.quantityLb, closingStockLb: item.closingStockLb + savedMovement.quantityLb, movements: [savedMovement, ...item.movements] } : item) };\n        if (corn) setSelectedItemId(corn.id);\n      }\n      setData(sample);\n      setLoading(false);\n      return;\n    }\n\n    let active = true;\n    const load = async () => {\n      setError(\"\");\n      try {\n        const response = await getInventoryItems();\n        if (response.status !== 200) throw new Error(\"Inventory could not be loaded.\");\n        if (!active) return;\n        setData(response.data);\n        const firstItemId = response.data.items[0]?.id ?? null;\n        setSelectedItemId(firstItemId);\n        setMovementItemId(firstItemId === null ? \"\" : String(firstItemId));\n        setWastageItemId(firstItemId === null ? \"\" : String(firstItemId));\n      } catch {\n        if (active) {\n          setData(null);\n          setError(\"Feed inventory could not be loaded. Try again in a moment.\");\n        }\n      } finally {\n        if (active) setLoading(false);\n      }\n    };\n    void load();\n    return () => { active = false; };\n  }, [fixture, fixtureMode, fixtureActualWastage, fixtureMovementSaved]);\n\n  const items = data?.items ?? [];\n  const selectedItem = items.find((item) => item.id === selectedItemId) ?? items[0] ?? null;\n  const visibleItems = useMemo(() => items.filter((item) => `${item.name} ${item.category} ${item.storageLocation}`.toLowerCase().includes(search.toLowerCase())), [items, search]);\n  const movements = useMemo(() => items.flatMap((item) => item.movements.map((movement) => ({ ...movement, itemName: item.name, storageLocation: item.storageLocation }))).sort((a, b) => b.date.localeCompare(a.date) || b.id - a.id), [items]);\n\n  const handleMovementSubmit = async (event: FormEvent<HTMLFormElement>) => {\n    event.preventDefault();\n    const validation: string[] = [];\n    const quantity = Number(movementQuantity);\n    if (!validDate(movementDate)) validation.push(\"Enter a valid date.\");\n    if (!Number.isFinite(quantity) || quantity <= 0) validation.push(\"Quantity must be greater than zero.\");\n    if (!movementNote.trim()) validation.push(\"Enter a note for this movement.\");\n    setMovementValidation(validation);\n    setMovementNotice(\"\");\n    if (validation.length) return;\n    const request = { itemId: Number(movementItemId), movementType, date: movementDate, quantityLb: quantity, note: movementNote.trim() };\n    if (fixtureMode) {\n      const item = items.find((entry) => entry.id === request.itemId);\n      if (item) {\n        const movement: InventoryMovement = { id: Date.now(), itemId: item.id, movementType: request.movementType, date: request.date, quantityLb: request.quantityLb, note: request.note, wastageCause: null };\n        const delta = request.movementType === \"received\" ? quantity : -quantity;\n        setData((current) => current ? { ...current, items: current.items.map((entry) => entry.id === item.id ? { ...entry, availableQuantity: entry.availableQuantity + delta, closingStockLb: entry.closingStockLb + delta, receivedStockLb: entry.receivedStockLb + (delta > 0 ? quantity : 0), movements: [movement, ...entry.movements] } : entry) } : current);\n        setMovementNotice(\"Movement saved and reflected in the item balance.\");\n      }\n      return;\n    }\n    setMovementBusy(true);\n    setError(\"\");\n    try {\n      const response = await recordInventoryMovement(request);\n      if (response.status !== 201) {\n        setError(\"The stock movement could not be saved. Review the item, date, quantity, and note.\");\n        return;\n      }\n      setData((current) => current ? { ...current, items: upsertReturnedMovement(current.items, response.data) } : current);\n      setMovementNotice(\"Movement saved and reflected in the item balance.\");\n      setMovementQuantity(\"\");\n      setMovementNote(\"\");\n    } catch {\n      setError(\"The stock movement could not be saved. Try again in a moment.\");\n    } finally {\n      setMovementBusy(false);\n    }\n  };\n\n  const handleWastageSubmit = async (event: FormEvent<HTMLFormElement>) => {\n    event.preventDefault();\n    const validation: string[] = [];\n    const quantity = Number(wastageQuantity);\n    if (!validDate(wastageDate)) validation.push(\"Enter a valid date.\");\n    if (!Number.isFinite(quantity) || quantity <= 0) validation.push(\"Actual wastage must be greater than zero.\");\n    if (!wastageCause.trim()) validation.push(\"Enter a wastage cause or note.\");\n    setWastageValidation(validation);\n    setWastageNotice(\"\");\n    if (validation.length) return;\n    const request: ActualWastageRequest = { itemId: Number(wastageItemId), recordDate: wastageDate, actualWastageLb: quantity, wastageCause: wastageCause.trim() };\n    if (fixtureMode) {\n      const item = items.find((entry) => entry.id === request.itemId);\n      if (item) {\n        const movement: InventoryMovement = { id: Date.now(), itemId: item.id, movementType: \"actual_wastage\", date: request.recordDate, quantityLb: request.actualWastageLb, note: request.wastageCause, wastageCause: request.wastageCause };\n        setData((current) => current ? { ...current, items: current.items.map((entry) => entry.id === item.id ? { ...entry, actualWastageLb: entry.actualWastageLb + quantity, availableQuantity: entry.availableQuantity - quantity, closingStockLb: entry.closingStockLb - quantity, movements: [movement, ...entry.movements] } : entry) } : current);\n        setWastageNotice(\"Actual wastage recorded separately from consumption estimates.\");\n      }\n      return;\n    }\n    setWastageBusy(true);\n    setError(\"\");\n    try {\n      const response = a