electedPen?.name ?? \"Pen\", manager: \"Mara Ortega\",\n      rationId: request.rationId, rationName: ration?.name ?? \"Ration\", feedingPlanId: plan?.id ?? null,\n      plannedQuantityLb: plan?.plannedQuantityLb ?? null, actualQuantityLb: total,\n      varianceLb: plan ? total - plan.plannedQuantityLb : null, status: plan ? \"Completed\" : \"Unplanned\",\n      feedCost: total * (ration?.costPerLb ?? 0), energyMcal: total * 1.21, ingredientConsumption, lotConsumption: lots,\n    };\n    setSelectedActivity(activity);\n    setActivities((current) => [activity, ...current.filter((item) => item.id !== activity.id)]);\n    setShowDetails(true);\n    setHasSavedResult(true);\n    setError(\"\");\n    setErrorDetails([]);\n  };\n\n  const submit = async (event: FormEvent<HTMLFormElement>) => {\n    event.preventDefault();\n    const errors: string[] = [];\n    if (!selectedPen) errors.push(\"Select a pen.\");\n    if (!validDate(activityDate)) errors.push(\"Enter a valid feeding date.\");\n    if (!selectedRation) errors.push(\"Select a ration.\");\n    if (penLots.length === 0) errors.push(\"The selected pen has no eligible lots for feeding.\");\n    const quantities = penLots.map((lot) => ({ lotId: lot.id, actualQuantityLb: Number(lotQuantities[lot.id]) }));\n    if (quantities.some((item) => !Number.isFinite(item.actualQuantityLb) || item.actualQuantityLb <= 0)) {\n      errors.push(\"Enter a separate actual quantity greater than zero for every affected lot.\");\n    }\n    setValidation(errors);\n    setError(\"\");\n    setErrorDetails([]);\n    setHasSavedResult(false);\n    if (errors.length > 0) return;\n    const request: FeedingActivityRequest = {\n      penId: Number(selectedPenId), date: activityDate, rationId: Number(selectedRationId),\n      feedingPlanId: selectedPlanId ? Number(selectedPlanId) : null, lotQuantities: quantities,\n    };\n    if (fixtureMode) {\n      if (fixtureShortage) {\n        setSelectedActivity(null);\n        setError(\"Insufficient inventory to save the requested activity.\");\n        setErrorDetails([\"Requested 1200 lb; 900 lb is available.\"]);\n        return;\n      }\n      saveFixtureActivity(request);\n      return;\n    }\n    setBusy(true);\n    setSelectedActivity(null);\n    try {\n      const response = await recordFeedingActivity(request);\n      if (response.status !== 201) {\n        const failure = activityError(response.data, \"The feeding activity could not be saved.\");\n        setError(failure.message);\n        setErrorDetails(failure.details);\n        return;\n      }\n      const activity = response.data.activity;\n      setSelectedActivity(activity);\n      setShowDetails(true);\n      setHasSavedResult(true);\n      setActivities((current) => [activity, ...current.filter((item) => item.id !== activity.id)]);\n      try {\n        const refreshed = await getFeedingActivities();\n        if (refreshed.status === 200) {\n          setActivities((current) => [activity, ...refreshed.data.activities.filter((item) => item.id !== activity.id)]);\n        }\n      } catch {\n        // Keep the returned activity visible if refreshing the log is temporarily unavailable.\n      }\n    } catch {\n      setError(\"The feeding activity could not be saved. Try again in a moment.\");\n    } finally {\n      setBusy(false);\n    }\n  };\n\n  return <main data-screen=\"S-8\" data-state={fixture ?? \"default\"} className=\"mx-auto grid w-full max-w-7xl content-start gap-6 p-4 sm:gap-8 sm:p-6\">\n    <div className=\"flex flex-col justify-between gap-3 border-b pb-4 sm:flex-row sm:items-end\">\n      <div><h1 className=\"font-heading text-3xl font-semibold tracking-tight\">Feeding log</h1></div>\n      <div className=\"flex flex-wrap items-center gap-2 text-sm text-muted-foreground\"><span>Facility: Cedar Draw Feedlot</span><span aria-hidden=\"true\">·</span><span>Sample date: <span className=\"font-mono text-foreground\">{facilityDate}</span></span><span aria-hidden=\"true\">·</spa