t\">Annual outlook</TableHead><TableHead className=\"text-center\">Status</TableHead></TableRow></TableHeader>","                <TableBody>","                  {visibleItems.map((item) => <TableRow key={item.id} onClick={() => setSelectedItemId(item.id)} className={`cursor-pointer ${selectedItem?.id === item.id ? \"bg-muted/50\" : \"\"}`}>","                    <TableCell className=\"font-semibold\"><button type=\"button\" onClick={() => setSelectedItemId(item.id)} className=\"text-left\">{item.name}<span className=\"block text-xs font-normal text-muted-foreground\">{item.category}</span></button></TableCell>","                    <TableCell className=\"whitespace-nowrap text-right font-mono\">{money(item.unitCost)} /{item.unit}</TableCell>","                    <TableCell className=\"whitespace-nowrap text-right font-mono font-semibold\">{number(item.availableQuantity)} {item.unit}</TableCell>","                    <TableCell className=\"whitespace-nowrap text-right font-mono text-muted-foreground\">{fixtureMode ? number(SAMPLE_ANNUAL_OUTLOOK[item.id] ?? 0) : \"—\"} {fixtureMode ? \"lb\" : \"\"}</TableCell>","                    <TableCell className=\"text-center\"><StatusBadge tone={statusOf(item.availableQuantity)}>{item.availableQuantity > 0 ? \"good\" : \"out of stock\"}</StatusBadge></TableCell>","                  </TableRow>)}","                  {visibleItems.length === 0 && <TableRow><TableCell colSpan={5} className=\"py-8 text-center text-muted-foreground\">No feed items match this search.</TableCell></TableRow>}","                </TableBody>","              </Table>","            </div>","          </CardContent>","          <div className=\"flex flex-col justify-between gap-2 border-t bg-muted/30 p-3 text-xs text-muted-foreground sm:flex-row\"><span>Opening, received, consumed, actual wastage, and closing balances are shown in item details.</span><span className=\"font-mono\">Estimated wastage: {number((data.wastageRatio ?? 0) * 100)}%</span></div>","