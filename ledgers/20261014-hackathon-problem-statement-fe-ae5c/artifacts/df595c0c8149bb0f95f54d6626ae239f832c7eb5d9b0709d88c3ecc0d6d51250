{"files":[{"added":["import { useEffect, useMemo, useState, type FormEvent, type ReactNode } from \"react\";","import { Button } from \"@/components/ui/button\";","import { Card, CardContent, CardHeader, CardTitle } from \"@/components/ui/card\";","import { Input } from \"@/components/ui/input\";","import { Label } from \"@/components/ui/label\";","import { Notice, NoticeDescription, NoticeTitle } from \"@/components/ui/notice\";","import { Skeleton } from \"@/components/ui/skeleton\";","import { StatusBadge } from \"@/components/ui/status-badge\";","import { Table, TableBody, TableCell, TableHead, TableHeader, TableRow } from \"@/components/ui/table\";","import { getInventoryItems, recordActualWastage, recordInventoryMovement } from \"@/lib/api/client\";","import type { ActualWastageRequest, InventoryItem, InventoryMovement, InventoryMovementRequestMovementType, InventoryOkResponse, MovementCreatedResponse } from \"@/lib/api/client.schemas\";","","const SAMPLE_INVENTORY: InventoryOkResponse = {","  wastageRatio: 0.042,","  items: [","    { id: 11, name: \"Yellow corn\", category: \"Grain\", availableQuantity: 680000, unit: \"lb\", unitCost: 0.112, dryMatterPercent: 88, energyMcalPerKg: 3.3, storageLocation: \"Grain storage bin 1\", openingStockLb: 675000, receivedStockLb: 12000, consumedStockLb: 6500, actualWastageLb: 500, closingStockLb: 680000, movements: [{ id: 701, itemId: 11, movementType: \"received\", date: \"2025-04-18\", quantityLb: 12000, note: \"Received commodity load · Grain storage bin 1\", wastageCause: null }] },","    { id: 12, name: \"Alfalfa hay\", category: \"Forage\", availableQuantity: 390000, unit: \"lb\", unitCost: 0.145, dryMatterPercent: 91, energyMcalPerKg: 2.1, storageLocation: \"Barn B\", openingStockLb: 394216, receivedStockLb: 0, consumedStockLb: 4100, actualWastageLb: 116, closingStockLb: 390000, movements: [{ id: 702, itemId: 12, movementType: \"actual_wastage\", date: \"2025-04-22\", quantityLb: 116, note: \"Bunk cleanout & spoil\", wastageCause: \"Bunk cleanout & spoil\" }] },","    { id: 13, name: \"Soybean meal\", category: \"Protein\", availableQuantity: 170000, unit: \"lb\", unitCost: 0.238, dryMatterPercent: 89, energyMcalPerKg: 3, storageLocation: \"Protein shed\", openingStockLb: 170000, receivedStockLb: 0, consumedStockLb: 0, actualWastageLb: 0, closingStockLb: 170000, movements: [] },","    { id: 14, name: \"Mineral premix\", category: \"Supplement\", availableQuantity: 42000, unit: \"lb\", unitCost: 0.64, dryMatterPercent: 95, energyMcalPerKg: 1.4, storageLocation: \"Feed room\", openingStockLb: 42000, receivedStockLb: 0, consumedStockLb: 0, actualWastageLb: 0, closingStockLb: 42000, movements: [] },","  ],","};","","const SAMPLE_ANNUAL_OUTLOOK: Record<number, number> = { 11: 69689, 12: 56831, 13: 36732, 14: 8683 };","const number = (value: number) => new Intl.NumberFormat(\"en-US\", { maximumFractionDigits: 2 }).format(value);","const money = (value: number) => `$${String(value)}`;","const statusOf = (quantity: number): \"bad\" | \"warn\" | \"ok\" => quantity <= 0 ? \"bad\" : quantity < 10000 ? \"warn\" : \"ok\";","const statusLabel = (value: string) => value.replaceAll(\"_\", \" \");","const movementLabel = (type: InventoryMovement[\"movementType\"]) => ({ opening: \"Opening stock\", received: \"Received commodity load\", consumed: \"Feed consumption\", actual_wastage: \"Actual wastage logged\", adjustment: \"Stock adjustment\" })[type];","const validDate = (value: string) => /^\\d{4}-\\d{2}-\\d{2}$/.test(value) && !Number.isNaN(new Date(`${value}T12:00:00Z`).valueOf()) && new Date(`${value}T12:00:00Z`).toISOString().slice(0, 10) === value;","","function upsertReturnedMovement(items: InventoryItem[], result: MovementCreatedResponse) {","  const movementList = [result.movement, ...result.item.movements.filter((movement) => movement.id !== result.movement.id)];","  const returnedItem = { ...result.item, movements: movementList };","  return items.some((item) => item.id === returnedItem.id)","    ? items.map((item) => item.id === returnedItem.id ? returnedItem : item)","    : [...items, returnedItem];","}","","function FieldError({ children }: { children?: string }) {","  return children ? <p className=\"text-sm text-destructive\" role=\"alert\">{children}</p> : null;","}","","function StockStat({ label, value, detail }: { label: string; value: ReactNode; detail?: string }) {","  return <div className=\"grid min-w-0 gap-1\"><span className=\"text-xs font-semibold uppercase tracking-wide text-muted-foreground\">{label}</span><strong className=\"font-heading text-xl font-semibold leading-tight sm:text-2xl\">{value}</strong>{detail && <span className=\"text-xs text-muted-foreground\">{detail}</span>}</div>;","}","","  const fixtureMode = fixture !== undefined;","  const fixtureValidation = Boolean(fixture && /validation|invalid/i.test(fixture));","  const fixtureActualWastage = Boolean(fixture && /actual.wastage/i.test(fixture));","  const fixtureMovementSaved = Boolean(fixture && /movement.saved|saved.and.reflected/i.test(fixture));","  const [data, setData] = useState<InventoryOkResponse | null>(SAMPLE_INVENTORY);","  const [selectedItemId, setSelectedItemId] = useState<number | null>(SAMPLE_INVENTORY.items[0]?.id ?? null);","  const [movementItemId, setMovementItemId] = useState(String(SAMPLE_INVENTORY.items[0]?.id ?? \"\"));","  const [wastageItemId, setWastageItemId] = useState(String(SAMPLE_INVENTORY.items[0]?.id ?? \"\"));","  const [movementType, setMovementType] = useState<InventoryMovementRequestMovementType>(\"received\");","  const [movementDate, setMovementDate] = useState(\"\");","  const [movementQuantity, setMovementQuantity] = useState(\"\");","  const [movementNote, setMovementNote] = useState(\"\");","  const [wastageDate, setWastageDate] = useState(\"\");","  const [wastageQuantity, setWastageQuantity] = useState(\"\");","  const [wastageCause, setWastageCause] = useState(\"\");","  const [movementValidation, setMovementValidation] = useState<string[]>(fixtureValidation ? [\"Enter a valid date.\", \"Quantity must be greater than zero.\"] : []);","  const [wastageValidation, setWastageValidation] = useState<string[]>(fixtureValidation ? [\"Enter a valid date.\", \"Actual wastage must be greater than zero.\", \"Enter a wastage cause or note.\"] : []);","  const [movementBusy, setMovementBusy] = useState(false);","  const [wastageBusy, setWastageBusy] = useState(false);","  const [loading, setLoading] = useState(false);","  const [error, setError] = useState(\"\");","  const [movementNotice, setMovementNotice] = useState(\"\");","  const [wastageNotice, setWastageNotice] = useState(\"\");","  const [search, setSearch] = useState(\"\");","","  useEffect(() => {","    if (fixtureMode) {","      let sample = SAMPLE_INVENTORY;","      if (fixtureActualWastage) {","        const corn = sample.items[0];","        const savedMovement: InventoryMovement = { id: 703, itemId: 11, movementType: \"actual_wastage\", date: \"2025-04-23\", quantityLb: 116, note: \"Actual wastage recorded · Bunk cleanout\", wastageCause: \"Bunk cleanout\" };","        sample = { ...sample, items: sample.items.map((item) => item.id === 11 ? { ...item, actualWastageLb: item.actualWastageLb + savedMovement.quantityLb, closingStockLb: item.closingStockLb - savedMovement.quantityLb, availableQuantity: item.availableQuantity - savedMovement.quantityLb, movements: [savedMovement, ...item.movements] } : item) };","        if (corn) setSelectedItemId(corn.id);","      } else if (fixtureMovementSaved) {","        const corn = sample.items[0];","        const savedMovement: InventoryMovement = { id: 704, itemId: 11, movementType: \"received\", date: \"2025-04-23\", quantityLb: 8000, note: \"Movement saved · New commodity load\", wastageCause: null };","        sample = { ...sample, items: sample.items.map((item) => item.id === 11 ? { ...item, availableQuantity: item.availableQuantity + savedMovement.quantityLb, receivedStockLb: item.receivedStockLb + savedMovement.quantityLb, closingStockLb: item.closingStockLb + savedMovement.quantityLb, movements: [savedMovement, ...item.movements] } : item) };","        if (corn) setSelectedItemId(corn.id);","      }","      setData(sample);","      setLoading(false);","      return;","    }","","    let active = true;","    const load = async () => {","      setError(\"\");","      try {","        const response = await getInventoryItems();","        if (response.status !== 200) throw new Error(\"Inventory could not be loaded.\");","        if (!active) return;","        setData(response.data);","        const firstItemId = response.data.items[0]?.id ?? null;","        setSelectedItemId(firstItemId);","        setMovementItemId(firstItemId === null ? \"\" : String(firstItemId));","        setWastageItemId(firstItemId === null ? \"\" : String(firstItemId));","      } catch {","        if (active) {","          setData(null);","          setError(\"Feed inventory could not be loaded. Try again in a moment.\");","        }","      } finally {","        if (active) setLoading(false);","      }","    };","    void load();","    return () => { active = false; };","  }, [fixture, fixtureMode, fixtureActualWastage, fixtureMovementSaved]);","","  const items = data?.items ?? [];","  const selectedItem = items.find((item) => item.id === selectedItemId) ?? items[0] ?? null;","  const visibleItems = useMemo(() => items.filter((item) => `${item.name} ${item.category} ${item.storageLocation}`.toLowerCase().includes(search.toLowerCase())), [items, search]);","  const movements = useMemo(() => items.flatMap((item) => item.movements.map((movement) => ({ ...movement, itemName: item.name, storageLocation: item.storageLocation }))).sort((a, b) => b.date.localeCompare(a.date) || b.id - a.id), [items]);","","  const handleMovementSubmit = async (event: FormEvent<HTMLFormElement>) => {","    event.preventDefault();","    const validation: string[] = [];","    const quantity = Number(movementQuantity);","    if (!validDate(movementDate)) validation.push(\"Enter a valid date.\");","    if (!Number.isFinite(quantity) || quantity <= 0) validation.push(\"Quantity must be greater than zero.\");","    if (!movementNote.trim()) validation.push(\"Enter a note for this movement.\");","    setMovementValidation(validation);","    setMovementNotice(\"\");","    if (validation.length) return;","    const request = { itemId: Number(movementItemId), movementType, date: movementDate, quantityLb: quantity, note: movementNote.trim() };","    if (fixtureMode) {","      const item = items.find((entry) => entry.id === request.itemId);","      if (item) {","        const movement: InventoryMovement = { id: Date.now(), itemId: item.id, movementType: request.movementType, date: request.date, quantityLb: request.quantityLb, note: request.note, wastageCause: null };","        const delta = request.movementType === \"received\" ? quantity : -quantity;","        setData((current) => current ? { ...current, items: current.items.map((entry) => entry.id === item.id ? { ...entry, availableQuantity: entry.availableQuantity + delta, closingStockLb: entry.closingStockLb + delta, receivedStockLb: entry.receivedStockLb + (delta > 0 ? quantity : 0), movements: [movement, ...entry.movements] } : entry) } : current);","        setMovementNotice(\"Movement saved and reflected in the item balance.\");","      }","      return;","    }","    setMovementBusy(true);","    setError(\"\");","    try {","      const response = await recordInventoryMovement(request);","      if (response.status !== 201) {","        setError(\"The stock movement could not be saved. Review the item, date, quantity, and note.\");","        return;","      }","      setData((current) => current ? { ...current, items: upsertReturnedMovement(current.items, response.data) } : current);","      setMovementNotice(\"Movement saved and reflected in the item balance.\");","      setMovementQuantity(\"\");","      setMovementNote(\"\");","    } catch {","      setError(\"The stock movement could not be saved. Try again in a moment.\");","    } finally {","      setMovementBusy(false);","    }","  };","","  const handleWastageSubmit = async (event: FormEvent<HTMLFormElement>) => {","    event.preventDefault();","    const validation: string[] = [];","    const quantity = Number(wastageQuantity);","    if (!validDate(wastageDate)) validation.push(\"Enter a valid date.\");","    if (!Number.isFinite(quantity) || quantity <= 0) validation.push(\"Actual wastage must be greater than zero.\");","    if (!wastageCause.trim()) validation.push(\"Enter a wastage cause or note.\");","    setWastageValidation(validation);","    setWastageNotice(\"\");","    if (validation.length) return;","    const request: ActualWastageRequest = { itemId: Number(wastageItemId), recordDate: wastageDate, actualWastageLb: quantity, wastageCause: wastageCause.trim() };","    if (fixtureMode) {","      const item = items.find((entry) => entry.id === request.itemId);","      if (item) {","        const movement: InventoryMovement = { id: Date.now(), itemId: item.id, movementType: \"actual_wastage\", date: request.recordDate, quantityLb: request.actualWastageLb, note: request.wastageCause, wastageCause: request.wastageCause };","        setData((current) => current ? { ...current, items: current.items.map((entry) => entry.id === item.id ? { ...entry, actualWastageLb: entry.actualWastageLb + quantity, availableQuantity: entry.availableQuantity - quantity, closingStockLb: entry.closingStockLb - quantity, movements: [movement, ...entry.movements] } : entry) } : current);","        setWastageNotice(\"Actual wastage recorded separately from consumption estimates.\");","      }","      return;","    }","    setWastageBusy(true);","    setError(\"\");","    try {","      const response = await recordActualWastage(request);","      if (response.status !== 201) {","        setError(\"Actual wastage could not be recorded. Review the item, date, quantity, and cause.\");","        return;","      }","      setData((current) => current ? { ...current, items: upsertReturnedMovement(current.items, response.data) } : current);","      setWastageNotice(\"Actual wastage recorded separately from consumption estimates.\");","      setWastageQuantity(\"\");","      setWastageCause(\"\");","    } catch {","      setError(\"Actual wastage could not be recorded. Try again in a moment.\");","    } finally {","      setWastageBusy(false);","    }","  };","","  const state = fixture ?? (loading ? \"loading\" : \"default\");","  return <main data-screen=\"S-4\" data-state={state} className=\"mx-auto grid w-full max-w-7xl flex-1 content-start gap-5 p-4 md:gap-6 md:p-6\">","    <header className=\"flex flex-col justify-between gap-2 border-b pb-4 sm:flex-row sm:items-baseline\">","      <h1 className=\"font-heading text-3xl font-semibold tracking-tight\">Feed inventory</h1>","      <p className=\"flex items-center gap-2 text-sm text-muted-foreground\"><span className=\"size-2 rounded-full bg-success\" />As of {fixtureMode ? \"23 Apr 2025\" : new Intl.DateTimeFormat(\"en-GB\", { day: \"2-digit\", month: \"short\", year: \"numeric\", timeZone: \"America/Denver\" }).format(new Date())}<span>·</span>America/Denver</p>","    </header>","","    {error && <Notice tone=\"bad\"><NoticeTitle>Inventory update</NoticeTitle><NoticeDescription>{error}</NoticeDescription></Notice>}","    {loading && <div className=\"grid gap-4 lg:grid-cols-3\"><Skeleton className=\"h-48\" /><Skeleton className=\"h-48\" /><Skeleton className=\"h-48\" /></div>}","","    {!loading && selectedItem && data && <>","      <Card>","        <CardContent className=\"grid gap-6 p-4 sm:p-6 lg:grid-cols-3\">","          <div className=\"grid content-between gap-5 lg:col-span-2\">","            <div>","              <div className=\"mb-1 flex flex-wrap items-center gap-2\"><span className=\"text-xs font-semibold uppercase tracking-wide text-muted-foreground\">Active Selection</span><StatusBadge tone={statusOf(selectedItem.availableQuantity)}>{selectedItem.availableQuantity > 0 ? \"good\" : \"out of stock\"}</StatusBadge></div>","              <h2 className=\"font-heading text-2xl font-semibold tracking-tight\">{selectedItem.name}</h2>","              <p className=\"text-sm text-muted-foreground\">{selectedItem.category} · Stored at {selectedItem.storageLocation}</p>","            </div>","            <div className=\"grid grid-cols-2 gap-5 border-t pt-4 sm:grid-cols-3\">","              <StockStat label=\"Unit price\" value={<span>$<span>{String(selectedItem.unitCost)}</span></span>} detail={`per ${selectedItem.unit}`} />","              <StockStat label=\"Current stock\" value={number(selectedItem.availableQuantity)} detail={selectedItem.unit} />","              <StockStat label=\"Projected balance\" value=\"Not available\" detail=\"annual outlook\" />","            </div>","            <div className=\"grid gap-2 border-t pt-4 text-sm sm:grid-cols-2 lg:grid-cols-4\">","              <p><span className=\"text-muted-foreground\">Available quantity</span><br /><strong>{number(selectedItem.availableQuantity)} {selectedItem.unit}</strong></p>","              <p><span className=\"text-muted-foreground\">Unit cost</span><br /><strong>{money(selectedItem.unitCost)} /{selectedItem.unit}</strong></p>","              <p><span className=\"text-muted-foreground\">Dry matter</span><br /><strong>{number(selectedItem.dryMatterPercent)}%</strong></p>","              <p><span className=\"text-muted-foreground\">Energy</span><br /><strong>{number(selectedItem.energyMcalPerKg)} Mcal/kg</strong></p>","              <p><span className=\"text-muted-foreground\">Storage location</span><br /><strong>{selectedItem.storageLocation}</strong></p>","            </div>","          </div>","          <section className=\"grid content-start gap-2 rounded-md border bg-muted/30 p-4\" aria-labelledby=\"nutrition-title\">","            <h3 id=