{"files":[{"added":["import { useEffect, useMemo, useState, type FormEvent } from \"react\";","import { Button } from \"@/components/ui/button\";","import { Card, CardContent, CardHeader, CardTitle } from \"@/components/ui/card\";","import { Input } from \"@/components/ui/input\";","import { Label } from \"@/components/ui/label\";","import { Notice, NoticeDescription, NoticeTitle } from \"@/components/ui/notice\";","import { Skeleton } from \"@/components/ui/skeleton\";","import { StatusBadge } from \"@/components/ui/status-badge\";","import { Table, TableBody, TableCell, TableHead, TableHeader, TableRow } from \"@/components/ui/table\";","import { createRation, getInventoryItems, getRations, optimizeRation, selectRationCandidate } from \"@/lib/api/client\";","import type { InventoryItem, Ration, RationCandidate, RationIngredient, RationOptimizationRequest } from \"@/lib/api/client.schemas\";","","type IngredientOption = Pick<RationIngredient, \"itemId\" | \"name\" | \"dryMatterPercent\" | \"energyMcalPerKg\" | \"costPerLb\">;","type RationEditor = { name: string; type: string; weightRange: string; operationalStatus: string; shares: Record<number, string> };","","const SAMPLE_INGREDIENTS: RationIngredient[] = [","  { itemId: 11, name: \"Yellow corn\", proportionPercent: 55, dryMatterPercent: 88, energyMcalPerKg: 3.3, costPerLb: 0.112 },","  { itemId: 12, name: \"Alfalfa hay\", proportionPercent: 30, dryMatterPercent: 91, energyMcalPerKg: 2.1, costPerLb: 0.145 },","  { itemId: 13, name: \"Soybean meal\", proportionPercent: 12, dryMatterPercent: 89, energyMcalPerKg: 3, costPerLb: 0.238 },","  { itemId: 14, name: \"Mineral premix\", proportionPercent: 3, dryMatterPercent: 95, energyMcalPerKg: 1.4, costPerLb: 0.64 },","];","","const SAMPLE_RATIONS: Ration[] = [","  { id: 31, name: \"Grower 1\", type: \"Grower\", targetWeightMinLb: 548, targetWeightMaxLb: 900, operationalStatus: \"Active\", costPerLb: 0.15286, ingredients: SAMPLE_INGREDIENTS },","  { id: 32, name: \"Finisher 2\", type: \"Finisher\", targetWeightMinLb: 900, targetWeightMaxLb: 1350, operationalStatus: \"Available\", costPerLb: 0.14956, ingredients: [","    { ...SAMPLE_INGREDIENTS[0], proportionPercent: 65 },","    { ...SAMPLE_INGREDIENTS[1], proportionPercent: 20 },","    { ...SAMPLE_INGREDIENTS[2], proportionPercent: 12 },","    { ...SAMPLE_INGREDIENTS[3], proportionPercent: 3 },","  ] },","];","","const SAMPLE_CANDIDATE: RationCandidate = {","  candidateId: 901,","  feasible: true,","  costPerLb: 0.1522,","  ingredients: [","    { ...SAMPLE_INGREDIENTS[0], proportionPercent: 57 },","    { ...SAMPLE_INGREDIENTS[1], proportionPercent: 28 },","    { ...SAMPLE_INGREDIENTS[2], proportionPercent: 12 },","    { ...SAMPLE_INGREDIENTS[3], proportionPercent: 3 },","  ],","  predictedDryMatterPercent: 89.2,","  predictedEnergyMcalPerKg: 3.4,","};","","const SAMPLE_INFEASIBLE: RationCandidate = {","  candidateId: 902,","  feasible: false,","  costPerLb: 0.1486,","  ingredients: [","    { ...SAMPLE_INGREDIENTS[0], proportionPercent: 70 },","    { ...SAMPLE_INGREDIENTS[1], proportionPercent: 18 },","    { ...SAMPLE_INGREDIENTS[2], proportionPercent: 9 },","    { ...SAMPLE_INGREDIENTS[3], proportionPercent: 3 },","  ],","  predictedDryMatterPercent: 87.4,","  predictedEnergyMcalPerKg: 3.2,","};","","const SAMPLE_INVENTORY: InventoryItem[] = SAMPLE_INGREDIENTS.map((ingredient) => ({","  id: ingredient.itemId,","  name: ingredient.name,","  category: \"Feed\",","  availableQuantity: 100000,","  unit: \"lb\",","  unitCost: ingredient.costPerLb,","  dryMatterPercent: ingredient.dryMatterPercent,","  energyMcalPerKg: ingredient.energyMcalPerKg,","  storageLocation: \"Feed storage\",","  openingStockLb: 100000,","  receivedStockLb: 0,","  consumedStockLb: 0,","  actualWastageLb: 0,","  closingStockLb: 100000,","  movements: [],","}));","","const formatNumber = (value: number, digits = 2) => new Intl.NumberFormat(\"en-US\", { maximumFractionDigits: digits }).format(value);","const formatCost = (value: number) => formatNumber(value, 5);","const asOption = (ingredient: RationIngredient): IngredientOption => ({ itemId: ingredient.itemId, name: ingredient.name, dryMatterPercent: ingredient.dryMatterPercent, energyMcalPerKg: ingredient.energyMcalPerKg, costPerLb: ingredient.costPerLb });","const asRange = (ration: Ration) => `${ration.targetWeightMinLb}-${ration.targetWeightMaxLb}`;","","function editorFor(ration: Ration | null, ingredients: IngredientOption[] = []): RationEditor {","  const shares = Object.fromEntries(ingredients.map((ingredient) => [ingredient.itemId, \"0\"]));","  ration?.ingredients.forEach((ingredient) => { shares[ingredient.itemId] = String(ingredient.proportionPercent); });","  return {","    name: ration?.name ?? \"\",","    type: ration?.type ?? \"\",","    weightRange: ration ? asRange(ration) : \"\",","    operationalStatus: ration?.operationalStatus ?? \"Active\",","    shares,","  };","}","","function FieldError({ children }: { children?: string }) {","  return children ? <p className=\"text-sm text-destructive\" role=\"alert\">{children}</p> : null;","}","","function editorIngredientLabel(name: string) {","  if (name.toLowerCase().includes(\"corn\")) return \"Corn\";","  if (name.toLowerCase().includes(\"hay\")) return \"Hay\";","  if (name.toLowerCase().includes(\"soybean\")) return \"SBM\";","  if (name.toLowerCase().includes(\"premix\")) return \"Premix\";","  return name;","}","","function NutritionValue({ label, value, unit }: { label: string; value: string; unit: string }) {","  return <div className=\"grid gap-1 rounded-md bg-muted p-3\">","    <span className=\"text-xs font-medium text-muted-foreground\">{label}</span>","    <strong className=\"font-heading text-lg font-semibold\"><span>{value}</span><span className=\"ml-1 text-sm font-normal text-muted-foreground\">{unit}</span></strong>","  </div>;","}","","function IngredientTable({ ingredients, shares, editable, onShareChange }: {","  ingredients: IngredientOption[];","  shares?: Record<number, string>;","  editable?: boolean;","  onShareChange?: (itemId: number, value: string) => void;","}) {","  const sum = ingredients.reduce((total, ingredient) => total + Number(shares?.[ingredient.itemId] ?? 0), 0);","  return <div className=\"grid gap-2\">","    <div className=\"flex items-center justify-between gap-3\">","      <h3 className=\"font-heading text-sm font-semibold\">Ingredient proportions</h3>","      {(editable || Math.abs(sum - 100) < 0.05) && <span className=\"text-sm text-muted-foreground\">Sum: {formatNumber(sum, 1)}%</span>}","    </div>","    <div className=\"overflow-x-auto rounded-md border\">","      <Table>","        <TableHeader><TableRow><TableHead>Commodity</TableHead><TableHead>Inv. Cost</TableHead><TableHead>Share</TableHead></TableRow></TableHeader>","        <TableBody>","          {ingredients.map((ingredient) => <TableRow key={ingredient.itemId}>","            <TableCell className=\"font-medium\">{ingredient.name}</TableCell>","            <TableCell>${formatNumber(ingredient.costPerLb, 3)} /lb</TableCell>","            <TableCell>{editable ? <div className=\"flex max-w-28 items-center gap-2\">","              <Input aria-label={`${ingredient.name} share (%)`} type=\"number\" min=\"0\" max=\"100\" step=\"0.1\" value={shares?.[ingredient.itemId] ?? \"0\"} onChange={(event) => onShareChange?.(ingredient.itemId, event.target.value)} />","              <span>%</span>","            </div> : <>{formatNumber(Number(shares?.[ingredient.itemId] ?? 0), 1)}%</>}</TableCell>","          </TableRow>)}","          {ingredients.length === 0 && <TableRow><TableCell colSpan={3} className=\"text-muted-foreground\">No ingredient details available.</TableCell></TableRow>}","        </TableBody>","      </Table>","    </div>","  </div>;","}","","function CandidateCard({ candidate, onSelect, selected, busy }: { candidate: RationCandidate; onSelect?: () => void; selected?: boolean; busy?: boolean }) {","  const ingredients = candidate.ingredients;","  return <Card className={selected ? \"border-primary\" : \"\"}>","    <CardContent className=\"grid gap-4\">","      <div className=\"flex flex-wrap items-start justify-between gap-3\">","        <div>","          <p className=\"text-xs font-semibold uppercase tracking-wide text-muted-foreground\">Optimizer proposal</p>","          <h3 className=\"font-heading text-lg font-semibold\">{candidate.feasible ? \"Feasible least-cost candidate\" : \"Infeasible candidate\"}</h3>","          <StatusBadge tone={candidate.feasible ? \"ok\" : \"warn\"}>{candidate.feasible ? \"Feasible\" : \"Infeasible\"}</StatusBadge>","        </div>","        <div className=\"text-right\">","          <p className=\"font-heading text-xl font-semibold\">{candidate.feasible ? <><span>$</span><span>{formatCost(candidate.costPerLb)}</span> <span className=\"text-sm font-normal text-muted-foreground\">/lb</span></> : <span>Infeasible · ${formatCost(candidate.costPerLb)} /lb</span>}</p>","          <p className=\"text-xs text-muted-foreground\">Predicted ration cost</p>","        </div>","      </div>","      <div className=\"overflow-x-auto rounded-md border\">","        <Table>","          <TableHeader><TableRow><TableHead>Component</TableHead><TableHead>Candidate Proportion</TableHead><TableHead>Predicted Nutrition</TableHead></TableRow></TableHeader>","          <TableBody>","            {ingredients.map((ingredient) => <TableRow key={ingredient.itemId}>","              <TableCell className=\"font-medium\">{`${ingredient.name} · $${formatNumber(ingredient.costPerLb, 3)}/lb`}</TableCell>","              <TableCell><span>{formatNumber(ingredient.proportionPercent, 1)}</span><span>%</span></TableCell>","              <TableCell className=\"text-sm\">DM: <span>{formatNumber(candidate.predictedDryMatterPercent, 1)}</span>% · Energy: <span>{formatNumber(candidate.predictedEnergyMcalPerKg, 2)}</span> Mcal/kg</TableCell>","            </TableRow>)}","          </TableBody>","        </Table>","      </div>","      {candidate.feasible && <>","        <Notice>","          <NoticeTitle>Suggestion only</NoticeTitle>","          <NoticeDescription>This calculated mix stays unapplied until you select it. Save the ration separately after reviewing the formula.</NoticeDescription>","        </Notice>","        <div className=\"flex flex-wrap items-center justify-between gap-3\">","          <span className=\"text-sm text-muted-foreground\">{selected ? \"Selected for the editor · not saved\" : \"candidate only · unapplied\"}</span>","          {onSelect && <Button type=\"button\" variant=\"outline\" disabled={busy || selected} onClick={onSelect}>{busy ? \"Selecting…\" : selected ? \"Mix selected\" : \"Select this mix\"}</Button>}","        </div>","      </>}","    </CardContent>","  </Card>;","}","","  const fixtureMode = fixture !== undefined;","  const fixtureValidation = Boolean(fixture && /validation|invalid/i.test(fixture));","  const fixtureOptimization = Boolean(fixture && /optimizer|feasible|infeasible|optimization/i.test(fixture));","  const fixtureSelected = Boolean(fixture && /selected|explicitly/i.test(fixture));","  const fixtureSaved = Boolean(fixture && /saved|ration.list/i.test(fixture));","  const [rations, setRations] = useState<Ration[]>(fixtureMode ? SAMPLE_RATIONS : []);","  const [inventory, setInventory] = useState<InventoryItem[]>(fixtureMode ? SAMPLE_INVENTORY : []);","  const [selectedId, setSelectedId] = useState<number | null>(fixtureMode ? SAMPLE_RATIONS[0].id : null);","  const [editor, setEditor] = useState<RationEditor>(() => editorFor(fixtureMode ? SAMPLE_RATIONS[0] : null, SAMPLE_INGREDIENTS.map(asOption)));","  const [dirty, setDirty] = useState(false);","  const [validation, setValidation] = useState<Record<string, string>>({});","  const [candidates, setCandidates] = useState<RationCandidate[]>(fixtureOptimization || fixtureSelected ? [SAMPLE_CANDIDATE] : []);","  const [infeasibleCandidates, setInfeasibleCandidates] = useState<RationCandidate[]>(fixtureOptimization || fixtureSelected ? [SAMPLE_INFEASIBLE] : []);","  const [selectedCandidate, setSelectedCandidate] = useState<RationCandidate | null>(fixtureSelected ? SAMPLE_CANDIDATE : null);","  const [saving, setSaving] = useState(false);","  const [optimizing, setOptimizing] = useState(false);","  const [selecting, setSelecting] = useState(false);","  const [loading, setLoading] = useState(!fixtureMode);","  const [error, setError] = useState(\"\");","  const [notice, setNotice] = useState(fixtureSaved ? \"Ration saved to the ration list.\" : \"\");","  const [minimumDryMatter, setMinimumDryMatter] = useState(\"88\");","  const [minimumEnergy, setMinimumEnergy] = useState(\"3.0\");","","  useEffect(() => {","    if (fixtureMode) {","      const displayedRations = fixtureSaved","        ? [...SAMPLE_RATIONS, { ...SAMPLE_RATIONS[1], id: 33, name: \"Optimized Grower\", costPerLb: SAMPLE_CANDIDATE.costPerLb, ingredients: SAMPLE_CANDIDATE.ingredients }]","        : SAMPLE_RATIONS;","      const chosen = fixtureSaved ? displayedRations[2] : displayedRations[0];","      setRations(displayedRations);","      setInventory(SAMPLE_INVENTORY);","      setSelectedId(chosen.id);","      const fixtureEditor = editorFor(chosen, SAMPLE_INGREDIENTS.map(asOption));","      if (fixtureSelected) fixtureEditor.shares = Object.fromEntries(SAMPLE_INGREDIENTS.map((ingredient) => [ingredient.itemId, String(SAMPLE_CANDIDATE.ingredients.find((entry) => entry.itemId === ingredient.itemId)?.proportionPercent ?? 0)]));","      if (fixtureValidation) {","        fixtureEditor.name = \"\";","        fixtureEditor.weightRange = \"950-650\";","      }","      setEditor(fixtureEditor);","      setDirty(fixtureSelected || fixtureSaved || fixtureValidation);","      setValidation(fixtureValidation ? { name: \"Enter a ration name.\", weightRange: \"Enter a valid minimum and maximum weight.\", shares: \"Ingredient proportions must total 100%.\" } : {});","      setCandidates(fixtureOptimization || fixtureSelected ? [SAMPLE_CANDIDATE] : []);","      setInfeasibleCandidates(fixtureOptimization || fixtureSelected ? [SAMPLE_INFEASIBLE] : []);","      setSelectedCandidate(fixtureSelected ? SAMPLE_CANDIDATE : null);","      setNotice(fixtureSaved ? \"Ration saved to the ration list.\" : fixtureSelected ? \"Mix selected for the editor. Save the ration to add it to the list.\" : \"\");","      setLoading(false);","      return;","    }","","    let active = true;","    const load = async () => {","      setLoading(true);","      setError(\"\");","      try {","        const [rationResponse, inventoryResponse] = await Promise.all([getRations(), getInventoryItems()]);","        if (rationResponse.status !== 200) throw new Error(\"Rations could not be loaded.\");","        if (!active) return;","        const rationData = rationResponse.data.rations;","        const inventoryData = inventoryResponse.status === 200 ? inventoryResponse.data.items : [];","        const optionMap = new Map<number, IngredientOption>();","        inventoryData.forEach((item) => optionMap.set(item.id, { itemId: item.id, name: item.name, dryMatterPercent: item.dryMatterPercent, energyMcalPerKg: item.energyMcalPerKg, costPerLb: item.unitCost }));","        rationData.flatMap((ration) => ration.ingredients).forEach((ingredient) => optionMap.set(ingredient.itemId, asOption(ingredient)));","        const options = [...optionMap.values()];","        setRations(rationData);","        setInventory(inventoryData);","        setSelectedId(rationData[0]?.id ?? null);","        setEditor(editorFor(rationData[0] ?? null, options));","      } catch {","        if (active) {","          setRations([]);","          setError(\"Rations could not be loaded. Try again in a moment.\");","        }","      } finally {","        if (active) setLoading(false);","      }","    };","    void load();","    return () => { active = false; };","  }, [fixture, fixtureMode, fixtureOptimization, fixtureSelected, fixtureSaved, fixtureValidation]);","","  const selectedRation = rations.find((ration) => ration.id === selectedId) ?? rations[0] ?? null;","  const ingredientOptions = useMemo(() => {","    const byId = new Map<number, IngredientOption>();","    inventory.forEach((item) => byId.set(item.id, { itemId: item.id, name: item.name, dryMatterPercent: item.dryMatterPercent, energyMcalPerKg: item.energyMcalPerKg, costPerLb: item.unitCost }));","    rations.flatMap((ration) => ration.ingredients).forEach((ingredient) => byId.set(ingredient.itemId, asOption(ingredient)));","    candidates.concat(infeasibleCandidates).flatMap((candidate) => candidate.ingredients).forEach((ingredient) => byId.set(ingredient.itemId, asOption(ingredient)));","    return [...byId.values()].sort((a, b) => a.itemId - b.itemId);","  }, [inventory, rations, candidates, infeasibleCandidates]);","","  const nutrition = (ingredients: RationIngredient[]) => {","    const total = ingredients.reduce((sum, ingredient) => sum + ingredient.proportionPercent, 0) || 1;","    return {","      dryMatter: ingredients.reduce((sum, ingredient) => sum + ingredient.dryMatterPercent * ingredient.proportionPercent, 0) / total,","      energy: ingredients.reduce((sum, ingredient) => sum + ingredient.energyMcalPerKg * ingredient.proportionPercent, 0) / total,","    };","  };","  const sortedFeasible = [...candidates].filter((candidate) => candidate.feasible).sort((a, b) => a.costPerLb - b.costPerLb);","  const sortedInfeasible = [...infeasibleCandidates].sort((a, b) => a.costPerLb - b.costPerLb);","  const chooseRation = (ration: Ration) => {","    setSelectedId(ration.id);","    setSelectedCandidate(null);","    setEditor(editorFor(ration, ingredientOptions));","    setDirty(false);","    setValidation({});","    setNotice(\"\");","  };","","  const updateEditor = (patch: Partial<RationEditor>) => {","    setEditor((current) => ({ ...current, ...patch }));","    setValidation((current) => {","      const next = { ...current };","      if (\"name\" in patch) delete next.name;","      if (\"weightRange\" in patch) delete next.weightRange;","      if (\"operationalStatus\" in patch) delete next.operationalStatus;","      if (\"shares\" in patch) delete next.shares;","      return next;","    });","    setDirty(true);","    setNotice(\"\");","  };","","  const discardChanges = () => {","    setEditor(editorFor(selectedRation, ingredientOptions));","    setDirty(false);","    setValidation({});","    setSelectedCandidate(null);","    setNotice(\"\");","  };","","  const parseRange = (range: string) => {","    const match = range.trim().match(/^(\\d+(?:\\.\\d+)?)\\s*(?:-|–|to)\\s*(\\d+(?:\\.\\d+)?)$/i);","    if (!match) return null;","    const minimum = Number(match[1]);","    const maximum = Number(match[2]);","    return Number.isFinite(minimum) && Number.isFinite(maximum) && minimum > 0 && maximum > minimum ? { minimum, maximum } : null;","  };","","  const validateEditor = () => {","    const errors: Record<string, string> = {};","    const range = parseRange(editor.weightRange);","    if (!editor.name.trim()) errors.name = \"Enter a ration name.\";","    if (!range) errors.weightRange = \"Enter a valid minimum and maximum weight, such as 650-950.\";","    if (!editor.operationalStatus.trim()) errors.operationalStatus = \"Enter an operational status.\";","    const shares = ingredientOptions.map((ingredient) => Number(editor.shares[ingredient.itemId] ?? 0));","    if (shares.some((share) => !Number.isFinite(share) || share < 0 || share > 100) || Math.abs(shares.reduce((sum, share) => sum + share, 0) - 100) > 0.05) {","      errors.shares = \"Ingredient proportions must be between 0 and 100 and total 100%.\";","    }","    setValidation(errors);","    return { errors, range };","  };","","  const handleOptimize = async (event: FormEvent<HTMLFormElement>) => {","    event.preventDefault();","    const range = parseRange(editor.weightRange);","    if (!range) {","      setValidation((current) => ({ ...current, weightRange: \"Enter a valid minimum and maximum weight before optimizing.\" }));","      return;","    }","    const minimumDryMatterPercent = Number(minimumDryMatter);","    const minimumEnergyMcalPerKg = Number(minimumEnergy);","    if (!Number.isFinite(minimumDryMatterPercent) || minimumDryMatterPercent < 0 || minimumDryMatterPercent > 100 || !Number.isFinite(minimumEnergyMcalPerKg) || minimumEnergyMcalPerKg < 0) {","      setError(\"Enter valid minimum dry matter and energy targets.\");","      return;","    }","    const request: RationOptimizationRequest = { targetWeightMinLb: range.minimum, targetWeightMaxLb: range.maximum, minimumDryMatterPercent, minimumEnergyMcalPerKg };","    setOptimizing(true);","    setError(\"\");","    setNotice(\"\");","    setSelectedCandidate(null);","    try {","      const response = await optimizeRation(request);","      if (response.status !== 200) throw new Error(\"Optimization failed.\");","      setCandidates(response.data.feasibleCandidates);","      setInfeasibleCandidates(response.data.infeasibleCandidates);","    } catch {","      setError(\"The least-cost mix could not be calculated. Review the targets and try again.\");","    } finally {","      setOptimizing(false);","    }","  };","","  const handleSelect = async (candidate: RationCandidate) => {","    const priorEditor = editor;","    const priorDirty = dirty;","    const priorCandidate = selectedCandidate;","    const proposedShares = Object.fromEntries(ingredientOptions.map((ingredient) => [ingredient.itemId, String(candidate.ingredients.find((entry) => entry.itemId === ingredient.itemId)?.proportionPercent ?? 0)]));","    setSelectedCandidate(candidate);","    setEditor((current) => ({ ...current, shares: proposedShares }));","    setDirty(true);","    setValidation({});","    setNotice(\"Mix selected for the editor. Save the ration to add it to the list.\");","    setSelecting(true);","    setError(\"\");","    try {","      const response = await selectRationCandidate({ candidateId: candidate.candidateId });","      if (response.status !== 200) throw new Error(\"Candidate selection failed.\");","      const chosen = response.data.selectedCandidate;","      setSelectedCandidate(chosen);","      setEditor((current) => ({ ...current, shares: Object.fromEntries(ingredientOptions.map((ingredient) => [ingredient.itemId, String(chosen.ingredients.find((entry) => entry.itemId === ingredient.itemId)?.proportionPercent ?? 0)])) }));","      setNotice(\"Mix selected for the editor. Save the ration to add it to the list.\");","    } catch {","      setEditor(priorEditor);","      setDirty(priorDirty);","      setSelectedCandidate(priorCandidate);","      setNotice(\"\");","      setError(\"This mix could not be selected. Try again.\");","    } finally {","      setSelecting(false);","    }","  };","","  const handleSave = async (event: FormEvent<HTMLFormElement>) => {","    event.preventDefault();","    const { errors, range } = validateEditor();","    if (Object.keys(errors).length || !range) return;","    const ingredients = ingredientOptions.filter((ingredient) => Number(editor.shares[ingredient.itemId] ?? 0) > 0).map((ingredient) => ({ itemId: ingredient.itemId, proportionPercent: Number(editor.shares[ingredient.itemId]) }));","    setSaving(true);","    setError(\"\");","    try {","      const request = { name: editor.name.trim(), type: editor.type.trim() || editor.name.trim().split(/\\s+/)[0], targetWeightMinLb: range.minimum, targetWeightMaxLb: range.maximum, operationalStatus: editor.operationalStatus.trim(), ingredients };","      if (fixtureMode) {","        const source = ingredientOptions.map((ingredient) => ({ ...ingredient, proportionPercent: Number(editor.shares[ingredient.itemId] ?? 0) })).filter((ingredient) => ingredient.proportionPercent > 0);","        const total = source.reduce((sum, ingredient) => sum + ingredient.proportionPercent, 0) || 1;","        const created: Ration = { id: Date.now(), ...request, costPerLb: source.reduce((sum, ingredient) => sum + ingredient.costPerLb * ingredient.proportionPercent, 0) / total, ingredients: source };","        setRations((current) => [...current, created]);","        setSelectedId(created.id);","        setSelectedCandidate(null);","        setNotice(\"Ration saved to the ration list.\");","        setDirty(false);","        return;","      }","      const response = await createRation(request);","      if (response.status !== 201) throw new Error(\"Ration could not be saved.\");","      const created = response.data;","      setRations((current) => [...current, created]);","      setSelectedId(created.id);","      setSelectedCandidate(null);","      setEditor(editorFor(created, ingredientOptions));","      setDirty(false);","      setValidation({});","      setNotice(\"Ration saved to the ration list.\");","    } catch {","      setError(\"The ration could not be saved. Review the formula and try again.\");","    } finally {","      setSaving(false);","    }","  };","","  const detailIngredients = selectedCandidate?.ingredients ?? selectedRation?.ingredients ?? [];","  const detailNutrition = nutrition(detailIngredients);","","  return <main data-screen=\"S-6\" data-state={fixture ?? \"default\"} className=\"mx-auto grid w-full max-w-7xl gap-6 px-4 py-6 sm:px-6 lg:px-8\">","    <div className=\"flex flex-wrap items-end justify-between gap-3\">","      <div><p className=\"text-sm text-muted-foreground\">Feed formulation</p><h1 className=\"font-heading text-3xl font-semibold tracking-tight\">Rations</h1></div>","      <p className=\"text-sm text-muted-foreground\">Facility date: 14 Oct 2026 · America/Denver</p>","    </div>","","    {error && <Notice tone=\"bad\"><NoticeTitle>Ration workflow issue</NoticeTitle><NoticeDescription>{error}</NoticeDescription></Notice>}","    {notice && <Notice><NoticeTitle>{notice.includes(\"saved\") ? \"Ration saved\" : \"Mix selected\"}<