{"ts":1791980142241,"kind":"call","tool":"Bash","input":"{\"command\":\"sed -n '1,75p' lib/feed-to-gain-calculator.ts\"}","output":"export type FeedUnit = \"lb\" | \"kg\" | \"ton\";\n\nexport interface FeedToGainEvent {\n  quantity: number;\n  unit: FeedUnit;\n  cost: number;\n}\n\nexport interface FeedToGainInput {\n  receivingDate: string;\n  asOfDate: string;\n  entryAverageWeightLb: number;\n  currentAverageWeightLb: number;\n  entryHeadcount: number;\n  currentHeadcount: number;\n  feedingEvents: FeedToGainEvent[];\n  targetWeightLb: number;\n  defaultAdgLbPerDay: number;\n}\n\nexport interface FeedToGainResult {\n  daysOnFeed: number;\n  totalGainLb: number;\n  averageDailyGainLbPerDay: number | null;\n  totalFeedAsFedLb: number;\n  feedConversionRatio: number | null;\n  feedCostPerPoundOfGain: number | null;\n  projectedMarketDate: string | null;\n}\n\nconst POUNDS_PER_UNIT: Record<FeedUnit, number> = { lb: 1, kg: 2.20462, ton: 2000 };\nconst DAY_MS = 24 * 60 * 60 * 1000;\n\nfunction utcDate(value: string): Date | null {\n  const match = /^(\\d{4})-(\\d{2})-(\\d{2})$/.exec(value);\n  if (!match) return null;\n  const date = new Date(Date.UTC(Number(match[1]), Number(match[2]) - 1, Number(match[3])));\n  return date.toISOString().slice(0, 10) === value ? date : null;\n}\n\nfunction dateAfterDays(date: Date, days: number): string | null {\n  if (!Number.isFinite(days) || days < 0) return null;\n  const projected = new Date(date.getTime() + Math.ceil(days) * DAY_MS);\n  return projected.toISOString().slice(0, 10);\n}\n\nexport class FeedToGainCalculator {\n  static calculate(input: FeedToGainInput): FeedToGainResult {\n    const receivingDate = utcDate(input.receivingDate);\n    const asOfDate = utcDate(input.asOfDate);\n    const daysOnFeed = receivingDate && asOfDate\n      ? Math.round((asOfDate.getTime() - receivingDate.getTime()) / DAY_MS)\n      : 0;\n    const totalGainLb = input.currentAverageWeightLb * input.currentHeadcount\n      - input.entryAverageWeightLb * input.entryHeadcount;\n    const averageDailyGainLbPerDay = daysOnFeed > 0 && totalGainLb > 0\n      ? totalGainLb / daysOnFeed\n      : null;\n    const totalFeedAsFedLb = input.feedingEvents.reduce(\n      (total, event) => total + event.quantity * POUNDS_PER_UNIT[event.unit],\n      0,\n    );\n    const feedCost = input.feedingEvents.reduce((total, event) => total + event.cost, 0);\n    const feedConversionRatio = totalGainLb > 0 ? totalFeedAsFedLb / totalGainLb : null;\n    const feedCostPerPoundOfGain = totalGainLb > 0 ? feedCost / totalGainLb : null;\n    const projectionAdg = averageDailyGainLbPerDay ?? input.defaultAdgLbPerDay;\n    const projectedMarketDate = asOfDate && projectionAdg > 0\n      ? dateAfterDays(asOfDate, Math.max(0, (input.targetWeightLb - input.currentAverageWeightLb) / projectionAdg))\n      : null;\n\n    return {\n      daysOnFeed,\n      totalGainLb,\n      averageDailyGainLbPerDay,\n      totalFeedAsFedLb,\n","chars":2748,"exitCode":0}
