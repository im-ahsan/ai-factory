<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Import records</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@600;650;700&family=IBM+Plex+Mono:wght@400;500;600&family=Source+Sans+3:ital,wght@0,400;0,600;0,700;1,400&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    :root {
      --bg-page: #F6F7F5;
      --bg-surface: #FFFFFF;
      --text-main: #252A27;
      --text-muted: #66706A;
      --border-color: #D9DEDA;
      --color-primary: #AD5C2A;
      --status-good: #28734F;
      --status-waiting: #94600C;
      --status-failed: #AE3D36;
      --dur-quick: 160ms;
    }

    body {
      background-color: var(--bg-page);
      color: var(--text-main);
      font-family: 'Source Sans 3', sans-serif;
      font-size: 16px;
      line-height: 24px;
      -webkit-font-smoothing: antialiased;
      margin: 0;
      padding: 0;
    }

    h1 {
      font-family: 'Hanken Grotesk', sans-serif;
      font-size: 26px;
      font-weight: 650;
      line-height: 32px;
      color: var(--text-main);
    }

    h2 {
      font-family: 'Hanken Grotesk', sans-serif;
      font-size: 22px;
      font-weight: 650;
      line-height: 28px;
    }

    h3 {
      font-family: 'Hanken Grotesk', sans-serif;
      font-size: 17px;
      font-weight: 600;
      line-height: 22px;
    }

    .font-mono-val {
      font-family: 'IBM Plex Mono', monospace;
    }

    /* Outlines and interactive states */
    button:focus-visible, select:focus-visible, input:focus-visible {
      outline: 2px solid var(--color-primary);
      outline-offset: 2px;
    }

    .primary-btn {
      background-color: var(--color-primary);
      color: #FFFFFF;
      height: 44px;
      border-radius: 6px;
      font-weight: 600;
      transition: opacity var(--dur-quick) ease, transform 90ms ease;
    }
    .primary-btn:hover {
      opacity: 0.92;
    }
    .primary-btn:active {
      transform: scale(0.98);
    }

    .ghost-control {
      height: 44px;
      border-radius: 6px;
      border: 1px solid var(--border-color);
      background-color: var(--bg-surface);
      transition: border-color var(--dur-quick) ease;
    }
    .ghost-control:hover {
      border-color: var(--color-primary);
    }

    /* Status badge treatments */
    .status-badge {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      padding: 2px 8px;
      border-radius: 4px;
      font-size: 13px;
      line-height: 18px;
      font-weight: 600;
      border-width: 1px;
      border-style: solid;
      background-color: #FFFFFF;
    }
    .status-good {
      color: var(--status-good);
      border-color: var(--status-good);
    }
    .status-waiting {
      color: var(--status-waiting);
      border-color: var(--status-waiting);
    }
    .status-failed {
      color: var(--status-failed);
      border-color: var(--status-failed);
    }

    /* Motion specifications */
    @keyframes status-breathe {
      0%, 100% { opacity: 0.96; }
      50% { opacity: 1; }
    }

    .live-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background-color: var(--status-good);
      display: inline-block;
      animation: status-breathe 8s ease-in-out infinite;
    }

    @keyframes row-settle {
      from {
        opacity: 0;
        transform: translateY(8px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .stagger-row {
      animation: row-settle var(--dur-quick) ease-out forwards;
    }
    .stagger-row:nth-child(1) { animation-delay: 0ms; }
    .stagger-row:nth-child(2) { animation-delay: 50ms; }
    .stagger-row:nth-child(3) { animation-delay: 100ms; }
    .stagger-row:nth-child(4) { animation-delay: 150ms; }
    .stagger-row:nth-child(5) { animation-delay: 200ms; }
    .stagger-row:nth-child(6) { animation-delay: 250ms; }

    @media (prefers-reduced-motion: reduce) {
      .live-dot {
        animation: none;
        opacity: 1;
      }
      .stagger-row {
        animation: none;
        opacity: 1;
        transform: none;
      }
      .primary-btn, .ghost-control {
        transition: none;
      }
    }
  </style>
</head>
<body class="min-h-screen text-[#252A27]">

