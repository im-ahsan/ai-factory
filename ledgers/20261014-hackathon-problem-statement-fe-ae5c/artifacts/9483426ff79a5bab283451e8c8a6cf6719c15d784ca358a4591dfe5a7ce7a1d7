{"ts":1791975633263,"kind":"call","tool":"Bash","input":"{\"command\":\"sed -n '1,220p' components/screens/s-4/container.tsx\"}","output":"\"use client\";\n\n// S-4 Feed inventory (/inventory): the approved Stitch page, built by the coding task in this file.\nimport { useEffect, useMemo, useState, type FormEvent, type ReactNode } from \"react\";\nimport { Button } from \"@/components/ui/button\";\nimport { Card, CardContent, CardHeader, CardTitle } from \"@/components/ui/card\";\nimport { Input } from \"@/components/ui/input\";\nimport { Label } from \"@/components/ui/label\";\nimport { Notice, NoticeDescription, NoticeTitle } from \"@/components/ui/notice\";\nimport { Skeleton } from \"@/components/ui/skeleton\";\nimport { StatusBadge } from \"@/components/ui/status-badge\";\nimport { Table, TableBody, TableCell, TableHead, TableHeader, TableRow } from \"@/components/ui/table\";\nimport { getInventoryItems, recordActualWastage, recordInventoryMovement } from \"@/lib/api/client\";\nimport type { ActualWastageRequest, InventoryItem, InventoryMovement, InventoryMovementRequestMovementType, InventoryOkResponse, MovementCreatedResponse } from \"@/lib/api/client.schemas\";\n\nconst SAMPLE_INVENTORY: InventoryOkResponse = {\n  wastageRatio: 0.042,\n  items: [\n    { id: 11, name: \"Yellow corn\", category: \"Grain\", availableQuantity: 680000, unit: \"lb\", unitCost: 0.112, dryMatterPercent: 88, energyMcalPerKg: 3.3, storageLocation: \"Grain storage bin 1\", openingStockLb: 675000, receivedStockLb: 12000, consumedStockLb: 6500, actualWastageLb: 500, closingStockLb: 680000, movements: [{ id: 701, itemId: 11, movementType: \"received\", date: \"2025-04-18\", quantityLb: 12000, note: \"Received commodity load · Grain storage bin 1\", wastageCause: null }] },\n    { id: 12, name: \"Alfalfa hay\", category: \"Forage\", availableQuantity: 390000, unit: \"lb\", unitCost: 0.145, dryMatterPercent: 91, energyMcalPerKg: 2.1, storageLocation: \"Barn B\", openingStockLb: 394216, receivedStockLb: 0, consumedStockLb: 4100, actualWastageLb: 116, closingStockLb: 390000, movements: [{ id: 702, itemId: 12, movementType: \"actual_wastage\", date: \"2025-04-22\", quantityLb: 116, note: \"Bunk cleanout & spoil\", wastageCause: \"Bunk cleanout & spoil\" }] },\n    { id: 13, name: \"Soybean meal\", category: \"Protein\", availableQuantity: 170000, unit: \"lb\", unitCost: 0.238, dryMatterPercent: 89, energyMcalPerKg: 3, storageLocation: \"Protein shed\", openingStockLb: 170000, receivedStockLb: 0, consumedStockLb: 0, actualWastageLb: 0, closingStockLb: 170000, movements: [] },\n    { id: 14, name: \"Mineral premix\", category: \"Supplement\", availableQuantity: 42000, unit: \"lb\", unitCost: 0.64, dryMatterPercent: 95, energyMcalPerKg: 1.4, storageLocation: \"Feed room\", openingStockLb: 42000, receivedStockLb: 0, consumedStockLb: 0, actualWastageLb: 0, closingStockLb: 42000, movements: [] },\n  ],\n};\n\nconst SAMPLE_ANNUAL_OUTLOOK: Record<number, number> = { 11: 69689, 12: 56831, 13: 36732, 14: 8683 };\nconst number = (value: number) => new Intl.NumberFormat(\"en-US\", { maximumFractionDigits: 2 }).format(value);\nconst money = (value: number) => `$${String(value)}`;\nconst statusOf = (quantity: number): \"bad\" | \"warn\" | \"ok\" => quantity <= 0 ? \"bad\" : quantity < 10000 ? \"warn\" : \"ok\";\nconst statusLabel = (value: string) => value.replaceAll(\"_\", \" \");\nconst movementLabel = (type: InventoryMovement[\"movementType\"]) => ({ opening: \"Opening stock\", received: \"Received commodity load\", consumed: \"Feed consumption\", actual_wastage: \"Actual wastage logged\", adjustment: \"Stock adjustment\" })[type];\nconst validDate = (value: string) => /^\\d{4}-\\d{2}-\\d{2}$/.test(value) && !Number.isNaN(new Date(`${value}T12:00:00Z`).valueOf()) && new Date(`${value}T12:00:00Z`).toISOString().slice(0, 10) === value;\n\nfunction upsertReturnedMovement(items: InventoryItem[], result: MovementCreatedResponse) {\n  const movementList = [result.movement, ...result.item.movements.filter((movement) => movement.id !== result.movement.id)];\n  const returnedItem = { ...result.item, movements: movementList };\n  return items.some((item) => item.id === returnedItem.id)\n    ? items.map((item) => item.id === returnedItem.id ? returnedItem : item)\n    : [...items, returnedItem];\n}\n\nfunction FieldError({ children }: { children?: string }) {\n  return children ? <p className=\"text-sm text-destructive\" role=\"alert\">{children}</p> : null;\n}\n\nfunction StockStat({ label, value, detail }: { label: string; value: ReactNode; detail?: string }) {\n  return <div className=\"grid min-w-0 gap-1\"><span className=\"text-xs font-semibold uppercase tracking-wide text-muted-foreground\">{label}</span><strong className=\"font-heading text-xl font-semibold leading-tight sm:text-2xl\">{value}</strong>{detail && <span className=\"text-xs text-muted-foreground\">{detail}</span>}</div>;\n}\n\nexport function FeedInventoryContainer({ fixture }: { fixture?: string }) {\n  const fixtureMode = fixture !== undefined;\n  const fixtureValidation = Boolean(fixture && /validation|invalid/i.test(fixture));\n  const fixtureActualWastage = Boolean(fixture && /actual.wastage/i.test(fixture));\n  const fixtureMovementSaved = Boolean(fixture && /movement.saved|saved.and.reflected/i.test(fixture));\n  const [data, setData] = useState<InventoryOkResponse | null>(SAMPLE_INVENTORY);\n  const [selectedItemId, setSelectedItemId] = useState<number | null>(SAMPLE_INVENTORY.items[0]?.id ?? null);\n  const [movementItemId, setMovementItemId] = useState(String(SAMPLE_INVENTORY.items[0]?.id ?? \"\"));\n  const [wastageItemId, setWastageItemId] = useState(String(SAMPLE_INVENTORY.items[0]?.id ?? \"\"));\n  const [movementType, setMovementType] = useState<InventoryMovementRequestMovementType>(\"received\");\n  const [movementDate, setMovementDate] = useState(\"\");\n  const [movementQuantity, setMovementQuantity] = useState(\"\");\n  const [movementNote, setMovementNote] = useState(\"\");\n  const [wastageDate, setWastageDate] = useState(\"\");\n  const [wastageQuantity, setWastageQuantity] = useState(\"\");\n  const [wastageCause, setWastageCause] = useState(\"\");\n  const [movementValidation, setMovementValidation] = useState<string[]>(fixtureValidation ? [\"Enter a valid date.\", \"Quantity must be greater than zero.\"] : []);\n  const [wastageValidation, setWastageValidation] = useState<string[]>(fixtureValidation ? [\"Enter a valid date.\", \"Actual wastage must be greater than zero.\", \"Enter a wastage cause or note.\"] : []);\n  const [movementBusy, setMovementBusy] = useState(false);\n  const [wastageBusy, setWastageBusy] = useState(false);\n  const [loading, setLoading] = useState(false);\n  const [error, setError] = useState(\"\");\n  const [movementNotice, setMovementNotice] = useState(\"\");\n  const [wastageNotice, setWastageNotice] = useState(\"\");\n  const [search, setSearch] = useState(\"\");\n\n  useEffect(() => {\n    if (fixtureMode) {\n      let sample = SAMPLE_INVENTORY;\n      if (fixtureActualWastage) {\n        const corn = sample.items[0];\n        const savedMovement: InventoryMovement = { id: 703, itemId: 11, movementType: \"actual_wastage\", date: \"2025-04-23\", quantityLb: 116, note: \"Actual wastage recorded · Bunk cleanout\", wastageCause: \"Bunk cleanout\" };\n        sample = { ...sample, items: sample.items.map((item) => item.id === 11 ? { ...item, actualWastageLb: item.actualWastageLb + savedMovement.quantityLb, closingStockLb: item.closingStockLb - savedMovement.quantityLb, availableQuantity: item.availableQuantity - savedMovement.quantityLb, movements: [savedMovement, ...item.movements] } : item) };\n        if (corn) setSelectedItemId(corn.id);\n      } else if (fixtureMovementSaved) {\n        const corn = sample.items[0];\n        const savedMovement: InventoryMovement = { id: 704, itemId: 11, movementType: \"received\", date: \"2025-04-23\", quantityLb: 8000, note: \"Movement saved · New commodity load\", wastageCause: null };\n        sample = { ...sample, items: sample.items.map((item) => item.id === 11 ? { ...item, availableQuantity: item.availableQuantity + savedMovement.quantityLb, receivedStockLb: item.receivedStockLb + savedMovement.quantityLb, closingStockLb: item.closingStockLb + savedMovement.quantityLb, movements: [savedMovement, ...item.movements] } : item) };\n        if (corn) setSelectedItemId(corn.id);\n      }\n      setData(sample);\n      setLoading(false);\n      return;\n    }\n\n    let active = true;\n    const load = async () => {\n      setError(\"\");\n      try {\n        const response = await getInventoryItems();\n        if (response.status !== 200) throw new Error(\"Inventory could not be loaded.\");\n        if (!active) return;\n        setData(response.data);\n        const firstItemId = response.data.items[0]?.id ?? null;\n        setSelectedItemId(firstItemId);\n        setMovementItemId(firstItemId === null ? \"\" : String(firstItemId));\n        setWastageItemId(firstItemId === null ? \"\" : String(firstItemId));\n      } catch {\n        if (active) {\n          setData(null);\n          setError(\"Feed inventory could not be loaded. Try again in a moment.\");\n        }\n      } finally {\n        if (active) setLoading(false);\n      }\n    };\n    void load();\n    return () => { active = false; };\n  }, [fixture, fixtureMode, fixtureActualWastage, fixtureMovementSaved]);\n\n  const items = data?.items ?? [];\n  const selectedItem = items.find((item) => item.id === selectedItemId) ?? items[0] ?? null;\n  const visibleItems = useMemo(() => items.filter((item) => `${item.name} ${item.category} ${item.storageLocation}`.toLowerCase().includes(search.toLowerCase())), [items, search]);\n  const movements = useMemo(() => items.flatMap((item) => item.movements.map((movement) => ({ ...movement, itemName: item.name, storageLocation: item.storageLocation }))).sort((a, b) => b.date.localeCompare(a.date) || b.id - a.id), [items]);\n\n  const handleMovementSubmit = async (event: FormEvent<HTMLFormElement>) => {\n    event.preventDefault();\n    const validation: string[] = [];\n    const quantity = Number(movementQuantity);\n    if (!validDate(movementDate)) validation.push(\"Enter a valid date.\");\n    if (!Number.isFinite(quantity) || quantity <= 0) validation.push(\"Quantity must be greater than zero.\");\n    if (!movementNote.trim()) validation.push(\"Enter a note for this movement.\");\n    setMovementValidation(validation);\n    setMovementNotice(\"\");\n    if (validation.length) return;\n    const request = { itemId: Number(movementItemId), movementType, date: movementDate, quantityLb: quantity, note: movementNote.trim() };\n    if (fixtureMode) {\n      const item = items.find((entry) => entry.id === request.itemId);\n      if (item) {\n        const movement: InventoryMovement = { id: Date.now(), itemId: item.id, movementType: request.movementType, date: request.date, quantityLb: request.quantityLb, note: request.note, wastageCause: null };\n        const delta = request.movementType === \"received\" ? quantity : -quantity;\n        setData((current) => current ? { ...current, items: current.items.map((entry) => entry.id === item.id ? { ...entry, availableQuantity: entry.availableQuantity + delta, closingStockLb: entry.closingStockLb + delta, receivedStockLb: entry.receivedStockLb + (delta > 0 ? quantity : 0), movements: [movement, ...entry.movements] } : entry) } : current);\n        setMovementNotice(\"Movement saved and reflected in the item balance.\");\n      }\n      return;\n    }\n    setMovementBusy(true);\n    setError(\"\");\n    try {\n      const response = await recordInventoryMovement(request);\n      if (response.status !== 201) {\n        setError(\"The stock movement could not be saved. Review the item, date, quantity, and note.\");\n        return;\n      }\n      setData((current) => current ? { ...current, items: upsertReturnedMovement(current.items, response.data) } : current);\n      setMovementNotice(\"Movement saved and reflected in the item balance.\");\n      setMovementQuantity(\"\");\n      setMovementNote(\"\");\n    } catch {\n      setError(\"The stock movement could not be saved. Try again in a moment.\");\n    } finally {\n      setMovementBusy(false);\n    }\n  };\n\n  const handleWastageSubmit = async (event: FormEvent<HTMLFormElement>) => {\n    event.preventDefault();\n    const validation: string[] = [];\n    const quantity = Number(wastageQuantity);\n    if (!validDate(wastageDate)) validation.push(\"Enter a valid date.\");\n    if (!Number.isFinite(quantity) || quantity <= 0) validation.push(\"Actual wastage must be greater than zero.\");\n    if (!wastageCause.trim()) validation.push(\"Enter a wastage cause or note.\");\n    setWastageValidation(validation);\n    setWastageNotice(\"\");\n    if (validation.length) return;\n    const request: ActualWastageRequest = { itemId: Number(wastageItemId), recordDate: wastageDate, actualWastageLb: quantity, wastageCause: wastageCause.trim() };\n    if (fixtureMode) {\n      const item = items.find((entry) => entry.id === request.itemId);\n      if (item) {\n        const movement: InventoryMovement = { id: Date.now(), itemId: item.id, movementType: \"actual_wastage\", date: request.recordDate, quantityLb: request.actualWastageLb, note: request.wastageCause, wastageCause: request.wastageCause };\n        setData((current) => current ? { ...current, items: current.items.map((entry) => entry.id === item.id ? { ...entry, actualWastageLb: entry.actualWastageLb + quantity, availableQuantity: entry.availableQuantity - quantity, closingStockLb: entry.closingStockLb - quantity, movements: [movement, ...entry.movements] } : entry) } : current);\n        setWastageNotice(\"Actual wastage recorded separately from consumption estimates.\");\n      }\n      return;\n    }\n    setWastageBusy(true);\n    setError(\"\");\n    try {\n      const response = await recordActualWastage(request);\n      if (response.status !== 201) {\n        setError(\"Actual wastage could not be recorded. Review the item, date, quantity, and cause.\");\n        return;\n      }\n      setData((current) => current ? { ...current, items: upsertReturnedMovement(current.items, response.data) } : current);\n      setWastageNotice(\"Actual wastage recorded separately from consumption estimates.\");\n      setWastageQuantity(\"\");\n      setWastageCause(\"\");\n    } catch {\n      setError(\"Actual wastage could not be recorded. Try again in a moment.\");\n    } finally {\n      setWastageBusy(false);\n    }\n  };\n\n  const state = fixture ?? (loading ? \"loading\" : \"default\");\n  return <main data-screen=\"S-4\" data-state={state} className=\"mx-auto grid w-full max-w-7xl flex-1 content-start gap-5 p-4 md:gap-6 md:p-6\">\n    <header className=\"flex flex-col justify-between gap-2 border-b pb-4 sm:flex-row sm:items-baseline\">\n      <h1 className=\"font-heading text-3xl font-semibold tracking-tight\">Feed inventory</h1>\n      <p className=\"flex items-center gap-2 text-sm text-muted-foreground\"><span className=\"size-2 rounded-full bg-success\" />As of {fixtureMode ? \"23 Apr 2025\" : new Intl.DateTimeFormat(\"en-GB\", { day: \"2-digit\", month: \"short\", year: \"numeric\", timeZone: \"America/Denver\" }).format(new Date())}<span>·</span>America/Denver</p>\n    </header>\n\n    {error && <Notice tone=\"bad\"><NoticeTitle>Inventory update</NoticeTitle><NoticeDescription>{error}</NoticeDescription></Notice>}\n    {loading && <div className=\"grid gap-4 lg:grid-cols-3\"><Skeleton className=\"h-48\" /><Skeleton className=\"h-48\" /><Skeleton className=\"h-48\" /></div>}\n\n    {!loading && selectedItem && data && <>\n      <Card>\n        <CardContent className=\"grid gap-6 p-4 sm:p-6 lg:grid-cols-3\">\n          <div className=\"grid content-between gap-5 lg:col-span-2\">\n            <div>\n              <div className=\"mb-1 flex flex-