n   \"Ration name\",\n   \"Target cattle weight range\",\n   \"Operational status\",\n   \"Corn proportion (%)\",\n   \"Hay proportion (%)\",\n   \"SBM proportion (%)\",\n   \"Premix proportion (%)\"\n  ],\n  \"columns\": [\n   \"Commodity\",\n   \"Inv. Cost\",\n   \"Share\",\n   \"Component\",\n   \"Candidate Proportion\",\n   \"Predicted Nutrition\"\n  ],\n  \"messages\": {},\n  \"toasts\": []\n },\n {\n  \"screen\": \"S-7\",\n  \"route\": \"/feeding/plans\",\n  \"reqs\": [\n   \"REQ-8\",\n   \"REQ-21\"\n  ],\n  \"states\": [\n   \"Plan input validation.\",\n   \"Plan preview recalculated from selected pen count and bunk rate.\",\n   \"Plan generated with a dated status.\"\n  ],\n  \"title\": \"Feeding plans\",\n  \"buttons\": [\n   \"Generate plan\"\n  ],\n  \"fields\": [\n   \"Pen\",\n   \"Plan date\",\n   \"Selected ration\",\n   \"Daily bunk rate (lb/head)\",\n   \"Current pen headcount\"\n  ],\n  \"columns\": [\n   \"Date\",\n   \"Pen\",\n   \"Ration\",\n   \"Headcount\",\n   \"Daily total\",\n   \"Status\"\n  ],\n  \"messages\": {},\n  \"toasts\": []\n },\n {\n  \"screen\": \"S-8\",\n  \"route\": \"/feeding/log\",\n  \"reqs\": [\n   \"REQ-9\",\n   \"REQ-10\",\n   \"REQ-21\"\n  ],\n  \"states\": [\n   \"Validation requires a separate actual quantity for every affected lot.\",\n   \"Successful save shows returned cost, energy, inventory use, lot quantities, plan variance and refreshed result.\",\n   \"Shortage result blocks saving and explains the unavailable quantity.\"\n  ],\n  \"title\": \"Feeding log\",\n  \"buttons\": [\n   \"Save feeding record\"\n  ],\n  \"fields\": [\n   \"Pen\",\n   \"Date\",\n   \"Ration\",\n   \"Feeding plan (optional)\"\n  ],\n  \"columns\": [\n   \"Date\",\n   \"Pen\",\n   \"Manager\",\n   \"Delivered ration & lots\",\n   \"Variance\",\n   \"Status\"\n  ],\n  \"messages\": {},\n  \"toasts\": []\n }\n]\n</artifact>\n\n<artifact id=\"stubs\" kind=\"stubs\" sha=\"\">\n[\n {\n  \"path\": \"lib/feed-to-gain-calculator.ts\",\n  \"content\": \"export type FeedUnit = \\\"lb\\\" | \\\"kg\\\" | \\\"ton\\\";\\n\\nexport interface FeedToGainEvent {\\n  quantity: number;\\n  unit: FeedUnit;\\n  cost: number;\\n}\\n\\nexport interface FeedToGainInput {\\n  receivingDate: string;\\n  asOfDate: string;\\n  entryAverageWeightLb: number;\\n  currentAverageWeightLb: number;\\n  entryHeadcount: number;\\n  currentHeadcount: number;\\n  feedingEvents: FeedToGainEvent[];\\n  targetWeightLb: number;\\n  defaultAdgLbPerDay: number;\\n}\\n\\nexport interface FeedToGainResult {\\n  daysOnFeed: number;\\n  totalGainLb: number;\\n  averageDailyGainLbPerDay: number | null;\\n  totalFeedAsFedLb: number;\\n  feedConversionRatio: number | null;\\n  feedCostPerPoundOfGain: number | null;\\n  projectedMarketDate: string | null;\\n}\\n\\nexport class FeedToGainCalculator {\\n  static calculate(_input: FeedToGainInput): FeedToGainResult {\\n    throw new Error(\\\"not implemented\\\");\\n  }\\n}\\n\"\n }\n]\n</artifact>\n\n<pointers>\n- contracts/openapi.yaml: the locked API contract; the client and test handlers in lib/api are generated from it\n</pointers>\n\nWrite the acceptance and characterisation tests now.\nBefore you return, check your list against the criteria: each of these needs at least one test in it: AC-6.1, AC-7.1, AC-7.2, AC-8.1, AC-8.2, AC-8.3, AC-9.1, AC-9.2, AC-9.3, AC-10.1, AC-10.2.\nThis session is cut off after 60 turns, 45 minutes or about $2 of model use, whichever comes first, and you are not warned. Long tool output, whole-file rewrites and reading a file again all use it up. Write every test first, then check them.\n\n<recap>\n- one test per AC\n- tests fail now for the right reason\n- characterisation tests pass today\n- don't touch production code\n</recap>"}