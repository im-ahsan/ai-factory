+const POUNDS_PER_UNIT: Record<FeedUnit, number> = { lb: 1, kg: 2.20462, ton: 2000 };
+const DAY_MS = 24 * 60 * 60 * 1000;
+
+function utcDate(value: string): Date | null {
+  const match = /^(\d{4})-(\d{2})-(\d{2})$/.exec(value);
+  if (!match) return null;
+  const date = new Date(Date.UTC(Number(match[1]), Number(match[2]) - 1, Number(match[3])));
+  return date.toISOString().slice(0, 10) === value ? date : null;
+}
+
+function dateAfterDays(date: Date, days: number): string | null {
+  if (!Number.isFinite(days) || days < 0) return null;
+  const projected = new Date(date.getTime() + Math.ceil(days) * DAY_MS);
+  return projected.toISOString().slice(0, 10);
+}
