Data(null);\n          setError(\"Feed inventory could not be loaded. Try again in a moment.\");\n        }\n      } finally {\n        if (active) setLoading(false);\n      }\n    };\n    void load();\n    return () => { active = false; };\n  }, [fixture, fixtureMode, fixtureActualWastage, fixtureMovementSaved]);\n\n  const items = data?.items ?? [];\n  const selectedItem = items.find((item) => item.id === selectedItemId) ?? items[0] ?? null;\n  const visibleItems = useMemo(() => items.filter((item) => `${item.name} ${item.category} ${item.storageLocation}`.toLowerCase().includes(search.toLowerCase())), [items, search]);\n  const movements = useMemo(() => items.flatMap((item) => item.movements.map((movement) => ({ ...movement, itemName: item.name, storageLocation: item.storageLocation }))).sort((a, b) => b.date.localeCompare(a.date) || b.id - a.id), [items]);\n\n  const handleMovementSubmit = async (event: FormEvent<HTMLFormElement>) => {\n    event.preventDefault();\n    const validation: string[] = [];\n    const quantity = Number(movementQuantity);\n    if (!validDate(movementDate)) validation.push(\"Enter a valid date.\");\n    if (!Number.isFinite(quantity) || quantity <= 0) validation.push(\"Quantity must be greater than zero.\");\n    if (!movementNote.trim()) validation.push(\"Enter a note for this movement.\");\n    setMovementValidation(validation);\n    setMovementNotice(\"\");\n    if (validation.length) return;\n    const request = { itemId: Number(movementItemId), movementType, date: movementDate, quantityLb: quantity, note: movementNote.trim() };\n    if (fixtureMode) {\n      const item = items.find((entry) => entry.id === request.itemId);\n      if (item) {\n        const movement: InventoryMovement = { id: Date.now(), itemId: item.id, movementType: request.movementType, date: request.date, quantityLb: request.quantityLb, note: request.note, wastageCause: null };\n        const delta = request.movementType === \"received\" ? quantity : -quantity;\n        setData((current) => current ? { ...current, items: current.items.map((entry) => entry.id === item.id ? { ...entry, availableQuantity: entry.availableQuantity + delta, closingStockLb: entry.closingStockLb + delta, receivedStockLb: entry.receivedStockLb + (delta > 0 ? quantity : 0), movements: [movement, ...entry.movements] } : entry) } : current);\n        setMovementNotice(\"Movement saved and reflected in the item balance.\");\n      }\n      return;\n    }\n    setMovementBusy(true);\n    setError(\"\");\n    try {\n      const response = await recordInventoryMovement(request);\n      if (response.status !== 201) {\n        setError(\"The stock movement could not be saved. Review the item, date, quantity, and note.\");\n        return;\n      }\n      setData((current) => current ? { ...current, items: upsertReturnedMovement(current.items, response.data) } : current);\n      setMovementNotice(\"Movement saved and reflected in the item balance.\");\n      setMovementQuantity(\"\");\n      setMovementNote(\"\");\n    } catch {\n      setError(\"The stock movement could not be saved. Try again in a moment.\");\n    } finally {\n      setMovementBusy(false);\n    }\n  };\n\n  const handleWastageSubmit = async (event: FormEvent<HTMLFormElement>) => {\n    event.preventDefault();\n    const validation: string[] = [];\n    const quantity = Number(wastageQuantity);\n    if (!validDate(wastageDate)) validation.push(\"Enter a valid date.\");\n    if (!Number.isFinite(quantity) || quantity <= 0) validation.push(\"Actual wastage must be greater than zero.\");\n    if (!wastageCause.trim()) validation.push(\"Enter a wastage cause or note.\");\n    setWastageValidation(validation);\n    setWastageNotice(\"\");\n    if (validation.length) return;\n    const request: ActualWastageRequest = { itemId: Number(wastageItemId), recordDate: wastageDate, actualWastageLb: quantity, wastageCause: wastageCause.trim() };\n    if (fixtureMode) {\n      const item = items.find((entry) => entry.id === request.itemId);\n      if (item) {\n        const movement: InventoryMovement = { id: Date.now(), itemId: item.id, movementType: \"actual_wastage\", date: request.recordDate, quantityLb: request.actualWastageLb, note: request.wastageCause, wastageCause: request.wastageCause };\n        setData((current) => current ? { ...current, items: current.items.map((entry) => entry.id === item.id ? { ...entry, actualWastageLb: entry.actualWastageLb + quantity, availableQuantity: entry.availableQuantity - quantity, closingStockLb: entry.closingStockLb - quantity, movements: [movement, ...entry.movements] } : entry) } : current);\n        setWastageNotice(\"Actual wastage recorded separately from consumption estimates.\");\n      }\n      return;\n    }\n    setWastageBusy(true);\n    setError(\"\");\n    try {\n      const response = await recordActualWastage(request);\n      if (response.status !== 201) {\n        setError(\"Actual wastage could not be recorded. Review the item, date, quantity, and cause.\");\n        return;\n      }\n      setData((current) => current ? { ...current, items: upsertReturnedMovement(current.items, response.data) } : current);\n      setWastageNotice(\"Actual wastage recorded separately from consumption estimates.\");\n      setWastageQuantity(\"\");\n      setWastageCause(\"\");\n    } catch {\n      setError(\"Actual wastage could not be recorded. Try again in a moment.\");\n    } finally {\n      setWastageBusy(false);\n    }\n  };\n\n  const state = fixture ?? (loading ? \"loading\" : \"default\");\n  return <main data-screen=\"S-4\" data-state={state} className=\"mx-auto grid w-full max-w-7xl flex-1 content-start gap-5 p-4 md:gap-6 md:p-6\">\n    <header className=\"flex flex-col justify-between gap-2 border-b pb-4 sm:flex-row sm:items-baseline\">\n      <h1 className=\"font-heading text-3xl font-semibold tracking-tight\">Feed inventory</h1>\n      <p className=\"flex items-center gap-2 text-sm text-muted-foreground\"><span className=\"size-2 rounded-full bg-success\" />As of {fixtureMode ? \"23 Apr 2025\" : new Intl.DateTimeFormat(\"en-GB\", { day: \"2-digit\", month: \"short\", year: \"numeric\", timeZone: \"America/Denver\" }).format(new Date())}<span>·</span>America/Denver</p>\n    </header>\n\n    {error && <Notice tone=\"bad\"><NoticeTitle>Inventory update</NoticeTitle><NoticeDescription>{error}</NoticeDescription></Notice>}\n    {loading && <div className=\"grid gap-4 lg:grid-cols-3\"><Skeleton className=\"h-48\" /><Skeleton className=\"h-48\" /><Skeleton className=\"h-48\" /></div>}\n\n    {!loading && selectedItem && data && <>\n      <Card>\n        <CardContent className=\"grid gap-6 p-4 sm:p-6 lg:grid-cols-3\">\n          <div className=\"grid content-between gap-5 lg:col-span-2\">\n            <div>\n              <div className=\"mb-1 flex flex-wrap items-center gap-2\"><span className=\"text-xs font-semibold uppercase tracking-wide text-muted-foreground\">Active Selection</span><StatusBadge tone={statusOf(selectedItem.availableQuantity)}>{selectedItem.availableQuantity > 0 ? \"good\" : \"out of stock\"}</StatusBadge></div>\n              <h2 className=\"font-heading text-2xl font-semibold tracking-tight\">{selectedItem.name}</h2>\n              <p className=\"text-sm text-muted-foreground\">{selectedItem.category} · Stored at {selectedItem.storageLocation}</p>\n            </div>\n            <div className=\"grid grid-cols-2 gap-5 border-t pt-4 sm:grid-cols-3\">\n              <StockStat label=\"Unit price\" value={<span>$<span>{String(selectedItem.unitCost)}</span></span>} detail={`per ${selectedItem.unit}`} />\n              <StockStat label=\"Current stock\" value={number(selectedItem.availableQuantity)} detail={selectedItem.unit} />\n              <StockStat label=\"Projected balance\" value=\"Not available\" detail=\"annual outlook\" />\n            </div>\n            <div className=\"grid gap-2 border-t pt-4 text-sm sm:grid-cols-2 lg:grid-cols-4\">\n           