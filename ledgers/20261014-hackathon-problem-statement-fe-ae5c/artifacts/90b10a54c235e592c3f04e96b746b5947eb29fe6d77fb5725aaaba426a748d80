{"ts":1791975862614,"kind":"call","tool":"Bash","input":"{\"command\":\"sed -n '1,180p' components/screens/s-5/container.tsx\"}","output":"\"use client\";\n\n// S-5 Inventory outlook (/inventory/outlook): the approved Stitch page, built by the coding task in this file.\nimport { useEffect, useRef, useState } from \"react\";\nimport { Card, CardContent, CardHeader, CardTitle } from \"@/components/ui/card\";\nimport { Input } from \"@/components/ui/input\";\nimport { Label } from \"@/components/ui/label\";\nimport { Notice, NoticeDescription, NoticeTitle } from \"@/components/ui/notice\";\nimport { Segmented } from \"@/components/ui/segmented\";\nimport { Skeleton } from \"@/components/ui/skeleton\";\nimport { Table, TableBody, TableCell, TableHead, TableHeader, TableRow } from \"@/components/ui/table\";\nimport { getInventoryItems, getInventoryOutlook, updateInventorySettings } from \"@/lib/api/client\";\nimport type { GetInventoryOutlookHorizon, InventoryOkResponse, OutlookOkResponse } from \"@/lib/api/client.schemas\";\n\nconst HORIZONS: { value: GetInventoryOutlookHorizon; label: string; days: number; column: string }[] = [\n  { value: \"daily\", label: \"Daily\", days: 1, column: \"Daily balance\" },\n  { value: \"weekly\", label: \"Weekly\", days: 7, column: \"Weekly (7d)\" },\n  { value: \"monthly\", label: \"Monthly\", days: 30, column: \"Monthly (30d)\" },\n  { value: \"quarterly\", label: \"Quarterly\", days: 90, column: \"Quarterly (90d)\" },\n  { value: \"bi-annual\", label: \"Bi-annual\", days: 180, column: \"Bi-annual (180d)\" },\n  { value: \"annual\", label: \"Annual\", days: 365, column: \"Annual balance\" },\n];\n\nconst SAMPLE_INVENTORY: InventoryOkResponse = {\n  wastageRatio: 0.042,\n  items: [\n    { id: 11, name: \"Yellow corn\", category: \"Grain\", availableQuantity: 680000, unit: \"lb\", unitCost: 0.112, dryMatterPercent: 88, energyMcalPerKg: 3.3, storageLocation: \"Grain storage bin 1\", openingStockLb: 675000, receivedStockLb: 12000, consumedStockLb: 6500, actualWastageLb: 500, closingStockLb: 680000, movements: [] },\n    { id: 12, name: \"Alfalfa hay\", category: \"Forage\", availableQuantity: 390000, unit: \"lb\", unitCost: 0.145, dryMatterPercent: 91, energyMcalPerKg: 2.1, storageLocation: \"Barn B\", openingStockLb: 394216, receivedStockLb: 0, consumedStockLb: 4100, actualWastageLb: 116, closingStockLb: 390000, movements: [] },\n    { id: 13, name: \"Soybean meal\", category: \"Protein\", availableQuantity: 170000, unit: \"lb\", unitCost: 0.238, dryMatterPercent: 89, energyMcalPerKg: 3, storageLocation: \"Protein shed\", openingStockLb: 170000, receivedStockLb: 0, consumedStockLb: 0, actualWastageLb: 0, closingStockLb: 170000, movements: [] },\n    { id: 14, name: \"Mineral premix\", category: \"Supplement\", availableQuantity: 42000, unit: \"lb\", unitCost: 0.64, dryMatterPercent: 95, energyMcalPerKg: 1.4, storageLocation: \"Feed room\", openingStockLb: 42000, receivedStockLb: 0, consumedStockLb: 0, actualWastageLb: 0, closingStockLb: 42000, movements: [] },\n  ],\n};\n\nconst SAMPLE_DAILY: Record<number, number> = { 11: 1673, 12: 913, 13: 365, 14: 91 };\nconst SAMPLE_BALANCES: Record<GetInventoryOutlookHorizon, Record<number, number>> = {\n  daily: { 11: 678327, 12: 389087, 13: 169635, 14: 41909 },\n  weekly: { 11: 668289, 12: 383609, 13: 167445, 14: 41363 },\n  monthly: { 11: 629810, 12: 362610, 13: 159050, 14: 39270 },\n  quarterly: { 11: 529430, 12: 307830, 13: 137150, 14: 33810 },\n  \"bi-annual\": { 11: 378860, 12: 225660, 13: 104300, 14: 25620 },\n  annual: { 11: 69689, 12: 56831, 13: 36732, 14: 8683 },\n};\n\nconst number = (value: number) => new Intl.NumberFormat(\"en-US\", { maximumFractionDigits: 2 }).format(value);\nconst ratioInputValue = (ratio: number) => String(Number((ratio * 100).toFixed(2)));\n\nfunction sampleProjection(horizon: GetInventoryOutlookHorizon, wastageRatio: number): OutlookOkResponse {\n  const selectedHorizon = HORIZONS.find((entry) => entry.value === horizon) ?? HORIZONS[0];\n  return {\n    horizon,\n    wastageRatio,\n    balances: SAMPLE_INVENTORY.items.map((item) => {\n      const dailyEstimatedConsumptionLb = Math.round((SAMPLE_DAILY[item.id] ?? 0) * (1 + wastageRatio) / 1.042);\n      const projectedBalanceLb = Math.abs(wastageRatio - 0.042) < 0.00001\n        ? SAMPLE_BALANCES[horizon][item.id]\n        : Math.round(item.availableQuantity - dailyEstimatedConsumptionLb * selectedHorizon.days);\n      return { itemId: item.id, itemName: item.name, currentStockLb: item.availableQuantity, dailyEstimatedConsumptionLb, projectedBalanceLb };\n    }),\n  };\n}\n\nfunction sampleProjections(wastageRatio: number) {\n  return Object.fromEntries(HORIZONS.map(({ value }) => [value, sampleProjection(value, wastageRatio)])) as Partial<Record<GetInventoryOutlookHorizon, OutlookOkResponse>>;\n}\n\nfunction FieldError({ children }: { children: string }) {\n  return <p className=\"text-sm text-destructive\" role=\"alert\">{children}</p>;\n}\n\nexport function InventoryOutlookContainer({ fixture }: { fixture?: string }) {\n  const fixtureMode = fixture !== undefined;\n  const fixtureValidation = Boolean(fixture && /validation|invalid|out.of.range/i.test(fixture));\n  const [inventory, setInventory] = useState<InventoryOkResponse | null>(fixtureMode ? SAMPLE_INVENTORY : null);\n  const [ratio, setRatio] = useState(fixtureMode ? SAMPLE_INVENTORY.wastageRatio : 0.04);\n  const [ratioInput, setRatioInput] = useState(fixtureValidation ? \"125\" : ratioInputValue(fixtureMode ? SAMPLE_INVENTORY.wastageRatio : 0.04));\n  const [validation, setValidation] = useState(fixtureValidation ? \"Enter a wastage ratio from 0% to 100%.\" : \"\");\n  const [projections, setProjections] = useState<Partial<Record<GetInventoryOutlookHorizon, OutlookOkResponse>>>(() => fixtureMode ? sampleProjections(SAMPLE_INVENTORY.wastageRatio) : {});\n  const [activeHorizon, setActiveHorizon] = useState<GetInventoryOutlookHorizon>(\"daily\");\n  const [loading, setLoading] = useState(!fixtureMode);\n  const [saving, setSaving] = useState(false);\n  const [error, setError] = useState(\"\");\n  const ratioUpdateTimer = useRef<ReturnType<typeof setTimeout> | null>(null);\n  const ratioEditId = useRef(0);\n\n  useEffect(() => {\n    if (fixtureMode) {\n      setInventory(SAMPLE_INVENTORY);\n      setRatio(SAMPLE_INVENTORY.wastageRatio);\n      setRatioInput(fixtureValidation ? \"125\" : ratioInputValue(SAMPLE_INVENTORY.wastageRatio));\n      setValidation(fixtureValidation ? \"Enter a wastage ratio from 0% to 100%.\" : \"\");\n      setProjections(sampleProjections(SAMPLE_INVENTORY.wastageRatio));\n      setLoading(false);\n      return;\n    }\n\n    let active = true;\n    const load = async () => {\n      setLoading(true);\n      setError(\"\");\n      try {\n        const inventoryResponse = await getInventoryItems();\n        if (inventoryResponse.status !== 200) throw new Error(\"Feed inventory could not be loaded.\");\n        const wastageRatio = inventoryResponse.data.wastageRatio;\n        const projectionResponses = await Promise.all(HORIZONS.map(async ({ value }) => {\n          const response = await getInventoryOutlook({ horizon: value, wastageRatio });\n          if (response.status !== 200) throw new Error(\"Inventory projections could not be loaded.\");\n          return [value, response.data] as const;\n        }));\n        if (!active) return;\n        setInventory(inventoryResponse.data);\n        setRatio(wastageRatio);\n        setRatioInput(ratioInputValue(wastageRatio));\n        setProjections(Object.fromEntries(projectionResponses) as Partial<Record<GetInventoryOutlookHorizon, OutlookOkResponse>>);\n      } catch {\n        if (active) {\n          setInventory(null);\n          setError(\"Inventory outlook could not be loaded. Try again in a moment.\");\n        }\n      } finally {\n        if (active) setLoading(false);\n      }\n    };\n    void load();\n    return () => {\n      active = false;\n      if (ratioUpdateTimer.current) clearTimeout(ratioUpdateTimer.current);\n    };\n  }, [fixture, fixtureMode, fixtureValidation]);\n\n  const refreshAllProjections = async (selectedRatio: number, editId: number) => {\n    try {\n      const responses = await Promise.all(HORIZONS.map(async ({ value }) => {\n        const response = await getInventoryOutlook({ horizon: value, wastageRatio: selectedRatio });\n        if (response.status !== 200) throw new Error(\"Inventory projections could not be refreshed.\");\n        return [value, response.data] as const;\n      }));\n      if (editId === ratioEditId.current) {\n        setProjections(Object.fromEntries(responses) as Partial<Record<GetInventoryOutlookHorizon, OutlookOkResponse>>);\n        setError(\"\");\n      }\n    } catch {\n      if (editId === ratioEditId.current) setError(\"The wastage ratio was saved, but projections could not be refreshed.\");\n    }\n  };\n\n  const saveRatio = async (selectedRatio: number, editId: number) => {\n    setSaving(true);\n    setError(\"\");\n    try {\n      const response = await updateInventorySettings({ wastageRatio: selectedRatio });\n      if (response.status !== 200) throw new Error(\"Wastage ratio could not be saved.\");\n      if (editId !== ratioEditId.current) return;\n      const savedRatio = response.data.wastageRatio;\n      setRatio(savedRatio);\n      setRatioInput(ratioInputValue(savedRatio));\n      setInventory((current) => current ? { ...current, wastageRatio: savedRatio } : current);\n      await refreshAllProjections(savedRatio, editId);\n    } catch {\n      if (editId === ratioEditId.current) setError(\"The wastage ratio could not be saved. Review the value and try again.\");\n    } finally {\n      if (editId === ratioEditId.current) setSaving(false);\n    }\n  };\n\n  const handleRatioChange = (value: string) => {\n    setRatioInput(value);\n    const percent = Number(value);\n    if (!value.trim() || !Number.isFinite(percent) || percent < 0 || percent > 100) {\n      setValidation(\"Enter a wastage ratio from 0% to 100%.\");\n      ratioEditId.current += 1;\n      if (ratioUpdateTimer.current) clearTimeout(ratioUpdateTimer.current);\n      return;\n    }\n\n    setValidation(\"\");\n    const selectedRatio = percent / 100;\n    setRatio(selectedRatio);\n    setInventory((current) => current ? { ...current, wastageRatio: selectedRatio } : current);\n    const editId = ++ratioEditId.current;\n    if (ratioUpdateTimer.current) clearTimeout(ratioUpdateTimer.current);\n","chars":10065,"exitCode":0}
