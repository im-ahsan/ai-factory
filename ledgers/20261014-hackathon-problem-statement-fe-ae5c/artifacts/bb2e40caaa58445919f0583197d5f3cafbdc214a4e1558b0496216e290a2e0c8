import {
  getGenerateFeedingPlanMockHandler,
  getGenerateFeedingPlanResponseMock,
  getGetFeedingActivitiesMockHandler,
  getGetFeedingActivitiesResponseMock,
  getGetFeedingPlansMockHandler,
  getGetFeedingPlansResponseMock,
  getGetInventoryItemsMockHandler,
  getGetInventoryItemsResponseMock,
  getGetLotsMockHandler,
  getGetLotsResponseMock,
  getGetRationsMockHandler,
  getGetRationsResponseMock,
  getOptimizeRationMockHandler,
  getOptimizeRationResponseMock,
  getRecordFeedingActivityMockHandler,
  getRecordFeedingActivityResponseMock,
  getSelectRationCandidateMockHandler,
  getSelectRationCandidateResponseMock,
