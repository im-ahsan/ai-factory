<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Project & demo — Cedar Draw Feedlot</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@600;650;700&family=IBM+Plex+Mono:wght@400;500;600&family=Source+Sans+3:ital,wght@0,400;0,600;0,700;1,400&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg-page: #F6F7F5;
      --bg-surface: #FFFFFF;
      --text-main: #252A27;
      --text-muted: #66706A;
      --border-color: #D9DEDA;
      --primary: #AD5C2A;
      --status-good: #28734F;
      --status-waiting: #94600C;
      --status-failed: #AE3D36;
      --dur-quick: 160ms;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      background-color: var(--bg-page);
      color: var(--text-main);
      font-family: 'Source Sans 3', sans-serif;
      font-size: 16px;
      line-height: 24px;
      -webkit-font-smoothing: antialiased;
      min-height: 100vh;
    }

    /* Font rules */
    h1, h2, h3, h4, .font-heading {
      font-family: 'Hanken Grotesk', sans-serif;
    }

    .mono {
      font-family: 'IBM Plex Mono', monospace;
    }

    /* Header Nav */
    header {
      background: var(--bg-surface);
      border-bottom: 1px solid var(--border-color);
      width: 100%;
    }

    .header-inner {
      max-width: 1360px;
      margin: 0 auto;
      padding: 0 24px;
      height: 56px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
    }

    .brand-group {
      display: flex;
      align-items: center;
      gap: 12px;
      flex-shrink: 0;
    }

    .brand-mark {
      width: 28px;
      height: 28px;
      background: var(--primary);
      border-radius: 6px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #FFFFFF;
      font-family: 'Hanken Grotesk', sans-serif;
      font-weight: 700;
      font-size: 16px;
      line-height: 1;
    }

    .brand-title {
      font-family: 'Hanken Grotesk', sans-serif;
      font-size: 17px;
      font-weight: 650;
      color: var(--text-main);
      letter-spacing: -0.01em;
    }

    nav.nav-links {
      display: flex;
      align-items: center;
      gap: 4px;
      overflow-x: auto;
      scrollbar-width: none;
      white-space: nowrap;
    }

    nav.nav-links::-webkit-scrollbar {
      display: none;
    }

    .nav-item {
      display: inline-flex;
      align-items: center;
      height: 56px;
      padding: 0 10px;
      font-size: 14px;
      font-weight: 600;
      color: var(--text-muted);
      text-decoration: none;
      border-bottom: 2px solid transparent;
      transition: color var(--dur-quick) ease, border-color var(--dur-quick) ease;
    }

    .nav-item:hover {
      color: var(--text-main);
    }

    .nav-item:focus-visible {
      outline: 2px solid var(--primary);
      outline-offset: -2px;
    }

    .nav-item.active {
      color: var(--primary);
      border-bottom-color: var(--primary);
    }

    .user-profile {
      display: flex;
      align-items: center;
      gap: 10px;
      flex-shrink: 0;
    }

    .avatar-initials {
      width: 32px;
      height: 32px;
      background: #EAECE9;
      border: 1px solid var(--border-color);
      border-radius: 6px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: 'IBM Plex Mono', monospace;
      font-size: 13px;
      font-weight: 600;
      color: var(--text-main);
    }

    .user-meta {
      display: flex;
      flex-direction: column;
      line-height: 1.2;
    }

    .user-name {
      font-size: 14px;
      font-weight: 600;
      color: var(--text-main);
    }

    .user-role {
      font-size: 12px;
      color: var(--text-muted);
    }

    /* Main Container */
    main {
      max-width: 1360px;
      margin: 0 auto;
      padding: 32px 24px 64px 24px;
    }

    .page-title-row {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 16px;
      margin-bottom: 24px;
    }

    h1.page-title {
      font-size: 30px;
      font-weight: 650;
      line-height: 38px;
      letter-spacing: -0.02em;
    }

    .facility-context {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 14px;
      color: var(--text-muted);
    }

    .live-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--status-good);
      display: inline-block;
      animation: status-breathe 8s ease-in-out infinite;
    }

    /* Panels & Rules */
    .panel {
      background: var(--bg-surface);
      border: 1px solid var(--border-color);
      border-radius: 8px;
      padding: 24px;
      margin-bottom: 24px;
    }

    .panel-compact {
      padding: 16px 20px;
    }

    .panel-header {
      margin-bottom: 16px;
    }

    h2.section-title {
      font-size: 22px;
      font-weight: 650;
      line-height: 28px;
      margin-bottom: 4px;
    }

    h3.subsection-title {
      font-size: 17px;
      font-weight: 600;
      line-height: 24px;
      margin-bottom: 8px;
    }

    .section-desc {
      color: var(--text-muted);
      font-size: 15px;
      line-height: 22px;
    }

    /* Buttons */
    .btn-primary {
      height: 44px;
      padding: 0 20px;
      background: var(--primary);
      color: #FFFFFF;
      border: none;
      border-radius: 6px;
      font-family: 'Source Sans 3', sans-serif;
      font-size: 15px;
      font-weight: 600;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      transition: opacity var(--dur-quick) ease, transform 90ms ease;
    }

    .btn-primary:hover {
      opacity: 0.94;
    }

    .btn-primary:active {
      transform: scale(0.98);
    }

    .btn-primary:focus-visible {
      outline: 2px solid var(--primary);
      outline-offset: 2px;
    }

    /* Status Badges */
    .status-badge {
      display: inline-flex;
      align-items: center;
      padding: 2px 8px;
      border-radius: 4px;
      font-size: 13px;
      font-weight: 600;
      line-height: 18px;
      border: 1px solid currentColor;
      text-transform: capitalize;
    }

    .status-good {
      color: var(--status-good);
      background: rgba(40, 115, 79, 0.05);
    }

    .status-waiting {
      color: var(--status-waiting);
      background: rgba(148, 96, 12, 0.05);
    }

    .status-failed {
      color: var(--status-failed);
      background: rgba(174, 61, 54, 0.05);
    }

    /* Demo Section Layout */
    .demo-bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 24px;
      flex-wrap: wrap;
      padding-bottom: 20px;
      border-bottom: 1px solid var(--border-color);
    }

    .demo-bar-info {
      max-width: 760px;
    }

    .results-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 16px;
      margin-top: 20px;
    }

    .result-card {
      background: var(--bg-page);
      border: 1px solid var(--border-color);
      border-radius: 6px;
      padding: 16px;
    }

    .result-card-val {
      font-size: 26px;
      font-weight: 600;
      line-height: 32px;
      margin-bottom: 4px;
    }

    .result-card-label {
      font-size: 14px;
      color: var(--text-muted);
    }

    .outcome-banner {
      margin-top: 16px;
      padding: 14px 16px;
      background: #FFF8F7;
      border: 1px solid rgba(174, 61, 54, 0.3);
      border-radius: 6px;
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 16px;
      flex-wrap: wrap;
    }

    .outcome-content {
      display: flex;
      align-items: baseline;
      gap: 12px;
      flex-wrap: wrap;
    }

    .outcome-text {
      font-size: 15px;
      color: var(--text-main);
    }

    /* Architecture diagram */
    .diagram-wrap {
      background: var(--bg-page);
      border: 1px solid var(--border-color);
      border-radius: 6px;
      padding: 24px;
      margin-top: 16px;
    }

    .diagram-flow {
      display: grid;
      grid-template-columns: 1fr 40px 1.2fr 40px 1fr;
      align-items: center;
      gap: 8px;
    }

    .diagram-box {
      background: var(--bg-surface);
      border: 1px solid var(--border-color);
      border-radius: 6px;
      padding: 16px;
      min-height: 128px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }

    .diagram-box.highlight {
      border: 1.5px solid var(--primary);
    }

    .diagram-tag {
      font-size: 12px;
      font-weight: 600;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }

    .diagram-box-title {
      font-family: 'Hanken Grotesk', sans-serif;
      font-size: 16px;
      font-weight: 650;
      color: var(--text-main);
      margin: 4px 0;
    }

    .diagram-box-desc {
      font-size: 13px;
      color: var(--text-muted);
      line-height: 18px;
    }

    .diagram-arrow {
      text-align: center;
      color: var(--text-muted);
      font-size: 20px;
      font-weight: 600;
      line-height: 1;
    }

    /* Guided Sequence & Stepper */
    .step-list {
      display: flex;
      flex-direction: column;
      gap: 12px;
      margin-top: 16px;
    }

    .step-item {
      display: grid;
      grid-template-columns: 36px 180px 1fr 140px;
      align-items: center;
      gap: 16px;
      padding: 12px 16px;
      background: var(--bg-page);
      border: 1px solid var(--border-color);
      border-radius: 6px;
    }

    .step-num {
      width: 28px;
      height: 28px;
      background: var(--bg-surface);
      border: 1px solid var(--border-color);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 600;
      font-size: 14px;
    }

    .step-artifact {
      font-family: 'Hanken Grotesk', sans-serif;
      font-weight: 650;
      font-size: 15px;
      color: var(--text-main);
    }

    .step-detail {
      font-size: 14px;
      color: var(--text-muted);
    }

    /* Calculator Example Box */
    .calc-container {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 24px;
      background: var(--bg-page);
      border: 1px solid var(--border-color);
      border-radius: 6px;
      padding: 20px;
      margin-top: 16px;
    }

    .calc-col-title {
      font-size: 14px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      color: var(--text-muted);
      margin-bottom: 12px;
      padding-bottom: 6px;
      border-bottom: 1px solid var(--border-color);
    }

    .metric-row {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      padding: 8px 0;
      border-bottom: 1px dashed var(--border-color);
      font-size: 15px;
    }

    .metric-row:last-child {
      border-bottom: none;
    }

    .metric-label {
      color: var(--text-muted);
    }

    .metric-val {
      font-weight: 600;
      color: var(--text-main);
    }

    /* Tables */
    .data-table-wrap {
      overflow-x: auto;
      margin-top: 16px;
      border: 1px solid var(--border-color);
      border-radius: 6px;
      background: var(--bg-surface);
    }

    table.data-table {
      width: 100%;
      border-collapse: collapse;
      text-align: left;
    }

    table.data-table th {
      background: var(--bg-page);
      padding: 12px 16px;
      font-size: 13px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.03em;
      color: var(--text-muted);
      border-bottom: 1px solid var(--border-color);
    }

    table.data-table td {
      height: 48px;
      padding: 8px 16px;
      font-size: 14px;
      border-bottom: 1px solid var(--border-color);
      color: var(--text-main);
    }

    table.data-table tr:last-child td {
      border-bottom: none;
    }

    /* Staggered row animation */
    table.data-table tbody tr {
      animation: tableRowSettle var(--dur-quick) ease forwards;
    }
    table.data-table tbody tr:nth-child(1) { animation-delay: 0ms; }
    table.data-table tbody tr:nth-child(2) { animation-delay: 50ms; }
    table.data-table tbody tr:nth-child(3) { animation-delay: 100ms; }
    table.data-table tbody tr:nth-child(4) { animation-delay: 150ms; }
    table.data-table tbody tr:nth-child(5) { animation-delay: 200ms; }
    table.data-table tbody tr:nth-child(6) { animation-delay: 250ms; }

    /* Split Two-Column Layout for End Sections */
    .two-col-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 24px;
    }

    /* Keyframes */
    @keyframes status-breathe {
      0%, 100% { opacity: 0.96; }
      50% { opacity: 1.0; }
    }

    @keyframes tableRowSettle {
      0% {
        opacity: 0;
        transform: translateY(8px);
      }
      100% {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .live-dot {
        animation: none;
      }
      table.data-table tbody tr {
        animation: none;
      }
      .btn-primary {
        transition: none;
      }
    }

    /* Responsive */
    @media (max-width: 992px) {
      .diagram-flow {
        grid-template-columns: 1fr;
        gap: 12px;
      }
      .diagram-arrow {
        transform: rotate(90deg);
        margin: 4px 0;
      }
      .calc-container {
        grid-template-columns: 1fr;
      }
      .step-item {
        grid-template-columns: 36px 1fr;
        gap: 8px;
      }
      .step-item > div:nth-child(3),
      .step-item > div:nth-child(4) {
        grid-column: 2 / -1;
      }
      .two-col-grid {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 768px) {
      h1.page-title {
        font-size: 26px;
        line-height: 34px;
      }
      table.data-table td {
        height: 56px;
      }
    }
  </style>
</head>
<body>

  <!-- Persistent App Header -->
  <header>
    <div class="header-inner">
      <div class="brand-group">
        <div class="brand-mark">C</div>
        <div class="brand-title">Cedar Draw Feedlot</div>
      </div>

      <nav class="nav-links">
        <a href="#overview" class="nav-item">Overview</a>
        <a href="#import" class="nav-item">Import records</a>
        <a href="#lots" class="nav-item">Lots & pens</a>
        <a href="#inventory" class="nav-item">Feed inventory</a>
        <a href="#outlook" class="nav-item">Inventory outlook</a>
        <a href="#rations" class="nav-item">Rations</a>
        <a href="#plans" class="nav-item">Feeding plans</a>
        <a href="#feeding-log" class="nav-item">Feeding log</a>
        <a href="#weight-records" class="nav-item">Weight records</a>
        <a href="#operational-reports" class="nav-item">Operational reports</a>
        <a href="#feed-to-gain" class="nav-item">Feed-to-gain</a>
        <a href="#project-demo" class="nav-item active">Project & demo</a>
      </nav>

      <div class="user-profile">
        <div class="avatar-initials">MO</div>
        <div class="user-meta">
          <span class="user-name">Mara Ortega</span>
          <span class="user-role">Feed manager</span>
        </div>
      </div>
    </div>
  </header>

  <!-- Main Content -->
  <main>
    <!-- Header title row -->
    <div class="page-title-row">
      <h1 class="page-title">Project & demo</h1>
      <div class="facility-context">
        <span class="live-dot"></span>
        <span>Facility: Cedar Draw Feedlot</span>
        <span>&bull;</span>
        <span class="mono">23 Apr 2025</span>
        <span>&bull;</span>
        <span class="mono">America/Denver</span>
      </div>
    </div>

    <!-- Section 1: Demo dataset -->
    <section class="panel">
      <div class="demo-bar">
        <div class="demo-bar-info">
          <h2 class="section-title">Demo dataset &mdash; separate from live operating records</h2>
          <p class="section-desc">Loads 16 sample records on demand into a segregated verification partition for interactive testing, formula audit, and workflow demonstration without polluting live feedlot tallies or pen rosters.</p>
        </div>
        <button class="btn-primary" type="button">
          Load demo dataset
        </button>
      </div>

      <!-- Truthful Result Area -->
      <div class="results-grid">
        <div class="result-card">
          <div class="result-card-val mono" style="color: var(--status-good);">12</div>
          <div class="result-card-label">Added records (lots, bunks, scale tickets)</div>
        </div>
        <div class="result-card">
          <div class="result-card-val mono" style="color: var(--status-waiting);">3</div>
          <div class="result-card-label">Already-present records (unchanged)</div>
        </div>
        <div class="result-card">
          <div class="result-card-val mono" style="color: var(--status-failed);">1</div>
          <div class="result-card-label">Failed row (schema / constraint conflict)</div>
        </div>
      </div>

      <div class="outcome-banner">
        <div class="outcome-content">
          <span class="status-badge status-failed">failed</span>
          <span class="outcome-text"><strong>Partial load &mdash; review the failed record:</strong> Row 14 rejected due to capacity limit overflow in Pen P-04 (incoming 40 head exceeds 34 open spaces). Live operating records preserved.</span>
        </div>
        <span class="status-badge status-waiting">waiting</span>
      </div>
    </section>

    <!-- Section 2: Proposed-solution summary -->
    <section class="panel">
      <div class="panel-header">
        <h2 class="section-title">Proposed solution summary</h2>
        <p class="section-desc">A unified, real-time operating system replacing disconnected whiteboards and spreadsheets with cross-validated cattle, inventory, and performance records.</p>
      </div>
      <div class="data-table-wrap">
        <table class="data-table">
          <thead>
            <tr>
              <th style="width: 220px;">Operational domain</th>
              <th>Current feedlot challenge</th>
              <th>System capability & cross-validation</th>
              <th style="width: 140px;">Status</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td class="font-heading"><strong>Cattle & pen occupancy</strong></td>
              <td>Split purchase orders and unpenned lots get lost; pens exceed safe bunk capacity.</td>
              <td>Explicit capacity enforcement (e.g. P-04 116/150 head, 34 open); unpenned lots (L-243, 24 head) flagged as unavailable for bunk delivery.</td>
              <td><span class="status-badge status-good">good</span></td>
            </tr>
            <tr>
              <td class="font-heading"><strong>Feed inventory & bunk delivery</strong></td>
              <td>Unmeasured spoilage and wastage are silently lumped into feed-to-gain conversions.</td>
              <td>Direct ration formulations (Grower 1, Finisher 2) with distinct wastage logging (116 lb actual) and a 4.2% projected burn model.</td>
              <td><span class="status-badge status-good">good</span></td>
            </tr>
            <tr>
              <td class="font-heading"><strong>Performance intelligence</strong></td>
              <td>ADG and FCR calculations lag weeks behind scale measurements and feed delivery logs.</td>
              <td>Automated reconciliation linking verified scale dates to historical feed delivery pounds for precise cost per pound of gain.</td>
              <td><span class="status-badge status-good">good</span></td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- Section 3: Architecture diagram -->
    <section class="panel">
      <div class="panel-header">
        <h2 class="section-title">System architecture & validation flow</h2>
        <p class="section-desc">Responsive web client interfacing through strict validation pipelines to shared storage, deterministic calculation engines, and management outputs.</p>
      </div>

      <div class="diagram-wrap">
        <div class="diagram-flow">
          <!-- Step 1 -->
          <div class="diagram-box">
            <div>
              <span class="diagram-tag">Client layer</span>
              <div class="diagram-box-title">Responsive web app</div>
            </div>
            <div class="diagram-box-desc">Desktop and handheld bunk-side interfaces for Mara Ortega, Eli Chen, and Diego Ruiz.</div>
          </div>

          <!-- Arrow -->
          <div class="diagram-arrow">&rarr;</div>

          <!-- Step 2 -->
          <div class="diagram-box">
            <div>
              <span class="diagram-tag">Ingestion & store</span>
              <div class="diagram-box-title">Import & record store</div>
            </div>
            <div class="diagram-box-desc">Validation path parsing PO/receiving CSV files, enforcing pen headroom and rejecting duplicate rows.</div>
          </div>

          <!-- Arrow -->
          <div class="diagram-arrow">&rarr;</div>

          <!-- Step 3 (Highlight) -->
          <div class="diagram-box highlight">
            <div>
              <span class="diagram-tag" style="color: var(--primary);">Calculation engine</span>
              <div class="diagram-box-title">FeedToGainCalculator</div>
            </div>
            <div class="diagram-box-desc">Public calculation module compiling verified chute weights, feeding dates, as-fed intake, and formulation cost.</div>
          </div>
        </div>

        <div style="margin-top: 16px; padding-top: 16px; border-top: 1px solid var(--border-color); display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px;">
          <div style="font-size: 14px; color: var(--text-muted);">
            <strong>Downstream outputs:</strong> Inventory outlooks, bunk delivery sheets, lot gain scorecards, and management financial reports.
          </div>
          <div style="display: flex; gap: 8px;">
            <span class="status-badge status-good">good</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Section 4: Guided demonstration sequence -->
    <section class="panel">
      <div class="panel-header">
        <h2 class="section-title">Guided demonstration sequence</h2>
        <p class="section-desc">Trace an active cattle cohort through procurement, penning, feeding plans, execution logs, and final gain calculations.</p>
      </div>

      <div class="step-list">
        <div class="step-item">
          <div class="step-num mono">1</div>
