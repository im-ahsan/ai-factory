\n    formDate: saved ? \"2025-04-21\" : \"2025-04-23\",\n    formWeight: invalid ? \"99999\" : saved ? \"860\" : \"842\",\n  };\n}\n\nfunction responseError(data: unknown, fallback: string) {\n  if (data && typeof data === \"object\" && \"message\" in data && typeof data.message === \"string\") {\n    const details = \"details\" in data && Array.isArray(data.details)\n      ? data.details.filter((detail): detail is string => typeof detail === \"string\")\n      : [];\n    return { message: data.message, details };\n  }\n  return { message: fallback, details: [] as string[] };\n}\n\nfunction Metric({ label, value, detail }: { label: string; value: string; detail?: string }) {\n  return <div className=\"grid min-w-0 content-start gap-1 rounded-md border bg-muted/40 p-3\">\n    <span className=\"text-xs font-semibold uppercase tracking-wide text-muted-foreground\">{label}</span>\n    <strong className=\"font-mono text-xl font-semibold leading-tight\">{value}</strong>\n    {detail && <span className=\"text-xs text-muted-foreground\">{detail}</span>}\n  </div>;\n}\n\nexport function WeightRecordsContainer({ fixture }: { fixture?: string }) {\n  const fixtureMode = fixture !== undefined;\n  const fixtureData = useMemo(() => fixtureMode ? fixtureContent(fixture) : undefined, [fixture, fixtureMode]);\n  const [lotsData, setLotsData] = useState<LotsOkResponse | null>(fixtureData?.lots ?? null);\n  const [selectedLotId, setSelectedLotId] = useState(fixtureData ? \"241\" : \"\");\n  const [readings, setReadings] = useState<WeightReading[]>(fixtureData?.readings ?? []);\n  const [metrics, setMetrics] = useState<PerformanceMetrics | null>(fixtureData?.metrics ?? null);\n  const [measurementDate, setMeasurementDate] = useState(fixtureMode ? \"2025-04-23\" : today());\n  const [headcount, setHeadcount] = useState(fixtureMode ? \"60\" : \"\");\n  const [averageWeight, setAverageWeight] = useState(fixtureMode ? \"842\" : \"\");\n  const [recordedBy, setRecordedBy] = useState(fixtureMode ? \"Diego Ruiz\" : \"\");\n  const [editingId, setEditingId] = useState<number | null>(null);\n  const [deleteTarget, setDeleteTarget] = useState<WeightReading | null>(fixtureData?.deleteTarget ?? null);\n  const [error, setError] = useState(fixtureData?.error ?? \"\");\n  const [errorDetails, setErrorDetails] = useState<string[]>(fixtureData?.errorDetails ?? []);\n  const [validation, setValidation] = useState<string[]>([]);\n  const [notice, setNotice] = useState(fixtureData?.success ?? \"\");\n  const [loading, setLoading] = useState(!fixtureMode);\n  const [busy, setBusy] = useState(false);\n  const selectionRequest = useRef(0);\n\n  const lots = lotsData?.lots ?? [];\n  const selectedLot = lots.find((lot) => lot.id === Number(selectedLotId)) ?? null;\n  const orderedReadings = useMemo(() => sortReadings(readings), [readings]);\n  const latestReading = orderedReadings.at(-1) ?? null;\n  const acceptedLots = useMemo(() => lots.filter((lot) => lot.status.toLowerCase() !== \"rejected\"), [lots]);\n  const displayedMetrics = metrics ?? (!lotsData && loading ? INITIAL_PERFORMANCE_PREVIEW : null);\n\n  useEffect(() => {\n    if (fixtureMode) {\n      const data = fixtureContent(fixture);\n      setLotsData(data.lots);\n      setSelectedLotId(\"241\");\n      setReadings(data.readings);\n      setMetrics(data.metrics);\n      setDeleteTarget(data.deleteTarget);\n      setError(data.error);\n      setErrorDetails(data.errorDetails);\n      setNotice(data.success);\n      setMeasurementDate(data.formDate);\n      setHeadcount(\"60\");\n      setAverageWeight(data.formWeight);\n      setRecordedBy(\"Diego Ruiz\");\n      setLoading(false);\n      return;\n    }\n\n    let active = true;\n    const load = async () => {\n      setLoading(true);\n      setError(\"\");\n      try {\n        const lotsResponse = await getLots();\n        if (lotsResponse.status !== 200) {\n          throw new Error(responseError(lotsResponse.data, \"Weight records could not be loaded.\").message);\n        }\n        const initialLot = lotsResponse.data.lots.find((lot) => lot.penId !== null) ?? lotsResponse.data.lots[0];\n        if (!initialLot) {\n          if (active) setLotsData(lotsResponse.data);\n          return;\n        }\n        const [readingsResponse, performanceResponse] = await Promise.all([\n          getWeightReadings(initialLot.id),\n          getLotPerformance(initialLot.id),\n        ]);\n        if (readingsResponse.status !== 200 || performanceResponse.status !== 200) {\n          throw new Error(\"Weight readings or lot performance could not be loaded.\");\n        }\n        if (!active) return;\n","chars":10143,"exitCode":0}
