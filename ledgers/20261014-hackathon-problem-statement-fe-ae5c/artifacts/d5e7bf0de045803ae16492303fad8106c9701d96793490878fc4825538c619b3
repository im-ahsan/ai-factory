    expectMetric("feed cost per pound of gain", /0\.82/);
    expectMetric("projected ship date", /2026-12-15|12\/15\/2026|dec(?:ember)? 15,? 2026/i);
  });

  it("AC_12_2_UsesAsFedPoundsAsFeedConversionRatioBasis", async () => {
    answerWeightScreen();
    at("/weights");
    render(<WeightRecordsContainer />);

    expectMetric("total feed consumed as-fed", /44,?928/);
    expectMetric("feed conversion ratio", /6\.4/);
    expect(44928 / 7020).toBeCloseTo(6.4, 1);
  });

  it("AC_12_3_ShowsReturnedTotalGainAndAverageDailyGain", async () => {
    answerWeightScreen();
    at("/weights");
    render(<WeightRecordsContainer />);

    expectMetric("total weight gain", /7,?020/);
    expectMetric("average daily gain", /3\.1/);
  });

  it("AC_12_4_ShowsLatestMetricsAsSoonAsAWeightRecordIsSaved", async () => {
    const createResponse = getCreateWeightReadingResponseMock();
    Object.assign(createResponse.metrics, {
      daysOnFeed: 121, totalWeightGainLb: 8120, averageDailyGainLbPerDay: 3.4,
      totalFeedConsumedAsFedLb: 44928, feedConversionRatio: 5.5, feedCostPerPoundOfGain: 0.76,
      projectedShipDate: "2026-12-16",
    });
    const editedResponse = getUpdateWeightReadingResponseMock();
    Object.assign(editedResponse.metrics, {
      daysOnFeed: 122, totalWeightGainLb: 8300, averageDailyGainLbPerDay: 3.6,
      totalFeedConsumedAsFedLb: 45120, feedConversionRatio: 5.4, feedCostPerPoundOfGain: 0.75,
      projectedShipDate: "2026-12-17",
    });
    const deletedResponse = getDeleteWeightReadingResponseMock();
    Object.assign(deletedResponse.metrics, {
      daysOnFeed: 120, totalWeightGainLb: 7020, averageDailyGainLbPerDay: 3.1,
      totalFeedConsumedAsFedLb: 44928, feedConversionRatio: 6.4, feedCostPerPoundOfGain: 0.82,
      projectedShipDate: "2026-12-15",
    });
    createResponse.metrics.feedCostPerPoundOfGain = 0.76;
    server.use(
      getGetLotsMockHandler(getGetLotsResponseMock()),
      getGetWeightReadingsMockHandler(getGetWeightReadingsResponseMock()),
      getCreateWeightReadingMockHandler(createResponse),
      getUpdateWeightReadingMockHandler(editedResponse),
      getDeleteWeightReadingMockHandler(deletedResponse),
      getGetLotPerformanceMockHandler(getGetLotPerformanceResponseMock()),
    );
    at("/weights");
    render(<WeightRecordsContainer />);
    const user = userEvent.setup();

    await fillNewWeightRecord(user);
    await user.click(await screen.findByRole("button", { name: "Save weight record" }));

    const assertMetrics = (metrics: typeof createResponse.metrics) => {
      expectMetric("days on feed", String(metrics.daysOnFeed));
      expectMetric("total weight gain", String(metrics.totalWeightGainLb));
      expectMetric("average daily gain", String(metrics.averageDailyGainLbPerDay));
      expectMetric("total feed consumed", String(metrics.totalFeedConsumedAsFedLb));
      expectMetric("feed conversion ratio", String(metrics.feedConversionRatio));
      expectMetric("feed cost per pound of gain", String(metrics.feedCostPerPoundOfGain));
      expectMetric("projected ship date", String(metrics.projectedShipDate));
    };
    assertMetrics(createResponse.metrics);

    await user.click(await screen.findByRole("button", { name: "Edit" }));
    const editWeight = await screen.findByLabelText("Average weight (lb/head)");
    await user.clear(editWeight);
    await user.type(editWeight, "800");
    await user.click(await screen.findByRole("button", { name: "Save weight record" }));
    await waitFor(() => assertMetrics(editedResponse.metrics));

    await user.click(await screen.findByRole("button", { name: "Delete" }));
    await user.click(await screen.findByRole("button", { name: "Confirm delete" }));
    assertMetrics(deletedResponse.metrics);
  });

  it("AC_12_5_LabelsFeedCostPerPoundOfGainWithoutProfitabilityClaims", async () => {
    answerWeightScreen();
    at("/weights");
    render(<WeightRecordsContainer />);

    expectMetric("feed cost per pound of gain", /0\.82/);
    expect(screen.queryByText(/\bROI\b/i)).toBeNull();
    expect(screen.queryByText(/profitability/i)).toBeNull();
  });
});

describe("feed-to-gain calculation acceptance", () => {
  it("AC_13_1_CalculatesFeedToGainWithConvertedUnitsAndDefaultProjection", () => {
    const calculated = FeedToGainCalculator.calculate({
      receivingDate: "2026-01-01",
      asOfDate: "2026-01-11",
      entryAverageWeightLb: 500,
      currentAverageWeightLb: 600,
      entryHeadcount: 10,
      currentHeadcount: 9,
      feedingEvents: [
        { quantity: 100, unit: "lb", cost: 100 },
        { quantity: 10, unit: "kg", cost: 50 },
        { quantity: 1, unit: "ton", cost: 200 },
      ],
      targetWeightLb: 800,
      defaultAdgLbPerDay: 2,
    });

    expect(calculated).toEqual({
      daysOnFeed: 10,
      totalGainLb: 400,
      averageDailyGainLbPerDay: 40,
      totalFeedAsFedLb: 100 + 10 * 2.20462 + 2000,
      feedConversionRatio: (100 + 10 * 2.20462 + 2000) / 400,
      feedCostPerPoundOfGain: 350 / 400,
      projectedMarketDate: "2026-01-16",
    });

    const unavailableAdg = FeedToGainCalculator.calculate({
      receivingDate: "2026-01-01",
      asOfDate: "2026-01-11",
      entryAverageWeightLb: 500,
      currentAverageWeightLb: 500,
      entryHeadcount: 10,
      currentHeadcount: 10,
      feedingEvents: [],
      targetWeightLb: 520,
      defaultAdgLbPerDay: 2,
    });
    expect(unavailableAdg.averageDailyGainLbPerDay).toBeNull();
    expect(unavailableAdg.projectedMarketDate).toBe("2026-01-21");
  });
});

