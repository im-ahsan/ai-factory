function answerWeightScreen(): void {
  server.use(
    getGetLotsMockHandler(getGetLotsResponseMock()),
    getGetWeightReadingsMockHandler(getGetWeightReadingsResponseMock()),
    getGetLotPerformanceMockHandler(getGetLotPerformanceResponseMock()),
  );
}

async function chooseLot(user: ReturnType<typeof userEvent.setup>): Promise<void> {
  const targetLot = await screen.findByRole("combobox", { name: "Target lot" });
  if (targetLot instanceof HTMLSelectElement) {
    await user.selectOptions(targetLot, "101");
    return;
  }

  await user.click(targetLot);
  await user.click(await screen.findByRole("option", { name: /Lot 24-A/ }));
}

async function fillNewWeightRecord(user: ReturnType<typeof userEvent.setup>): Promise<void> {
  await chooseLot(user);

  const date = await screen.findByLabelText("Measurement date");
  await user.clear(date);
  await user.type(date, "2026-10-14");

  const headcount = await screen.findByLabelText("Applicable headcount");
  await user.clear(headcount);
  await user.type(headcount, "52");

  const averageWeight = await screen.findByLabelText("Average weight (lb/head)");
  await user.clear(averageWeight);
  await user.type(averageWeight, "785");

  const recordedBy = await screen.findByLabelText("Recorded by");
  await user.clear(recordedBy);
  await user.type(recordedBy, "Yard manager");
}

function expectVisibleNumber(pattern: RegExp): void {
  expect(screen.getByText(pattern)).toBeTruthy();
}

function visibleValuePattern(value: string): RegExp {
  const escaped = value.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
  return new RegExp(escaped.replace(/\B(?=(\d{3})+(?!\d))/g, ",?"), "i");
}

function expectMetric(label: string, value: string | RegExp): void {
  const visible = document.body.textContent?.replace(/\s+/g, " ").toLowerCase() ?? "";
  const start = visible.indexOf(label.toLowerCase());
  expect(start, `expected visible metric label: ${label}`).toBeGreaterThanOrEqual(0);
  const metricText = visible.slice(start, start + 110);
  expect(metricText).toMatch(typeof value === "string" ? visibleValuePattern(value) : value);
}

describe("weight records and lot performance acceptance", () => {
  it("AC_11_1_ShowsReturnedWeightMeasurementAfterSave", async () => {
    const returned = getCreateWeightReadingResponseMock();
    returned.readings[0] = {
      ...returned.readings[0], measurementDate: "2026-10-12", animalsWeighed: 48,
      averageWeightLb: 802, totalLotWeightLb: 38496, gainSincePriorLb: 876, notes: "Scale verified",
    };
    server.use(
      getGetLotsMockHandler(getGetLotsResponseMock()),
      getGetWeightReadingsMockHandler(getGetWeightReadingsResponseMock()),
      getCreateWeightReadingMockHandler(returned),
      getGetLotPerformanceMockHandler(getGetLotPerformanceResponseMock()),
    );
    at("/weights");
    render(<WeightRecordsContainer />);
    const user = userEvent.setup();

    await fillNewWeightRecord(user);
    await user.click(await screen.findByRole("button", { name: "Save weight record" }));

    expectVisibleNumber(/2026-10-12|10\/12\/2026|Oct(?:ober)? 12,? 2026/i);
    expectVisibleNumber(/\b48\b/);
    expectVisibleNumber(/\b802\b/);
    expectVisibleNumber(/38,?496/);
    expectVisibleNumber(/876/);
    expect(screen.getByText("Scale verified")).toBeTruthy();
  });

  it("AC_11_2_ShowsWeightHistoryInDateOrderWithReadingControls", async () => {
    const example = getGetWeightReadingsResponseMock();
    const first = example.readings[0];
    const twoReadingHistory = {
      readings: [
        first,
        {
          ...first,
          id: 602,
          measurementDate: "2026-10-14",
          averageWeightLb: 785,
          totalLotWeightLb: 40820,
          gainSincePriorLb: 1300,
          notes: "Routine weighing",
        },
      ],
    };
    server.use(
      getGetLotsMockHandler(getGetLotsResponseMock()),
      getGetWeightReadingsMockHandler(twoReadingHistory),
      getGetLotPerformanceMockHandler(getGetLotPerformanceResponseMock()),
    );
    at("/weights");
    render(<WeightRecordsContainer />);

    const olderDate = await screen.findByText("2026-10-01");
    const newerDate = screen.getByText("2026-10-14");
    expect(
      olderDate.compareDocumentPosition(newerDate) & Node.DOCUMENT_POSITION_FOLLOWING,
    ).toBe(Node.DOCUMENT_POSITION_FOLLOWING);
    const olderWeight = await screen.findByText(/\b760\b/);
    const newerWeight = screen.getByText(/\b785\b/);
    expect(
      olderWeight.compareDocumentPosition(newerWeight) & Node.DOCUMENT_POSITION_FOLLOWING,
    ).toBe(Node.DOCUMENT_POSITION_FOLLOWING);
    expect(screen.getByRole("columnheader", { name: "Date" })).toBeTruthy();
    expect(screen.getByRole("columnheader", { name: "Avg weight" })).toBeTruthy();
    expect(screen.getByRole("columnheader", { name: "Head" })).toBeTruthy();
    expect(screen.getByRole("button", { name: "Save weight record" })).toBeTruthy();
    expect(screen.getAllByRole("button", { name: "Edit" }).length).toBeGreaterThan(0);
    expect(screen.getAllByRole("button", { name: "Delete" }).length).toBeGreaterThan(0);
  });

  it("AC_11_3_ShowsReturnedSeriesAndRecalculatedMetricsAfterEdit", async () => {
    const readings = getGetWeightReadingsResponseMock();
    const older = readings.readings[0];
    const newer = {
      ...older, id: 602, measurementDate: "2026-10-14", averageWeightLb: 785,
      totalLotWeightLb: 40820, gainSincePriorLb: 1300, notes: "Routine weighing",
    };
    readings.readings = [older, newer];
    const edited = getUpdateWeightReadingResponseMock();
    edited.readings = [
      older,
      { ...newer, measurementDate: "2026-10-15", averageWeightLb: 812, totalLotWeightLb: 42224, gainSincePriorLb: 2704, notes: "Corrected scale reading" },
    ];
    edited.metrics.totalWeightGainLb = 8424;
    edited.metrics.averageDailyGainLbPerDay = 3.5;
    const deleted = getDeleteWeightReadingResponseMock();
    deleted.readings = [older];
    deleted.metrics.totalWeightGainLb = 5720;
    deleted.metrics.averageDailyGainLbPerDay = 2.9;
    server.use(
      getGetLotsMockHandler(getGetLotsResponseMock()),
      getGetWeightReadingsMockHandler(readings),
      getUpdateWeightReadingMockHandler(edited),
      getDeleteWeightReadingMockHandler(deleted),
      getGetLotPerformanceMockHandler(getGetLotPerformanceResponseMock()),
    );
    at("/weights");
    render(<WeightRecordsContainer />);
    const user = userEvent.setup();

    await user.click((await screen.findAllByRole("button", { name: "Edit" })).at(-1)!);
    const averageWeight = await screen.findByLabelText("Average weight (lb/head)");
    await user.clear(averageWeight);
    await user.type(averageWeight, "812");
    await user.click(await screen.findByRole("button", { name: "Save weight record" }));

    expectVisibleNumber(/2026-10-15/);
    expectVisibleNumber(/\b812\b/);
    expectVisibleNumber(/42,?224/);
    expectVisibleNumber(/8,?424/);
    expectVisibleNumber(/3\.5/);
    expect(screen.getByText("Corrected scale reading")).toBeTruthy();

    await user.click((await screen.findAllByRole("button", { name: "Delete" })).at(-1)!);
    await screen.findByText(/cannot be undone/i);
    await user.click(await screen.findByRole("button", { name: "Confirm delete" }));
    expectVisibleNumber(/2026-10-01/);
    expect(screen.queryByText("2026-10-15")).toBeNull();
    expectMetric("total weight gain", /5,?720/);
    expectMetric("average daily gain", /2\.9/);

    server.use(
      http.put("*/lots/:lotId/weight-readings/:readingId", () => HttpResponse.json({
        code: "validation_error", message: "Average weight is outside the accepted range.", details: ["Use a value below 2000 lb per head."],
      }, { status: 422 })),
    );
    await user.click(await screen.findByRole("button", { name: "Edit" }));
    const invalidAverage = await screen.findByLabelText("Average weight (lb/head)");
    await user.clear(invalidAverage);
    await user.type(invalidAverage, "99999");
    await user.click(await screen.findByRole("button", { name: "Save weight record" }));
    await screen.findByText("Average weight is outside the accepted range.");
    expect(screen.getByText("2026-10-01")).toBeTruthy();
    expect(screen.queryByText("99999")).toBeNull();
    expectMetric("total weight gain", /5,?720/);
  });

  it("AC_12_1_ShowsAllReturnedLotPerformanceMetrics", async () => {
    answerWeightScreen();
