{"files":[{"added":["import { useEffect, useMemo, useState, type FormEvent } from \"react\";","import { Button } from \"@/components/ui/button\";","import { Card, CardContent, CardHeader, CardTitle } from \"@/components/ui/card\";","import { Input } from \"@/components/ui/input\";","import { Label } from \"@/components/ui/label\";","import { Notice, NoticeDescription, NoticeTitle } from \"@/components/ui/notice\";","import { Skeleton } from \"@/components/ui/skeleton\";","import { StatusBadge, toneOf } from \"@/components/ui/status-badge\";","import { Table, TableBody, TableCell, TableHead, TableHeader, TableRow } from \"@/components/ui/table\";","import { Link } from \"@/lib/nav\";","import { getFeedingActivities, getFeedingPlans, getLots, getRations, recordFeedingActivity } from \"@/lib/api/client\";","import type { FeedingActivity, FeedingActivityRequest, FeedingPlan, LotsOkResponse, Ration, RationsOkResponse } from \"@/lib/api/client.schemas\";","","const SAMPLE_LOTS: LotsOkResponse = {","  lots: [","    { id: 241, name: \"L-241\", penId: 4, penName: \"P-04\", headCount: 60, breed: \"Angus–Hereford\", sex: \"steers\", sourcePurchaseOrderLine: \"PO-5831 line 1\", status: \"good\", targetWeightLb: 1350, defaultGainRateLbPerDay: 3, measuredAdgLbPerDay: 2.35 },","    { id: 242, name: \"L-242\", penId: 4, penName: \"P-04\", headCount: 56, breed: \"Charolais-cross\", sex: \"heifers\", sourcePurchaseOrderLine: \"PO-5840 line 1\", status: \"good\", targetWeightLb: 1350, defaultGainRateLbPerDay: 3, measuredAdgLbPerDay: null },","    { id: 239, name: \"L-239\", penId: 2, penName: \"P-02\", headCount: 72, breed: \"Angus\", sex: \"steers\", sourcePurchaseOrderLine: \"PO-5790 line 1\", status: \"good\", targetWeightLb: 1350, defaultGainRateLbPerDay: 3, measuredAdgLbPerDay: 2.95 },","  ],","  pens: [","    { id: 4, name: \"P-04\", capacity: 150, currentAnimalCount: 116, activeLotCount: 2, status: \"good\" },","    { id: 2, name: \"P-02\", capacity: 120, currentAnimalCount: 72, activeLotCount: 1, status: \"good\" },","  ],","};","","const SAMPLE_RATIONS: RationsOkResponse = {","  rations: [{ id: 31, name: \"Grower 1\", type: \"Grower\", targetWeightMinLb: 548, targetWeightMaxLb: 900, operationalStatus: \"Active\", costPerLb: 0.15286, ingredients: [","    { itemId: 11, name: \"Yellow corn\", proportionPercent: 55, dryMatterPercent: 88, energyMcalPerKg: 3.3, costPerLb: 0.112 },","    { itemId: 12, name: \"Alfalfa hay\", proportionPercent: 30, dryMatterPercent: 91, energyMcalPerKg: 2.1, costPerLb: 0.145 },","    { itemId: 13, name: \"Soybean meal\", proportionPercent: 12, dryMatterPercent: 89, energyMcalPerKg: 3, costPerLb: 0.238 },","    { itemId: 14, name: \"Mineral premix\", proportionPercent: 3, dryMatterPercent: 95, energyMcalPerKg: 1.4, costPerLb: 0.64 },","  ] }],","};","","const SAMPLE_PLANS: FeedingPlan[] = [","  { id: 401, date: \"2025-04-22\", penId: 4, penName: \"P-04\", lotId: 241, lotName: \"L-241\", animalCount: 116, rationId: 31, rationName: \"Grower 1\", plannedQuantityLb: 1624, plannedTime: \"07:00\", quantityPerAnimalLb: 14, totalFeedCost: 248.25, expectedEnergyMcal: 1967, status: \"Completed\", actualQuantityLb: null, varianceLb: null },","  { id: 400, date: \"2025-04-19\", penId: 2, penName: \"P-02\", lotId: 239, lotName: \"L-239\", animalCount: 72, rationId: 31, rationName: \"Grower 1\", plannedQuantityLb: 1296, plannedTime: \"07:00\", quantityPerAnimalLb: 18, totalFeedCost: 198.11, expectedEnergyMcal: 1570, status: \"Completed\", actualQuantityLb: null, varianceLb: null },","];","","const SAMPLE_ACTIVITY: FeedingActivity = {","  id: 801, date: \"2025-04-22\", penId: 4, penName: \"P-04\", manager: \"Mara Ortega\", rationId: 31, rationName: \"Grower 1\", feedingPlanId: 401,","  plannedQuantityLb: 1624, actualQuantityLb: 1624, varianceLb: 0, status: \"Completed\", feedCost: 248.24, energyMcal: 2452,","  ingredientConsumption: [","    { itemId: 11, itemName: \"Yellow corn\", quantityLb: 893.2 },","    { itemId: 12, itemName: \"Alfalfa hay\", quantityLb: 487.2 },","    { itemId: 13, itemName: \"Soybean meal\", quantityLb: 194.9 },","    { itemId: 14, itemName: \"Mineral premix\", quantityLb: 48.7 },","  ],","  lotConsumption: [{ lotId: 241, lotName: \"L-241\", quantityLb: 840 }, { lotId: 242, lotName: \"L-242\", quantityLb: 784 }],","};","","const SAMPLE_SECOND_ACTIVITY: FeedingActivity = {","  ...SAMPLE_ACTIVITY, id: 800, date: \"2025-04-19\", penId: 2, penName: \"P-02\", plannedQuantityLb: 1296, actualQuantityLb: 1296,","  lotConsumption: [{ lotId: 239, lotName: \"L-239\", quantityLb: 1296 }],","};","","const number = (value: number, digits = 2) => new Intl.NumberFormat(\"en-US\", { maximumFractionDigits: digits }).format(value);","const currency = (value: number) => `$${number(value, 2)}`;","const validDate = (value: string) => /^\\d{4}-\\d{2}-\\d{2}$/.test(value) && !Number.isNaN(new Date(`${value}T12:00:00Z`).valueOf()) && new Date(`${value}T12:00:00Z`).toISOString().slice(0, 10) === value;","const today = () => {","  const date = new Date();","  return `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, \"0\")}-${String(date.getDate()).padStart(2, \"0\")}`;","};","const displayDate = (value: string) => {","  const date = new Date(`${value.slice(0, 10)}T12:00:00Z`);","  return Number.isNaN(date.valueOf()) ? value : new Intl.DateTimeFormat(\"en-GB\", { day: \"2-digit\", month: \"short\", year: \"numeric\", timeZone: \"UTC\" }).format(date);","};","","function FieldError({ children }: { children?: string }) {","  return children ? <p className=\"text-sm text-destructive\" role=\"alert\">{children}</p> : null;","}","","function Metric({ label, value, detail }: { label: string; value: string; detail?: string }) {","  return <div className=\"grid min-w-0 content-start gap-1 rounded-md bg-muted/60 p-3\">","    <span className=\"text-xs font-semibold uppercase tracking-wide text-muted-foreground\">{label}</span>","    <strong className=\"font-heading text-xl font-semibold leading-tight\">{value}</strong>","    {detail && <span className=\"truncate text-xs text-muted-foreground\">{detail}</span>}","  </div>;","}","","function activityError(data: unknown, fallback: string) {","  if (data && typeof data === \"object\" && \"message\" in data && typeof data.message === \"string\") {","    const details = \"details\" in data && Array.isArray(data.details) ? data.details.filter((detail): detail is string => typeof detail === \"string\") : [];","    return { message: data.message, details };","  }","  return { message: fallback, details: [] as string[] };","}","","  const fixtureMode = fixture !== undefined;","  const fixtureValidation = Boolean(fixture && /validation|invalid/i.test(fixture));","  const fixtureSuccess = Boolean(fixture && /success|saved|returned/i.test(fixture));","  const fixtureShortage = Boolean(fixture && /shortage|inventory/i.test(fixture));","  const fixtureDefault = fixtureMode && !fixtureValidation && !fixtureSuccess && !fixtureShortage;","  const initialActivities = fixtureMode ? (fixtureShortage || fixtureValidation ? [] : [SAMPLE_ACTIVITY, SAMPLE_SECOND_ACTIVITY]) : [];","  const [lotData, setLotData] = useState<LotsOkResponse | null>(fixtureMode ? SAMPLE_LOTS : null);","  const [rationData, setRationData] = useState<RationsOkResponse | null>(fixtureMode ? SAMPLE_RATIONS : null);","  const [plans, setPlans] = useState<FeedingPlan[]>(fixtureMode ? SAMPLE_PLANS : []);","  const [activities, setActivities] = useState<FeedingActivity[]>(initialActivities);","  const [selectedActivity, setSelectedActivity] = useState<FeedingActivity | null>(fixtureSuccess || fixtureDefault ? SAMPLE_ACTIVITY : null);","  const [selectedPenId, setSelectedPenId] = useState(fixtureMode ? \"4\" : \"\");","  const [selectedRationId, setSelectedRationId] = useState(fixtureMode ? \"31\" : \"\");","  const [selectedPlanId, setSelectedPlanId] = useState(\"\");","  const [activityDate, setActivityDate] = useState(fixtureMode ? \"2025-04-23\" : today());","  const [lotQuantities, setLotQuantities] = useState<Record<number, string>>({});","  const [validation, setValidation] = useState<string[]>(fixtureValidation ? [\"Enter a separate actual quantity greater than zero for every affected lot.\"] : []);","  const [loading, setLoading] = useState(!fixtureMode);","  const [busy, setBusy] = useState(false);","  const [hasSavedResult, setHasSavedResult] = useState(fixtureSuccess);","  const [error, setError] = useState(fixtureShortage ? \"Insufficient inventory to save the requested activity.\" : \"\");","  const [errorDetails, setErrorDetails] = useState<string[]>(fixtureShortage ? [\"Requested 1200 lb; 900 lb is available.\"] : []);","  const [showDetails, setShowDetails] = useState(fixtureSuccess || fixtureDefault);","","  useEffect(() => {","    if (fixtureMode) {","      setLotData(SAMPLE_LOTS);","      setRationData(SAMPLE_RATIONS);","      setPlans(SAMPLE_PLANS);","      setActivities(initialActivities);","      setSelectedActivity(fixtureSuccess || fixtureDefault ? SAMPLE_ACTIVITY : null);","      setLoading(false);","      return;","    }","    let active = true;","    const load = async () => {","      setLoading(true);","      setError(\"\");","      try {","        const [lotsResponse, rationsResponse, plansResponse, activitiesResponse] = await Promise.all([","          getLots(), getRations(), getFeedingPlans(), getFeedingActivities(),","        ]);","        if (lotsResponse.status !== 200 || rationsResponse.status !== 200 || plansResponse.status !== 200 || activitiesResponse.status !== 200) {","          throw new Error(\"Feeding log data could not be loaded.\");","        }","        if (!active) return;","        setLotData(lotsResponse.data);","        setRationData(rationsResponse.data);","        setPlans(plansResponse.data.plans);","        setActivities(activitiesResponse.data.activities);","        setSelectedActivity(activitiesResponse.data.activities[0] ?? null);","        setSelectedPenId(lotsResponse.data.pens[0] ? String(lotsResponse.data.pens[0].id) : \"\");","        setSelectedRationId(rationsResponse.data.rations.find((ration) => !/inactive|archived/i.test(ration.operationalStatus)) ? String(rationsResponse.data.rations.find((ration) => !/inactive|archived/i.test(ration.operationalStatus))?.id) : \"\");","      } catch {","        if (active) setError(\"Feeding log data could not be loaded. Try again in a moment.\");","      } finally {","        if (active) setLoading(false);","      }","    };","    void load();","    return () => { active = false; };","  }, [fixture, fixtureMode, fixtureSuccess, fixtureShortage, fixtureValidation, fixtureDefault]);","","  const pens = lotData?.pens ?? [];","  const rations = useMemo(() => (rationData?.rations ?? []).filter((ration) => !/inactive|archived/i.test(ration.operationalStatus)), [rationData]);","  const selectedPen = pens.find((pen) => pen.id === Number(selectedPenId)) ?? null;","  const selectedRation = rations.find((ration) => ration.id === Number(selectedRationId)) ?? null;","  const penLots = useMemo(() => (lotData?.lots ?? []).filter((lot) => lot.penId === selectedPen?.id), [lotData, selectedPen]);","  const eligiblePlans = useMemo(() => plans.filter((plan) => plan.penId === selectedPen?.id), [plans, selectedPen]);","  const recentActivities = selectedActivity ? activities.filter((activity) => activity.id !== selectedActivity.id && !activity.lotConsumption.some((oldLot) => selectedActivity.lotConsumption.some((savedLot) => savedLot.lotId === oldLot.lotId))) : activities;","  const actualTotal = penLots.reduce((total, lot) => total + (Number(lotQuantities[lot.id]) || 0), 0);","  const facilityDate = fixtureMode ? \"23 Apr 2025\" : new Intl.DateTimeFormat(\"en-GB\", { day: \"2-digit\", month: \"short\", year: \"numeric\", timeZone: \"America/Denver\" }).format(new Date());","","  const changePen = (penId: string) => {","    setSelectedPenId(penId);","    setSelectedPlanId(\"\");","    setLotQuantities({});","    setValidation([]);","    setHasSavedResult(false);","  };","","  const saveFixtureActivity = (request: FeedingActivityRequest) => {","    const ration = rations.find((item) => item.id === request.rationId);","    const plan = plans.find((item) => item.id === request.feedingPlanId);","    const lots = request.lotQuantities.map((item) => ({","      lotId: item.lotId,","      lotName: lotData?.lots.find((lot) => lot.id === item.lotId)?.name ?? `Lot ${item.lotId}`,","      quantityLb: item.actualQuantityLb,","    }));","    const total = lots.reduce((sum, lot) => sum + lot.quantityLb, 0);","    const ingredientConsumption = (ration?.ingredients ?? []).map((ingredient) => ({","      itemId: ingredient.itemId, itemName: ingredient.name, quantityLb: Math.round(total * ingredient.proportionPercent) / 100,","    }));","    const activity: FeedingActivity = {","      id: 803, date: request.date, penId: request.penId, penName: selectedPen?.name ?? \"Pen\", manager: \"Mara Ortega\",","      rationId: request.rationId, rationName: ration?.name ?? \"Ration\", feedingPlanId: plan?.id ?? null,","      plannedQuantityLb: plan?.plannedQuantityLb ?? null, actualQuantityLb: total,","      varianceLb: plan ? total - plan.plannedQuantityLb : null, status: plan ? \"Completed\" : \"Unplanned\",","      feedCost: total * (ration?.costPerLb ?? 0), energyMcal: total * 1.21, ingredientConsumption, lotConsumption: lots,","    };","    setSelectedActivity(activity);","    setActivities((current) => [activity, ...current.filter((item) => item.id !== activity.id)]);","    setShowDetails(true);","    setHasSavedResult(true);","    setError(\"\");","    setErrorDetails([]);","  };","","  const submit = async (event: FormEvent<HTMLFormElement>) => {","    event.preventDefault();","    const errors: string[] = [];","    if (!selectedPen) errors.push(\"Select a pen.\");","    if (!validDate(activityDate)) errors.push(\"Enter a valid feeding date.\");","    if (!selectedRation) errors.push(\"Select a ration.\");","    if (penLots.length === 0) errors.push(\"The selected pen has no eligible lots for feeding.\");","    const quantities = penLots.map((lot) => ({ lotId: lot.id, actualQuantityLb: Number(lotQuantities[lot.id]) }));","    if (quantities.some((item) => !Number.isFinite(item.actualQuantityLb) || item.actualQuantityLb <= 0)) {","      errors.push(\"Enter a separate actual quantity greater than zero for every affected lot.\");","    }","    setValidation(errors);","    setError(\"\");","    setErrorDetails([]);","    setHasSavedResult(false);","    if (errors.length > 0) return;","    const request: FeedingActivityRequest = {","      penId: Number(selectedPenId), date: activityDate, rationId: Number(selectedRationId),","      feedingPlanId: selectedPlanId ? Number(selectedPlanId) : null, lotQuantities: quantities,","    };","    if (fixtureMode) {","      if (fixtureShortage) {","        setSelectedActivity(null);","        setError(\"Insufficient inventory to save the requested activity.\");","        setErrorDetails([\"Requested 1200 lb; 900 lb is available.\"]);","        return;","      }","      saveFixtureActivity(request);","      return;","    }","    setBusy(true);","    setSelectedActivity(null);","    try {","      const response = await recordFeedingActivity(request);","      if (response.status !== 201) {","        const failure = activityError(response.data, \"The feeding activity could not be saved.\");","        setError(failure.message);","        setErrorDetails(failure.details);","        return;","      }","      const activity = response.data.activity;","      setSelectedActivity(activity);","      setShowDetails(true);","      setHasSavedResult(true);","      setActivities((current) => [activity, ...current.filter((item) => item.id !== activity.id)]);","      try {","        const refreshed = await getFeedingActivities();","        if (refreshed.status === 200) {","          setActivities((current) => [activity, ...refreshed.data.activities.filter((item) => item.id !== activity.id)]);","        }","      } catch {","        // Keep the returned activity visible if refreshing the log is temporarily unavailable.","      }","    } catch {","      setError(\"The feeding activity could not be saved. Try again in a moment.\");","    } finally {","      setBusy(false);","    }","  };","","  return <main data-screen=\"S-8\" data-state={fixture ?? \"default\"} className=\"mx-auto grid w-full max-w-7xl content-start gap-6 p-4 sm:gap-8 sm:p-6\">","    <div className=\"flex flex-col justify-between gap-3 border-b pb-4 sm:flex-row sm:items-end\">","      <div><h1 className=\"font-heading text-3xl font-semibold tracking-tight\">Feeding log</h1></div>","      <div className=\"flex flex-wrap items-center gap-2 text-sm text-muted-foreground\"><span>Facility: Cedar Draw Feedlot</span><span aria-hidden=\"true\">·</span><span>Sample date: <span className=\"font-mono text-foreground\">{facilityDate}</span></span><span aria-hidden=\"true\">·</span><span className=\"font-mono\">America/Denver</span></div>","    </div>","","    {error && <Notice tone={error.toLowerCase().includes(\"insufficient\") ? \"bad\" : \"warn\"}><NoticeTitle>{error.toLowerCase().includes(\"insufficient\") ? \"Inventory shortage\" : \"Feeding log\"}</NoticeTitle><NoticeDescription><span>{error}</span>{errorDetails.length > 0 && <span className=\"mt-1 block\">{errorDetails.map((detail) => <span key={detail} className=\"block\">{detail}</span>)}</span>}</NoticeDescription></Notice>}","","    <div className=\"grid min-w-0 items-start gap-6 lg:grid-cols-12 lg:gap-8\">","      <Card className=\"min-w-0 lg:col-span-5\">","        <CardHeader className=\"border-b pb-4\"><CardTitle className=\"text-xl\">Record pen feeding</CardTitle><p className=\"text-sm text-muted-foreground\">Enter delivered quantities per lot for scheduled allotment.</p></CardHeader>","        <CardContent className=\"pt-5\">","          {loading ? <Skeleton className=\"h-96 w-full\" /> : <form noValidate onSubmit={submit} className=\"grid gap-4\">","            <div className=\"grid gap-4 sm:grid-cols-2\">","              <div className=\"grid gap-1.5\"><Label htmlFor=\"feeding-pen\">Pen</Label><select id=\"feeding-pen\" aria-label=\"Pen\" required value={selectedPenId} onChange={(event) => changePen(event.target.value)} className=\"h-9 w-full rounded-md border border-input bg-card px-3 text-sm\"><option value=\"\">Select a pen</option>{pens.map((pen) => <option key={pen.id} value={pen.id}>{pen.name} ({pen.currentAnimalCount} head · {pen.activeLotCount} lots)</option>)}</select></div>","              <div className=\"grid gap-1.5\"><Label htmlFor=\"feeding-date\">Date</Label><Input id=\"feeding-date\" aria-label=\"Date\" required type=\"date\" value={activityDate} onChange={(event) => { setActivityDate(event.target.value); setHasSavedResult(false); }} /></div>","            </div>","            <div className=\"grid gap-4 sm:grid-cols-2\">","              <div className=\"grid gap-1.5\"><Label htmlFor=\"feeding-ration\">Ration</Label><select id=\"feeding-ration\" aria-label=\"Ration\" required value={selectedRationId} onChange={(event) => { setSelectedRationId(event.target.value); setHasSavedResult(false); }} className=\"h-9 w-full rounded-md border border-input bg-card px-3 text-sm\"><option value=\"\">Select a ration</option>{rations.map((ration) => <option key={ration.id} value={ration.id}>{ration.name}</option>)}</select>{selectedRation && <span className=\"text-xs text-muted-foreground\">{number(selectedRation.targetWeightMinLb, 0)}–{number(selectedRation.targetWeightMaxLb, 0)} lb cattle</span>}</div>","              <div className=\"grid gap-1.5\"><Label htmlFor=\"feeding-plan\">Feeding plan (optional)</Label><select id=\"feeding-plan\" aria-label=\"Feeding plan (optional)\" value={selectedPlanId} onChange={(event) => { setSelectedPlanId(event.target.value); setHasSavedResult(false); }} className=\"h-9 w-full rounded-md border border-input bg-card px-3 text-sm\"><option value=\"\">Unplanned feeding</option>{eligiblePlans.map((plan) => <option key={plan.id} value={plan.id}>Plan #{plan.id} · {plan.rationName}</option>)}</select></div>","            </div>","","            <div className=\"grid gap-3 border-t pt-4\">","              <div className=\"flex flex-wrap items-center justify-between gap-2\"><span className=\"text-xs font-semibold uppercase tracking-wide text-muted-foreground\">Per-lot delivery allotment</span><span className=\"text-xs text-muted-foreground\">Required for every lot</span></div>","              <div className=\"grid gap-3 rounded-md border bg-muted/30 p-3\">","                {penLots.map((lot) => <div key={lot.id} className=\"grid gap-1.5\">","                  <div className=\"flex flex-wrap items-baseline justify-between gap-2 text-xs\"><Label htmlFor={`lot-quantity-${lot.id}`} className=\"font-semibold\">Delivery quantity · {lot.name}</Label><span className=\"text-muted-foreground\">{number(lot.headCount, 0)} head · {lot.breed} {lot.sex}</span></div>","                  <div className=\"relative\"><Input id={`lot-quantity-${lot.id}`} aria-label={`${lot.name} actual quantity`} type=\"number\" inputMode=\"decimal\" min=\"0.01\" step=\"0.01\" required value={lotQuantities[lot.id] ?? \"\"} onChange={(event) => { setLotQuantities((current) => ({ ...current, [lot.id]: event.target.value })); setValidation([]); setHasSavedResult(false); }} className=\"pr-10 text-right font-mono\" /><span className=\"pointer-events-none absolute right-3 top-2.5 text-xs text-muted-foreground\">lb</span></div>","                </div>)}","                {penLots.length === 0 && <p className=\"text-sm text-muted-foreground\">Select a pen with eligible lots to enter delivery quantities.</p>}","              </div>","              {validation.map((item) => <FieldError key={item}>{item}</FieldError>)}","            </div>","","            <div className=\"flex flex-wrap items-center jus