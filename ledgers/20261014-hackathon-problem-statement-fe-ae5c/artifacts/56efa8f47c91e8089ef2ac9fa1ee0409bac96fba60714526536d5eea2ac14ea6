{"ts":1791974435007,"kind":"call","tool":"Bash","input":"{\"command\":\"sed -n '1,260p' components/screens/s-2/container.tsx\"}","output":"\"use client\";\n\nimport { AlertCircle, RotateCw, Table2, RefreshCw, Info } from \"lucide-react\";\nimport { useCallback, useEffect, useMemo, useState } from \"react\";\nimport { Button } from \"@/components/ui/button\";\nimport { Card, CardContent } from \"@/components/ui/card\";\nimport { Notice, NoticeDescription, NoticeTitle } from \"@/components/ui/notice\";\nimport { Select, SelectContent, SelectItem, SelectTrigger, SelectValue } from \"@/components/ui/select\";\nimport { Skeleton } from \"@/components/ui/skeleton\";\nimport { StatusBadge } from \"@/components/ui/status-badge\";\nimport type { ImportBatch, ImportPreviewResponse, ImportRow, ImportSyncResponse } from \"@/lib/api/client.schemas\";\nimport { getImportBatches, previewImport, synchronizeImports } from \"@/lib/api/client\";\n\nconst SAMPLE_BATCHES: ImportBatch[] = [\n  { batchId: \"april-combined-2025\", sourceName: \"april_cattle_po.csv, april_receiving.csv (2 files selected)\", recordCount: 5 },\n  { batchId: \"april-po-2025\", sourceName: \"april_cattle_po.csv (84 head, 56 head)\", recordCount: 2 },\n  { batchId: \"april-receiving-2025\", sourceName: \"april_receiving.csv (142 head)\", recordCount: 3 },\n];\n\nconst SAMPLE_ROWS: ImportRow[] = [\n  { id: 1, sourceIdentifier: \"PO-5831 line 1\", sourceType: \"purchase_order\", vendor: \"Red Basin Cattle Co.\", cost: 123480, headCount: 84, weightLb: 612, breed: \"Angus–Hereford steers\", ageDays: 480, source: \"Red Basin Ranch · april_cattle_po.csv\", rowStatus: \"ready\", problemDetail: \"24 head are not assigned to a pen.\", proposedLots: [{ lotId: 241, lotName: \"L-241\", penId: 4, penName: \"P-04\", headCount: 60, capacity: 150, currentAnimalCount: 116, status: \"Proposed\" }, { lotId: 243, lotName: \"L-243\", penId: 0, penName: \"No pen\", headCount: 24, capacity: 0, currentAnimalCount: 0, status: \"Unpenned