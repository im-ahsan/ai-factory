w Intl.NumberFormat(\"en-US\", { maximumFractionDigits: 2 }).format(value);\nconst money = (value: number) => `$${new Intl.NumberFormat(\"en-US\", { maximumFractionDigits: 2 }).format(value)}`;\nconst statusLabel = (status: string) => status.replaceAll(\"_\", \" \");\n\nfunction isFixtureState(state: string | undefined, pattern: RegExp) {\n  return Boolean(state && pattern.test(state));\n}\n\nfunction Stat({ label, value, tone = \"neutral\" }: { label: string; value: number; tone?: \"neutral\" | \"ok\" | \"warn\" | \"bad\" }) {\n  return <div className=\"grid gap-1 rounded-md border bg-muted/30 px-3 py-2\"><span className=\"text-xs text-muted-foreground\">{label}</span><span className=\"sr-only\">{label} {number(value)}</span><strong className={`font-mono text-lg tabular-nums ${tone === \"ok\" ? \"text-success\" : tone === \"warn\" ? \"text-warning\" : tone === \"bad\" ? \"text-destructive\" : \"\"}`}>{number(value)}</strong></div>;\n}\n\nfunction ImportRowCard({ row }: { row: ImportRow }) {\n  const tone = row.rowStatus === \"added\" || row.rowStatus === \"ready\" ? \"ok\" : row.rowStatus === \"duplicate\" || row.rowStatus === \"capacity_blocked\" || row.rowStatus === \"failed\" ? \"bad\" : row.rowStatus === \"already_present\" ? \"neutral\" : \"warn\";\n  return <article className=\"grid gap-3 border-b p-4 last:border-b-0 hover:bg-muted/20 lg:grid-cols-12 lg:items-center\">\n    <div className=\"flex justify-between gap-3 lg:col-span-2 lg:block\"><span className=\"text-xs text-muted-foreground lg:hidden\">Source</span><span className=\"font-mono text-sm\">{row.source}</span></div>\n    <div className=\"flex justify-between gap-3 lg:col-span-1 lg:block\"><span className=\"text-xs text-muted-foreground lg:hidden\">Record</span><span className=\"font-mono text-sm font-medium\">{row.sourceIdentifier}</span></div>\n    <div className=\"lg:col-span-2\"><div className=\"font-medium\">{row.vendor}</div><div className=\"text-xs text-muted-foreground\">{row.sourceType === \"purchase_order\" ? \"Purchase order\" : \"Receiving\"}</div></div>\n    <div className=\"flex justify-between gap-3 lg:col-span-1 lg:block lg:text-right\"><span className=\"text-xs text-muted-foreground lg:hidden\">Head</span><span className=\"font-mono font-semibold\"><span>{number(row.headCount)}</span> head</span></div>\n    <div className=\"flex justify-between gap-3 lg:col-span-2 lg:block lg:text-right\"><span className=\"text-xs text-muted-foreground lg:hidden\">Cost</span><div><div className=\"font-mono\">{money(row.cost / Math.max(1, row.headCount))} / head</div><div className=\"font-mono text-xs text-muted-foreground\">{money(row.cost)} total</div></div></div>\n    <div className=\"lg:col-span-2\"><div><span className=\"font-mono\"><span>{number(row.weightLb)}</span> lb</span>, <span>{row.breed}</span></div><div className=\"text-xs text-muted-foreground\"><span>{number(row.ageDays)}</span> days</div></div>\n    <div className=\"grid gap-1.5 lg:col-span-2\">\n      {row.proposedLots.length > 0 ? row.proposedLots.map((lot) => <div key={lot.lotId} className=\"text-sm\"><span className=\"font-mono font-medium\">{lot.headCount} head → {lot.lotName}</span> <span className=\"text-muted-foreground\">({lot.penName})</span></div>) : <span className=\"text-sm text-muted-foreground\">{row.rowStatus === \"duplicate\" || row.rowStatus === \"already_present\" ? \"No new lot\" : row.rowStatus === \"capacity_blocked\" ? \"P-04 requested\" : \"Unassigned lot\"}</span>}\n      <div><StatusBadge tone={tone}>{statusLabel(row.rowStatus)}</StatusBadge></div>\n      {row.problemDetail && <p className=\"text-xs leading-relaxed text-text-secondary\">{row.problemDetail}</p>}\n    </div>\n  </article>;\n}\n\nexport function ImportRecordsContainer({ fixture }: { fixture?: string }) {\n  const fixtureMode = Boolean(fixture);\n  const fixtureValidation = isFixtureState(fixture, /validation|error.*preview|cannot.*preview/i);\n  const fixtureSync = isFixtureState(fixture, /sync.*result|synchron/i);\n  const fixturePreview = fixtureMode && !fixtureValidation && !fixtureSync;\n  const [batches, setBatches] = useState<ImportBatch[]>(fixtureMode ? SAMPLE_BATCHES : []);\n  const [batchId, setBatchId] = useState(fixtureMode ? SAMPLE_BATCHES[0].batchId : \"\");\n  const [preview, setPreview] = useState<ImportPreviewResponse | null>(fixturePreview ? { batchId: SAMPLE_BATCHES[0].batchId, rows: SAMPLE_ROWS, readyCount: 2, duplicateCount: 1, pendingMappingCount: 1, failedCount: 0 } : null);\n  const [syncResult, setSyncResult] = useState<ImportSyncResponse | null>(fixtureSync ? { batchId: SAMPLE_BATCHES[0].batchId, addedCount: 1, alreadyPresentCount: 1, duplicateCount: 1, pendingMappingCount: 1, capacityBlockedCount: 1, failedCount: 1, partial: true, rows: SAMPLE_SYNC_ROWS } : null);\n  const [loading, setLoading] = useState(!fixtureMode);\n  const [previewing, setPreviewing] = useState(false);\n  const [syncing, setSyncing] = useState(false);\n  const [batchError, setBatchError] = useState(\"\");\n  const [previewError, setPreviewError] = useState(fixtureValidation ? \"The selected source file could not be previewed. Check the file format and required purchase-order or receiving fields, then try again.\" : \"\");\n  const [syncError, setSyncError] = useState(\"\");\n\n  const loadBatches = useCallback(async () => {\n    setLoading(true);\n    setBatchError(\"\");\n    try {\n      const response = await getImportBatches();\n      if (response.status !== 200) throw new Error(\"Import batches could not be loaded.\");\n      setBatches(response.data.batches);\n      setBatchId((current) => current || response.data.batches[0]?.batchId || \"\");\n    } catch {\n      setBatchError(\"Import batches could not be loaded. Try again in a moment.\");\n    } finally {\n      setLoading(false);\n    }\n  }, []);\n\n  useEffect(() => {\n    if (fixtureMode) {\n      setBatches(SAMPLE_BATCHES);\n      setBatchId(SAMPLE_BATCHES[0].batchId);\n      setLoading(false);\n      return;\n    }\n    void loadBatches();\n  }, [fixtureMode, loadBatches]);\n\n  const selectedBatch = useMemo(() => batches.find((batch) => batch.batchId === batchId), [batches, batchId]);\n\n  const handlePreview = async () => {\n    if (fixtureMode) {\n      if (fixtureValidation) {\n        setPreview(null);\n        setPreviewError(\"The selected source file could not be previewed. Check the file format and required purchase-order or receiving fields, then try again.\");\n        return;\n      }\n      setPreview({ batchId, rows: SAMPLE_ROWS, readyCount: 2, duplicateCount: 1, pendingMappingCount: 1, failedCount: 0 });\n      setSyncResult(null);\n      setPreviewError(\"\");\n      return;\n    }\n    setPreviewing(true);\n    setPreviewError(\"\");\n    setSyncError(\"\");\n    setSyncResult(null);\n    try {\n      let requestBatchId = batchId;\n      if (!requestBatchId) {\n        const batchResponse = await getImportBatches();\n        if (batchResponse.status !== 200 || !batchResponse.data.batches[0]) throw new Error(\"No supplied import batches are available.\");\n        requestBatchId = batchResponse.data.batches[0].batchId;\n        setBatches(batchResponse.data.batches);\n        setBatchId(requestBatchId);\n      }\n      const response = await previewImport({ batchId: requestBatchId });\n      if (response.status !== 200) {\n        setPreviewError(response.data.message || \"The selected source file could not be previewed.\");\n        setPreview(null);\n        return;\n      }\n      setPreview(response.data);\n    } catch {\n      setPreviewError(\"The selected source file could not be previewed. Check the file format and try again.\");\n      setPreview(null);\n    } finally {\n      setPreviewing(false);\n    }\n  };\n\n  const handleSync = async () => {\n    if (!preview) return;\n    if (fixtureMode) {\n      setSyncResult({ batchId: preview.batchId, addedCount: 1, alreadyPresentCount: 1, duplicateCount: 1, pendingMappingCount: 1, capacityBlockedCount: 1, failedCount: 1, partial: true, rows: SAMPLE_SYNC_ROWS });\n      return;\n    }\n    setSyncing(true);\n    setSyncError(\"\");\n    try {\n      const response = await synchronizeImports({ batchId: preview.batchId });\n      if (response.status !== 200) {\n        setSyncError(response.data.message || \"Records could not be synchronized.\");\n        return;\n      }\n      setSyncResult(response.data);\n    } catch {\n      setSyncError(\"Records could not be synchronized. Try again in a moment.\");\n    } finally {\n      setSyncing(false);\n    }\n  };\n\n  const resultRows = syncResult?.rows ?? preview?.rows ?? [];\n  const totalHead = resultRows.reduce((sum, row) => sum + row.headCount, 0);\n  const totalCost = resultRows.reduce((sum, row) => sum + row.cost, 0);\n  const validatableHead = resultRows.filter((row) => row.rowStatus === \"ready\" || row.rowStatus === \"added\").reduce((sum, row) => {\n    if (row.proposedLots.length === 0) return sum + row.headCount;\n    return sum + row.proposedLots.filter((lot) => lot.penId > 0).reduce((lotTotal, lot) => lotTotal + lot.headCount, 0);\n  }, 0);\n  const statusSummary = syncResult ? [\n    [\"Added\", syncResult.addedCount, \"ok\" as const],\n    [\"Already present\", syncResult.alreadyPresentCount, \"neutral\" as const],\n    [\"Duplicate\", syncResult.duplicateCount, \"bad\" as const],\n    [\"Pending mapping\", syncResult.pendingMappingCount, \"warn\" as const],\n    [\"Capacity blocked\", syncResult.capacityBlockedCount, \"bad\" as const],\n    [\"Failed\", syncResult.failedCount, \"bad\" as const],\n  ] : null;\n\n  return <main data-screen=\"S-2\" data-state={fixture ?? (syncResult ? \"sync-result\" : preview ? \"preview-loaded\" : \"default\")} className=\"mx-auto grid w-full max-w-6xl flex-1 content-start gap-5 p-4 md:p-6\">\n    <header className=\"grid gap-1\"><h1 className=\"font-heading text-2xl font-semibold tracking-tight md:text-3xl\">Import records</h1></header>\n\n    <Card>\n      <CardContent className=\"grid gap-4 pt-4\">\n        <div className=\"grid gap-4 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-end\">\n          <div className=\"grid gap-3 sm:grid-cols-[minmax(0,1fr)_auto] sm:items-end\">\n            <div className=\"grid max-w-xl gap-1.5\"><label htmlFor=\"import-batch\" className=\"text-sm font-semibold\">Source file selection / batch selector</label>\n              <Select value={batchId} onValueChange={(value) => { setBatchId(value); setPreview(null); setSyncResult(null); setPreviewError(\"\"); }}>\n                <SelectTrigger id=\"import-batch\" aria-label=\"Source file selection / batch selector\" className=\"h-11 font-mono\"><SelectValue placeholder={loading ? \"Loading source batches…\" : \"Select a source batch\"} /></SelectTrigger>\n                <SelectContent>{batches.map((batch) => <SelectItem key={batch.batchId} value={batch.batchId}>{batch.sourceName} · {batch.recordCount} records</SelectItem>)}</SelectContent>\n              </Select>\n            </div>\n            <Button type=\"button\" variant=\"outline\" className=\"h-11\" onClick={() => void handlePreview()} disabled={(!batchId && !loading) || previewing || syncing}><Table2 />{previewing ? \"Previewing…\" : \"Preview records\"}</Button>\n          </div>\n          <Button type=\"button\" aria-label={preview ? `Synchronize ready records (${preview.readyCount} lines ready)` : \"Synchronize ready records\"} className=\"h-11 w-full sm:w-auto\" onClick={() => void handleSync()} disabled={!preview || preview.rows.length === 0 || syncing || previewing}><RefreshCw />{syncing ? \"Syncing…\" : `Sync ready records${preview ? ` (${preview.readyCount} lines ready)` : \"\"}`}</Button>\n        </div>\n\n        {loading && <div className=\"grid gap-2 sm:grid-cols-2\" aria-busy=\"true\"><Skeleton className=\"h-10\" /><Skeleton className=\"h-10\" /></div>}\n        {batchError && <Notice tone=\"bad\"><AlertCircle /><NoticeTitle>Source batches unavailable</NoticeTitle><NoticeDescription className=\"flex flex-wrap items-center justify-between gap-2\"><span>{batchError}</span><Button variant=\"outline\" size=\"sm\" onClick={() => void loadBatches()}><RotateCw />Retry</Button></NoticeDescription></Notice>}\n        {previewError && <Notice tone=\"bad\"><AlertCircle /><NoticeTitle>Preview could not be created</NoticeTitle><NoticeDescription>{previewError}</NoticeDescription></Notice>}\n        {syncError && <Notice tone=\"bad\"><AlertCircle /><NoticeTitle>Synchronization failed</NoticeTitle><NoticeDescription>{syncError}</NoticeDescription></Notice>}\n\n        {preview && !syncResult && <div className=\"grid gap-3 border-t pt-4\">\n          <div className=\"flex flex-wrap items-center justify-between gap-2 text-sm\"><p className=\"flex items-center gap-2 text-muted-foreground\"><span className=\"size-2 rounded-full bg-success\" />Preview evaluated timestamp: <span className=\"font-mono text-foreground\">{fixtureMode ? \"23 Apr 2025, 09:14 America/Denver\" : new Intl.DateTimeFormat(\"en-GB\", { dateStyle: \"medium\", timeStyle: \"short\", timeZone: \"America/Denver\" }).format(new Date()) + \" America/Denver\"}</span></p><p className=\"text-muted-foreground\">Total <strong className=\"font-mono text-foreground\">{preview.rows.length}</strong> records evaluated (<strong className=\"font-mono text-foreground\">{number(totalHead)}</strong> head)</p></div>\n          <div className=\"grid grid-cols-2 gap-2 text-sm md:grid-cols-5\">\n            <Stat label=\"Ready to sync\" value={preview.readyCount} tone=\"ok\" />\n            <Stat label=\"Partial mapped\" value={preview.rows.filter((row) => row.proposedLots.length > 1).length} tone=\"warn\" />\n            <Stat label=\"Duplicate entry\" value={preview.duplicateCount} tone=\"bad\" />\n            <Stat label=\"Pending mapping\" value={preview.pendingMappingCount} tone=\"warn\" />\n            <Stat label=\"Capacity blocked\" value={preview.rows.filter((row) => row.rowStatus === \"capacity_blocked\").length} tone=\"bad\" />\n          </div>\n          {preview.rows.some((row) => row.rowStatus === \"capacity_blocked\") && <div className=\"flex gap-2 rounded-md border bg-muted/30 p-3 text-sm\"><Info className=\"mt-0.5 size-4 shrink-0 text-warning\" /><p><strong>Capacity enforcement:</strong> Unresolved or capacity-blocked animals cannot be used in pen operations. {preview.rows.find((row) => row.rowStatus === \"capacity_blocked\")?.problemDetail}</p></div>}\n        </div>}\n\n        {syncResult && <section className=\"grid gap-3 border-t pt-4\" aria-label=\"Synchronization results\">\n          <div className=\"flex flex-wrap items-center justify-between gap-2\"><h2 className=\"font-heading text-lg font-semibold\">Synchronization results</h2><StatusBadge tone={syncResult.partial ? \"warn\" : \"ok\"}>{syncResult.partial ? \"Partial results\" : \"Results returned\"}</StatusBadge></div>\n          {syncResult.partial && <Notice tone=\"warn\"><Info /><NoticeTitle>Some records need attention</NoticeTitle><NoticeDescription>Review pending, blocked, duplicate, and failed row outcomes before retrying the remaining records.</NoticeDescription></Notice>}\n          <div className=\"grid grid-cols-2 gap-2 sm:grid-cols-3 lg:grid-cols-6\">{statusSummary?.map(([label, value, tone]) => <Stat key={label} label={label as string} value={value as number} tone={tone as \"neutral\" | \"ok\" | \"warn\" | \"bad\"} />)}</div>\n        </section>}\n      </CardContent>\n    </Card>\n\n    {(preview || syncResult) && <Card className=\"overflow-hidden\">\n      <div className=\"divide-y\">{resultRows.map((row) => <ImportRowCard key={`${row.id}-${row.sourceIdentifier}`} row={row} />)}</div>\n      <footer className=\"flex flex-wrap items-center justify-between gap-3 border-t bg-muted/30 px-4 py-3 text-sm\">\n        <span className=\"text-muted-foreground\">Showing {resultRows.length} records across {selectedBatch?.sourceName.includes(\",\") ? 2 : 1} evaluated import files</span>\n        <div className=\"flex flex-wrap items-center gap-x-4 gap-y-1\"><span className=\"text-muted-foreground\">Combined extended cost: <strong className=\"font-mono text-foreground\">{money(totalCost)}</strong></span><span className=\"text-muted-foreground\">Validatable head: <strong className=\"font-mono text-foreground\">{number(validatableHead)} / {number(totalHead)} head</strong></span></div>\n      </footer>\n    </Card>}\n  </main>;\n}\n","chars":19568,"exitCode":0}
