OrderLine: \"PO-5831 line 1\", status: \"waiting\", targetWeightLb: 1350, defaultGainRateLbPerDay: 3, measuredAdgLbPerDay: null },","  ],","  pens: [","    { id: 4, name: \"P-04\", capacity: 150, currentAnimalCount: 116, activeLotCount: 2, status: \"good\" },","    { id: 2, name: \"P-02\", capacity: 120, currentAnimalCount: 72, activeLotCount: 1, status: \"good\" },","  ],","};","","const SAMPLE_MAPPINGS: LotMappingOkResponse[] = [","  { sourcePurchaseOrderLine: \"PO-5831 line 1\", assignments: [","    { lotId: 241, lotName: \"L-241\", penId: 4, penName: \"P-04\", requestedHeadCount: 60, capacity: 150, currentAnimalCount: 116, status: \"good\", problemDetail: null },","    { lotId: 243, lotName: \"L-243\", penId: 0, penName: \"No pen\", requestedHeadCount: 24, capacity: 0, currentAnimalCount: 0, status: \"waiting\", problemDetail: \"24 head are awaiting pen assignment.\" },","  ] },","  { sourcePurchaseOrderLine: \"PO-5840 line 1\", assignments: [","    { lotId: 242, lotName: \"L-242\", penId: 4, penName: \"P-04\", requestedHeadCount: 56, capacity: 150, currentAnimalCount: 116, status: \"good\", problemDetail: null },","  ] },","  { sourcePurchaseOrderLine: \"PO-5790 line 1\", assignments: [","    { lotId: 239, lotName: \"L-239\", penId: 2, penName: \"P-02\", requestedHeadCount: 72, capacity: 120, currentAnimalCount: 72, status: \"good\", problemDetail: null },","  ] },","];","","const SAMPLE_FORECAST: ForecastOkResponse = {","  lotId: 241,","  targetWeightLb: 1350,","  gainRateLbPerDay: 2.35,","  gainRateBasis: \"measured\",","  projectedMarketDate: \"2025-11-22\",","  recommendations: [{ kind: \"sale_timing\", message: \"Current gain rate projects market readiness on 22 Nov 2025.\", adgLbPerDay: 2.35, projectedMarketDate: \"2025-11-22\", planVariance: null }],","};","","const number = (value: number) => new Intl.NumberFormat(\"en-US\", { maximumFractionDigits: 2 }).format(value);","const statusText = (value: string) => value.replaceAll(\"_\", \" \");","const displayDate = (value: string | null) => {","  if (!value) return \"Not available\";","  const date = new Date(`${value.slice(0, 10)}T12:00:00`);","  return Number.isNaN(date.valueOf()) ? value : new Intl.DateTimeFormat(\"en-GB\", { day: \"2-digit\", month: \"short\", year: \"numeric\", timeZone: \"UTC\" }).format(date);","};","","function isFixtureState(state: string | undefined, pattern: RegExp) {","  return Boolean(state && pattern.test(state));","}","","function Stat({ label, children, detail }: { label: string; children: React.ReactNode; detail?: string }) {","  return <div className=\"grid min-w-0 gap-1 rounded-md border bg-muted/30 px-3 py-2\"><span className=\"text-xs font-semibold uppercase tracking-wide text-muted-foreground\">{label}</span><strong className=\"font-heading text-lg font-semibold leading-tight\">{children}</strong>{detail && <span className=\"text-xs text-muted-foreground\">{detail}</span>}</div>;","}","","function MappingOutcome({ result }: { result: LotMappingOkResponse }) {","  return <div className=\"grid gap-2 border-t p-3 first:border-t-0 sm:grid-cols-2 sm:items-start\">","    <div><span className=\"block text-xs text-muted-foreground\">PO Line Trace</span><strong className=\"font-mono text-sm\">{result.sourcePurchaseOrderLine}</strong></div>","    <div className=\"grid gap-2\">","      {result.assignments.map((assignment, index) => {","        const refused = /capacity|refus|block/i.test(assignment.status) || Boolean(assignment.problemDetail && /capacity|exceed/i.test(assignment.problemDetail));","        return <div key={`${assignment.lotId}-${assignment.penId}-${index}`} className=\"flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 rounded-md bg-muted/30 px-3 py-2 text-sm\">","          <span><strong className=\"font-mono\">{assignment.lotName}</strong> <span className=\"text-muted-foreground\">→ {assignment.penName}</span></span>","          <span className=\"flex flex-wrap gap-1 text-xs text-muted-foreground\"><span className=\"font-mono\">{number(assignment.currentAnimalCount)}</span><span>current /</span><span className=\"font-mono\">{number(assignment.capacity)}</span><span>capacity ·</span><span className=\"font-mono\">{number(assignment.requestedHeadCount)}</span><span>requested</span></span>","          <span className=\"basis-full flex flex-wrap items-center gap-2\">","            <StatusBadge tone={refused ? \"bad\" : toneOf(assignment.status)}>{statusText(assignment.status)}</StatusBadge>","            {refused && <span className=\"text-xs font-medium text-destructive\">Capacity refusal · limit {number(assignment.capacity)} head</span>}","            {assignment.problemDetail && <span className=\"text-xs text-text-secondary\">{assignment.problemDetail}</span>}","          </span>","        </div>;","      })}","    </div>","  </div>;","}","","  const fixtureMode = fixture !== undefined;","  const fixtureValidation = isFixtureState(fixture, /validation|invalid/i);","  const fixtureSaved = isFixtureState(fixture, /saved|recalculat/i);","  const fixtureUnresolved = isFixtureState(fixture, /unresolved|unavailable|pending/i);","  const [data, setData] = useState<LotsOkResponse | null>(SAMPLE_LOTS);","  const [mappings, setMappings] = useState<LotMappingOkResponse[]>(fixtureMode ? SAMPLE_MAPPINGS : []);","  const [forecast, setForecast] = useState<ForecastOkResponse | null>(fixtureMode ? SAMPLE_FORECAST : null);","  const [selectedLotId, setSelectedLotId] = useState<number | null>(SAMPLE_FORECAST.lotId);","  const [targetWeight, setTargetWeight] = useState(fixtureValidation ? \"0\" : fixtureSaved ? \"1350\" : \"1350\");","  const [defaultGainRate, setDefaultGainRate] = useState(fixtureValidation ? \"-1\" : fixtureSaved ? \"3.1\" : \"3\");","  const [search, setSearch] = useState(\"\");","  const [selectedPenId, setSelectedPenId] = useState(\"\");","  const [assignmentHeadCount, setAssignmentHeadCount] = useState(\"\");","  const [loading, setLoading] = useState(!fixtureMode);","  const [saving, setSaving] = useState(false);","  const [mappingBusy, setMappingBusy] = useState(false);","  const [saved, setSaved] = useState(fixtureSaved);","  const [validation, setValidation] = useState<string[]>(fixtureValidation ? [\"Target weight must be greater than zero.\", \"Default gain rate must be greater than zero.\"] : []);","  const [error, setError] = useState(\"\");","  const [mappingError, setMappingError] = useState(\"\");","  const assumptionsEdited = useRef(false);","","  useEffect(() => {","    if (fixtureMode) {","      setData(SAMPLE_LOTS);","      setMappings(fixtureUnresolved ? [...SAMPLE_MAPPINGS, { sourcePurchaseOrderLine: \"RCV-9940\", assignments: [{ lotId: 243, lotName: \"Pending receipt RCV-9940\", penId: 0, penName: \"Unavailable\", requestedHeadCount: 18, capacity: 60, currentAnimalCount: 52, status: \"Capacity blocked\", problemDetail: \"Assignment exceeds the 60 head pen capacity.\" }] }] : SAMPLE_MAPPINGS);","      setForecast(SAMPLE_FORECAST);","      setLoading(false);","      return;","    }","","    let active = true;","    const load = async () => {","      setLoading(true);","      setError(\"\");","      try {","        const response = await getLots();","        if (response.status !== 200) throw new Error(\"Lot and pen records could not be loaded.\");","        const lots = response.data;","        if (!active) return;","        setData(lots);","        const firstLot = lots.lots[0];","        if (firstLot) {","          setSelectedLotId(firstLot.id);","          if (!assumptionsEdited.current) {","            setTargetWeight(String(firstLot.targetWeightLb));","            setDefaultGainRate(String(firstLot.defaultGainRateLbPerDay));","          }","          setSelectedPenId(firstLot.penId === null ? \"\" : String(firstLot.penId));","          setAssignmentHeadCount(String(firstLot.headCount));","        }","","        const groups = new Map<string, Lot[]>();","        for (const lot of lots.lots) {","          if (lot.penId === null || /pending|unavailable/i.test(lot.status)) continue;","          const group = groups.get(lot.sourcePurchaseOrderLine) ?? [];","          group.push(lot);","          groups.set(lot.sourcePurchaseOrderLine, group);","        }","        const results = await Promise.all([...groups.entries()].map(async ([sourcePurchaseOrderLine, assignments]) => {","          const mapped = await mapPurchaseOrderLine({","            sourcePurchaseOrderLine,","            assignments: assignments.map((lot) => ({ lotId: lot.id, penId: lot.penId as number, headCount: lot.headCount })),","          });","          return mapped.status === 200 ? mapped.data : null;","        }));","        if (active) setMappings(results.filter((result): result is LotMappingOkResponse => result !== null));","        if (firstLot) {","          const forecastResponse = await getLotForecast(firstLot.id);","          if (active && forecastResponse.status === 200) setForecast(forecastResponse.data);","        }","      } catch {","        if (active) setError(\"Lot and pen records could not be loaded. Try again in a moment.\");","      } finally {","        if (active) setLoading(false);","      }","    };","    void load();","    return () => { active = false; };","  }, [fixture, fixtureMode, fixtureUnresolved]);","","  const selectedLot = data?.lots.find((lot) => lot.id === selectedLotId) ?? null;","  const availableLots = data?.lots.filter((lot) => lot.penId !== null && !/pending|unavailable/i.test(lot.status)) ?? [];","  const visibleLots = useMemo(() => (data?.lots ?? []).filter((lot) => `${lot.name} ${lot.penName} ${lot.breed} ${lot.sex} ${lot.sourcePurchaseOrderLine}`.toLowerCase().includes(search.toLowerCase())), [data, search]);","  const acceptedHead = data?.lots.reduce((sum, lot) => sum + lot.headCount, 0) ?? 0;","  const pendingLots = data?.lots.filter((lot) => lot.penId === null || /pending|waiting/i.test(lot.status)) ?? [];","  const pennedHead = data?.lots.filter((lot) => lot.penId !== null).reduce((sum, lot) => sum + lot.headCount, 0) ?? 0;","  const capacity = data?.pens.reduce((sum, pen) => sum + pen.capacity, 0) ?? 0;","  const currentAnimals = data?.pens.reduce((sum, pen) => sum + pen.currentAnimalCount, 0) ?? 0;","  const activePens = data?.pens.length ?? 0;","","  const handleSaveAssumptions = async (event: FormEvent<HTMLFormElement>) => {","    event.preventDefault();","    const nextValidation: string[] = [];","    const target = Number(targetWeight);","    const gainRate = Number(defaultGainRate);","    if (!Number.isFinite(target) || target <= 0) nextValidation.push(\"Target weight must be greater than zero.\");","    if (!Number.isFinite(gainRate) || gainRate <= 0) nextValidation.push(\"Default gain rate must be greater than zero.\");","    setValidation(nextValidation);","    setSaved(false);","    if (nextValidation.length || !selectedLot) return;","    if (fixtureMode) {","      setForecast({ ...SAMPLE_FORECAST, targetWeightLb: target, gainRateLbPerDay: selectedLot.measuredAdgLbPerDay ?? gainRate, gainRateBasis: selectedLot.measuredAdgLbPerDay === null ? \"configured_default\" : \"measured\", projectedMarketDate: \"2025-11-22\" });","      setSaved(true);","      return;","    }","    setSaving(true);","    setError(\"\");","    try {","      const response = await updateLotAssumptions(selectedLot.id, { targetWeightLb: target, defaultGainRateLbPerDay: gainRate });","      if (response.status !== 200) {","        const message = \"message\" in response.data ? response.data.message : \"Lot assumptions could not be saved.\";","        setError(message);","        return;","      }","      setForecast(response.data);","      setData((current) => current ? { ...current, lots: current.lots.map((lot) => lot.id === selectedLot.id ? { ...lot, targetWeightLb: target, defaultGainRateLbPerDay: gainRate } : lot) } : current);","      setSaved(true);","    } catch {","      setError(\"Lot assumptions could not be saved. Try again in a moment.\");","    } finally {","      setSaving(false);","    }","  };","","  const handleMapAssignment = async (event: FormEvent<HTMLFormElement>) => {","    event.preventDefault();","    if (!selectedLot || !selectedPenId || !assignmentHeadCount) return;","    if (fixtureMode) {","      setMappingError(\"Fixture records are read-only.\");","      return;","    }","    setMappingBusy(true);","    setMappingError(\"\");","    try {","      const response = await mapPurchaseOrderLine({","        sourcePurchaseOrderLine: selectedLot.sourcePurchaseOrderLine,","        assignments: [{ lotId: selectedLot.id, penId: Number(selectedPenId), headCount: Number(assignmentHeadCount) }],","      });","      if (response.status !== 200) {","        setMappingError(\"The pen assignment could not be saved. Review the lot, pen capacity, and head count.\");","        return;","      }","      setMappings((current) => [...current.filter((item) => item.sourcePurchaseOrderLine !== response.data.sourcePurchaseOrderLine), response.data]);","      const assignment = response.data.assignments[0];","      if (assignment && !(/capacity|refus|block/i.test(assignment.status) || assignment.problemDetail)) {","        setData((current) => current ? { ...current, lots: current.lots.map((lot) => lot.id === assignment.lotId ? { ...lot, penId: assignment.penId, penName: assignment.penName } : lot) } : current);","      }","    } catch {","      setMappingError(\"The pen assignment could not be saved. Try again in a moment.\");","    } finally {","      setMappingBusy(false);","    }","  };","","  const onSelectLot = (value: string) => {","    const id = Number(value);","    const lot = data?.lots.find((item) => item.id === id);","    if (!lot) return;","    assumptionsEdited.current = false;","    setSelectedLotId(id);","    setAssignmentHeadCount(String(lot.headCount));","    setSelectedPenId(lot.penId === null ? \"\" : String(lot.penId));","    setSaved(false);","    setValidation([]);","    if (!fixtureMode) {","      setForecast(null);","      void getLotForecast(lot.id).then((response) => {","        if (response.status === 200) setForecast(response.data);","      }).catch(() => setForecast(null));","    } else {","      setForecast(lot.id === SAMPLE_FORECAST.lotId ? SAMPLE_FORECAST : null);","    }","  };","","  const dateText = fixture ? \"23 Apr 2025\" : new Intl.DateTimeFormat(\"en-GB\", { day: \"2-digit\", month: \"short\", year: \"numeric\", timeZone: \"America/Denver\" }).format(new Date());","  const measuredBasis = forecast?.gainRateBasis === \"measured\";","  const sourceFixtureMetrics = fixtureMode && selectedLot?.id === 241;","","    <main data-screen=\"S-3\" data-state={fixture ?? \"default\"} className=\"mx-auto grid w-full max-w-7xl gap-5 p-4 md:p-6\">","      <div className=\"flex flex-col justify-between gap-2 border-b pb-3 md:flex-row md:items-baseline\">","        <h1 className=\"font-heading text-2xl font-semibold tracking-tight md:text-3xl\">Lots &amp; pens</h1>","        <div className=\"flex flex-wrap items-center gap-2 text-sm text-muted-foreground\"><span className=\"size-2 rounded-full bg-success\" /><span>Sample date: <strong className=\"font-mono font-medium text-foreground\">{dateText}</strong></span><span className=\"text-border-strong\">|</span><span>Facility time: <strong className=\"font-mono font-medium text-foreground\">America/Denver</strong></span></div>","      </div>","","      {error && <Notice tone=\"bad\"><AlertCircle /><NoticeTitle>Lot and pen update needs attention</NoticeTitle><NoticeDescription>{error}</NoticeDescription></Notice>}","      {loading && !data && <div className=\"grid gap-4 lg:grid-cols-2\" aria-busy=\"true\"><Skeleton className=\"h-40\" /><Skeleton className=\"h-96\" /></div>}","","      {data && <>","        <section aria-label=\"Operational metrics\" className=\"grid gap-4 rounded-lg border bg-card p-4 md:grid-cols-2 xl:grid-cols-5 xl:items-center\">","          <Stat label=\"Total Occupied Capacit