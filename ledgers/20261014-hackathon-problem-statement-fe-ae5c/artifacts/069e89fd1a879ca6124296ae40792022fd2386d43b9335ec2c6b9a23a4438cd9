"@/lib/api/client\";\nimport type { OverviewOkResponse } from \"@/lib/api/client.schemas\";\n\nconst SAMPLE_OVERVIEW: OverviewOkResponse = {\n  activeLotCount: 3,\n  activePenCount: 2,\n  totalAnimals: 188,\n  pens: [\n    { id: 4, name: \"P-04\", capacity: 150, currentAnimalCount: 116, activeLotCount: 2, status: \"good\" },\n    { id: 2, name: \"P-02\", capacity: 120, currentAnimalCount: 72, activeLotCount: 1, status: \"good\" },\n  ],\n  lotPerformance: [\n    { lotId: 239, lotName: \"L-239\", penName: \"P-02\", headCount: 72, breed: \"Angus steers\", measuredAdgLbPerDay: 2.95, fcrAsFed: 6.4, feedCostPerLbGain: 0.82 },\n    { lotId: 241, lotName: \"L-241\", penName: \"P-04\", headCount: 60, breed: \"Angus–Hereford steers\", measuredAdgLbPerDay: 2.35, fcrAsFed: 6.4, feedCostPerLbGain: 0.82 },\n    { lotId: 242, lotName: \"L-242\", penName: \"P-04\", headCount: 56, breed: \"Charolais-cross heifers\", measuredAdgLbPerDay: 2.05, fcrAsFed: 6.4, feedCostPerLbGain: 0.82 },\n  ],\n  inventoryStatus: \"In stock\",\n  rationUsage: [{ rationName: \"Grower 1\", penCount: 2, feedLb: 2450 }],\n  dailyBunkRateByPen: [\n    { penId: 4, penName: \"P-04\", lbPerHeadPerDay: 23.5 },\n    { penId: 2, penName: \"P-02\", lbPerHeadPerDay: 23.5 },\n  ],\n  plannedFeedLb: 4420,\n  actualFeedLb: 4365,\n  totalFeedConsumedLb: 4365,\n  totalFeedCost: 1842.6,\n  startingWeightLb: 650,\n  currentWeightLb: 785,\n  totalGainLb: 25320,\n  adgLbPerDay: 3.1,\n  fcrAsFed: 6.4,\n  feedCostPerLbGain: 0.82,\n  energyConsumedMcal: 15240,\n  bestPerformingLot: \"L-239\",\n  worstPerformingLot: \"L-242\",\n};\n\nconst number = (value: number) => new Intl.NumberFormat(\"en-US\", { maximumFractionDigits: 2 }).format(value);\nconst weight = (value: number) => `${number(value)} lb`;\nconst money = (value: number) => `$${new Intl.NumberFormat(\"en-US\", { minimumFractionDigits: 2, maximumFractionDigits: 2 }).format(value)}`;\n\nfunction Metric({ label, value, detail }: { label: string; value: string; detail?: string }) {\n  return (\n    <div className=\"grid gap-1 rounded-md bg-muted/40 p-3\">\n      <dt className=\"text-xs text-muted-foreground\">{label}</dt>\n      <dd className=\"font-heading text-lg font-semibold leading-tight\">{value}</dd>\n      {detail && <span className=\"text-xs text-muted-foreground\">{detail}</span>}\n    </div>\n  );\n}\n\nfunction LotRow({ lot, best, worst, fixture }: { lot: OverviewOkResponse[\"lotPerformance\"][number]; best: string; worst: string; fixture: boolean }) {\n  const rank = lot.lotName === best ? \"best\" : lot.lotName === worst ? \"worst\" : fixture && lot.lotName === \"L-241\" ? \"waiting\" : \"active\";\n  return (\n    <article role=\"row\" aria-label={lot.lotName} className=\"grid gap-2 rounded-lg border p-3 sm:grid-cols-3 sm:items-center\">\n      <div role=\"cell\" className=\"flex flex-wrap items-center gap-2\">\n        <span className=\"font-medium\">{lot.lotName}</span>\n        <StatusBadge tone={rank === \"best\" ? \"ok\" : rank === \"worst\" ? \"bad\" : rank === \"waiting\" ? \"warn\" : \"neutral\"}>{rank}</StatusBadge>\n      </div>\n      <div role=\"cell\" className=\"text-sm text-muted-foreground\"><span>{lot.breed}</span> · Pen <span className=\"font-mono\">{lot.penName}</span> · <span className=\"font-mono text-foreground\">{lot.headCount}</span> head</div>\n      <div role=\"cell\" className=\"flex items-baseline justify-between gap-3 sm:justify-end\">\n        <span className=\"text-xs text-muted-foreground\">Average daily gain</span>\n        <span className=\"font-semibold tabular-nums\">{number(lot.measuredAdgLbPerDay)} lb/day</span>\n      </div>\n    </article>\n  );\n}\n\nexport function HeadOnPensContainer({ fixture }: { fixture?: string }) {\n  const [data, setData] = useState<OverviewOkResponse | null>(fixture ? SAMPLE_OVERVIEW : null);\n  const [loading, setLoading] = useState(!fixture);\n  const [error, setError] = useState(false);\n\n  const loadOverview = useCallback(async () => {\n    setLoading(true);\n    setError(false);\n    try {\n      const response = await getOverview();\n      if (response.status !== 200) throw new Error(\"Overview data could not be loaded\");\n      setData(response.data);\n    } catch {\n      setError(true);\n    } finally {\n      setLoading(false);\n    }\n  }, []);\n\n  useEffect(() => {\n    if (fixture) {\n      setData(SAMPLE_OVERVIEW);\n      setLoading(false);\n      setError(false);\n      return;\n    }\n    void loadOverview();\n  }, [fixture, loadOverview]);\n\n  const asOfDate = fixture\n    ? \"23 Apr 2025\"\n    : new Intl.DateTimeFormat(\"en-GB\", { day: \"2-digit\", month: \"short\", year: \"numeric\", timeZone: \"America/Denver\" }).format(new Date());\n\n  return (\n    <main data-screen=\"S-1\" data-state={fixture ?? \"default\"} className=\"mx-auto grid w-full max-w-6xl gap-4 p-4 md:p-6\">\n      <section className=\"rounded-lg border bg-card p-4 md:p-6\" aria-labelledby=\"overview-title\">\n        <p className=\"text-sm text-muted-foreground\">As of <span className=\"font-mono\">{asOfDate}</span> · America/Denver</p>\n        <h1 id=\"overview-title\" className=\"mt-2 font-heading text-2xl font-semibold tracking-tight md:text-3xl\">\n          {data ? `${number(data.totalAnimals)} head on pens` : \"Overview\"}\n        </h1>\n        {data && <p className=\"mt-2 text-sm text-text-secondary\">\n          {fixture\n            ? <><span className=\"font-medium text-brand-text\">2 active pens</span> · <span className=\"font-medium text-brand-text\">212 head received</span> across 3 lots · <span className=\"font-medium text-brand-text\">24 head</span> awaiting a pen</>\n            : <><span className=\"font-medium text-brand-text\">Active lots {number(data.activeLotCount)}</span> · Active pens {number(data.activePenCount)} · Total animals {number(data.totalAnimals)}</>}\n        </p>}\n      </section>\n\n      {error && <Notice tone=\"bad\"><CircleAlert /><NoticeTitle>Dashboard data could not be loaded</NoticeTitle><NoticeDescription className=\"flex flex-wrap items-center justify-between gap-2\"><span>Try again in a moment.</span><Button variant=\"outline\" size=\"sm\" onClick={() => void loadOverview()}><RotateCw />Retry</Button></NoticeDescription></Notice>}\n\n      {loading && !data && <div className=\"grid gap-4 md:grid-cols-2\" aria-busy=\"true\"><Skeleton className=\"h-72\" /><Skeleton className=\"h-72\" /></div>}\n\n      {data && <>\n        <div className=\"grid items-start gap-4 md:grid-cols-2\">\n          <Card>\n            <CardHeader className=\"flex-row flex-wrap items-center justify-between gap-2\">\n              <CardTitle>Pen occupancy</CardTitle>\n              <span className=\"font-mono text-xs text-muted-foreground\">{number(data.activePenCount)} active pens · {number(data.totalAnimals)} head</span>\n            </CardHeader>\n            <CardContent className=\"px-0 pt-4\">\n              <Table>\n                <TableHeader><TableRow><TableHead>Pen</TableHead><TableHead>Occupancy / Capacity</TableHead><TableHead>Open Head</TableHead><TableHead>Active Lots in Pen</TableHead><TableHead>Status</TableHead></TableRow></TableHeader>\n                <TableBody>\n                  {data.pens.map((pen) => {\n                    const knownLots = data.lotPerformance.filter((lot) => lot.penName === pen.name);\n                    return <TableRow key={pen.id} aria-label={pen.name}>\n                      <TableCell className=\"font-mono font-medium\">{pen.name}</TableCell>\n                      <TableCell><span className=\"font-mono\">{number(pen.currentAnimalCount)}</span> / <span className=\"font-mono\">{number(pen.capacity)}</span> head</TableCell>\n                      <TableCell><span className=\"font-mono\">{number(pen.capacity - pen.currentAnimalCount)}</span> open</TableCell>\n                      <TableCell className=\"whitespace-normal\"><span>{knownLots.map((lot, index) => <span key={lot.lotId}>{index > 0 && \" · \"}<span className=\"font-mono\">{lot.lotName}</span> ({number(lot.headCount)})</span>)}</span>{knownLots.length > 0 && \" · \"}<span className=\"font-mono\">{number(pen.activeLotCount)}</span> active lots</TableCell>\n                      <TableCell><StatusBadge tone={toneOf(pen.status)}>{pen.status}</StatusBadge></TableCell>\n                    </TableRow>;\n                  })}\n                  {data.pens.length === 0 && <TableRow><TableCell colSpan={5} className=\"text-center text-muted-foreground\">No active pens</TableCell></TableRow>}\n                </TableBody>\n              </Table>\n            </CardContent>\n          </Card>\n\n          <Card>\n            <CardHeader className=\"flex-row items-center justify-between gap-2\"><CardTitle>Lot performance</CardTitle><span className=\"text-xs text-muted-foreground\">ADG ranking</span></CardHeader>\n            <CardContent className=\"grid gap-3 pt-4\">\n              <div role=\"table\" aria-label=\"Lot performance by lot\" className=\"grid gap-2\">\n                <div role=\"rowgroup\" className=\"grid gap-2\">{data.lotPerformance.map((lot) => <LotRow key={lot.lotId} lot={lot} best={data.bestPerformingLot} worst={data.worstPerformingLot} fixture={Boolean(fixture)} />)}</div>\n                {data.lotPerformance.length === 0 && <p className=\"rounded-md border border-dashed p-4 text-sm text-muted-foreground\">No lot performance data available.</p>}\n              </div>\n              <div className=\"grid gap-2 border-t pt-3 sm:grid-cols-2\">\n                <p className=\"flex flex-wrap items-center gap-2 text-sm\"><span className=\"text-muted-foreground\">Best-performing lot</span><strong>{data.bestPerformingLot}</strong></p>\n                <p className=\"flex flex-wrap items-center gap-2 text-sm\"><span className=\"text-muted-foreground\">Worst-performing lot</span><strong>{data.worstPerformingLot}</strong></p>\n              </div>\n            </CardContent>\n          </Card>\n        </div>\n\n        <section aria-labelledby=\"operational-summary-title\" className=\"grid gap-3\">\n          <h2 id=\"operational-summary-title\" className=\"font-heading text-lg font-semibold\">Operational summary</h2>\n          <Card><CardContent className=\"grid gap-5 pt-4\">\n            <dl className=\"grid gap-3 sm:grid-cols-2 lg:grid-cols-4\">\n              <Metric label=\"Active lots\" value={number(data.activeLotCount)} />\n\"use client\";\nimport { Select as SelectPrimitive } from \"radix-ui\";\nimport { Check, ChevronDown } from \"lucide-react\";\nimport type { ComponentProps } from \"react\";\nimport { cn } from \"@/lib/utils\";\n\nexport const Select = SelectPrimitive.Root;\nexport const SelectValue = SelectPrimitive.Value;\nexport const SelectGroup = SelectPrimitive.Group;\n\nexport function SelectTrigger({ className, children, ...props }: ComponentProps<typeof SelectPrimitive.Trigger>) {\n  return (\n    <SelectPrimitive.Trigger data-slot=\"select-trigger\" className={cn(\"flex h-9 w-full items-center justify-between gap-2 rounded-md border border-input bg-card px-3 py-2 text-sm shadow-xs outline-none focus-visible:ring-2 focus-visible:ring-ring disabled:cursor-not-allowed disabled:opacity-50 data-[placeholder]:text-muted-foreground [&>span]:truncate\", className)} {...props}>\n      {children}\n      <SelectPrimitive.Icon asChild><ChevronDown className=\"size-4 opacity-50\" /></SelectPrimitive.Icon>\n    </SelectPrimitive.Trigger>\n  );\n}\n\nexport function SelectContent({ className, children, position = \"popper\", ...props }: ComponentProps<typeof SelectPrimitive.Content>) {\n  return (\n    <SelectPrimitive.Portal>\n      <SelectPrimitive.Content data-slot=\"select-content\" position={position} className={cn(\"relative z-50 max-h-72 min-w-32 overflow-hidden rounded-md border bg-popover text-popover-foreground shadow-raised\", position === \"popper\" && \"w-full min-w-[var(--radix-select-trigger-width)] translate-y-1\", className)} {...props}>\n        <SelectPrimitive.Viewport className=\"p-1\">{children}</SelectPrimitive.Viewport>\n      </SelectPrimitive.Content>\n    </SelectPrimitive.Portal>\n  );\n}\n\nexport function SelectItem({ className, children, ...props }: ComponentProps<typeof SelectPrimitive.Item>) {\n  return (\n    <SelectPrimitive.Item data-slot=\"select-item\" className={cn(\"relative flex w-full cursor-default items-center rounded-sm py-1.5 ps-2 pe-8 text-sm outline-none select-none focus:bg-muted data-[disabled]:pointer-events-none data-[disabled]:opacity-50\", className)} {...props}>\n      <span className=\"absolute end-2 flex size-3.5 items-center justify-center\"><SelectPrimitive.ItemIndicator><Check className=\"size-4\" /></SelectPrimitive.ItemIndicator></span>\n      <SelectPrimitive.ItemText>{children}</SelectPrimitive.ItemText>\n    </SelectPrimitive.Item>\n  );\n}\nimport { Slot } from \"radix-ui\";\nimport { cva, type VariantProps } from \"class-variance-authority\";\nimport type { ComponentProps } from \"react\";\nimport { cn } from \"@/lib/utils\";\n\nexport const buttonVariants = cva(\n  \"inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-md text-sm font-medium transition-colors outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 ring-offset-background disabled:pointer-events-none disabled:opacity-50 [&_svg]:size-4 [&_svg]:shrink-0\",\n  {\n    variants: {\n      variant: {\n        default: \"bg-primary text-primary-foreground shadow-sm hover:bg-primary/90\",\n        destructive: \"bg-destructive text-background shadow-sm hover:bg-destructive/90\",\n        outline: \"border border-input bg-card text-foreground shadow-sm hover:bg-muted\",\n        secondary: \"bg-secondary text-secondary-foreground hover:bg-secondary/80\",\n        ghost: \"text-foreground hover:bg-muted\",\n        link: \"text-primary underline-offset-4 hover:underline\",\n      },\n      size: { default: \"h-9 px-4 py-2\", sm: \"h-8 px-3 text-xs\", lg: \"h-10 px-6\", icon: \"size-9\" },\n    },\n    defaultVariants: { variant: \"default\", size: \"default\" },\n  },\n);\n\nexport function Button({ className, variant, size, asChild = false, ...props }: ComponentProps<\"button\"> & VariantProps<typeof buttonVariants> & { asChild?: boolean }) {\n  const Comp = asChild ? Slot.Root : \"button\";\n  return <Comp data-slot=\"button\" className={cn(buttonVariants({ variant, size }), className)} {...props} />;\n}\n","chars":17352,"exitCode":0}
