<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Feeding plans — Cedar Draw Feedlot</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@600;650;700&family=IBM+Plex+Mono:wght@400;500;600&family=Source+Sans+3:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    /* Design System Tokens */
    :root {
      --bg-page: #F6F7F5;
      --bg-surface: #FFFFFF;
      --text-main: #252A27;
      --text-quiet: #66706A;
      --border-color: #D9DEDA;
      --primary: #AD5C2A;
      --status-good: #28734F;
      --status-waiting: #94600C;
      --status-failed: #AE3D36;

      --font-heading: 'Hanken Grotesk', sans-serif;
      --font-body: 'Source Sans 3', sans-serif;
      --font-mono: 'IBM Plex Mono', monospace;

      --dur-quick: 160ms;
      --ease-standard: cubic-bezier(0.2, 0, 0, 1);
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      background-color: var(--bg-page);
      color: var(--text-main);
      font-family: var(--font-body);
      font-size: 16px;
      line-height: 24px;
      -webkit-font-smoothing: antialiased;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    /* Keyframe Animations */
    @keyframes status-breathe {
      0%, 100% { opacity: 0.96; }
      50% { opacity: 1; transform: scale(1.02); }
    }

    @keyframes row-entrance {
      from {
        opacity: 0;
        transform: translateY(8px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes page-fade-in {
      from { opacity: 0; transform: translateY(4px); }
      to { opacity: 1; transform: translateY(0); }
    }

    @media (prefers-reduced-motion: reduce) {
      *, ::before, ::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
      }
    }

    /* Header styling */
    .app-header {
      background-color: var(--bg-surface);
      border-bottom: 1px solid var(--border-color);
      height: 56px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 24px;
      position: sticky;
      top: 0;
      z-index: 50;
    }

    .header-left {
      display: flex;
      align-items: center;
      gap: 24px;
      overflow-x: auto;
      scrollbar-width: none;
    }
    .header-left::-webkit-scrollbar {
      display: none;
    }

    .brand-mark-group {
      display: flex;
      align-items: center;
      gap: 10px;
      text-decoration: none;
      color: var(--text-main);
      flex-shrink: 0;
    }

    .brand-icon {
      width: 24px;
      height: 24px;
      background-color: var(--text-main);
      color: #FFFFFF;
      font-family: var(--font-heading);
      font-weight: 700;
      font-size: 14px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 4px;
    }

    .brand-wordmark {
      font-family: var(--font-heading);
      font-weight: 650;
      font-size: 16px;
      letter-spacing: -0.2px;
      white-space: nowrap;
    }

    .main-nav {
      display: flex;
      align-items: center;
      gap: 4px;
      list-style: none;
      flex-shrink: 0;
    }

    .nav-item a {
      display: inline-flex;
      align-items: center;
      height: 56px;
      padding: 0 10px;
      font-size: 14px;
      font-weight: 500;
      color: var(--text-quiet);
      text-decoration: none;
      border-bottom: 2px solid transparent;
      transition: color var(--dur-quick) ease, border-color var(--dur-quick) ease;
      white-space: nowrap;
    }

    .nav-item a:hover {
      color: var(--text-main);
    }

    .nav-item a:focus-visible {
      outline: 2px solid var(--primary);
      outline-offset: -2px;
    }

    .nav-item a.active {
      color: var(--primary);
      border-bottom-color: var(--primary);
      font-weight: 600;
    }

    .header-right {
      display: flex;
      align-items: center;
      gap: 10px;
      flex-shrink: 0;
      margin-left: 16px;
    }

    .user-avatar-initials {
      width: 32px;
      height: 32px;
      background-color: var(--bg-page);
      border: 1px solid var(--border-color);
      border-radius: 6px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: var(--font-heading);
      font-size: 12px;
      font-weight: 650;
      color: var(--text-main);
    }

    .user-meta {
      display: flex;
      flex-direction: column;
      line-height: 1.2;
    }

    .user-name {
      font-size: 13px;
      font-weight: 600;
      color: var(--text-main);
    }

    .user-role {
      font-size: 11px;
      color: var(--text-quiet);
    }

    /* Page Container */
    .page-main {
      flex: 1;
      max-width: 1320px;
      width: 100%;
      margin: 0 auto;
      padding: 32px 24px;
      animation: page-fade-in 240ms var(--ease-standard) forwards;
    }

    .page-title-row {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      margin-bottom: 24px;
    }

    h1.page-title {
      font-family: var(--font-heading);
      font-size: 30px;
      font-weight: 650;
      line-height: 36px;
      color: var(--text-main);
    }

    .facility-context {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-size: 14px;
      color: var(--text-quiet);
    }

    .pulse-dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background-color: var(--status-good);
      display: inline-block;
      animation: status-breathe 8s ease-in-out infinite;
    }

    /* Two-column layout on Desktop */
    .layout-grid {
      display: grid;
      grid-template-columns: 460px 1fr;
      gap: 24px;
      align-items: start;
    }

    /* Panel Card */
    .panel-card {
      background-color: var(--bg-surface);
      border: 1px solid var(--border-color);
      border-radius: 8px;
      padding: 24px;
    }

    .panel-header {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      margin-bottom: 20px;
      padding-bottom: 12px;
      border-bottom: 1px solid var(--border-color);
    }

    h2.panel-title {
      font-family: var(--font-heading);
      font-size: 22px;
      font-weight: 650;
      line-height: 28px;
      color: var(--text-main);
    }

    h3.section-subtitle {
      font-family: var(--font-heading);
      font-size: 17px;
      font-weight: 600;
      line-height: 24px;
      color: var(--text-main);
      margin-bottom: 12px;
    }

    /* Status badge */
    .status-badge {
      display: inline-flex;
      align-items: center;
      padding: 2px 8px;
      font-size: 12px;
      font-weight: 600;
      border-radius: 4px;
      border: 1px solid currentColor;
      line-height: 16px;
      text-transform: capitalize;
    }

    .status-badge.good {
      color: var(--status-good);
      border-color: var(--status-good);
    }

    .status-badge.waiting {
      color: var(--status-waiting);
      border-color: var(--status-waiting);
    }

    .status-badge.failed {
      color: var(--status-failed);
      border-color: var(--status-failed);
    }

    /* Form controls */
    .form-group {
      display: flex;
      flex-direction: column;
      gap: 6px;
      margin-bottom: 16px;
    }

    .form-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px;
    }

    label.field-label {
      font-size: 14px;
      font-weight: 600;
      color: var(--text-main);
    }

    .field-input, .field-select {
      height: 44px;
      padding: 0 14px;
      background-color: var(--bg-surface);
      border: 1px solid var(--border-color);
      border-radius: 6px;
      font-family: var(--font-body);
      font-size: 15px;
      color: var(--text-main);
      width: 100%;
      transition: border-color var(--dur-quick) ease, box-shadow var(--dur-quick) ease;
    }

    .field-input.mono, .field-select.mono {
      font-family: var(--font-mono);
      font-size: 14px;
    }

    .field-input:focus, .field-select:focus {
      outline: none;
      border-color: var(--primary);
      box-shadow: 0 0 0 1px var(--primary);
    }

    .field-helper {
      font-size: 13px;
      color: var(--text-quiet);
      margin-top: 2px;
    }

    .num-mono {
      font-family: var(--font-mono);
    }

    /* Hero / Daily Total Callout */
    .daily-total-banner {
      background-color: #FAFAF9;
      border: 1px solid var(--border-color);
      border-radius: 6px;
      padding: 16px;
      margin-bottom: 20px;
    }

    .daily-total-eyebrow {
      font-size: 12px;
      font-weight: 600;
      color: var(--text-quiet);
      text-transform: uppercase;
      letter-spacing: 0.5px;
      margin-bottom: 4px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .daily-total-value {
      font-family: var(--font-mono);
      font-size: 34px;
      font-weight: 600;
      line-height: 40px;
      color: var(--text-main);
      display: flex;
      align-items: baseline;
      gap: 8px;
    }

    .daily-total-unit {
      font-family: var(--font-body);
      font-size: 16px;
      font-weight: 500;
      color: var(--text-quiet);
    }

    .daily-total-formula {
      font-size: 13px;
      color: var(--text-quiet);
      margin-top: 6px;
      border-top: 1px dashed var(--border-color);
      padding-top: 6px;
    }

    /* Lot breakdown list inside generator preview */
    .lot-breakdown-card {
      border: 1px solid var(--border-color);
      border-radius: 6px;
      margin-bottom: 20px;
      background-color: var(--bg-surface);
      overflow: hidden;
    }

    .lot-breakdown-header {
      background-color: #FAFAF9;
      padding: 10px 14px;
      font-size: 13px;
      font-weight: 600;
      border-bottom: 1px solid var(--border-color);
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .lot-item-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 12px 14px;
      border-bottom: 1px solid var(--border-color);
    }

    .lot-item-row:last-child {
      border-bottom: none;
    }

    .lot-item-name {
      font-weight: 600;
      font-size: 14px;
      color: var(--text-main);
    }

    .lot-item-sub {
      font-size: 13px;
      color: var(--text-quiet);
    }

    .lot-item-metrics {
      text-align: right;
    }

    .lot-item-weight {
      font-family: var(--font-mono);
      font-weight: 600;
      font-size: 15px;
      color: var(--text-main);
    }

    .lot-item-head {
      font-size: 13px;
      color: var(--text-quiet);
    }

    /* Alternative Pen Option Preview */
    .alternative-pen-box {
      border: 1px solid var(--border-color);
      border-radius: 6px;
      padding: 12px 14px;
      margin-bottom: 20px;
      background-color: var(--bg-surface);
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .alternative-pen-info {
      display: flex;
      flex-direction: column;
      gap: 2px;
    }

    .alternative-title {
      font-size: 13px;
      font-weight: 600;
      color: var(--text-main);
    }

    .alternative-desc {
      font-size: 13px;
      color: var(--text-quiet);
    }

    .alternative-total {
      font-family: var(--font-mono);
      font-size: 16px;
      font-weight: 600;
      color: var(--text-main);
      text-align: right;
    }

    /* Primary Button */
    .btn-primary {
      height: 44px;
      background-color: var(--primary);
      color: #FFFFFF;
      font-family: var(--font-body);
      font-size: 15px;
      font-weight: 600;
      border: none;
      border-radius: 6px;
      padding: 0 20px;
      cursor: pointer;
      width: 100%;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      transition: background-color var(--dur-quick) ease, transform 90ms ease;
    }

    .btn-primary:hover {
      background-color: #964e22;
    }

    .btn-primary:focus-visible {
      outline: 2px solid var(--primary);
      outline-offset: 2px;
    }

    .btn-primary:active {
      transform: scale(0.99);
    }

    /* Table styles */
    .table-container {
      overflow-x: auto;
      border: 1px solid var(--border-color);
      border-radius: 6px;
      background-color: var(--bg-surface);
    }

    .data-table {
      width: 100%;
      border-collapse: collapse;
      text-align: left;
    }

    .data-table th {
      height: 40px;
      background-color: #FAFAF9;
      font-size: 13px;
      font-weight: 600;
      color: var(--text-quiet);
      padding: 0 16px;
      border-bottom: 1px solid var(--border-color);
      white-space: nowrap;
    }

    .data-table td {
      height: 48px;
      padding: 0 16px;
      border-bottom: 1px solid var(--border-color);
      font-size: 14px;
      color: var(--text-main);
      white-space: nowrap;
    }

    .data-table tr:last-child td {
      border-bottom: none;
    }

    /* Signature table row motion */
    .data-table tbody tr {
      animation: row-entrance var(--dur-quick) ease-out backwards;
    }
    .data-table tbody tr:nth-child(1) { animation-delay: 50ms; }
    .data-table tbody tr:nth-child(2) { animation-delay: 100ms; }
    .data-table tbody tr:nth-child(3) { animation-delay: 150ms; }
    .data-table tbody tr:nth-child(4) { animation-delay: 200ms; }

    .data-table tbody tr:hover td {
      background-color: #FAFAF9;
    }

    /* Mobile responsive stacking */
    @media (max-width: 960px) {
      .app-header {
        padding: 0 16px;
      }
      .page-main {
        padding: 20px 16px;
      }
      h1.page-title {
        font-size: 26px;
        line-height: 32px;
      }
      .page-title-row {
        flex-direction: column;
        gap: 8px;
      }
      .layout-grid {
        grid-template-columns: 1fr;
      }
      .data-table td {
        height: 56px;
      }
    }
  </style>
</head>
<body>

  <!-- Shared Header -->
  <header class="app-header">
    <div class="header-left">
      <a href="javascript:void(0)" class="brand-mark-group">
        <span class="brand-icon">C</span>
        <span class="brand-wordmark">Cedar Draw Feedlot</span>
      </a>
      <nav aria-label="Main Navigation">
        <ul class="main-nav">
          <li class="nav-item"><a href="javascript:void(0)">Overview</a></li>
          <li class="nav-item"><a href="javascript:void(0)">Import records</a></li>
          <li class="nav-item"><a href="javascript:void(0)">Lots &amp; pens</a></li>
          <li class="nav-item"><a href="javascript:void(0)">Feed inventory</a></li>
          <li class="nav-item"><a href="javascript:void(0)">Inventory outlook</a></li>
          <li class="nav-item"><a href="javascript:void(0)">Rations</a></li>
          <li class="nav-item"><a href="javascript:void(0)" class="active" aria-current="page">Feeding plans</a></li>
          <li class="nav-item"><a href="javascript:void(0)">Feeding log</a></li>
          <li class="nav-item"><a href="javascript:void(0)">Weight records</a></li>
          <li class="nav-item"><a href="javascript:void(0)">Operational reports</a></li>
          <li class="nav-item"><a href="javascript:void(0)">Feed-to-gain</a></li>
          <li class="nav-item"><a href="javascript:void(0)">Project &amp; demo</a></li>
        </ul>
      </nav>
    </div>

    <div class="header-right">
      <div class="user-avatar-initials">MO</div>
      <div class="user-meta">
        <span class="user-name">Mara Ortega</span>
        <span class="user-role">Feed manager</span>
      </div>
    </div>
  </header>

  <!-- Main Content -->
  <main class="page-main">
    <div class="page-title-row">
      <h1 class="page-title">Feeding plans</h1>
      <div class="facility-context">
        <span class="pulse-dot"></span>
        <span>Cedar Draw Feedlot &middot; 23 Apr 2025 &middot; America/Denver</span>
      </div>
    </div>

    <div class="layout-grid">
      <!-- Plan Generator Column -->
      <section class="panel-card" aria-labelledby="generator-heading">
        <div class="panel-header">
          <h2 class="panel-title" id="generator-heading">Plan generator</h2>
          <span class="status-badge waiting">preview</span>
        </div>

        <form onsubmit="event.preventDefault();">
          <div class="form-row">
            <div class="form-group">
              <label class="field-label" for="pen-select">Pen</label>
              <select id="pen-select" class="field-select mono">
                <option value="P-04" selected>P-04 (116 / 150 head)</option>
                <option value="P-02">P-02 (72 / 120 head)</option>
              </select>
            </div>
            <div class="form-group">
              <label class="field-label" for="plan-date">Plan date</label>
              <input type="text" id="plan-date" class="field-input mono" value="23 Apr 2025" readonly>
            </div>
          </div>

          <div class="form-group">
            <label class="field-label" for="ration-select">Selected ration</label>
            <select id="ration-select" class="field-select">
              <option value="Grower 1" selected>Grower 1 ($0.15286 /lb &middot; 13.8% CP)</option>
              <option value="Finisher 2">Finisher 2 ($0.14956 /lb &middot; 13.2% CP)</option>
            </select>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label class="field-label" for="bunk-rate">Daily bunk rate (lb/head)</label>
              <input type="text" id="bunk-rate" class="field-input mono" value="14.0">
            </div>
            <div class="form-group">
              <label class="field-label" for="headcount">Current pen headcount</label>
              <input type="text" id="headcount" class="field-input mono" value="116 head" readonly>
            </div>
          </div>

          <!-- Hero Callout: Daily Total -->
          <div class="daily-total-banner">
            <div class="daily-total-eyebrow">
              <span>Generated Daily Total</span>
              <span class="num-mono">23 Apr 2025</span>
            </div>
            <div class="daily-total-value">
              <span>1,624</span>
              <span class="daily-total-unit">lb as-fed</span>
            </div>
            <div class="daily-total-formula">
              Calculated from <span class="num-mono">116</span> penned animals at <span class="num-mono">14 lb/head/day</span> using Grower 1 for pen <span class="num-mono">P-04</span>.
            </div>
          </div>

          <!-- Lot Quantities Preview -->
          <div class="lot-breakdown-card">
            <div class="lot-breakdown-header">
              <span>Pen P-04 lot breakdown preview</span>
              <span class="num-mono">116 head total</span>
            </div>
            <div class="lot-item-row">
              <div>
                <div class="lot-item-name num-mono">L-241</div>
                <div class="lot-item-sub">Angus–Hereford steers</div>
              </div>
              <div class="lot-item-metrics">
                <div class="lot-item-weight">840 lb</div>
                <div class="lot-item-head num-mono">60 head &times; 14 lb/day</div>
              </div>
            </div>
            <div class="lot-item-row">
              <div>
                <div class="lot-item-name num-mono">L-242</div>
                <div class="lot-item-sub">Charolais-cross heifers</div>
              </div>
              <div class="lot-item-metrics">
                <div class="lot-item-weight">784 lb</div>
                <div class="lot-item-head num-mono">56 head &times; 14 lb/day</div>
              </div>
            </div>
          </div>

          <!-- Alternative Option -->
          <div class="alternative-pen-box">
            <div class="alternative-pen-info">
              <span class="alternative-title">Alternative pen: P-02</span>
              <span class="alternative-desc">72 head at 18 lb/head/day &middot; Grower 1 (L-239)</span>
            </div>
            <div class="alternative-total">
              <div>1,296 lb</div>
              <span class="status-badge good" style="font-size: 11px;">available</span>
            </div>
          </div>

          <button type="submit" class="btn-primary">Generate plan</button>
        </form>
      </section>

      <!-- Dated Plan List Column -->
      <section class="panel-card" aria-labelledby="history-heading">
        <div class="panel-header">
          <h2 class="panel-title" id="history-heading">Dated feeding plans</h2>
          <span class="facility-context num-mono">2 active records</span>
        </div>

        <div class="table-container">
          <table class="data-table">
            <thead>
              <tr>
                <th>Date</th>
                <th>Pen</th>
                <th>Ration</th>
                <th>Headcount</th>
                <th>Daily total</th>
                <th>Status</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td class="num-mono">22 Apr 2025</td>
                <td class="num-mono">P-04</td>
                <td>Grower 1</td>
                <td class="num-mono">116 head</td>
                <td class="num-mono">1,624 lb</td>
                <td><span class="status-badge good">Completed</span></td>
              </tr>
              <tr>
                <td class="num-mono">19 Apr 2025</td>
                <td class="num-mono">P-02</td>
                <td>Grower 1</td>
                <td class="num-mono">72 head</td>
                <td class="num-mono">1,296 lb</td>
                <td><span class="status-badge good">Completed</span></td>
              </tr>
            </tbody>
          </table>
        </div>

        <div style="margin-top: 24px; padding: 16px; border-radius: 6px; border: 1px solid var(--border-color); background-color: #FAFAF9;">
          <h3 class="section-subtitle" style="margin-bottom: 8px;">Execution note</h3>
          <p style="font-size: 14px; color: var(--text-quiet); line-height: 20px;">
