  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    /* Design Tokens */
    :root {
      --bg-page: #F6F7F5;
      --bg-surface: #FFFFFF;
      --text-main: #252A27;
      --text-muted: #66706A;
      --border-color: #D9DEDA;
      --primary: #AD5C2A;
      --status-good: #28734F;
      --status-waiting: #94600C;
      --status-failed: #AE3D36;
      --dur-quick: 160ms;
    }

    body {
      background-color: var(--bg-page);
      color: var(--text-main);
      font-family: 'Source Sans 3', sans-serif;
      font-size: 16px;
      line-height: 24px;
      margin: 0;
      padding: 0;
      -webkit-font-smoothing: antialiased;
    }

    h1, .font-heading-1 {
      font-family: 'Hanken Grotesk', sans-serif;
      font-size: 30px;
      font-weight: 650;
      line-height: 38px;
    }

    h2, .font-heading-2 {
      font-family: 'Hanken Grotesk', sans-serif;
      font-size: 22px;
      font-weight: 650;
      line-height: 28px;
    }

    h3, .font-heading-3 {
      font-family: 'Hanken Grotesk', sans-serif;
      font-size: 17px;
      font-weight: 600;
      line-height: 22px;
    }

    .font-mono-num {
      font-family: 'IBM Plex Mono', monospace;
    }

    /* Motion specifications */
    @keyframes fadeInSettle {
      from {
        opacity: 0;
        transform: translateY(8px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes status-breathe {
      0%, 100% {
        opacity: 0.96;
      }
      50% {
        opacity: 1;
      }
    }

    .animate-status-breathe {
      animation: status-breathe 8s ease-in-out infinite;
    }

    .stagger-row-1 { animation: fadeInSettle var(--dur-quick) ease-out 0ms both; }
    .stagger-row-2 { animation: fadeInSettle var(--dur-quick) ease-out 50ms both; }
    .stagger-row-3 { animation: fadeInSettle var(--dur-quick) ease-out 100ms both; }
    .stagger-row-4 { animation: fadeInSettle var(--dur-quick) ease-out 150ms both; }
    .stagger-row-5 { animation: fadeInSettle var(--dur-quick) ease-out 200ms both; }
    .stagger-row-6 { animation: fadeInSettle var(--dur-quick) ease-out 250ms both; }

    /* Interactive state styles */
    .nav-item {
      color: var(--text-muted);
      transition: color var(--dur-quick) ease;
      padding-top: 16px;
      padding-bottom: 16px;
      position: relative;
      text-decoration: none;
      font-size: 14px;
      font-weight: 500;
      white-space: nowrap;
    }

    .nav-item:hover {
      color: var(--text-main);
    }

    .nav-item.active {
      color: var(--primary);
      font-weight: 600;
    }

    .nav-item.active::after {
      content: '';
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      height: 2px;
      background-color: var(--primary);
    }

    .input-field {
      height: 44px;
      border: 1px solid var(--border-color);
      border-radius: 6px;
      background-color: var(--bg-surface);
      color: var(--text-main);
      padding: 0 12px;
      font-size: 15px;
      outline: none;
      transition: border-color var(--dur-quick) ease, box-shadow var(--dur-quick) ease;
    }

    .input-field:focus {
      border-color: var(--primary);
      box-shadow: 0 0 0 1px var(--primary);
    }

    .table-row-48 {
      height: 48px;
    }

    @media (prefers-reduced-motion: reduce) {
      *, ::before, ::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
      }
    }
  </style>
</head>
