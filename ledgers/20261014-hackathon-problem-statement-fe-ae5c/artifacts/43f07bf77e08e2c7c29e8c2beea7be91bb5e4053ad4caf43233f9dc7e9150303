onseMock, getGetOperationalReportsResponseMock, getGetFeedToGainReportResponseMock, getGetProjectDemoResponseMock, getLoadDemoDataResponseMock, getGetOverviewMockHandler, getGetImportBatchesMockHandler, getPreviewImportMockHandler, getSynchronizeImportsMockHandler, getGetLotsMockHandler, getMapPurchaseOrderLineMockHandler, getUpdateLotAssumptionsMockHandler, getGetLotForecastMockHandler, getGetInventoryItemsMockHandler, getRecordInventoryMovementMockHandler, getRecordActualWastageMockHandler, getUpdateInventorySettingsMockHandler, getGetInventoryOutlookMockHandler, getGetRationsMockHandler, getCreateRationMockHandler, getOptimizeRationMockHandler, getSelectRationCandidateMockHandler, getGetFeedingPlansMockHandler, getGenerateFeedingPlanMockHandler, getGetFeedingActivitiesMockHandler, getRecordFeedingActivityMockHandler, getGetWeightReadingsMockHandler, getCreateWeightReadingMockHandler, getUpdateWeightReadingMockHandler, getDeleteWeightReadingMockHandler, getGetLotPerformanceMockHandler, getGetOperationalReportsMockHandler, getGetFeedToGainReportMockHandler, getGetProjectDemoMockHandler, getLoadDemoDataMockHandler, getFeedlotOperationsAPIMock.\n\n<artifact id=\"acs\" kind=\"acceptance-criteria\" sha=\"\">\n[\n {\n  \"req\": \"REQ-11\",\n  \"given\": \"A user records a weight measurement for a lot.\",\n  \"id\": \"AC-11.1\",\n  \"level\": \"ui\",\n  \"then\": \"The screen displays the returned measurement date, number of animals weighed, average animal weight, total lot weight, weight gain since the prior measurement, and notes.\",\n  \"when\": \"The measurement is saved.\"\n },\n {\n  \"req\": \"REQ-11\",\n  \"given\": \"A lot has multiple saved weight measurements.\",\n  \"id\": \"AC-11.2\",\n  \"level\": \"ui\",\n  \"then\": \"The screen displays the returned readings in date order as a time series, with controls to add, edit, and delete readings.\",\n  \"when\": \"A user opens its weight history.\"\n },\n {\n  \"req\": \"REQ-11\",\n  \"given\": \"A user edits or 