{"ts":1791975264003,"kind":"call","tool":"Bash","input":"{\"command\":\"sed -n '1,240p' components/screens/s-3/container.tsx\"}","output":"\"use client\";\n\n// S-3 Lots & pens (/lots-pens): the approved Stitch page, built by the coding task in this file.\nimport { AlertCircle, CheckCircle2, RotateCw } from \"lucide-react\";\nimport { useEffect, useMemo, useRef, useState, type FormEvent } from \"react\";\nimport { Button } from \"@/components/ui/button\";\nimport { Card, CardContent, CardHeader, CardTitle } from \"@/components/ui/card\";\nimport { Input } from \"@/components/ui/input\";\nimport { Notice, NoticeDescription, NoticeTitle } from \"@/components/ui/notice\";\nimport { Select, SelectContent, SelectItem, SelectTrigger, SelectValue } from \"@/components/ui/select\";\nimport { Skeleton } from \"@/components/ui/skeleton\";\nimport { StatusBadge, toneOf } from \"@/components/ui/status-badge\";\nimport { Table, TableBody, TableCell, TableHead, TableHeader, TableRow } from \"@/components/ui/table\";\nimport { getLotForecast, getLots, mapPurchaseOrderLine, updateLotAssumptions } from \"@/lib/api/client\";\nimport type { ForecastOkResponse, Lot, LotMappingOkResponse, LotsOkResponse } from \"@/lib/api/client.schemas\";\n\nconst SAMPLE_LOTS: LotsOkResponse = {\n  lots: [\n    { id: 241, name: \"L-241\", penId: 4, penName: \"P-04\", headCount: 60, breed: \"Angus–Hereford\", sex: \"steers\", sourcePurchaseOrderLine: \"PO-5831 line 1\", status: \"good\", targetWeightLb: 1350, defaultGainRateLbPerDay: 3, measuredAdgLbPerDay: 2.35 },\n    { id: 242, name: \"L-242\", penId: 4, penName: \"P-04\", headCount: 56, breed: \"Charolais-cross\", sex: \"heifers\", sourcePurchaseOrderLine: \"PO-5840 line 1\", status: \"good\", targetWeightLb: 1350, defaultGainRateLbPerDay: 3, measuredAdgLbPerDay: null },\n    { id: 239, name: \"L-239\", penId: 2, penName: \"P-02\", headCount: 72, breed: \"Angus\", sex: \"steers\", sourcePurchaseOrderLine: \"PO-5790 line 1\", status: \"good\", targetWeightLb: 1350, defaultGainRateLbPerDay: 3, measuredAdgLbPerDay: 2.95 },\n    { id: 243, name: \"L-243\", penId: null, penName: \"Unavailable\", headCount: 24, breed: \"Angus–Hereford\", sex: \"steers\", sourcePurchaseOrderLine: \"PO-5831 line 1\", status: \"waiting\", targetWeightLb: 1350, defaultGainRateLbPerDay: 3, measuredAdgLbPerDay: null },\n  ],\n  pens: [\n    { id: 4, name: \"P-04\", capacity: 150, currentAnimalCount: 116, activeLotCount: 2, status: \"good\" },\n    { id: 2, name: \"P-02\", capacity: 120, currentAnimalCount: 72, activeLotCount: 1, status: \"good\" },\n  ],\n};\n\nconst SAMPLE_MAPPINGS: LotMappingOkResponse[] = [\n  { sourcePurchaseOrderLine: \"PO-5831 line 1\", assignments: [\n    { lotId: 241, lotName: \"L-241\", penId: 4, penName: \"P-04\", requestedHeadCount: 60, capacity: 150, currentAnimalCount: 116, status: \"good\", problemDetail: null },\n    { lotId: 243, lotName: \"L-243\", penId: 0, penName: \"No pen\", requestedHeadCount: 24, capacity: 0, currentAnimalCount: 0, status: \"waiting\", problemDetail: \"24 head are awaiting pen assignment.\" },\n  ] },\n  { sourcePurchaseOrderLine: \"PO-5840 line 1\", assignments: [\n    { lotId: 242, lotName: \"L-242\", penId: 4, penName: \"P-04\", requestedHeadCount: 56, capacity: 150, currentAnimalCount: 116, status: \"good\", problemDetail: null },\n  ] },\n  { sourcePurchaseOrderLine: \"PO-5790 line 1\", assignments: [\n    { lotId: 239, lotName: \"L-239\", penId: 2, penName: \"P-02\", requestedHeadCount: 72, capacity: 120, currentAnimalCount: 72, status: \"good\", problemDetail: null },\n  ] },\n];\n\nconst SAMPLE_FORECAST: ForecastOkResponse = {\n  lotId: 241,\n  targetWeightLb: 1350,\n  gainRateLbPerDay: 2.35,\n  gainRateBasis: \"measured\",\n  projectedMarketDate: \"2025-11-22\",\n  recommendations: [{ kind: \"sale_timing\", message: \"Current gain rate projects market readiness on 22 Nov 2025.\", adgLbPerDay: 2.35, projectedMarketDate: \"2025-11-22\", planVariance: null }],\n};\n\nconst number = (value: number) => new Intl.NumberFormat(\"en-US\", { maximumFractionDigits: 2 }).format(value);\nconst statusText = (value: string) => value.replaceAll(\"_\", \" \");\nconst displayDate = (value: string | null) => {\n  if (!value) return \"Not available\";\n  const date = new Date(`${value.slice(0, 10)}T12:00:00`);\n  return Number.isNaN(date.valueOf()) ? value : new Intl.DateTimeFormat(\"en-GB\", { day: \"2-digit\", month: \"short\", year: \"numeric\", timeZone: \"UTC\" }).format(date);\n};\n\nfunction isFixtureState(state: string | undefined, pattern: RegExp) {\n  return Boolean(state && pattern.test(state));\n}\n\nfunction Stat({ label, children, detail }: { label: string; children: React.ReactNode; detail?: string }) {\n  return <div className=\"grid min-w-0 gap-1 rounded-md border bg-muted/30 px-3 py-2\"><span className=\"text-xs font-semibold uppercase tracking-wide text-muted-foreground\">{label}</span><strong className=\"font-heading text-lg font-semibold leading-tight\">{children}</strong>{detail && <span className=\"text-xs text-muted-foreground\">{detail}</span>}</div>;\n}\n\nfunction MappingOutcome({ result }: { result: LotMappingOkResponse }) {\n  return <div className=\"grid gap-2 border-t p-3 first:border-t-0 sm:grid-cols-2 sm:items-start\">\n    <div><span className=\"block text-xs text-muted-foreground\">PO Line Trace</span><strong className=\"font-mono text-sm\">{result.sourcePurchaseOrderLine}</strong></div>\n    <div className=\"grid gap-2\">\n      {result.assignments.map((assignment, index) => {\n        const refused = /capacity|refus|block/i.test(assignment.status) || Boolean(assignment.problemDetail && /capacity|exceed/i.test(assignment.problemDetail));\n        return <div key={`${assignment.lotId}-${assignment.penId}-${index}`} className=\"flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 rounded-md bg-muted/30 px-3 py-2 text-sm\">\n          <span><strong className=\"font-mono\">{assignment.lotName}</strong> <span className=\"text-muted-foreground\">→ {assignment.penName}</span></span>\n          <span className=\"flex flex-wrap gap-1 text-xs text-muted-foreground\"><span className=\"font-mono\">{number(assignment.currentAnimalCount)}</span><span>current /</span><span className=\"font-mono\">{number(assignment.capacity)}</span><span>capacity ·</span><span className=\"font-mono\">{number(assignment.requestedHeadCount)}</span><span>requested</span></span>\n          <span className=\"basis-full flex flex-wrap items-center gap-2\">\n            <StatusBadge tone={refused ? \"bad\" : toneOf(assignment.status)}>{statusText(assignment.status)}</StatusBadge>\n            {refused && <span className=\"text-xs font-medium text-destructive\">Capacity refusal · limit {number(assignment.capacity)} head</span>}\n            {assignment.problemDetail && <span className=\"text-xs text-text-secondary\">{assignment.problemDetail}</span>}\n          </span>\n        </div>;\n      })}\n    </div>\n  </div>;\n}\n\nexport function LotsPensContainer({ fixture }: { fixture?: string }) {\n  const fixtureMode = fixture !== undefined;\n  const fixtureValidation = isFixtureState(fixture, /validation|invalid/i);\n  const fixtureSaved = isFixtureState(fixture, /saved|recalculat/i);\n  const fixtureUnresolved = isFixtureState(fixture, /unresolved|unavailable|pending/i);\n  const [data, setData] = useState<LotsOkResponse | null>(SAMPLE_LOTS);\n  const [mappings, setMappings] = useState<LotMappingOkResponse[]>(fixtureMode ? SAMPLE_MAPPINGS : []);\n  const [forecast, setForecast] = useState<ForecastOkResponse | null>(fixtureMode ? SAMPLE_FORECAST : null);\n  const [selectedLotId, setSelectedLotId] = useState<number | null>(SAMPLE_FORECAST.lotId);\n  const [targetWeight, setTargetWeight] = useState(fixtureValidation ? \"0\" : fixtureSaved ? \"1350\" : \"1350\");\n  const [defaultGainRate, setDefaultGainRate] = useState(fixtureValidation ? \"-1\" : fixtureSaved ? \"3.1\" : \"3\");\n  const [search, setSearch] = useState(\"\");\n  const [selectedPenId, setSelectedPenId] = useState(\"\");\n  const [assignmentHeadCount, setAssignmentHeadCount] = useState(\"\");\n  const [loading, setLoading] = useState(!fixtureMode);\n  const [saving, setSaving] = useState(false);\n  const [mappingBusy, setMappingBusy] = useState(false);\n  const [saved, setSaved] = useState(fixtureSaved);\n  const [validation, setValidation] = useState<string[]>(fixtureValidation ? [\"Target weight must be greater than zero.\", \"Default gain rate must be greater than zero.\"] : []);\n  const [error, setError] = useState(\"\");\n  const [mappingError, setMappingError] = useState(\"\");\n  const assumptionsEdited = useRef(false);\n\n  useEffect(() => {\n    if (fixtureMode) {\n      setData(SAMPLE_LOTS);\n      setMappings(fixtureUnresolved ? [...SAMPLE_MAPPINGS, { sourcePurchaseOrderLine: \"RCV-9940\", assignments: [{ lotId: 243, lotName: \"Pending receipt RCV-9940\", penId: 0, penName: \"Unavailable\", requestedHeadCount: 18, capacity: 60, currentAnimalCount: 52, status: \"Capacity blocked\", problemDetail: \"Assignment exceeds the 60 head pen capacity.\" }] }] : SAMPLE_MAPPINGS);\n      setForecast(SAMPLE_FORECAST);\n      setLoading(false);\n      return;\n    }\n\n    let active = true;\n    const load = async () => {\n      setLoading(true);\n      setError(\"\");\n      try {\n        const response = await getLots();\n        if (response.status !== 200) throw new Error(\"Lot and pen records could not be loaded.\");\n        const lots = response.data;\n        if (!active) return;\n        setData(lots);\n        const firstLot = lots.lots[0];\n        if (firstLot) {\n          setSelectedLotId(firstLot.id);\n          if (!assumptionsEdited.current) {\n            setTargetWeight(String(firstLot.targetWeightLb));\n            setDefaultGainRate(String(firstLot.defaultGainRateLbPerDay));\n          }\n          setSelectedPenId(firstLot.penId === null ? \"\" : String(firstLot.penId));\n          setAssignmentHeadCount(String(firstLot.headCount));\n        }\n\n        const groups = new Map<string, Lot[]>();\n        for (const lot of lots.lots) {\n          if (lot.penId === null || /pending|unavailable/i.test(lot.status)) continue;\n          const group = groups.get(lot.sourcePurchaseOrderLine) ?? [];\n          group.push(lot);\n          groups.set(lot.sourcePurchaseOrderLine, group);\n        }\n        const results = await Promise.all([...groups.entries()].map(async ([sourcePurchaseOrderLine, assignments]) => {\n          const mapped = await mapPurchaseOrderLine({\n            sourcePurchaseOrderLine,\n            assignments: assignments.map((lot) => ({ lotId: lot.id, penId: lot.penId as number, headCount: lot.headCount })),\n          });\n          return mapped.status === 200 ? mapped.data : null;\n        }));\n        if (active) setMappings(results.filter((result): result is LotMappingOkResponse => result !== null));\n        if (firstLot) {\n          const forecastResponse = await getLotForecast(firstLot.id);\n          if (active && forecastResponse.status === 200) setForecast(forecastResponse.data);\n        }\n      } catch {\n        if (active) setError(\"Lot and pen records could not be loaded. Try again in a moment.\");\n      } finally {\n        if (active) setLoading(false);\n      }\n    };\n    void load();\n    return () => { active = false; };\n  }, [fixture, fixtureMode, fixtureUnresolved]);\n\n  const selectedLot = data?.lots.find((lot) => lot.id === selectedLotId) ?? null;\n  const availableLots = data?.lots.filter((lot) => lot.penId !== null && !/pending|unavailable/i.test(lot.status)) ?? [];\n  const visibleLots = useMemo(() => (data?.lots ?? []).filter((lot) => `${lot.name} ${lot.penName} ${lot.breed} ${lot.sex} ${lot.sourcePurchaseOrderLine}`.toLowerCase().includes(search.toLowerCase())), [data, search]);\n  const acceptedHead = data?.lots.reduce((sum, lot) => sum + lot.headCount, 0) ?? 0;\n  const pendingLots = data?.lots.