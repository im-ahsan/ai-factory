 + wastageRatio) / 1.042);","      const projectedBalanceLb = Math.abs(wastageRatio - 0.042) < 0.00001","        ? SAMPLE_BALANCES[horizon][item.id]","        : Math.round(item.availableQuantity - dailyEstimatedConsumptionLb * selectedHorizon.days);","      return { itemId: item.id, itemName: item.name, currentStockLb: item.availableQuantity, dailyEstimatedConsumptionLb, projectedBalanceLb };","    }),","  };","}","","function sampleProjections(wastageRatio: number) {","  return Object.fromEntries(HORIZONS.map(({ value }) => [value, sampleProjection(value, wastageRatio)])) as Partial<Record<GetInventoryOutlookHorizon, OutlookOkResponse>>;","}","","function FieldError({ children }: { children: string }) {","  return <p className=\"text-sm text-destructive\" role=\"alert\">{children}</p>;","}","","  const fixtureMode = fixture !== undefined;","  const fixtureValidation = Boolean(fixture && /validation|invalid|out.of.range/i.test(fixture));","  const [inventory, setInventory] = useState<InventoryOkResponse | null>(fixtureMode ? SAMPLE_INVENTORY : null);","  const [ratio, setRatio] = useState(fixtureMode ? SAMPLE_INVENTORY.wastageRatio : 0.04);","  const [ratioInput, setRatioInput] = useState(fixtureValidation ? \"125\" : ratioInputValue(fixtureMode ? SAMPLE_INVENTORY.wastageRatio : 0.04));","  const [validation, setValidation] = useState(fixtureValidation ? \"Enter a wastage ratio from 0% to 100%.\" : \"\");","  const [projections, setProjections] = useState<Partial<Record<GetInventoryOutlookHorizon, OutlookOkResponse>>>(() => fixtureMode ? sampleProjections(SAMPLE_INVENTORY.wastageRatio) : {});","  const [activeHorizon, setActiveHorizon] = useState<GetInventoryOutlookHorizon>(\"daily\");","  const [loading, setLoading] = useState(!fixtureMode);","  const [saving, setSaving] = useState(false);","  const [error, setError] = useState(\"\");","  const ratioUpdateTimer = useRef<ReturnType<typeof setTimeout> | null>(null);","  const ratioEditId = useRef(0);","","  useEffect