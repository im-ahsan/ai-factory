ation of forecast.recommendations) {\n      await expectText(recommendation.message);\n      if (recommendation.adgLbPerDay !== null) await expectText(String(recommendation.adgLbPerDay));\n      if (recommendation.projectedMarketDate !== null) await expectText(recommendation.projectedMarketDate);\n      if (recommendation.planVariance !== null) await expectText(String(recommendation.planVariance));\n    }\n  });\n\n  it(\"AC_4_1_ShowsInventoryItemDetailsAndStockMovementHistory\", async () => {\n    at(\"/inventory\");\n    const inventory = getGetInventoryItemsResponseMock();\n    inventory.items.push({\n      ...inventory.items[0], id: 12, name: \"Alfalfa hay\", category: \"Forage\", availableQuantity: 22400,\n      unit: \"ton\", unitCost: 0.24, dryMatterPercent: 91, energyMcalPerKg: 2.1, storageLocation: \"Barn B\",\n      openingStockLb: 24000, receivedStockLb: 3200, consumedStockLb: 4100, actualWastageLb: 75,\n      closingStockLb: 23025,\n      movements: [{ ...inventory.items[0].movements[0], id: 702, itemId: 12, movementType: \"received\", date: \"2026-10-12\", quantityLb: 3200, note: \"Hay delivery\", wastageCause: null }],\n    });\n    server.use(getGetInventoryItemsMockHandler(inventory));\n    render(<FeedInventoryContainer />);\n\n    for (const item of inventory.items) {\n      await expectText(item.name);\n      await expectText(item.category);\n      await expectText(formattedNumber(item.availableQuantity));\n      await expectText(item.unit);\n      await expectText(String(item.unitCost));\n      await expectText(String(item.dryMatterPercent));\n6: * OpenAPI spec version: 1.0.0\n296: * @summary Get lot and pen records\n327:  return `http://localhost:5080/lots`\n350: * @summary Map a source purchase order line to lots and pens\n391:  return `http://localhost:5080/lots/mappings`\n448:  return `http://localhost:5080/lots/${lotId}/assumptions`\n506:  return `http://localhost:5080/lots/${lotId}/forecast`\n790:      normalizedParams.append(key, value ===