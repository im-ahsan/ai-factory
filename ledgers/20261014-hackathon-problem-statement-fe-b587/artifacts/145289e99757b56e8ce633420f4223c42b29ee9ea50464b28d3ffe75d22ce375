n(\\\"Pen 14\\\");\\n  });\\n\\n  it(\\\"AC_18_1_TotalIsAverageTimesCountWithNoTotalField\\\", async () => {\\n    const u = userEvent.setup();\\n    installYard({ weights: weightHistoryStore().weights, metrics: M(), posts: [] });\\n    render(<ProcurementLotRecordsContainer />);\\n    const avg = await screen.findByLabelText(/average animal weight/i);\\n    const count = await screen.findByLabelText(/animals weighed/i);\\n    expect(screen.queryByRole(\\\"spinbutton\\\", { name: /total/i })).toBeNull();\\n    expect(screen.queryByRole(\\\"textbox\\\", { name: /total/i })).toBeNull();\\n    await fill(u, avg, \\\"640\\\");\\n    await fill(u, count, \\\"12\\\");\\n    await waitFor(() => expect(shows(num(7680))).toBe(true));\\n    await fill(u, avg, \\\"705\\\");\\n    await waitFor(() => expect(shows(num(8460))).toBe(true));\\n    expect(shows(num(7680))).toBe(false);\\n    await fill(u, count, \\\"9\\\");\\n    await waitFor(() => expect(shows(num(6345))).toBe(true));\\n    expect(shows(num(8460))).toBe(false);\\n    expect(screen.queryByRole(\\\"spinbutton\\\", { name: /total/i })).toBeNull();\\n    expect(screen.queryByRole(\\\"textbox\\\", { name: /total/i })).toBeNull();\\n  });\\n\\n  it(\\\"AC_18_2_Saves500By20AsTenThousandInHistory\\\", async () => {\\n    const u = userEvent.setup();\\n    const store = weightHistoryStore();\\n    const saved = W({ weightId: 20, measurementDate: \\\"2026-01-14\\\", animalsWeighed: 20, averageWeightLb: 500, totalMeasuredWeightLb: 10000, weightGainSincePriorLb: 52, notes: \\\"Pre-ship check\\\" });\\n    installYard(store, [\\n      msw.getCreateWeightMeasurementMockHandler(async (info) => {\\n        store.posts.push(await info.request.clone().json());\\n        store.weights.push(saved);\\n        store.metrics = M({ averageDailyGainLbPerDay: 1.88 });\\n        return { record: saved, revisedMetrics: store.metrics };\\n      }),\\n    ]);\\n    render(<ProcurementLotRecordsContainer />);\\n    const form = document.body;\\