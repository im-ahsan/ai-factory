rowText(row)).toContain(\\\"Pre-ship check\\\");\\n    expect(rowWith(num(14616))).toBeTruthy();\\n  });\\n\\n  it(\\\"AC_19_1_WeightHistoryListsRecordsInTimeOrderWithAllColumns\\\", async () => {\\n    const store = weightHistoryStore();\\n    ... (14328 more characters not kept)","chars":34328}
