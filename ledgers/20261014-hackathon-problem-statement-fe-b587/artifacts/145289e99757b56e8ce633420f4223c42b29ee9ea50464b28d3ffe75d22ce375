\"@/lib/api/client.schemas\\\";\\n\\nvi.setConfig({ testTimeout: 30000 });\\n\\n// ---------- server ----------\\nconst server = setupServer();\\nbeforeAll(() => server.listen({ onUnhandledRequest: \\\"bypass\\\" }));\\nafterEach(() => { server.resetHandlers(); vi.unstubAllGlobals(); vi.restoreAllMocks(); });\\nafterAll(() => server.close());\\nconst serve = (...h: RequestHandler[]) => server.use(...h, ...msw.getFeedlotWorkspaceAPIMock());\\n\\n// ---------- text helpers ----------\\nconst num = (n: number) => {\\n  const [i, f] = String(n).split(\\\".\\\");\\n  const grouped = i.replace(/\\\\B(?=(\\\\d{3})+(?!\\\\d))/g, \\\",?\\\");\\n  const tail = f ? `\\\\\\\\.${f}0*` : \\\"(?:\\\\\\\\.0+)?\\\";\\n  return new RegExp(`(?<![\\\\\\\\d.,])${grouped}${tail}(?!\\\\\\\\d|,\\\\\\\\d)`);\\n};\\nconst MONTHS = [\\\"January\\\", \\\"February\\\", \\\"March\\\", \\\"April\\\", \\\"May\\\", \\\"June\\\", \\\"July\\\", \\\"August\\\", \\\"September\\\", \\\"October\\\", \\\"November\\\", \\\"December\\\"];\\nconst dateRe = (iso: string) => {\\n  const [y, m, d] = iso.split(\\\"-\\\").map(Number);\\n  const mn = MONTHS[m - 1].slice(0, 3);\\n  const dd = `0?${d}`;\\n  return new RegExp(`${y}-0?${m}-${dd}\\\\\\\\b|\\\\\\\\b${dd}\\\\\\\\s+${mn}[a-z]*\\\\\\\\.?,?\\\\\\\\s+${y}|${mn}[a-z]*\\\\\\\\.?\\\\\\\\s+${dd}(st|nd|rd|th)?,?\\\\\\\\s+${y}|\\\\\\\\b${dd}/0?${m}/${y}|\\\\\\\\b0?${m}/${dd}/${y}`, \\\"i\\\");\\n};\\nconst shows = (re: RegExp) => {\\n  const leaves = Array.from(document.body.querySelectorAll(\\\"*\\\")).filter((e) => e.children.length === 0).map((e) => e.textContent ?? \\\"\\\");\\n  const values = Array.from(document.body.querySelectorAll(\\\"input,textarea\\\")).map((e) => (e as HTMLInputElement).value);\\n  return [...leaves, ...values].some((t) => re.test(t));\\n};\\nconst rowText = (r: Element) => Array.from(r.querySelectorAll(\\\"td,th,[role=cell],[role=gridcell],[role=columnheader]\\\")).map((c) => c.textContent ?? \\\"\\\").join(\\\" | \\\");\\nconst rowWith = (...res: Array<RegExp | string>) =>\\n  Array.from(document.querySelectorAll(\\\"tr,[role=row]\\\")).find((r) => {\\n    const t = rowText(r);\\n    return res.every((x) => (typeof x === \\\"string\\\" ? t.includes(x) : x.test(t)));\\n  });\\nconst visibleText = (scope: Element) => {\\n  const parts: string[] = [];\\n  scope.querySelectorAll(\\\"*\\\").forEach((e) => {\\n    if (e.tagName === \\\"SELECT\\\") { parts.push(Array.from((e as HTMLSelectElement).selectedOptions).map((o) => o.textContent ?? \\\"\\\").join(\\\" \\\")); return; }\\n    if (e.tagName === \\\"OPTION\\\") return;\\n    if (e.tagName === \\\"INPUT\\\" || e.tagName === \\\"TEXTAREA\\\") parts.push((e as HTMLInputElement).value);\\n    if (e.children.length === 0) parts.push(e.textContent ?? \\\"\\\");\\n  });\\n  return parts.join(\\\" | \\\");\\n};\\nconst metricNow = (label: RegExp) => {\\n  const els = screen.queryAllByText(label);\\n  const el = els.find((e) => e.tagName === \\\"DT\\\") ?? els[0];\\n  if (!el) return \\\"\\\";\\n  return (el.tagName === \\\"DT\\\" ? el.nextElementSibling : el.parentElement)?.textContent ?? \\\"\\\";\\n};\\n\\n// ---------- interaction helpers ----------\\ntype U = ReturnType<typeof userEvent.setup>;\\nasync function fill(u: U, el: HTMLElement, value: string) {\\n  await u.clear(el);\\n  await u.type(el, value);\\n}\\nasync function choose(u: U, scope: HTMLElement, label: RegExp, option: RegExp) {\\n  const el = await within(scope).findByLabelText(label);\\n  if (el.tagName === \\\"SELECT\\\") {\\n    await u.selectOptions(el, within(el).getByRole(\\\"option\\\", { name: option }));\\n  } else {\\n    await u.click(el);\\n    await u.click(await screen.findByRole(\\\"option\\\", { name: option }));\\n  }\\n}\\nasync function actionButton(u: U, name: RegExp, row?: Element) {\\n  const find = () => screen.queryByRole(\\\"button\\\", { name }) ?? screen.queryByRole(\\\"menuitem\\\", { name });\\n  if (!find() && row) {\\n    const cb = within(row as HTMLElement).queryByRole(\\\"checkbox\\\");\\n    if (cb) await u.click(cb);\\n  }\\n  if (!find() && row) {\\n    const more = within(row as HTMLElement).queryByRole(\\\"button\\\", { name: /more|actions/i });\\n    if (more) await u.click(more);\\n  }\\n  return waitFor(() => {\\n    const el = find();\\n    expect(el, `no action ${name}`).toBeTruthy();\\n    return el as HTMLElement;\\n  });\\n}\\n\\n// ---------- S-2 data ----------\\nconst LOT: LotSummary = {\\n  lotId: 41, lotName: \\\"L-7741\\\", headCount: 22, breed: \\\"Angus\\\", sex: \\\"Steer\\\", penName: \\\"P-17\\\", rationName: \\\"Grower Mix 14G\\\",\\n  feedConsumedLb: 9000, startingWeightLb: 800, currentWeightLb: 1000, adgLbPerDay: 1.5, fcr: 9, costOfGainPerLb: 0.5,\\n};\\nconst PEN: PenSummary = {\\n  penId: 17, penName: \\\"P-17\\\", animalCount: 22, capacity: 40, rationName: \\\"Grower Mix 14G\\\", dailyBunkRateLbPerHead: 24,\\n  plannedFeedLb: 528, actualFeedLb: 528, currentWeightLb: 1000, adgLbPerDay: 1.5,\\n};\\nconst M = (o: Partial<LotMetrics> = {}): LotMetrics => ({\\n  daysOnFeed: 90, totalWeightGainLb: 150, averageDailyGainLbPerDay: 1.66, totalFeedConsumedLb: 5000, feedConversionRatio: 33.3,\\n  feedCostPerGainUsdPerLb: 0.5, projectedShipDate: null, suggestions: [], ...o,\\n});\\nconst W = (o: Partial<WeightRecord>): WeightRecord => ({\\n  weightId: 1, lotId: LOT.lotId, lotName: LOT.lotName, measurementDate: \\\"2025-12-23\\\", animalsWeighed: 20, averageWeightLb: 900,\\n  totalMeasuredWeightLb: 18000, weightGainSincePriorLb: 0, notes: \\\"\\\", status: \\\"Current\\\", createdBy: \\\"ops\\\",\\n  createdAt: \\\"2026-01-01T10:00:00Z\\\", lastChangedBy: \\\"ops\\\", lastChangedAt: \\\"2026-01-01T10:00:00Z\\\", ...o,\\n});\\ninterface YardStore { weights: WeightRecord[]; metrics: LotMetrics; posts: unknown[] }\\nconst yardResponse = (weights: WeightRecord[]): YardResponse => ({\\n  purchaseOrders: [{\\n    recordId: 1, purchaseOrderNumber: \\\"PO-5501\\\", lineNumber: 1, receiptNumber: \\\"RC-900