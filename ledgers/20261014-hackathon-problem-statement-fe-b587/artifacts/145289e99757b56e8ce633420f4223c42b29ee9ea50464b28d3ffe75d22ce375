ame: `Pen ${id}`, animalCount: 260 })),\\n    })),\\n  );\\n}\\nasync function recordFeeding(u: U) {\\n  await u.click((await screen.findAllByRole(\\\"button\\\", { name: /feeding entry/i }))[0]);\\n  const dlg = await screen.findByRole(\\\"dialog\\\");\\n  await choose(u, dlg, /saved plan/i, /Pen 14/);\\n  await fill(u, await within(dlg).findByLabelText(/delivered quantity/i), \\\"6075\\\");\\n  const alloc = within(dlg).queryByLabelText(/actual lot allocation/i);\\n  if (alloc) await fill(u, alloc, \\\"Lot 14-A: 6,075 lb\\\");\\n  await u.click(within(dlg).getByRole(\\\"button\\\", { name: /save actual feeding/i }));\\n  await waitFor(() => expect(shows(/6,?075/)).toBe(true));\\n  if (screen.queryByRole(\\\"dialog\\\")) {\\n    await u.keyboard(\\\"{Escape}\\\");\\n    await waitFor(() => expect(screen.queryByRole(\\\"dialog\\\")).toBeNull());\\n  }\\n}\\nconst VARIANCE = /[−–-]\\\\s?285(?!\\\\d)|285\\\\s*(lb\\\\s*)?(under|short|below)/i;\\nconst eventRow = () => rowWith(num(6360), num(6075), VARIANCE);\\n\\n// ---------- tests ----------\\ndescribe(\\\"part 3: feeding plan, weights, lot performance\\\", () => {\\n  it(\\\"AC_17_1_FeedingRowShowsPlannedActualVarianceAndAdjustAction\\\", async () => {\\n    const u = userEvent.setup();\\n    const feed: FeedStore = { available: 100000, posts: [] };\\n    installFeed(feed, [msw.getCreateFeedingEventMockHandler(() => ({ event: event(), message: \\\"Feeding saved.\\\" }))]);\\n    render(<FeedManagementContainer />);\\n    await recordFeeding(u);\\n    const row = await waitFor(() => {\\n      const r = eventRow();\\n      expect(r, \\\"no feeding row with plan, actual and variance\\\").toBeTruthy();\\n      return r as Element;\\n    });\\n    const text = rowText(row);\\n    expect(text).toMatch(num(6360));\\n    expect(text).toMatch(num(6075));\\n    expect(text).toMatch(VARIANCE);\\n    expect(await actionButton(u, /adjust future plan/i, row)).toBeTruthy();\\n  });\\n\\n  it(\\\"AC_17_2_AdjustFormShowsEditableQuan