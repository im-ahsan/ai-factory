ainer />);\\n    await recordFeeding(u);\\n    const row = await waitFor(() => {\\n      const r = eventRow();\\n      expect(r, \\\"no feeding row\\\").toBeTruthy();\\n      return r as Element;\\n    });\\n    await u.click(await actionButton(u, /adjust future plan/i, row));\\n    const dialog = await screen.findByRole(\\\"dialog\\\").catch(() => null);\\n    const scope = (dialog ?? document.body) as HTMLElement;\\n    const quantityName = /quantity|rate|allocation|\\\\blb\\\\b|per (head|animal)/i;\\n    const isEditable = (f: Element) => !(f as HTMLInputElement).disabled && !(f as HTMLInputElement).readOnly;\\n    const fields = await waitFor(() => {\\n      const found = [\\n        ...within(scope).queryAllByRole(\\\"spinbutton\\\", { name: quantityName }),\\n        ...within(scope).queryAllByRole(\\\"textbox\\\", { name: quantityName }),\\n      ].filter(isEditable) as HTMLInputElement[];\\n      expect(found.length, \\\"no editable future plan quantity field\\\").toBeGreaterThan(0);\\n      return found;\\n    });\\n    const planned = fields.find((f) => num(6360).test(f.value) || num(24).test(f.value));\\n    expect(planned, `no quantity field shows the plan's 6,360 lb or 24 lb per animal: ${fields.map((f) => f.value).join(\\\" / \\\")}`).toBeTruthy();\\n    const visible = visibleText(scope);\\n    expect(visible).toContain(\\\"Pen 14\\\");\\n    expect(visible).toContain(\\\"Grower Mix 14G\\\");\\n    if (dialog) expect(visible).not.toMatch(/Pen 12|Pen 18|Finisher 850|Transition Blend/);\\n    await fill(u, planned as HTMLInputElement, \\\"5900\\\");\\n    expect((planned as HTMLInputElement).value).toContain(\\\"5900\\\");\\n    expect(visibleText(scope)).toContain(\\\"Pen 14\\\");\\n  });\\n\\n  it(\\\"AC_18_1_TotalIsAverageTimesCountWithNoTotalField\\\", async () => {\\n    const u = userEvent.setup();\\n    installYard({ weights: weightHistoryStore().weights, metrics: M(), posts: [] });\\n    render(<ProcurementLotRecordsContainer />);\\n    const av