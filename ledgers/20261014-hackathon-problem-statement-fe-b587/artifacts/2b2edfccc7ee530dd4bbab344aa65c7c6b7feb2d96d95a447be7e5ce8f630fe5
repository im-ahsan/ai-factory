{"ts":1792011955701,"kind":"call","tool":"Write","input":"{\"file_path\":\"/work/tests/acceptance.part3.test.tsx\",\"content\":\"// @vitest-environment jsdom\\nimport { afterAll, afterEach, beforeAll, describe, expect, it, vi } from \\\"vitest\\\";\\nimport { fireEvent, render, screen, waitFor, within } from \\\"@testing-library/react\\\";\\nimport userEvent from \\\"@testing-library/user-event\\\";\\nimport { setupServer } from \\\"msw/node\\\";\\nimport { at, TEST_NOW } from \\\"./support/screen\\\";\\nimport {\\n  getCreateWeightRecordMockHandler,\\n  getEditWeightRecordMockHandler,\\n  getFeedlotWorkspaceAPIMock,\\n  getGetFeedWorkspaceMockHandler,\\n  getGetYardRecordsMockHandler,\\n  getVoidFeedingEventMockHandler,\\n  getVoidWeightRecordMockHandler,\\n} from \\\"@/lib/api/client.msw\\\";\\nimport type {\\n  FeedingEvent,\\n  FeedingPlan,\\n  FeedResponse,\\n  InventoryItem,\\n  LotPerformance,\\n  Ration,\\n  WeightMutationResponse,\\n  WeightRecord,\\n  YardResponse,\\n} from \\\"@/lib/api/client.schemas\\\";\\nimport { ProcurementLotRecordsContainer } from \\\"@/components/screens/s-2/container\\\";\\nimport { FeedManagementContainer } from \\\"@/components/screens/s-3/container\\\";\\n\\nconst server = setupServer(...getFeedlotWorkspaceAPIMock());\\nbeforeAll(() => server.listen({ onUnhandledRequest: \\\"error\\\" }));\\nafterEach(() => {\\n  server.resetHandlers();\\n  vi.unstubAllGlobals();\\n  vi.restoreAllMocks();\\n});\\nafterAll(() => server.close());\\n\\n// ---------- helpers ----------\\nconst iso = (daysAgo: number) => new Date(TEST_NOW.getTime() - daysAgo * 86400000).toISOString().slice(0, 10);\\nconst esc = (s: string) => s.replace(/[.*+?^${}()|[\\\\]\\\\\\\\]/g, \\\"\\\\\\\\$&\\\");\\nconst MON = [\\\"Jan\\\", \\\"Feb\\\", \\\"Mar\\\", \\\"Apr\\\", \\\"May\\\", \\\"Jun\\\", \\\"Jul\\\", \\\"Aug\\\", \\\"Sep\\\", \\\"Oct\\\", \\\"Nov\\\", \\\"Dec\\\"];\\n\\nfunction numRe(n: number | string): RegExp {\\n  const [i, f] = String(n).split(\\\".\\\");\\n  const ip = i.replace(/\\\\B(?=(\\\\d{3})+(?!\\\\d))/g, \\\",?\\\");\\n  return new RegExp(`(?<![\\\\\\\\d.,])${ip}${f ? `\\\\\\\\.${f}` : \\\"\\\"}(?!\\\\\\\\d)`);\\n}\\n\\nfunction dateRe(isoDate: string): RegExp {\\n  const [, m, d] = isoDate.split(\\\"-\\\").map(Number);\\n  const M = MON[m - 1];\\n  const mm = String(m).padStart(2, \\\"0\\\");\\n  const dd = String(d).padStart(2, \\\"0\\\");\\n  return new RegExp(`${isoDate}|\\\\\\\\b${d} ${M}|${M}[a-z]* ${d}\\\\\\\\b|${mm}/${dd}|\\\\\\\\b${m}/${d}\\\\\\\\b`);\\n}\\n\\nfunction pageText(): string {\\n  const values = Array.from(document.querySelectorAll(\\\"input,textarea,select\\\")).map((e) => (e as HTMLInputElement).value ?? \\\"\\\");\\n  return `${document.body.textContent ?? \\\"\\\"} ${values.join(\\\" \\\")}`;\\n}\\n\\nfunction expectShown(...nums: Array<number | string>) {\\n  for (const n of nums) expect(pageText(), `expected ${n} on the page`).toMatch(numRe(n));\\n}\\n\\nfunction rowWith(re: RegExp): HTMLElement {\\n  const rows = Array.from(document.querySelectorAll<HTMLElement>(\\\"tr,[role='row']\\\")).filter((r) => re.test(r.textContent ?? \\\"\\\"));\\n  if (!rows.length) throw new Error(`no row matching ${re}`);\\n  return rows[rows.length - 1];\\n}\\n\\nfunction noteCell(note: string): HTMLElement {\\n  const hits = screen.getAllByText(new RegExp(esc(note))).filter((e) => ![\\\"TEXTAREA\\\", \\\"INPUT\\\"].includes(e.tagName));\\n  return hits[0];\\n}\\n\\nfunction weight(over: Partial<WeightRecord> & { id: number }): WeightRecord {\\n  return {\\n    lotId: 2408, lotName: \\\"L-2408\\\", penName: \\\"P06\\\", measuredAt: iso(60), animalsWeighed: 9, averageWeightLb: 1077,\\n    totalWeightLb: 9693, gainSincePreviousLb: 0, notes: \\\"Baseline weigh-in\\\", status: \\\"Current\\\", createdBy: \\\"operator-1\\\",\\n    createdAt: `${iso(60)}T09:00:00Z`, lastChangedBy: \\\"operator-1\\\", lastChangedAt: `${iso(60)}T09:00:00Z`, ...over,\\n  };\\n}\\n\\nfunction perf(over: Partial<LotPerformance> = {}): LotPerformance {\\n  return {\\n    lotId: 2408, lotName: \\\"L-2408\\\", daysOnFeed: 142, totalWeightGainLb: 328, adgLbPerDay: 2.31, totalFeedConsumedLb: 829736,\\n    feedConversionRatio: 6.14, feedCostPerGain: 1.06, projectedShipDate: iso(-40), suggestion: \\\"Hold the current ration; reassess the ship window.\\\", ...over,\\n  };\\n}\\n\\nfunction yardData(over: Partial<YardResponse> = {}): YardResponse {\\n  return {\\n    imports: [{\\n      id: 7710, poNumber: \\\"PO-7710\\\", poLine: \\\"01\\\", receiptId: \\\"RCV-5521\\\", sourceId: \\\"src-7710-01\\\", status: \\\"Synced\\\", vendor: \\\"Prairie Cattle Co\\\",\\n      unitCost: 389, currency: \\\"USD\\\", headCount: 31, averageWeightLb: 1043, breed: \\\"Angus\\\", ageMonths: 15, source: \\\"Mock procurement adapter\\\",\\n      lotId: 2408, lotName: \\\"L-2408\\\", penId: 6, penName: \\\"P06\\\", existingMapping: \\\"L-2408 to P06\\\", targetWeightLb: 1390, targetSource: \\\"lot\\\",\\n      adgLbPerDay: 3.4, projectedShipDate: null, reviewRequired: false,\\n    }],\\n    lots: [{ id: 2408, name: \\\"L-2408\\\", penId: 6, penName: \\\"P06\\\", headCount: 412, targetWeightLb: 1425, targetSource: \\\"lot\\\", adgLbPerDay: 3.4, breed: \\\"Angus\\\", sex: \\\"Steer\\\", receivingDate: iso(142) }],\\n    pens: [{ id: 6, name: \\\"P06\\\", capacity: 480, currentAnimalCount: 412, lotIds: [2408] }],\\n    selectedPerformance: perf(),\\n    weights: [weight({ id: 9100 })],\\n    yardTargetWeightLb: 1410,\\n    currency: \\\"USD\\\",\\n    ...over,\\n  };\\n}\\n\\nconst REVISED = { daysOnFeed: 131, totalWeightGainLb: 377, adgLbPerDay: 2.87, feedConversionRatio: 7.31, feedCostPerGain: 1.77, projectedShipDate: iso(-30) };\\n\\nfunction openYard() {\\n  at(\\\"/yard\\\");\\n  render(<ProcurementLotRecordsContainer />);\\n}\\n\\nasync function chooseLot(user: ReturnType<typeof userEvent.setup>, scope: HTMLElement | Document, name: string) {\\n  const q = within(scope as HTMLElement);\\n  const el = q.getByLabelText(\\\"Lot\\\");\\n  if (el.tagName === \\\"SELECT\\\") {\\n    await user.selectOptions(el, within(el).getByRole(\\\"option\\\", { name: new RegExp(esc(name)) }));\\n  } else {\\n    await user.click(el);\\n    await user.click(await screen.findByRole(\\\"option\\\", { name: new RegExp(esc(name)) }));\\n  }\\n}\\n\\nasync function typeInto(user: ReturnType<typeof userEvent.setup>, el: HTMLElement, value: string) {\\n  await user.clear(el);\\n  await user.type(el, value);\\n}\\n\\nasync function fillWeightForm(\\n  user: ReturnType<typeof userEvent.setup>,\\n  v: { lot?: string; date?: string; count: number; avg: number; notes?: string },\\n  scope: HTMLElement | Document = document,\\n) {\\n  const q = within(scope as HTMLElement);\\n  if (v.lot) await chooseLot(user, scope, v.lot);\\n  if (v.date) fireEvent.change(q.getByLabelText(\\\"Measurement date\\\"), { target: { value: v.date } });\\n  await typeInto(user, q.getByLabelText(\\\"Average animal weight\\\"), String(v.avg));\\n  await typeInto(user, q.getByLabelText(\\\"Animals weighed\\\"), String(v.count));\\n  if (v.notes) await typeInto(user, q.getByLabelText(\\\"Notes\\\"), v.notes);\\n}\\n\\nasync function rowAction(user: ReturnType<typeof userEvent.setup>, row: HTMLElement, name: string) {\\n  const inRow = within(row).queryAllByRole(\\\"button\\\", { name })[0];\\n  if (inRow) return user.click(inRow);\\n  const more = within(row).queryAllByRole(\\\"button\\\", { name: /more/i })[0];\\n  if (more) {\\n    await user.click(more);\\n    return user.click(await screen.findByRole(\\\"menuitem\\\", { name }));\\n  }\\n  await user.click(row);\\n  const global = screen.queryAllByRole(\\\"button\\\", { name })[0];\\n  if (!global) throw new Error(`no action ${name}`);\\n  return user.click(global);\\n}\\n\\nasync function confirmIfAsked(user: ReturnType<typeof userEvent.setup>, reason: string) {\\n  await new Promise((r) => setTimeout(r, 60));\\n  const dlg = screen.queryByRole(\\\"alertdialog\\\") ?? screen.queryByRole(\\\"dialog\\\");\\n  if (!dlg) return;\\n  const box = within(dlg).queryAllByRole(\\\"textbox\\\")[0];\\n  if (box && !(box as HTMLInputElement).value) await user.type(box, reason);\\n  const ok = within(dlg).getAllByRole(\\\"button\\\").find((b) => /void|confirm|yes/i.test(b.textContent ?? \\\"\\\"));\\n  if (ok) await user.click(ok);\\n}\\n\\nfunction mutation(record: WeightRecord, suggestions: string[]): WeightMutationResponse {\\n  return { record, historyCount: 3, revisedMetrics: REVISED, suggestions };\\n}\\n\\n// ---------- S-3 data ----------\\nfunction inv(id: number, name: string, available: number): InventoryItem {\\n  return {\\n    id, name, category: \\\"Roughage\\\", availableQuantityLb: available, unitOfMeasure: \\\"lb\\\", unitCostPerTon: 310, unitCostPerLb: 0.155,\\n    dryMatterPercent: 35, energyMcalPerLb: 0.62, storageLocation: \\\"Bunker 3\\\", openingStockLb: 60000, receivedStockLb: 0, consumedStockLb: 11700, closingStockLb: available,\\n  };\\n}\\n\\nconst RATION: Ration = {\\n  id: 3, name: \\\"Finisher Mix B\\\", type: \\\"Finishing\\\", ingredientProportionsAsFed: [{ ingredientId: 1, ingredientName: \\\"Corn silage\\\", proportionPercent: 100, quantityLb: 6200 }],\\n  dryMatterPercent: 62, energyMcalPerLb: 1.2, intendedWeightRange: \\\"1100-1400 lb\\\", costPerLb: 0.172, adgLbPerDay: 3.1, costOfGain: 1.3,\\n};\\n\\nfunction plan(over: Partial<FeedingPlan> & { id: number }): FeedingPlan {\\n  return {\\n    penId: 22, penName: \\\"Pen 22\\\", rationId: 3, rationName: \\\"Finisher Mix B\\\", date: iso(1), plannedTime: \\\"07:00\\\", animalCount: 400, perAnimalRateLb: 15.5,\\n    plannedQuantityLb: 6200, cost: 1066, expectedEnergyMcal: 7440, status: \\\"Completed\\\", allocationTotalLb: 6200, allocationDifferenceLb: 0, allocationReconciled: true,\\n    lotAllocations: [{ lotId: 2408, lotName: \\\"L-2408\\\", quantityLb: 6200 }], ...over,\\n  };\\n}\\n\\nfunction event(over: Partial<FeedingEvent> = {}): FeedingEvent {\\n  return {\\n    id: 31, planId: 51, penName: \\\"Pen 22\\\", rationName: \\\"Finisher Mix B\\\", plannedQuantityLb: 6200, actualDeliveredQuantityLb: 5750, varianceLb: -450,\\n    feedCost: 989.1, energyMcalPerLb: 1.2, energyMcal: 6900, inventoryDecrementLb: 5750, wastageAdjustedEstimatedConsumptionLb: 6009,\\n    unitCostSnapshots: [{ ingredientId: 1, ingredientName: \\\"Corn silage\\\", quantityLb: 5750, unitCostPerLb: 0.172 }],\\n    lotAllocations: [{ lotId: 2408, lotName: \\\"L-2408\\\", quantityLb: 5750 }], status: \\\"Variance\\\", savedAt: `${iso(1)}T08:00:00Z`, createdBy: \\\"operator-1\\\",\\n    lastChangedBy: \\\"operator-1\\\", revisedMetrics: { adgLbPerDay: 3.05, feedConversionRatio: 6.9, feedCostPerGain: 1.4 }, suggestions: [], ...over,\\n  };\\n}\\n\\nfunction feedData(over: Partial<FeedResponse> = {}): FeedResponse {\\n  return {\\n    currency: \\\"USD\\\", wastageRatio: 0.045, inventory: [inv(1, \\\"Corn silage\\\", 48300)], forecasts: [], rations: [RATION],\\n    plans: [plan({ id: 51 }), plan({ id: 52, date: iso(-1), plannedQuantityLb: 6400, perAnimalRateLb: 16, cost: 1100, expectedEnergyMcal: 7680, status: \\\"Planned\\\", allocationTotalLb: 6400, lotAllocations: [{ lotId: 2408, lotName: \\\"L-2408\\\", quantityLb: 6400 }] })],\\n    events: [event()], ...over,\\n  };\\n}\\n\\nfunction openFeed() {\\n  at(\\\"/feed\\\");\\n  render(<FeedManagementContainer />);\\n}\\n\\nasync function adjustAction(user: ReturnType<typeof userEvent.setup>): Promise<HTMLElement> {\\n  const direct = () => [...screen.queryAllByRole(\\\"button\\\", { name: \\\"Adjust future plan\\\" }), ...screen.queryAllByRole(\\\"menuitem\\\", { name: \\\"Adjust future plan\\\" })];\\n  if (direct().length) return direct()[0];\\n  const row = rowWith(numRe(5750));\\n  await user.click(within(row).getAllByRole(\\\"button\\\", { name: /more/i })[0]);\\n  return screen.findByRole(\\\"menuitem\\\", { name: \\\"Adjust future plan\\\" });\\n}\\n\\n// ---------- tests ----------\\ndescribe(\\\"part 3: feeding plan, weights, performance, corrections\\\", () => {\\n  it(\\\"AC_17_1_ShowsPlannedActualVarianceAndAdjustAction\\\", async () => {\\n    server.use(getGetFeedWorkspaceMockHandler(() => feedData()));\\n    const user = userEvent.setup();\\n    openFeed();\\n    await waitFor(() => expect(() => rowWith(numRe(5750))).not.toThrow(), { timeout: 3000 });\\n    const row = rowWith(numRe(5750));\\n    expect(row.textContent).toMatch(/Pen 22/);\\n    expect(row.textContent).toMatch(numRe(6200));\\n    expect(row.textContent).toMatch(numRe(5750));\\n    expect(row.textContent).toMatch(numRe(450));\\n    const action = await adjustAction(user);\\n    expect(action).toBeTruthy();\\n  });\\n\\n  it(\\\"AC_17_2_AdjustFormShowsEditableFutureQuantitiesPenAndRation\\\", async () => {\\n    server.use(getGetFeedWorkspaceMockHandler(() => feedData()));\\n    const user = userEvent.setup();\\n    openFeed();\\n    await waitFor(() => expect(() => rowWith(numRe(5750))).not.toThrow(), { timeout: 3000 });\\n    const action = await adjustAction(user);\\n    await user.click(action);\\n    const dlg = await screen.findByRole(\\\"dialog\\\", undefined, { timeout: 3000 });\\n    const editable = within(dlg).queryAllByRole(\\\"spinbutton\\\").concat(within(dlg).queryAllByRole(\\\"textbox\\\")).filter((e) => {\\n      const i = e as HTMLInputElement;\\n      return !i.readOnly && !i.disabled;\\n    });\\n    expect(editable.length).toBeGreaterThan(0);\\n    const values = editable.map((e) => (e as HTMLInputElement).value.replace(/,/g, \\\"\\\"));\\n    expect(values.some((v) => v === \\\"6400\\\" || v === \\\"16\\\" || v === \\\"16.0\\\")).toBe(true);\\n    const selects = Array.from(dlg.querySelectorAll(\\\"select\\\")).map((s) => s.selectedOptions[0]?.textContent ?? \\\"\\\");\\n    const shown = `${dlg.textContent} ${selects.join(\\\" \\\")} ${Array.from(dlg.querySelectorAll(\\\"input\\\")).map((i) => i.value).join(\\\" \\\")}`;\\n    expect(shown).toMatch(/Pen 22/);\\n    expect(shown).toMatch(/Finisher Mix B/);\\n  });\\n\\n  it(\\\"AC_18_1_TotalWeightIsAverageTimesCountAndNotEditable\\\", async () => {\\n    server.use(getGetYardRecordsMockHandler(() => yardData()));\\n    const user = userEvent.setup();\\n    openYard();\\n    await screen.findByLabelText(\\\"Average animal weight\\\", undefined, { timeout: 3000 });\\n    await typeInto(user, screen.getByLabelText(\\\"Average animal weight\\\"), \\\"612\\\");\\n    await typeInto(user, screen.getByLabelText(\\\"Animals weighed\\\"), \\\"17\\\");\\n    await waitFor(() => expect(pageText()).toMatch(numRe(10404)));\\n    await typeInto(user, screen.getByLabelText(\\\"Animals weighed\\\"), \\\"19\\\");\\n    await waitFor(() => expect(pageText()).toMatch(numRe(11628)));\\n    expect(pageText()).not.toMatch(numRe(10404));\\n    const totalFields = [...screen.queryAllByRole(\\\"spinbutton\\\", { name: /total/i }), ...screen.queryAllByRole(\\\"textbox\\\", { name: /total/i })];\\n    for (const f of totalFields) {\\n      const i = f as HTMLInputElement;\\n      expect(i.readOnly || i.disabled || i.getAttribute(\\\"aria-readonly\\\") === \\\"true\\\").toBe(true);\\n    }\\n  });\\n\\n  it(\\\"AC_18_2_FiveHundredByTwentyShowsTenThousandAndSavedRecordInHistory\\\", async () => {\\n    const date = iso(0);\\n    const saved = weight({\\n      id: 9101, measuredAt: date, animalsWeighed: 20, averageWeightLb: 500, totalWeightLb: 10000, gainSincePreviousLb: 61, notes: \\\"Pen sort reweigh 4417\\\",\\n    });\\n    let done = false;\\n    const bodies: unknown[] = [];\\n    server.use(\\n      getGetYardRecordsMockHandler(() => yardData({ weights: done ? [weight({ id: 9100 }), saved] : [weight({ id: 9100 })] })),\\n      getCreateWeightRecordMockHandler(async (info) => {\\n        bodies.push(await info.request.clone().json());\\n        done = true;\\n        return mutation(saved, []);\\n      }),\\n    );\\n    const user = userEvent.setup();\\n    openYard();\\n    await screen.findByLabelText(\\\"Average animal weight\\\", undefined, { timeout: 3000 });\\n    await fillWeightForm(user, { lot: \\\"L-2408\\\", date, count: 20, avg: 500, notes: \\\"Pen sort reweigh 4417\\\" });\\n    await waitFor(() => expect(pageText()).toMatch(numRe(10000)));\\n    await user.click(screen.getByRole(\\\"button\\\", { name: \\\"Save weight\\\" }));\\n    await waitFor(() => expect(() => noteCell(\\\"Pen sort reweigh 4417\\\")).not.toThrow(), { timeout: 3000 });\\n    const row = rowWith(/Pen sort reweigh 4417/);\\n    expect(row.textContent).toMatch(numRe(20));\\n    expect(row.textContent).toMatch(numRe(10000));\\n    expect(row.textContent).toMatch(numRe(61));\\n    expect(bodies).toHaveLength(1);\\n    expect(bodies[0]).toMatchObject({ lotId: 2408, animalsWeighed: 20, averageWeightLb: 500, measuredAt: date });\\n  });\\n\\n  it(\\\"AC_19_1_WeightHistoryIsTimeOrderedWithAllFields\\\", async () => {\\n    const a = weight({ id: 9301, measuredAt: iso(40), animalsWeighed: 14, averageWeightLb: 1012, totalWeightLb: 14168, gainSincePreviousLb: 0, notes: \\\"Alpha intake weigh 8801\\\" });\\n    const b = weight({ id: 9302, measuredAt: iso(25), animalsWeighed: 16, averageWeightLb: 1068, totalWeightLb: 17088, gainSincePreviousLb: 56, notes: \\\"Bravo mid weigh 8802\\\" });\\n    const c = weight({ id: 9303, measuredAt: iso(10), animalsWeighed: 18, averageWeightLb: 1131, totalWeightLb: 20358, gainSincePreviousLb: 63, notes: \\\"Charlie recent weigh 8803\\\" });\\n    server.use(getGetYardRecordsMockHandler(() => yardData({ weights: [b, c, a] })));\\n    openYard();\\n    await waitFor(() => expect(() => noteCell(\\\"Charlie recent weigh 8803\\\")).not.toThrow(), { timeout: 3000 });\\n    for (const r of [a, b, c]) {\\n      const row = rowWith(new RegExp(esc(r.notes)));\\n      expect(row.textContent).toMatch(dateRe(r.measuredAt));\\n      expect(row.textContent).toMatch(numRe(r.animalsWeighed));\\n      expect(row.textContent).toMatch(numRe(r.averageWeightLb));\\n      expect(row.textContent).toMatch(numRe(r.totalWeightLb));\\n      if (r.gainSincePreviousLb) expect(row.textContent).toMatch(numRe(r.gainSincePreviousLb));\\n    }\\n    const pos = [a, b, c].map((r) => noteCell(r.notes));\\n    const follows = (x: HTMLElement, y: HTMLElement) => Boolean(x.compareDocumentPosition(y) & Node.DOCUMENT_POSITION_FOLLOWING);\\n    const ascending = follows(pos[0], pos[1]) && follows(pos[1], pos[2]);\\n    const descending = follows(pos[2], pos[1]) && follows(pos[1], pos[0]);\\n    expect(ascending || descending).toBe(true);\\n  });\\n\\n  it(\\\"AC_20_1_EditWeightShowsReturnedMetricsAndKeepsOriginalInHistory\\\", async () => {\\n    const original = weight({ id: 9201, measuredAt: iso(30), animalsWeighed: 20, averageWeightLb: 1195, totalWeightLb: 23900, gainSincePreviousLb: 48, notes: \\\"Original scale ticket 7731\\\" });\\n    const revised = weight({\\n      id: 9202, measuredAt: iso(30), animalsWeighed: 20, averageWeightLb: 1210, totalWeightLb: 24200, gainSincePreviousLb: 53, notes: \\\"Corrected after reweigh 7731\\\", status: \\\"Revised\\\",\\n    });\\n    let done = false;\\n    const params: unknown[] = [];\\n    server.use(\\n      getGetYardRecordsMockHandler(() => (done\\n        ? yardData({ weights: [{ ...original, status: \\\"Superseded\\\" }, revised], selectedPerformance: perf(REVISED) })\\n        : yardData({ weights: [original] }))),\\n      getEditWeightRecordMockHandler(async (info) => {\\n        params.push(info.params.recordId);\\n        done = true;\\n        return mutation(revised, [\\\"Review the updated weight trend before adjusting the ship window.\\\"]);\\n      }),\\n    );\\n    const user = userEvent.setup();\\n    openYard();\\n    await waitFor(() => expect(() => noteCell(\\\"Original scale ticket 7731\\\")).not.toThrow(), { timeout: 3000 });\\n    await rowAction(user, rowWith(/Original scale ticket 7731/), \\\"Edit record\\\");\\n    const sheet = await screen.findByRole(\\\"dialog\\\", undefined, { time