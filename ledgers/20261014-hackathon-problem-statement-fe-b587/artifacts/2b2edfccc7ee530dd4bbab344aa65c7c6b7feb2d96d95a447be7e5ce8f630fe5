 {}): FeedResponse {\\n  return {\\n    currency: \\\"USD\\\", wastageRatio: 0.045, inventory: [inv(1, \\\"Corn silage\\\", 48300)], forecasts: [], rations: [RATION],\\n    plans: [plan({ id: 51 }), plan({ id: 52, date: iso(-1), plannedQuantityLb: 6400, perAnimalRateLb: 16, cost: 1100, expectedEnergyMcal: 7680, status: \\\"Planned\\\", allocationTotalLb: 6400, lotAllocations: [{ lotId: 2408, lotName: \\\"L-2408\\\", quantityLb: 6400 }] })],\\n    events: [event()], ...over,\\n  };\\n}\\n\\nfunction openFeed() {\\n  at(\\\"/feed\\\");\\n  render(<FeedManagementContainer />);\\n}\\n\\nasync function adjustAction(user: ReturnType<typeof userEvent.setup>): Promise<HTMLElement> {\\n  const direct = () => [...screen.queryAllByRole(\\\"button\\\", { name: \\\"Adjust future plan\\\" }), ...screen.queryAllByRole(\\\"menuitem\\\", { name: \\\"Adjust future plan\\\" })];\\n  if (direct().length) return direct()[0];\\n  const row = rowWith(numRe(5750));\\n  await user.click(within(row).getAllByRole(\\\"button\\\", { name: /more/i })[0]);\\n  return screen.findByRole(\\\"menuitem\\\", { name: \\\"Adjust future plan\\\" });\\n}\\n\\n// ---------- tests ----------\\ndescribe(\\\"part 3: feeding plan, weights, performance, corrections\\\", () => {\\n  it(\\\"AC_17_1_ShowsPlannedActualVarianceAndAdjustAction\\\", async () => {\\n    server.use(getGetFeedWorkspaceMockHandler(() => feedData()));\\n    const user = userEvent.setup();\\n    openFeed();\\n    await waitFor(() => expect(() => rowWith(numRe(5750))).not.toThrow(), { timeout: 3000 });\\n    const row = rowWith(numRe(5750));\\n    expect(row.textContent).toMatch(/Pen 22/);\\n    expect(row.textContent).toMatch(numRe(6200));\\n    expect(row.textContent).toMatch(numRe(5750));\\n    expect(row.textContent).toMatch(numRe(450));\\n    const action = await adjustAction(user);\\n    expect(action).toBeTruthy();\\n  });\\n\\n  it(\\\"AC_17_2_AdjustFormShowsEditableFutureQuantitiesPenAndRation\\\", async () => {\\n    server.use(getG