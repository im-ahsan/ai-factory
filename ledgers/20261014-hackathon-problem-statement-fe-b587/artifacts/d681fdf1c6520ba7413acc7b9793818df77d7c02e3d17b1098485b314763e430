{"ts":1792013353327,"kind":"call","tool":"Bash","input":"{\"command\":\"cat /work/components/ui/date-picker.tsx | head -60\"}","output":"{\"stdout\":\"\\\"use client\\\";\\n// A date (or a start and an end) picked from a calendar; the field shows it as text.\\nimport { CalendarDays } from \\\"lucide-react\\\";\\nimport { useState } from \\\"react\\\";\\nimport type { DateRange } from \\\"react-day-picker\\\";\\nimport { Calendar } from \\\"./calendar\\\";\\nimport { Popover, PopoverContent, PopoverTrigger } from \\\"./popover\\\";\\n\\nconst fmt = (d?: Date) => (d ? d.toLocaleDateString(undefined, { day: \\\"numeric\\\", month: \\\"short\\\", year: \\\"numeric\\\" }) : \\\"\\\");\\nconst parse = (s?: string) => { const d = s ? new Date(s) : undefined; return d && !Number.isNaN(d.getTime()) ? d : undefined; };\\n\\nexport function DatePicker({ value, placeholder, range = false, disabled, id }: { value?: string; placeholder?: string; range?: boolean; disabled?: boolean; id?: string }) {\\n  const [from, to] = (value ?? \\\"\\\").split(/\\\\s+-\\\\s+/);\\n  const [day, setDay] = useState<Date | undefined>(parse(from));\\n  const [span, setSpan] = useState<DateRange | undefined>(range ? { from: parse(from), to: parse(to) } : undefined);\\n  const text = range ? [fmt(span?.from), fmt(span?.to)].filter(Boolean).join(\\\" - \\\") : fmt(day);\\n  return (\\n    <Popover>\\n      <PopoverTrigger asChild disabled={disabled}>\\n        <button id={id} type=\\\"button\\\" className=\\\"flex h-9 w-full items-center justify-between gap-2 rounded-md border border-input bg-card px-3 text-sm shadow-xs outline-none focus-visible:ring-2 focus-visible:ring-ring disabled:opacity-50\\\">\\n          <span className={text ? \\\"\\\" : \\\"text-muted-foreground\\\"}>{text || placeholder || \\\"Pick a date\\\"}</span>\\n          <CalendarDays className=\\\"size-4 opacity-50\\\" />\\n        </button>\\n      </PopoverTrigger>\\n      <PopoverContent className=\\\"w-auto p-0\\\" align=\\\"start\\\">\\n        {range\\n          ? <Calendar mode=\\\"range\\\" selected={span} onSelect={setSpan} defaultMonth={span?.from} />\\n          : <Calendar mode=\\\"single\\\" selected={day} onSelect={setDay} defaultMonth={day} />}\\n      </PopoverContent>\\n    </Popover>\\n  );\\n}\",\"stderr\":\"\",\"interrupted\":false,\"isImage\":false,\"noOutputExpected\":false}","chars":2099}
{"ts":1792013511596,"kind":"call","tool":"Write","input":"{\"file_path\":\"/work/tests/acceptance.part3.test.tsx\",\"content\":\"// @vitest-environment jsdom\\nimport { afterAll, afterEach, beforeAll, describe, expect, it, vi } from \\\"vitest\\\";\\nimport { render, screen, waitFor, within } from \\\"@testing-library/react\\\";\\nimport userEvent from \\\"@testing-library/user-event\\\";\\nimport { setupServer } from \\\"msw/node\\\";\\nimport type { RequestHandler } from \\\"msw\\\";\\nimport { TEST_NOW } from \\\"./support/screen\\\";\\nimport { ProcurementLotRecordsContainer } from \\\"@/components/screens/s-2/container\\\";\\nimport { FeedManagementContainer } from \\\"@/components/screens/s-3/container\\\";\\nimport * as msw from \\\"@/lib/api/client.msw\\\";\\nimport type {\\n  FeedingEvent, FeedingPlan, InventoryItem, LotMetrics, LotSummary, PenSummary, Ration, WeightRecord, YardResponse,\\n} from \\\"@/lib/api/client.schemas\\\";\\n\\n// ---------- server ----------\\nconst server = setupServer();\\nbeforeAll(() => server.listen({ onUnhandledRequest: \\\"bypass\\\" }));\\nafterEach(() => { server.resetHandlers(); vi.unstubAllGlobals(); vi.restoreAllMocks(); });\\nafterAll(() => server.close());\\nconst serve = (...h: RequestHandler[]) => server.use(...h, ...msw.getFeedlotWorkspaceAPIMock());\\n\\n// ---------- text helpers ----------\\nconst num = (n: number) => {\\n  const [i, f] = String(n).split(\\\".\\\");\\n  const grouped = i.replace(/\\\\B(?=(\\\\d{3})+(?!\\\\d))/g, \\\",?\\\");\\n  const tail = f ? `\\\\\\\\.${f}0*` : \\\"(?:\\\\\\\\.0+)?\\\";\\n  return new RegExp(`(?<![\\\\\\\\d.,])${grouped}${tail}(?!\\\\\\\\d|,\\\\\\\\d)`);\\n};\\nconst MONTHS = [\\\"January\\\", \\\"February\\\", \\\"March\\\", \\\"April\\\", \\\"May\\\", \\\"June\\\", \\\"July\\\", \\\"August\\\", \\\"September\\\", \\\"October\\\", \\\"November\\\", \\\"December\\\"];\\nconst dateRe = (iso: string) => {\\n  const [y, m, d] = iso.split(\\\"-\\\").map(Number);\\n  const mn = MONTHS[m - 1].slice(0, 3);\\n  const dd = `0?${d}`;\\n  return new RegExp(`${y}-0?${m}-${dd}\\\\\\\\b|\\\\\\\\b${dd}\\\\\\\\s+${mn}[a-z]*\\\\\\\\.?,?\\\\\\\\s+${y}|${mn}[a-z]*\\\\\\\\.?\\\\\\\\s+${dd}(st|nd|rd|th)?,?\\\\\\\\s+${y}|\\\\\\\\b${dd}/0?${m}/${y}|\\\\\\\\b0?${m}/${dd}/${y}`, \\\"i\\\");\\n};\\nconst shows = (re: RegExp) => {\\n  const leaves = Array.from(document.body.querySelectorAll(\\\"*\\\")).filter((e) => e.children.length === 0).map((e) => e.textContent ?? \\\"\\\");\\n  const values = Array.from(document.body.querySelectorAll(\\\"input,textarea\\\")).map((e) => (e as HTMLInputElement).value);\\n  return [...leaves, ...values].some((t) => re.test(t));\\n};\\nconst rowText = (r: Element) => Array.from(r.querySelectorAll(\\\"td,th,[role=cell],[role=gridcell],[role=columnheader]\\\")).map((c) => c.textContent ?? \\\"\\\").join(\\\" | \\\");\\nconst rowWith = (...res: Array<RegExp | string>) =>\\n  Array.from(document.querySelectorAll(\\\"tr,[role=row]\\\")).find((r) => {\\n    const t = rowText(r);\\n    return res.every((x) => (typeof x === \\\"string\\\" ? t.includes(x) : x.test(t)));\\n  });\\nconst metricNow = (label: RegExp) => {\\n  const els = screen.queryAllByText(label);\\n  const el = els.find((e) => e.tagName === \\\"DT\\\") ?? els[0];\\n  if (!el) return \\\"\\\";\\n  return (el.tagName === \\\"DT\\\" ? el.nextElementSibling : el.parentElement)?.textContent ?? \\\"\\\";\\n};\\n\\n// ---------- interaction helpers ----------\\ntype U = ReturnType<typeof userEvent.setup>;\\nasync function fill(u: U, el: HTMLElement, value: string) {\\n  await u.clear(el);\\n  await u.type(el, value);\\n}\\nasync function choose(u: U, scope: HTMLElement, label: RegExp, option: RegExp) {\\n  const el = await within(scope).findByLabelText(label);\\n  if (el.tagName === \\\"SELECT\\\") {\\n    await u.selectOptions(el, within(el).getByRole(\\\"option\\\", { name: option }));\\n  } else {\\n    await u.click(el);\\n    await u.click(await screen.findByRole(\\\"option\\\", { name: option }));\\n  }\\n}\\nasync function actionButton(u: U, name: RegExp, row?: Element) {\\n  const find = () => screen.queryByRole(\\\"button\\\", { name }) ?? screen.queryByRole(\\\"menuitem\\\", { name });\\n  if (!find() && row) {\\n    const cb = within(row as HTMLElement).queryByRole(\\\"checkbox\\\");\\n    if (cb) await u.click(cb);\\n  }\\n  if (!find() && row) {\\n    const more = within(row as HTMLElement).queryByRole(\\\"button\\\", { name: /more|actions/i });\\n    if (more) await u.click(more);\\n  }\\n  return waitFor(() => {\\n    const el = find();\\n    if (!el) throw new Error(`no action ${name}`);\\n    return el;\\n  });\\n}\\n\\n// ---------- S-2 data ----------\\nconst LOT: LotSummary = {\\n  lotId: 41, lotName: \\\"L-7741\\\", headCount: 22, breed: \\\"Angus\\\", sex: \\\"Steer\\\", penName: \\\"P-17\\\", rationName: \\\"Grower Mix 14G\\\",\\n  feedConsumedLb: 9000, startingWeightLb: 800, currentWeightLb: 1000, adgLbPerDay: 1.5, fcr: 9, costOfGainPerLb: 0.5,\\n};\\nconst PEN: PenSummary = {\\n  penId: 17, penName: \\\"P-17\\\", animalCount: 22, capacity: 40, rationName: \\\"Grower Mix 14G\\\", dailyBunkRateLbPerHead: 24,\\n  plannedFeedLb: 528, actualFeedLb: 528, currentWeightLb: 1000, adgLbPerDay: 1.5,\\n};\\nconst M = (o: Partial<LotMetrics> = {}): LotMetrics => ({\\n  daysOnFeed: 90, totalWeightGainLb: 150, averageDailyGainLbPerDay: 1.66, totalFeedConsumedLb: 5000, feedConversionRatio: 33.3,\\n  feedCostPerGainUsdPerLb: 0.5, projectedShipDate: null, suggestions: [], ...o,\\n});\\nconst W = (o: Partial<WeightRecord>): WeightRecord => ({\\n  weightId: 1, lotId: LOT.lotId, lotName: LOT.lotName, measurementDate: \\\"2025-12-23\\\", animalsWeighed: 20, averageWeightLb: 900,\\n  totalMeasuredWeightLb: 18000, weightGainSincePriorLb: 0, notes: \\\"\\\", status: \\\"Current\\\", createdBy: \\\"ops\\\",\\n  createdAt: \\\"2026-01-01T10:00:00Z\\\", lastChangedBy: \\\"ops\\\", lastChangedAt: \\\"2026-01-01T10:00:00Z\\\", ...o,\\n});\\ninterface YardStore { weights: WeightRecord[]; metrics: LotMetrics; posts: unknown[] }\\nconst yardResponse = (weights: WeightRecord[]): YardResponse => ({\\n  purchaseOrders: [{\\n    recordId: 1, purchaseOrderNumber: \\\"PO-5501\\\", lineNumber: 1, receiptNumber: \\\"RC-9001\\\", vendor: \\\"Hill Cattle\\\", unitCostUsdPerTon: 410,\\n    headCount: 22, averageWeightLb: 800, breed: \\\"Angus\\\", ageMonths: 9, source: \\\"ERP\\\", importStatus: \\\"Synced\\\",\\n    lotId: LOT.lotId, lotName: LOT.lotName, penId: PEN.penId, penName: PEN.penName,\\n  }],\\n  lots: [LOT], pens: [PEN], forecasts: [], weightHistory: weights,\\n});\\nfunction installYard(store: YardStore, extra: RequestHandler[] = []) {\\n  serve(\\n    ...extra,\\n    msw.getGetYardRecordsMockHandler(() => yardResponse(store.weights)),\\n    msw.getGetLotMetricsMockHandler(() => ({ lotId: LOT.lotId, lotName: LOT.lotName, metrics: store.metrics })),\\n    msw.getGetLotWeightHistoryMockHandler(() => ({ lotId: LOT.lotId, records: store.weights })),\\n    msw.getGetOverviewMockHandler(() => ({ ...msw.getGetOverviewResponseMock(), lots: [LOT], pens: [PEN] })),\\n  );\\n}\\nasync function pickLot(u: U, scope: HTMLElement) {\\n  const el = within(scope).queryByLabelText(/^lot$/i);\\n  if (!el) return;\\n  const shown = el.tagName === \\\"SELECT\\\" ? (el as HTMLSelectElement).selectedOptions[0]?.textContent : el.textContent;\\n  if (shown?.includes(LOT.lotName)) return;\\n  await choose(u, scope, /^lot$/i, new RegExp(LOT.lotName));\\n}\\nasync function pickDate(scope: HTMLElement, iso: string) {\\n  const el = within(scope).queryByLabelText(/measurement date/i);\\n  if (el && el.tagName === \\\"INPUT\\\") {\\n    const { fireEvent } = await import(\\\"@testing-library/react\\\");\\n    fireEvent.change(el, { target: { value: iso } });\\n  }\\n}\\nconst weightHistoryStore = (): YardStore => ({\\n  weights: [\\n    W({ weightId: 13, measurementDate: \\\"2025-12-23\\\", animalsWeighed: 22, averageWeightLb: 1031, totalMeasuredWeightLb: 22682, weightGainSincePriorLb: 126, notes: \\\"Mid-feed weigh\\\" }),\\n    W({ weightId: 11, measurementDate: \\\"2025-10-06\\\", animalsWeighed: 18, averageWeightLb: 812, totalMeasuredWeightLb: 14616, weightGainSincePriorLb: 0, notes: \\\"Arrival weigh\\\" }),\\n    W({ weightId: 14, measurementDate: \\\"2026-01-13\\\", animalsWeighed: 21, averageWeightLb: 1148, totalMeasuredWeightLb: 24108, weightGainSincePriorLb: 117, notes: \\\"\\\" }),\\n    W({ weightId: 12, measurementDate: \\\"2025-11-17\\\", animalsWeighed: 24, averageWeightLb: 905, totalMeasuredWeightLb: 21720, weightGainSincePriorLb: 93, notes: \\\"Dry weather check\\\" }),\\n  ],\\n  metrics: M(), posts: [],\\n});\\n\\n// ---------- S-3 data ----------\\nconst plan = (o: Partial<FeedingPlan>): FeedingPlan => ({\\n  planId: 4806, penId: 14, penName: \\\"Pen 14\\\", rationId: 3, rationName: \\\"Grower Mix 14G\\\", feedingDate: \\\"2026-01-14\\\", plannedFeedingTime: \\\"05:45\\\",\\n  animalCount: 260, perAnimalDailyRateLb: 24, plannedQuantityLb: 6240, quantityPerAnimalLb: 24, totalFeedCostUsd: 798.72,\\n  expectedEnergyIntakeMcal: 4243, status: \\\"Planned\\\", allocations: [{ lotId: 41, lotName: \\\"14-A\\\", quantityLb: 6240 }],\\n  allocationReconciled: true, allocationDifferenceLb: 0, ...o,\\n});\\nconst PLANS: FeedingPlan[] = [\\n  plan({}),\\n  plan({ planId: 4802, penId: 12, penName: \\\"Pen 12\\\", rationId: 4, rationName: \\\"Finisher 850\\\", animalCount: 340, plannedQuantityLb: 8160 }),\\n  plan({ planId: 4799, penId: 18, penName: \\\"Pen 18\\\", rationId: 5, rationName: \\\"Transition Blend\\\", animalCount: 295, plannedQuantityLb: 7080 }),\\n];\\nconst RATIONS: Ration[] = [3, 4, 5].map((id, i) => ({\\n  rationId: id, name: [\\\"Grower Mix 14G\\\", \\\"Finisher 850\\\", \\\"Transition Blend\\\"][i], type: \\\"TMR\\\", ingredients: [], costPerLbUsd: 0.12 + i / 100,\\n  dryMatterPercent: 60, energyMcalPerLb: 0.68, intendedAnimalType: \\\"Steer\\\", intendedWeightRangeLb: \\\"700-1100\\\",\\n}));\\nconst corn = (available: number): InventoryItem => ({\\n  itemId: 9, name: \\\"Cracked corn\\\", category: \\\"Grain\\\", availableQuantityLb: available, unitOfMeasure: \\\"lb\\\", unitCostUsdPerTon: 338,\\n  unitCostUsdPerLb: 0.169, dryMatterPercent: 88, energyMcalPerLb: 0.9, storageLocation: \\\"Bin 2\\\", openingStockLb: 120000, receivedStockLb: 0,\\n  consumedStockLb: 120000 - available, closingStockLb: available,\\n});\\nconst EVENT_METRICS = M({\\n  daysOnFeed: 151, totalWeightGainLb: 348, averageDailyGainLbPerDay: 2.64, totalFeedConsumedLb: 612345, feedConversionRatio: 5.93,\\n  feedCostPerGainUsdPerLb: 0.97, projectedShipDate: \\\"2027-03-20\\\",\\n  suggestions: [\\\"Raise the bunk call by 0.5 lb per head this week.\\\", \\\"Plan the sale window for the third week of March.\\\"],\\n});\\nconst VOID_METRICS = M({\\n  daysOnFeed: 152, totalWeightGainLb: 361, averageDailyGainLbPerDay: 3.19, totalFeedConsumedLb: 598765, feedConversionRatio: 7.77,\\n  feedCostPerGainUsdPerLb: 1.13, suggestions: [\\\"Re-plan the voided bunk quantity before the next delivery.\\\"],\\n});\\nconst event = (o: Partial<FeedingEvent> = {}): FeedingEvent => ({\\n  eventId: 91, planId: 4806, penId: 14, penName: \\\"Pen 14\\\", rationName: \\\"Grower Mix 14G\\\", plannedQuantityLb: 6240,\\n  actualDeliveredQuantityLb: 6000, varianceLb: -240, feedCostUsd: 768, energyMcal: 4080, inventoryDecrementLb: 6000,\\n  wastageAdjustedEstimatedConsumptionLb: 5730, status: \\\"Variance\\\", allocations: [{ lotId: 41, lotName: \\\"14-A\\\", quantityLb: 6000 }],\\n  costSnapshots: [], createdBy: \\\"ops\\\", createdAt: \\\"2026-01-14T06:00:00Z\\\", lastChangedBy: \\\"ops\\\", lastChangedAt: \\\"2026-01-14T06:00:00Z\\\", ...o,\\n});\\ninterface FeedStore { available: number; posts: unknown[] }\\nfunction installFeed(store: FeedStore, extra: RequestHandler[] = []) {\\n  serve(\\n    ...extra,\\n    msw.getGetFeedingPlansMockHandler(() => ({ plans: PLANS })),\\n    msw.getGetRationsMockHandler(() => ({ currency: \\\"USD\\\", rations: RATIONS })),\\n    msw.getGetFeedInventoryMockHandler(() => ({ currency: \\\"USD\\\", items: [corn(store.available)] })),\\n    msw.getGetOverviewMockHandler(() => ({\\n      ...msw.getGetOverviewResponseMock(),\\n      lots: [LOT],\\n      pens: [14, 12, 18].map((id) => ({ ...PEN, penId: id, penName: `Pen ${id}`, animalCount: 260 })),\\n    })),\\n  );\\n}\\nasync function recordFeeding(u: U) {\\n  await u.click(await screen.findByRole(\\\"button\\\", { name: /feeding entry/i }));\\n  const dlg = await screen.findByRole(\\\"dialog\\\");\\n  await choose(u, dlg, /saved plan/i, /Pen 14/);\\n  await fill(u, await within(dlg).findByLabelText(/delivered quantity/i), \\\"6000\\\");\\n  const alloc = within(dlg).queryByLabelText(/actual lot allocation/i);\\n  if (alloc) await fill(u, alloc, \\\"Lot 14-A: 6,000 lb\\\");\\n  await u.click(within(dlg).getByRole(\\\"button\\\", { name: /save actual feeding/i }));\\n  await waitFor(() => expect(shows(/6,?000/)).toBe(true));\\n  if (screen.queryByRole(\\\"dialog\\\")) {\\n    await u.keyboard(\\\"{Escape}\\\");\\n    await waitFor(() => expect(screen.queryByRole(\\\"dialog\\\")).toBeNull());\\n  }\\n}\\nconst VARIANCE = /[−–-]\\\\s?240(?!\\\\d)|240\\\\s*(lb\\\\s*)?(under|short|below)/i;\\nconst eventRow = () => rowWith(num(6240), num(6000), VARIANCE);\\n\\n// ---------- tests ----------\\ndescribe(\\\"part 3: feeding plan, weights, lot performance\\\", () => {\\n  it(\\\"AC_17_1_FeedingRowShowsPlannedActualVarianceAndAdjustAction\\\", async () => {\\n    const u = userEvent.setup();\\n    const feed: FeedStore = { available: 100000, posts: [] };\\n    installFeed(feed, [msw.getCreateFeedingEventMockHandler(() => ({ event: event(), message: \\\"Feeding saved.\\\" }))]);\\n    render(<FeedManagementContainer />);\\n    await recordFeeding(u);\\n    const row = await waitFor(() => {\\n      const r = eventRow();\\n      if (!r) throw new Error(\\\"no feeding row with plan, actual and variance\\\");\\n      return r;\\n    });\\n    const text = rowText(row);\\n    expect(text).toMatch(num(6240));\\n    expect(text).toMatch(num(6000));\\n    expect(text).toMatch(VARIANCE);\\n    expect(await actionButton(u, /adjust future plan/i, row)).toBeTruthy();\\n  });\\n\\n  it(\\\"AC_17_2_AdjustFormShowsEditableQuantitiesPenAndRation\\\", async () => {\\n    const u = userEvent.setup();\\n    const feed: FeedStore = { available: 100000, posts: [] };\\n    installFeed(feed, [msw.getCreateFeedingEventMockHandler(() => ({ event: event(), message: \\\"Feeding saved.\\\" }))]);\\n    render(<FeedManagementContainer />);\\n    await recordFeeding(u);\\n    const row = await waitFor(() => {\\n      const r = eventRow();\\n      if (!r) throw new Error(\\\"no feeding row\\\");\\n      return r;\\n    });\\n    await u.click(await actionButton(u, /adjust future plan/i, row));\\n    const scope = (await screen.findByRole(\\\"dialog\\\").catch(() => document.body)) as HTMLElement;\\n    const fields = [\\n      ...within(scope).queryAllByRole(\\\"spinbutton\\\"),\\n      ...within(scope).queryAllByRole(\\\"textbox\\\", { name: /quantity|rate|lb|allocation/i }),\\n    ].filter((f) => !(f as HTMLInputElement).disabled && !(f as HTMLInputElement).readOnly);\\n    expect(fields.length).toBeGreaterThan(0);\\n    const inputs = Array.from(scope.querySelectorAll(\\\"input,textarea\\\")).map((e) => (e as HTMLInputElement).value).join(\\\" \\\");\\n    const shown = `${scope.textContent ?? \\\"\\\"} ${inputs}`;\\n    expect(shown).toContain(\\\"Pen 14\\\");\\n    expect(shown).toContain(\\\"Grower Mix 14G\\\");\\n    expect(shown).not.toContain(\\\"Finisher 850 Pen 12\\\");\\n    const first = fields[0] as HTMLInputElement;\\n    await fill(u, first, \\\"5900\\\");\\n    expect(first.value).toContain(\\\"5900\\\");\\n  });\\n\\n  it(\\\"AC_18_1_TotalIsAverageTimesCountWithNoTotalField\\\", async () => {\\n    const u = userEvent.setup();\\n    installYard({ weights: weightHistoryStore().weights, metrics: M(), posts: [] });\\n    render(<ProcurementLotRecordsContainer />);\\n    const avg = await screen.findByLabelText(/average animal weight/i);\\n    const count = await screen.findByLabelText(/animals weighed/i);\\n    expect(screen.queryByRole(\\\"spinbutton\\\", { name: /total/i })).toBeNull();\\n    expect(screen.queryByRole(\\\"textbox\\\", { name: /total/i })).toBeNull();\\n    await fill(u, avg, \\\"640\\\");\\n    await fill(u, count, \\\"12\\\");\\n    await waitFor(() => expect(shows(num(7680))).toBe(true));\\n    await fill(u, avg, \\\"705\\\");\\n    await waitFor(() => expect(shows(num(8460))).toBe(true));\\n    expect(shows(num(7680))).toBe(false);\\n    await fill(u, count, \\\"9\\\");\\n    await waitFor(() => expect(shows(num(6345))).toBe(true));\\n    expect(shows(num(8460))).toBe(false);\\n    expect(screen.queryByRole(\\\"spinbutton\\\", { name: /total/i })).toBeNull();\\n    expect(screen.queryByRole(\\\"textbox\\\", { name: /total/i })).toBeNull();\\n  });\\n\\n  it(\\\"AC_18_2_Saves500By20AsTenThousandInHistory\\\", async () => {\\n    const u = userEvent.setup();\\n    const store = weightHistoryStore();\\n    const saved = W({ weightId: 20, measurementDate: \\\"2026-01-14\\\", animalsWeighed: 20, averageWeightLb: 500, totalMeasuredWeightLb: 10000, weightGainSincePriorLb: 52, notes: \\\"Pre-ship check\\\" });\\n    installYard(store, [\\n      msw.getCreateWeightMeasurementMockHandler(async (info) => {\\n        store.posts.push(await info.request.clone().json());\\n        store.weights.push(saved);\\n        store.metrics = M({ averageDailyGainLbPerDay: 1.88 });\\n        return { record: saved, revisedMetrics: store.metrics };\\n      }),\\n    ]);\\n    render(<ProcurementLotRecordsContainer />);\\n    const form = document.body;\\n    const avg = await screen.findByLabelText(/average animal weight/i);\\n    await pickLot(u, form);\\n    await pickDate(form, TEST_NOW.toISOString().slice(0, 10).replace(/\\\\d\\\\d$/, \\\"14\\\"));\\n    await fill(u, await screen.findByLabelText(/animals weighed/i), \\\"20\\\");\\n    await fill(u, avg, \\\"500\\\");\\n    await fill(u, screen.getByLabelText(/^notes$/i), \\\"Pre-ship check\\\");\\n    await waitFor(() => expect(shows(/10,?000\\\\s*(lb|pounds)?/i)).toBe(true));\\n    await u.click(screen.getByRole(\\\"button\\\", { name: \\\"Save weight\\\" }));\\n    await waitFor(() => expect(store.posts.length).toBe(1));\\n    expect(store.posts[0]).toMatchObject({ animalsWeighed: 20, averageWeightLb: 500, notes: \\\"Pre-ship check\\\" });\\n    const row = await waitFor(() => {\\n      const r = rowWith(num(10000), num(500), num(20));\\n      if (!r) throw new Error(\\\"saved record not in history\\\");\\n      return r;\\n    });\\n    expect(rowText(row)).toMatch(dateRe(\\\"2026-01-14\\\"));\\n    expect(rowText(row)).toContain(\\\"Pre-ship check\\\");\\n    expect(rowWith(num(14616))).toBeTruthy();\\n  });\\n\\n  it(\\\"AC_19_1_WeightHistoryListsRecordsInTimeOrderWithAllColumns\\\", async () => {\\n    const store = weightHistoryStore();\\n    installYard(store);\\n    render(<ProcurementLotRecordsContainer />);\\n    const expected = [\\n      { iso: \\\"2025-10-06\\\", n: 18, avg: 812, total: 14616, gain: 0, notes: \\\"Arrival weigh\\\" },\\n      { iso: \\\"2025-11-17\\\", n: 24, avg: 905, total: 21720, gain: 93, notes: \\\"Dry weather check\\\" },\\n      { iso: \\\"2025-12-23\\\", n: 22, avg: 1031, total: 22682, gain: 126, notes: \\\"Mid-feed weigh\\\" },\\n      { iso: \\\"2026-01-13\\\", n: 21, avg: 1148, total: 24108, gain: 117, notes: \\\"\\\" },\\n    ];\\n    const rows = await waitFor(() => {\\n      const found = expected.map((e) => rowWith(num(e.total)));\\n      if (found.some((r) => !r)) throw new Error(\\\"history rows missing\\\");\\n      return found as Element[];\\n    });\\n    expected.forEach((e, i) => {\\n      const t = rowText(rows[i]);\\n      expect(t).toMatch(dateRe(e.iso));\\n      expect(t).toMatch(num(e.n));\\n      expect(t).toMatch(num(e.avg));\\n      expect(t).toMatch(num(e.total));\\n      if (e.gain) expect(t).toMatch(num(e.gain));\\n      if (e.notes) expect(t).toContain(e.notes);\\n    });\\n    const pos = rows.map((r) => (r.compareDocumentPosition(rows[0]) & Node.DOCUMENT_POSITION_PRECEDING ? 1 : 0));\\n    const before = (a: Element, b: Element) => !!(a.compareDocumentPosition(b) & Node.DOCUMENT_POSITION_FOLLOWING);\\n    void pos;\\n    const ascending = rows.every((r, i) => i === 0 || before(rows[i - 1], r));\\n    const descending = rows.every((r, i) => i === 0 || before(r, rows[i - 1]));\\n    expect(ascending || descending).toBe(true);\\n  });\\n\\n  it(\\\"AC_20_1_EditedWeightShowsRevisedMetricsAndKeepsOriginalInHistory\\\", async () => {\\n    const u = userEvent.setup();\\n    const store: YardStore = {\\n      weights: [\\n        W({ weightId: 500, measurementDate: \\\"2025-12-20\\\", animalsWeighed: 20, averageWeightLb: 1100, totalMeasuredWeightLb: 22000, notes: \\\"Earlier weigh\\\" }),\\n        W({ weightId: 501, measurementDate: \\\"2026-01-13\\\", animalsWeighed: 20, averageWeightLb: 1198, totalMeasuredWeightLb: 23960, weightGainSincePr... (9953 more characters not kept)","output":"{\"type\":\"create\",\"filePath\":\"/work/tests/acceptance.part3.test.tsx\",\"content\":\"// @vitest-environment jsdom\\nimport { afterAll, afterEach, beforeAll, describe, expect, it, vi } from \\\"vitest\\\";\\nimport { render, screen, waitFor, within } from \\\"@testing-library/react\\\";\\nimport userEvent from \\\"@testing-library/user-event\\\";\\nimport { setupServer } from \\\"msw/node\\\";\\nimport type { RequestHandler } from \\\"msw\\\";\\nimport { TEST_NOW } from \\\"./support/screen\\\";\\nimport { ProcurementLotRecordsContainer } from \\\"@/components/screens/s-2/container\\\";\\nimport { FeedManagementContainer } from \\\"@/components/screens/s-3/container\\\";\\nimport * as msw from \\\"@/lib/api/client.msw\\\";\\nimport type {\\n  FeedingEvent, FeedingPlan, InventoryItem, LotMetrics, LotSummary, PenSummary, Ration, WeightRecord, YardResponse,\\n} from \\\"@/lib/api/client.schemas\\\";\\n\\n// ---------- server ----------\\nconst server = setupServer();\\nbeforeAll(() => server.listen({ onUnhandledRequest: \\\"bypass\\\" }));\\nafterEach(() => { server.resetHandlers(); vi.unstubAllGlobals(); vi.restoreAllMocks(); });\\nafterAll(() => server.close());\\nconst serve = (...h: RequestHandler[]) => server.use(...h, ...msw.getFeedlotWorkspaceAPIMock());\\n\\n// ---------- text helpers ----------\\nconst num = (n: number) => {\\n  const [i, f] = String(n).split(\\\".\\\");\\n  const grouped = i.replace(/\\\\B(?=(\\\\d{3})+(?!\\\\d))/g, \\\",?\\\");\\n  const tail = f ? `\\\\\\\\.${f}0*` : \\\"(?:\\\\\\\\.0+)?\\\";\\n  return new RegExp(`(?<![\\\\\\\\d.,])${grouped}${tail}(?!\\\\\\\\d|,\\\\\\\\d)`);\\n};\\nconst MONTHS = [\\\"January\\\", \\\"February\\\", \\\"March\\\", \\\"April\\\", \\\"May\\\", \\\"June\\\", \\\"July\\\", \\\"August\\\", \\\"September\\\", \\\"October\\\", \\\"November\\\", \\\"December\\\"];\\nconst dateRe = (iso: string) => {\\n  const [y, m, d] = iso.split(\\\"-\\\").map(Number);\\n  const mn = MONTHS[m - 1].slice(0, 3);\\n  const dd = `0?${d}`;\\n  return new RegExp(`${y}-0?${m}-${dd}\\\\\\\\b|\\\\\\\\b${dd}\\\\\\\\s+${mn}[a-z]*\\\\\\\\.?,?\\\\\\\\s+${y}|${mn}[a-z]*\\\\\\\\.?\\\\\\\\s+${dd}(st|nd|rd|th)?,?\\\\\\\\s+${y}|\\\\\\\\b${dd}/0?${m}/${y}|\\\\\\\\b0?${m}/${dd}/${y}`, \\\"i\\\");\\n};\\nconst shows = (re: RegExp) => {\\n  const leaves = Array.from(document.body.querySelectorAll(\\\"*\\\")).filter((e) => e.children.length === 0).map((e) => e.textContent ?? \\\"\\\");\\n  const values = Array.from(document.body.querySelectorAll(\\\"input,textarea\\\")).map((e) => (e as HTMLInputElement).value);\\n  return [...leaves, ...values].some((t) => re.test(t));\\n};\\nconst rowText = (r: Element) => Array.from(r.querySelectorAll(\\\"td,th,[role=cell],[role=gridcell],[role=columnheader]\\\")).map((c) => c.textContent ?? \\\"\\\").join(\\\" | \\\");\\nconst rowWith = (...res: Array<RegExp | string>) =>\\n  Array.from(document.querySelectorAll(\\\"tr,[role=row]\\\")).find((r) => {\\n    const t = rowText(r);\\n    return res.every((x) => (typeof x === \\\"string\\\" ? t.includes(x) : x.test(t)));\\n  });\\nconst metricNow = (label: RegExp) => {\\n  const els = screen.queryAllByText(label);\\n  const el = els.find((e) => e.tagName === \\\"DT\\\") ?? els[0];\\n  if (!el) return \\\"\\\";\\n  return (el.tagName === \\\"DT\\\" ? el.nextElementSibling : el.parentElement)?.textContent ?? \\\"\\\";\\n};\\n\\n// ---------- interaction helpers ----------\\ntype U = ReturnType<typeof userEvent.setup>;\\nasync function fill(u: U, el: HTMLElement, value: string) {\\n  await u.clear(el);\\n  await u.type(el, value);\\n}\\nasync function choose(u: U, scope: HTMLElement, label: RegExp, option: RegExp) {\\n  const el = await within(scope).findByLabelText(label);\\n  if (el.tagName === \\\"SELECT\\\") {\\n    await u.selectOptions(el, within(el).getByRole(\\\"option\\\", { name: option }));\\n  } else {\\n    await u.click(el);\\n    await u.click(await screen.findByRole(\\\"option\\\", { name: option }));\\n  }\\n}\\nasync function actionButton(u: U, name: RegExp, row?: Element) {\\n  const find = () => screen.queryByRole(\\\"button\\\", { name }) ?? screen.queryByRole(\\\"menuitem\\\", { name });\\n  if (!find() && row) {\\n    const cb = within(row as HTMLElement).queryByRole(\\\"checkbox\\\");\\n    if (cb) await u.click(cb);\\n  }\\n  if (!find() && row) {\\n    const more = within(row as HTMLElement).queryByRole(\\\"button\\\", { name: /more|actions/i });\\n    if (more) await u.click(more);\\n  }\\n  return waitFor(() => {\\n    const el = find();\\n    if (!el) throw new Error(`no action ${name}`);\\n    return el;\\n  });\\n}\\n\\n// ---------- S-2 data ----------\\nconst LOT: LotSummary = {\\n  lotId: 41, lotName: \\\"L-7741\\\", headCount: 22, breed: \\\"Angus\\\", sex: \\\"Steer\\\", penName: \\\"P-17\\\", rationName: \\\"Grower Mix 14G\\\",\\n  feedConsumedLb: 9000, startingWeightLb: 800, currentWeightLb: 1000, adgLbPerDay: 1.5, fcr: 9, costOfGainPerLb: 0.5,\\n};\\nconst PEN: PenSummary = {\\n  penId: 17, penName: \\\"P-17\\\", animalCount: 22, capacity: 40, rationName: \\\"Grower Mix 14G\\\", dailyBunkRateLbPerHead: 24,\\n  plannedFeedLb: 528, actualFeedLb: 528, currentWeightLb: 1000, adgLbPerDay: 1.5,\\n};\\nconst M = (o: Partial<LotMetrics> = {}): LotMetrics => ({\\n  daysOnFeed: 90, totalWeightGainLb: 150, averageDailyGainLbPerDay: 1.66, totalFeedConsumedLb: 5000, feedConversionRatio: 33.3,\\n  feedCostPerGainUsdPerLb: 0.5, projectedShipDate: null, suggestions: [], ...o,\\n});\\nconst W = (o: Partial<WeightRecord>): WeightRecord => ({\\n  weightId: 1, lotId: LOT.lotId, lotName: LOT.lotName, measurementDate: \\\"2025-12-23\\\", animalsWeighed: 20, averageWeightLb: 900,\\n  totalMeasuredWeightLb: 18000, weightGainSincePriorLb: 0, notes: \\\"\\\", status: \\\"Current\\\", createdBy: \\\"ops\\\",\\n  createdAt: \\\"2026-01-01T10:00:00Z\\\", lastChangedBy: \\\"ops\\\", lastChangedAt: \\\"2026-01-01T10:00:00Z\\\", ...o,\\n});\\ninterface YardStore { weights: WeightRecord[]; metrics: LotMetrics; posts: unknown[] }\\nconst yardResponse = (weights: WeightRecord[]): YardResponse => ({\\n  purchaseOrders: [{\\n    recordId: 1, purchaseOrderNumber: \\\"PO-5501\\\", lineNumber: 1, receiptNumber: \\\"RC-9001\\\", vendor: \\\"Hill Cattle\\\", unitCostUsdPerTon: 410,\\n    headCount: 22, averageWeightLb: 800, breed: \\\"Angus\\\", ageMonths: 9, source: \\\"ERP\\\", importStatus: \\\"Synced\\\",\\n    lotId: LOT.lotId, lotName: LOT.lotName, penId: PEN.penId, penName: PEN.penName,\\n  }],\\n  lots: [LOT], pens: [PEN], forecasts: [], weightHistory: weights,\\n});\\nfunction installYard(store: YardStore, extra: RequestHandler[] = []) {\\n  serve(\\n    ...extra,\\n    msw.getGetYardRecordsMockHandler(() => yardResponse(store.we