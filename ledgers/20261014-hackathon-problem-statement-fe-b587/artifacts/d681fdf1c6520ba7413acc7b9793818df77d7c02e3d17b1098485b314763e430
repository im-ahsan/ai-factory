\\\", \\\"August\\\", \\\"September\\\", \\\"October\\\", \\\"November\\\", \\\"December\\\"];\\nconst dateRe = (iso: string) => {\\n  const [y, m, d] = iso.split(\\\"-\\\").map(Number);\\n  const mn = MONTHS[m - 1].slice(0, 3);\\n  const dd = `0?${d}`;\\n  return new RegExp(`${y}-0?${m}-${dd}\\\\\\\\b|\\\\\\\\b${dd}\\\\\\\\s+${mn}[a-z]*\\\\\\\\.?,?\\\\\\\\s+${y}|${mn}[a-z]*\\\\\\\\.?\\\\\\\\s+${dd}(st|nd|rd|th)?,?\\\\\\\\s+${y}|\\\\\\\\b${dd}/0?${m}/${y}|\\\\\\\\b0?${m}/${dd}/${y}`, \\\"i\\\");\\n};\\nconst shows = (re: RegExp) => {\\n  const leaves = Array.from(document.body.querySelectorAll(\\\"*\\\")).filter((e) => e.children.length === 0).map((e) => e.textContent ?? \\\"\\\");\\n  const values = Array.from(document.body.querySelectorAll(\\\"input,textarea\\\")).map((e) => (e as HTMLInputElement).value);\\n  return [...leaves, ...values].some((t) => re.test(t));\\n};\\nconst rowText = (r: Element) => Array.from(r.querySelectorAll(\\\"td,th,[role=cell],[role=gridcell],[role=columnheader]\\\")).map((c) => c.textContent ?? \\\"\\\").join(\\\" | \\\");\\nconst rowWith = (...res: Array<RegExp | string>) =>\\n  Array.from(document.querySelectorAll(\\\"tr,[role=row]\\\")).find((r) => {\\n    const t = rowText(r);\\n    return res.every((x) => (typeof x === \\\"string\\\" ? t.includes(x) : x.test(t)));\\n  });\\nconst metricNow = (label: RegExp) => {\\n  const els = screen.queryAllByText(label);\\n  const el = els.find((e) => e.tagName === \\\"DT\\\") ?? els[0];\\n  if (!el) return \\\"\\\";\\n  return (el.tagName === \\\"DT\\\" ? el.nextElementSibling : el.parentElement)?.textContent ?? \\\"\\\";\\n};\\n\\n// ---------- interaction helpers ----------\\ntype U = ReturnType<typeof userEvent.setup>;\\nasync function fill(u: U, el: HTMLElement, value: string) {\\n  await u.clear(el);\\n  await u.type(el, value);\\n}\\nasync function choose(u: U, scope: HTMLElement, label: RegExp, option: RegExp) {\\n  const el = await within(scope).findByLabelText(label);\\n  if (el.tagNam