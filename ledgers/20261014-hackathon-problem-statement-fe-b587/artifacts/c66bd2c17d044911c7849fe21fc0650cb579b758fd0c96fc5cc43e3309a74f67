{"ts":1792013500768,"kind":"call","tool":"Write","input":"{\"file_path\":\"/work/tests/acceptance.part2.test.tsx\",\"content\":\"// @vitest-environment jsdom\\nimport { afterAll, afterEach, beforeAll, describe, expect, it, vi } from \\\"vitest\\\";\\nimport { fireEvent, render, screen, waitFor, within } from \\\"@testing-library/react\\\";\\nimport userEvent from \\\"@testing-library/user-event\\\";\\nimport { HttpResponse, http } from \\\"msw\\\";\\nimport { setupServer } from \\\"msw/node\\\";\\nimport { FeedManagementContainer } from \\\"@/components/screens/s-3/container\\\";\\nimport { at } from \\\"./support/screen\\\";\\nimport {\\n  getFeedlotWorkspaceAPIMock,\\n  getGetFeedForecastMockHandler,\\n  getGetFeedInventoryMockHandler,\\n  getGetFeedingPlansMockHandler,\\n  getGetOverviewMockHandler,\\n  getGetOverviewResponseMock,\\n  getGetRationComparisonMockHandler,\\n  getGetRationsMockHandler,\\n  getGetYardRecordsMockHandler,\\n  getGetYardRecordsResponseMock,\\n} from \\\"@/lib/api/client.msw\\\";\\nimport type {\\n  CostSnapshot,\\n  FeedForecastResponse,\\n  FeedingEvent,\\n  FeedingPlan,\\n  InventoryItem,\\n  LotAllocation,\\n  LotSummary,\\n  PenSummary,\\n  Ration,\\n  RationComparisonRow,\\n} from \\\"@/lib/api/client.schemas\\\";\\n\\n// ---------- API stand-in (the contract's generated handlers, with this file's own rows) ----------\\n\\nconst server = setupServer(...getFeedlotWorkspaceAPIMock());\\nbeforeAll(() => server.listen({ onUnhandledRequest: \\\"bypass\\\" }));\\nafterEach(() => { server.resetHandlers(); vi.unstubAllGlobals(); vi.restoreAllMocks(); });\\nafterAll(() => server.close());\\n\\nconst item = (itemId: number, name: string, category: string, availableQuantityLb: number, ton: number): InventoryItem => ({\\n  itemId, name, category, availableQuantityLb, unitOfMeasure: \\\"lb\\\",\\n  unitCostUsdPerTon: ton, unitCostUsdPerLb: Math.round((ton / 2000) * 1000) / 1000,\\n  dryMatterPercent: 88, energyMcalPerLb: 0.8, storageLocation: `Bin Z-${itemId}`,\\n  openingStockLb: availableQuantityLb + 1000, receivedStockLb: 0, consumedStockLb: 1000, closingStockLb: availableQuantityLb,\\n});\\n\\nconst ration = (rationId: number, name: string, costPerLbUsd: number, extra: Partial<Ration> = {}): Ration => ({\\n  rationId, name, type: \\\"Grower\\\", ingredients: [], costPerLbUsd, dryMatterPercent: 88, energyMcalPerLb: 0.7,\\n  intendedAnimalType: \\\"Steers\\\", intendedWeightRangeLb: \\\"650–850 lb\\\", ...extra,\\n});\\n\\nconst lot = (lotId: number, lotName: string, penName: string, headCount: number): LotSummary => ({\\n  lotId, lotName, headCount, breed: \\\"Angus\\\", sex: \\\"Steer\\\", penName, rationName: \\\"Ridge Grower\\\",\\n  feedConsumedLb: 0, startingWeightLb: 700, currentWeightLb: 800, adgLbPerDay: 3.2, fcr: 6, costOfGainPerLb: 0.9,\\n});\\n\\nconst pen = (penId: number, penName: string, animalCount: number): PenSummary => ({\\n  penId, penName, animalCount, capacity: 400, rationName: \\\"Ridge Grower\\\", dailyBunkRateLbPerHead: 25,\\n  plannedFeedLb: 0, actualFeedLb: 0, currentWeightLb: 800, adgLbPerDay: 3.2,\\n});\\n\\nconst PENS: PenSummary[] = [\\n  pen(33, \\\"Pen 33\\\", 180), pen(41, \\\"Pen 41\\\", 250), pen(51, \\\"Pen 51\\\", 250),\\n  pen(61, \\\"Pen 61\\\", 240), pen(62, \\\"Pen 62\\\", 220), pen(71, \\\"Pen 71\\\", 260), pen(72, \\\"Pen 72\\\", 200),\\n];\\nconst LOTS: LotSummary[] = [\\n  lot(331, \\\"33-A\\\", \\\"Pen 33\\\", 180),\\n  lot(411, \\\"41-A\\\", \\\"Pen 41\\\", 130), lot(412, \\\"41-B\\\", \\\"Pen 41\\\", 120),\\n  lot(511, \\\"51-A\\\", \\\"Pen 51\\\", 150), lot(512, \\\"51-B\\\", \\\"Pen 51\\\", 100),\\n  lot(611, \\\"61-A\\\", \\\"Pen 61\\\", 140), lot(612, \\\"61-B\\\", \\\"Pen 61\\\", 100),\\n  lot(621, \\\"62-A\\\", \\\"Pen 62\\\", 120), lot(622, \\\"62-B\\\", \\\"Pen 62\\\", 100),\\n  lot(711, \\\"71-A\\\", \\\"Pen 71\\\", 150), lot(712, \\\"71-B\\\", \\\"Pen 71\\\", 110),\\n  lot(721, \\\"72-A\\\", \\\"Pen 72\\\", 120), lot(722, \\\"72-B\\\", \\\"Pen 72\\\", 80),\\n];\\n\\nconst RATIONS: Ration[] = [ration(31, \\\"Ridge Grower\\\", 0.152), ration(32, \\\"Ridge Finisher\\\", 0.171)];\\nconst ITEMS: InventoryItem[] = [\\n  item(21, \\\"Rolled barley\\\", \\\"Grain\\\", 14820, 418),\\n  item(22, \\\"Cottonseed hulls\\\", \\\"Forage\\\", 9365, 276),\\n  item(23, \\\"Wheat midds\\\", \\\"By-product\\\", 20110, 590),\\n];\\n\\nconst plan = (o: Partial<FeedingPlan> & { planId: number; penId: number; penName: string }): FeedingPlan => ({\\n  rationId: 31, rationName: \\\"Ridge Grower\\\", feedingDate: \\\"2026-01-16\\\", plannedFeedingTime: \\\"05:45\\\", animalCount: 250,\\n  perAnimalDailyRateLb: 26, plannedQuantityLb: 6500, quantityPerAnimalLb: 26, totalFeedCostUsd: 800, expectedEnergyIntakeMcal: 4000,\\n  status: \\\"Planned\\\", allocations: [], allocationReconciled: true, allocationDifferenceLb: 0, ...o,\\n});\\n\\nconst snapshot = (unit: number, qty = 1000): CostSnapshot => ({ itemId: 21, ingredientName: \\\"Rolled barley\\\", quantityLb: qty, unitCostUsdPerLb: unit });\\n\\nconst event = (o: Partial<FeedingEvent> & { eventId: number; planId: number; penId: number; penName: string }): FeedingEvent => ({\\n  rationName: \\\"Ridge Grower\\\", plannedQuantityLb: 7000, actualDeliveredQuantityLb: 7000, varianceLb: 0, feedCostUsd: 900, energyMcal: 4000,\\n  inventoryDecrementLb: 7000, wastageAdjustedEstimatedConsumptionLb: 7000, status: \\\"Complete\\\", allocations: [], costSnapshots: [],\\n  createdBy: \\\"operator\\\", createdAt: \\\"2026-01-15T12:00:00.000Z\\\", lastChangedBy: \\\"operator\\\", lastChangedAt: \\\"2026-01-15T12:00:00.000Z\\\", ...o,\\n});\\n\\nconst alloc = (lotId: number, lotName: string, quantityLb: number): LotAllocation => ({ lotId, lotName, quantityLb });\\n\\ninterface World {\\n  items?: InventoryItem[];\\n  rations?: Ration[];\\n  plans?: FeedingPlan[];\\n  comparisons?: RationComparisonRow[];\\n  forecast?: (ingredientId: number) => FeedForecastResponse;\\n  currency?: string;\\n}\\n\\nfunction serve(w: World = {}, ...extra: ReturnType<typeof http.post>[]) {\\n  const lots = LOTS;\\n  const pens = PENS;\\n  server.use(\\n    ...extra,\\n    getGetFeedInventoryMockHandler({ currency: w.currency ?? \\\"USD\\\", items: w.items ?? ITEMS }),\\n    getGetRationsMockHandler({ currency: w.currency ?? \\\"USD\\\", rations: w.rations ?? RATIONS }),\\n    getGetFeedingPlansMockHandler({ plans: w.plans ?? [] }),\\n    getGetRationComparisonMockHandler({ comparisons: w.comparisons ?? [] }),\\n    getGetOverviewMockHandler({ ...getGetOverviewResponseMock(), lots, pens }),\\n    getGetYardRecordsMockHandler({ ...getGetYardRecordsResponseMock(), lots, pens }),\\n    getGetFeedForecastMockHandler((info) => {\\n      const id = Number(new URL(info.request.url).searchParams.get(\\\"ingredientId\\\") ?? (w.items ?? ITEMS)[0].itemId);\\n      return w.forecast ? w.forecast(id) : { itemId: id, ingredientName: \\\"Rolled barley\\\", wastageRatio: 0.045, periods: [] };\\n    }),\\n  );\\n}\\n\\n// ---------- reading and acting on the page ----------\\n\\nconst bodyText = () => (document.body.textContent ?? \\\"\\\").replace(/\\\\s+/g, \\\" \\\");\\n\\n/** a number as a person may see it: thousands commas optional, minus sign required for negatives */\\nfunction numRe(n: number | string): RegExp {\\n  const s = String(n);\\n  const neg = s.startsWith(\\\"-\\\");\\n  const [int, dec] = (neg ? s.slice(1) : s).split(\\\".\\\");\\n  const intPat = int.replace(/\\\\B(?=(\\\\d{3})+$)/g, \\\",?\\\");\\n  return new RegExp(`(?<![\\\\\\\\d,.])${neg ? \\\"[-−–]\\\\\\\\s?\\\" : \\\"\\\"}${intPat}${dec ? `\\\\\\\\.${dec}` : \\\"\\\"}(?!\\\\\\\\d|,\\\\\\\\d|\\\\\\\\.\\\\\\\\d)`);\\n}\\n\\nasync function until(re: RegExp, timeout = 4000) {\\n  await waitFor(() => expect(bodyText()).toMatch(re), { timeout });\\n}\\n\\nconst ROW = \\\"tr, [role='row'], li, [role='listitem'], article\\\";\\n\\n/** some row / card / list entry whose name matches `name` also shows every one of `needs` (page-wide when the page has no such container) */\\nasync function expectRow(name: RegExp, ...needs: RegExp[]) {\\n  await waitFor(() => {\\n    const containers = new Set<Element>();\\n    for (const el of screen.queryAllByText(name)) { const c = el.closest(ROW); if (c) containers.add(c); }\\n    const texts = containers.size ? [...containers].map((c) => (c.textContent ?? \\\"\\\").replace(/\\\\s+/g, \\\" \\\")) : [bodyText()];\\n    expect(texts.some((t) => name.test(t) && needs.every((re) => re.test(t))), `no row for ${name} shows ${needs.join(\\\" and \\\")}; rows: ${texts.join(\\\" | \\\")}`).toBe(true);\\n  }, { timeout: 4000 });\\n}\\n\\ntype User = ReturnType<typeof userEvent.setup>;\\n\\nasync function openMenuItem(user: User, trigger: string, entry: string) {\\n  await user.click(await screen.findByRole(\\\"button\\\", { name: trigger }));\\n  const target = await Promise.any([\\n    screen.findByRole(\\\"menuitem\\\", { name: entry }),\\n    screen.findByRole(\\\"button\\\", { name: entry }),\\n    screen.findByRole(\\\"link\\\", { name: entry }),\\n  ]);\\n  await user.click(target);\\n}\\n\\nasync function fill(user: User, label: RegExp, value: string) {\\n  const el = (await screen.findByLabelText(label)) as HTMLInputElement;\\n  if (el.type === \\\"date\\\" || el.type === \\\"time\\\") { fireEvent.change(el, { target: { value } }); return; }\\n  await user.clear(el);\\n  await user.type(el, value);\\n}\\n\\nasync function choose(user: User, label: RegExp, option: RegExp) {\\n  const el = await screen.findByLabelText(label);\\n  if (el.tagName === \\\"SELECT\\\") {\\n    const opt = within(el).getAllByRole(\\\"option\\\").find((o) => option.test(o.textContent ?? \\\"\\\"));\\n    if (!opt) throw new Error(`no option ${option} in ${label}`);\\n    await user.selectOptions(el, opt as HTMLOptionElement);\\n    return;\\n  }\\n  await user.click(el);\\n  await user.click(await screen.findByRole(\\\"option\\\", { name: option }));\\n}\\n\\n/** per-lot fields when the form has them, else the allocation text box in the approved form's \\\"Lot 14-A: 3,200 lb; ...\\\" shape */\\nasync function fillAllocations(user: User, entries: { lot: string; qty: number }[]) {\\n  const perLot = screen.queryAllByLabelText(new RegExp(entries[0].lot, \\\"i\\\"));\\n  if (perLot.length) {\\n    for (const e of entries) await fill(user, new RegExp(e.lot, \\\"i\\\"), String(e.qty));\\n    return;\\n  }\\n  const text = entries.map((e) => `Lot ${e.lot}: ${e.qty.toLocaleString(\\\"en-US\\\")} lb`).join(\\\"; \\\");\\n  await fill(user, /allocation/i, text);\\n}\\n\\nfunction open() {\\n  at(\\\"/feed\\\");\\n  const user = userEvent.setup();\\n  render(<FeedManagementContainer />);\\n  return user;\\n}\\n\\nasync function startPlan(user: User, penName: RegExp) {\\n  await openMenuItem(user, \\\"Feeding entry\\\", \\\"Plan feeding\\\");\\n  await choose(user, /^pen/i, penName);\\n  await choose(user, /selected ration/i, /Ridge Grower/);\\n}\\n\\nasync function recordActual(user: User, o: { plan: RegExp; qty: number; allocations: { lot: string; qty: number }[] }) {\\n  await openMenuItem(user, \\\"Feeding entry\\\", \\\"Record actual\\\");\\n  await choose(user, /saved plan/i, o.plan);\\n  await fill(user, /delivered quantity/i, String(o.qty));\\n  await fill(user, /actual feeding time/i, \\\"05:50\\\");\\n  await fillAllocations(user, o.allocations);\\n  await user.click(await screen.findByRole(\\\"button\\\", { name: \\\"Save actual feeding\\\" }));\\n}\\n\\nasync function openDetailIfAny(user: User) {\\n  const b = screen.queryAllByRole(\\\"button\\\", { name: /detail|view record|open record/i })[0] ?? screen.queryAllByRole(\\\"link\\\", { name: /detail|view record|open record/i })[0];\\n  if (b) await user.click(b);\\n}\\n\\nconst T = 25000;\\n\\n// ---------- REQ-9 ----------\\n\\ndescribe(\\\"REQ-9 stock refusal\\\", () => {\\n  it(\\\"AC_9_1_ShowsRefusalAndShortageKeepsFormAndSavesNothing\\\", async () => {\\n    const hulls = item(22, \\\"Cottonseed hulls\\\", \\\"Forage\\\", 625, 276);\\n    let posts = 0;\\n    serve({ items: [ITEMS[0], hulls, ITEMS[2]] }, http.post(\\\"*/feed/stock-movements\\\", () => {\\n      posts++;\\n      return HttpResponse.json({ code: \\\"insufficient_stock\\\", message: \\\"Issue refused: balance would go negative\\\", shortageLb: 1875, availableQuantityLb: 625, requestedQuantityLb: 2500, saved: false }, { status: 409 });\\n    }));\\n    const user = open();\\n    await screen.findByText(\\\"Feed management\\\");\\n\\n    const direct = screen.queryAllByRole(\\\"button\\\", { name: /movement/i })[0];\\n    if (direct) await user.click(direct);\\n    else await openMenuItem(user, \\\"Feed tools\\\", \\\"Record stock movement\\\");\\n\\n    await choose(user, /item|ingredient/i, /Cottonseed hulls/);\\n    await choose(user, /type/i, /Issue/);\\n    await fill(user, /quantity/i, \\\"2500\\\");\\n    await user.click(await screen.findByRole(\\\"button\\\", { name: /(save|record|submit).*movement|^save$/i }));\\n\\n    await waitFor(() => expect(posts).toBe(1));\\n    await until(/Issue refused: balance would go negative/);\\n    await until(numRe(1875));\\n    expect(screen.getByLabelText(/quantity/i)).toBeTruthy();\\n    expect(screen.getByRole(\\\"button\\\", { name: /(save|record|submit).*movement|^save$/i })).toBeTruthy();\\n    expect(bodyText()).not.toMatch(/movement saved|saved movement|movement recorded/i);\\n  }, T);\\n});\\n\\n// ---------- REQ-10 ----------\\n\\nconst HORIZONS = [\\\"Daily\\\", \\\"Weekly\\\", \\\"Monthly\\\", \\\"Quarterly\\\", \\\"Bi-annual\\\", \\\"Annual\\\"] as const;\\n\\nasync function pickHorizon(user: User, h: string) {\\n  for (const role of [\\\"tab\\\", \\\"radio\\\", \\\"button\\\", \\\"option\\\"] as const) {\\n    const el = screen.queryAllByRole(role, { name: new RegExp(`^${h}$`, \\\"i\\\") })[0];\\n    if (el) { await user.click(el); return; }\\n  }\\n}\\n\\ndescribe(\\\"REQ-10 forecasts\\\", () => {\\n  it(\\\"AC_10_1_ShowsWastageRatioAndBalancesForEveryHorizon\\\", async () => {\\n    const values: Record<string, [number, number | null]> = {\\n      Daily: [18420, null], Weekly: [-3277, 3310], Monthly: [-41905, 41980],\\n      Quarterly: [-128760, 128805], \\\"Bi-annual\\\": [-259330, 259411], Annual: [-514885, 514902],\\n    };\\n    serve({\\n      forecast: (id) => ({\\n        itemId: id, ingredientName: \\\"Rolled barley\\\", wastageRatio: 0.065,\\n        periods: HORIZONS.map((h) => ({ horizon: h, available: true, balanceLb: values[h][0], shortageLb: values[h][1] ?? 0 })),\\n      }),\\n    });\\n    const user = open();\\n    await until(/6\\\\.5\\\\s*%|0\\\\.065/);\\n    for (const h of HORIZONS) {\\n      await pickHorizon(user, h);\\n      const [balance, shortage] = values[h];\\n      const needs = [numRe(balance), ...(shortage ? [numRe(shortage)] : [])];\\n      await expectRow(new RegExp(h, \\\"i\\\"), ...needs);\\n      await until(numRe(balance));\\n      if (shortage) await until(numRe(shortage));\\n    }\\n    expect(bodyText()).not.toMatch(/NaN|undefined/);\\n  }, T);\\n\\n  it(\\\"AC_10_2_MarksPeriodsWithoutDatedPlanUnavailable\\\", async () => {\\n    serve({\\n      forecast: (id) => ({\\n        itemId: id, ingredientName: \\\"Rolled barley\\\", wastageRatio: 0.065,\\n        periods: [\\n          { horizon: \\\"Daily\\\", available: true, balanceLb: 18420, shortageLb: 0 },\\n          { horizon: \\\"Weekly\\\", available: false, balanceLb: null, shortageLb: null },\\n          { horizon: \\\"Monthly\\\", available: true, balanceLb: -41905, shortageLb: 41980 },\\n          { horizon: \\\"Quarterly\\\", available: false, balanceLb: null, shortageLb: null },\\n          { horizon: \\\"Bi-annual\\\", available: true, balanceLb: -259330, shortageLb: 259411 },\\n          { horizon: \\\"Annual\\\", available: true, balanceLb: -514885, shortageLb: 514902 },\\n        ],\\n      }),\\n    });\\n    const user = open();\\n    await until(/6\\\\.5\\\\s*%|0\\\\.065/);\\n    for (const h of [\\\"Weekly\\\", \\\"Quarterly\\\"]) {\\n      await pickHorizon(user, h);\\n      await expectRow(new RegExp(h, \\\"i\\\"), /unavailable|not available/i);\\n    }\\n    for (const h of [\\\"Monthly\\\", \\\"Annual\\\"]) {\\n      await pickHorizon(user, h);\\n      await until(numRe(h === \\\"Monthly\\\" ? 41905 : 514885));\\n    }\\n    expect(bodyText()).not.toMatch(/NaN|null|undefined/);\\n  }, T);\\n});\\n\\n// ---------- REQ-11 ----------\\n\\ndescribe(\\\"REQ-11 rations\\\", () => {\\n  it(\\\"AC_11_1_ShowsSavedRationWithReturnedCostNutritionAndAnimalRange\\\", async () => {\\n    const saved = ration(77, \\\"Prairie Grower\\\", 0.137, {\\n      type: \\\"Grower\\\", dryMatterPercent: 87.3, energyMcalPerLb: 0.71,\\n      intendedAnimalType: \\\"Yearling heifers\\\", intendedWeightRangeLb: \\\"720–910 lb\\\",\\n      ingredients: [\\n        { itemId: 21, ingredientName: \\\"Rolled barley\\\", quantityLb: 1480, asFedPercent: 40, unitCostUsdPerLb: 0.209 },\\n        { itemId: 22, ingredientName: \\\"Cottonseed hulls\\\", quantityLb: 815, asFedPercent: 22, unitCostUsdPerLb: 0.138 },\\n        { itemId: 23, ingredientName: \\\"Wheat midds\\\", quantityLb: 1405, asFedPercent: 38, unitCostUsdPerLb: 0.295 },\\n      ],\\n    });\\n    let created = false;\\n    let body: Record<string, unknown> | null = null;\\n    server.use(\\n      http.post(\\\"*/feed/rations\\\", async ({ request }) => { body = (await request.json()) as Record<string, unknown>; created = true; return HttpResponse.json({ ration: saved }, { status: 201 }); }),\\n      getGetRationsMockHandler(() => ({ currency: \\\"USD\\\", rations: created ? [...RATIONS, saved] : RATIONS })),\\n    );\\n    serve({});\\n    server.use(getGetRationsMockHandler(() => ({ currency: \\\"USD\\\", rations: created ? [...RATIONS, saved] : RATIONS })));\\n    const user = open();\\n    await screen.findByText(\\\"Feed management\\\");\\n    await openMenuItem(user, \\\"Feed tools\\\", \\\"New ration\\\");\\n    await fill(user, /ration name/i, \\\"Prairie Grower\\\");\\n    await choose(user, /ration type/i, /Grower/);\\n    await fill(user, /intended weight range/i, \\\"700-900 lb\\\");\\n    await fill(user, /as-fed ingredient proportions/i, \\\"Rolled barley 40%; Cottonseed hulls 22%; Wheat midds 38%\\\");\\n    await fill(user, /dry matter/i, \\\"88.1\\\");\\n    await fill(user, /energy value/i, \\\"0.70\\\");\\n    await user.click(await screen.findByRole(\\\"button\\\", { name: \\\"Calculate and save ration\\\" }));\\n\\n    await waitFor(() => expect(body).not.toBeNull());\\n    await until(/0\\\\.137|\\\\$0\\\\.14(?!\\\\d)/);\\n    await until(numRe(\\\"87.3\\\"));\\n    await until(numRe(\\\"0.71\\\"));\\n    await until(/Yearling heifers/);\\n    await until(/720\\\\s*[–-]\\\\s*910/);\\n    for (const [name, qty, pct] of [[\\\"Rolled barley\\\", 1480, 40], [\\\"Cottonseed hulls\\\", 815, 22], [\\\"Wheat midds\\\", 1405, 38]] as const) {\\n      await expectRow(new RegExp(name, \\\"i\\\"), new RegExp(`${numRe(qty).source}|${pct}\\\\\\\\s*%`));\\n    }\\n  }, T);\\n\\n  it(\\\"AC_12_1_ComparisonListsCostsPerformanceAndMarksLowestCostOfGain\\\", async () => {\\n    serve({\\n      comparisons: [\\n        { rationId: 1, rationName: \\\"Alpha Mix\\\", costPerLbUsd: 0.129, lotName: \\\"Lot 81\\\", adgLbPerDay: 3.37, costOfGainPerLbUsd: 0.93, lowestCostOfGain: false },\\n        { rationId: 2, rationName: \\\"Beta Mix\\\", costPerLbUsd: 0.147, lotName: \\\"Lot 82\\\", adgLbPerDay: 3.91, costOfGainPerLbUsd: 0.87, lowestCostOfGain: true },\\n        { rationId: 3, rationName: \\\"Gamma Mix\\\", costPerLbUsd: 0.133, lotName: \\\"Lot 83\\\", adgLbPerDay: 3.18, costOfGainPerLbUsd: 0.96, lowestCostOfGain: false },\\n      ],\\n    });\\n    open();\\n    for (const re of [/Alpha Mix/, /Beta Mix/, /Gamma Mix/, numRe(\\\"0.129\\\"), numRe(\\\"0.147\\\"), numRe(\\\"0.133\\\"), numRe(\\\"3.37\\\"), numRe(\\\"3.91\\\"), numRe(\\\"3.18\\\"), numRe(\\\"0.93\\\"), numRe(\\\"0.87\\\"), numRe(\\\"0.96\\\")]) await until(re);\\n\\n    // the \\\"lowest\\\" mark sits with the Beta Mix (its name or its cost of gain), not with the others\\n    await until(/lowest|best/i);\\n    const badges = screen.queryAllByText(/lowest|best/i);\\n    expect(badges.length).toBeGreaterThan(0);\\n    const verdicts = badges.map((b) => {\\n      for (let el: Element | null = b; el; el = el.parentElement) {\\n        const t = (el.textContent ?? \\\"\\\").replace(/\\\\s+/g, \\\" \\\");\\n        const hasBeta = /Beta Mix/.test(t) || numRe(\\\"0.87\\\").test(t);\\n        const hasOthers = /Alpha Mix|Gamma Mix/.test(t) || numRe(\\\"0.93\\\").test(t) || numRe(\\\"0.96\\\").test(t);\\n        if (hasBeta || hasOthers) return hasBeta && !hasOthers;\\n      }\\n      return false;\\n    });\\n    expect(verdicts.some(Boolean)).toBe(true);\\n  }, T);\\n});\\n\\n// ---------- REQ-13 ----------\\n\\ndescribe(\\\"REQ-13 per-pound prices\\\", () => {\\n  it(\\\"AC_13_1_ShowsPerPoundPricesInConfiguredCurrencyAndQuantitiesInPounds\\\", async () => {\\n    serve({\\n      rations: [ration(31, \\\"Ridge Grower\\\", 0.152), ration(32, \\\"Ridge Finisher\\\", 0.171)],\\n      comparisons: [\\n        { rationId: 31, rationName: \\\"Ridge Grower\\\", costPerLbUsd: 0.152, lotName: \\\"Lot 91\\\", adgLbPerDay: 3.3, costOfGainPerLbUsd: 0.9, lowestCostOfGain: true },\\n        ... (11010 more characters not kept)","output":"{\"type\":\"create\",\"filePath\":\"/work/tests/acceptance.part2.test.tsx\",\"content\":\"// @vitest-environment jsdom\\nimport { afterAll, afterEach, beforeAll, describe, expect, it, vi } from \\\"vitest\\\";\\nimport { fireEvent, render, screen, waitFor, within } from \\\"@testing-library/react\\\";\\nimport userEvent from \\\"@testing-library/user-event\\\";\\nimport { HttpResponse, http } from \\\"msw\\\";\\nimport { setupServer } from \\\"msw/node\\\";\\nimport { FeedManagementContainer } from \\\"@/components/screens/s-3/container\\\";\\nimport { at } from \\\"./support/screen\\\";\\nimport {\\n  getFeedlotWorkspaceAPIMock,\\n  getGetFeedForecastMockHandler,\\n  getGetFeedInventoryMockHandler,\\n  getGetFeedingPlansMockHandler,\\n  getGetOverviewMockHandler,\\n  getGetOverviewResponseMock,\\n  getGetRationComparisonMockHandler,\\n  getGetRationsMockHandler,\\n  getGetYardRecordsMockHandler,\\n  getGetYardRecordsResponseMock,\\n} from \\\"@/lib/api/client.msw\\\";\\nimport type {\\n  CostSnapshot,\\n  FeedForecastResponse,\\n  FeedingEvent,\\n  FeedingPlan,\\n  InventoryItem,\\n  LotAllocation,\\n  LotSummary,\\n  PenSummary,\\n  Ration,\\n  RationComparisonRow,\\n} from \\\"@/lib/api/client.schemas\\\";\\n\\n// ---------- API stand-in (the contract's generated handlers, with this file's own rows) ----------\\n\\nconst server = setupServer(...getFeedlotWorkspaceAPIMock());\\nbeforeAll(() => server.listen({ onUnhandledRequest: \\\"bypass\\\" }));\\nafterEach(() => { server.resetHandlers(); vi.unstubAllGlobals(); vi.restoreAllMocks(); });\\nafterAll(() => server.close());\\n\\nconst item = (itemId: number, name: string, category: string, availableQuantityLb: number, ton: number): InventoryItem => ({\\n  itemId, name, category, availableQuantityLb, unitOfMeasure: \\\"lb\\\",\\n  unitCostUsdPerTon: ton, unitCostUsdPerLb: Math.round((ton / 2000) * 1000) / 1000,\\n  dryMatterPercent: 88, energyMcalPerLb: 0.8, storageLocation: `Bin Z-${itemId}`,\\n  openingStockLb: availableQuantityLb + 1000, receivedStockLb: 0, consumedStockLb: 1000, closingStockLb: availableQuantityLb,\\n});\\n\\nconst ration = (rationId: number, name: string, costPerLbUsd: number, extra: Partial<Ration> = {}): Ration => ({\\n  rationId, name, type: \\\"Grower\\\", ingredients: [], costPerLbUsd, dryMatterPercent: 88, energyMcalPerLb: 0.7,\\n  intendedAnimalType: \\\"Steers\\\", intendedWeightRangeLb: \\\"650–850 lb\\\", ...extra,\\n});\\n\\nconst lot = (lotId: number, lotName: string, penName: string, headCount: number): LotSummary => ({\\n  lotId, lotName, headCount, breed: \\\"Angus\\\", sex: \\\"Steer\\\", penName, rationName: \\\"Ridge Grower\\\",\\n  feedConsumedLb: 0, startingWeightLb: 700, currentWeightLb: 800, adgLbPerDay: 3.2, fcr: 6, costOfGainPerLb: 0.9,\\n});\\n\\nconst pen = (penId: number, penName: string, animalCount: number): PenSummary => ({\\n  penId, penName, animalCount, capacity: 400, rationName: \\\"Ridge Grower\\\", dailyBunkRateLbPerHead: 25,\\n  plannedFeedLb: 0, actualFeedLb: 0, currentWeightLb: 800, adgLbPerDay: 3.2,\\n});\\n\\nconst PENS: PenSummary[] = [\\n  pen(33, \\\"Pen 33\\\", 180), pen(41, \\\"Pen 41\\\", 250), pen(51, \\\"Pen 51\\\", 250),\\n  pen(61, \\\"Pen 61\\\", 240), pen(62, \\\"Pen 62\\\", 220), pen(71, \\\"Pen 71\\\", 260), pen(72, \\\"Pen 72\\\", 200),\\n];\\nconst LOTS: LotSummary[] = [\\n  lot(331, \\\"33-A\\\", \\\"Pen 33\\\", 180),\\n  lot(411, \\\"41-A\\\", \\\"Pen 41\\\", 130), lot(412, \\\"41-B\\\", \\\"Pen 41\\\", 120),\\n  lot(511, \\\"51-A\\\", \\\"Pen 51\\\", 150), lot(512, \\\"51-B\\\", \\\"Pen 51\\\", 100),\\n  lot(611, \\\"61-A\\\", \\\"Pen 61\\\", 140), lot(612, \\\"61-B\\\", \\\"Pen 61\\\", 100),\\n  lot(621, \\\"62-A\\\", \\\"Pen 62\\\", 120), lot(622, \\\"62-B\\\", \\\"Pen 62\\\", 100),\\n  lot(711, \\\"71-A\\\", \\\"Pen 71\\\", 150), lot(712, \\\"71-B\\\", \\\"Pen 71\\\", 110),\\n  lot(721, \\\"72-A\\\", \\\"Pen 72\\\", 120), lot(722, \\\"72-B\\\", \\\"Pen 72\\\", 80),\\n];\\n\\nconst RATIONS: Ration[] = [ration(31, \\\"Ridge Grower\\\", 0.152), ration(32, \\\"Ridge Finisher\\\", 0.171)];\\nconst ITEMS: InventoryItem[] = [\\n  item(21, \\\"Rolled barley\\\", \\\"Grain\\\", 14820, 418),\\n  item(22, \\\"Cottonseed hulls\\\", \\\"Forage\\\", 9365, 276),\\n  item(23, \\\"Wheat midds\\\", \\\"By-product\\\", 20110, 590),\\n];\\n\\nconst plan = (o: Partial<FeedingPlan> & { planId: number; penId: number; penName: string }): FeedingPlan => ({\\n  rationId: 31, rationName: \\\"Ridge Grower\\\", feedingDate: \\\"2026-01-16\\\", plannedFeedingTime: \\\"05:45\\\", animalCount: 250,\\n  perAnimalDailyRateLb: 26, plannedQuantityLb: 6500, quantityPerAnimalLb: 26, totalFeedCostUsd: 800, expectedEnergyIntakeMcal: 4000,\\n  status: \\\"Planned\\\", allocations: [], allocationReconciled: true, allocationDifferenceLb: 0, ...o,\\n});\\n\\nconst snapshot = (unit: number, qty = 1000): CostSnapshot => ({ itemId: 21, ingredientName: \\\"Rolled barley\\\", quantityLb: qty, unitCostUsdPerLb: unit });\\n\\nconst event = (o: Partial<FeedingEvent> & { eventId: number; planId: number; penId: number; penName: string }): FeedingEvent => ({\\n  rationName: \\\"Ridge Grower\\\", plannedQuantityLb: 7000, actualDeliveredQuantityLb: 7000, varianceLb: 0, feedCostUsd: 900, energyMcal: 4000,\\n  inventoryDecrementLb: 7000, wastageAdjustedEstimatedConsumptionLb: 7000, status: \\\"Complete\\\", allocations: [], costSnapshots: [],\\n  createdBy: \\\"operator\\\", createdAt: \\\"2026-01-15T12:00:00.000Z\\\", lastChangedBy: \\\"operator\\\", lastChangedAt: \\\"2026-01-15T12:00:00.000Z\\\", ...o,\\n});\\n\\nconst alloc = (lotId: number, lotName: string, quantityLb: number): LotAllocation => ({ lotId, lotName, quantityLb });\\n\\ninterface World {\\n  items?: InventoryItem[];\\n  rations?: Ration[];\\n  plans?: FeedingPlan[];\\n  comparisons?: RationComparisonRow[];\\n  forecast?: (ingredientId: number) => FeedForecastResponse;\\n  currency?: string;\\n}\\n\\nfunction serve(w: World = {}, ...extra: ReturnType<typeof http.post>[]) {\\n  const lots = LOTS;\\n  const pens = PENS;\\n  server.use(\\n    ...extra,\\n    getGetFeedInventoryMockHandler({ currency: w.currency ?? \\\"USD\\\", items: w.items ?? ITEMS }),\\n    getGetRationsMockHandler({ currency: w.currency ?? \\\"USD\\\", rations: w.rations ?? RATIONS }),\\n    getGetFeedingPlansMockHandler({ plans: w.plans ?? [] }),\\n    getGetRationComparisonMockHandler({ comparisons: w.comparisons ?? [] }),\\n    getGetOverviewMockHandler({ ...getGetOverviewResponseMock(), lots, pens }),\\n    getGetYardRecordsMockHandler({ ...getGetYardRecordsResponseMock(), lots, pens }),\\n    getGetFeedForecastMockHandler((info) => {\\n      const id = Number(new URL(info.request.url).searchParams.get(\\\"ingredientId\\\") ?? (w.items ?? ITEMS)[0].itemId);\\n      return w.forecast ? w.forecast(id) : { itemId: id, ingredientName: \\\"Rolled barley\\\", wastageRatio: 0.045, periods: [] };\\n    }),\\n  );\\n}\\n\\n// ---------- reading and acting on the page ----------\\n\\nconst bodyText = () => (document.body.textContent ?? \\\"\\\").replace(/\\\\s+/g, \\\" \\\");\\n\\n/** a number as a person may see it: thousands commas optional, minus sign required for negatives */\\nfunction numRe(n: number | string): RegExp {\\n  const s = String(n);\\n  const neg = s.startsWith(\\\"-\\\");\\n  const [int, dec] = (neg ? s.slice(1) : s).split(\\\".\\\");\\n  const intPat = int.replace(/\\\\B(?=(\\\\d{3})+$)/g, \\\",?\\\");\\n  return new RegExp(`(?<![\\\\\\\\d,.])${neg ? \\\"[-−–]\\\\\\\\s?\\\" : \\\"\\\"}${intPat}${dec ? `\\\\\\\\.${dec}` : \\\"\\\"}(?!\\\\\\\\d|,\\\\\\\\d|\\\\\\\\.\\\\\\\\d)`);\\n}\\n\\nasync function until(re: RegExp, timeout = 4000) {\\n  await waitFor(() => expect(bodyText()).toMatch(re), { timeout });\\n}\\n\\nconst ROW = \\\"tr, [role='row'], li, [role='listitem'], article\\\";\\n\\n/** some row / card / list entry whose name matches `name` also shows every one of `needs` (page-wide when the page has no such container) */\\nasync function expectRow(name: RegExp, ...needs: RegExp[]) {\\n  await waitFor(() => {\\n    const containers = new Set<Element>();\\n    for (const el of screen.queryAllByText(name)) { const c = el.closest(ROW); if (c) containers.add(c); }\\n    const texts = containers.size ? [...containers].map((c) => (c.textContent ?? \\\"\\\").replace(/\\\\s+/g, \\\" \\\")) : [bodyText()];\\n    expect(texts.some((t) => name.test(t) && needs.every((re) => re.test(t))), `no row for ${name} shows ${needs.join(\\\" and \\\")}; rows: ${texts.join(\\\" | \\\")}`).toBe(true);\\n  }, { timeout: 4000 });\\n}\\n\\ntype User = ReturnType<typeof userEvent.setup>;\\n\\nasync function openMenuItem(user: User, trigger: string, entry: string) {\\n  await user.click(await screen.findByRole(\\\"button\\\", { name: trigger }));\\n  const target = await Promise.any([\\n    screen.findByRole(\\\"menuitem\\\", { name: entry }),\\n    screen.findByRole(\\\"button\\\", { name: entry }),\\n    screen.findByRole(\\\"link\\\", { name: entry }),\\n  ]);\\n  await user.click(target);\\n}\\n\\nasync function fill(user: User, label: RegExp, value: string) {\\n  const el = (await screen.findByLabelText(label)) as HTMLInputElement;\\n  if (el.type === \\\"date\\\" || el.type === \\\"time\\\") { fireEvent.change(el, { target: { value } }); return; }\\n  await user.clear(el);\\n  await user.type(el, value);\\n}\\n\\nasync function choose(user: User, label: RegExp, option: RegExp) {\\n  const el = await screen.findByLabelText(label);\\n  if (el.tagName === \\\"SELECT\\\") {\\n    const opt = within(el).getAllByRole(\\\"option\\\").find((o) => option.test(o.textContent ?? \\\"\\\"));\\n    if (!opt) throw new Error(`no option ${option} in ${label}`);\\n    await user.selectOptions(el, opt as HTMLOptionElement);\\n    return;\\n  }\\n  await user.click(el);\\n  await user.click(await screen.findByRole(\\\"option\\\", { name: option }));\\n}\\n\\n/** per-lot fields when the form has them, else the allocation text box in the approved form's \\\"Lot 14-A: 3,200 lb; ...\\\" shape */\\nasync function fillAllocations(user: User, entries: { lot: string; qty: number }[]) {\\n  const perLot = screen.queryAllByLabelText(new RegExp(entries[0].lot, \\\"i\\\"));\\n  if (perLot.length) {\\n    for (const e of entries) await fill(user, new RegExp(e.lot, \\\"i\\\"), String(e.qty));\\n    return;\\n  }\\n  const text = entries.map((e) => `Lot ${e.lot}: ${e.qty.toLocaleString(\\\"en-US\\\")} lb`).join(\\\"; \\\");\\n  await fill(user, /allocation/i, text);\\n}\\n\\nfunction open() {\\n  at(\\\"/feed\\\");\\n  const user = userEvent.setup();\\n  render(<FeedManagementContainer />);\\n  return user;\\n}\\n\\nasync function startPlan(user: User, penName: RegExp) {\\n  await openMenuItem(user, \\\"Feeding entry\\\", \\\"Plan feeding\\\");\\n  await choose(user, /^pen/i, penName);\\n  await choose(user, /selected ration/i, /Ridge Grower/);\\n}\\n\\nasync function recordActual(user: User, o: { plan: RegExp; qty: number; allocations: { lot: string; qty: number }[] }) {\\n  await openMenuItem(user, \\\"Feeding entry\\\", \\\"Record actual\\\");\\n  await choose(user, /saved plan/i, o.plan);\\n  await fill(user, /delivered quantity/i, String(o.qty));\\n  await fill(user, /actual feeding time/i, \\\"05:50\\\");\\n  await fillAllocations(user, o.allocations);\\n  await user.click(await screen.findByRole(\\\"button\\\", { name: \\\"Save actual feeding\\\" }));\\n}\\n\\nasync function openDetailIfAny(user: User) {\\n  const b = screen.queryAllByRole(\\\"button\\\", { name: /detail|view record|open record/i })[0] ?? screen.queryAllByRole(\\\"link\\\", { name: /detail|view record|open record/i })[0];\\n  if (b) await user.click(b);\\n}\\n\\nconst T = 25000;\\n\\n// ---------- REQ-9 ----------\\n\\ndescribe(\\\"REQ-9 stock refusal\\\", () => {\\n  it(\\\"AC_9_1_ShowsRefusalAndShortageKeepsFormAndSavesNothing\\\", async () => {\\n    const hulls = item(22, \\\"Cottonseed hulls\\\", \\\"Forage\\\", 625, 276);\\n    let posts = 0;\\n    serve({ items: [ITEMS[0], hulls, ITEMS[2]] }, http.post(\\\"*/feed/stock-movements\\\", () => {\\n      posts++;\\n      return HttpResponse.json({ code: \\\"insufficient_stock\\\", message: \\\"Issue refused: balance would go negative\\\", shortageLb: 1875, availableQuantityLb: 625, requestedQuantityLb: 2500, saved: false }, { status: 409 });\\n    }));\\n    const user = open();\\n    await screen.findByText(\\\"Feed management\\\");\\n\\n    const direct = screen.queryAllByRole(\\\"button\\\", { name: /movement/i })[0];\\n    if (dire