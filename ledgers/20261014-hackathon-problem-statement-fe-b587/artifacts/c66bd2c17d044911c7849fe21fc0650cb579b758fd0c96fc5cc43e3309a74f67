:00:00.000Z\\\", lastChangedBy: \\\"operator\\\", lastChangedAt: \\\"2026-01-15T12:00:00.000Z\\\", ...o,\\n});\\n\\nconst alloc = (lotId: number, lotName: string, quantityLb: number): LotAllocation => ({ lotId, lotName, quantityLb });\\n\\ninterface World {\\n  items?: InventoryItem[];\\n  rations?: Ration[];\\n  plans?: FeedingPlan[];\\n  comparisons?: RationComparisonRow[];\\n  forecast?: (ingredientId: number) => FeedForecastResponse;\\n  currency?: string;\\n}\\n\\nfunction serve(w: World = {}, ...extra: ReturnType<typeof http.post>[]) {\\n  const lots = LOTS;\\n  const pens = PENS;\\n  server.use(\\n    ...extra,\\n    getGetFeedInventoryMockHandler({ currency: w.currency ?? \\\"USD\\\", items: w.items ?? ITEMS }),\\n    getGetRationsMockHandler({ currency: w.currency ?? \\\"USD\\\", rations: w.rations ?? RATIONS }),\\n    getGetFeedingPlansMockHandler({ plans: w.plans ?? [] }),\\n    getGetRationComparisonMockHandler({ comparisons: w.comparisons ?? [] }),\\n    getGetOverviewMockHandler({ ...getGetOverviewResponseMock(), lots, pens }),\\n    getGetYardRecordsMockHandler({ ...getGetYardRecordsResponseMock(), lots, pens }),\\n    getGetFeedForecastMockHandler((info) => {\\n      const id = Number(new URL(info.request.url).searchParams.get(\\\"ingredientId\\\") ?? (w.items ?? ITEMS)[0].itemId);\\n      return w.forecast ? w.forecast(id) : { itemId: id, ingredientName: \\\"Rolled barley\\\", wastageRatio: 0.045, periods: [] };\\n    }),\\n  );\\n}\\n\\n// ---------- reading and acting on the page ----------\\n\\nconst bodyText = () => (document.body.textContent ?? \\\"\\\").replace(/\\\\s+/g, \\\" \\\");\\n\\n/** a number as a person may see it: thousands commas optional, minus sign required for negatives */\\nfunction numRe(n: number | string): RegExp {\\n  const s = String(n);\\n  const neg = s.startsWith(\\\"-\\\");\\n  const [int, dec] = (neg ? s.slice(1) : s).split(\\\".\\\");\\n  const intPat = int.replace(/\\\\B(?=(\\\\d{3})+$)/g, \\\",?\\\");\\n  return new RegExp(`(?<![\\\\\\\\d,.])${neg ? \\\"[-−–]\\\\\\\\s?\\\" : \\\"\\\"}${intPat}${dec ? `\\\\\\\\.${dec}` : \\\"\\\"}(?!\\\\\\\\d|,\\\\\\\\d|\\\\\\\\.\\\\\\\\d)`);\\n}\\n\\nasync function until(re: RegExp, timeout = 4000) {\\n  await waitFor(() => expect(bodyText()).toMatch(re), { timeout });\\n}\\n\\nconst ROW = \\\"tr, [role='row'], li, [role='listitem'], article\\\";\\n\\n/** some row / card / list entry whose name matches `name` also shows every one of `needs` (page-wide when the page has no such container) */\\nasync function expectRow(name: RegExp, ...needs: RegExp[]) {\\n  await waitFor(() => {\\n    const containers = new Set<Element>();\\n    for (const el of screen.queryAllByText(name)) { const c = el.closest(ROW); if (c) containers.add(c); }\\n    const texts = containers.size ? [...containers].map((c) => (c.textContent ?? \\\"\\\").replace(/\\\\s+/g, \\\" \\\")) : [bodyText()];\\n    expect(texts.some((t) => name.test(t) && needs.every((re) => re.test(t))), `no row for ${name} shows ${needs.join(\\\" and \\\")}; rows: ${texts.join(\\\" | \\\")}`).toBe(true);\\n  }, { timeout: 4000 });\\n}\\n\\ntype User = ReturnType<typeof userEvent.setup>;\\n\\nasync function openMenuItem(user: User, trigger: string, entry: string) {\\n  await user.click(await screen.findByRole(\\\"button\\\", { name: trigger }));\\n  const target = await Promise.any([\\n    screen.findByRole(\\\"menuitem\\\", { name: entry }),\\n    screen.findByRole(\\\"button\\\", { name: entry }),\\n    screen.findByRole(\\\"link\\\", { name: entry }),\\n  ]);\\n  await user.click(target);\\n}\\n\\nasync function fill(user: User, label: RegExp, value: string) {\\n  const el = (await screen.findByLabelText(label)) as HTMLInputElement;\\n  if (el.type === \\\"date\\\" || el.type === \\\"time\\\") { fireEvent.change(el, { target: { value } }); return; }\\n  await user.clear(el);\\n  await user.type(el, value);\\n}\\n\\nasync function choose(user: User, label: RegExp, option: RegExp) {\\n  const el = await screen.findByLabelText(label);\\n  if (el.tagName === \\\"SELECT\\\") {\\n    const opt = within(el).getAllByRole(\\\"option\\\").find((o) => option.test(o.textContent ?? \\\"\\\"));\\n    if (!opt) throw new Error(`no option ${option} in ${label}`);\\n    await user.selectOptions(el, opt as HTMLOptionElement);\\n    return;\\n  }\\n  await user.click(el);\\n  await user.click(await screen.findByRole(\\\"option\\\", { name: option }));\\n}\\n\\n/** per-lot fields when the form has them, else the allocation text box in the approved form's \\\"Lot 14-A: 3,200 lb; ...\\\" shape */\\nasync function fillAllocations(user: User, entries: { lot: string; qty: number }[]) {\\n  const perLot = screen.queryAllByLabelText(new RegExp(entries[0].lot, \\\"i\\\"));\\n  if (perLot.length) {\\n    for (const e of entries) await fill(user, new RegExp(e.lot, \\\"i\\\"), String(e.qty));\\n    return;\\n  }\\n  const text = entries.map((e) => `Lot ${e.lot}: ${e.qty.toLocaleString(\\\"en-US\\\")} lb`).join(\\\"; \\\");\\n  await fill(user, /allocation/i, text);\\n}\\n\\nfunction open() {\\n  at(\\\"/feed\\\");\\n  const user = userEvent.setup();\\n  render(<FeedManagementContainer />);\\n  return user;\\n}\\n\\nasync function startPlan(user: User, penName: RegExp) {\\n  await openMenuItem(user, \\\"Feeding entry\\\", \\\"Plan feeding\\\");\\n  await choose(user, /^pen/i, penName);\\n  await choose(user, /selected ration/i, /Ridge Grower/);\\n}\\n\\nasync function recordActual(user: User, o: { plan: RegExp; qty: number; allocations: { lot: string; qty: number }[] }) {\\n  await openMenuItem(user, \\\"Feeding entry\\\", \\\"Record actual\\\");\\n  await choose(user, /saved plan/i, o.plan);\\n  await fill(user, /delivered quantity/i, String(o.qty));\\n  await fill(user, /actual feeding time/i, \\\"05:50\\\");\\n  await fillAllocations(user, o.allocations);\\n  await user.click(await screen.findByRole(\\\"button\\\", { name: \\\"Save actual feeding\\\" }));\\n}\\n\\nasync function openDeta