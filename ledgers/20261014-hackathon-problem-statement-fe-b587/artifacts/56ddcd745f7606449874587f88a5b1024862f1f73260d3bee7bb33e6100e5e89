R 5.94; USD 1.87 per kg gain\\\"),\\n    highestAdgLot: card(\\\"Highest ADG lot\\\", \\\"Prairie 31\\\", \\\"1.93 kg per day\\\"),\\n    mostUsedRation: card(\\\"Most-used ration\\\", \\\"Finisher Plus\\\", \\\"5,317 kg per day; 11 pens\\\"),\\n    planAlignment: card(\\\"Plan alignment and remaining inventory\\\", \\\"93.7 percent\\\", \\\"44.1 t planned; 40.9 t delivered; 7.3 days cover\\\"),\\n    feedExceptions: [card(\\\"Pen 05 underfed\\\", \\\"\\\", \\\"17 percent below plan\\\"), card(\\\"Pen 19 overfed\\\", \\\"\\\", \\\"23 percent above plan\\\")],\\n    feedToGainRows: POOL,\\n    filterOptions: {\\n      lots: POOL.map((r) => ({ id: r.lotId, name: r.lotName })),\\n      breeds: [\\\"Angus\\\", \\\"Hereford\\\", \\\"Charolais\\\"],\\n      pens: [...new Map(POOL.map((r) => [r.penId, { id: r.penId, name: r.penName }])).values()],\\n    },\\n    ...over,\\n  };\\n}\\nfunction serveInsights(over: Partial<InsightsResponse> = {}) {\\n  server.use(http.get(\\\"*/api/insights\\\", () => HttpResponse.json(insights(over))), reportHandler());\\n}\\nfunction renderReports() {\\n  at(\\\"/insights\\\");\\n  return render(<ReportsProjectBriefContainer />);\\n}\\nconst reportRequests = () => requests.filter((u) => /\\\\/api\\\\/reports\\\\/feed-to-gain(\\\\?|$)/.test(u));\\nconst exportUrls = (kind: \\\"csv\\\" | \\\"pdf\\\") =>\\n  [...requests, ...anchorClicks, ...opened, ...nav.went].filter((u) => new RegExp(`feed-to-gain/export\\\\\\\\.${kind}`).test(u));\\n\\n// ---------- overview data ----------\\nfunction overview(over: Partial<OverviewResponse> = {}): OverviewResponse {\\n  const base = getGetOverviewResponseMock();\\n  const lot = (id: number, name: string, headCount: number, rationName: string, feedTons: number, energyGJ: number, s: number, c: number, adg: number, fcr: number, cost: number, best: boolean, worst: boolean) =>\\n    ({ ...base.lots[0], id, name, headCount, rationName, feedTons, energyGJ, startingWeightLb: s, currentWeightLb: c, totalWeightGainLb: c - s, adgLbPerDay: adg, feedConversionRatio: fcr, costOfGain: cost, bestPerformer: best, worstPerformer: worst });\\n  const pen = (id: number, name: string, headCount: number, rationName: string, use: number, bunk: number, plan: number, actual: number, w: number, adg: number) =>\\n    ({ ...base.pens[0], id, name, headCount, rationName, rationUseTons: use, bunkRateLbPerHead: bunk, plannedFeedTons: plan, actualFeedTons: actual, currentWeightLb: w, adgLbPerDay: adg });\\n  return {\\n    ...base,\\n    summary: {\\n      ...base.summary, activeLots: 3, activePens: 3, totalHead: 431, averageAdgLbPerDay: 3.27, averageCostOfGain: 1.41, currency: \\\"USD\\\",\\n      feedCostToday: 1913, feedCostPlannedToday: 1788, stockCoverDays: 5.7, feedActualTons: 5.3, feedPlannedTons: 4.9,\\n    },\\n    lots: [\\n      lot(71, \\\"Aspen 7\\\", 112, \\\"Grower 71\\\", 1.12, 21.3, 701, 1093, 3.41, 6.05, 1.18, true, false),\\n      lot(72, \\\"Birch 3\\\", 163, \\\"Finisher 74\\\", 1.64, 31.2, 733, 1117, 3.26, 6.37, 1.39, false, false),\\n      lot(73, \\\"Cypress 8\\\", 156, \\\"Step-up 5\\\", 1.3, 24.7, 698, 1006, 2.88, 7.11, 1.67, false, true),\\n    ],\\n    pens: [\\n      pen(41, \\\"P-41\\\", 28, \\\"Grower 71\\\", 0.23, 24.8, 0.25, 0.23, 1096, 3.34),\\n      pen(42, \\\"P-42\\\", 26, \\\"Finisher 74\\\", 0.26, 23.7, 0.27, 0.26, 1091, 3.29),\\n      pen(43, \\\"P-43\\\", 24, \\\"Step-up 5\\\", 0.22, 22.9, 0.21, 0.22, 1124, 3.28),\\n    ],\\n    ...over,\\n  };\\n}\\nfunction renderOverview(data: OverviewResponse) {\\n  server.use(http.get(\\\"*/api/overview\\\", () => HttpResponse.json(data)));\\n  at(\\\"/overview\\\");\\n  return render(<YardOverviewContainer />);\\n}\\n\\ndescribe(\\\"part 4: dashboard, reports, exports, yard summary, sample data\\\", () => {\\n  it(\\\"AC_24_1_DashboardShowsEveryMeasureAndMarksBestAndWorstLots\\\", async () => {\\n    renderOverview(overview());\\n    await seen(\\\"431\\\", \\\"3.27\\\", \\\"1.41\\\", \\\"1913\\\", \\\"1788\\\", \\\"5.7\\\", \\\"5.3\\\", \\\"4.9\\\");\\n    await expectRow(\\\"Aspen 7\\\", [\\\"112\\\", \\\"Grower 71\\\", \\\"1.12\\\", \\\"21.3\\\", \\\"701\\\", \\\"1093\\\", \\\"3.41\\\", \\\"6.05\\\", \\\"1.18\\\"]);\\n    await expectRow(\\\"Birch 3\\\", [\\\"163\\\", \\\"Finisher 74\\\", \\\"1.64\\\", \\\"31.2\\\", \\\"733\\\", \\\"1117\\\", \\\"3.26\\\", \\\"6.37\\\", \\\"1.39\\\"]);\\n    await expectRow(\\\"Cypress 8\\\", [\\\"156\\\", \\\"Step-up 5\\\", \\\"1.30\\\", \\\"24.7\\\", \\\"698\\\", \\\"1006\\\", \\\"2.88\\\", \\\"7.11\\\", \\\"1.67\\\"]);\\n    await expectRow(\\\"P-41\\\", [\\\"28\\\", \\\"Grower 71\\\", \\\"0.23\\\", \\\"24.8\\\", \\\"0.25\\\", \\\"1096\\\", \\\"3.34\\\"]);\\n    await expectRow(\\\"P-42\\\", [\\\"26\\\", \\\"Finisher 74\\\", \\\"0.26\\\", \\\"23.7\\\", \\\"0.27\\\", \\\"1091\\\", \\\"3.29\\\"]);\\n    await expectRow(\\\"P-43\\\", [\\\"24\\\", \\\"Step-up 5\\\", \\\"0.22\\\", \\\"22.9\\\", \\\"0.21\\\", \\\"1124\\\", \\\"3.28\\\"]);\\n    const best = rowText(await rowOf(\\\"Aspen 7\\\"));\\n    const mid = rowText(await rowOf(\\\"Birch 3\\\"));\\n    const worst = rowText(await rowOf(\\\"Cypress 8\\\"));\\n    expect(best).toMatch(/best/i);\\n    expect(best).not.toMatch(/worst|lowest/i);\\n    expect(worst).toMatch(/worst|lowest/i);\\n    expect(worst).not.toMatch(/best/i);\\n    expect(mid).not.toMatch(/best|worst|lowest/i);\\n  });\\n\\n  it(\\\"AC_25_1_ReportsShowRankingsVarianceInventoryAndCostPerGain\\\", async () => {\\n    serveInsights();\\n    renderReports();\\n    await seen(\\n      \\\"Pen 17\\\", \\\"1391\\\", \\\"Birch 33\\\",\\n      \\\"Willow Bend 22\\\", \\\"5.94\\\", \\\"1.87\\\",\\n      \\\"Prairie 31\\\", \\\"1.93\\\",\\n      \\\"Finisher Plus\\\", \\\"5317\\\", \\\"11 pens\\\",\\n      \\\"93.7\\\", \\\"44.1\\\", \\\"40.9\\\", \\\"7.3\\\",\\n      \\\"Pen 05\\\", \\\"17\\\", \\\"Pen 19\\\", \\\"23\\\",\\n      \\\"2.38\\\",\\n    );\\n    const t = pageText();\\n    expect(t).toMatch(/under[^·]*Pen 05|Pen 05[^·]*under/i);\\n    expect(t).toMatch(/over[^·]*Pen 19|Pen 19[^·]*over/i);\\n    await expectRow(\\\"Cedar 27\\\", [\\\"Hereford\\\", \\\"Steer\\\", \\\"Pen 12\\\", \\\"1.63\\\", \\\"6.42\\\", \\\"2.07\\\"]);\\n  });\\n\\n  it(\\\"AC_26_1_FilteredReportShowsSelectedValuesAndMatchingLotsWithAdgFcrCost\\\", async () => {\\n    serveInsights();\\n    const user = userEvent.setup();\\n    renderReports();\\n    await rowOf(\\\"North Ridge 24\\\");\\n    await pick(user, \\\"Breed\\\", \\\"Hereford\\\");\\n    await pick(user, \\\"Sex\\\", \\\"Steer\\\");\\n    await user.click(screen.getByRole(\\\"button\\\", { name: \\\"Apply filters\\\" }));\\n\\n    await rowOf(\\\"Juniper 33\\\");\\n    await expectRow(\\\"Cedar 27\\\", [\\\"Hereford\\\", \\\"Steer\\\", \\\"Pen 12\\\", \\\"1.63\\\", \\\"6.42\\\", \\\"2.07\\\"]);\\n    await expectRow(\\\"Juniper 33\\\", [\\\"Hereford\\\", \\\"Steer\\\", \\\"Pen 12\\\", \\\"1.57\\\", \\\"6.55\\\", \\\"2.12\\\"]);\\n    await expectRow(\\\"Willow Bend 22\\\", [\\\"Hereford\\\", \\\"Steer\\\", \\\"Pen 03\\\", \\\"1.39\\\", \\\"7.06\\\", \\\"2.31\\\"]);\\n    for (const gone of [\\\"North Ridge 24\\\", \\\"Prairie 31\\\", \\\"Larkspur 19\\\"]) expect(findRow(gone), `${gone} is outside the scope`).toBeNull();\\n    for (const h of [/ADG \\\\(kg\\\\/day\\\\)/, /FCR \\\\(kg\\\\/kg\\\\)/, /Cost of gain/]) expect(screen.getByRole(\\\"columnheader\\\", { name: h })).toBeTruthy();\\n\\n    expect(shownValue(\\\"Breed\\\")).toContain(\\\"Hereford\\\");\\n    expect(radioChecked(\\\"Steer\\\")).toBe(true);\\n    const q = new URL(reportRequests().at(-1)!).searchParams;\\n    expect(q.get(\\\"breed\\\")).toBe(\\\"Hereford\\\");\\n    expect(q.get(\\\"sex\\\")).toBe(\\\"Steer\\\");\\n    expect(Number(q.get(\\\"lotId\\\") ?? 0)).toBe(0);\\n    expect(Number(q.get(\\\"penId\\\") ?? 0)).toBe(0);\\n    expect(q.get(\\\"startDate\\\")).toMatch(/^\\\\d{4}-\\\\d{2}-\\\\d{2}$/);\\n    expect(q.get(\\\"endDate\\\")).toMatch(/^\\\\d{4}-\\\\d{2}-\\\\d{2}$/);\\n  });\\n\\n  it(\\\"AC_26_2_ChangingFiltersRefreshesResultsForNewScope\\\", async () => {\\n    serveInsights();\\n    const user = userEvent.setup();\\n    renderReports();\\n    await rowOf(\\\"North Ridge 24\\\");\\n\\n    await pick(user, \\\"Pen\\\", \\\"Pen 12\\\");\\n    await user.click(screen.getByRole(\\\"button\\\", { name: \\\"Apply filters\\\" }));\\n    await rowOf(\\\"Juniper 33\\\");\\n    await expectRow(\\\"Cedar 27\\\", [\\\"Pen 12\\\", \\\"1.63\\\", \\\"6.42\\\", \\\"2.07\\\"]);\\n    await expectRow(\\\"Juniper 33\\\", [\\\"Pen 12\\\", \\\"1.57\\\", \\\"6.55\\\", \\\"2.12\\\"]);\\n    for (const gone of [\\\"North Ridge 24\\\", \\\"Prairie 31\\\", \\\"Larkspur 19\\\", \\\"Willow Bend 22\\\"]) expect(findRow(gone), `${gone} is outside Pen 12`).toBeNull();\\n    expect(shownValue(\\\"Pen\\\")).toContain(\\\"Pen 12\\\");\\n    expect(new URL(reportRequests().at(-1)!).searchParams.get(\\\"penId\\\")).toBe(\\\"12\\\");\\n\\n    await pick(user, \\\"Lot\\\", \\\"Cedar 27\\\");\\n    await user.click(screen.getByRole(\\\"button\\\", { name: \\\"Apply filters\\\" }));\\n    await waitFor(() => expect(findRow(\\\"Juniper 33\\\")).toBeNull(), { timeout: 5000 });\\n    await expectRow(\\\"Cedar 27\\\", [\\\"Pen 12\\\", \\\"1.63\\\", \\\"6.42\\\", \\\"2.07\\\"]);\\n    expect(shownValue(\\\"Lot\\\")).toContain(\\\"Cedar 27\\\");\\n    expect(shownValue(\\\"Pen\\\")).toContain(\\\"Pen 12\\\");\\n    const q = new URL(reportRequests().at(-1)!).searchParams;\\n    expect(q.get(\\\"lotId\\\")).toBe(\\\"2427\\\");\\n    expect(q.get(\\\"penId\\\")).toBe(\\\"12\\\");\\n  });\\n\\n  it(\\\"AC_27_1_CsvExportCoversSelectedScope\\\", async () => {\\n    serveInsights();\\n    const user = userEvent.setup();\\n    renderReports();\\n    await rowOf(\\\"North Ridge 24\\\");\\n    await pick(user, \\\"Breed\\\", \\\"Hereford\\\");\\n    await pick(user, \\\"Sex\\\", \\\"Steer\\\");\\n    await user.click(screen.getByRole(\\\"button\\\", { name: \\\"Apply filters\\\" }));\\n    await rowOf(\\\"Juniper 33\\\");\\n\\n    await user.click(screen.getByRole(\\\"button\\\", { name: \\\"Export report\\\" }));\\n    await user.click(await screen.findByText(/^CSV$/));\\n\\n    await waitFor(() => expect(exportUrls(\\\"csv\\\").length).toBeGreaterThan(0), { timeout: 5000 });\\n    expect(exportUrls(\\\"pdf\\\")).toHaveLength(0);\\n    const q = new URL(exportUrls(\\\"csv\\\")[0]!, \\\"http://localhost\\\").searchParams;\\n    expect(q.get(\\\"breed\\\")).toBe(\\\"Hereford\\\");\\n    expect(q.get(\\\"sex\\\")).toBe(\\\"Steer\\\");\\n    expect(Number(q.get(\\\"lotId\\\") ?? 0)).toBe(0);\\n    expect(Number(q.get(\\\"penId\\\") ?? 0)).toBe(0);\\n    expect(q.get(\\\"startDate\\\")).toMatch(/^\\\\d{4}-\\\\d{2}-\\\\d{2}$/);\\n    expect(q.get(\\\"endDate\\\")).toMatch(/^\\\\d{4}-\\\\d{2}-\\\\d{2}$/);\\n    expect(await screen.findByText(\\\"CSV report exported for the selected scope.\\\")).toBeTruthy();\\n  });\\n\\n  it(\\\"AC_27_2_PdfExportCoversSelectedScope\\\", async () => {\\n    serveInsights();\\n    const user = userEvent.setup();\\n    renderReports();\\n    await rowOf(\\\"North Ridge 24\\\");\\n    await pick(user, \\\"Pen\\\", \\\"Pen 12\\\");\\n    await pick(user, \\\"Sex\\\", \\\"Steer\\\");\\n    await user.click(screen.getByRole(\\\"button\\\", { name: \\\"Apply filters\\\" }));\\n    await rowOf(\\\"Juniper 33\\\");\\n\\n    await user.click(screen.getByRole(\\\"button\\\", { name: \\\"Export report\\\" }));\\n    await user.click(await screen.findByText(/^PDF$/));\\n\\n    await waitFor(() => expect(exportUrls(\\\"pdf\\\").length).toBeGreaterThan(0), { timeout: 5000 });\\n    expect(exportUrls(\\\"csv\\\")).toHaveLength(0);\\n    const q = new URL(exportUrls(\\\"pdf\\\")[0]!, \\\"http://localhost\\\").searchParams;\\n    expect(q.get(\\\"penId\\\")).toBe(\\\"12\\\");\\n    expect(q.get(\\\"sex\\\")).toBe(\\\"Steer\\\");\\n    expect(Number(q.get(\\\"lotId\\\") ?? 0)).toBe(0);\\n    expect(q.get(\\\"startDate\\\")).toMatch(/^\\\\d{4}-\\\\d{2}-\\\\d{2}$/);\\n    expect(q.get(\\\"endDate\\\")).toMatch(/^\\\\d{4}-\\\\d{2}-\\\\d{2}$/);\\n    expect(await screen.findByText(\\\"PDF report exported for the selected scope.\\\")).toBeTruthy();\\n  });\\n\\n  it(\\\"AC_28_1_YardSummaryShowsHeadAdgCostOfGainAndFeedCost\\\", async () => {\\n    const base = overview();\\n    renderOverview({\\n      ...base,\\n      summary: { ...base.summary, activeLots: 3, totalHead: 417, averageAdgLbPerDay: 3.05, averageCostOfGain: 1.52, feedCostToday: 2064, feedCostPlannedToday: 1999 },\\n      lots: base.lots.map((l, i) => ({ ...l, headCount: [100, 150, 167][i]! })),\\n    });\\n    await seen(\\\"417\\\", \\\"3.05\\\", \\\"1.52\\\", \\\"2064\\\");\\n  });\\n\\n  it(\\\"AC_29_1_OverviewShowsSampleLotPenRationFeedingAndWeightRecords\\\", async () => {\\n    renderOverview(overview());\\n    await expectRow(\\\"Aspen 7\\\", [\\\"Grower 71\\\", \\\"1.12\\\", \\\"701\\\", \\\"1093\\\"]);\\n    await expectRow(\\\"Birch 3\\\", [\\\"Finisher 74\\\", \\\"1.64\\\", \\\"733\\\", \\\"1117\\\"]);\\n    await expectRow(\\\"Cypress 8\\\", [\\\"Step-up 5\\\", \\\"1.30\\\", \\\"698\\\", \\\"1006\\\"]);\\n    await expectRow(\\\"P-41\\\", [\\\"Grower 71\\\", \\\"24.8\\\", \\\"0.25\\\", \\\"0.23\\\", \\\"1096\\\"]);\\n    await expectRow(\\\"P-42\\\", [\\\"Finisher 74\\\", \\\"23.7\\\", \\\"0.27\\\", \\\"0.26\\\", \\\"1091\\\"]);\\n    await expectRow(\\\"P-43\\\", [\\\"Step-up 5\\\", \\\"22.9\\\", \\\"0.21\\\", \\\"0.22\\\", \\\"1124\\\"]);\\n  });\\n\\n  it(\\\"AC_29_1_YardRecordsShowSampleProcurementLotPenAndWeightRecords\\\", async () => {\\n    const base = getGetYardRecordsResponseMock();\\n    const data: YardResponse = {\\n      ...base,\\n      imports: [\\n        { ...base.imports[0]!, id: 1, poNumber: \\\"PO-7731\\\", vendor: \\\"Prairie Grain Supply\\\", sourceId: \\\"src-7731-01\\\", lotName: \\\"L-7701\\\", penName: \\\"P71\\\" },\\n        { ...base.imports[0]!, id: 2, poNumber: \\\"PO-7732\\\", vendor: \\\"Red Mesa Cattle Co.\\\", sourceId: \\\"src-7732-01\\\", lotName: \\\"L-7702\\\", penName: \\\"P72\\\" },\\n        { ...base.imports[0]!, id: 3, poNumber: \\\"PO-... (4270 more characters not kept)","output":"{\"type\":\"create\",\"filePath\":\"/work/tests/acceptance.part4.test.tsx\",\"content\":\"// @vitest-environment jsdom\\nimport { afterAll, afterEach, beforeAll, beforeEach, describe, expect, it, vi } from \\\"vitest\\\";\\nimport { render, screen, waitFor } from \\\"@testing-library/react\\\";\\nimport userEvent from \\\"@testing-library/user-event\\\";\\nimport { http, HttpResponse } from \\\"msw\\\";\\nimport { setupServer } from \\\"msw/node\\\";\\nimport { at, nav } from \\\"./support/screen\\\";\\nimport {\\n  getFeedlotWorkspaceAPIMock,\\n  getGetFeedToGainReportResponseMock,\\n  getGetFeedWorkspaceResponseMock,\\n  getGetInsightsResponseMock,\\n  getGetOverviewResponseMock,\\n  getGetYardRecordsResponseMock,\\n} from \\\"@/lib/api/client.msw\\\";\\nimport type { FeedResponse, FeedToGainRow, InsightsResponse, OverviewResponse, YardResponse } from \\\"@/lib/api/client.schemas\\\";\\nimport { YardOverviewContainer } from \\\"@/components/screens/s-1/container\\\";\\nimport { ProcurementLotRecordsContainer } from \\\"@/components/screens/s-2/container\\\";\\nimport { FeedManagementContainer } from \\\"@/components/screens/s-3/container\\\";\\nimport { ReportsProjectBriefContainer } from \\\"@/components/screens/s-4/container\\\";\\n\\n// ---------- stand-in API ----------\\nconst server = setupServer(...getFeedlotWorkspaceAPIMock());\\nconst requests: string[] = [];\\nconst anchorClicks: string[] = [];\\nconst opened: string[] = [];\\n\\nconst onAnchorClick = (e: Event) => {\\n  const a = (e.target as Element | null)?.closest?.(\\\"a\\\");\\n  if (a) anchorClicks.push((a as HTMLAnchorElement).href);\\n};\\n\\nbeforeAll(() => {\\n  server.listen({ onUnhandledRequest: \\\"bypass\\\" });\\n  server.events.on(\\\"request:start\\\", ({ request }) => { requests.push(request.url); });\\n});\\nafterAll(() => server.close());\\nbeforeEach(() => {\\n  requests.length = 0;\\n  anchorClicks.length = 0;\\n  opened.length = 0;\\n  (URL as unknown as Record<string, unknown>).createObjectURL = vi.fn(() => \\\"blob:test\\\");\\n  (URL as unknown as Record<string, unknown>).revokeObjectURL = vi.fn();\\n  vi.spyOn(HTMLAnchorElement.prototype, \\\"click\\\").mockImplementation(function (this: HTMLAnchorElement) { anchorClicks.push(this.href); });\\n  vi.spyOn(window, \\\"open\\\").mockImplementation((u?: string | URL) => { opened.push(String(u)); return null; });\\n  document.addEventListener(\\\"click\\\", onAnchorClick, true);\\n});\\nafterEach(() => {\\n  document.removeEventListener(\\\"click\\\", onAnchorClick, true);\\n  server.resetHandlers();\\n  vi.unstubAllGlobals();\\n  vi.restoreAllMocks();\\n  delete (URL as unknown as Record<string, unknown>).createObjectURL;\\n  delete (URL as unknown as Record<string, unknown>).revokeObjectURL;\\n});\\n\\n// ---------- helpers ----------\\nconst norm = (s: string) => s.replace(/(\\\\d),(?=\\\\d{3}\\\\b)/g, \\\"$1\\\").replace(/\\\\s+/g, \\\" \\\");\\nfunction pageText(): string {\\n  const vals = [...document.body.querySelectorAll(\\\"input,select,textarea\\\")].map((e) => (e as HTMLInputElement).value).join(\\\" \\\");\\n  return norm(`${document.body.textContent ?? \\\"\\\"} ${vals}`);\\n}\\nasync function seen(...tokens: string[]) {\\n  await waitFor(() => {\\n    const t = pageText();\\n    for (const tok of tokens) expect(t, `page should show \\\"${tok}\\\"`).toContain(tok);\\n  }, { timeout: 5000 });\\n}\\nfunction findRow(text: string | RegExp): HTMLElement | null {\\n  const rows = screen.queryAllByText(text).map((e) => e.closest(\\\"tr,[role=row]\\\")).filter(Boolean) as HTMLElement[];\\n  return rows[0] ?? null;\\n}\\nasync function rowOf(text: string | RegExp): Promise<HTMLElement> {\\n  await waitFor(() => expect(findRow(text), `a table row for ${String(text)}`).not.toBeNull(), { timeout: 5000 });\\n  return findRow(text)!;\\n}\\nconst rowText = (row: HTMLElement) => norm(row.textContent ?? \\\"\\\");\\nasync function expectRow(name: string, cells: string[]) {\\n  const row = await rowOf(name);\\n  const t = rowText(row);\\n  for (const c of cells) expect(t, `row ${name} should show \\\"${c}\\\"`).toContain(c);\\n}\\n\\nasync function pick(user: ReturnType<typeof userEvent.setup>, field: \\\"Lot\\\" | \\\"Breed\\\" | \\\"Pen\\\" | \\\"Sex\\\", option: string) {\\n  if (field === \\\"Sex\\\") {\\n    const radio = screen.queryByRole(\\\"radio\\\", { name: option }) ?? screen.getByLabelText(option);\\n    await user.click(radio);\\n    return;\\n  }\\n  const ctl = screen.queryByRole(\\\"combobox\\\", { name: new RegExp(`^${field}`) }) ?? screen.getByLabelText(field);\\n  if (ctl.tagName === \\\"SELECT\\\") {\\n    await user.selectOptions(ctl, option);\\n    return;\\n  }\\n  await user.click(ctl);\\n  await user.click(await screen.findByRole(\\\"option\\\", { name: option }));\\n}\\nfunction shownValue(field: \\\"Lot\\\" | \\\"Breed\\\" | \\\"Pen\\\"): string {\\n  const ctl = screen.queryByRole(\\\"combobox\\\", { name: new RegExp(`^${field}`) }) ?? screen.getByLabelText(field);\\n  if (ctl.tagName === \\\"SELECT\\\") return (ctl as HTMLSelectElement).selectedOptions[0]?.textContent ?? \\\"\\\";\\n  return `${ctl.textContent ?? \\\"\\\"} ${(ctl as HTMLInputElement).value ?? \\\"\\\"}`;\\n}\\nfunction radioChecked(option: string): boolean {\\n  const r = screen.getByRole(\\\"radio\\\", { name: option });\\n  return (r.getAttribute(\\\"aria-checked\\\") ?? String((r as HTMLInputElement).checked)) === \\\"true\\\";\\n}\\n\\n// ---------- report data ----------\\nconst row = (lotId: number, lotName: string, breed: string, sex: string, penId: number, penName: string, adg: number, fcr: number, costOfGain: number): FeedToGainRow =>\\n  ({ lotId, lotName, breed, sex, penId, penName, adg, fcr, costOfGain, currency: \\\"USD\\\", unit: \\\"kg\\\" });\\nconst POOL: FeedToGainRow[] = [\\n  row(2401, \\\"North Ridge 24\\\", \\\"Angus\\\", \\\"Steer\\\", 8, \\\"Pen 08\\\", 1.72, 6.18, 1.98),\\n  row(2427, \\\"Cedar 27\\\", \\\"Hereford\\\", \\\"Steer\\\", 12, \\\"Pen 12\\\", 1.63, 6.42, 2.07),\\n  row(2431, \\\"Prairie 31\\\", \\\"Hereford\\\", \\\"Heifer\\\", 4, \\\"Pen 04\\\", 1.48, 6.71, 2.19),\\n  row(2419, \\\"Larkspur 19\\\", \\\"Charolais\\\", \\\"Steer\\\", 16, \\\"Pen 16\\\", 1.81, 6.88, 2.2),\\n  row(2422, \\\"Willow Bend 22\\\", \\\"Hereford\\\", \\\"Steer\\\", 3, \\\"Pen 03\\\", 1.39, 7.06, 2.31),\\n  row(2433, \\\"Juniper 33\\\", \\\"Hereford\\\", \\\"Steer\\\", 12, \\\"Pen 12\\\", 1.57, 6.55, 2.12),\\n];\\nfunction scopeRows(q: URLSearchParams): FeedToGainRow[] {\\n  const lot = Number(q.get(\\\"lotId\\\") ?? 0);\\n  const pen = Number(q.get(\\\"penId\\\") ?? 0);\\n  const breed = q.get(\\\"breed\\\");\\n  const sex = q.get(\\\"sex\\\");\\n  return POOL.filter((r) =>\\n    (!lot || r.lotId === lot) && (!pen || r.penId === pen) &&\\n    (!breed || /^all/i.test(breed) || r.breed === breed) && (!sex || /^all$/i.test(sex) || r.sex === sex));\\n}\\nconst reportHandler = () => http.get(\\\"*/api/reports/feed-to-gain\\\", ({ request }) => {\\n  const q = new URL(request.url).searchParams;\\n  return HttpResponse.json({\\n    filters: {\\n      startDate: q.get(\\\"startDate\\\") ?? \\\"2025-03-01\\\", endDate: q.get(\\\"endDate\\\") ?? \\\"2025-03-30\\\",\\n      lotId: Number(q.get(\\\"lotId\\\") ?? 0), breed: q.get(\\\"breed\\\") ?? \\\"All breeds\\\", sex: q.get(\\\"sex\\\") ?? \\\"All\\\", penId: Number(q.get(\\\"penId\\\") ?? 0),\\n    },\\n    rows: scopeRows(q),\\n  });\\n});\\nconst card = (title: string, value: string, detail: string) => ({ title, value, detail });\\nfunction insights(over: Partial<InsightsResponse> = {}): InsightsResponse {\\n  return {\\n    ...getGetInsightsResponseMock(),\\n    costOfGain30Days: 2.38,\\n    currency: \\\"USD\\\",\\n    highestFeedConsumingPen: card(\\\"Highest f