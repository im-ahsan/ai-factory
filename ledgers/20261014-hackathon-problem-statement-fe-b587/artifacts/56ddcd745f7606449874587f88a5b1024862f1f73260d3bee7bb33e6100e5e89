{"ts":1792011946600,"kind":"call","tool":"Write","input":"{\"file_path\":\"/work/tests/acceptance.part4.test.tsx\",\"content\":\"// @vitest-environment jsdom\\nimport { afterAll, afterEach, beforeAll, beforeEach, describe, expect, it, vi } from \\\"vitest\\\";\\nimport { render, screen, waitFor } from \\\"@testing-library/react\\\";\\nimport userEvent from \\\"@testing-library/user-event\\\";\\nimport { http, HttpResponse } from \\\"msw\\\";\\nimport { setupServer } from \\\"msw/node\\\";\\nimport { at, nav } from \\\"./support/screen\\\";\\nimport {\\n  getFeedlotWorkspaceAPIMock,\\n  getGetFeedToGainReportResponseMock,\\n  getGetFeedWorkspaceResponseMock,\\n  getGetInsightsResponseMock,\\n  getGetOverviewResponseMock,\\n  getGetYardRecordsResponseMock,\\n} from \\\"@/lib/api/client.msw\\\";\\nimport type { FeedResponse, FeedToGainRow, InsightsResponse, OverviewResponse, YardResponse } from \\\"@/lib/api/client.schemas\\\";\\nimport { YardOverviewContainer } from \\\"@/components/screens/s-1/container\\\";\\nimport { ProcurementLotRecordsContainer } from \\\"@/components/screens/s-2/container\\\";\\nimport { FeedManagementContainer } from \\\"@/components/screens/s-3/container\\\";\\nimport { ReportsProjectBriefContainer } from \\\"@/components/screens/s-4/container\\\";\\n\\n// ---------- stand-in API ----------\\nconst server = setupServer(...getFeedlotWorkspaceAPIMock());\\nconst requests: string[] = [];\\nconst anchorClicks: string[] = [];\\nconst opened: string[] = [];\\n\\nconst onAnchorClick = (e: Event) => {\\n  const a = (e.target as Element | null)?.closest?.(\\\"a\\\");\\n  if (a) anchorClicks.push((a as HTMLAnchorElement).href);\\n};\\n\\nbeforeAll(() => {\\n  server.listen({ onUnhandledRequest: \\\"bypass\\\" });\\n  server.events.on(\\\"request:start\\\", ({ request }) => { requests.push(request.url); });\\n});\\nafterAll(() => server.close());\\nbeforeEach(() => {\\n  requests.length = 0;\\n  anchorClicks.length = 0;\\n  opened.length = 0;\\n  (URL as unknown as Record<string, unknown>).createObjectURL = vi.fn(() => \\\"blob:test\\\");\\n  (URL as unknown as Record<string, unknown>).revokeObjectURL = vi.fn();\\n  vi.spyOn(HTMLAnchorElement.prototype, \\\"click\\\").mockImplementation(function (this: HTMLAnchorElement) { anchorClicks.push(this.href); });\\n  vi.spyOn(window, \\\"open\\\").mockImplementation((u?: string | URL) => { opened.push(String(u)); return null; });\\n  document.addEventListener(\\\"click\\\", onAnchorClick, true);\\n});\\nafterEach(() => {\\n  document.removeEventListener(\\\"click\\\", onAnchorClick, true);\\n  server.resetHandlers();\\n  vi.unstubAllGlobals();\\n  vi.restoreAllMocks();\\n  delete (URL as unknown as Record<string, unknown>).createObjectURL;\\n  delete (URL as unknown as Record<string, unknown>).revokeObjectURL;\\n});\\n\\n// ---------- helpers ----------\\nconst norm = (s: string) => s.replace(/(\\\\d),(?=\\\\d{3}\\\\b)/g, \\\"$1\\\").replace(/\\\\s+/g, \\\" \\\");\\nfunction pageText(): string {\\n  const vals = [...document.body.querySelectorAll(\\\"input,select,textarea\\\")].map((e) => (e as HTMLInputElement).value).join(\\\" \\\");\\n  return norm(`${document.body.textContent ?? \\\"\\\"} ${vals}`);\\n}\\nasync function seen(...tokens: string[]) {\\n  await waitFor(() => {\\n    const t = pageText();\\n    for (const tok of tokens) expect(t, `page should show \\\"${tok}\\\"`).toContain(tok);\\n  }, { timeout: 5000 });\\n}\\nfunction findRow(text: string | RegExp): HTMLElement | null {\\n  const rows = screen.queryAllByText(text).map((e) => e.closest(\\\"tr,[role=row]\\\")).filter(Boolean) as HTMLElement[];\\n  return rows[0] ?? null;\\n}\\nasync function rowOf(text: string | RegExp): Promise<HTMLElement> {\\n  await waitFor(() => expect(findRow(text), `a table row for ${String(text)}`).not.toBeNull(), { timeout: 5000 });\\n  return findRow(text)!;\\n}\\nconst rowText = (row: HTMLElement) => norm(row.textContent ?? \\\"\\\");\\nasync function expectRow(name: string, cells: string[]) {\\n  const row = await rowOf(name);\\n  const t = rowText(row);\\n  for (const c of cells) expect(t, `row ${name} should show \\\"${c}\\\"`).toContain(c);\\n}\\n\\nasync function pick(user: ReturnType<typeof userEvent.setup>, field: \\\"Lot\\\" | \\\"Breed\\\" | \\\"Pen\\\" | \\\"Sex\\\", option: string) {\\n  if (field === \\\"Sex\\\") {\\n    const radio = screen.queryByRole(\\\"radio\\\", { name: option }) ?? screen.getByLabelText(option);\\n    await user.click(radio);\\n    return;\\n  }\\n  const ctl = screen.queryByRole(\\\"combobox\\\", { name: new RegExp(`^${field}`) }) ?? screen.getByLabelText(field);\\n  if (ctl.tagName === \\\"SELECT\\\") {\\n    await user.selectOptions(ctl, option);\\n    return;\\n  }\\n  await user.click(ctl);\\n  await user.click(await screen.findByRole(\\\"option\\\", { name: option }));\\n}\\nfunction shownValue(field: \\\"Lot\\\" | \\\"Breed\\\" | \\\"Pen\\\"): string {\\n  const ctl = screen.queryByRole(\\\"combobox\\\", { name: new RegExp(`^${field}`) }) ?? screen.getByLabelText(field);\\n  if (ctl.tagName === \\\"SELECT\\\") return (ctl as HTMLSelectElement).selectedOptions[0]?.textContent ?? \\\"\\\";\\n  return `${ctl.textContent ?? \\\"\\\"} ${(ctl as HTMLInputElement).value ?? \\\"\\\"}`;\\n}\\nfunction radioChecked(option: string): boolean {\\n  const r = screen.getByRole(\\\"radio\\\", { name: option });\\n  return (r.getAttribute(\\\"aria-checked\\\") ?? String((r as HTMLInputElement).checked)) === \\\"true\\\";\\n}\\n\\n// ---------- report data ----------\\nconst row = (lotId: number, lotName: string, breed: string, sex: string, penId: number, penName: string, adg: number, fcr: number, costOfGain: number): FeedToGainRow =>\\n  ({ lotId, lotName, breed, sex, penId, penName, adg, fcr, costOfGain, currency: \\\"USD\\\", unit: \\\"kg\\\" });\\nconst POOL: FeedToGainRow[] = [\\n  row(2401, \\\"North Ridge 24\\\", \\\"Angus\\\", \\\"Steer\\\", 8, \\\"Pen 08\\\", 1.72, 6.18, 1.98),\\n  row(2427, \\\"Cedar 27