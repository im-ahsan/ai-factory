{"ts":1792013480891,"kind":"call","tool":"Write","input":"{\"file_path\":\"/work/tests/acceptance.part1.test.tsx\",\"content\":\"// @vitest-environment jsdom\\nimport { afterAll, afterEach, beforeAll, describe, expect, it, vi } from \\\"vitest\\\";\\nimport { cleanup, render, screen, waitFor, within } from \\\"@testing-library/react\\\";\\nimport userEvent from \\\"@testing-library/user-event\\\";\\nimport { setupServer } from \\\"msw/node\\\";\\nimport { at, TEST_NOW } from \\\"./support/screen\\\";\\nimport {\\n  getFeedlotWorkspaceAPIMock,\\n  getCreateInventoryItemMockHandler,\\n  getGetFeedInventoryMockHandler,\\n  getGetImportConflictsMockHandler,\\n  getGetLotForecastMockHandler,\\n  getGetLotForecastsMockHandler,\\n  getGetLotMetricsMockHandler,\\n  getGetLotWeightHistoryMockHandler,\\n  getGetOverviewMockHandler,\\n  getGetYardRecordsMockHandler,\\n  getSaveLotPenMappingsMockHandler,\\n  getSyncProcurementMockHandler,\\n} from \\\"@/lib/api/client.msw\\\";\\nimport type {\\n  ConflictRecord,\\n  InventoryItem,\\n  InventoryItemRequest,\\n  LotForecast,\\n  LotMetricsResponse,\\n  LotSummary,\\n  MappingRequest,\\n  MappingResponse,\\n  OverviewResponse,\\n  PenSummary,\\n  SourceRecord,\\n  SyncRequest,\\n  SyncResponse,\\n  YardResponse,\\n} from \\\"@/lib/api/client.schemas\\\";\\nimport { YardOverviewContainer } from \\\"@/components/screens/s-1/container\\\";\\nimport { ProcurementLotRecordsContainer } from \\\"@/components/screens/s-2/container\\\";\\nimport { FeedManagementContainer } from \\\"@/components/screens/s-3/container\\\";\\n\\n// ---------- test plumbing ----------\\nconst server = setupServer(...getFeedlotWorkspaceAPIMock());\\nconst seenRequests: Request[] = [];\\nbeforeAll(() => {\\n  server.events.on(\\\"request:start\\\", ({ request }) => { seenRequests.push(request); });\\n  server.listen({ onUnhandledRequest: \\\"error\\\" });\\n});\\nafterEach(() => {\\n  server.resetHandlers();\\n  seenRequests.length = 0;\\n  vi.unstubAllGlobals();\\n  vi.restoreAllMocks();\\n});\\nafterAll(() => server.close());\\n\\nconst FIND = { timeout: 5000 };\\nconst norm = (t: string) => t.replace(/(?<=\\\\d),(?=\\\\d{3})/g, \\\"\\\").replace(/\\\\s+/g, \\\" \\\");\\nconst esc = (s: string) => s.replace(/[.*+?^${}()|[\\\\]\\\\\\\\]/g, \\\"\\\\\\\\$&\\\");\\nfunction hasNum(text: string, n: number | string): boolean {\\n  return new RegExp(`(?<![\\\\\\\\d.])${esc(String(n))}(?!\\\\\\\\d)`).test(norm(text));\\n}\\nconst body = () => document.body.textContent ?? \\\"\\\";\\nasync function see(token: string) {\\n  await waitFor(() => expect(body()).toContain(token), FIND);\\n}\\n\\n// smallest enclosing regions (row, card) of every place `token` is shown that do not also hold another record's token\\nfunction scopes(token: string, others: string[]): string[] {\\n  const all = Array.from(document.body.querySelectorAll<HTMLElement>(\\\"*\\\"));\\n  const leaves = all.filter((e) => (e.textContent ?? \\\"\\\").includes(token) && !Array.from(e.children).some((c) => (c.textContent ?? \\\"\\\").includes(token)));\\n  return leaves.map((leaf) => {\\n    let cur: HTMLElement = leaf;\\n    while (cur.parentElement && cur.parentElement !== document.body && !others.some((o) => (cur.parentElement!.textContent ?? \\\"\\\").includes(o))) cur = cur.parentElement;\\n    return cur.textContent ?? \\\"\\\";\\n  });\\n}\\nfunction othersOf(all: string[], one: string) { return all.filter((x) => x !== one); }\\n\\nconst MONTHS = [\\\"January\\\", \\\"February\\\", \\\"March\\\", \\\"April\\\", \\\"May\\\", \\\"June\\\", \\\"July\\\", \\\"August\\\", \\\"September\\\", \\\"October\\\", \\\"November\\\", \\\"December\\\"];\\nfunction showsDate(text: string, d: Date): boolean {\\n  const iso = d.toISOString().slice(0, 10);\\n  const day = d.getUTCDate();\\n  const mon = d.getUTCMonth();\\n  const long = MONTHS[mon];\\n  const short = long.slice(0, 3);\\n  const m = `(?:${long}|${short})\\\\\\\\.?`;\\n  const patterns = [\\n    esc(iso),\\n    `(?<!\\\\\\\\d)0?${day}\\\\\\\\s+${m}(?![a-z])`,\\n    `${m}\\\\\\\\s+0?${day}(?!\\\\\\\\d)`,\\n    `(?<!\\\\\\\\d)0?${day}/0?${mon + 1}/\\\\\\\\d{2,4}`,\\n    `(?<!\\\\\\\\d)0?${mon + 1}/0?${day}/\\\\\\\\d{2,4}`,\\n  ];\\n  return patterns.some((p) => new RegExp(p, \\\"i\\\").test(text));\\n}\\nfunction showsAnyDate(text: string): boolean {\\n  return /\\\\d{4}-\\\\d{2}-\\\\d{2}/.test(text)\\n    || /(?:jan|feb|mar|apr|may|jun|jul|aug|sep|oct|nov|dec)[a-z]*\\\\.?\\\\s+\\\\d{1,2}/i.test(text)\\n    || /\\\\d{1,2}\\\\s+(?:jan|feb|mar|apr|may|jun|jul|aug|sep|oct|nov|dec)/i.test(text)\\n    || /\\\\d{1,2}\\\\/\\\\d{1,2}\\\\/\\\\d{2,4}/.test(text)\\n    || /invalid date|undefined|null|NaN/i.test(text);\\n}\\nconst inDays = (n: number) => new Date(TEST_NOW.getTime() + n * 86_400_000);\\nconst isoDay = (d: Date) => d.toISOString().slice(0, 10);\\n\\n// ---------- data builders (shapes from the contract) ----------\\nconst mkLot = (lotId: number, lotName: string, penName: string): LotSummary => ({\\n  lotId, lotName, headCount: 100 + lotId, breed: \\\"Angus\\\", sex: \\\"Steer\\\", penName, rationName: \\\"Grower\\\",\\n  feedConsumedLb: 1000, startingWeightLb: 600, currentWeightLb: 700, adgLbPerDay: 2.1, fcr: 6.1, costOfGainPerLb: 0.9,\\n});\\nconst mkPen = (penId: number, penName: string, capacity: number, animalCount: number): PenSummary => ({\\n  penId, penName, animalCount, capacity, rationName: \\\"Grower\\\", dailyBunkRateLbPerHead: 24, plannedFeedLb: 2400, actualFeedLb: 2300, currentWeightLb: 700, adgLbPerDay: 2.1,\\n});\\nconst mkRecord = (o: Partial<SourceRecord> & Pick<SourceRecord, \\\"recordId\\\" | \\\"purchaseOrderNumber\\\" | \\\"vendor\\\">): SourceRecord => ({\\n  lineNumber: 1, receiptNumber: `RCV-${o.recordId}`, unitCostUsdPerTon: 1000, headCount: 50, averageWeightLb: 500, breed: \\\"Angus\\\", ageMonths: 8,\\n  source: \\\"SRC-Base\\\", importStatus: \\\"Synced\\\", lotId: 0, lotName: \\\"\\\", penId: 0, penName: \\\"\\\", ...o,\\n});\\nconst mkForecast = (lotId: number, lotName: string, target: number, source: \\\"Lot\\\" | \\\"Yard\\\", adg: number, ship: string | null): LotForecast => ({\\n  lotId, lotName, currentWeightLb: 812, targetWeightLb: target, targetSource: source, adgLbPerDay: adg, projectedShipDate: ship,\\n});\\nconst mkMetrics = (lotId: number, lotName: string): LotMetricsResponse => ({\\n  lotId, lotName,\\n  metrics: { daysOnFeed: 40, totalWeightGainLb: 100, averageDailyGainLbPerDay: 2.5, totalFeedConsumedLb: 800, feedConversionRatio: 8, feedCostPerGainUsdPerLb: 1, projectedShipDate: null, suggestions: [] },\\n});\\nconst mkItem = (o: Partial<InventoryItem> & Pick<InventoryItem, \\\"itemId\\\" | \\\"name\\\">): InventoryItem => ({\\n  category: \\\"Grain\\\", availableQuantityLb: 1000, unitOfMeasure: \\\"lb\\\", unitCostUsdPerTon: 300, unitCostUsdPerLb: 0.15, dryMatterPercent: 88,\\n  energyMcalPerLb: 0.8, storageLocation: \\\"Bin X\\\", openingStockLb: 1, receivedStockLb: 2, consumedStockLb: 3, closingStockLb: 4, ...o,\\n});\\n\\nfunction useYard(yard: YardResponse) {\\n  server.use(\\n    getGetYardRecordsMockHandler(yard),\\n    getGetLotWeightHistoryMockHandler((info) => ({ lotId: Number(info.params.lotId), records: [] })),\\n    getGetLotMetricsMockHandler((info) => {\\n      const lot = yard.lots.find((l) => String(l.lotId) === info.params.lotId) ?? yard.lots[0];\\n      return mkMetrics(lot.lotId, lot.lotName);\\n    }),\\n  );\\n}\\nfunction useForecasts(lots: LotSummary[], forecasts: LotForecast[], yardTarget: number) {\\n  useYard({ purchaseOrders: [], lots, pens: lots.map((l, i) => mkPen(i + 1, l.penName, 400, 250)), forecasts });\\n  server.use(\\n    getGetLotForecastsMockHandler({ yardTargetWeightLb: yardTarget, forecasts }),\\n    getGetLotForecastMockHandler((info) => forecasts.find((f) => String(f.lotId) === info.params.lotId) ?? forecasts[0]),\\n  );\\n}\\nfunction renderYard() {\\n  at(\\\"/yard\\\");\\n  render(<ProcurementLotRecordsContainer />);\\n}\\nfunction renderFeed() {\\n  at(\\\"/feed\\\");\\n  render(<FeedManagementContainer />);\\n}\\nfunction renderOverview() {\\n  at(\\\"/overview\\\");\\n  render(<YardOverviewContainer />);\\n}\\n\\nconst overviewData = (): OverviewResponse => ({\\n  currency: \\\"USD\\\", activeLots: 3, activePens: 3, totalHead: 612, averageAdgLbPerDay: 2.4, averageCostOfGainPerLb: 0.93,\\n  feedCostToday: 4120, plannedFeedLbToday: 9000, deliveredFeedLbToday: 8800,\\n  lots: [mkLot(1, \\\"Lot Overview-Alpha\\\", \\\"OP-1\\\"), mkLot(2, \\\"Lot Overview-Bravo\\\", \\\"OP-2\\\"), mkLot(3, \\\"Lot Overview-Charlie\\\", \\\"OP-3\\\")],\\n  pens: [mkPen(1, \\\"OP-1\\\", 300, 200), mkPen(2, \\\"OP-2\\\", 300, 210), mkPen(3, \\\"OP-3\\\", 300, 202)],\\n});\\nconst inventoryBase = (): InventoryItem[] => [\\n  mkItem({ itemId: 1, name: \\\"Linseed Cake KX\\\", category: \\\"Oilseed\\\", availableQuantityLb: 21350, unitCostUsdPerTon: 392, unitCostUsdPerLb: 0.196, dryMatterPercent: 91.4, energyMcalPerLb: 0.93, storageLocation: \\\"Shed R-7\\\", openingStockLb: 40120, receivedStockLb: 6800, consumedStockLb: 25610, closingStockLb: 21310 }),\\n  mkItem({ itemId: 2, name: \\\"Barley Rolled QZ\\\", category: \\\"Grain\\\", availableQuantityLb: 15780, unitCostUsdPerTon: 282, unitCostUsdPerLb: 0.141, dryMatterPercent: 86.2, energyMcalPerLb: 0.87, storageLocation: \\\"Bin T-3\\\", openingStockLb: 30000, receivedStockLb: 5200, consumedStockLb: 19450, closingStockLb: 15750 }),\\n  mkItem({ itemId: 3, name: \\\"Molasses Blend MP\\\", category: \\\"Liquid\\\", availableQuantityLb: 8940, unitCostUsdPerTon: 164, unitCostUsdPerLb: 0.082, dryMatterPercent: 74.5, energyMcalPerLb: 0.76, storageLocation: \\\"Tank L-5\\\", openingStockLb: 12000, receivedStockLb: 3500, consumedStockLb: 6540, closingStockLb: 8960 }),\\n];\\n\\n// ---------- AC-1: shared workspace, no sign-in, same controls ----------\\nfunction controls(): string[] {\\n  const roles = [\\\"button\\\", \\\"link\\\", \\\"textbox\\\", \\\"combobox\\\", \\\"checkbox\\\", \\\"switch\\\", \\\"tab\\\"] as const;\\n  const out: string[] = [];\\n  for (const role of roles) {\\n    for (const el of screen.queryAllByRole(role)) out.push(`${role}:${(el.getAttribute(\\\"aria-label\\\") ?? el.textContent ?? \\\"\\\").trim()}`);\\n  }\\n  return out.sort();\\n}\\nfunction expectNoSignIn() {\\n  expect(screen.queryByText(/sign in|log in|login|sign-in/i)).toBeNull();\\n  expect(screen.queryByRole(\\\"button\\\", { name: /sign in|log in|login/i })).toBeNull();\\n  expect(screen.queryByRole(\\\"textbox\\\", { name: /password|email|username/i })).toBeNull();\\n  expect(screen.queryByRole(\\\"combobox\\\", { name: /role/i })).toBeNull();\\n  expect(screen.queryByLabelText(/\\\\brole\\\\b/i)).toBeNull();\\n  expect(screen.queryByRole(\\\"radio\\\", { name: /role|admin|operator|viewer/i })).toBeNull();\\n}\\n\\ndescribe(\\\"REQ-1 shared workspace\\\", () => {\\n  it(\\\"AC_1_1_ShowsSharedWorkspaceWithoutSignInOrRoleSelector\\\", async () => {\\n    server.use(getGetOverviewMockHandler(overviewData()));\\n    renderOverview();\\n    await see(\\\"Lot Overview-Alpha\\\");\\n    await see(\\\"Lot Overview-Bravo\\\");\\n    expect(screen.getByRole(\\\"heading\\\", { name: \\\"Yard overview\\\" })).toBeTruthy();\\n    expectNoSignIn();\\n    expect(seenRequests.length).toBeGreaterThan(0);\\n    for (const r of seenRequests) {\\n      expect(r.headers.get(\\\"authorization\\\")).toBeNull();\\n    }\\n    expect(nothingNavigatedToLogin()).toBe(true);\\n  });\\n\\n  it(\\\"AC_1_2_ShowsSameControlsInTwoSessions\\\", async () => {\\n    server.use(\\n      getGetOverviewMockHandler(overviewData()),\\n      getGetFeedInventoryMockHandler({ currency: \\\"USD\\\", items: inventoryBase() }),\\n    );\\n    useYard({ purchaseOrders: [mkRecord({ recordId: 1, purchaseOrderNumber: \\\"PO-1\\\", vendor: \\\"Session Vendor\\\" })], lots: [mkLot(1, \\\"Lot Session-One\\\", \\\"SP-1\\\")], pens: [mkPen(1, \\\"SP-1\\\", 300, 200)] });\\n    const screens: Array<{ name: string; open: () => void; ready: string; required: string[] }> = [\\n      { name: \\\"overview\\\", open: renderOverview, ready: \\\"Lot Overview-Alpha\\\", required: [\\\"Yard records\\\", \\\"Feed ops\\\", \\\"Insights\\\"] },\\n      { name: \\\"yard\\\", open: renderYard, ready: \\\"Lot Session-One\\\", required: [\\\"Sync POs\\\"] },\\n      { name: \\\"feed\\\", open: renderFeed, ready: \\\"Linseed Cake KX\\\", required: [\\\"Feed tools\\\", \\\"Feeding entry\\\", \\\"Reports & project brief\\\"] },\\n    ];\\n    for (const s of screens) {\\n      const sessions: string[][] = [];\\n      for (let session = 0; session < 2; session++) {\\n        s.open();\\n        await see(s.ready);\\n        expectNoSignIn();\\n        sessions.push(controls());\\n        cleanup();\\n      }\\n      expect(sessions[0].length).toBeGreaterThan(0);\\n      for (const name of s.required) expect(sessions[0].some((c) => c.endsWith(`:${name}`)), `${s.name}: control ${name}`).toBe(true);\\n      expect(sessions[1]).toEqual(sessions[0]);\\n    }\\n  });\\n});\\n\\nfunction nothingNavigatedToLogin(): boolean {\\n  return !/login|sign-?in|auth/i.test(window.location.pathname);\\n}\\n\\n// ---------- AC-2: synchronisation ----------\\nconst syncResponse = (): SyncResponse => ({\\n  source: \\\"SRC-Alpha-Feed\\\",\\n  message: \\\"Synchronised 3 lines\\\",\\n  conflicts: [],\\n  records: [\\n    mkRecord({ recordId: 501, purchaseOrderNumber: \\\"PO-61842\\\", lineNumber: 1, receiptNumber: \\\"RCV-90317\\\", vendor: \\\"Prairie Ridge Cattle Co\\\", unitCostUsdPerTon: 1412, headCount: 187, averageWeightLb: 612, breed: \\\"Charolais Cross\\\", ageMonths: 13, source: \\\"SRC-Alpha-Feed\\\", lotId: 11, lotName: \\\"L-9051\\\", penId: 21, penName: \\\"P-31\\\" }),\\n    mkRecord({ recordId: 502, purchaseOrderNumber: \\\"PO-61855\\\", lineNumber: 2, receiptNumber: \\\"RCV-90322\\\", vendor: \\\"Sandhill Livestock LLC\\\", unitCostUsdPerTon: 1538, headCount: 243, averageWeightLb: 748, breed: \\\"Red Angus\\\", ageMonths: 17, source: \\\"SRC-Beta-Feed\\\", lotId: 12, lotName: \\\"L-9052\\\", penId: 22, penName: \\\"P-32\\\" }),\\n    mkRecord({ recordId: 503, purchaseOrderNumber: \\\"PO-61871\\\", lineNumber: 3, receiptNumber: \\\"RCV-90330\\\", vendor: \\\"Cedar Flats Ranch\\\", unitCostUsdPerTon: 1295, headCount: 311, averageWeightLb: 871, breed: \\\"Hereford\\\", ageMonths: 19, source: \\\"SRC-Gamma-Feed\\\", lotId: 13, lotName: \\\"L-9053\\\", penId: 23, penName: \\\"P-33\\\" }),\\n  ],\\n});\\n\\ndescribe(\\\"REQ-2 procurement sync\\\", () => {\\n  it(\\\"AC_2_1_SyncRequestCarriesPoLineVendorCostHeadWeightBreedAgeSource\\\", async () => {\\n    let sent: SyncRequest | undefined;\\n    useYard({ purchaseOrders: [], lots: [mkLot(1, \\\"Lot Sync-One\\\", \\\"SY-1\\\")], pens: [mkPen(1, \\\"SY-1\\\", 300, 200)] });\\n    server.use(getSyncProcurementMockHandler(async (info) => { sent = (await info.request.json()) as SyncRequest; return syncResponse(); }));\\n    const user = userEvent.setup();\\n    renderYard();\\n    await user.click(await screen.findByRole(\\\"button\\\", { name: \\\"Sync POs\\\" }, FIND));\\n    await waitFor(() => expect(sent).toBeDefined(), FIND);\\n    const req = sent!;\\n    expect(typeof req.source).toBe(\\\"string\\\");\\n    expect(req.source.length).toBeGreaterThan(0);\\n    expect(req.purchaseOrderLines.length).toBeGreaterThan(0);\\n    for (const l of req.purchaseOrderLines) {\\n      expect(typeof l.purchaseOrderNumber).toBe(\\\"string\\\");\\n      expect(l.purchaseOrderNumber.length).toBeGreaterThan(0);\\n      expect(Number.isInteger(l.lineNumber)).toBe(true);\\n      expect(typeof l.vendor).toBe(\\\"string\\\");\\n      expect(l.vendor.length).toBeGreaterThan(0);\\n      expect(typeof l.unitCostUsdPerTon).toBe(\\\"number\\\");\\n      expect(l.unitCostUsdPerTon).toBeGreaterThan(0);\\n      expect(Number.isInteger(l.headCount)).toBe(true);\\n      expect(l.headCount).toBeGreaterThan(0);\\n      expect(typeof l.averageWeightLb).toBe(\\\"number\\\");\\n      expect(l.averageWeightLb).toBeGreaterThan(0);\\n      expect(typeof l.breed).toBe(\\\"string\\\");\\n      expect(l.breed.length).toBeGreaterThan(0);\\n      expect(typeof l.ageMonths).toBe(\\\"number\\\");\\n      expect(l.ageMonths).toBeGreaterThan(0);\\n      expect(typeof l.source).toBe(\\\"string\\\");\\n      expect(l.source.length).toBeGreaterThan(0);\\n    }\\n    expect(req.receivingRecords.length).toBeGreaterThan(0);\\n    const poNumbers = req.purchaseOrderLines.map((l) => l.purchaseOrderNumber);\\n    for (const r of req.receivingRecords) {\\n      expect(r.receiptNumber.length).toBeGreaterThan(0);\\n      expect(poNumbers).toContain(r.purchaseOrderNumber);\\n      expect(r.receivedHeadCount).toBeGreaterThan(0);\\n      expect(r.source.length).toBeGreaterThan(0);\\n    }\\n  });\\n\\n  it(\\\"AC_2_2_ShowsReturnedVendorCostHeadWeightBreedAgeSource\\\", async () => {\\n    const result = syncResponse();\\n    let synced = false;\\n    const before = [mkRecord({ recordId: 400, purchaseOrderNumber: \\\"PO-00001\\\", vendor: \\\"Earlier Vendor Inc\\\", unitCostUsdPerTon: 999, headCount: 77, averageWeightLb: 433, breed: \\\"Older Breed\\\", ageMonths: 9, source: \\\"SRC-Old\\\" })];\\n    server.use(\\n      getGetYardRecordsMockHandler(() => ({ purchaseOrders: synced ? result.records : before, lots: [], pens: [] })),\\n      getSyncProcurementMockHandler(() => { synced = true; return result; }),\\n    );\\n    const user = userEvent.setup();\\n    renderYard();\\n    await see(\\\"Earlier Vendor Inc\\\");\\n    await user.click(await screen.findByRole(\\\"button\\\", { name: \\\"Sync POs\\\" }));\\n    for (const r of result.records) await see(r.vendor);\\n    const vendors = result.records.map((r) => r.vendor);\\n    for (const r of result.records) {\\n      const found = scopes(r.vendor, othersOf(vendors, r.vendor));\\n      const ok = found.some((t) =>\\n        hasNum(t, r.unitCostUsdPerTon) && hasNum(t, r.headCount) && hasNum(t, r.averageWeightLb) && hasNum(t, r.ageMonths)\\n        && t.includes(r.breed) && t.includes(r.source));\\n      expect(ok, `values of ${r.vendor} shown together: ${found.join(\\\" || \\\")}`).toBe(true);\\n    }\\n  });\\n});\\n\\n// ---------- AC-3: PO line -> lot -> pen mapping ----------\\nconst mappingYard = (): YardResponse => ({\\n  purchaseOrders: [\\n    mkRecord({ recordId: 701, purchaseOrderNumber: \\\"PO-77231\\\", lineNumber: 2, vendor: \\\"Mapping Vendor A\\\", headCount: 102 }),\\n    mkRecord({ recordId: 702, purchaseOrderNumber: \\\"PO-77248\\\", lineNumber: 1, vendor: \\\"Mapping Vendor B\\\", headCount: 64 }),\\n  ],\\n  lots: [mkLot(31, \\\"LOT-M31\\\", \\\"P-61\\\"), mkLot(32, \\\"LOT-M32\\\", \\\"P-72\\\"), mkLot(33, \\\"LOT-M33\\\", \\\"P-83\\\")],\\n  pens: [mkPen(61, \\\"P-61\\\", 400, 250), mkPen(72, \\\"P-72\\\", 410, 260), mkPen(83, \\\"P-83\\\", 420, 270)],\\n});\\n\\nasync function chooseOptions(user: ReturnType<typeof userEvent.setup>, dialog: HTMLElement, label: RegExp, options: RegExp[]) {\\n  const trigger = within(dialog).getAllByLabelText(label)[0] as HTMLElement;\\n  if (trigger instanceof HTMLSelectElement) {\\n    const match = Array.from(trigger.options).find((o) => options[0].test(o.textContent ?? \\\"\\\"));\\n    await user.selectOptions(trigger, match!.value);\\n    return;\\n  }\\n  for (const re of options) {\\n    await user.click(trigger);\\n    let target: HTMLElement | undefined;\\n    await waitFor(() => {\\n      target = (screen.queryAllByRole(\\\"option\\\", { name: re })[0] ?? screen.queryAllByRole(\\\"menuitemcheckbox\\\", { name: re })[0] ?? screen.queryAllByRole(\\\"checkbox\\\", { name: re })[0]\\n        ?? screen.queryAllByText(re).find((e) => !dialog.contains(e) || e.closest(\\\"[role=listbox],[role=menu],[role=option]\\\"))) as HTMLElement | undefined;\\n      expect(target).toBeDefined();\\n    }, FIND);\\n    await user.click(target!);\\n  }\\n  const heading = within(dialog).queryByRole(\\\"heading\\\");\\n  if (heading) await user.click(heading);\\n}\\n\\nasync function mapPoLine(response: MappingResponse, po: RegExp, lots: RegExp[], pens: RegExp[]): Promise<MappingRequest> {\\n  let sent: MappingRequest | undefined;\\n  useYard(mappingYard());\\n  server.use(getSaveLotPenMappingsMockHandler(async (info) => { sent = (await info.request.json()) as MappingRequest; return response; }));\\n  const user = userEvent.setup({ pointerEventsCheck: 0 });\\n  renderYard();\\n  await see(\\\"LOT-M31\\\");\\n  await user.click(await screen.findByRole(\\\"button\\\", { name: \\\"Map PO line\\\" }));\\n  const dialog = await screen.findByRole(\\\"dialog\\\");\\n  await chooseOptions(user, dialog, /po line/i, [po]);\\n  await chooseOptions(user, dialog, /^lots?$/i, lots);\\n  await chooseOptions(user, dialog, /pen/i, pens);\\n  await user.click(within(dialog).getByRole(\\\"button\\\", { name: /save mapping/i }));\\n  await waitFor(() => expect(sent).toBeDefined(), FIND);\\n  return sent!;\\n}\\n\\ndescribe(\\\"REQ-3 mapping\\\", () => {\\n  it(\\\"AC_3_1_ShowsPoLineToLotToPenAssociationForSingleLot\\\", async () => {\\n    const response: MappingResponse = {\\n      message: \\\"Mapped\\\",\\n      mappings: [{ purchaseOrderNumber: \\\"PO-77231\\\", lineNumber: 2, lo... (13271 more characters not kept)","output":"{\"type\":\"create\",\"filePath\":\"/work/tests/acceptance.part1.test.tsx\",\"content\":\"// @vitest-environment jsdom\\nimport { afterAll, afterEach, beforeAll, describe, expect, it, vi } from \\\"vitest\\\";\\nimport { cleanup, render, screen, waitFor, within } from \\\"@testing-library/react\\\";\\nimport userEvent from \\\"@testing-library/user-event\\\";\\nimport { setupServer } from \\\"msw/node\\\";\\nimport { at, TEST_NOW } from \\\"./support/screen\\\";\\nimport {\\n  getFeedlotWorkspaceAPIMock,\\n  getCreateInventoryItemMockHandler,\\n  getGetFeedInventoryMockHandler,\\n  getGetImportConflictsMockHandler,\\n  getGetLotForecastMockHandler,\\n  getGetLotForecastsMockHandler,\\n  getGetLotMetricsMockHandler,\\n  getGetLotWeightHistoryMockHandler,\\n  getGetOverviewMockHandler,\\n  getGetYardRecordsMockHandler,\\n  getSaveLotPenMappingsMockHandler,\\n  getSyncProcurementMockHandler,\\n} from \\\"@/lib/api/client.msw\\\";\\nimport type {\\n  ConflictRecord,\\n  InventoryItem,\\n  InventoryItemRequest,\\n  LotForecast,\\n  LotMetricsResponse,\\n  LotSummary,\\n  MappingRequest,\\n  MappingResponse,\\n  OverviewResponse,\\n  PenSummary,\\n  SourceRecord,\\n  SyncRequest,\\n  SyncResponse,\\n  YardResponse,\\n} from \\\"@/lib/api/client.schemas\\\";\\nimport { YardOverviewContainer } from \\\"@/components/screens/s-1/container\\\";\\nimport { ProcurementLotRecordsContainer } from \\\"@/components/screens/s-2/container\\\";\\nimport { FeedManagementContainer } from \\\"@/components/screens/s-3/container\\\";\\n\\n// ---------- test plumbing ----------\\nconst server = setupServer(...getFeedlotWorkspaceAPIMock());\\nconst seenRequests: Request[] = [];\\nbeforeAll(() => {\\n  server.events.on(\\\"request:start\\\", ({ request }) => { seenRequests.push(request); });\\n  server.listen({ onUnhandledRequest: \\\"error\\\" });\\n});\\nafterEach(() => {\\n  server.resetHandlers();\\n  seenRequests.length = 0;\\n  vi.unstubAllGlobals();\\n  vi.restoreAllMocks();\\n});\\nafterAll(() => server.close());\\n\\nconst FIND = { timeout: 5000 };\\nconst norm = (t: string) => t.replace(/(?<=\\\\d),(?=\\\\d{3})/g, \\\"\\\").replace(/\\\\s+/g, \\\" \\\");\\nconst esc = (s: string) => s.replace(/[.*+?^${}()|[\\\\]\\\\\\\\]/g, \\\"\\\\\\\\$&\\\");\\nfunction hasNum(text: string, n: number | string): boolean {\\n  return new RegExp(`(?<![\\\\\\\\d.])${esc(String(n))}(?!\\\\\\\\d)`).test(norm(text));\\n}\\nconst body = () => document.body.textContent ?? \\\"\\\";\\nasync function see(token: string) {\\n  await waitFor(() => expect(body()).toContain(token), FIND);\\n}\\n\\n// smallest enclosing regions (row, card) of every place `token` is shown that do not also hold another record's token\\nfunction scopes(token: string, others: string[]): string[] {\\n  const all = Array.from(document.body.querySelectorAll<HTMLElement>(\\\"*\\\"));\\n  const leaves = all.filter((e) => (e.textContent ?? \\\"\\\").includes(token) && !Array.from(e.children).some((c) => (c.textContent ?? \\\"\\\").includes(token)));\\n  return leaves.map((leaf) => {\\n    let cur: HTMLElement = leaf;\\n    while (cur.parentElement && cur.parentElement !== document.body && !others.some((o) => (cur.parentElement!.textContent ?? \\\"\\\").includes(o))) cur = cur.parentElement;\\n    return cur.textContent ?? \\\"\\\";\\n  });\\n}\\nfunction othersOf(all: string[], one: string) { return all.filter((x) => x !== one); }\\n\\nconst MONTHS = [\\\"January\\\", \\\"February\\\", \\\"March\\\", \\\"April\\\", \\\"May\\\", \\\"June\\\", \\\"July\\\", \\\"August\\\", \\\"September\\\", \\\"October\\\", \\\"November\\\", \\\"December\\\"];\\nfunction showsDate(text: string, d: Date): boolean {\\n  const iso = d.toISOString().slice(0, 10);\\n  const day = d.getUTCDate();\\n  const mon = d.getUTCMonth();\\n  const long = MONTHS[mon];\\n  const short = long.slice(0, 3);\\n  const m = `(?:${long}|${short})\\\\\\\\.?`;\\n  const patterns = [\\n    esc(iso),\\n    `(?<!\\\\\\\\d)0?${day}\\\\\\\\s+${m}(?![a-z])`,\\n    `${m}\\\\\\\\s+0?${day}(?!\\\\\\\\d)`,\\n    `(?<!\\\\\\\\d)0?${day}/0?${mon + 1}/\\\\\\\\d{2,4}`,\\n    `(?<!\\\\\\\\d)0?${mon + 1}/0?${day}/\\\\\\\\d{2,4}`,\\n  ];\\n  return patterns.some((p) => new RegExp(p, \\\"i\\\").test(text));\\n}\\nfunction showsAnyDate(text: string): boolean {\\n  return /\\\\d{4}-\\\\d{2}-\\\\d{2}/.test(text)\\n    || /(?:jan|feb|mar|apr|may|jun|jul|aug|sep|oct|nov|dec)[a-z]*\\\\.?\\\\s+\\\\d{1,2}/i.test(text)\\n    || /\\\\d{1,2}\\\\s+(?:jan|feb|mar|apr|may|jun|jul|aug|sep|oct|nov|dec)/i.test(text)\\n    || /\\\\d{1,2}\\\\/\\\\d{1,2}\\\\/\\\\d{2,4}/.test(text)\\n    || /invalid date|undefined|null|NaN/i.test(text);\\n}\\nconst inDays = (n: number) => new Date(TEST_NOW.getTime() + n * 86_400_000);\\nconst isoDay = (d: Date) => d.toISOString().slice(0, 10);\\n\\n// ---------- data builders (shapes from the contract) ----------\\nconst mkLot = (lotId: number, lotName: string, penName: string): LotSummary => ({\\n  lotId, lotName, headCount: 100 + lotId, breed: \\\"Angus\\\", sex: \\\"Steer\\\", penName, rationName: \\\"Grower\\\",\\n  feedConsumedLb: 1000, startingWeightLb: 600, currentWeightLb: 700, adgLbPerDay: 2.1, fcr: 6.1, costOfGainPerLb: 0.9,\\n});\\nconst mkPen = (penId: number, penName: string, capacity: number, animalCount: number): PenSummary => ({\\n  penId, penName, animalCount, capacity, rationName: \\\"Grower\\\", dailyBunkRateLbPerHead: 24, plannedFeedLb: 2400, actualFeedLb: 2300, currentWeightLb: 700, adgLbPerDay: 2.1,\\n});\\nconst mkRecord = (o: Partial<SourceRecord> & Pick<SourceRecord, \\\"recordId\\\" | \\\"purchaseOrderNumber\\\" | \\\"vendor\\\">): SourceRecord => ({\\n  lineNumber: 1, receiptNumber: `RCV-${o.recordId}`, unitCostUsdPerTon: 1000, headCount: 50, averageWeightLb: 500, breed: \\\"Angus\\\", ageMonths: 8,\\n  source: \\\"SRC-Base\\\", importStatus: \\\"Synced\\\", lotId: 0, lotName: \\\"\\\", penId: 0, penName: \\\"\\\", ...o,\\n});\\nconst mkForecast = (lotId: number, lotName: string, target: number, source: \\\"Lot\\\" | \\\"Yard\\\", adg: number, ship: string | null): LotForecast => ({\\n  lotId, lotName, currentWeightLb: 812, targetWeightLb: target, targetSource: source, adgLbPerDay: adg, projectedShipDate: ship,\\n});\\nconst mkMetrics = (lotId: number, lotName: string): LotMetricsResponse => ({\\n  lotId, lotName,\\n  metrics: { daysOnFeed: 40, totalWeightGainLb: 100, averageDailyGainLbPerDay: 2.5, totalFeedConsumedLb: 800, feedConversionRatio: 8, feedCostPerGainUsdPerLb: 1, projectedShipDate: null, suggestions: [] },\\n});\\nconst mkItem = (o: Partial<InventoryItem> & Pick<InventoryItem, \\\"itemId\\\" | \\\"name\\\">): InventoryItem => ({\\n  category: \\\"Grain\\\", availableQuantityLb: 1000, unitOfMeasure: \\\"lb\\\", unitCostUsdPerTon: 300, unitCostUsdPerLb: 0.15, dryMatterPercent: 88,\\n  energyMcalPerLb: 0.8, storageLocation: \\\"Bin X\\\", openingStockLb: 1, receivedStockLb: 2, consumedStockLb: 3, closingStockLb: 4, ...o,\\n});\\n\\nfunction useYard(yard: YardResponse) {\\n  server.use(\\n    getGetYardRecordsMockHandler(yard),\\n    getGetLotWeightHistoryMockHandler((info) => ({ lotId: Number(info.params.lotId), records: [] })),\\n    getGetLotMetricsMockHandler((info) => {\\n      const lot = yard.lots.find((l) => String(l.lotId) === info.params.lotId) ?? yard.lots[0];\\n      return mkMetrics(lot.lotId, lot.lotName);\\n    }),\\n  );\\n}\\nfunction useForecasts(lots: LotSummary[], forecasts: LotForecast[], yardTarget: number) {\\n  useYard({ purchaseOrders: [], lots, pens: lots.map((l, i) => mkPen(i + 1, l.penName, 400, 250)), forecasts });\\n  server.use(\\n    getGetLotForecastsMockHandler({ yardTargetWeightLb: yardTarget, forecasts }),\\n    getGetLotForecastMockHandler((info) => forecasts.find((f) => String(f.lotId) === info.params.lotId) ?? forecasts[0]),\\n  );\\n}\\nfunction renderYard() {\\n  at(\\\"/yard\\\");\\n  render(<ProcurementLotRecordsContainer />);\\n}\\nfunction renderFeed() {\\n  at(\\\"/feed\\\");\\n  render(<FeedManagementContainer />);\\n}\\nfunction renderOverview() {\\n  at(\\\"/overview\\\");\\n  render(<YardOverviewContainer />);\\n}\\n\\nconst overviewData = (): OverviewResponse => ({\\n  currency: \\\"USD\\\", activeLots: 3, activePens: 3, totalHead: 612, averageAdgLbPerDay: 2.4, averageCostOfGainPerLb: 0.93,\\n  feedCostToday: 4120, plannedFeedLbToday: 9000, deliveredFeedLbToday: 8800,\\n  lots: [mkLot(1, \\\"Lot Overview-Alpha\\\", \\\"OP-1\\\"), mkLot(2, \\\"Lot Overview-Bravo\\\", \\\"OP-2\\\"), mkLot(3, \\\"Lot Overview-Charlie\\\", \\\"OP-3\\\")],\\n  pens: [mkPen(1, \\\"OP-1\\\", 300, 200), mkPen(2, \\\"OP-2\\\", 300, 210), mkPen(3, \\\"OP-3\\\", 300, 202)],\\n});\\nconst inventoryBase = (): InventoryItem[] => [\\n  mkItem({ itemId: 1, name: \\\"Linseed Cake KX\\\", category: \\\"Oilseed\\\", availableQuantityLb: 21350, unitCostUsdPerTon: 392, unitCostUsdPerLb: 0.196, dryMatterPercent: 91.4, energyMcalPerLb: 0.93, storageLocation: \\\"Shed R-7\\\", openingStockLb: 40120, receivedStockLb: 6800, consumedStockLb: 25610, closingStockLb: 21310 }),\\n  mkItem({ itemId: 2, name: \\\"Barley Rolled QZ\\\", category: \\\"Grain\\\", availableQuantityLb: 15780, unitCostUsdPerTon: 282, unitCostUsdPerLb: 0.141, dryMatterPercent: 86.2, energyMcalPerLb: 0.87, storageLocation: \\\"Bin T-3\\\", openingStockLb: 30000, receivedStockLb: 5200, consumedStockLb: 19450, closingStockLb: 15750 }),\\n  mkItem({ itemId: 3, name: \\\"Molasses Blend MP\\\", category: \\\"Liquid\\\", availableQuantityLb: 8940, unitCostUsdPerTon: 164, unitCostUsdPerLb: 0.082, dryMatterPercent: 74.5, energyMcalPerLb: 0.76, storageLocation: \\\"Tank L-5\\\", openingStockLb: 12000, receivedStockLb: 3500, consumedStockLb: 6540, closingStockLb: 8960 }),\\n];\\n\\n// ---------- AC-1: shared workspace, no sign-in, same controls ----------\\nfunction controls(): string[] {\\n  const roles = [\\\"button\\\", \\\"link\\\", \\\"textbox\\\", \\\"combobox\\\", \\\"checkbox\\\", \\\"switch\\\", \\\"tab\\\"] as const;\\n  const out: string[] = [];\\n  for (const role of roles) {\\n    for (const el of screen.queryAllByRole(role)) out.push(`${role}:${(el.getAttribute(\\\"aria-label\\\") ?? el.textContent ?? \\\"\\\").trim()}`);\\n  }\\n  return out.sort();\\n}\\nfunction expectNoSignIn() {\\n  expect(screen.queryByText(/sign in|log in|login|sign-in/i)).toBeNull();\\n  expect(screen.queryByRole(\\\"button\\\", { name: /sign in|log in|login/i })).toBeNull();\\n  expect(screen.queryByRole(\\\"textbox\\\", { name: /password|email|username/i })).toBeNull();\\n  expect(screen.queryByRole(\\\"combobox\\\", { name: /role/i })).toBeNull();\\n  expect(screen.queryByLabelText(/\\\\brole\\\\b/i)).toBeNull();\\n  expect(screen.queryByRole(\\\"radio\\\", { name: /role|admin|operator|viewer/i })).toBeNull();\\n}\\n\\ndescribe(\\\"REQ-1 shared workspace\\\", () => {\\n  it(\\\"AC_1_1_ShowsSharedWorkspaceWithoutSignInOrRoleSelector\\\", async () => {\\n    server.use(getGetOverviewMockHandler(overviewData()));\\n    renderOverview();\\n    await see(\\\"Lot Overview-Alpha\\\");\\n    await see(\\\"Lot Overview-Bravo\\\");\\n    expect(screen.getByRole(\\\"heading\\\", { name: \\\"Yard overview\\\" })).toBeTruthy();\\n    expectNoSignIn();\\n    expect(seenRequests.length).toBeGreaterThan(0);\\n    for (const r of seenRequests) {\\n      expect(r.headers.get(\\\"authorization\\\")).toBeNull();\\n    }\\n    expect(nothingNavigatedToLogin()).toBe(true);\\n  });\\n\\n  it(\\\"AC_1_2_ShowsSameControlsInTwoSessions\\\", async () => {\\n    server.use(\\n      getGetOverviewMockHandler(overviewData()),\\n      getGetFeedInventoryMockHandler({ currency: \\\"USD\\\", items: inventoryBase() }),\\n    );\\n    useYard({ purchaseOrders: [mkRecord({ recordId: 1, purchaseOrderNumber: \\\"PO-1\\\", vendor: \\\"Session Vendor\\\" })], lots: [mkLot(1, \\\"Lot Session-One\\\", \\\"SP-1\\\")], pens: [mkPen(1, \\\"SP-1\\\", 300, 200)] });\\n    const screens: Array<{ name: string; open: () => void; ready: string; required: string[] }> = [\\n      { name: \\\"overview\\\", open: renderOverview, ready: \\\"Lot Overview-Alpha\\\", required: [\\\"Yard records\\\", \\\"Feed ops\\\", \\\"Insights\\\"] },\\n      { name: \\\"yard\\\", open: renderYard, ready: \\\"Lot Session-One\\\", required: [\\\"Sync POs\\\"] },\\n      { name: \\\"feed\\\", open: renderFeed, ready: \\\"Linseed Cake KX\\\", required: [\\\"Feed tools\\\", \\\"Feeding entry\\\", \\\"Reports & project brief\\\"] },\\n    ];\\n    for (const s of screens) {\\n      const sessions: string[][] = [];\\n      for (let session = 0; session < 2; session++) {\\n        s.open();\\n        await see(s.ready);\\n        expectNoSignIn();\\n        sessions.push(controls());\\n        cleanup();\\n      }\\n      expect(sessions[0].length).toBeGreaterThan(0);\\n      for (const name of s.required) expect(sessions[0].some((c) => c.endsWith(`:${name}`)), `${s.name}: control ${name}`).toBe(true);\\n      expect(sessions[1]).toEqual(sessions[0]);\\n    }\\n  });\\n});\\n\\nfunction nothingNavigatedToLogin(): boolean {\\n  return !/login|sign-?in|auth/i.test(window.location.pathname);\\n}\\n\\n// ---------- AC-2: synchronisation ----------\\nconst syncResponse = (): SyncResponse => ({\\n  source: \\\"SRC-Alpha-Feed\\\",\\n  message: \\\"Synchronised 3 lines\\\",\\n  conflicts: [],\\n  records: [\\n    mkRecord({ recordId: 501, purchaseOrderNumber: \\\"PO-61842\\\", lineNumber: 1, receiptNumber: \\\"RCV-90317\\\", vendor: \\\"Prairie Ridge Cattle Co\\\", unitCostUsdPerTon: 1412, headCount: 187, averageWeightLb: 612, breed: \\\"Charolais Cross\\\", ageMonths: 13, source: \\\"SRC-Alpha-Feed\\\", lotId: 11, lotName: \\\"L-9051\\\", penId: 21, penName: \\\"P-31\\\" }),\\n    mkRecord({ recordId: 502, purchaseOrderNumber: \\\"PO-61855\\\", lineNumber: 2, receiptNumber: \\\"RCV-90322\\\", vendor: \\\"Sandhill Livestock LLC\\\", unitCostUsdPerTon: 1538, headCount: 243, averageWeightLb: 748, breed: \\\"Red Angus\\\", ageMonths: 17, source: \\\"SRC-Beta-Feed\\\", lotId: 12, lotName: \\\"L-9052\\\", penId: 22, penName: \\\"P-32\\\" }),\\n    mkRecord({ recordId: 503, purchaseOrderNumber: \\\"PO-61871\\\", lineNumber: 3, receiptNumber: \\\"RCV-90330\\\", vendor: \\\"Cedar Flats Ranch\\\", unitCostUsdPerTon: 1295, headCount: 311, averageWeightLb: 871, breed: \\\"Hereford\\\", ageMonths: 19, source: \\\"SRC-Gamma-Feed\\\", lotId: 13, lotName: \\\"L-9053\\\", penId: 23, penName: \\\"P-33\\\" }),\\n  ],\\n});\\n\\ndescribe(\\\"REQ-2 procurement sync\\\", () => {\\n  it(\\\"AC_2_1_SyncRequestCarriesPoLineVendorCostHeadWeightBreedAgeSource\\\", async () => {\\n    let sent: SyncRequest | undefined;\\n    useYard({