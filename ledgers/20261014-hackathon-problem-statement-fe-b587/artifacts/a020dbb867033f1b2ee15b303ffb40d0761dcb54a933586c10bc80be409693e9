 capacity: 400, currentAnimalCount: 350, lotIds: [5102] }],\\n    selectedPerformance: { lotId: 5101, lotName: \\\"L-5101\\\", daysOnFeed: 133, totalWeightGainLb: 301, adgLbPerDay: 2.27, totalFeedConsumedLb: 712340, feedConversionRatio: 6.01, feedCostPerGain: 1.03, projectedShipDate: \\\"2026-08-23\\\", suggestion: \\\"Hold the current ration.\\\" },\\n    weights: [weightRec()],\\n    yardTargetWeightLb: 1388,\\n    currency: \\\"USD\\\",\\n    ...o,\\n  };\\n}\\nconst forecastRoute = (lotId: number, lotName: string, target: number, source: string, adg: number, date: string | null): [string, () => Reply] =>\\n  [`GET /api/lots/${lotId}/forecast`, () => json({ lotId, lotName, targetWeightLb: target, targetSource: source, adgLbPerDay: adg, projectedShipDate: date, currentWeightLb: 1188 })];\\n\\nconst overview = (): OverviewResponse => ({\\n  summary: { activeLots: 3, activePens: 5, totalHead: 311, averageAdgLbPerDay: 2.9, averageCostOfGain: 1.11, currency: \\\"USD\\\", feedCostToday: 1530, feedCostPlannedToday: 1490, stockCoverDays: 5.2, feedActualTons: 4.1, feedPlannedTons: 4.3, totalFeedConsumedLb: 50210, energyConsumedMcal: 98100 },\\n  chartPoints: [{ label: \\\"Mar 12\\\", value: 4.1 }, { label: \\\"Mar 13\\\", value: 4.2 }],\\n  lots: [{ id: 5101, name: \\\"North 91\\\", headCount: 77, rationName: \\\"Finisher 44\\\", feedTons: 0.82, energyGJ: 15.1, startingWeightLb: 702, currentWeightLb: 1042, totalWeightGainLb: 340, adgLbPerDay: 3.01, feedConversionRatio: 6.3, costOfGain: 1.19, bestPerformer: true, worstPerformer: false }],\\n  pens: [{ id: 31, name: \\\"P-31\\\", headCount: 29, rationName: \\\"Finisher 44\\\", rationUseTons: 0.2, bunkRateLbPerHead: 23.1, plannedFeedTons: 0.22, actualFeedTons: 0.2, currentWeightLb: 1042, adgLbPerDay: 3.01 }],\\n});\\n\\nconst inv = (o: Partial<InventoryItem>): InventoryItem => ({\\n  id: 201, name: \\\"Cottonseed hulls\\\", category: \\\"Roughage\\\", availableQuantityLb: 4150, unitOfMeasure: \\\"bale\\\", unitCostPerTon: 11