lace(/(\\\\d),(?=\\\\d{3})/g, \\\"$1\\\").replace(/\\\\s+/g, \\\" \\\");\\nconst has = (text: string, v: string | number) => norm(text).includes(String(v));\\nconst MON = [\\\"Jan\\\", \\\"Feb\\\", \\\"Mar\\\", \\\"Apr\\\", \\\"May\\\", \\\"Jun\\\", \\\"Jul\\\", \\\"Aug\\\", \\\"Sep\\\", \\\"Oct\\\", \\\"Nov\\\", \\\"Dec\\\"];\\nconst FULL = [\\\"January\\\", \\\"February\\\", \\\"March\\\", \\\"April\\\", \\\"May\\\", \\\"June\\\", \\\"July\\\", \\\"August\\\", \\\"September\\\", \\\"October\\\", \\\"November\\\", \\\"December\\\"];\\nfunction hasDate(text: string, iso: string): boolean {\\n  const [y, m, d] = iso.split(\\\"-\\\").map(Number) as [number, number, number];\\n  const pad = (n: number) => String(n).padStart(2, \\\"0\\\");\\n  return [iso, `${d} ${MON[m - 1]}`, `${MON[m - 1]} ${d}`, `${d} ${FULL[m - 1]}`, `${FULL[m - 1]} ${d}`, `${m}/${d}/${y}`, `${pad(d)}/${pad(m)}/${y}`, `${d}/${m}/${y}`].some((v) => text.includes(v));\\n}\\nconst bodyText = () => norm(document.body.textContent);\\n\\n/** The smallest block around `name` (found by walking up from where the name is shown) that also holds every value and none of `others`. */\\nfunction blockFor(name: string, values: (string | number)[], others: string[] = []): HTMLElement | null {\\n  const all = [...document.body.querySelectorAll<HTMLElement>(\\\"*\\\")];\\n  const leaves = all.filter((el) => norm(el.textContent).includes(name) && ![...el.children].some((c) => norm(c.textContent).includes(name)));\\n  for (const leaf of leaves) {\\n    let el: HTMLElement | null = leaf;\\n    for (let i = 0; i < 8 && el; i++, el = el.parentElement) {\\n      const t = norm(el.textContent);\\n      if (values.every((v) => t.includes(String(v)))) {\\n        if (!others.some((o) => t.includes(o))) return el;\\n        break;\\n      }\\n    }\\n  }\\n  return null;\\n}\\nasync function expectBlock(name: string, values: (string | number)[], others: string[] = []): Promise<HTMLElement> {\\n  let found: HTMLElement | null = null;\\n  await waitFor(() => {\\n    found = blockFor(name, values, others);\\n    expect(found, `a block showing ${name} with ${values.join(\\\" | \\\")}`).not.toBeNull();\\n  });\\n  return found!;\\n}\\nfunction fieldValues(label: string): string[] {\\n  return screen.getAllByText(label).map((el) => (el.tagName === \\\"DT\\\" ? el.nextElementSibling?.textContent ?? \\\"\\\" : (el.parentElement?.textContent ?? \\\"\\\").replace(label, \\\"\\\")));\\n}\\nfunction controlNames(): string[] {\\n  const els = document.body.querySelectorAll<HTMLElement>(\\\"button,a[href],input,select,textarea,[role=button],[role=combobox],[role=tab],[role=menuitem]\\\");\\n  const names = [...els].map((el) => `${el.tagName.toLowerCase()}:${(el.getAttribute(\\\"aria-label\\\") || el.textContent || el.getAttribute(\\\"placeholder\\\") || \\\"\\\").trim()}`);\\n  return [...new Set(names)].sort();\\n}\\nasync function choose(user: ReturnType<typeof userEvent.setup>, control: HTMLElement, text: string | RegExp) {\\n  if (control.tagName === \\\"SELECT\\\") {\\n    await user.selectOptions(control, within(control).getByRole(\\\"option\\\", { name: text }));\\n    return;\\n  }\\n  await user.click(control);\\n  await user.click(await screen.findByRole(\\\"option\\\", { name: text }));\\n}\\nasync function fill(user: ReturnType<typeof userEvent.setup>, control: HTMLElement, value: string) {\\n  if (control.tagName === \\\"INPUT\\\" || control.tagName === \\\"TEXTAREA\\\") {\\n    await user.clear(control);\\n    await user.type(control, value);\\n  } else await choose(user, control, value);\\n}\\nconst lastButton = (root: HTMLElement, name: RegExp) => {\\n  const all = within(root).getAllByRole(\\\"button\\\").filter((b) => name.test(b.textContent ?? \\\"\\\") && !/close|cancel/i.test(b.textContent ?? \\\"\\\"));\\n  return all[all.length - 1]!;\\n};\\n\\n// =====================================================================================================\\n// Characterisation: the approved sample pages keep opening in their drawn states.\\n// =====================================================================================================\\ndescribe(\\\"characterisation\\\", () => {\\n  it(\\\"CHAR_OverviewEmptyStateShowsApprovedWords\\\", () => {\\n    render(<YardOverviewContainer fixture=\\\"empty\\\" />);\\n    expect(screen.getByText(\\\"No active lots yet\\\")).toBeTruthy();\\n    expect(screen.getByText(\\\"Sync yard records to see feed costs, pens and performance here.\\\")).toBeTruthy();\\n  });\\n  it(\\\"CHAR_ProcurementErrorStateShowsApprovedWords\\\", () => {\\n    render(<ProcurementLotRecordsContainer fixture=\\\"error\\\" />);\\n    expect(screen.getByText(\\\"Procurement could not refresh. The last saved lot and weight records are still shown.\\\")).toBeTruthy();\\n  });\\n  it(\\\"CHAR_FeedEmptyStateShowsApprovedWords\\\", () => {\\n    render(<FeedManagementContainer fixture=\\\"empty\\\" />);\\n    expect(screen.getByText(\\\"No feed records yet\\\")).toBeTruthy();\\n    expect(screen.getByText(\\\"Add an ingredient, build a ration, or plan the first bunk to populate this workbench.\\\")).toBeTruthy();\\n  });\\n});\\n\\n// =====================================================================================================\\n// REQ-1 shared workspace\\n// =====================================================================================================\\ndescribe(\\\"REQ-1 shared workspace without sign-in\\\", () => {\\n  it(\\\"AC_1_1_ShowsSharedWorkspaceWithoutSignInOrRoleSelector\\\", async () => {\\n    stubApi(baseRoutes());\\n    render(<YardOverviewContainer />);\\n    await screen.findAllByText(/North 91/);\\n    expect((await screen.findAllByRole(\\\"heading\\\", { name: \\\"Yard overview\\\" })).length).toBeGreaterThan(0);\\n    for (const name of [\\\"Yard records\\\", \\\"Feed ops\\\", \\\"Insights\\\"]) expect(screen.getAllByRole(\\\"button\\\", { name }).length + screen.queryAllByRole(\\\"link\\\", { name }).length).toBeGreaterThan(0);\\n    expect(screen.queryByRole(\\\"button\\\", { name: /sign in|log in|login|sign up|continue as/i })).toBeNull();\\n    expect(screen.queryByRole(\\\"link\\\", { name: /sign in|log in|login/i })).toBeNull();\\n    expect(screen.queryByLabelText(/password|e-?mail|user ?name/i)).toBeNull();\\n    expect(screen.queryByRole(\\\"combobox\\\", { name: /role/i })).toBeNull();\\n    expect(screen.queryByLabelText(/role/i)).toBeNull();\\n    expect(screen.queryByText(/select (a |your )?role|choose (a |your )?role|sign in|log in/i)).toBeNull();\\n  });\\n\\n  it(\\\"AC_1_2_ShowsSameControlsInTwoSessions\\\", async () => {\\n    const markers: [string, () => JSX.Element, RegExp][] = [\\n      [\\\"overview\\\", () => <YardOverviewContainer />, /North 91/],\\n      [\\\"yard\\\", () => <ProcurementLotRecordsContainer />, /PO-7733/],\\n      [\\\"feed\\\", () => <FeedManagementContainer />, /Cottonseed hulls/],\\n    ];\\n    const sessions: Record<string, string[]>[] = [];\\n    for (let s = 0; s < 2; s++) {\\n      localStorage.clear();\\n      sessionStorage.clear();\\n      stubApi(baseRoutes());\\n      const seen: Record<string, string[]> = {};\\n      for (const [key, ui, marker] of markers) {\\n        const view = render(ui());\\n        await screen.findAllByText(marker);\\n        seen[key] = controlNames();\\n        view.unmount();\\n      }\\n      sessions.push(seen);\\n    }\\n    for (const [key] of markers) {\\n      expect(sessions[0]![key]!.length).toBeGreaterThan(0);\\n      expect(sessions[1]![key]).toEqual(sessions[0]![key]);\\n    }\\n    const yardControls = sessions[0]!.yard!.join(\\\"|\\\");\\n    expect(yardControls).toContain(\\\"Sync POs\\\");\\n    const feedControls = sessions[0]!.feed!.join(\\\"|\\\");\\n    for (const name of [\\\"Feed tools\\\", \\\"Feeding entry\\\", \\\"Reports & project brief\\\"]) expect(feedControls).toContain(name);\\n    for (const key of [\\\"overview\\\", \\\"yard\\\", \\\"feed\\\"]) expect(sessions[0]![key]!.join(\\\"|\\\")).not.toMatch(/sign in|log in|role/i);\\n  });\\n});\\n\\n// =====================================================================================================\\n// REQ-2 procurement sync\\n// =====================================================================================================\\nconst SYNCED: ImportRecord[] = [\\n  imp({ id: 8101, poNumber: \\\"PO-8101\\\", poLine: \\\"11\\\", receiptId: \\\"RCV-8101\\\", sourceId: \\\"src-8101-11\\\", vendor: \\\"Cedar Creek Cattle\\\", unitCost: 1.37, headCount: 37, averageWeightLb: 1093.5, breed: \\\"Simmental\\\", ageMonths: 14, source: \\\"Receiving feed A\\\", lotId: 5103, lotName: \\\"L-5103\\\", penId: 33, penName: \\\"P-33\\\" }),\\n  imp({ id: 8102, poNumber: \\\"PO-8102\\\", poLine: \\\"12\\\", receiptId: \\\"RCV-8102\\\", sourceId: \\\"src-8102-12\\\", vendor: \\\"Red Mesa Livestock\\\", unitCost: 1.52, headCount: 41, averageWeightLb: 1214.5, breed: \\\"Hereford\\\", ageMonths: 16, source: \\\"Receiving feed B\\\", lotId: 5104, lotName: \\\"L-5104\\\", penId: 34, penName: \\\"P-34\\\" }),\\n  imp({ id: 8103, poNumber: \\\"PO-8103\\\", poLine: \\\"13\\\", receiptId: \\\"RCV-8103\\\", sourceId: \\\"src-8103-13\\\", vendor: \\\"Willow Bend Ranch\\\", unitCost: 1.19, headCount: 53, averageWeightLb: 987.5, breed: \\\"Brahman\\\", ageMonths: 19, source: \\\"Receiving feed C\\\", lotId: 5105, lotName: \\\"L-5105\\\", penId: 35, penName: \\\"P-35\\\" }),\\n];\\nconst syncRoutes = (): Routes => ({\\n  ...baseRoutes(),\\n  \\\"POST /api/procurement/sync\\\": () => json({ syncedAt: \\\"2026-01-15T12:00:00Z\\\", records: SYNCED, message: \\\"Procurement and receiving records refreshed.\\\" }),\\n});\\n\\ndescribe(\\\"REQ-2 synchronization\\\", () => {\\n  it(\\\"AC_2_1_SyncRequestsMockSourceAndShowsPoLineVendorCostHeadWeightBreedAgeSource\\\", async () => {\\n    stubApi(syncRoutes());\\n    const user = userEvent.setup();\\n    render(<ProcurementLotRecordsContainer />);\\n    await screen.findAllByText(/PO-7733/);\\n    await user.click(screen.getByRole(\\\"button\\\", { name: \\\"Sync POs\\\" }));\\n    await waitFor(() => expect(calls.filter((c) => c.method === \\\"POST\\\" && c.path === \\\"/api/procurement/sync\\\")).toHaveLength(1));\\n    expect(calls.find((c) => c.path === \\\"/api/procurement/sync\\\")!.body).toEqual({ source: \\\"mock\\\", includePurchaseOrders: true, includeReceiving: true });\\n    for (const r of SYNCED) {\\n      await expectBlock(r.poNumber, [r.poLine, r.vendor, r.unitCost, r.headCount, r.averageWeightLb, r.breed, r.ageMonths, r.source], SYNCED.filter((x) => x !== r).map((x) => x.poNumber));\\n    }\\n  });\\n\\n  it(\\\"AC_2_2_ShowsReturnedVendorCostHeadWeightBreedAgeAndSourceForEachRecord\\\", async () => {\\n    stubApi(syncRoutes());\\n    const user = userEvent.setup();\\n    render(<ProcurementLotRecordsContainer />);\\n    await screen.findAllByText(/PO-7733/);\\n    await user.click(screen.getByRole(\\\"button\\\", { name: \\\"Sync POs\\\" }));\\n    for (const r of SYNCED) {\\n      await expectBlock(r.poNumber, [r.vendor, r.unitCost, r.headCount, r.averageWeightLb, r.breed, r.ageMonths, r.source], SYNCED.filter((x) => x !== r).map((x) => x.poNumber));\\n    }\\n    expect(bodyText()).not.toContain(\\\"Lone Pine Feeders\\\");\\n  });\\n});\\n\\n// =====================================================================================================\\n// REQ-3 PO line to lot to pen\\n// =====================================================================================================\\ntype Assign = { lotId: number; lotName: string; penId: number; penName: string; headCount: number; penCapacity: number; penCurrentAnimalCount: number };\\nconst A1: Assign = { lotId: 5101, lotName: \\\"L-5101\\\", penId: 31, penName: \\\"P-31\\\", headCount: 20, penCapacity: 563, penCurrentAnimalCount: 417 };\\nconst A2: Assign = { lotId: 5102, lotName: \\\"L-5102\\\", penId: 32, penName: \\\"P-32\\\", headCoun