"0\\\");\\n  return [iso, `${d} ${MON[m - 1]}`, `${MON[m - 1]} ${d}`, `${d} ${FULL[m - 1]}`, `${FULL[m - 1]} ${d}`, `${m}/${d}/${y}`, `${pad(d)}/${pad(m)}/${y}`, `${d}/${m}/${y}`].some((v) => text.includes(v));\\n}\\nconst bodyText = () => norm(document.body.textContent);\\n\\n/** The smallest block around `name` (found by walking up from where the name is shown) that also holds every value and none of `others`. */\\nfunction blockFor(name: string, values: (string | number)[], others: string[] = []): HTMLElement | null {\\n  const all = [...document.body.querySelectorAll<HTMLElement>(\\\"*\\\")];\\n  const leaves = all.filter((el) => norm(el.textContent).includes(name) && ![...el.children].some((c) => norm(c.textContent).includes(name)));\\n  for (const leaf of leaves) {\\n    let el: HTMLElement | null = leaf;\\n    for (let i = 0; i < 8 && el; i++, el = el.parentElement) {\\n      const t = norm(el.textContent);\\n      if (values.every((v) => t.includes(String(v)))) {\\n        if (!others.some((o) => t.includes(o))) return el;\\n        break;\\n      }\\n    }\\n  }\\n  return null;\\n}\\nasync function expectBlock(name: string, values: (string | number)[], others: string[] = []): Promise<HTMLElement> {\\n  let found: HTMLElement | null = null;\\n  await waitFor(() => {\\n    found = blockFor(name, values, others);\\n    expect(found, `a block showing ${name} with ${values.join(\\\" | \\\")}`).not.toBeNull();\\n  });\\n  return found!;\\n}\\nfunction fieldValues(label: string): string[] {\\n  return screen.getAllByText(label).map((el) => (el.tagName === \\\"DT\\\" ? el.nextElementSibling?.textContent ?? \\\"\\\" : (el.parentElement?.textContent ?? \\\"\\\").replace(label, \\\"\\\")));\\n}\\nfunction controlNames(): string[] {\\n  const els = document.body.querySelectorAll<HTMLElement>(\\\"button,a[href],input,select,textarea,[role=button],[role=combobox],[role=tab],[role=menuitem]\\\");\\n  const names = [...els].map((el) => `${el.tagName.toLowerCase()}:${(el.g