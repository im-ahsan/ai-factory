{"ts":1792015144274,"kind":"call","tool":"Write","input":"{\"file_path\":\"/work/tests/part2_bottom.txt\",\"content\":\"// ---------- REQ-9 ----------\\n\\ndescribe(\\\"REQ-9 stock refusal\\\", () => {\\n  it(\\\"AC_9_1_ShowsRefusalAndShortageKeepsFormAndSavesNothing\\\", async () => {\\n    const hulls = item(22, \\\"Cottonseed hulls\\\", \\\"Forage\\\", 625, 276);\\n    let posts = 0;\\n    serve({ items: [ITEMS[0], hulls, ITEMS[2]] }, http.post(\\\"*/feed/stock-movements\\\", () => {\\n      posts++;\\n      return HttpResponse.json({ code: \\\"insufficient_stock\\\", message: \\\"Issue refused: balance would go negative\\\", shortageLb: 1875, availableQuantityLb: 625, requestedQuantityLb: 2500, saved: false }, { status: 409 });\\n    }));\\n    const user = open();\\n    await screen.findByText(\\\"Feed management\\\");\\n    await expectTableRow(/Cottonseed hulls/, (r) => expect(r.cell(col.avail)).toMatch(/625\\\\s*lb/));\\n    const rowBefore = tableRows(/Cottonseed hulls/).map((r) => r.text);\\n\\n    const direct = screen.queryAllByRole(\\\"button\\\", { name: /movement/i })[0];\\n    if (direct) await user.click(direct);\\n    else await openMenuItem(user, \\\"Feed tools\\\", \\\"Record stock movement\\\");\\n\\n    await choose(user, /item|ingredient/i, /Cottonseed hulls/);\\n    await choose(user, /type/i, /Issue/);\\n    await fill(user, /quantity/i, \\\"2500\\\");\\n    await user.click(await screen.findByRole(\\\"button\\\", { name: /(save|record|submit).*movement|^save$/i }));\\n\\n    await waitFor(() => expect(posts).toBe(1));\\n    await until(/Issue refused: balance would go negative/);\\n    await until(numRe(1875));\\n    expect((screen.getAllByLabelText(/quantity/i)[0] as HTMLInputElement).value).toMatch(/^2,?500$/);\\n    expect(screen.getByRole(\\\"button\\\", { name: /(save|record|submit).*movement|^save$/i })).toBeTruthy();\\n    expect(tableRows(/Cottonseed hulls/).map((r) => r.text)).toEqual(rowBefore);\\n    expect(tableRows(numRe(2500))