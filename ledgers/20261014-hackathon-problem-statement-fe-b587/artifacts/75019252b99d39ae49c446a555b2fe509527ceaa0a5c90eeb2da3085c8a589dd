, { target: { value } }); return; }\\n  await user.clear(el);\\n  await user.type(el, value);\\n}\\n\\nasync function choose(user: User, label: RegExp, option: RegExp) {\\n  const el = await screen.findByLabelText(label);\\n  if (el.tagName === \\\"SELECT\\\") {\\n    const opt = within(el).getAllByRole(\\\"option\\\").find((o) => option.test(o.textContent ?? \\\"\\\"));\\n    if (!opt) throw new Error(`no option ${option} in ${label}`);\\n    await user.selectOptions(el, opt as HTMLOptionElement);\\n    return;\\n  }\\n  await user.click(el);\\n  await user.click(await screen.findByRole(\\\"option\\\", { name: option }));\\n}\\n\\n/** per-lot fields when the form has them, else the allocation text box in the approved form's \\\"Lot 14-A: 3,200 lb; ...\\\" shape */\\nasync function fillAllocations(user: User, entries: { lot: string; qty: number }[]) {\\n  const perLot = screen.queryAllByLabelText(new RegExp(entries[0].lot, \\\"i\\\"));\\n  if (perLot.length) {\\n    for (const e of entries) await fill(user, new RegExp(e.lot, \\\"i\\\"), String(e.qty));\\n    return;\\n  }\\n  const text = entries.map((e) => `Lot ${e.lot}: ${e.qty.toLocaleString(\\\"en-US\\\")} lb`).join(\\\"; \\\");\\n  await fill(user, /allocation/i, text);\\n}\\n\\nfunction open() {\\n  at(\\\"/feed\\\");\\n  const user = userEvent.setup();\\n  render(<FeedManagementContainer />);\\n  return user;\\n}\\n\\nasync function startPlan(user: User, penName: RegExp) {\\n  await openMenuItem(user, \\\"Feeding entry\\\", \\\"Plan feeding\\\");\\n  await choose(user, /^pen/i, penName);\\n  await choose(user, /selected ration/i, /Ridge Grower/);\\n}\\n\\nasync function recordActual(user: User, o: { plan: RegExp; qty: number; allocations: { lot: string; qty: number }[] }) {\\n  await openMenuItem(user, \\\"Feeding entry\\\", \\\"Record actual\\\");\\n  await choose(user, /saved plan/i, o.plan);\\n  await fill(user, /delivered quantity/i, String(o.qty));\\n  await fill(user, /actual feeding time/i, \\\"05:50\\\");\\n  await fillAllocations(user, o.allocations);\\n  await user.click(await screen.findByRole(\\\"button\\\", { name: \\\"Save actual feeding\\\" }));\\n}\\n\\nconst T = 25000;\\n\\n// ---------- reading the page's tables by their approved column headers ----------\\n\\nconst squash = (s: string | null | undefined) => (s ?? \\\"\\\").replace(/\\\\s+/g, \\\" \\\").trim();\\n\\n/** every table row (a real table row, in the table's header-to-cell order) whose text matches `re`, with a way to read a cell by its column header */\\nfunction tableRows(re: RegExp) {\\n  return screen.queryAllByRole(\\\"row\\\").filter((r) => re.test(squash(r.textContent)) && within(r).queryAllByRole(\\\"cell\\\").length > 0).map((r) => {\\n    const table = r.closest(\\\"table\\\");\\n    const heads = table ? within(table).queryAllByRole(\\\"columnheader\\\").map((h) => squash(h.textContent)) : [];\\n    const cells = within(r).queryAllByRole(\\\"cell\\\").map((c) => squash(c.textContent));\\n    return {\\n      text: squash(r.textContent),\\n      cell: (header: RegExp) => { const i = heads.findIndex((h) => header.test(h)); return i < 0 ? null : cells[i] ?? null; },\\n    };\\n  });\\n}\\n\\ntype TableRowView = ReturnType<typeof tableRows>[number];\\n\\n/** wait until some table row matching `re` satisfies `check`; the check throws (expect) when it does not */\\nasync function expectTableRow(re: RegExp, check: (r: TableRowView) => void, timeout = 4000) {\\n  await waitFor(() => {\\n    const rows = tableRows(re);\\n    expect(rows.length, `no table row matches ${re}`).toBeGreaterThan(0);\\n    let last: unknown;\\n    for (const r of rows) { try { check(r); return; } catch (e) { last = e; } }\\n    throw last;\\n  }, { timeout });\\n}\\n\\nconst col = {\\n  plan: /Plan\\\\s*→\\\\s*delivered/i, cost: /Feed cost\\\\s*·\\\\s*energy/i, issue: /Inventory issue/i, lots: /Lot allocation/i, status: /^Status$/i, event: /Event\\\\s*·\\\\s*pen/i,\\n  avail: /^Available$/i, price: /Cost\\\\s*·\\\\s*ton\\\\s*\\\\/\\\\s*lb/i,\\n};\\n\\n/** a money amount the way a person may read it: two decimals, or whole units when shown rounded */\\nconst money = (x: number) => new RegExp(`${numRe(x.toFixed(2)).source}|${numRe(Math.round(x)).source}`);\\n\\n/** the smallest elements (at most 260 characters) whose own text matches every regex: the words and numbers sit together */\\nfunction compact(...res: RegExp[]): Element[] {\\n  const all = [...document.body.querySelectorAll(\\\"*\\\")].filter((el) => {\\n    const t = squash(el.textContent);\\n    return t.length <= 260 && res.every((re) => re.test(t));\\n  });\\n  return all.filter((el) => !all.some((o) => o !== el && el.contains(o)));\\n}\\n\\n/** where each lot's quantity sits next to the lot's name, in either order */\\nfunction lotQty(text: string, lot: string, qty: number): boolean {\\n  const q = numRe(qty).source;\\n  return new RegExp(`${lot}[^\\\\\\\\d]{0,16}${q}|${q}[^\\\\\\\\d]{0,16}${lot}`).test(text);\\n}\\n\\n// ---------- REQ-9 ----------\\n\\ndescribe(\\\"REQ-9 stock refusal\\\", () => {\\n  it(\\\"AC_9_1_ShowsRefusalAndShortageKeepsFormAndSavesNothing\\\", async () => {\\n    const hulls = item(22, \\\"Cottonseed hulls\\\", \\\"Forage\\\", 625, 276);\\n    let posts = 0;\\n    serve({ items: [ITEMS[0], hulls, ITEMS[2]] }, http.post(\\\"*/feed/stock-movements\\\", () => {\\n      posts++;\\n      return HttpResponse.json({ code: \\\"insufficient_stock\\\", message: \\\"Issue refused: balance would go negative\\\", shortageLb: 1875, availableQuantityLb: 625, requestedQuantityLb: 2500, saved: false }, { status: 409 });\\n    }));\\n    const user = open();\\n    await screen.findByText(\\\"Feed management\\\");\\n    await expectTableRow(/Cottonseed hulls/, (r) => expect(r.cell(col.avail)).toMatch(/625\\\\s*lb/));\\n    const rowBefore = tableRows(/Cottonseed hulls/).map((r) => r.text);\\n\\n    const direct = screen.queryAllByRole(\\\"button\\\", { name: /movement/i })[0];\\n    if (direct) await user.click(direct);\\n    else await openMenuItem(user, \\\"Feed tools\\\", \\\"Record stock movement\\\");\\n\\n    await choose(user, /item|ingredient/i, /Cottonseed hulls/);\\n    await choose(user, /type/i, /Issue/);\\n    await fill(user, /quantity/i, \\\"2500\\\");\\n    await user.click(await screen.findByRole(\\\"button\\\", { name: /(save|record|submit).*movement|^save$/i }));\\n\\n    await waitFor(() => expect(posts).toBe(1));\\n    await until(/Issue refused: balance would go negative/);\\n    await until(numRe(1875));\\n    expect((screen.getAllByLabelText(/quantity/i)[0] as HTMLInputElement).value).toMatch(/^2,?500$/);\\n    expect(screen.getByRole(\\\"button\\\", { name: /(save|record|submit).*movement|^save$/i })).toBeTruthy();\\n    expect(tableRows(/Cottonseed hulls/).map((r) => r.text)).toEqual(rowBefore);\\n    expect(tableRows(numRe(2500))).toHaveLength(0);\\n    const said = bodyText().replace(/not saved/gi, \\\"\\\");\\n    expect(said).not.toMatch(/\\\\b(movement|issue|stock)\\\\b[^.]{0,40}\\\\b(saved|recorded)\\\\b|\\\\b(saved|recorded)\\\\b[^.]{0,40}\\\\b(movement|issue)\\\\b/i);\\n  }, T);\\n});\\n\\n// ---------- REQ-10 ----------\\n\\nconst HORIZONS = [\\\"Daily\\\", \\\"Weekly\\\", \\\"Monthly\\\", \\\"Quarterly\\\", \\\"Bi-annual\\\", \\\"Annual\\\"] as const;\\n\\nasync function pickHorizon(user: User, h: string) {\\n  for (const role of [\\\"tab\\\", \\\"radio\\\", \\\"button\\\", \\\"option\\\"] as const) {\\n    const el = screen.queryAllByRole(role, { name: new RegExp(`^${h}$`, \\\"i\\\") })[0];\\n    if (el) { await user.click(el); return; }\\n  }\\n}\\n\\nfunction horizonTexts(h: string): string[] {\\n  const others = HORIZONS.filter((x) => x !== h).map((x) => new RegExp(`(^|[^A-Za-z-])${x}($|[^A-Za-z])`, \\\"i\\\"));\\n  const scopes = screen.queryAllByText(new RegExp(`^\\\\\\\\s*${h}\\\\\\\\s*$`, \\\"i\\\")).map((el) => {\\n    let up: Element = el;\\n    while (up.parentElement && up.parentElement !== document.body && !others.some((re) => re.test(squash(up.parentElement!.textContent)))) up = up.parentElement;\\n    return squash(up.textContent);\\n  });\\n  return [...scopes, ...screen.queryAllByRole(\\\"tabpanel\\\").map((p) => squash(p.textContent))];\\n}\\n\\nconst NUMERIC_ESTIMATE = /\\\\d[\\\\d,]*(?:\\\\.\\\\d+)?\\\\s*lb\\\\b|(?:^|[\\\\s(])[-−–]\\\\s?\\\\d|(?:^|\\\\s)0(?:\\\\s|$)/i;\\n\\ndescribe(\\\"REQ-10 forecasts\\\", () => {\\n  it(\\\"AC_10_1_ShowsWastageRatioAndBalancesForEveryHorizon\\\", async () => {\\n    const values: Record<string, [number, number]> = {\\n      Daily: [-1420, 1437], Weekly: [-3277, 3310], Monthly: [-41905, 41980],\\n      Quarterly: [-128760, 128805], \\\"Bi-annual\\\": [-259330, 259411], Annual: [-514885, 514902],\\n    };\\n    serve({\\n      forecast: (id) => ({\\n        itemId: id, ingredientName: \\\"Rolled barley\\\", wastageRatio: 0.065,\\n        periods: HORIZONS.map((h) => ({ horizon: h, available: true, balanceLb: values[h][0], shortageLb: values[h][1] })),\\n      }),\\n    });\\n    const user = open();\\n    await until(/6\\\\.5\\\\s*%|0\\\\.065/);\\n    for (const h of HORIZONS) {\\n      await pickHorizon(user, h);\\n      const [balance, shortage] = values[h];\\n      await waitFor(() => {\\n        const texts = horizonTexts(h);\\n        expect(texts.length, `no ${h} horizon on the page`).toBeGreaterThan(0);\\n        expect(texts.some((t) => numRe(balance).test(t) && numRe(shortage).test(t)), `${h} does not show balance ${balance} and shortage ${shortage}; has: ${texts.join(\\\" | \\\")}`).toBe(true);\\n      }, { timeout: 4000 });\\n    }\\n    expect(bodyText()).not.toMatch(/NaN|undefined/);\\n  }, T);\\n\\n  it(\\\"AC_10_2_MarksPeriodsWithoutDatedPlanUnavailable\\\", async () => {\\n    const shown: Record<string, [number, number]> = { Daily: [-1420, 1437], Monthly: [-41905, 41980], \\\"Bi-annual\\\": [-259330, 259411], Annual: [-514885, 514902] };\\n    serve({\\n      forecast: (id) => ({\\n        itemId: id, ingredientName: \\\"Rolled barley\\\", wastageRatio: 0.065,\\n        periods: HORIZONS.map((h) => (h in shown\\n          ? { horizon: h, available: true, balanceLb: shown[h][0], shortageLb: shown[h][1] }\\n          : { horizon: h, available: false, balanceLb: null, shortageLb: null })),\\n      }),\\n    });\\n    const user = open();\\n    await until(/6\\\\.5\\\\s*%|0\\\\.065/);\\n    for (const h of [\\\"Weekly\\\", \\\"Quarterly\\\"]) {\\n      await pickHorizon(user, h);\\n      await waitFor(() => {\\n        const texts = horizonTexts(h);\\n        expect(texts.length, `no ${h} horizon on the page`).toBeGreaterThan(0);\\n        const marked = texts.filter((t) => /unavailable|not available/i.test(t));\\n        expect(marked.length, `${h} is not marked unavailable; has: ${texts.join(\\\" | \\\")}`).toBeGreaterThan(0);\\n        expect(marked.every((t) => !NUMERIC_ESTIMATE.test(t)), `${h} shows a numeric estimate: ${marked.join(\\\" | \\\")}`).toBe(true);\\n      }, { timeout: 4000 });\\n    }\\n    for (const h of Object.keys(shown)) {\\n      await pickHorizon(user, h);\\n      const [balance, shortage] = shown[h];\\n      await waitFor(() => expect(horizonTexts(h).some((t) => numRe(balance).test(t) && numRe(shortage).test(t) && !/unavailable|not available/i.test(t)), `${h} should show its numbers`).toBe(true), { timeout: 4000 });\\n    }\\n    expect(bodyText()).not.toMatch(/NaN|null|undefined/);\\n  }, T);\\n});\\n\\n// ---------- REQ-11 ... (22648 more characters not kept)","chars":42648}
