), pen(71, \\\"Pen 71\\\", 260), pen(72, \\\"Pen 72\\\", 200), pen(81, \\\"Pen 81\\\", 300),\\n];\\nconst LOTS: LotSummary[] = [\\n  lot(331, \\\"33-A\\\", \\\"Pen 33\\\", 180),\\n  lot(411, \\\"41-A\\\", \\\"Pen 41\\\", 130), lot(412, \\\"41-B\\\", \\\"Pen 41\\\", 120),\\n  lot(511, \\\"51-A\\\", \\\"Pen 51\\\", 150), lot(512, \\\"51-B\\\", \\\"Pen 51\\\", 100),\\n  lot(611, \\\"61-A\\\", \\\"Pen 61\\\", 140), lot(612, \\\"61-B\\\", \\\"Pen 61\\\", 100),\\n  lot(621, \\\"62-A\\\", \\\"Pen 62\\\", 120), lot(622, \\\"62-B\\\", \\\"Pen 62\\\", 100),\\n  lot(711, \\\"71-A\\\", \\\"Pen 71\\\", 150), lot(712, \\\"71-B\\\", \\\"Pen 71\\\", 110),\\n  lot(721, \\\"72-A\\\", \\\"Pen 72\\\", 120), lot(722, \\\"72-B\\\", \\\"Pen 72\\\", 80),\\n  lot(811, \\\"81-A\\\", \\\"Pen 81\\\", 150), lot(812, \\\"81-B\\\", \\\"Pen 81\\\", 100), lot(813, \\\"81-C\\\", \\\"Pen 81\\\", 50),\\n];\\n\\nconst RATIONS: Ration[] = [ration(31, \\\"Ridge Grower\\\", 0.152), ration(32, \\\"Ridge Finisher\\\", 0.171)];\\nconst ITEMS: InventoryItem[] = [\\n  item(21, \\\"Rolled barley\\\", \\\"Grain\\\", 14820, 418),\\n  item(22, \\\"Cottonseed hulls\\\", \\\"Forage\\\", 9365, 276),\\n  item(23, \\\"Wheat midds\\\", \\\"By-product\\\", 20110, 590),\\n];\\n\\nconst plan = (o: Partial<FeedingPlan> & { planId: number; penId: number; penName: string }): FeedingPlan => ({\\n  rationId: 31, rationName: \\\"Ridge Grower\\\", feedingDate: \\\"2026-01-16\\\", plannedFeedingTime: \\\"05:45\\\", animalCount: 250,\\n  perAnimalDailyRateLb: 26, plannedQuantityLb: 6500, quantityPerAnimalLb: 26, totalFeedCostUsd: 800, expectedEnergyIntakeMcal: 4000,\\n  status: \\\"Planned\\\", allocations: [], allocationReconciled: true, allocationDifferenceLb: 0, ...o,\\n});\\n\\nconst snapshot = (unit: number, qty = 1000): CostSnapshot => ({ itemId: 21, ingredientName: \\\"Rolled barley\\\", quantityLb: qty, unitCostUsdPerLb: unit });\\n\\nconst event = (o: Partial<FeedingEvent> & { eventId: number; planId: number; penId: number; penName: string }): FeedingEvent => ({\\n  rationName: \\\"Ridge Grower\\\", plannedQuantityLb: 7000, actualDeliveredQuantityLb: 7000, varianceLb: 0, feedCostUsd: 900, energyMcal: 4000,\\n  inventoryDecrementLb: 7000, wastageAdjustedEstimatedConsumptionLb: 7000, status: \\\"Complete\\\", allocations: [], costSnapshots: [],\\n  createdBy: \\\"operator\\\", createdAt: \\\"2026-01-15T12:00:00.000Z\\\", lastChangedBy: \\\"operator\\\", lastChangedAt: \\\"2026-01-15T12:00:00.000Z\\\", ...o,\\n});\\n\\nconst alloc = (lotId: number, lotName: string, quantityLb: number): LotAllocation => ({ lotId, lotName, quantityLb });\\n\\ninterface World {\\n  items?: InventoryItem[] | (() => InventoryItem[]);\\n  rations?: Ration[] | (() => Ration[]);\\n  plans?: FeedingPlan[];\\n  comparisons?: RationComparisonRow[] | (() => RationComparisonRow[]);\\n  forecast?: (ingredientId: number) => FeedForecastResponse;\\n  currency?: string;\\n}\\n\\nfunction serve(w: World = {}, ...extra: ReturnType<typeof http.post>[]) {\\n  const lots = LOTS;\\n  const pens = PENS;\\n  server.use(\\n    ...extra,\\n    getGetFeedInventoryMockHandler(() => ({ currency: w.currency ?? \\\"USD\\\", items: typeof w.items === \\\"function\\\" ? w.items() : w.items ?? ITEMS })),\\n    getGetRationsMockHandler({ currency: w.currency ?? \\\"USD\\\", rations: w.rations ?? RATIONS }),\\n    getGetFeedingPlansMockHandler({ plans: w.plans ?? [] }),\\n    getGetRationComparisonMockHandler(() => ({ comparisons: typeof w.comparisons === \\\"function\\\" ? w.comparisons() : w.comparisons ?? [] })),\\n    getGetOverviewMockHandler({ ...getGetOverviewResponseMock(), lots, pens }),\\n    getGetYardRecordsMockHandler({ ...getGetYardRecordsResponseMock(), lots, pens }),\\n    getGetFeedForecastMockHandler((info) => {\\n      const id = Number(new URL(info.request.url).searchParams.get(\\\"ingredientId\\\") ?? ITEMS[0].itemId);\\n      return w.forecast ? w.forecast(id) : { itemId: id, ingredientName: \\\"Rolled barley\\\", wastageRatio: 0.045, periods: [] };\\n    }),\\n  );\\n}\\n\\n// ---------- reading and acting on the page ----------\\n\\nconst bodyText = () => (document.body.textContent ?? \\\"\\\").replace(/\\\\s+/g, \\\" \\\");\\n\\n/** a number as a person may see it: thousands commas optional, minus sign required for negatives */\\nfunction numRe(n: number | string): RegExp {\\n  const s = String(n);\\n  const neg = s.startsWith(\\\"-\\\");\\n  const [int, dec] = (neg ? s.slice(1) : s).split(\\\".\\\");\\n  const intPat = int.replace(/\\\\B(?=(\\\\d{3})+$)/g, \\\",?\\\");\\n  return new RegExp(`(?<![\\\\\\\\d,.])${neg ? \\\"[-−–]\\\\\\\\s?\\\" : \\\"\\\"}${intPat}${dec ? `\\\\\\\\.${dec}` : \\\"\\\"}(?!\\\\\\\\d|,\\\\\\\\d|\\\\\\\\.\\\\\\\\d)`);\\n}\\n\\nasync function until(re: RegExp, timeout = 4000) {\\n  await waitFor(() => expect(bodyText()).toMatch(re), { timeout });\\n}\\n\\nconst ROW = \\\"tr, [role='row'], li, [role='listitem'], article\\\";\\n\\n/** some row / card / list entry whose name matches `name` also shows every one of `needs` (page-wide when the page has no such container) */\\nasync function expectRow(name: RegExp, ...needs: RegExp[]) {\\n  await waitFor(() => {\\n    const containers = new Set<Element>();\\n    for (const el of screen.queryAllByText(name)) { const c = el.closest(ROW); if (c) containers.add(c); }\\n    const texts = containers.size ? [...containers].map((c) => (c.textContent ?? \\\"\\\").replace(/\\\\s+/g, \\\" \\\")) : [bodyText()];\\n    expect(texts.some((t) => name.test(t) && needs.every((re) => re.test(t))), `no row for ${name} shows ${needs.join(\\\" and \\\")}; rows: ${texts.join(\\\" | \\\")}`).toBe(true);\\n  }, { timeout: 4000 });\\n}\\n\\ntype User = ReturnType<typeof userEvent.setup>;\\n\\nasync function openMenuItem(user: User, trigger: string, entry: string) {\\n  await user.click(await screen.findByRole(\\\"button\\\", { name: trigger }));\\n  const target = await Promise.any([\\n    screen.findByRole(\\\"menuitem\\\", { name: