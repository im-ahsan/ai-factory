toBeNull();\\n}\\n\\ndescribe(\\\"REQ-1 shared workspace\\\", () => {\\n  it(\\\"AC_1_1_ShowsSharedWorkspaceWithoutSignInOrRoleSelector\\\", async () => {\\n    server.use(getGetOverviewMockHandler(overviewData()));\\n    renderOverview();\\n    await see(\\\"Lot Overview-Alpha\\\");\\n    await see(\\\"Lot Overview-Bravo\\\");\\n    expect(screen.getByRole(\\\"heading\\\", { name: \\\"Yard overview\\\" })).toBeTruthy();\\n    expectNoSignIn();\\n    expect(seenRequests.length).toBeGreaterThan(0);\\n    for (const r of seenRequests) {\\n      expect(r.headers.get(\\\"authorization\\\")).toBeNull();\\n    }\\n    expect(nav.went.filter((w) => /login|sign-?in|auth/i.test(w))).toEqual([]);\\n  });\\n\\n  it(\\\"AC_1_2_ShowsSameControlsInTwoSessions\\\", async () => {\\n    server.use(\\n      getGetOverviewMockHandler(overviewData()),\\n      getGetFeedInventoryMockHandler({ currency: \\\"USD\\\", items: inventoryBase() }),\\n    );\\n    useYard({ purchaseOrders: [mkRecord({ recordId: 1, purchaseOrderNumber: \\\"PO-1\\\", vendor: \\\"Session Vendor\\\" })], lots: [mkLot(1, \\\"Lot Session-One\\\", \\\"SP-1\\\")], pens: [mkPen(1, \\\"SP-1\\\", 300, 200)] });\\n    const screens: Array<{ name: string; path: string; element: () => ReactElement; ready: string; required: string[] }> = [\\n      { name: \\\"overview\\\", path: \\\"/overview\\\", element: () => <YardOverviewContainer />, ready: \\\"Lot Overview-Alpha\\\", required: [\\\"Yard records\\\", \\\"Feed ops\\\", \\\"Insights\\\"] },\\n      { name: \\\"yard\\\", path: \\\"/yard\\\", element: () => <ProcurementLotRecordsContainer />, ready: \\\"Lot Session-One\\\", required: [\\\"Sync POs\\\"] },\\n      { name: \\\"feed\\\", path: \\\"/feed\\\", element: () => <FeedManagementContainer />, ready: \\\"Linseed Cake KX\\\", required: [\\\"Feed tools\\\", \\\"Feeding entry\\\", \\\"Reports & project brief\\\"] },\\n    ];\\n    const people = [{ id: \\\"alice\\\", role: \\\"admin\\\" }, { id: \\\"bob\\\", role: \\\"viewer\\\" }];\\n    for (const s of screens) {\\n      const seen: Array<{ who: string; controls: Control[] }> = [];\\n\\n      // two people, each in a fresh browser context of their own, one after the other\\n      for (const who of people) {\\n        startSession(s.path, who);\\n        render(s.element());\\n        await see(s.ready);\\n        expectNoSignIn();\\n        seen.push({ who: who.id, controls: controlsIn(document.body) });\\n        cleanup();\\n      }\\n\\n      // and both open at the same time, each page with its own state\\n      startSession(s.path, people[0]);\\n      const first = render(s.element());\\n      const second = render(s.element());\\n      await waitFor(() => {\\n        expect(first.container.textContent).toContain(s.ready);\\n        expect(second.container.textContent).toContain(s.ready);\\n      }, FIND);\\n      expectNoSignIn();\\n      seen.push({ who: \\\"open-together-1\\\", controls: controlsIn(first.container) });\\n      seen.push({ who: \\\"open-together-2\\\", controls: controlsIn(second.container) });\\n      cleanup();\\n\\n      expect(seen[0].controls.length, `${s.name}: controls found`).toBeGreaterThan(0);\\n      for (const name of s.required) {\\n        expect(seen[0].controls.some((c) => c.name.endsWith(name)), `${s.name}: control ${name}`).toBe(true);\\n      }\\n      for (const other of seen.slice(1)) {\\n        expect(other.controls, `${s.name}: controls for ${other.who} match those for ${seen[0].who}`).toEqual(seen[0].controls);\\n      }\\n    }\\n  });\\n});\\n\\n// ---------- AC-2: synchronisation ----------\\nconst syncResponse = (): SyncResponse => ({\\n  source: \\\"SRC-Alpha-Feed\\\",\\n  message: \\\"Synchronised 3 lines\\\",\\n  conflicts: [],\\n  records: [\\n    mkRecord({ recordId: 501, purchaseOrderNumber: \\\"PO-61842\\\", lineNumber: 1, receiptNumber: \\\"RCV-90317\\\", vendor: \\\"Prairie Ridge Cattle Co\\\", unitCostUsdPerTon: 1412, headCount: 187, averageWeightLb: 612, breed: \\\"Cha