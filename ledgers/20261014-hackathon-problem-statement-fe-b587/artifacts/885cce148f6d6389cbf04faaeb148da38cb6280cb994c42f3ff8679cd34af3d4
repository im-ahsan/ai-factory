es[1], yardTarget, \\\"Yard\\\", 2.1, isoDay(inDays(60))), // no lot target: the configured yard target\\n      mkForecast(3, names[2], 1501, \\\"Lot\\\", 2.0, isoDay(inDays(80))), // lot-specific target\\n      mkForecast(4, names[3], 1384, \\\"Lot\\\", 2.2, isoDay(inDays(95))), // target carried by its procurement line\\n    ];\\n    const procurement = [mkRecord({ recordId: 901, purchaseOrderNumber: \\\"PO-88100\\\", vendor: \\\"Target Procurement Vendor\\\", lotId: 4, lotName: names[3], penId: 4, penName: \\\"FP-4\\\" })];\\n    useForecasts(lotsOf(names), forecasts, yardTarget, procurement);\\n    renderYard();\\n    for (const n of names) await see(n);\\n    const targets = forecasts.map((f) => f.targetWeightLb);\\n    names.forEach((n, i) => {\\n      const row = regionWhere(n, (t) => hasNum(t, targets[i]) && !othersOf(names, n).some((o) => t.includes(o)));\\n      expect(row, `${n} shows its own target ${targets[i]} in its own row`).not.toBeNull();\\n      targets.forEach((other, j) => {\\n        if (j !== i) expect(hasNum(row!, other), `${n} must not show the target ${other} of ${names[j]}: ${row}`).toBe(false);\\n      });\\n    });\\n  });\",\"originalFile\":\"// @vitest-environment jsdom\\nimport { afterAll, afterEach, beforeAll, describe, expect, it, vi } from \\\"vitest\\\";\\nimport type { ReactElement } from \\\"react\\\";\\nimport { cleanup, render, screen, waitFor, within } from \\\"@testing-library/react\\\";\\nimport userEvent from \\\"@testing-library/user-event\\\";\\nimport { setupServer } from \\\"msw/node\\\";\\nimport { at, nav, TEST_NOW } from \\\"./support/screen\\\";\\nimport {\\n  getFeedlotWorkspaceAPIMock,\\n  getCreateInventoryItemMockHandler,\\n  getGetFeedInventoryMockHandler,\\n  getGetImportConflictsMockHandler,\\n  getGetLotForecastMockHandler,\\n  getGetLotForecastsMockHandler,\\n  getGetLotMetricsMockHandler,\\n  getGetLotWeightHistoryMockHandler,\\n  getGetOverviewMockHandler,\\n  getGetYardRecordsMockHandler,\\n  getSaveLot