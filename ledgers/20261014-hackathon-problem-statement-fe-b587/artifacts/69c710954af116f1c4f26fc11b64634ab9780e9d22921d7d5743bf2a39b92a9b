DateString(\\\"en-GB\\\", { day: \\\"numeric\\\", month: \\\"short\\\", year: \\\"numeric\\\", timeZone: \\\"UTC\\\" });\\nconst SAVED_AT = `${TODAY_ISO}T06:10:00Z`;\\n\\n// ---------- fixtures ----------\\nconst item = (id: number, name: string, category: string, avail: number, perTon: number, perLb: number): InventoryItem => ({\\n  id, name, category, availableQuantityLb: avail, unitOfMeasure: \\\"lb\\\", unitCostPerTon: perTon, unitCostPerLb: perLb,\\n  dryMatterPercent: 88, energyMcalPerLb: 0.9, storageLocation: `Bin ${id}`, openingStockLb: avail + 1000, receivedStockLb: 0,\\n  consumedStockLb: 1000, closingStockLb: avail,\\n});\\nconst ration = (o: Partial<Ration> & Pick<Ration, \\\"id\\\" | \\\"name\\\">): Ration => ({\\n  type: \\\"Grower\\\", ingredientProportionsAsFed: [], dryMatterPercent: 88.7, energyMcalPerLb: 0.68, intendedWeightRange: \\\"650-850 lb\\\",\\n  costPerLb: 0.128, adgLbPerDay: 3.42, costOfGain: 0.88, ...o,\\n});\\nconst alloc = (lotId: number, lotName: string, quantityLb: number) => ({ lotId, lotName, quantityLb });\\nconst plan = (o: Partial<FeedingPlan> & Pick<FeedingPlan, \\\"id\\\" | \\\"penId\\\" | \\\"penName\\\">): FeedingPlan => ({\\n  rationId: 301, rationName: \\\"North Yard Grower\\\", date: TODAY_ISO, plannedTime: \\\"06:00\\\", animalCount: 300, perAnimalRateLb: 20,\\n  plannedQuantityLb: 6000, cost: 768, expectedEnergyMcal: 4080, status: \\\"Planned\\\", allocationTotalLb: 6000, allocationDifferenceLb: 0,\\n  allocationReconciled: true, lotAllocations: [], ...o,\\n});\\nconst event = (o: Partial<FeedingEvent> & Pick<FeedingEvent, \\\"id\\\" | \\\"planId\\\" | \\\"penName\\\">): FeedingEvent => ({\\n  rationName: \\\"North Yard Grower\\\", plannedQuantityLb: 6000, actualDeliveredQuantityLb: 6000, varianceLb: 0, feedCost: 768,\\n  energyMcalPerLb: 0.68, energyMcal: 4080, inventoryDecrementLb: 6000, wastageAdjustedEstimatedConsumptionLb: 6270,\\n  unitCostSnapshots: [], lotAllocations: [], status: \\\"Completed\\\", savedAt: SAVED_AT, createdBy: \\\"operator-1\\\", lastChangedBy: \\\"operator-1\\\",\\n  revisedMetrics: { adgLbPerDay: 3.42, feedConversionRatio: 6.12, feedCostPerGain: 1.24 }, suggestions: [], ...o,\\n});\\nconst lot = (id: number, name: string, penId: number, penName: string, headCount: number): LotRecord => ({\\n  id, name, penId, penName, headCount, targetWeightLb: 1400, targetSource: \\\"lot\\\", adgLbPerDay: 3.1, breed: \\\"Angus\\\", sex: \\\"Steer\\\", receivingDate: \\\"2025-10-01\\\",\\n});\\nconst pen = (id: number, name: string, head: number, lotIds: number[]): PenRecord => ({ id, name, capacity: 500, currentAnimalCount: head, lotIds });\\n\\nconst baseYard = (): YardResponse => ({\\n  ...getGetYardRecordsResponseMock(),\\n  currency: \\\"USD\\\",\\n  pens: [\\n    pen(14, \\\"Pen 14\\\", 275, [1401, 1402]), pen(22, \\\"Pen 22\\\", 330, [2201, 2202]), pen(52, \\\"Pen 52\\\", 250, [5201, 5202]),\\n    pen(61, \\\"Pen 61\\\", 210, [6101, 6102]), pen(71, \\\"Pen 71\\\", 180, [7101]),\\n  ],\\n  lots: [\\n    lot(1401, \\\"Lot 14-A\\\", 14, \\\"Pen 14\\\", 140), lot(1402, \\\"Lot 14-B\\\", 14, \\\"Pen 14\\\", 135),\\n    lot(2201, \\\"Lot 22-A\\\", 22, \\\"Pen 22\\\", 190), lot(2202, \\\"Lot 22-B\\\", 22, \\\"Pen 22\\\", 140),\\n    lot(5201, \\\"Lot 52-A\\\", 52, \\\"Pen 52\\\", 150), lot(5202, \\\"Lot 52-B\\\", 52, \\\"Pen 52\\\", 100),\\n    lot(6101, \\\"Lot 61-A\\\", 61, \\\"Pen 61\\\", 110), lot(6102, \\\"Lot 61-B\\\", 61, \\\"Pen 61\\\", 100),\\n    lot(7101, \\\"Lot 71-A\\\", 71, \\\"Pen 71\\\", 180),\\n  ],\\n});\\n\\nconst baseFeed = (o: Partial<FeedResponse> = {}): FeedResponse => ({\\n  ...getGetFeedWorkspaceResponseMock(),\\n  currency: \\\"USD\\\",\\n  wastageRatio: 0.045,\\n  inventory: [\\n    item(101, \\\"Soybean meal\\\", \\\"Protein\\\", 760, 426, 0.213),\\n    item(104, \\\"Cracked corn\\\", \\\"Grain\\\", 28640, 338, 0.169),\\n    item(105, \\\"Alfalfa hay\\\", \\\"Forage\\\", 22400, 286, 0.143),\\n  ],\\n  forecasts: [],\\n  rations: [ration({ id: 301, name: \\\"North Yard Grower\\\" })],\\n  plans: [],\\n  events: [],\\n  ...o,\\n});\\n\\n// ---------- the API stand-in: every call is recorded ----------\\nfunction serve(feed: FeedResponse, post: Record<string, Handler> = {}, yard: YardResponse = baseYard()) {\\n  const calls: { method: string; path: string; body: any }[] = [];\\n  vi.stubGlobal(\\\"fetch\\\", async (input: RequestInfo | URL, init?: RequestInit) => {\\n    const url = new URL(typeof input === \\\"string\\\" ? input : input instanceof URL ? input.href : input.url);\\n    const method = (init?.method ?? \\\"GET\\\").toUpperCase();\\n    const body = init?.body ? JSON.parse(String(init.body)) : undefined;\\n    calls.push({ method, path: url.pathname, body });\\n    let status = 200;\\n    let data: unknown;\\n    if (method === \\\"GET\\\" && url.pathname === \\\"/api/feed\\\") data = feed;\\n    else if (method === \\\"GET\\\" && url.pathname === \\\"/api/yard\\\") data = yard;\\n    else {\\n      const h = post[`${method} ${url.pathname}`];\\n      if (h) [status, data] = h(body);\\n      else { status = 404; data = { code: \\\"not_found\\\", message: \\\"not found\\\" }; }\\n    }\\n    return new Response(JSON.stringify(data), { status, headers: { \\\"Content-Type\\\": \\\"application/json\\\" } });\\n  });\\n  return calls;\\n}\\n\\n// ---------- helpers ----------\\nconst text = () => (document.body.textContent ?? \\\"\\\").replace(/\\\\s+/g, \\\" \\\");\\nconst esc = (s: string) => s.replace(/[.*+?^${}()|[\\\\]\\\\\\\\]/g, \\\"\\\\\\\\$&\\\");\\n/** a number as a person reads it: thousands commas optional, never part of a longer number */\\nconst rx = (s: string) => new RegExp(`(?<![\\\\\\\\d.,])${esc(s).replace(/,/g, \\\",?\\\")}(?!\\\\\\\\d)`);\\nconst neg = (s: string) => new RegExp(`[\\\\\\\\u2212-]\\\\\\\\s?${esc(s).replace(/,/g, \\\",?\\\")}(?!\\\\\\\\d)`);\\nconst money = (cur: string, v: string) => new RegExp(`(?:${cur})\\\\\\\\s?${esc(v)}(?!\\\\\\\\d)|(?<![\\\\\\\\d.])${esc(v)}\\\\\\\\s?(?:${cur})`);\\n\\nasync function loaded(name: RegExp = /Cracked corn/) {\\n  await screen.findAllByText(name);\\n}\\nfunction open() {\\n  at(\\\"/feed\\\");\\n  render(<FeedManagementContainer />);\\n}\\n\\nasync function fill(u: U, label: RegExp, value: string | RegExp) {\\n  const el = screen.getByLabelText(label) as HTMLElement;\\n  if (el.tagName === \\\"SELECT\\\") {\\n    const sel = el as HTMLSelectElement;\\n    const match = (t: string) => (typeof value === \\\"string\\\" ? t.includes(value) : value.test(t));\\n    const opt = Array.from(sel.options).find((o) => match(o.textContent ?? \\\"\\\"));\\n    if (!opt) throw new Error(`no option ${String(value)} in ${String(label)}`);\\n    await u.selectOptions(sel, opt);\\n    return;\\n  }\\n  if (el.getAttribute(\\\"role\\\") === \\\"combobox\\\") {\\n    await u.click(el);\\n    const opts = await screen.findAllByRole(\\\"option\\\");\\n    const hit = opts.find((o) => (typeof value === \\\"string\\\" ? (o.textContent ?? \\\"\\\").includes(value) : value.test(o.textContent ?? \\\"\\\")));\\n    if (!hit) throw new Error(`no option ${String(value)} in ${String(label)}`);\\n    await u.click(hit);\\n    return;\\n  }\\n  const type = el.getAttribute(\\\"type\\\");\\n  if (type === \\\"time\\\") { fireEvent.change(el, { target: { value } }); return; }\\n  if (type === \\\"date\\\") { fireEvent.change(el, { target: { value: TOMORROW_ISO } }); return; }\\n  await u.clear(el);\\n  await u.type(el, String(value));\\n}\\nasync function tryFill(u: U, label: RegExp, value: string | RegExp) {\\n  if (screen.queryByLabelText(label)) await fill(u, label, value);\\n}\\n\\nasync function menuChoose(u: U, button: string, itemName: string | RegExp) {\\n  await u.click(screen.getByRole(\\\"button\\\", { name: button }));\\n  const found = (await screen.findAllByRole(\\\"menuitem\\\", { name: itemName }).catch(() => [] as HTMLElement[]))[0]\\n    ?? (await screen.findByRole(\\\"button\\\", { name: itemName }));\\n  await u.click(found);\\n}\\nasync function openFromTools(u: U, itemName: RegExp) {\\n  await u.click(screen.getByRole(\\\"button\\\", { name: \\\"Feed tools\\\" }));\\n  const mi = screen.queryAllByRole(\\\"menuitem\\\", { name: itemName })[0];\\n  if (mi) { await u.click(mi); return; }\\n  await u.keyboard(\\\"{Escape}\\\");\\n  await u.click(await screen.findByRole(\\\"button\\\", { name: itemName }));\\n}\\nasync function clickSubmit(u: U, name: RegExp, near?: HTMLElement) {\\n  const byName = screen.queryAllByRole(\\\"button\\\", { name })[0];\\n  const form = near?.closest(\\\"form\\\");\\n  const btn = byName ?? (form?.querySelector(\\\"button[type=submit], button:not([type])\\\") as HTMLElement | null);\\n  if (!btn) throw new Error(\\\"no submit button\\\");\\n  await u.click(btn);\\n}\\n\\nasync function planFeeding(u: U, penRe: RegExp, rate: string, allocText: string) {\\n  await menuChoose(u, \\\"Feeding entry\\\", \\\"Plan feeding\\\");\\n  await fill(u, /^pen\\\\b/i, penRe);\\n  await fill(u, /^selected ration/i, /North Yard Grower/);\\n  await fill(u, /feeding date/i, TOMORROW_HUMAN);\\n  await fill(u, /planned feeding time/i, \\\"05:45\\\");\\n  await fill(u, /per-animal bunk rate/i, rate);\\n  await fill(u, /lot.*allocation/i, allocText);\\n  await clickSubmit(u, /save feeding plan/i);\\n}\\nasync function recordActual(u: U, planRe: RegExp, delivered: string, allocText: string) {\\n  await menuChoose(u, \\\"Feeding entry\\\", \\\"Record actual\\\");\\n  await fill(u, /^saved plan/i, planRe);\\n  await fill(u, /delivered quantity/i, delivered);\\n  await fill(u, /actual feeding time/i, \\\"06:10\\\");\\n  await fill(u, /actual lot allocation/i, allocText);\\n  await clickSubmit(u, /save actual feeding/i);\\n}\\n\\nconst ROW = \\\"tr,[role=row],li,article\\\";\\nfunction rowWith(pen: RegExp, marker?: RegExp): HTMLElement {\\n  const dialog = screen.queryByRole(\\\"dialog\\\");\\n  if (dialog && (!marker || marker.test(dialog.textContent ?? \\\"\\\"))) return dialog;\\n  const rows = screen.queryAllByText(pen).map((e) => e.closest(ROW) as HTMLElement | null).filter((r): r is HTMLElement => !!r);\\n  return rows.find((r) => !marker || marker.test(r.textContent ?? \\\"\\\")) ?? document.body;\\n}\\nasync function openDetail(u: U, pen: RegExp, marker: RegExp): Promise<HTMLElement> {\\n  await waitFor(() => expect(text()).toMatch(marker));\\n  const row = rowWith(pen, marker);\\n  if (row !== document.body && !screen.queryByRole(\\\"dialog\\\")) {\\n    const viewer = within(row).queryByRole(\\\"button\\\", { name: /detail|view/i });\\n    await u.click(viewer ?? row);\\n  }\\n  return rowWith(pen, marker);\\n}\\nconst stext = (el: HTMLElement) => (el.textContent ?? \\\"\\\").replace(/\\\\s+/g, \\\" \\\");\\n\\nconst forecastPeriods = (over: Record<string, Partial<{ available: boolean; balanceLb: number; shortageLb: number; estimatedConsumptionLb: number }>> = {}) => {\\n  const base: Record<string, [number, number]> = {\\n    Daily: [21347, 0], Weekly: [-15263, 15300], Monthly: [-163417, 163500], Quarterly: [-551233, 551300], \\\"Bi-annual\\\": [-1131817, 1131900], Annual: [-2330961, 2331000],\\n  };\\n  return Object.entries(base).map(([horizon, [balanceLb, shortageLb]]) => ({\\n    horizon: horizon as \\\"Daily\\\", available: true, balanceLb, shortageLb, estimatedConsumptionLb: 40000, ...over[horizon],\\n  }));\\n};\\nasync function pickHorizon(u: U, h: string): Promise<boolean> {\\n  const el = screen.queryByRole(\\\"tab\\\", { name: h }) ?? screen.queryByRole(\\\"radio\\\", { name: h }) ?? screen.queryByRole(\\\"button\\\", { name: h });\\n  if (el) { await u.click(el); return true; }\\n  if (screen.queryByLabelText(/horizon/i)) { await fill(u, /horizon/i, h); return true; }\\n  return false;\\n}\\n\\ndescribe(\\\"feed management (part 2)\\\", () => {\\n  // ---------- REQ-9 ----------\\n  it(\\\"AC_9_1_ShowsRefusalAndShortageAndKeepsMovementForm\\\", async () => {\\n    const calls = serve(baseFeed(), {\\n    