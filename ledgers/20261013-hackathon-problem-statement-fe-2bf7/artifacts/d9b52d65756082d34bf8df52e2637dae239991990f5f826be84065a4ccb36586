\": \"A client has a valid bearer token and supplies a required date range plus optional breed, sex, or pen filters.\",\n  \"id\": \"AC-9.2\",\n  \"level\": \"api\",\n  \"then\": \"The response status is 200 and the response rows contain contract-defined ADG, feed, FCR, cost-of-gain, and energy fields for matching lots.\",\n  \"when\": \"The client sends GET /reports/feed-to-gain.\"\n },\n {\n  \"req\": \"REQ-9\",\n  \"given\": \"A client has a valid bearer token and supplies a valid feed-to-gain date range, supported filters, and format csv or pdf.\",\n  \"id\": \"AC-9.3\",\n  \"level\": \"api\",\n  \"then\": \"The response status is 200 and the response file artifact has contentType and content corresponding to the requested format and filtered authorized rows.\",\n  \"when\": \"The client sends GET /reports/feed-to-gain/export.\"\n },\n {\n  \"req\": \"REQ-9\",\n  \"given\": \"A client omits a required feed-to-gain date or supplies an export format outside the contract enum.\",\n  \"id\": \"AC-9.4\",\n  \"level\": \"api\",\n  \"then\": \"The response status is 422 and the response error code is VALIDATION_ERROR.\",\n  \"when\": \"The client sends a feed-to-gain report or export request.\"\n },\n {\n  \"req\": \"REQ-9\",\n  \"given\": \"A client has a valid bearer token and supplies supported profitability horizon, breed, penId, or roiStatus filters.\",\n  \"id\": \"AC-9.5\",\n  \"level\": \"api\",\n  \"then\": \"The response status is 200 and the response contains authorized matching profitability rows and canViewProfitability where declared, or a CSV file with those filtered authorized rows.\",\n  \"when\": \"The client sends GET /reports/profitability or GET /reports/profitability/export.\"\n },\n {\n  \"req\": \"REQ-9\",\n  \"given\": \"A client has a valid bearer token with access to lot-report rows but without profitability.view or profitability.export, and matching profitability data exists.\",\n  \"id\": \"AC-9.6\",\n  \"level\": \"api\",\n  \"then\": \"The report response status is 200, its canViewProfitability value is false, and its rows contain no non-null returnedInvestment, totalGainValue, netReturn, or roiPercent values; the export response status is 403 and contains no file artifact.\",\n  \"when\": \"The client sends GET /reports/profitability and GET /reports/profitability/export using supported filters.\"\n },\n {\n  \"req\": \"REQ-9\",\n  \"given\": \"A client has a valid bearer token with profitability.view but without profitability.export, and matching profitability data exists.\",\n  \"id\": \"AC-9.7\",\n  \"level\": \"api\",\n  \"then\": \"The report response status is 200, its canViewProfitability value is true, and its matching rows contain the contract-defined profitability values; the export response status is 403 and contains no file artifact.\",\n  \"when\": \"The client sends GET /reports/profitability and GET /reports/profitability/export using supported filters.\"\n },\n {\n  \"req\": \"REQ-9\",\n  \"given\": \"A client has a valid bearer token with profitability.export but without profitability.view, and matching profitability data exists.\",\n  \"id\": \"AC-9.8\",\n  \"level\": \"api\",\n  \"then\": \"The report response status is 200, its canViewProfitability value is false, and its rows contain no non-null returnedInvestment, totalGainValue, netReturn, or roiPercent values; the export response status is 200 and the response contains the contract-defined CSV file artifact.\",\n  \"when\": \"The client sends GET /reports/profitability and GET /reports/profitability/export using supported filters.\"\n },\n {\n  \"req\": \"REQ-10\",\n  \"given\": \"A client has a valid bearer token and sample records may be absent, not yet loaded, or already loaded.\",\n  \"id\": \"AC-10.1\",\n  \"level\": \"api\",\n  \"then\": \"The response status is 200 and the response loaded, recordCount, records, and load status distinguish an empty set, a successful load, and already_loaded without duplicating records.\",\n  \"when\": \"The client sends GET /sample-data or POST /sample-data/load.\"\n },\n {\n  \"req\": \"REQ-10\",\n  \"given\": \"A client has a valid bearer token and sample records exist; the client records the GET /sample-data response records and recordCount before attempting reset.\",\n  \"id\": \"AC-10.2\",\n  \"level\": \"api\",\n  \"then\": \"The unconfirmed response status is the contract-declared 422 or 409 and the intervening GET response records and recordCount are unchanged; the confirmed response reports the completed reset status and resulting recordCount, and the final GET response records do not contain the previously recorded affected sample records.\",\n  \"when\": \"The client sends POST /sample-data/reset without required confirmation, reads GET /sample-data, then repeats the reset with explicit confirmation and reads GET /sample-data again.\"\n },\n {\n  \"req\": \"REQ-10\",\n  \"given\": \"A client has a valid bearer token and sample records exist; the client records the GET /sample-data response records and recordCount before attempting replacement.\",\n  \"id\": \"AC-10.3\",\n  \"level\": \"api\",\n  \"then\": \"The unconfirmed response status is the contract-declared 422 or 409 and the intervening GET response records and recordCount are unchanged; the confirmed response reports the completed replacement status and resulting recordCount, and the final GET response records contain the replacement sample records rather than the previously recorded affected sample records.\",\n  \"when\": \"The client sends POST /sample-data/replace without required confirmation, reads GET /sample-data, then repeats replacement with explicit confirmation and reads GET /sample-data again.\"\n },\n {\n  \"req\": \"REQ-11\",\n  \"given\": \"The API is configured with an App PostgreSQL connection and a client successfully creates or updates a contract resource.\",\n  \"id\": \"AC-11.1\",\n  \"level\": \"api\",\n  \"then\": \"The response contains the saved value 