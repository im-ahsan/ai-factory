D\",\n    \"sources\": [\n     \"I-1\",\n     \"Q-1\"\n    ]\n   },\n   {\n    \"acceptance\": [\n     {\n      \"given\": \"A client has a valid bearer token and the source adapter is available\",\n      \"id\": \"AC-REQ-2.1\",\n      \"level\": \"api\",\n      \"then\": \"the response status is 200 and the response records field is a list of available procurement and receiving records\",\n      \"when\": \"it sends GET /api/imports/source-records\"\n     },\n     {\n      \"given\": \"A client has a valid bearer token and submits a valid ImportRequest selecting source records\",\n      \"id\": \"AC-REQ-2.2\",\n      \"level\": \"api\",\n      \"then\": \"the response status is 200 and the response contains status, createdCount, updatedCount, records, and allocationConflicts fields\",\n      \"when\": \"it sends POST /api/imports\"\n     },\n     {\n      \"given\": \"A client has a valid bearer token\",\n      \"id\": \"AC-REQ-2.3\",\n      \"level\": \"api\",\n      \"then\": \"the response status is 200 and the response contains poLines, lotPens, and pens lists\",\n      \"when\": \"it sends GET /api/allocations\"\n     },\n     {\n      \"given\": \"A client has a valid bearer token and submits a valid AllocationUpdateRequest\",\n      \"id\": \"AC-REQ-2.4\",\n      \"level\": \"api\",\n      \"then\": \"the response status is 200 and the response contains the saved PO-line-to-lot and lot-to-pen allocation values\",\n      \"when\": \"it sends PUT /api/allocations\"\n     }\n    ],\n    \"ears\": \"Where the locked OpenAPI contract defines procurement import and allocation operations, the Feedlot API shall provide the declared preview, import, read-allocation, and save-allocation behavior.\",\n    \"id\": \"REQ-2\",\n    \"op\": \"ADDED\",\n    \"sources\": [\n     \"I-1\",\n     \"Q-1\"\n    ]\n   },\n   {\n    \"acceptance\": [\n     {\n      \"given\": \"A client has a valid bearer token and the requested lot exists\",\n      \"id\": \"AC-REQ-3.1\",\n      \