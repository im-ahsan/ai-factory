<!-- VANILLA JAVASCRIPT: SIMULATOR & INTERACTIVE LOGIC        -->
<!-- ======================================================== -->
<script>
    // State Tracker
    let currentSimState = 'normal';

    function setSimState(state) {
      currentSimState = state;
      
      // Update Toolbar Buttons
      const buttons = {
        'normal': document.getElementById('sim-btn-normal'),
        'loading': document.getElementById('sim-btn-loading'),
        'success': document.getElementById('sim-btn-success'),
        'error': document.getElementById('sim-btn-error'),
        'badges': document.getElementById('sim-btn-badges')
      };

      for (const [key, btn] of Object.entries(buttons)) {
        if (!btn) continue;
        if (key === state) {
          btn.className = "px-2.5 py-1 rounded font-medium bg-primary-container text-white transition-all active:scale-[0.97] flex items-center gap-1 shadow-sm";
        } else {
          btn.className = "px-2.5 py-1 rounded font-medium bg-surface-container-lowest text-on-surface border border-outline-variant hover:bg-surface-variant transition-all active:scale-[0.97] flex items-center gap-1";
        }
      }

      // DOM Targets
      const toast = document.getElementById('toast-banner');
      const errorBanner = document.getElementById('error-banner');
      const badgeDisplay = document.getElementById('badge-display');
      const badgeLabelText = document.getElementById('badge-label-text');
      const badgeSubtext = document.getElementById('badge-subtext');
      const btnRelease = document.getElementById('btn-release-action');
      const btnLabelText = document.getElementById('btn-label-text');

      // Reset banners
      toast.classList.add('hidden');
      errorBanner.classList.add('hidden');
      badgeSubtext.classList.add('hidden');

      if (state === 'normal') {
        // 1. NORMAL STATE
        badgeDisplay.className = "inline-flex items-center gap-1.5 px-2.5 py-1 rounded text-xs font-medium border border-[#D4D4D8] bg-[#F7F7F8] text-[#3F3F46]";
        badgeDisplay.innerHTML = `<span class="w-2 h-2 rounded-full bg-[#9A6700]"></span><span id="badge-label-text" class="font-medium">Not released</span>`;
        
        btnRelease.disabled = false;
        btnRelease.className = "w-full sm:w-auto h-10 px-5 rounded font-body font-medium text-sm text-white bg-primary-container hover:bg-[#195C4C] active:scale-[0.97] transition-all flex items-center justify-center gap-2 focus:outline-none focus:ring-2 focus:ring-primary-container focus:ring-offset-2";
        btnRelease.innerHTML = `<span class="material-symbols-outlined text-[18px]" data-icon="free_cancellation">free_cancellation</span><span>Release today's space</span>`;
      } 
      else if (state === 'loading') {
        // 2. LOADING STATE
        badgeDisplay.className = "inline-flex items-center gap-1.5 px-2.5 py-1 rounded text-xs font-medium border border-outline-variant bg-surface text-outline";
        badgeDisplay.innerHTML = `<span class="w-2 h-2 rounded-full bg-outline"></span><span>Updating…</span>`;

        btnRelease.disabled = true;
        btnRelease.className = "w-full sm:w-auto h-10 px-5 rounded font-body font-medium text-sm text-outline-variant bg-surface-variant cursor-not-allowed flex items-center justify-center gap-2";
        btnRelease.innerHTML = `
          <svg class="animate-spin -ml-1 mr-2 h-4 w-4 text-outline" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
          </svg>
          <span>Releasing…</span>`;
      }
      else if (state === 'success') {
        // 3. SUCCESS STATE
        toast.classList.remove('hidden');
        badgeSubtext.classList.remove('hidden');
        badgeSubtext.textContent = "Claimable at 08:00 PKT (released at 07:15 PKT)";

        badgeDisplay.className = "inline-flex items-center gap-1.5 px-2.5 py-1 rounded text-xs font-medium bg-[#E6F0ED] text-primary-container border border-primary-container/20 chip-swap";
        badgeDisplay.innerHTML = `<span class="w-2 h-2 rounded-full bg-primary-container"></span><span class="font-medium">Reserved</span>`;

        btnRelease.disabled = true;
        btnRelease.className = "w-full sm:w-auto h-10 px-5 rounded font-body font-medium text-sm text-primary-container bg-[#E6F0ED] border border-primary-container/30 cursor-default flex items-center justify-center gap-2";
        btnRelease.innerHTML = `<span class="material-symbols-outlined text-[18px]" data-icon="check" data-weight="fill">check</span><span>Released for today</span>`;
      }
      else if (state === 'error') {
        // 4. ERROR STATE
        errorBanner.classList.remove('hidden');
        badgeDisplay.className = "inline-flex items-center gap-1.5 px-2.5 py-1 rounded text-xs font-medium bg-[#FBEAE8] text-error border border-error/30";
        badgeDisplay.innerHTML = `<span class="w-2 h-2 rounded-full bg-error"></span><span class="font-medium">Already released</span>`;

        btnRelease.disabled = true;
        btnRelease.className = "w-full sm:w-auto h-10 px-5 rounded font-body font-medium text-sm text-outline bg-surface-variant cursor-not-allowed flex items-center justify-center gap-2";
        btnRelease.innerHTML = `<span class="material-symbols-outlined text-[18px]" data-icon="block">block</span><span>Cannot re-release</span>`;
      }
      else if (state === 'badges') {
        // 5. BADGE VARIANTS PREVIEW
        badgeSubtext.classList.remove('hidden');
        badgeSubtext.textContent = "Live Allocation Mode: Assigned to employee at 08:03 PKT";
        
        badgeDisplay.className = "inline-flex items-center gap-1.5 px-2.5 py-1 rounded text-xs font-medium bg-[#F1F4F1] text-[#18181B] border border-outline-variant";
        badgeDisplay.innerHTML = `<span class="w-2 h-2 rounded-full bg-[#2F7D4A]"></span><span class="font-medium">Claimed — by an employee at 08:03 PKT</span>`;

        btnRelease.disabled = true;
        btnRelease.className = "w-full sm:w-auto h-10 px-5 rounded font-body font-medium text-sm text-[#18181B] bg-surface-variant border border-outline-variant cursor-default flex items-center justify-center gap-2";
        btnRelease.innerHTML = `<span class="material-symbols-outlined text-[18px]" data-icon="assignment_turned_in">assignment_turned_in</span><span>Claimed for today</span>`;
      }
    }

    // Interactive button trigger to showcase realistic loading flow
    function handleUserReleaseClick() {
      setSimState('loading');
      setTimeout(() => {
        setSimState('success');
      }, 900);
    }

    function dismissToast() {
      document.getElementById('toast-banner').classList.add('hidden');
    }
  </script>
