<span class="w-2 h-2 rounded-full bg-[#1F6F5C] animate-ping flex-shrink-0"></span>
<span class="truncate">Validating Single Sign-On session tokens</span>
</div>
</div>
<!-- ========================================== -->
<!-- STATE 3: ERROR STATE -->
<!-- ========================================== -->
<div class="hidden space-y-5" id="state-error">
<!-- Stop Red Inline Alert Container -->
<div class="p-3.5 rounded bg-[#FBEAE8] border border-[#ffdad6] text-[#ba1a1a] flex gap-3 text-left">
<span class="material-symbols-outlined text-[20px] text-[#ba1a1a] flex-shrink-0 mt-0.5" data-icon="error">error</span>
<div class="space-y-1">
<div class="text-xs font-semibold uppercase tracking-wider text-[#93000a]">Domain Restriction</div>
<p class="text-xs text-[#18181B] leading-relaxed">
<span class="font-mono font-medium text-[#ba1a1a]">ahmed.raza@gmail.com</span> is not a Folio3 Workspace account. Personal Gmail and other providers are not accepted.
            </p>
</div>
</div>
<button class="w-full h-11 px-4 flex items-center justify-center gap-2 rounded bg-surface-container-lowest border border-outline-variant text-[#18181B] font-body text-sm font-medium hover:bg-surface-container-low hover:border-outline focus:outline-none focus:ring-2 focus:ring-[#1F6F5C] focus:ring-offset-2 active:scale-[0.98] transition-all duration-160" onclick="switchState('default')" type="button">
