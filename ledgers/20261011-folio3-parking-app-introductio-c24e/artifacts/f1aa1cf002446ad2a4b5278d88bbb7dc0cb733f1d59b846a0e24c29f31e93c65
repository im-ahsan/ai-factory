</a>
</div>
</header>
<!-- ========================================== -->
<!-- Main Viewport Canvas (Centered Auth Experience) -->
<!-- ========================================== -->
<main class="flex-1 flex flex-col items-center justify-center px-4 py-8 sm:py-12 relative">
<!-- State Switcher Bar for Review & Testing -->
<div class="mb-6 flex items-center gap-1 p-1 bg-surface-container-low rounded-lg border border-outline-variant">
<span class="text-[11px] font-semibold text-outline uppercase tracking-wider px-2.5 py-1">Mode Preview:</span>
<button class="px-3 py-1 rounded text-xs font-medium bg-surface-container-lowest text-on-surface shadow-sm border border-outline-variant transition-all duration-160" id="tab-default" onclick="switchState('default')">
        Default View
      </button>
<button class="px-3 py-1 rounded text-xs font-medium text-on-surface-variant hover:text-on-surface transition-all duration-160" id="tab-loading" onclick="switchState('loading')">
        Loading Flow
      </button>
<button class="px-3 py-1 rounded text-xs font-medium text-on-surface-variant hover:text-on-surface transition-all duration-160" id="tab-error" onclick="switchState('error')">
        Access Error
      </button>
</div>
<!-- Centered Authentication Card -->
<div class="w-full max-w-[440px] bg-surface-container-lowest rounded-lg border border-outline-variant p-8 sm:p-10 shadow-[0_1px_3px_rgba(24,24,27,0.05)] transition-all">
<!-- Card Branding Header -->
<div class="flex flex-col items-center text-center mb-8">
<!-- Logo Emblem -->
<div class="w-12 h-12 rounded-lg bg-[#1F6F5C] flex items-center justify-center text-white mb-4 shadow-sm ring-4 ring-[#E6F0ED]">
<span class="font-headline font-bold text-2xl tracking-tighter">P</span>
</div>
<!-- Product Name & Headline -->
<h1 class="text-2xl font-headline font-semibold text-[#18181B] tracking-tight">
          Folio3 Parking System
        </h1>
<p class="text-sm text-[#52525B] mt-1.5 leading-relaxed max-w-[320px]">
          Claim released parking spaces at the Folio3 office
        </p>
</div>
<!-- ========================================== -->
<!-- STATE 1: DEFAULT STATE -->
<!-- ========================================== -->
<div class="space-y-6" id="state-default">
<button class="w-full h-11 px-4 flex items-center justify-center gap-3 rounded bg-surface-container-lowest border border-outline-variant text-[#18181B] font-body text-sm font-medium hover:bg-surface-container-low hover:border-outline focus:outline-none focus:ring-2 focus:ring-[#1F6F5C] focus:ring-offset-2 active:scale-[0.98] transition-all duration-160" onclick="triggerGoogleSignIn()" type="button">
<!-- Google 'G' official vector -->
<svg class="w-4 h-4 flex-shrink-0" viewbox="0 0 24 24">
<path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"></path>
<path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"></path>
