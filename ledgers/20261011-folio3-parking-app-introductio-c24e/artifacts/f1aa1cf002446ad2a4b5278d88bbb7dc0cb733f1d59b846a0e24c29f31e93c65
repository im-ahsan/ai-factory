</div>
<!-- ========================================== -->
<!-- STATE 2: LOADING STATE -->
<!-- ========================================== -->
<div class="hidden space-y-6" id="state-loading">
<button class="w-full h-11 px-4 flex items-center justify-center gap-2.5 rounded bg-surface-container-low border border-outline-variant text-[#71717A] font-body text-sm font-medium cursor-not-allowed" disabled="" type="button">
<!-- Calm Pine/Forest Spinner -->
<svg class="animate-spin h-4 w-4 text-[#1F6F5C]" fill="none" viewbox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
