<header class="w-full px-6 py-3.5 flex items-center justify-between border-b border-outline-variant bg-surface-container-lowest">
<div class="flex items-center gap-3">
<!-- Minimalist geometric Parking P emblem -->
<div class="w-8 h-8 rounded bg-primary-container flex items-center justify-center text-on-primary font-headline font-bold text-base shadow-sm">
        P
      </div>
<div class="flex flex-col">
<span class="text-lg font-headline font-bold text-on-surface tracking-tight leading-none">
          Folio3 Parking
        </span>
<span class="text-[10px] font-mono tracking-wider text-outline uppercase mt-0.5">
          Internal Console
        </span>
</div>
</div>
<!-- Trailing Action: Help link according to JSON trailing_icon_actions: ["help_outline"] -->
<div class="flex items-center gap-4">
<div class="hidden sm:inline-flex items-center gap-1.5 px-2 py-1 rounded bg-surface-container text-xs font-mono text-outline">
