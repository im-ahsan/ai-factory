<!-- Copyright exact label from JSON -->
<div class="text-xs font-semibold text-on-surface-variant">
      © 2025 Folio3 Software. Internal system for authorised personnel only.
    </div>
<!-- Links exact labels from JSON: ["Security Policy", "Terms of Access", "Help Desk"] -->
<div class="flex items-center gap-6">
<a class="text-on-surface-variant hover:text-primary transition-colors duration-160" href="#security">
        Security Policy
      </a>
<a class="text-on-surface-variant hover:text-primary transition-colors duration-160" href="#terms">
        Terms of Access
      </a>
<a class="text-on-surface-variant hover:text-primary transition-colors duration-160" href="#help-desk">
        Help Desk
      </a>
</div>
</footer>
<!-- State Toggle Handler Script -->
<script>
    function switchState(stateName) {
      const states = ['default', 'loading', 'error'];
      states.forEach(s => {
        const el = document.getElementById(`state-${s}`);
        const tab = document.getElementById(`tab-${s}`);
        if (s === stateName) {
          el.classList.remove('hidden');
          tab.className = "px-3 py-1 rounded text-xs font-medium bg-surface-container-lowest text-on-surface shadow-sm border border-outline-variant transition-all duration-160";
        } else {
          el.classList.add('hidden');
          tab.className = "px-3 py-1 rounded text-xs font-medium text-on-surface-variant hover:text-on-surface transition-all duration-160";
        }
      });
    }

    function triggerGoogleSignIn() {
      // Simulate real auth handshake transition
      switchState('loading');
      setTimeout(() => {
        switchState('error');
      }, 1600);
    }
  </script>
