<!-- Vanilla JavaScript Interactions & Filters                                 -->
<!-- ========================================================================= -->
<script>
    let currentFilter = 'all';
    let searchQuery = '';

    // Filter selector logic
    function setFilter(filterType) {
      currentFilter = filterType;
      
      // Update UI tab appearance
      const tabs = [
        { id: 'filter-all', type: 'all' },
        { id: 'filter-dedicated', type: 'dedicated' },
        { id: 'filter-nondedicated', type: 'nondedicated' },
      ];

      tabs.forEach(tab => {
        const el = document.getElementById(tab.id);
        if (el) {
          if (tab.type === filterType) {
            el.className = "tab-active text-sm pb-2.5 px-2 flex items-center gap-2 transition-all";
          } else {
            el.className = "text-[#71717A] hover:text-[#18181B] text-sm pb-2.5 px-2 flex items-center gap-2 border-b-2 border-transparent transition-all";
          }
        }
      });

      // Missing pill outline highlight
      const missingPill = document.getElementById('filter-missing');
      if (filterType === 'missing') {
        missingPill.className = "ml-2 text-xs font-medium py-1 px-3 rounded-full border-2 border-error bg-error-container/80 text-error flex items-center gap-1.5 transition-colors ring-2 ring-error/20";
      } else {
        missingPill.className = "ml-2 text-xs font-medium py-1 px-3 rounded-full border border-tertiary-fixed-dim/60 bg-error-container/30 text-tertiary hover:bg-error-container/60 flex items-center gap-1.5 transition-colors";
      }

      applyFilters();
    }

    // Live search handler
    function handleSearch(val) {
      searchQuery = val.trim().toLowerCase();
      applyFilters();
    }

    // Apply combined filters and search query
    function applyFilters() {
      const rows = document.querySelectorAll('.employee-row');
      let visibleCount = 0;

      rows.forEach(row => {
        const text = row.innerText.toLowerCase();
        const type = row.getAttribute('data-type');
        const hasPlate = row.getAttribute('data-hasplate') === 'true';

        let matchesFilter = false;
        if (currentFilter === 'all') {
          matchesFilter = true;
        } else if (currentFilter === 'dedicated') {
          matchesFilter = (type === 'dedicated');
        } else if (currentFilter === 'nondedicated') {
          matchesFilter = (type === 'nondedicated');
        } else if (currentFilter === 'missing') {
          matchesFilter = !hasPlate;
        }

        const matchesSearch = searchQuery === '' || text.includes(searchQuery);

        if (matchesFilter && matchesSearch) {
          row.style.display = '';
          visibleCount++;
        } else {
          row.style.display = 'none';
        }
      });

      // Update counters & empty state visibility
      const emptyState = document.getElementById('table-empty-state');
      const tableFooter = document.getElementById('table-footer');
      const countLabel = document.getElementById('showing-count');

      if (visibleCount === 0) {
        emptyState.classList.remove('hidden');
        tableFooter.classList.add('hidden');
      } else {
        emptyState.classList.add('hidden');
        tableFooter.classList.remove('hidden');
        countLabel.textContent = `Showing ${visibleCount} of 3 employees`;
      }
    }

    function clearAllFilters() {
      document.getElementById('employee-search-input').value = '';
      searchQuery = '';
      setFilter('all');
    }

    // State simulator switcher
    function switchState(state) {
      const activeBtn = document.getElementById('sim-btn-active');
      const emptyBtn = document.getElementById('sim-btn-empty');

      if (state === 'active') {
        activeBtn.className = "px-2.5 py-1 rounded bg-surface-container-lowest font-medium text-primary shadow-xs border border-outline-variant";
        emptyBtn.className = "px-2.5 py-1 rounded hover:bg-surface-container-low text-on-surface-variant border border-transparent transition-colors";
        clearAllFilters();
      } else {
        emptyBtn.className = "px-2.5 py-1 rounded bg-surface-container-lowest font-medium text-primary shadow-xs border border-outline-variant";
        activeBtn.className = "px-2.5 py-1 rounded hover:bg-surface-container-low text-on-surface-variant border border-transparent transition-colors";
        // simulate no matching result
        document.getElementById('employee-search-input').value = 'xyz-non-existent-query';
        handleSearch('xyz-non-existent-query');
      }
    }

    // Drawer state and dynamic profile injection
    const employeeData = {
      ayesha: {
        initials: "AS",
        name: "Ayesha Siddiqui",
        id: "F3-0921 · Software Engineering",
        email: "ayesha.siddiqui@folio3.com",
        dedicated: true,
        space: "BAY B1-03",
        floor: "Basement 1 (B1)",
        plates: [
          { plate: "LEC-18-3320", vehicle: "Honda Civic · Silver", primary: true }
        ]
      },
      bilal: {
        initials: "BA",
        name: "Bilal Ahmed",
        id: "F3-1187 · Quality Assurance",
        email: "bilal.ahmed@folio3.com",
        dedicated: false,
        space: "Pool Bay (General Lot)",
        floor: "Ground Floor",
        plates: [
          { plate: "BKX-482", vehicle: "Toyota Yaris · White", primary: true },
          { plate: "LEA-19-7731", vehicle: "Suzuki Cultus · Blue", primary: false }
        ]
      },
      hamza: {
        initials: "HQ",
        name: "Hamza Qureshi",
        id: "F3-1302 · Operations",
        email: "hamza.qureshi@folio3.com",
        dedicated: false,
        space: "Unassigned",
        floor: "—",
        plates: []
      }
    };

    function selectRow(personKey) {
      const data = employeeData[personKey];
      if (!data) return;

      document.getElementById('drawer-avatar').innerText = data.initials;
      document.getElementById('drawer-name').innerText = data.name;
      document.getElementById('drawer-id').innerText = data.id;
      document.getElementById('drawer-email').innerText = data.email;
      document.getElementById('drawer-floor-val').innerText = data.floor;

      const dedicatedEl = document.getElementById('drawer-dedicated-status');
      const spaceChip = document.getElementById('drawer-space-chip');

      if (data.dedicated) {
        dedicatedEl.innerHTML = '<span class="w-1.5 h-1.5 rounded-full bg-[#1F6F5C]"></span> Dedicated Bay';
        dedicatedEl.className = "inline-flex items-center gap-1.5 px-2 py-0.5 rounded text-xs font-medium bg-secondary-container text-on-secondary-container";
        spaceChip.className = "space-chip";
        spaceChip.innerHTML = `<span class="material-symbols-outlined text-[13px]" data-icon="location_on">location_on</span> ${data.space}`;
      } else {
        dedicatedEl.innerHTML = '<span class="w-1.5 h-1.5 rounded-full bg-outline"></span> Non-dedicated';
        dedicatedEl.className = "inline-flex items-center gap-1.5 px-2 py-0.5 rounded text-xs font-medium bg-surface-container text-[#71717A]";
        spaceChip.className = "text-xs font-mono text-[#71717A] bg-surface-container px-2 py-1 rounded";
        spaceChip.innerHTML = data.space;
      }

      // Populate plates
      const platesContainer = document.getElementById('drawer-plates-container');
      platesContainer.innerHTML = '';

      if (data.plates.length === 0) {
        platesContainer.innerHTML = `
          <div class="p-3 rounded border border-error/30 bg-[#FBEAE8] text-xs text-[#B42318] flex items-center gap-2">
            <span class="material-symbols-outlined text-[16px]" data-icon="warning">warning</span>
            <span>No license plate registered. Security will deny vehicle entry at guard gate.</span>
          </div>
        `;
      } else {
        data.plates.forEach(p => {
          platesContainer.innerHTML += `
            <div class="p-3 rounded border border-outline-variant bg-surface flex items-center justify-between">
              <div class="flex items-center gap-2.5">
                <span class="plate-chip">${p.plate}</span>
                <div>
                  <div class="text-xs font-medium text-[#18181B]">${p.vehicle}</div>
                  <div class="text-[10px] text-[#71717A]">Verified Guard Console</div>
                </div>
              </div>
              ${p.primary ? '<span class="text-[11px] font-mono text-[#1F6F5C] font-semibold bg-[#E6F0ED] px-2 py-0.5 rounded">PRIMARY</span>' : ''}
            </div>
          `;
        });
      }

      toggleDrawer(true);
    }

    function toggleDrawer(open) {
      const drawer = document.getElementById('employee-drawer');
      const backdrop = document.getElementById('drawer-backdrop');
      if (open) {
        backdrop.classList.remove('hidden');
        drawer.classList.remove('translate-x-full');
      } else {
        drawer.classList.add('translate-x-full');
        backdrop.classList.add('hidden');
      }
    }
  </script>
