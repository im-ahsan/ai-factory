<!-- State Switcher & Simulation Logic -->
<script>
    let currentState = 'default';

    function setBtnStyle(activeId) {
      const btnIds = ['btn-state-default', 'btn-state-claiming', 'btn-state-success', 'btn-state-conflict', 'btn-state-zero'];
      btnIds.forEach(id => {
        const btn = document.getElementById(id);
        if (!btn) return;
        if (id === activeId) {
          btn.className = "px-3 py-1 font-semibold rounded text-xs transition-colors bg-[#FFFFFF] text-[#18181B] shadow-sm border border-[#E4E4E7]";
        } else {
          btn.className = "px-3 py-1 font-medium rounded text-xs transition-colors text-[#71717A] hover:text-[#18181B]";
        }
      });
    }

    function switchState(stateName) {
      currentState = stateName;
      const defaultContent = document.getElementById('state-default-content');
      const successContent = document.getElementById('state-success-content');
      const conflictBanner = document.getElementById('state-conflict-banner');
      
      const metricNum = document.getElementById('metric-number');
      const metricLabel = document.getElementById('metric-label');
      const metricDesc = document.getElementById('metric-description');
      const claimBtn = document.getElementById('primary-claim-btn');
      const btnText = document.getElementById('btn-text');
      const cardDot = document.getElementById('card-dot');

      // Reset base visibility
      conflictBanner.classList.add('hidden');
      successContent.classList.add('hidden');
      defaultContent.classList.remove('hidden');
      claimBtn.disabled = false;
      claimBtn.className = "btn-press w-full sm:w-auto min-w-[260px] h-11 px-8 rounded-[6px] bg-[#1F6F5C] hover:bg-[#195C4C] text-[#FFFFFF] font-body text-sm font-semibold transition-all shadow-none flex items-center justify-center gap-2 focus:outline-none focus:ring-2 focus:ring-[#1F6F5C] focus:ring-offset-2";
      btnText.textContent = "Claim a space for today";
      cardDot.className = "w-2.5 h-2.5 rounded-full bg-[#1F6F5C] live-dot";

      if (stateName === 'default') {
        setBtnStyle('btn-state-default');
        metricNum.textContent = "3";
        metricLabel.textContent = "spaces available now";
        metricDesc.textContent = "Eligible employees in General Pool may claim immediate reserved entry for today.";
      } 
      else if (stateName === 'claiming') {
        setBtnStyle('btn-state-claiming');
        metricNum.textContent = "3";
        metricLabel.textContent = "spaces available now";
        claimBtn.disabled = true;
        btnText.innerHTML = `<span class="inline-block animate-spin mr-2">◌</span> Claiming…`;
        claimBtn.className = "w-full sm:w-auto min-w-[260px] h-11 px-8 rounded-[6px] bg-[#195C4C] text-white/90 font-body text-sm font-semibold cursor-wait flex items-center justify-center gap-2";
      } 
      else if (stateName === 'success') {
        setBtnStyle('btn-state-success');
        defaultContent.classList.add('hidden');
        successContent.classList.remove('hidden');
        cardDot.className = "w-2.5 h-2.5 rounded-full bg-[#2F7D4A]";
      } 
      else if (stateName === 'conflict') {
        setBtnStyle('btn-state-conflict');
        conflictBanner.classList.remove('hidden');
        metricNum.textContent = "0";
        metricLabel.textContent = "spaces available now";
        metricDesc.textContent = "All basement bays currently claimed. You will be queued for cancellations.";
        claimBtn.disabled = true;
        claimBtn.className = "w-full sm:w-auto min-w-[260px] h-11 px-8 rounded-[6px] bg-[#EFEFF1] text-[#71717A] border border-[#E4E4E7] font-body text-sm font-semibold cursor-not-allowed flex items-center justify-center gap-2";
        btnText.textContent = "Claim a space (Unavailable)";
        cardDot.className = "w-2.5 h-2.5 rounded-full bg-[#B42318]";
      } 
      else if (stateName === 'zero') {
        setBtnStyle('btn-state-zero');
        metricNum.textContent = "0";
        metricLabel.textContent = "spaces available now";
        metricDesc.textContent = "0 spaces available — we’ll notify you if a space is released.";
        claimBtn.disabled = true;
        claimBtn.className = "w-full sm:w-auto min-w-[260px] h-11 px-8 rounded-[6px] bg-[#EFEFF1] text-[#71717A] border border-[#E4E4E7] font-body text-sm font-semibold cursor-not-allowed flex items-center justify-center gap-2";
        btnText.textContent = "Claim a space (Unavailable)";
        cardDot.className = "w-2.5 h-2.5 rounded-full bg-[#71717A]";
      }
    }

    function simulateClaim() {
      // Simulate click interaction
      switchState('claiming');
      setTimeout(() => {
        switchState('success');
      }, 1100);
    }

    function triggerRefresh() {
      const timeElem = document.getElementById('timestamp-text');
      const now = new Date();
      const hrs = String(now.getHours()).padStart(2, '0');
      const mins = String(now.getMinutes()).padStart(2, '0');
      timeElem.textContent = `Updated ${hrs}:${mins} PKT`;
    }
  </script>
