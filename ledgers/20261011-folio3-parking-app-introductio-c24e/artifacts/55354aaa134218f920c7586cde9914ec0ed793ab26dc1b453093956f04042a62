<!-- Interactive JavaScript logic -->
<script>
    let currentFilter = 'all';
    let currentFloor = 'all';
    let searchKeyword = '';

    function setFilter(filterType) {
      currentFilter = filterType;
      // Update UI pills
      document.querySelectorAll('.filter-pill').forEach(btn => {
        btn.classList.remove('active', 'bg-surface-container-lowest', 'text-on-surface', 'shadow-xs');
        btn.classList.add('text-outline');
      });
      
      const activeBtn = document.getElementById(`filter-${filterType === 'nondedicated' ? 'non-dedicated' : filterType}`);
      if (activeBtn) {
        activeBtn.classList.add('active', 'bg-surface-container-lowest', 'text-on-surface', 'shadow-xs');
        activeBtn.classList.remove('text-outline');
      }

      applyFilters();
    }

    function handleSearch(val) {
      searchKeyword = val.toLowerCase().trim();
      const clearBtn = document.getElementById('clearSearchBtn');
      if (searchKeyword.length > 0) {
        clearBtn.classList.remove('hidden');
      } else {
        clearBtn.classList.add('hidden');
      }
      applyFilters();
    }

    function clearSearch() {
      const searchInput = document.getElementById('searchInput');
      searchInput.value = '';
      handleSearch('');
      searchInput.focus();
    }

    function handleFloorFilter(floorVal) {
      currentFloor = floorVal;
      applyFilters();
    }

    function resetAllFilters() {
      document.getElementById('searchInput').value = '';
      document.getElementById('floorSelect').value = 'all';
      searchKeyword = '';
      currentFloor = 'all';
      document.getElementById('clearSearchBtn').classList.add('hidden');
      setFilter('all');
    }

    function applyFilters() {
      const rows = document.querySelectorAll('.roster-row');
      let visibleCount = 0;

      rows.forEach(row => {
        const name = row.getAttribute('data-name').toLowerCase();
        const email = row.getAttribute('data-email').toLowerCase();
        const id = row.getAttribute('data-id').toLowerCase();
        const dedicated = row.getAttribute('data-dedicated');
        const floor = row.getAttribute('data-floor');
        const status = row.getAttribute('data-status');

        // Check text search
        const matchesSearch = !searchKeyword || 
          name.includes(searchKeyword) || 
          email.includes(searchKeyword) || 
          id.includes(searchKeyword);

        // Check Segmented filter
        let matchesPill = true;
        if (currentFilter === 'dedicated') {
          matchesPill = (dedicated === 'yes');
        } else if (currentFilter === 'nondedicated') {
          matchesPill = (dedicated === 'no');
        } else if (currentFilter === 'missing') {
          matchesPill = (status === 'missing');
        }

        // Check floor dropdown
        let matchesFloor = true;
        if (currentFloor !== 'all') {
          matchesFloor = (floor === currentFloor);
        }

        if (matchesSearch && matchesPill && matchesFloor) {
          row.style.display = '';
          visibleCount++;
        } else {
          row.style.display = 'none';
        }
      });

      // Toggle Empty state
      const emptyState = document.getElementById('emptyState');
      const rosterTable = document.getElementById('rosterTable');
      if (visibleCount === 0) {
        emptyState.classList.remove('hidden');
        emptyState.classList.add('flex');
        rosterTable.classList.add('hidden');
      } else {
        emptyState.classList.add('hidden');
        emptyState.classList.remove('flex');
        rosterTable.classList.remove('hidden');
      }
    }

    // Interactive Detail Drawer Handlers
    function openDetailDrawer(rowElement) {
      const name = rowElement.getAttribute('data-name');
      const id = rowElement.getAttribute('data-id');
      const email = rowElement.getAttribute('data-email');
      const dedicated = rowElement.getAttribute('data-dedicated');
      const bay = rowElement.getAttribute('data-bay');
      const platesStr = rowElement.getAttribute('data-plates');
      const status = rowElement.getAttribute('data-status');

      // Populate Drawer elements
      document.getElementById('drawerName').innerText = name;
      document.getElementById('drawerId').innerText = `${id} · Verified Staff`;
      document.getElementById('drawerEmail').innerText = email;
      
      const initials = name.split(' ').map(n => n[0]).join('').substring(0, 2);
      document.getElementById('drawerAvatar').innerText = initials;

      const badge = document.getElementById('drawerDedicatedBadge');
      const bayChip = document.getElementById('drawerBayCode');
      if (dedicated === 'yes') {
        badge.className = "inline-flex items-center px-2 py-0.5 rounded text-[11px] font-medium bg-secondary-container text-primary";
        badge.innerHTML = "● Dedicated";
        bayChip.className = "space-chip";
        bayChip.innerText = bay;
      } else {
        badge.className = "inline-flex items-center px-2 py-0.5 rounded text-[11px] font-medium bg-surface-container text-outline";
        badge.innerHTML = "Floating Allocation";
        bayChip.className = "font-mono text-outline text-xs";
        bayChip.innerText = "Daily Floating Pool";
      }

      const warningBanner = document.getElementById('drawerWarningBanner');
      const platesContainer = document.getElementById('drawerPlatesContainer');
      platesContainer.innerHTML = '';

      if (status === 'missing') {
        warningBanner.classList.remove('hidden');
        platesContainer.innerHTML = `
          <div class="p-3 bg-surface-container rounded border border-dashed border-error/40 text-center">
            <p class="text-error font-medium">No vehicle license plate on file</p>
            <p class="text-[11px] text-outline mt-0.5">Please add a verified vehicle plate number.</p>
          </div>
        `;
      } else {
        warningBanner.classList.add('hidden');
        const plates = platesStr.split(',');
        plates.forEach((p, idx) => {
          const isPrimary = (idx === 0);
          platesContainer.innerHTML += `
            <div class="flex items-center justify-between p-2.5 rounded bg-surface-container-lowest border border-outline-variant">
              <div class="flex items-center gap-2">
                <span class="plate-chip">${p.trim()}</span>
                <span class="text-[10px] text-outline font-medium uppercase tracking-wider">${isPrimary ? 'Primary' : 'Secondary'}</span>
              </div>
              <span class="text-[11px] text-primary flex items-center gap-1 font-medium">
                <span class="material-symbols-outlined text-[14px]">verified</span> Active
              </span>
            </div>
          `;
        });
      }

      // Show drawer
      const backdrop = document.getElementById('drawerBackdrop');
      const drawer = document.getElementById('detailDrawer');
      backdrop.classList.remove('opacity-0', 'pointer-events-none');
      backdrop.classList.add('opacity-100');
      drawer.classList.remove('translate-x-full');
    }

    function closeDetailDrawer() {
      const backdrop = document.getElementById('drawerBackdrop');
      const drawer = document.getElementById('detailDrawer');
      backdrop.classList.add('opacity-0', 'pointer-events-none');
      backdrop.classList.remove('opacity-100');
      drawer.classList.add('translate-x-full');
    }

    // Keyboard support (Esc to close drawer)
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        closeDetailDrawer();
      }
    });
  </script>
