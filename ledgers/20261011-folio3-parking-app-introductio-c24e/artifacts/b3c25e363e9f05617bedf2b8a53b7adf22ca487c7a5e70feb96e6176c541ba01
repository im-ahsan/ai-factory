<script>
    // State controller for preview simulator
    const states = ['default', 'claiming', 'success', 'error', 'empty'];

    function setDashboardState(state) {
      // Hide all states
      states.forEach(s => {
        const el = document.getElementById(`state-${s}-view`);
        if (el) el.classList.add('hidden');
        
        const btn = document.getElementById(`sim-${s}`);
        if (btn) {
          btn.classList.remove('bg-primary-container', 'text-white', 'shadow-xs');
          btn.classList.add('text-on-surface-variant');
        }
      });

      // Show targeted state
      const targetView = document.getElementById(`state-${state}-view`);
      if (targetView) {
        targetView.classList.remove('hidden');
      }

      // Highlight simulator button
      const targetBtn = document.getElementById(`sim-${state}`);
      if (targetBtn) {
        targetBtn.classList.remove('text-on-surface-variant');
        targetBtn.classList.add('bg-primary-container', 'text-white', 'shadow-xs');
      }
    }

    // Simulated action for "Claim a space for today"
    function handleClaimClick() {
      setDashboardState('claiming');
      // Simulate real-world barrier server validation delay
      setTimeout(() => {
        setDashboardState('success');
      }, 1600);
    }

    // Interactive Notification toggle
    function toggleNotification(checkbox) {
      const label = document.getElementById('toggle-label');
      if (checkbox.checked) {
        label.textContent = 'Enabled';
        label.classList.remove('text-outline');
        label.classList.add('text-on-surface-variant');
      } else {
        label.textContent = 'Disabled';
        label.classList.remove('text-on-surface-variant');
        label.classList.add('text-outline');
      }
    }
  </script>
