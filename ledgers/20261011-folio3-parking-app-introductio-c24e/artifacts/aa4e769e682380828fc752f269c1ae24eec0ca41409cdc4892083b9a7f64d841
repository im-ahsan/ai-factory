<!DOCTYPE html>
<html lang="en" class="h-full bg-surface">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Security Guard Console - Folio3 Parking Gate</title>
  <!-- Google Fonts: Hanken Grotesk, Public Sans, IBM Plex Mono -->
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
  <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@500;600;700&family=IBM+Plex+Mono:wght@500;600;700&family=Public+Sans:wght@400;500;600;700&display=swap" rel="stylesheet"/>
  <!-- Material Symbols Outlined -->
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
  <script id="tailwind-config">
    tailwind.config = {
      darkMode: "class",
      theme: {
        extend: {
          colors: {
            "surface-container-lowest": "#ffffff",
            "surface-container-low": "#f1f4f1",
            "on-error-container": "#93000a",
            "error-container": "#ffdad6",
            "surface": "#f7faf7",
            "on-surface-variant": "#3f4945",
            "outline": "#6f7975",
            "primary": "#005645",
            "primary-container": "#1f6f5c",
            "on-primary": "#ffffff",
            "on-surface": "#18181B", /* User requirement: off-black #18181B */
            "outline-variant": "#bec9c4",
            "secondary-container": "#c8e6db",
            "surface-container": "#ecefeb",
            "surface-container-high": "#e6e9e6",
            "error": "#ba1a1a",
            "error-light": "#FDF2F2"
          },
          fontFamily: {
            headline: ["Hanken Grotesk", "sans-serif"],
            body: ["Public Sans", "sans-serif"],
            mono: ["IBM Plex Mono", "monospace"]
          }
        }
      }
    }
  </script>
  <style>
    .material-symbols-outlined {
      font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 20;
      vertical-align: middle;
    }
    .plate-chip {
      font-family: 'IBM Plex Mono', monospace;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      font-weight: 700;
      border: 1.5px solid #18181B;
      border-radius: 4px;
      padding: 4px 10px;
      background: #ffffff;
      color: #18181B;
      display: inline-flex;
      align-items: center;
      line-height: 1;
    }
    .plate-chip-sm {
      font-family: 'IBM Plex Mono', monospace;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      font-weight: 600;
      border: 1.25px solid #18181B;
      border-radius: 4px;
      padding: 2.5px 7px;
      background: #ffffff;
      color: #18181B;
      display: inline-flex;
      align-items: center;
      line-height: 1;
    }
    .plate-unreadable {
      font-family: 'IBM Plex Mono', monospace;
      letter-spacing: 0.05em;
      font-weight: 600;
      border: 1.25px dashed #93000a;
      border-radius: 4px;
      padding: 2.5px 7px;
      background: #fff5f5;
      color: #93000a;
      display: inline-flex;
      align-items: center;
      line-height: 1;
    }
  </style>
</head>
<body class="min-h-full font-body text-[#18181B] bg-surface flex flex-col antialiased">

  <!-- ================= TOP NAVIGATION / CONSOLE BAR ================= -->
  <header class="bg-surface-container-lowest border-b border-outline-variant w-full sticky top-0 z-40">
    <div class="flex justify-between items-center w-full px-6 h-16 max-w-7xl mx-auto">
      <!-- Left: Brand / Console Role -->
      <div class="flex items-center gap-6">
        <div class="flex items-center gap-3">
          <div class="w-8 h-8 rounded bg-primary-container text-on-primary flex items-center justify-center font-headline font-bold text-base tracking-tight">
            F3
          </div>
          <div class="flex flex-col">
            <span class="font-headline font-bold text-base text-[#18181B] tracking-tight leading-tight">Folio3 Parking</span>
            <span class="text-[11px] font-mono text-outline uppercase tracking-wider">Gate 1 Entry Terminal</span>
          </div>
        </div>

        <nav class="hidden md:flex items-center h-16 gap-1 border-l border-outline-variant pl-6">
          <a class="text-primary border-b-2 border-primary font-medium h-full flex items-center px-3.5 text-sm" href="#">
            Guard Console
          </a>
          <a class="text-on-surface-variant hover:text-[#18181B] font-medium h-full flex items-center px-3.5 text-sm transition-colors" href="#">
            Daily Allocations
          </a>
          <a class="text-on-surface-variant hover:text-[#18181B] font-medium h-full flex items-center px-3.5 text-sm transition-colors" href="#">
            Barrier Manual Override
          </a>
          <a class="text-on-surface-variant hover:text-[#18181B] font-medium h-full flex items-center px-3.5 text-sm transition-colors" href="#">
            Help Desk
          </a>
        </nav>
      </div>

      <!-- Right: Guard Details & State Demos -->
      <div class="flex items-center gap-4">
        <!-- Interactive State Simulation switcher for reviewer testing -->
        <div class="hidden sm:flex items-center gap-1.5 bg-surface-container-low p-1 rounded-lg border border-outline-variant text-xs font-mono">
          <span class="text-outline px-1.5 text-[10px] uppercase font-semibold">Demo:</span>
          <button onclick="setSimState('normal')" id="btn-normal" class="px-2 py-0.5 rounded bg-surface-container-lowest text-[#18181B] border border-outline-variant font-medium shadow-xs">
            Normal
          </button>
          <button onclick="setSimState('error')" id="btn-error" class="px-2 py-0.5 rounded text-on-surface-variant hover:text-[#18181B] hover:bg-surface-variant transition-colors">
            Outage
          </button>
          <button onclick="setSimState('empty')" id="btn-empty" class="px-2 py-0.5 rounded text-on-surface-variant hover:text-[#18181B] hover:bg-surface-variant transition-colors">
            Empty
          </button>
        </div>

        <div class="h-6 w-[1px] bg-outline-variant"></div>

        <!-- Guard on Duty Badge -->
        <div class="flex items-center gap-2.5">
          <div class="w-8 h-8 rounded-full bg-surface-container-high border border-outline-variant text-[#18181B] font-mono font-semibold text-xs flex items-center justify-center">
            TM
          </div>
          <div class="hidden lg:flex flex-col text-left">
            <span class="text-xs font-semibold text-[#18181B] leading-snug">Tariq Mehmood</span>
            <span class="text-[11px] font-mono text-outline leading-tight">Guard Station #01 (Shift A)</span>
          </div>
        </div>
      </div>
    </div>
  </header>

  <!-- ================= MAIN CONSOLE CONTENT ================= -->
  <main class="flex-1 w-full max-w-7xl mx-auto px-6 py-6 flex flex-col gap-6">

    <!-- ERROR STATE BANNER (Toggled or visible on outage) -->
    <div id="error-banner" class="hidden rounded-lg bg-[#FFF2F0] border-l-4 border-error p-4 text-[#18181B] shadow-xs">
      <div class="flex items-start justify-between gap-3">
        <div class="flex items-start gap-3">
          <span class="material-symbols-outlined text-error text-[24px] mt-0.5 shrink-0" data-icon="error">error</span>
          <div>
            <div class="flex items-center gap-2">
              <h2 class="text-sm font-bold text-error tracking-tight">CRITICAL HARDWARE ALERT</h2>
              <span class="px-1.5 py-0.2 rounded text-[10px] font-mono font-semibold uppercase bg-error/10 text-error">Gate 1 Sensor Offline</span>
            </div>
            <p class="text-xs text-[#18181B] mt-1 font-medium">
              Camera offline since 08:25 — no automated authorization, green indicator disabled. Outage event recorded.
            </p>
            <p class="text-[11px] text-on-surface-variant mt-1">
              Manual plate inspection required for all approaching vehicles. Direct barrier switch override active.
            </p>
          </div>
        </div>
        <button onclick="setSimState('normal')" class="text-xs font-mono text-outline hover:text-[#18181B] px-2 py-1 rounded border border-outline-variant bg-white">
          Dismiss Demo
        </button>
      </div>
    </div>

    <!-- ================= 1. SYSTEM HEALTH BAR ================= -->
    <section class="bg-surface-container-lowest border border-outline-variant rounded-lg px-5 py-3.5 flex flex-col md:flex-row md:items-center justify-between gap-4 shadow-xs">
      <!-- Health Indicators -->
      <div class="flex flex-wrap items-center gap-x-6 gap-y-2 text-xs">
        <span class="font-mono uppercase text-[11px] font-bold text-outline tracking-wider flex items-center gap-1.5">
          <span class="material-symbols-outlined text-[16px] text-primary" data-icon="hub">hub</span>
          System Health
        </span>

        <!-- Camera Status -->
        <div class="flex items-center gap-2">
          <span id="health-camera-dot" class="w-2 h-2 rounded-full bg-primary inline-block"></span>
          <span class="text-on-surface-variant font-medium">Camera:</span>
          <span id="health-camera-text" class="font-semibold text-primary">Online</span>
        </div>

        <span class="text-outline-variant hidden sm:inline">•</span>

        <!-- Authorization Service -->
        <div class="flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-primary inline-block"></span>
          <span class="text-on-surface-variant font-medium">Authorization service:</span>
          <span class="font-semibold text-primary">Online</span>
        </div>

        <span class="text-outline-variant hidden sm:inline">•</span>

        <!-- Gate Indicator -->
        <div class="flex items-center gap-2">
          <span id="health-gate-dot" class="w-2 h-2 rounded-full bg-primary inline-block"></span>
          <span class="text-on-surface-variant font-medium">Gate indicator:</span>
          <span id="health-gate-text" class="font-semibold text-primary">Online</span>
        </div>
      </div>

      <!-- Date & Office Time -->
      <div class="flex items-center gap-2 text-xs font-mono text-[#18181B] bg-surface-container-low px-3 py-1.5 rounded border border-outline-variant/70 self-start md:self-auto">
        <span class="material-symbols-outlined text-[16px] text-outline" data-icon="schedule">schedule</span>
        <span class="font-semibold">Tue 10 Jun 2025, office time 08:21 PKT</span>
      </div>
    </section>

    <!-- ================= 2. LATEST DETECTION CARD ================= -->
    <section id="latest-detection-section" class="bg-surface-container-lowest border border-outline-variant rounded-lg p-6 shadow-xs">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-4 border-b border-outline-variant gap-3">
        <div class="flex items-center gap-2.5">
          <span class="material-symbols-outlined text-primary text-[22px]" data-icon="videocam">videocam</span>
          <div>
            <h2 class="font-headline font-bold text-base text-[#18181B] tracking-tight">Latest Optical Plate Detection</h2>
            <p class="text-xs text-outline font-mono">Live feed from ANPR Optical Scanner — Barrier Entry Arm 01</p>
          </div>
        </div>
        <div class="flex items-center gap-2">
          <span class="text-xs font-mono text-outline">Trigger: 08:21:05 PKT</span>
          <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded text-xs font-mono font-semibold bg-[#E6F0ED] text-primary border border-primary/20">
            <span class="w-2 h-2 rounded-full bg-primary animate-pulse"></span>
            LIVE RADAR
          </span>
        </div>
      </div>

      <!-- Detection Main Body -->
      <div class="mt-6 grid grid-cols-1 lg:grid-cols-12 gap-6 items-center">
        <!-- License Plate Hero Display (4 cols) -->
        <div class="lg:col-span-4 bg-surface-container-low border border-outline-variant rounded-lg p-5 flex flex-col items-center justify-center text-center">
          <span class="text-[11px] font-mono uppercase font-semibold text-outline tracking-wider mb-2">Detected License Plate</span>
          <div class="plate-chip text-2xl py-2 px-5 tracking-widest shadow-xs">
            BKX-482
          </div>
          <span class="text-xs text-on-surface-variant font-medium mt-3 flex items-center gap-1.5">
            <span class="material-symbols-outlined text-[16px] text-primary" data-icon="verified">verified</span>
            Optical OCR Match: 99.4%
          </span>
        </div>

        <!-- Verification Result & Indicator (5 cols) -->
        <div class="lg:col-span-5 flex flex-col justify-center space-y-4">
          <div>
            <span class="text-[11px] font-mono uppercase font-bold text-outline tracking-wider block mb-1">Authorization Status</span>
            <div class="flex items-center gap-2">
              <span class="material-symbols-outlined text-primary text-[20px]" data-icon="check_circle">check_circle</span>
              <p class="text-sm md:text-base font-bold text-[#18181B] leading-tight">
                Authorized — temporary claim for 10 Jun 2025
              </p>
            </div>
            <p class="text-xs text-on-surface-variant mt-1.5 pl-7">
              Claimant: <strong>Bilal Ahmed</strong> (F3-1187) · Slot assigned: Bay B2-14 · Shift: 08:00–18:00 PKT
            </p>
          </div>

          <!-- Green Indicator -->
          <div class="pt-2">
            <span class="text-[11px] font-mono uppercase font-bold text-outline tracking-wider block mb-1.5">Gate Optical Signal</span>
            <div id="gate-indicator-badge" class="inline-flex items-center gap-2.5 px-3.5 py-1.5 rounded-md bg-[#E6F0ED] text-primary border border-primary/30">
              <span class="w-3 h-3 rounded-full bg-primary shadow-[0_0_8px_rgba(0,86,69,0.7)] animate-pulse"></span>
              <span class="text-xs font-mono font-bold tracking-wide uppercase">Gate Indicator: Activated</span>
            </div>
          </div>
        </div>

        <!-- Guard Physical Verification Buttons (3 cols) -->
        <div class="lg:col-span-3 flex flex-col gap-3 pt-2 lg:pt-0 lg:border-l lg:border-outline-variant lg:pl-6">
          <span class="text-[11px] font-mono uppercase font-bold text-outline tracking-wider block">Physical Gate Action</span>
          
          <!-- Button 1: Vehicle entered -->
          <button id="btn-vehicle-entered" onclick="recordAction('Entered')" type="button" class="w-full h-11 px-4 bg-primary hover:bg-[#195C4C] text-white font-medium text-xs rounded transition-all flex items-center justify-center gap-2 shadow-xs active:scale-[0.98]">
            <span class="material-symbols-outlined text-[18px]" data-icon="check">check</span>
            <span>Vehicle entered</span>
          </button>

          <!-- Button 2: Did not enter -->
          <button id="btn-not-entered" onclick="recordAction('Did not enter')" type="button" class="w-full h-11 px-4 bg-surface-container-lowest hover:bg-surface-variant text-[#18181B] font-medium text-xs border border-outline-variant rounded transition-all flex items-center justify-center gap-2 active:scale-[0.98]">
            <span class="material-symbols-outlined text-[18px] text-error" data-icon="close">close</span>
            <span>Did not enter</span>
          </button>
        </div>
      </div>
    </section>

    <!-- EMPTY STATE CARD (Toggled via demo or when queue has zero items) -->
    <div id="empty-state-card" class="hidden bg-surface-container-lowest border border-outline-variant rounded-lg p-10 text-center shadow-xs">
      <div class="w-12 h-12 rounded-full bg-surface-container-high border border-outline-variant text-outline flex items-center justify-center mx-auto mb-3">
        <span class="material-symbols-outlined text-[24px]" data-icon="directions_car">directions_car</span>
      </div>
      <h3 class="font-headline font-bold text-base text-[#18181B]">No car detections yet today.</h3>
      <p class="text-xs text-on-surface-variant mt-1 max-w-sm mx-auto">
        Optical cameras at Gate 1 and Gate 2 are primed. Detections will automatically populate here upon arrival.
      </p>
    </div>

    <!-- ================= 3. ATTEMPT LOG TABLE ================= -->
    <section class="bg-surface-container-lowest border border-outline-variant rounded-lg shadow-xs overflow-hidden">
      <div class="p-5 pb-4 border-b border-outline-variant flex flex-col sm:flex-row sm:items-center justify-between gap-3">
        <div class="flex items-center gap-2.5">
          <span class="material-symbols-outlined text-primary text-[20px]" data-icon="history">history</span>
          <div>
            <h2 class="font-headline font-bold text-base text-[#18181B] tracking-tight">Attempt Log</h2>
            <p class="text-xs text-outline">Complete audit trail of ANPR scanner events and physical entry verifications.</p>
          </div>
        </div>

        <div class="flex items-center gap-3">
          <span class="text-xs font-mono text-outline">Live buffer: 4 attempts recorded</span>
          <button onclick="alert('Log exported to audit trail CSV.')" class="px-2.5 py-1 text-xs font-medium text-on-surface-variant hover:text-[#18181B] border border-outline-variant rounded hover:bg-surface-variant transition-colors flex items-center gap-1.5">
            <span class="material-symbols-outlined text-[14px]" data-icon="download">download</span>
            Export Log
          </button>
        </div>
      </div>

      <!-- Table View -->
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="bg-surface-container-low border-b border-outline-variant text-[11px] font-semibold font-mono uppercase tracking-wider text-outline">
              <th class="py-3 px-5">Time</th>
              <th class="py-3 px-5">Detected plate</th>
              <th class="py-3 px-5">Type</th>
              <th class="py-3 px-5">Result</th>
              <th class="py-3 px-5 text-right">Actual entry</th>
            </tr>
          </thead>
          <tbody id="attempt-table-body" class="divide-y divide-outline-variant text-xs font-body text-[#18181B]">
            <!-- Row 1: 08:21:05 · BKX-482 · Temporary · Authorized · Entered -->
            <tr class="hover:bg-surface-container-low/60 transition-colors">
              <td class="py-3.5 px-5 font-mono text-on-surface-variant">
                08:21:05
              </td>
              <td class="py-3.5 px-5">
                <span class="plate-chip-sm">BKX-482</span>
              </td>
              <td class="py-3.5 px-5">
                <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-mono font-medium bg-surface-container text-[#18181B] border border-outline-variant">
                  Temporary
                </span>
              </td>
              <td class="py-3.5 px-5">
                <span class="inline-flex items-center gap-1.5 text-xs font-medium text-primary">
                  <span class="w-1.5 h-1.5 rounded-full bg-primary"></span>
                  Authorized
                </span>
              </td>
              <td class="py-3.5 px-5 text-right">
                <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded text-[11px] font-mono font-semibold bg-[#E6F0ED] text-primary border border-primary/20">
                  <span class="material-symbols-outlined text-[13px]" data-icon="check">check</span>
                  Entered
                </span>
              </td>
            </tr>

            <!-- Row 2: 08:18:40 · LEB-22-1904 · Permanent sticker · Bypassed — recorded as utilized · — -->
            <tr class="hover:bg-surface-container-low/60 transition-colors">
              <td class="py-3.5 px-5 font-mono text-on-surface-variant">
                08:18:40
              </td>
              <td class="py-3.5 px-5">
                <span class="plate-chip-sm">LEB-22-1904</span>
              </td>
              <td class="py-3.5 px-5">
                <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-mono font-medium bg-secondary-container/50 text-[#18181B] border border-outline-variant">
                  Permanent sticker
                </span>
              </td>
              <td class="py-3.5 px-5">
                <span class="text-on-surface-variant font-medium">
                  Bypassed — recorded as utilized
                </span>
              </td>
              <td class="py-3.5 px-5 text-right font-mono text-outline">
                —
              </td>
            </tr>

            <!-- Row 3: 08:15:12 · Unreadable · Temporary · No automated authorization · Did not enter -->
            <tr class="hover:bg-surface-container-low/60 transition-colors">
              <td class="py-3.5 px-5 font-mono text-on-surface-variant">
                08:15:12
              </td>
              <td class="py-3.5 px-5">
                <span class="plate-unreadable">Unreadable</span>
              </td>
              <td class="py-3.5 px-5">
                <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-mono font-medium bg-surface-container text-[#18181B] border border-outline-variant">
                  Temporary
                </span>
              </td>
              <td class="py-3.5 px-5">
                <span class="inline-flex items-center gap-1.5 text-xs font-medium text-error">
                  <span class="w-1.5 h-1.5 rounded-full bg-error"></span>
                  No automated authorization
                </span>
              </td>
              <td class="py-3.5 px-5 text-right">
                <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded text-[11px] font-mono font-semibold bg-[#FBEAE8] text-error border border-error/20">
                  <span class="material-symbols-outlined text-[13px]" data-icon="close">close</span>
                  Did not enter
                </span>
              </td>
            </tr>

            <!-- Row 4: 08:12:30 · KHI-5531 · Temporary · Not verified — no claim today · Pending -->
            <tr class="hover:bg-surface-container-low/60 transition-colors">
              <td class="py-3.5 px-5 font-mono text-on-surface-variant">
                08:12:30
              </td>
              <td class="py-3.5 px-5">
                <span class="plate-chip-sm">KHI-5531</span>
              </td>
              <td class="py-3.5 px-5">
                <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-mono font-medium bg-surface-container text-[#18181B] border border-outline-variant">
                  Temporary
                </span>
              </td>
              <td class="py-3.5 px-5">
                <span class="inline-flex items-center gap-1.5 text-xs font-medium text-on-surface-variant">
                  <span class="w-1.5 h-1.5 rounded-full bg-outline"></span>
                  Not verified — no claim today
                </span>
              </td>
              <td class="py-3.5 px-5 text-right">
                <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded text-[11px] font-mono font-medium bg-surface-container text-on-surface-variant border border-outline-variant">
                  Pending
                </span>
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- ================= 4. OPERATIONAL NOTE ================= -->
    <section class="bg-surface-container-low border border-outline-variant rounded-lg p-4 flex items-center gap-3 text-xs text-[#18181B]">
      <span class="material-symbols-outlined text-outline text-[20px] shrink-0" data-icon="info">info</span>
      <p class="font-medium">
        <strong>Note:</strong> Motorcycles and pedestrians are ignored.
      </p>
    </section>

  </main>

  <!-- ================= MINIMAL GUARD FOOTER ================= -->
  <footer class="mt-auto border-t border-outline-variant bg-surface-container-lowest py-4">
    <div class="max-w-7xl mx-auto px-6 flex flex-col sm:flex-row items-center justify-between gap-2 text-xs text-outline font-mono">
      <div class="flex items-center gap-3">
        <span>Folio3 Parking Gate Console</span>
        <span>•</span>
        <span>Karachi Campus Phase 1 — Gate 01</span>
        <span>•</span>
        <span>Hardware Firmware v3.14-LPR</span>
      </div>
      <div>
        <span>Guard Session: Tariq Mehmood (Station #01)</span>
      </div>
    </div>
  </footer>

  <!-- ================= INTERACTIVE DEMO SCRIPT ================= -->
  <script>
    function setSimState(state) {
      const errorBanner = document.getElementById('error-banner');
      const latestSection = document.getElementById('latest-detection-section');
      const emptyCard = document.getElementById('empty-state-card');
      const gateIndicatorBadge = document.getElementById('gate-indicator-badge');
      const healthCameraDot = document.getElementById('health-camera-dot');
      const healthCameraText = document.getElementById('health-camera-text');
      const healthGateDot = document.getElementById('health-gate-dot');
      const healthGateText = document.getElementById('health-gate-text');

      const btnNormal = document.getElementById('btn-normal');
      const btnError = document.getElementById('btn-error');
      const btnEmpty = document.getElementById('btn-empty');

      // Reset button styles
      [btnNormal, btnError, btnEmpty].forEach(b => {
        b.className = "px-2 py-0.5 rounded text-on-surface-variant hover:text-[#18181B] hover:bg-surface-variant transition-colors";
      });

      if (state === 'normal') {
        btnNormal.className = "px-2 py-0.5 rounded bg-surface-container-lowest text-[#18181B] border border-outline-variant font-medium shadow-xs";
        errorBanner.classList.add('hidden');
        latestSection.classList.remove('hidden');
        emptyCard.classList.add('hidden');

        healthCameraDot.className = "w-2 h-2 rounded-full bg-primary inline-block";
        healthCameraText.className = "font-semibold text-primary";
        healthCameraText.textContent = "Online";

        healthGateDot.className = "w-2 h-2 rounded-full bg-primary inline-block";
        healthGateText.className = "font-semibold text-primary";
        healthGateText.textContent = "Online";

        gateIndicatorBadge.innerHTML = `
          <span class="w-3 h-3 rounded-full bg-primary shadow-[0_0_8px_rgba(0,86,69,0.7)] animate-pulse"></span>
          <span class="text-xs font-mono font-bold tracking-wide uppercase">Gate Indicator: Activated</span>
        `;
        gateIndicatorBadge.className = "inline-flex items-center gap-2.5 px-3.5 py-1.5 rounded-md bg-[#E6F0ED] text-primary border border-primary/30";
      } else if (state === 'error') {
        btnError.className = "px-2 py-0.5 rounded bg-surface-container-lowest text-[#18181B] border border-outline-variant font-medium shadow-xs";
        errorBanner.classList.remove('hidden');
        latestSection.classList.remove('hidden');
        emptyCard.classList.add('hidden');

        healthCameraDot.className = "w-2 h-2 rounded-full bg-error inline-block animate-pulse";
        healthCameraText.className = "font-semibold text-error";
        healthCameraText.textContent = "Offline (since 08:25)";

        healthGateDot.className = "w-2 h-2 rounded-full bg-outline inline-block";
        healthGateText.className = "font-semibold text-outline";
        healthGateText.textContent = "Disabled";

        gateIndicatorBadge.innerHTML = `
          <span class="w-3 h-3 rounded-full bg-outline inline-block"></span>
          <span class="text-xs font-mono font-bold tracking-wide uppercase">Gate Indicator: Disabled</span>
        `;
        gateIndicatorBadge.className = "inline-flex items-center gap-2.5 px-3.5 py-1.5 rounded-md bg-surface-container text-outline border border-outline-variant";
      } else if (state === 'empty') {
        btnEmpty.className = "px-2 py-0.5 rounded bg-surface-container-lowest text-[#18181B] border border-outline-variant font-medium shadow-xs";
        errorBanner.classList.add('hidden');
        latestSection.classList.add('hidden');
        emptyCard.classList.remove('hidden');
      }
    }

    function recordAction(action) {
      alert(`Guard recorded physical entry: "${action}" for plate BKX-482.`);
    }
  </script>
</body>
</html>
