<span class="material-symbols-outlined text-white" data-icon="local_parking">local_parking</span>
</div>
<div>
<div class="font-headline font-bold text-base tracking-tight text-on-surface leading-none">Folio3 Parking</div>
<div class="font-label text-xs uppercase tracking-wider text-outline mt-0.5">Bay Management</div>
</div>
</div>
<div class="flex items-center gap-4">
<div class="hidden sm:flex items-center gap-2 px-2.5 py-1 rounded bg-surface-container-high text-xs font-mono text-on-surface-variant border border-outline-variant/40">
