<span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-surface-container-low text-on-surface-variant border border-outline-variant/50">
              Parking Administrators
            </span>
</div>
</div>
<!-- 2) Inline Error Alert (Current State: Explicit Unauthorized Personal Domain Error) -->
<section aria-live="assertive" class="mb-6 rounded-lg bg-[#FBEAE8] border border-[#F5C2BC] p-4 relative transition-all">
<div class="flex items-start gap-3">
<span class="material-symbols-outlined text-[#B42318] text-xl shrink-0 mt-0.5" data-icon="error">error</span>
<div class="flex-1">
<div class="font-headline font-semibold text-xs text-[#B42318] tracking-wide uppercase mb-1">
                Authentication Rejected
              </div>
<p class="font-body text-xs sm:text-[13px] text-[#B42318] leading-relaxed font-medium">
                ahmed.raza@gmail.com is not a Folio3 Workspace account. Personal Gmail and other providers are not accepted.
              </p>
<!-- Action Button inside alert -->
<div class="mt-3.5 pt-2.5 border-t border-[#F5C2BC]/60 flex items-center justify-between">
<button class="inline-flex items-center gap-1.5 text-xs font-body font-semibold text-[#B42318] hover:text-[#93000A] transition-colors focus:outline-none focus:ring-2 focus:ring-[#B42318] focus:ring-offset-1 rounded px-1.5 py-1 -ml-1" id="tryAnotherBtn" onclick="resetAccountView()" type="button">
<span class="material-symbols-outlined text-base" data-icon="restart_alt">restart_alt</span>
<span>Try another account</span>
</button>
<span class="font-mono text-[10px] text-[#B42318]/70">ERR_NON_ORG_DOMAIN</span>
</div>
</div>
</div>
</section>
<!-- 3) Primary Sign-in Actions & Interactive States -->
<div class="space-y-4">
<!-- Main Google SSO Button -->
<div id="defaultActionContainer">
<button class="w-full h-11 px-4 rounded-lg bg-surface-container-lowest hover:bg-surface-container-low active:scale-[0.98] border border-outline-variant text-on-surface font-body font-medium text-sm flex items-center justify-center gap-3 transition-all duration-160 focus:outline-none focus:ring-2 focus:ring-primary-container focus:ring-offset-2 shadow-sm" id="googleSignInBtn" onclick="triggerLoadingPreview()" type="button">
<!-- Google G Logo SVG -->
<svg aria-hidden="true" class="w-4 h-4 shrink-0" viewbox="0 0 24 24">
<path d="M23.745 12.27c0-.7-.06-1.4-.19-2.07H12v4.51h6.6c-.29 1.52-1.14 2.82-2.4 3.68v3.05h3.88c2.27-2.09 3.665-5.17 3.665-9.17z" fill="#4285F4"></path>
