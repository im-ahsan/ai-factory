<p class="leading-relaxed">
          Daily parking releases occur promptly at <strong class="font-mono text-on-surface">10:00 PKT</strong>. If you are a visiting consultant without a corporate Google suite ID, obtain a visitor pass at the Security Guard Console.
        </p>
</div>
</div>
</main>
<!-- Ground Footer -->
<footer class="relative z-10 w-full py-4 px-6 md:px-12 border-t border-outline-variant/30 bg-surface-container-lowest/60 backdrop-blur-sm flex flex-col sm:flex-row items-center justify-between text-xs text-outline gap-2">
<div class="flex items-center gap-4">
<span>© Folio3 Software Inc.</span>
<span class="inline-block w-1 h-1 rounded-full bg-outline-variant"></span>
<span>Corporate Facilities &amp; Security</span>
</div>
<div class="flex items-center gap-6 font-mono text-[11px]">
<span>SERVER: PK-KHI-DC1</span>
<span class="text-emerald-700 flex items-center gap-1">
<span class="inline-block w-1.5 h-1.5 rounded-full bg-emerald-600 animate-pulse"></span>
        SYSTEMS NORMAL
      </span>
</div>
</footer>
<!-- Micro-interaction state logic -->
<script>
    let isLoading = false;

    function triggerLoadingPreview() {
      isLoading = true;
      document.getElementById('defaultActionContainer').classList.add('hidden');
      document.getElementById('loadingStatePreview').classList.remove('hidden');
      document.getElementById('stateToggleLabel').innerHTML = '<span class="material-symbols-outlined text-sm" data-icon="undo">undo</span><span>Reset to default</span>';
    }

    function cancelLoadingPreview() {
      isLoading = false;
      document.getElementById('defaultActionContainer').classList.remove('hidden');
      document.getElementById('loadingStatePreview').classList.add('hidden');
      document.getElementById('stateToggleLabel').innerHTML = '<span class="material-symbols-outlined text-sm" data-icon="sync">sync</span><span>Preview loading state</span>';
    }

    function toggleSimulatedLoading() {
      if (isLoading) {
        cancelLoadingPreview();
      } else {
        triggerLoadingPreview();
      }
    }

    function resetAccountView() {
      const alertBox = document.querySelector('section[aria-live="assertive"]');
      alertBox.classList.add('opacity-40');
      setTimeout(() => {
        alertBox.classList.remove('opacity-40');
        triggerLoadingPreview();
        setTimeout(() => {
          cancelLoadingPreview();
        }, 1800);
      }, 200);
    }
  </script>
