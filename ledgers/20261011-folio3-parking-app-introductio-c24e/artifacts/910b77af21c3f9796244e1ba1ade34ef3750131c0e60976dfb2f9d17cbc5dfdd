</div>
<!-- Loading State Preview Card (Interactive Demonstration Toggle) -->
<div class="hidden" id="loadingStatePreview">
<button class="w-full h-11 px-4 rounded-lg bg-surface-container-low border border-outline-variant text-on-surface-variant font-body font-medium text-sm flex items-center justify-center gap-3 cursor-wait" disabled="">
