<!-- Main Centered Authentication Stage -->
<main class="relative z-10 flex-grow flex items-center justify-center px-4 py-12 sm:px-6">
<div class="w-full max-w-[480px]">
<!-- Central Card Container -->
<div class="bg-surface-container-lowest border border-outline-variant rounded-lg p-6 sm:p-8 shadow-[0_8px_30px_rgb(24,28,27,0.06)] relative overflow-hidden">
<!-- Subtle Top Accent Rule -->
<div class="absolute top-0 left-0 right-0 h-1 bg-primary-container"></div>
<!-- 1) Card Header & Identity -->
<div class="mb-6">
<div class="flex items-center justify-between mb-4">
<div class="inline-flex items-center gap-2 px-2.5 py-1 rounded bg-secondary-container text-on-secondary-fixed text-xs font-medium">
<span class="material-symbols-outlined text-[15px]" data-icon="shield">shield</span>
              Workspace SSO
            </div>
<span class="font-mono text-xs text-outline font-medium tracking-wide">GATEWAY 2.4</span>
</div>
<h1 class="font-headline font-bold text-2xl sm:text-[26px] tracking-tight text-on-surface leading-tight">
            Folio3 Parking System
          </h1>
<p class="font-body text-sm text-on-surface-variant mt-2 leading-relaxed">
            Claim released parking spaces at the Folio3 office
          </p>
<!-- Role pills indicating authorized access categories -->
<div class="mt-4 pt-3 border-t border-outline-variant/40 flex flex-wrap items-center gap-1.5">
<span class="font-label text-[11px] uppercase tracking-wider text-outline mr-1">Access Roles:</span>
<span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-surface-container-low text-on-surface-variant border border-outline-variant/50">
              Employees
            </span>
<span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-surface-container-low text-on-surface-variant border border-outline-variant/50">
