<circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
<path class="opacity-75" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z" fill="currentColor"></path>
</svg>
<span>Verifying your Folio3 account…</span>
</button>
<div class="flex items-center justify-between text-xs text-outline mt-2 px-1">
<span>Contacting Identity Provider</span>
<button class="text-xs text-primary underline hover:text-on-surface" onclick="cancelLoadingPreview()">Cancel</button>
</div>
</div>
<!-- State preview switcher for reviewing UI transitions -->
<div class="pt-3 border-t border-outline-variant/30 flex items-center justify-between">
<span class="text-[11px] font-mono text-outline">State Inspector</span>
<button class="text-xs font-body text-primary hover:underline flex items-center gap-1" id="stateToggleLabel" onclick="toggleSimulatedLoading()" type="button">
<span class="material-symbols-outlined text-sm" data-icon="sync">sync</span>
<span>Preview loading state</span>
</button>
</div>
</div>
<!-- 4) Policy & Support Footer inside Card -->
<div class="mt-6 pt-5 border-t border-outline-variant/50 space-y-3">
<p class="font-body text-xs text-on-surface-variant leading-relaxed">
