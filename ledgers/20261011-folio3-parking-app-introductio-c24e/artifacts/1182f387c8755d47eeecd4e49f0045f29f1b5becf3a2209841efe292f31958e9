<!-- Interactive JavaScript logic for micro-interactions -->
<script>
    let isChecking = false;

    function handleRetry() {
      if (isChecking) return;
      isChecking = true;

      const btn = document.getElementById('tryAgainBtn');
      const btnIcon = document.getElementById('btnIcon');
      const btnText = document.getElementById('btnText');
      const banner = document.getElementById('retryBanner');
      const bannerMsg = document.getElementById('bannerMessage');
      const bannerTime = document.getElementById('retryTimestamp');

      // Set Loading State
      btn.disabled = true;
      btn.classList.add('opacity-80', 'cursor-not-allowed');
      btnIcon.classList.add('animate-spin');
      btnIcon.setAttribute('data-icon', 'progress_activity');
      btnIcon.textContent = 'progress_activity';
      btnText.textContent = 'Checking directory…';

      // Hide previous banner if visible
      banner.classList.add('hidden');

      // Simulate directory re-check
      setTimeout(() => {
        isChecking = false;
        btn.disabled = false;
        btn.classList.remove('opacity-80', 'cursor-not-allowed');
        btnIcon.classList.remove('animate-spin');
        btnIcon.setAttribute('data-icon', 'refresh');
        btnIcon.textContent = 'refresh';
        btnText.textContent = 'Try again';

        // Show updated timestamp & diagnostic message
        const now = new Date();
        const timeStr = now.toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit' }) + ' PKT';
        bannerTime.textContent = timeStr;
        bannerMsg.textContent = 'Directory lookup failed again. Profile mapping not yet synced in Active Directory.';
        banner.classList.remove('hidden');
      }, 1400);
    }

    function handleSignOut() {
      const btn = event.currentTarget;
      btn.classList.add('opacity-70');
      btn.querySelector('span:last-child').textContent = 'Signing out…';
      setTimeout(() => {
        alert('Signing out of session for sana.khalid@folio3.com');
      }, 300);
    }

    function copyRefCode() {
      const code = 'DIR-404 · 10 Jun 2025 08:12 PKT';
      navigator.clipboard.writeText(code).then(() => {
        const copyLabel = document.getElementById('copyLabel');
        const copyIcon = document.getElementById('copyIcon');
        copyLabel.textContent = 'Copied!';
        copyIcon.setAttribute('data-icon', 'check');
        copyIcon.textContent = 'check';

        setTimeout(() => {
          copyLabel.textContent = 'Copy ref';
          copyIcon.setAttribute('data-icon', 'content_copy');
          copyIcon.textContent = 'content_copy';
        }, 2000);
      }).catch(() => {
        const copyLabel = document.getElementById('copyLabel');
        copyLabel.textContent = 'Copied';
        setTimeout(() => { copyLabel.textContent = 'Copy ref'; }, 1500);
      });
    }
  </script>
