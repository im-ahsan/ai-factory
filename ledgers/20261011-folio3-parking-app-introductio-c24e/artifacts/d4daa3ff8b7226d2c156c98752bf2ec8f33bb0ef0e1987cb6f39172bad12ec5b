<div class="flex items-center gap-2">
<span class="w-5 h-5 rounded-full bg-[#1F6F5C] text-white flex items-center justify-center text-[13px] font-bold">✓</span>
<span class="font-medium" id="toast-message">Recipient removed</span>
</div>
<button class="text-[#71717A] hover:text-white p-0.5 ml-2 transition-colors" onclick="hideToast()" title="Dismiss">
<span class="material-symbols-outlined text-sm">close</span>
</button>
</aside>
<!-- JAVASCRIPT: State handlers & Micro-interactions -->
<script>
    let toastTimeout;

    function showToast(message = "Recipient removed") {
      const toast = document.getElementById('toast-notification');
      const msgEl = document.getElementById('toast-message');
      msgEl.textContent = message;
      toast.classList.remove('translate-y-20', 'opacity-0', 'pointer-events-none');
      toast.classList.add('translate-y-0', 'opacity-100');

      clearTimeout(toastTimeout);
      toastTimeout = setTimeout(() => {
        hideToast();
      }, 4000);
    }

    function hideToast() {
      const toast = document.getElementById('toast-notification');
      toast.classList.remove('translate-y-0', 'opacity-100');
      toast.classList.add('translate-y-20', 'opacity-0', 'pointer-events-none');
    }

    function handleRemove(email, btnElement) {
      if (confirm(`Remove ${email} from weekly report dispatches?`)) {
        const row = btnElement.closest('tr');
        if (row) {
          row.style.opacity = '0';
          row.style.transform = 'translateY(-4px)';
          row.style.transition = 'all 160ms cubic-bezier(0.16, 1, 0.3, 1)';
          setTimeout(() => {
            row.remove();
            updateCount();
            showToast(`Recipient ${email} removed`);
          }, 160);
        }
      }
    }

    function handleEdit(email) {
      const input = document.getElementById('recipient-email');
      input.value = email;
      input.focus();
      showToast(`Editing ${email}`);
    }

    function updateCount() {
      const tbody = document.getElementById('recipients-tbody');
      const rows = tbody.querySelectorAll('tr').length;
      document.getElementById('recipient-count').textContent = rows;
      document.getElementById('display-count').textContent = rows;
      
      if (rows === 0) {
        document.getElementById('table-container').classList.add('hidden');
        document.getElementById('empty-state').classList.remove('hidden');
        document.getElementById('empty-state').classList.add('flex');
      } else {
        document.getElementById('table-container').classList.remove('hidden');
        document.getElementById('empty-state').classList.add('hidden');
        document.getElementById('empty-state').classList.remove('flex');
      }
    }

    function handleAddRecipient() {
      const input = document.getElementById('recipient-email');
      const errorBox = document.getElementById('inline-error');
      const val = input.value.trim();

      if (!val || !val.includes('@') || !val.includes('.')) {
        errorBox.classList.remove('hidden');
        input.classList.add('border-[#B42318]');
        return;
      }

      errorBox.classList.add('hidden');
      input.classList.remove('border-[#B42318]');

      const tbody = document.getElementById('recipients-tbody');
      const tr = document.createElement('tr');
      tr.className = 'hover:bg-[#EFEFF1] transition-colors h-14 group';
      
      const isInternal = val.endsWith('folio3.com');
      const typeLabel = isInternal ? 'Folio3 Internal • Operations' : 'External Partner • Notification';
      const badgeStyle = isInternal 
        ? 'bg-[#E6F0ED] text-[#1F6F5C] border-[#C8E6DB]' 
        : 'bg-[#F7F7F8] text-[#3F3F46] border-[#E4E4E7]';

      tr.innerHTML = `
        <td class="px-6 py-3 font-mono text-xs font-medium text-[#18181B]">
          <div class="flex items-center gap-2">
            <span class="material-symbols-outlined text-[#71717A] text-base">alternate_email</span>
            <span>${val}</span>
          </div>
        </td>
        <td class="px-6 py-3 text-xs">
          <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded text-xs ${badgeStyle} font-medium border">
            ${typeLabel}
          </span>
        </td>
        <td class="px-6 py-3 font-mono text-xs text-[#71717A] tabular-numbers">
          Today
        </td>
        <td class="px-6 py-3 text-xs">
          <span class="text-[#2F7D4A] font-medium flex items-center gap-1.5">
            <span class="w-1.5 h-1.5 rounded-full bg-[#2F7D4A]"></span>
            Active
          </span>
        </td>
        <td class="px-6 py-3 text-right text-xs">
          <div class="inline-flex items-center gap-1">
            <button onclick="handleEdit('${val}')" class="px-2 py-1 text-xs text-[#3F3F46] hover:text-[#18181B] hover:bg-[#E4E4E7] rounded font-medium transition-colors">
              Edit
            </button>
            <button onclick="handleRemove('${val}', this)" class="px-2 py-1 text-xs text-[#B42318] hover:bg-[#FBEAE8] rounded font-medium transition-colors">
              Remove
            </button>
          </div>
        </td>
      `;
      tbody.prepend(tr);
      input.value = '';
      updateCount();
      showToast(`Added ${val} to weekly reports`);
    }

    function setDemoState(state) {
      const errorBox = document.getElementById('inline-error');
      const input = document.getElementById('recipient-email');
      const table = document.getElementById('table-container');
      const emptyState = document.getElementById('empty-state');

      // reset demo buttons
      ['btn-state-default', 'btn-state-toast', 'btn-state-error', 'btn-state-empty'].forEach(id => {
        const btn = document.getElementById(id);
        btn.className = 'px-2.5 py-1 rounded text-xs font-medium bg-[#EFEFF1] text-[#3F3F46] hover:bg-[#E4E4E7] transition-all btn-press';
      });

      if (state === 'default') {
        document.getElementById('btn-state-default').className = 'px-2.5 py-1 rounded text-xs font-medium bg-[#1F6F5C] text-white transition-all btn-press';
        errorBox.classList.add('hidden');
        input.classList.remove('border-[#B42318]');
        table.classList.remove('hidden');
        emptyState.classList.add('hidden');
        emptyState.classList.remove('flex');
        hideToast();
      } else if (state === 'toast') {
        document.getElementById('btn-state-toast').className = 'px-2.5 py-1 rounded text-xs font-medium bg-[#1F6F5C] text-white transition-all btn-press';
        showToast("✓ Recipient removed");
      } else if (state === 'error') {
        document.getElementById('btn-state-error').className = 'px-2.5 py-1 rounded text-xs font-medium bg-[#1F6F5C] text-white transition-all btn-press';
        errorBox.classList.remove('hidden');
        input.classList.add('border-[#B42318]');
        input.value = "invalid-email-address";
      } else if (state === 'empty') {
        document.getElementById('btn-state-empty').className = 'px-2.5 py-1 rounded text-xs font-medium bg-[#1F6F5C] text-white transition-all btn-press';
        table.classList.toggle('hidden');
        if (table.classList.contains('hidden')) {
          emptyState.classList.remove('hidden');
          emptyState.classList.add('flex');
          document.getElementById('recipient-count').textContent = '0';
          document.getElementById('display-count').textContent = '0';
        } else {
          emptyState.classList.add('hidden');
          emptyState.classList.remove('flex');
          updateCount();
        }
      }
    }
  </script>
