<script>
    // Live Clock Simulation (PKT)
    function updateClock() {
      const now = new Date();
      // Format in UTC+5 (PKT)
      const options = {
        timeZone: "Asia/Karachi",
        hour12: false,
        hour: "2-digit",
        minute: "2-digit",
        second: "2-digit"
      };
      const timeStr = now.toLocaleTimeString("en-GB", options);
      const clockEl = document.getElementById("live-pkt-clock");
      if (clockEl) {
        clockEl.textContent = timeStr;
      }
    }
    setInterval(updateClock, 1000);
    updateClock();

    // DOM Elements
    const inputField = document.getElementById('release-time-input');
    const errorMsg = document.getElementById('validation-error-msg');
    const successBanner = document.getElementById('success-banner');
    const toastTimestamp = document.getElementById('toast-timestamp');

    const btnDefault = document.getElementById('sim-default-btn');
    const btnSuccess = document.getElementById('sim-success-btn');
    const btnError = document.getElementById('sim-error-btn');

    function resetSimulatorButtonStyles() {
      const inactiveClass = 'px-3 py-1 text-xs font-medium rounded border border-[#E4E4E7] bg-white text-[#18181B] hover:bg-[#EFEFF1] transition-all btn-press';
      btnDefault.className = inactiveClass;
      btnSuccess.className = inactiveClass;
      btnError.className = inactiveClass;
    }

    function setActiveSimButton(btn) {
      resetSimulatorButtonStyles();
      btn.className = 'px-3 py-1 text-xs font-medium rounded border border-primary-container bg-primary-container text-white transition-all btn-press';
    }

    function setSimulatorState(state) {
      if (state === 'default') {
        setActiveSimButton(btnDefault);
        inputField.value = '08:00';
        inputField.classList.remove('border-[#B42318]', 'focus:border-[#B42318]', 'focus:ring-[#FBEAE8]');
        inputField.classList.add('border-[#E4E4E7]', 'focus:border-[#1F6F5C]', 'focus:ring-[#E6F0ED]');
        errorMsg.classList.add('hidden');
        successBanner.classList.add('hidden');
      } 
      else if (state === 'success') {
        setActiveSimButton(btnSuccess);
        inputField.value = '07:45';
        inputField.classList.remove('border-[#B42318]', 'focus:border-[#B42318]', 'focus:ring-[#FBEAE8]');
        inputField.classList.add('border-[#E4E4E7]', 'focus:border-[#1F6F5C]', 'focus:ring-[#E6F0ED]');
        errorMsg.classList.add('hidden');
        
        // Show banner with current time
        const now = new Date();
        const timeOptions = { timeZone: "Asia/Karachi", hour12: false, hour: "2-digit", minute: "2-digit", second: "2-digit" };
        toastTimestamp.textContent = `Today at ${now.toLocaleTimeString("en-GB", timeOptions)} PKT`;
        successBanner.classList.remove('hidden');
      } 
      else if (state === 'error') {
        setActiveSimButton(btnError);
        inputField.value = '8:99';
        inputField.classList.remove('border-[#E4E4E7]', 'focus:border-[#1F6F5C]', 'focus:ring-[#E6F0ED]');
        inputField.classList.add('border-[#B42318]', 'focus:border-[#B42318]', 'focus:ring-[#FBEAE8]');
        errorMsg.classList.remove('hidden');
        successBanner.classList.add('hidden');
      }
    }

    function dismissBanner() {
      successBanner.classList.add('hidden');
    }

    function saveChanges() {
      const val = inputField.value.trim();
      const timeRegex = /^([01]\d|2[0-3]):([0-5]\d)$/;
      if (!timeRegex.test(val)) {
        setSimulatorState('error');
      } else {
        setSimulatorState('success');
      }
    }

    function discardChanges() {
      setSimulatorState('default');
    }

    // Live validation listener on user keystrokes
    inputField.addEventListener('input', function(e) {
      const val = e.target.value.trim();
      const timeRegex = /^([01]\d|2[0-3]):([0-5]\d)$/;
      if (val.length === 5) {
        if (!timeRegex.test(val)) {
          inputField.classList.add('border-[#B42318]');
          errorMsg.classList.remove('hidden');
        } else {
          inputField.classList.remove('border-[#B42318]');
          errorMsg.classList.add('hidden');
        }
      } else if (val.length < 5) {
        errorMsg.classList.add('hidden');
        inputField.classList.remove('border-[#B42318]');
      }
    });
  </script>
