<!-- Micro-interactions & Demo State Controller Script -->
<script>
    function setDemoState(state) {
      const btnDefault = document.getElementById('btn-demo-default');
      const btnValidation = document.getElementById('btn-demo-validation');
      const btnEmpty = document.getElementById('btn-demo-empty');

      const normalTable = document.getElementById('view-normal-table');
      const emptyTable = document.getElementById('view-empty-table');
      const editDrawer = document.getElementById('edit-drawer-panel');
      const tableContainer = document.getElementById('table-container');

      const validationBanner = document.getElementById('validation-banner');
      const inputSpaceCode = document.getElementById('input-space-code');
      const spaceCodeError = document.getElementById('space-code-error');
      const spaceCodeHelper = document.getElementById('space-code-helper');

      // Reset button pills
      [btnDefault, btnValidation, btnEmpty].forEach(b => {
        b.className = "px-2.5 py-0.5 rounded text-outline-variant hover:text-inverse-on-surface hover:bg-surface-variant/20 transition-colors";
      });

      if (state === 'default') {
        btnDefault.className = "px-2.5 py-0.5 rounded bg-primary-container text-surface-container-lowest font-medium transition-colors";
        
        normalTable.classList.remove('hidden');
        emptyTable.classList.add('hidden');
        editDrawer.classList.remove('hidden');
        tableContainer.className = "lg:col-span-8 flex flex-col bg-surface-container-lowest border border-outline-variant rounded overflow-hidden";
        
        validationBanner.classList.add('hidden');
        inputSpaceCode.className = "w-full h-10 px-3 font-mono font-medium uppercase tracking-wider bg-surface-container-lowest border border-outline-variant rounded focus:border-primary focus:ring-2 focus:ring-secondary-container text-on-surface outline-none transition-all";
        spaceCodeError.classList.add('hidden');
        spaceCodeHelper.classList.remove('hidden');
        
        document.getElementById('input-space-code').value = 'B1-03';
        document.getElementById('drawer-title').textContent = 'Edit space B1-03';
      } 
      else if (state === 'validation') {
        btnValidation.className = "px-2.5 py-0.5 rounded bg-error text-surface-container-lowest font-medium transition-colors";
        
        normalTable.classList.remove('hidden');
        emptyTable.classList.add('hidden');
        editDrawer.classList.remove('hidden');
        tableContainer.className = "lg:col-span-8 flex flex-col bg-surface-container-lowest border border-outline-variant rounded overflow-hidden";
        
        validationBanner.classList.remove('hidden');
        inputSpaceCode.className = "w-full h-10 px-3 font-mono font-medium uppercase tracking-wider bg-surface-container-lowest border-2 border-[#B42318] rounded text-[#B42318] focus:ring-1 focus:ring-[#B42318] outline-none transition-all";
        spaceCodeError.classList.remove('hidden');
        spaceCodeHelper.classList.add('hidden');
        
        document.getElementById('input-space-code').value = 'B1-03';
        document.getElementById('drawer-title').textContent = 'Edit space B1-03';
      } 
      else if (state === 'empty') {
        btnEmpty.className = "px-2.5 py-0.5 rounded bg-surface-variant text-on-surface font-semibold transition-colors";
        
        normalTable.classList.add('hidden');
        emptyTable.classList.remove('hidden');
        emptyTable.classList.add('flex');
        editDrawer.classList.add('hidden');
        tableContainer.className = "lg:col-span-12 flex flex-col bg-surface-container-lowest border border-outline-variant rounded overflow-hidden";
      }
    }

    function selectRow(spaceId) {
      const drawer = document.getElementById('edit-drawer-panel');
      const tableContainer = document.getElementById('table-container');
      drawer.classList.remove('hidden');
      tableContainer.className = "lg:col-span-8 flex flex-col bg-surface-container-lowest border border-outline-variant rounded overflow-hidden";
      
      document.getElementById('drawer-title').textContent = 'Edit space ' + spaceId;
      document.getElementById('input-space-code').value = spaceId;
      
      // Auto fill values per selection
      if(spaceId === 'B1-03') {
        document.getElementById('select-floor').value = 'B1';
        document.getElementById('input-holder').value = 'Ayesha Siddiqui (F3-0921)';
        document.getElementById('input-notes').value = 'Pillar P-14';
      } else if(spaceId === 'B2-14') {
        document.getElementById('select-floor').value = 'B2';
        document.getElementById('input-holder').value = '— (pool)';
        document.getElementById('input-notes').value = 'Near ramp access';
      } else if(spaceId === 'B3-07') {
        document.getElementById('select-floor').value = 'B3';
        document.getElementById('input-holder').value = 'Usman Tariq (F3-0455)';
        document.getElementById('input-notes').value = 'Pillar P-28';
      }
    }

    function openDrawer(mode) {
      const drawer = document.getElementById('edit-drawer-panel');
      const tableContainer = document.getElementById('table-container');
      drawer.classList.remove('hidden');
      tableContainer.className = "lg:col-span-8 flex flex-col bg-surface-container-lowest border border-outline-variant rounded overflow-hidden";

      if (mode === 'new') {
        document.getElementById('drawer-title').textContent = 'Add new space';
        document.getElementById('input-space-code').value = '';
        document.getElementById('input-holder').value = '';
        document.getElementById('input-notes').value = '';
      }
    }

    function closeDrawer() {
      const drawer = document.getElementById('edit-drawer-panel');
      const tableContainer = document.getElementById('table-container');
      drawer.classList.add('hidden');
      tableContainer.className = "lg:col-span-12 flex flex-col bg-surface-container-lowest border border-outline-variant rounded overflow-hidden";
    }

    function clearHolder() {
      document.getElementById('input-holder').value = '';
    }

    function setPoolAllocation() {
      document.getElementById('input-holder').value = '— (pool)';
    }
  </script>
</body></html>