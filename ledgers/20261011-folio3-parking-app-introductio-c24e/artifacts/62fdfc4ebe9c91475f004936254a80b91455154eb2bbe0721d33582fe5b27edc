<!-- SECTION 4: Side Panel Drawer / Form (Columns 9 to 12 Context Rail) -->
<div class="lg:col-span-4 bg-surface-container-lowest border border-outline-variant rounded p-5 flex flex-col shadow-xs" id="edit-drawer-panel">
<!-- Drawer Header -->
<div class="flex items-center justify-between pb-3.5 border-b border-outline-variant">
