<!-- Micro-interactions Script -->
<script>
    let isErrorState = true;
    let isLoading = false;

    function toggleValidationDemo() {
      const plateInput = document.getElementById('plateInput');
      const plateError = document.getElementById('plateError');
      const plateIconSlot = document.getElementById('plateIconSlot');
      const toggleLabel = document.getElementById('validationToggleLabel');

      if (isErrorState) {
        // Switch to Valid State
        plateInput.classList.remove('border-error', 'ring-1', 'ring-error');
        plateInput.classList.add('border-outline-variant');
        plateInput.value = 'BKX-482';
        plateError.classList.add('hidden');
        plateIconSlot.innerHTML = `<span class="material-symbols-outlined text-base text-primary" data-icon="check">check</span>`;
        plateIconSlot.classList.remove('text-error');
        toggleLabel.textContent = "Show Error State";
        isErrorState = false;
      } else {
        // Switch to Error State
        plateInput.classList.add('border-error', 'ring-1', 'ring-error');
        plateInput.classList.remove('border-outline-variant');
        plateInput.value = '';
        plateError.classList.remove('hidden');
        plateIconSlot.innerHTML = `<span class="material-symbols-outlined text-base" data-icon="error">error</span>`;
        plateIconSlot.classList.add('text-error');
        toggleLabel.textContent = "Show Valid State";
        isErrorState = true;
      }
    }

    function toggleLoadingState() {
      const btn = document.getElementById('submitBtn');
      const label = document.getElementById('btnLabel');
      const icon = document.getElementById('btnIcon');

      isLoading = !isLoading;

      if (isLoading) {
        btn.disabled = true;
        btn.classList.add('opacity-80', 'cursor-not-allowed');
        label.textContent = "Saving…";
        icon.textContent = "hourglass_empty";
        icon.classList.add('animate-spin');
      } else {
        btn.disabled = false;
        btn.classList.remove('opacity-80', 'cursor-not-allowed');
        label.textContent = "Save and continue to dashboard";
        icon.textContent = "check_circle";
        icon.classList.remove('animate-spin');
      }
    }

    function removeSecondaryVehicle() {
      const card = document.getElementById('secondaryVehicleCard');
      if (card) {
        card.style.opacity = '0';
        card.style.transform = 'translateY(-4px)';
        card.style.transition = 'all 160ms cubic-bezier(0.16,1,0.3,1)';
        setTimeout(() => {
          card.classList.add('hidden');
        }, 160);
      }
    }

    function triggerAddAnother() {
      const card = document.getElementById('secondaryVehicleCard');
      if (card && card.classList.contains('hidden')) {
        card.classList.remove('hidden');
        card.style.opacity = '1';
        card.style.transform = 'translateY(0)';
      } else {
        alert("Maximum registered vehicle allowance per employee profile is 2 vehicles.");
      }
    }

    function handleFormSubmit() {
      const plate = document.getElementById('plateInput').value.trim();
      if (!plate) {
        if (!isErrorState) toggleValidationDemo();
        document.getElementById('plateInput').focus();
        return;
      }

      toggleLoadingState();
      setTimeout(() => {
        alert("Vehicle successfully linked to Bilal Ahmed (F3-1187). Gate permission granted.");
        toggleLoadingState();
      }, 1200);
    }
  </script>
