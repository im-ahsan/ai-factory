  <!-- Client-side Logic for Interactive Fidelity & Testing -->
  <script>
    function setState(state) {
      // Highlight active switcher button
      const buttons = ['default', 'dialog', 'conflict', 'success'];
      buttons.forEach(b => {
        const btn = document.getElementById('btn-state-' + b);
        if (btn) {
          if (b === state) {
            btn.className = "px-2.5 py-1 rounded bg-brand text-white font-medium hover:bg-brand-dark transition";
          } else {
            btn.className = "px-2.5 py-1 rounded bg-zinc-800 text-zinc-200 hover:bg-zinc-700 transition";
          }
        }
      });

      if (state === 'default') {
        closeEditModal();
        hideConflict();
        dismissToast();
      } else if (state === 'dialog') {
        hideConflict();
        dismissToast();
        openEditModal('edit');
      } else if (state === 'conflict') {
        closeEditModal();
        dismissToast();
        showConflict();
      } else if (state === 'success') {
        closeEditModal();
        hideConflict();
        showToast();
      }
    }

    function openEditModal(mode) {
      const modal = document.getElementById('edit-plate-modal');
      modal.classList.remove('hidden');
    }

    function closeEditModal() {
      const modal = document.getElementById('edit-plate-modal');
      modal.classList.add('hidden');
    }

    function savePlateFromModal() {
      const plate = document.getElementById('modal-input-plate').value;
      const make = document.getElementById('modal-input-make').value;
      const model = document.getElementById('modal-input-model').value;
      const color = document.getElementById('modal-input-color').value;

      document.getElementById('display-plate').innerText = plate;
      document.getElementById('display-make').innerText = make;
      document.getElementById('display-model').innerText = model;
      document.getElementById('display-color').innerText = color;

      closeEditModal();
      showToast();
    }

    function handleSave() {
      const spaceCode = document.getElementById('space-code').value.trim().toUpperCase();
      // If Space B1-03 is entered, demonstrate validation state
      if (spaceCode === 'B1-03') {
        showConflict();
      } else {
        hideConflict();
        showToast();
      }
    }

    function showConflict() {
      document.getElementById('conflict-banner').classList.remove('hidden');
      document.getElementById('space-code').classList.add('border-red-500', 'bg-red-50', 'text-red-900');
      document.getElementById('space-valid-icon').classList.add('hidden');
      document.getElementById('space-error-icon').classList.remove('hidden');
      document.getElementById('space-conflict-inline').classList.remove('hidden');
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function hideConflict() {
      document.getElementById('conflict-banner').classList.add('hidden');
      document.getElementById('space-code').classList.remove('border-red-500', 'bg-red-50', 'text-red-900');
      document.getElementById('space-valid-icon').classList.remove('hidden');
      document.getElementById('space-error-icon').classList.add('hidden');
      document.getElementById('space-conflict-inline').classList.add('hidden');
    }

    function resolveConflict() {
      document.getElementById('space-code').value = 'B1-04';
      hideConflict();
      showToast();
    }

    function showToast() {
      const toast = document.getElementById('toast-success');
      toast.classList.remove('hidden', 'translate-y-2');
      toast.classList.add('translate-y-0');
      setTimeout(() => {
        // keep visible for demonstration or auto hide after 5s
      }, 5000);
    }

    function dismissToast() {
      const toast = document.getElementById('toast-success');
      toast.classList.add('hidden', 'translate-y-2');
    }

    function toggleDedicated(isOn) {
      const badge = document.getElementById('toggle-badge');
      const inputs = document.getElementById('assignment-inputs');
      if (isOn) {
        badge.innerText = "Enabled (ON)";
        badge.className = "px-2 py-0.5 rounded text-[10px] font-bold uppercase bg-emerald-100 text-emerald-800";
        inputs.classList.remove('opacity-40', 'pointer-events-none');
      } else {
        badge.innerText = "Disabled (OFF)";
        badge.className = "px-2 py-0.5 rounded text-[10px] font-bold uppercase bg-zinc-200 text-zinc-700";
        inputs.classList.add('opacity-40', 'pointer-events-none');
      }
    }

    function confirmRemoveVehicle() {
      if (confirm("Remove LEC-18-3320 from Ayesha Siddiqui's active gate clearance?")) {
        const row = document.getElementById('vehicle-row-1');
        row.classList.add('opacity-30');
        alert("Vehicle removed. Click 'Save changes' to commit updates to the Gate Barrier roster.");
      }
    }

    function resetForm() {
      document.getElementById('space-code').value = 'B1-03';
      document.getElementById('assigned-floor').value = 'B1';
      document.getElementById('dedicated-toggle').checked = true;
      toggleDedicated(true);
      hideConflict();
      dismissToast();
    }

    function toggleElement(id, show) {
      const el = document.getElementById(id);
      if (show) el.classList.remove('hidden');
      else el.classList.add('hidden');
    }
  </script>
