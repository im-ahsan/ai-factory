<!-- Micro-interactions Script -->
<script>
    function switchState(state) {
      const cards = ['normal', 'success', 'error', 'empty'];
      cards.forEach(c => {
        const el = document.getElementById(`card-${c}`);
        if (el) el.classList.add('hidden');
        const btn = document.getElementById(`btn-state-${c}`);
        if (btn) {
          btn.className = "state-tab-btn px-3 py-1.5 rounded text-xs font-medium transition-all text-on-surface-variant hover:text-on-surface";
        }
      });

      const targetCard = document.getElementById(`card-${state}`);
      if (targetCard) targetCard.classList.remove('hidden');

      const activeBtn = document.getElementById(`btn-state-${state}`);
      if (activeBtn) {
        activeBtn.className = "state-tab-btn px-3 py-1.5 rounded text-xs font-medium transition-all bg-surface-container-lowest text-on-surface border border-outline-variant shadow-sm";
      }
    }

    function simulateClaim() {
      const btn = document.getElementById('claim-btn-interactive');
      const text = document.getElementById('claim-btn-text');
      if (!btn || !text) return;

      btn.disabled = true;
      btn.innerHTML = `
        <svg class="animate-spin h-4 w-4 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
        </svg>
        <span>Claiming…</span>
      `;

      setTimeout(() => {
        switchState('success');
        btn.disabled = false;
        btn.innerHTML = `
          <span class="material-symbols-outlined text-[18px]">local_parking</span>
          <span id="claim-btn-text">Claim a space for today</span>
        `;
      }, 750);
    }

    function toggleVehicleMode() {
      const normalV = document.getElementById('vehicle-normal');
      const emptyV = document.getElementById('vehicle-empty');
      if (normalV.classList.contains('hidden')) {
        normalV.classList.remove('hidden');
        emptyV.classList.add('hidden');
      } else {
        normalV.classList.add('hidden');
        emptyV.classList.remove('hidden');
      }
    }
  </script>
</body></html>