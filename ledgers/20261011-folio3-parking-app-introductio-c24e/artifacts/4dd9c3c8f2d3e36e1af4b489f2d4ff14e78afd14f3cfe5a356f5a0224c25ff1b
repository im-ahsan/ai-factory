<!-- JAVASCRIPT MICRO-INTERACTIONS & VALIDATION STATE HANDLERS                -->
<!-- ========================================================================= -->
<script>
    let isErrorStateSimulated = true;

    function openDrawer(spaceCode) {
      const drawer = document.getElementById('side-drawer');
      const drawerTitle = document.getElementById('drawer-title');
      const spaceCodeInput = document.getElementById('space-code-input');
      
      if (spaceCode === 'new') {
        drawerTitle.textContent = 'Add new space';
        spaceCodeInput.value = '';
        setErrorState(false);
      } else {
        drawerTitle.textContent = `Edit space ${spaceCode}`;
        spaceCodeInput.value = spaceCode;
        if (spaceCode === 'B1-03') {
          setErrorState(true);
        } else {
          setErrorState(false);
        }
      }
      drawer.classList.remove('translate-x-full');
      drawer.classList.add('translate-x-0');
    }

    function closeDrawer() {
      const drawer = document.getElementById('side-drawer');
      drawer.classList.add('translate-x-full');
      drawer.classList.remove('translate-x-0');
    }

    function toggleErrorState() {
      isErrorStateSimulated = !isErrorStateSimulated;
      setErrorState(isErrorStateSimulated);
      document.getElementById('errorStateLabel').textContent = isErrorStateSimulated ? 'Active' : 'Cleared';
    }

    function setErrorState(active) {
      const errBox = document.getElementById('validation-error-box');
      const input = document.getElementById('space-code-input');
      const text = document.getElementById('field-error-text');

      if (active) {
        errBox.classList.remove('hidden');
        input.classList.add('border-[#B42318]');
        input.classList.remove('border-[#E4E4E7]');
        text.classList.remove('hidden');
      } else {
        errBox.classList.add('hidden');
        input.classList.remove('border-[#B42318]');
        input.classList.add('border-[#E4E4E7]');
        text.classList.add('hidden');
      }
    }

    function saveSpaceChanges() {
      if (document.getElementById('space-code-input').value === 'B1-03' && isErrorStateSimulated) {
        alert('Validation error: Space code B1-03 already exists. Please resolve conflict before saving.');
      } else {
        alert('Changes for space B1-03 successfully saved to Folio3 inventory telemetry.');
        closeDrawer();
      }
    }

    // Initialize state
    document.addEventListener('DOMContentLoaded', () => {
      setErrorState(true);
    });
  </script>
