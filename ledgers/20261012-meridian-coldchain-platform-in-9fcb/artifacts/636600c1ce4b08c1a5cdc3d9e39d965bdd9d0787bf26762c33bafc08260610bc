<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Route detail — Meridian</title>
  <!-- Google Fonts: Hanken Grotesk, Public Sans, IBM Plex Mono -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@600;650;700&family=IBM+Plex+Mono:wght@400;500;600&family=Public+Sans:wght@400;500;600&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    /* Strict CSS token overrides & typography rules */
    body {
      background-color: #F7F7F7;
      color: #202020;
      font-family: 'Public Sans', -apple-system, BlinkMacSystemFont, sans-serif;
      margin: 0;
      padding: 0;
      -webkit-font-smoothing: antialiased;
    }

    h1, .font-heading-main {
      font-family: 'Hanken Grotesk', sans-serif;
      font-size: 28px;
      line-height: 1.25;
      font-weight: 650;
    }

    h2, .font-heading-section {
      font-family: 'Hanken Grotesk', sans-serif;
      font-size: 20px;
      line-height: 1.3;
      font-weight: 650;
    }

    h3, .font-heading-sub {
      font-family: 'Hanken Grotesk', sans-serif;
      font-size: 16px;
      line-height: 1.4;
      font-weight: 600;
    }

    .font-mono-num {
      font-family: 'IBM Plex Mono', monospace;
      font-feature-settings: "tnum" 1;
    }

    /* Motion specifications */
    @keyframes entranceFadeIn {
      0% {
        opacity: 0;
        transform: translateY(6px);
      }
      100% {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes syncBreathe {
      0%, 100% {
        opacity: 0.7;
      }
      50% {
        opacity: 1;
      }
    }

    @keyframes savedHandoff {
      0% {
        opacity: 0.6;
        transform: translateY(8px);
      }
      100% {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .motion-entrance {
      animation: entranceFadeIn 280ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    .status-breathing-dot {
      animation: syncBreathe 6s ease-in-out infinite;
    }

    .motion-saved-handoff {
      animation: savedHandoff 260ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    /* Control interactive states */
    .btn-primary {
      background-color: #A94B1D;
      color: #FFFFFF;
      height: 48px;
      border-radius: 2px;
      font-family: 'Public Sans', sans-serif;
      font-size: 16px;
      font-weight: 500;
      padding: 0 20px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      transition: background-color 150ms ease, box-shadow 150ms ease;
      text-decoration: none;
      cursor: pointer;
    }
    .btn-primary:hover {
      background-color: #933f17;
    }
    .btn-primary:focus {
      outline: none;
      box-shadow: 0 0 0 2px #A94B1D;
    }
    .btn-primary:active {
      background-color: #7d3513;
    }

    .btn-secondary {
      background-color: #FFFFFF;
      color: #202020;
      height: 48px;
      border: 1px solid #D5D5D5;
      border-radius: 2px;
      font-family: 'Public Sans', sans-serif;
      font-size: 16px;
      font-weight: 500;
      padding: 0 20px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      transition: background-color 150ms ease, border-color 150ms ease;
      text-decoration: none;
      cursor: pointer;
    }
    .btn-secondary:hover {
      background-color: #F7F7F7;
      border-color: #BFBFBF;
    }
    .btn-secondary:focus {
      outline: none;
      box-shadow: 0 0 0 2px #A94B1D;
    }
    .btn-secondary:active {
      background-color: #EFEFEF;
    }

    .nav-item-active {
      color: #202020;
      position: relative;
    }
    .nav-item-active::after {
      content: '';
      position: absolute;
      bottom: -17px;
      left: 0;
      right: 0;
      height: 2px;
      background-color: #A94B1D;
    }

    .nav-item-inactive {
      color: #626262;
      transition: color 140ms ease;
    }
    .nav-item-inactive:hover {
      color: #202020;
    }
    .nav-item-inactive:focus {
      outline: none;
      box-shadow: 0 0 0 2px #A94B1D;
    }

    @media (prefers-reduced-motion: reduce) {
      *, ::before, ::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
      }
    }
  </style>
</head>
<body class="min-h-screen text-[#202020] bg-[#F7F7F7]">

