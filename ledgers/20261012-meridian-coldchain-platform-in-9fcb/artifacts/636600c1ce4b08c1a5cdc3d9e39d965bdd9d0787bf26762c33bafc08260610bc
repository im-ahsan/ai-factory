          </div>

          <div class="flex items-center gap-6 text-[14px]">
            <div>
              <span class="text-[#626262] block text-[13px]">Scheduled stop</span>
              <span class="font-mono-num text-[16px] text-[#202020] font-medium">15:00 BST</span>
            </div>
            <div class="h-8 w-[1px] bg-[#D5D5D5]"></div>
            <div>
              <span class="text-[#626262] block text-[13px]">Qualified-duration margin</span>
              <span class="font-mono-num text-[16px] text-[#202020] font-medium">+38m allowance</span>
            </div>
            <div class="h-8 w-[1px] bg-[#D5D5D5]"></div>
            <div>
              <span class="text-[#626262] block text-[13px]">Last update</span>
              <span class="font-mono-num text-[16px] text-[#202020]">14 May 09:30</span>
            </div>
            <div class="pl-2">
              <a href="#" class="btn-secondary" style="height: 40px; padding: 0 16px; font-size: 14px;">Delivery evidence</a>
            </div>
          </div>
        </div>

        <!-- Stop Details Sub-bar: Order Link & Consignee -->
        <div class="py-4 flex flex-wrap items-center justify-between text-[14px] border-b border-[#D5D5D5] bg-[#FFFFFF]">
          <div class="flex items-center gap-6">
            <div>
              <span class="text-[#626262]">Consignment order:</span>
              <span class="font-mono-num font-semibold text-[#202020] ml-1">Order 0-299</span>
            </div>
            <div>
              <span class="text-[#626262]">Consignee:</span>
              <span class="text-[#202020] font-medium ml-1">Cedar Health (Hana Youssef)</span>
            </div>
            <div>
              <span class="text-[#626262]">Product:</span>
              <span class="text-[#202020] font-medium ml-1">Insulin Glargine 100 units/mL (Lot IG-2511)</span>
