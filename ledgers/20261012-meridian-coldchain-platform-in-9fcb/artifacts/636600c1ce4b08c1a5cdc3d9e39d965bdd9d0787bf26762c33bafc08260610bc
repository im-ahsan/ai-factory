    <!-- Operational Context & Assurance Summary -->
    <section class="grid grid-cols-1 md:grid-cols-2 gap-8">
      
      <!-- Box Consignment & Thermal Assurance Panel -->
      <div class="bg-[#FFFFFF] border border-[#D5D5D5] rounded-[2px] p-6">
        <h3 class="font-heading-sub text-[#202020] mb-4">Thermal packaging specification</h3>
        
        <div class="space-y-4 text-[14px]">
          <div class="flex justify-between py-2 border-b border-[#D5D5D5]">
            <span class="text-[#626262]">Shipper specification</span>
            <span class="font-medium text-[#202020]">Credo ProEnthalp 4L / BioTherm 12L</span>
          </div>
          <div class="flex justify-between py-2 border-b border-[#D5D5D5]">
            <span class="text-[#626262]">Validated temperature band</span>
            <span class="font-mono-num font-medium text-[#202020]">2.0°C – 8.0°C (Profile v3)</span>
          </div>
          <div class="flex justify-between py-2 border-b border-[#D5D5D5]">
            <span class="text-[#626262]">Upper tier tolerance (>8–10°C)</span>
