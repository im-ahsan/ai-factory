    <!-- Top Route Overview Hero Panel -->
    <section class="bg-[#FFFFFF] border border-[#D5D5D5] rounded-[2px] p-6 mb-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        
        <!-- Left: Route specs & Metadata -->
        <div class="lg:col-span-7 flex flex-col justify-between">
          <div>
            <div class="flex items-center gap-3 mb-4">
              <span class="font-mono-num text-2xl font-bold tracking-tight text-[#202020]">Route R-204</span>
              <span class="inline-flex items-center gap-1.5 text-sm font-medium text-[#24704B]">
                <span class="w-2 h-2 rounded-full bg-[#24704B]"></span>
