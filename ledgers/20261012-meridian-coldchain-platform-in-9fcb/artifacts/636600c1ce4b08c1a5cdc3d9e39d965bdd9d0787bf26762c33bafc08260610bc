              </span>
            </div>

            <!-- Key metadata grid -->
            <div class="grid grid-cols-3 gap-6 py-4 border-t border-b border-[#D5D5D5]">
              <div>
                <div class="text-[14px] text-[#626262] mb-1">Route date</div>
                <div class="font-mono-num text-[16px] text-[#202020] font-medium">14 May 2026</div>
              </div>
              <div>
                <div class="text-[14px] text-[#626262] mb-1">Assigned driver</div>
                <div class="text-[16px] text-[#202020] font-medium">Tariq Mansour</div>
              </div>
              <div>
                <div class="text-[14px] text-[#626262] mb-1">Vehicle assignment</div>
                <div class="font-mono-num text-[16px] text-[#202020] font-medium">VAN-27 · MTR-482</div>
              </div>
            </div>

            <!-- Planned departure & margin note -->
            <div class="grid grid-cols-3 gap-6 pt-4">
              <div>
                <div class="text-[14px] text-[#626262] mb-1">Planned departure</div>
                <div class="font-mono-num text-[16px] text-[#202020]">15:00 BST</div>
              </div>
              <div>
                <div class="text-[14px] text-[#626262] mb-1">Route margin</div>
                <div class="font-mono-num text-[16px] text-[#202020]">38 min qualified-duration</div>
              </div>
              <div>
