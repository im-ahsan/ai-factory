                  </td>
                  <td class="py-3 px-4 text-right">
                    <a href="#" class="btn-secondary" style="height: 34px; padding: 0 12px; font-size: 13px;">Box temperature</a>
                  </td>
                </tr>

                <!-- Row 2: B-702 -->
                <tr class="hover:bg-[#FBFBFB] transition-colors h-[48px]">
                  <td class="py-3 px-4 font-mono-num font-semibold text-[#202020]">
                    B-702
                  </td>
                  <td class="py-3 px-4 font-mono-num text-[#202020]">
