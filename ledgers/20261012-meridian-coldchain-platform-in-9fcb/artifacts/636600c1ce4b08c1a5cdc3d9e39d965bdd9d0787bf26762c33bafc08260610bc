                <div class="text-[16px] text-[#202020]">Order 0-299 (20 packs)</div>
              </div>
            </div>
          </div>
        </div>

        <!-- Right: Real photograph of the white van cropped to 4:3 -->
        <div class="lg:col-span-5">
          <div class="border border-[#D5D5D5] rounded-[2px] overflow-hidden bg-[#FFFFFF]">
