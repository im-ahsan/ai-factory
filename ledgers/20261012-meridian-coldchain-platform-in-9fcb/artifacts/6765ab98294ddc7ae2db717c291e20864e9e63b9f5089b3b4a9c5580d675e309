<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Temperature profiles</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@600;650;700&family=IBM+Plex+Mono:wght@400;500;600&family=Public+Sans:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    /* CSS Reset & System Tokens */
    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      background-color: #F7F7F7;
      color: #202020;
      font-family: 'Public Sans', sans-serif;
      font-size: 16px;
      line-height: 1.5;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    /* Typography */
    h1, h2, h3, .heading-font {
      font-family: 'Hanken+Grotesk', 'Hanken Grotesk', sans-serif;
    }

    .font-mono {
      font-family: 'IBM Plex Mono', monospace;
    }

    /* Motion Tokens & Keyframes */
    @keyframes entranceFadeIn {
      0% {
        opacity: 0;
        transform: translateY(6px);
      }
      100% {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes savedHandoff {
      0% {
        opacity: 0.6;
        transform: translateY(8px);
      }
      100% {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes waitingBreathe {
      0%, 100% {
        opacity: 0.7;
      }
      50% {
        opacity: 1;
      }
    }

    .animate-entrance {
      animation: entranceFadeIn 240ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    .animate-handoff {
      animation: savedHandoff 260ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    .dot-waiting-breathing {
      animation: waitingBreathe 6s ease-in-out infinite;
    }

    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
        scroll-behavior: auto !important;
      }
    }

    /* Header Component */
    header {
      background-color: #FFFFFF;
      border-bottom: 1px solid #D5D5D5;
      width: 100%;
      height: 64px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 32px;
      position: sticky;
      top: 0;
      z-index: 50;
    }

    .header-left {
      display: flex;
      align-items: center;
      gap: 32px;
    }

    .brand-mark {
      display: flex;
      align-items: center;
      gap: 8px;
      text-decoration: none;
      color: #202020;
    }

    .brand-square {
      width: 24px;
      height: 24px;
      background-color: #202020;
      border-radius: 2px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #FFFFFF;
      font-weight: 700;
      font-size: 13px;
      font-family: 'Hanken Grotesk', sans-serif;
    }

    .brand-name {
      font-family: 'Hanken Grotesk', sans-serif;
      font-weight: 700;
      font-size: 17px;
      letter-spacing: -0.2px;
    }

    nav.main-nav {
      display: flex;
      align-items: center;
      gap: 24px;
      height: 64px;
    }

    .nav-link {
      display: flex;
      align-items: center;
      height: 100%;
      font-size: 15px;
      font-weight: 500;
      color: #626262;
      text-decoration: none;
      border-bottom: 2px solid transparent;
      transition: color 150ms ease, border-color 150ms ease;
    }

    .nav-link:hover {
      color: #202020;
    }

    .nav-link.active {
      color: #A94B1D;
      border-bottom-color: #A94B1D;
      font-weight: 600;
    }

    .header-right {
      display: flex;
      align-items: center;
      gap: 20px;
    }

    .user-profile {
      display: flex;
      align-items: center;
      gap: 10px;
      font-size: 14px;
      color: #202020;
    }

    .user-initials {
      width: 28px;
      height: 28px;
      background-color: #F7F7F7;
      border: 1px solid #D5D5D5;
      border-radius: 2px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 12px;
      font-weight: 600;
      color: #202020;
    }

    .lang-switcher {
      font-size: 14px;
      color: #626262;
      border-left: 1px solid #D5D5D5;
      padding-left: 16px;
    }

    /* Main Layout */
    main {
      flex: 1;
      width: 100%;
      max-width: 1280px;
      margin: 0 auto;
      padding: 32px 32px 64px 32px;
      display: flex;
      flex-direction: column;
      gap: 32px;
    }

    .page-header-row {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
    }

    h1.page-title {
      font-size: 28px;
      font-weight: 650;
      color: #202020;
      letter-spacing: -0.3px;
      line-height: 1.2;
    }

    .sub-title-text {
      margin-top: 4px;
      font-size: 14px;
      color: #626262;
    }

    /* Panels & Rules */
    .panel {
      background-color: #FFFFFF;
      border: 1px solid #D5D5D5;
      border-radius: 2px;
      padding: 24px;
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    h2.section-heading {
      font-size: 20px;
      font-weight: 650;
      color: #202020;
      letter-spacing: -0.2px;
    }

    h3.smaller-heading {
      font-size: 16px;
      font-weight: 600;
      color: #202020;
    }

    /* Buttons */
    .btn {
      height: 48px;
      padding: 0 20px;
      border-radius: 2px;
      font-size: 15px;
      font-weight: 600;
      font-family: 'Public Sans', sans-serif;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      text-decoration: none;
      transition: background-color 140ms ease, border-color 140ms ease, transform 90ms ease;
    }

    .btn:active {
      transform: scale(0.98);
    }

    .btn:focus-visible {
      outline: 2px solid #A94B1D;
      outline-offset: 2px;
    }

    .btn-primary {
      background-color: #A94B1D;
      color: #FFFFFF;
      border: 1px solid #A94B1D;
    }

    .btn-primary:hover {
      background-color: #933E16;
      border-color: #933E16;
    }

    .btn-secondary {
      background-color: #FFFFFF;
      color: #202020;
      border: 1px solid #D5D5D5;
    }

    .btn-secondary:hover {
      background-color: #F7F7F7;
      border-color: #C0C0C0;
    }

    /* Status indicators */
    .status-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: 14px;
      font-weight: 500;
      white-space: nowrap;
    }

    .status-dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
    }

    .status-good {
      color: #24704B;
    }
    .status-good .status-dot {
      background-color: #24704B;
    }

    .status-waiting {
      color: #805800;
    }
    .status-waiting .status-dot {
      background-color: #805800;
    }

    .status-refused {
      color: #AE2C2C;
    }
    .status-refused .status-dot {
      background-color: #AE2C2C;
    }

    /* Lead Profile Card Grid */
    .lead-profile-banner {
      background-color: #FFFFFF;
      border: 1px solid #D5D5D5;
      border-radius: 2px;
      padding: 24px;
      display: flex;
      flex-direction: column;
      gap: 20px;
    }

    .lead-header-bar {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      border-bottom: 1px solid #D5D5D5;
      padding-bottom: 16px;
    }

    .lead-title-area {
      display: flex;
      flex-direction: column;
      gap: 4px;
    }

    .lead-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 24px;
    }

    .metric-cell {
      display: flex;
      flex-direction: column;
      gap: 4px;
    }

    .metric-label {
      font-size: 14px;
      color: #626262;
    }

    .metric-value {
      font-size: 16px;
      color: #202020;
      font-weight: 500;
    }

    .metric-value-large {
      font-size: 20px;
      font-weight: 600;
      color: #202020;
    }

    /* Tables */
    .table-container {
      width: 100%;
      border-collapse: collapse;
      text-align: left;
    }

    .table-container th {
      font-size: 14px;
      font-weight: 600;
      color: #626262;
      border-bottom: 1px solid #D5D5D5;
      padding: 12px 16px;
      height: 48px;
      background-color: #FFFFFF;
    }

    .table-container td {
      font-size: 15px;
      color: #202020;
      border-bottom: 1px solid #D5D5D5;
      padding: 12px 16px;
      height: 48px;
      vertical-align: middle;
    }

    .table-container tr:last-child td {
      border-bottom: none;
    }

    .table-container tbody tr:hover td {
      background-color: #FAFAFA;
    }

    /* Recalculation Evaluation Grid */
    .recalc-card {
      border: 1px solid #D5D5D5;
      border-radius: 2px;
      padding: 16px;
      background-color: #FFFFFF;
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .recalc-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 16px;
    }

    .sub-quiet {
      font-size: 14px;
      color: #626262;
    }

    .unaltered-notice {
      border-left: 3px solid #202020;
      padding: 12px 16px;
      background-color: #F7F7F7;
      font-size: 14px;
      color: #202020;
    }
  </style>
</head>
<body class="animate-entrance">

  <!-- Header standard across every page -->
  <header>
    <div class="header-left">
      <a href="#" class="brand-mark">
        <div class="brand-square">M</div>
        <span class="brand-name">Meridian</span>
