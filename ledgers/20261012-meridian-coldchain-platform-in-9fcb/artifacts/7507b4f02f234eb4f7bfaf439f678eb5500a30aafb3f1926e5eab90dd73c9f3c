<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Organisation detail</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@600;650;700&family=IBM+Plex+Mono:wght@400;500;600&family=Public+Sans:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    /* Design System strict CSS tokens */
    :root {
      --bg-page: #F7F7F7;
      --bg-surface: #FFFFFF;
      --text-main: #202020;
      --text-quiet: #626262;
      --border-rule: #D5D5D5;
      --primary: #A94B1D;
      --status-good: #24704B;
      --status-waiting: #805800;
      --status-refused: #AE2C2C;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      background-color: var(--bg-page);
      color: var(--text-main);
      font-family: 'Public Sans', sans-serif;
      font-size: 16px;
      line-height: 1.5;
      -webkit-font-smoothing: antialiased;
    }

    /* Motion specifications */
    @keyframes pageEntrance {
      0% {
        opacity: 0;
        transform: translateY(6px);
      }
      100% {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes savedHandoff {
      0% {
        opacity: 0.6;
        transform: translateY(8px);
      }
      100% {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes waitingBreathe {
      0%, 100% {
        opacity: 0.7;
      }
      50% {
        opacity: 1;
      }
    }

    .animate-entrance {
      animation: pageEntrance 260ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    @media (prefers-reduced-motion: reduce) {
      *, ::before, ::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
        scroll-behavior: auto !important;
      }
    }

    /* Typography */
    h1, h2, h3, .font-heading {
      font-family: 'Hanken Grotesk', sans-serif;
    }

    .main-title {
      font-size: 28px;
      font-weight: 650;
      line-height: 1.25;
      color: var(--text-main);
    }

    .section-title {
      font-size: 20px;
      font-weight: 650;
      line-height: 1.3;
      color: var(--text-main);
    }

    .subsection-title {
      font-size: 16px;
      font-weight: 600;
      line-height: 1.4;
      color: var(--text-main);
    }

    .mono {
      font-family: 'IBM Plex Mono', monospace;
    }

    /* Header */
    header {
      background: var(--bg-surface);
      border-bottom: 1px solid var(--border-rule);
      height: 56px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 32px;
      position: sticky;
      top: 0;
      z-index: 50;
    }

    .header-left {
      display: flex;
      align-items: center;
      gap: 32px;
    }

    .brand-mark {
      display: flex;
      align-items: center;
      gap: 10px;
      text-decoration: none;
      color: var(--text-main);
    }

    .brand-box {
      width: 24px;
      height: 24px;
      background: #202020;
      color: #FFFFFF;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: 'Hanken Grotesk', sans-serif;
      font-weight: 700;
      font-size: 14px;
      border-radius: 2px;
    }

    .brand-name {
      font-family: 'Hanken Grotesk', sans-serif;
      font-weight: 700;
      font-size: 18px;
      letter-spacing: -0.01em;
    }

    nav {
      display: flex;
      align-items: center;
      gap: 24px;
      height: 56px;
    }

    .nav-item {
      text-decoration: none;
      color: var(--text-quiet);
      font-size: 15px;
      font-weight: 500;
      display: flex;
      align-items: center;
      height: 100%;
      border-bottom: 2px solid transparent;
      transition: color 150ms ease, border-color 150ms ease;
    }

    .nav-item:hover {
      color: var(--text-main);
    }

    .nav-item:focus-visible {
      outline: 2px solid var(--primary);
      outline-offset: -2px;
    }

    .nav-item.active {
      color: var(--primary);
      border-bottom-color: var(--primary);
      font-weight: 600;
    }

    .header-right {
      display: flex;
      align-items: center;
      gap: 20px;
      font-size: 14px;
    }

    .user-profile {
      display: flex;
      align-items: center;
      gap: 8px;
      color: var(--text-main);
    }

    .user-initials {
      width: 28px;
      height: 28px;
      background: #EAEAEA;
      color: #202020;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: 'Hanken Grotesk', sans-serif;
      font-weight: 600;
      font-size: 12px;
      border-radius: 2px;
    }

    .lang-switcher {
      color: var(--text-quiet);
      font-size: 14px;
      border-left: 1px solid var(--border-rule);
      padding-left: 16px;
    }

    /* Main Container */
    main {
      max-width: 880px;
      margin: 0 auto;
      padding: 32px 24px 64px 24px;
    }

    /* Page Header block */
    .page-header {
      margin-bottom: 32px;
    }

    .page-kicker {
      font-size: 14px;
      color: var(--text-quiet);
      margin-bottom: 4px;
    }

    .panels-container {
      display: flex;
      flex-direction: column;
      gap: 32px;
    }

    /* Panels */
    .panel {
      background: var(--bg-surface);
      border: 1px solid var(--border-rule);
      border-radius: 2px;
      padding: 24px;
    }

    .panel-header {
      margin-bottom: 16px;
      display: flex;
      justify-content: space-between;
      align-items: baseline;
    }

    .panel-desc {
      font-size: 14px;
      color: var(--text-quiet);
      margin-top: 4px;
      margin-bottom: 20px;
      line-height: 1.45;
    }

    /* Form Fields */
    .form-group {
      display: flex;
      flex-direction: column;
      gap: 8px;
      margin-bottom: 16px;
    }

    label {
      font-size: 14px;
      font-weight: 500;
      color: var(--text-main);
    }

    .input-field {
      height: 48px;
      background: var(--bg-surface);
      border: 1px solid var(--border-rule);
      border-radius: 2px;
      padding: 0 16px;
      font-size: 16px;
      color: var(--text-main);
      transition: border-color 150ms ease, box-shadow 150ms ease;
      width: 100%;
    }

    .input-field:focus {
      outline: none;
      border-color: var(--primary);
      box-shadow: 0 0 0 1px var(--primary);
    }

    .input-field.mono {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 16px;
    }

    .field-hint {
      font-size: 14px;
      color: var(--text-quiet);
      line-height: 1.4;
    }

    /* Buttons */
    .btn {
      height: 48px;
      padding: 0 24px;
      border-radius: 2px;
      font-size: 16px;
      font-weight: 500;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      transition: background-color 150ms ease, border-color 150ms ease, transform 90ms ease;
    }

    .btn:active {
      transform: scale(0.99);
    }

    .btn:focus-visible {
      outline: 2px solid var(--primary);
      outline-offset: 2px;
    }

    .btn-primary {
      background: var(--primary);
      color: #FFFFFF;
      border: 1px solid var(--primary);
    }

    .btn-primary:hover {
      background: #933E15;
      border-color: #933E15;
    }

    /* Tables */
    .table-container {
      border: 1px solid var(--border-rule);
      border-radius: 2px;
      background: var(--bg-surface);
      overflow: hidden;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      text-align: left;
    }

    thead th {
      background: #FAFAFA;
      font-size: 13px;
      font-weight: 600;
      color: var(--text-quiet);
      text-transform: uppercase;
      letter-spacing: 0.03em;
      padding: 0 16px;
      height: 40px;
      border-bottom: 1px solid var(--border-rule);
    }

    tbody tr {
      height: 48px;
      border-bottom: 1px solid var(--border-rule);
    }

    tbody tr:last-child {
      border-bottom: none;
    }

    tbody td {
      padding: 0 16px;
      font-size: 15px;
      color: var(--text-main);
      vertical-align: middle;
    }

    /* Status Dot & Labels */
    .status-badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-size: 14px;
      font-weight: 500;
    }

    .status-dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      flex-shrink: 0;
    }

    .status-dot.good {
      background-color: var(--status-good);
    }

    .status-dot.waiting {
      background-color: var(--status-waiting);
    }

    .status-dot.refused, .status-dot.failed {
      background-color: var(--status-refused);
    }

    .status-text-good {
      color: var(--status-good);
    }

    .status-text-waiting {
      color: var(--status-waiting);
    }

    .status-text-refused {
      color: var(--status-refused);
    }

    /* Information notes */
    .info-callout {
      background: #FAF8F6;
      border-left: 3px solid var(--primary);
      padding: 12px 16px;
      font-size: 14px;
      color: var(--text-main);
      margin-top: 16px;
      line-height: 1.45;
    }

    .read-only-badge {
      font-size: 12px;
      color: var(--text-quiet);
      border: 1px solid var(--border-rule);
      padding: 2px 8px;
      border-radius: 2px;
      background: #FAFAFA;
      font-weight: 500;
    }

    .meta-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
      margin-bottom: 16px;
    }

    .meta-item {
      display: flex;
      flex-direction: column;
      gap: 4px;
    }

    .meta-label {
      font-size: 13px;
      color: var(--text-quiet);
      font-weight: 500;
    }

    .meta-value {
      font-size: 15px;
      color: var(--text-main);
    }
  </style>
</head>
<body class="animate-entrance">

  <!-- Header -->
  <header>
    <div class="header-left">
      <a href="#" class="brand-mark">
        <div class="brand-box">M</div>
        <span class="brand-name">Meridian</span>
      </a>
      <nav>
        <a href="#" class="nav-item">Products</a>
        <a href="#" class="nav-item active">Organisations</a>
        <a href="#" class="nav-item">Accounts</a>
        <a href="#" class="nav-item">Audit trail</a>
        <a href="#" class="nav-item">Reports</a>
      </nav>
    </div>
    <div class="header-right">
      <div class="user-profile">
        <div class="user-initials">MV</div>
        <span>Marcus Vale · System Administrator</span>
      </div>
      <div class="lang-switcher">
        <span>EN / العربية</span>
      </div>
    </div>
  </header>

  <!-- Main Content -->
  <main>
    <div class="page-header">
      <div class="page-kicker">Cedar Health</div>
      <h1 class="main-title">Organisation detail</h1>
    </div>

    <div class="panels-container">

      <!-- Organisation Profile & Scope -->
      <section class="panel">
        <div class="panel-header">
          <h2 class="section-title">Organisation specification</h2>
          <span class="status-badge">
            <span class="status-dot good"></span>
            <span class="status-text-good">good active</span>
          </span>
        </div>
        <div class="meta-grid">
          <div class="meta-item">
            <span class="meta-label">Organisation name</span>
            <span class="meta-value">Cedar Health</span>
          </div>
          <div class="meta-item">
            <span class="meta-label">Customer administrator</span>
            <span class="meta-value">Salma Idris</span>
          </div>
          <div class="meta-item">
            <span class="meta-label">Primary buyer</span>
            <span class="meta-value">Hana Youssef</span>
          </div>
          <div class="meta-item">
            <span class="meta-label">Default consignee facility</span>
            <span class="meta-value">Cedar Clinic, London</span>
          </div>
        </div>
      </section>

      <!-- Minimum Remaining Shelf Life Rule (Editable for Marcus) -->
      <section class="panel">
        <div class="panel-header">
          <h2 class="section-title">Shelf-life governance rule</h2>
          <span class="read-only-badge">Marcus editable</span>
        </div>
        <p class="panel-desc">
          Configure the mandatory minimum remaining shelf-life threshold enforced across warehouse allocation, route packing, and consignee dispatch. Customers and dispatchers see its returned value read-only.
        </p>

        <form action="#" method="POST" onsubmit="event.preventDefault();">
          <div class="form-group" style="max-width: 320px;">
            <label for="shelf-life-input">Minimum remaining shelf life (days)</label>
            <input 
              type="text" 
              id="shelf-life-input" 
              name="shelf_life" 
              class="input-field mono" 
              value="90" 
              required
            >
            <span class="field-hint">Configured threshold for Cedar Health consignment eligibility.</span>
          </div>

          <div style="margin-top: 24px; display: flex; align-items: center; gap: 16px;">
            <button type="submit" class="btn btn-primary">Save shelf-life rule</button>
            <span class="field-hint">Customers and dispatchers see its returned value read-only.</span>
          </div>
        </form>

        <div class="info-callout">
          Primary Save shelf-life rule: Customers and dispatchers see its returned value read-only. Inbound warehouse batches (including Lot IG-2511 with 321 days remaining and IG-2509) evaluate against this threshold prior to packing and transit assignment.
        </div>
      </section>

      <!-- Organisation-scoped Account Access (Read-only for System Staff) -->
      <section class="panel">
        <div class="panel-header">
          <h2 class="section-title">Organisation-scoped account access</h2>
          <span class="read-only-badge">read-only to system staff</span>
        </div>
        <p class="panel-desc">
          Authorized Cedar Health personnel with consignment governance, buyer procurement, or recipient authority.
        </p>

        <div class="table-container">
          <table>
            <thead>
              <tr>
                <th>Member</th>
                <th>Organisation role</th>
                <th>Account identifier</th>
                <th>Status</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>Salma Idris</td>
                <td>Cedar Health Customer Administrator</td>
                <td class="mono">salma.idris@cedarhealth.example</td>
                <td>
                  <span class="status-badge">
                    <span class="status-dot good"></span>
                    <span class="status-text-good">good active</span>
                  </span>
                </td>
              </tr>
              <tr>
                <td>Hana Youssef</td>
                <td>Cedar Health Buyer</td>
                <td class="mono">hana.youssef@cedarhealth.example</td>
                <td>
                  <span class="status-badge">
                    <span class="status-dot good"></span>
                    <span class="status-text-good">good active</span>
                  </span>
                </td>
              </tr>
              <tr>
                <td>Rania Karim</td>
                <td>Clinic Staff Receiver</td>
                <td class="mono">rania.karim@cedarhealth.example</td>
                <td>
                  <span class="status-badge">
                    <span class="status-dot good"></span>
                    <span class="status-text-good">good active</span>
                  </span>
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

      <!-- Saved Destination Addresses (Read-only for System Staff) -->
      <section class="panel">
        <div class="panel-header">
          <h2 class="section-title">Saved destination addresses</h2>
          <span class="read-only-badge">read-only to system staff</span>
        </div>
        <p class="panel-desc">
          Managed receiving clinic locations registered for cold-chain route delivery. Do not edit the customer's saved addresses here.
        </p>

        <div class="table-container">
          <table>
            <thead>
              <tr>
                <th>Facility unit</th>
                <th>Street address &amp; locality</th>
                <th>Delivery status</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><strong>Cedar Clinic</strong></td>
                <td>42 River Road, London</td>
                <td>
                  <span class="status-badge">
                    <span class="status-dot good"></span>
                    <span class="status-text-good">good primary delivery destination</span>
                  </span>
                </td>
              </tr>
              <tr>
                <td><strong>Cedar Day Unit</strong></td>
                <td>18 Elm Street, London</td>
                <td>
                  <span class="status-badge">
                    <span class="status-dot good"></span>
                    <span class="status-text-good">good secondary clinic unit</span>
                  </span>
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

    </div>
  </main>

</body>
</html>
