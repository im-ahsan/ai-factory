<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Delivery evidence</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@600;650&family=IBM+Plex+Mono:wght@400;500;600&family=Public+Sans:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      background-color: #F7F7F7;
      color: #202020;
      font-family: 'Public Sans', sans-serif;
      font-size: 16px;
      line-height: 1.5;
      -webkit-font-smoothing: antialiased;
    }

    h1, h2, h3, h4 {
      font-family: 'Hanken Grotesk', sans-serif;
    }

    .font-mono {
      font-family: 'IBM Plex Mono', monospace;
    }

    /* Header */
    .app-header {
      background-color: #FFFFFF;
      border-bottom: 1px solid #D5D5D5;
      height: 64px;
      padding: 0 32px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .header-left {
      display: flex;
      align-items: center;
      gap: 32px;
    }

    .brand-mark {
      display: flex;
      align-items: center;
      gap: 12px;
      text-decoration: none;
      color: #202020;
    }

    .brand-badge {
      width: 24px;
      height: 24px;
      background-color: #202020;
      color: #FFFFFF;
      font-family: 'Hanken Grotesk', sans-serif;
      font-weight: 650;
      font-size: 14px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 2px;
    }

    .brand-name {
      font-family: 'Hanken Grotesk', sans-serif;
      font-size: 18px;
      font-weight: 650;
      letter-spacing: -0.01em;
    }

    .main-nav {
      display: flex;
      align-items: center;
      gap: 24px;
    }

    .nav-link {
      font-family: 'Public Sans', sans-serif;
      font-size: 16px;
      font-weight: 500;
      color: #626262;
      text-decoration: none;
      padding: 20px 0;
      border-bottom: 2px solid transparent;
      transition: color 150ms ease, border-color 150ms ease;
    }

    .nav-link:hover {
      color: #202020;
    }

    .nav-link.active {
      color: #A94B1D;
      border-bottom-color: #A94B1D;
    }

    .header-right {
      display: flex;
      align-items: center;
      gap: 24px;
    }

    .user-profile {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .user-avatar {
      width: 32px;
      height: 32px;
      background-color: #F7F7F7;
      border: 1px solid #D5D5D5;
      color: #202020;
      font-family: 'IBM Plex Mono', monospace;
      font-size: 14px;
      font-weight: 600;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 2px;
    }

    .user-info {
      font-size: 16px;
      color: #202020;
    }

    .user-role {
      color: #626262;
    }

    .lang-switcher {
      font-size: 14px;
      color: #626262;
      border-left: 1px solid #D5D5D5;
      padding-left: 16px;
    }

    /* Main Container */
    .main-content {
      max-width: 1280px;
      margin: 0 auto;
      padding: 32px;
    }

    .page-title-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 32px;
    }

    h1.page-title {
      font-size: 28px;
      font-weight: 650;
      line-height: 1.2;
      letter-spacing: -0.01em;
    }

    .page-actions {
      display: flex;
      gap: 16px;
    }

    /* Buttons */
    .btn {
      height: 48px;
      padding: 0 24px;
      font-family: 'Public Sans', sans-serif;
      font-size: 16px;
      font-weight: 500;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      text-decoration: none;
      cursor: pointer;
      border-radius: 2px;
      transition: background-color 150ms ease, border-color 150ms ease, color 150ms ease, transform 90ms ease;
    }

    .btn:focus-visible {
      outline: 2px solid #A94B1D;
      outline-offset: 2px;
    }

    .btn:active {
      transform: scale(0.98);
    }

    .btn-secondary {
      background-color: #FFFFFF;
      border: 1px solid #D5D5D5;
      color: #202020;
    }

    .btn-secondary:hover {
      background-color: #F7F7F7;
      border-color: #202020;
    }

    /* Panel System */
    .panel {
      background-color: #FFFFFF;
      border: 1px solid #D5D5D5;
      border-radius: 2px;
      padding: 16px;
      margin-bottom: 32px;
    }

    /* Lead Summary Panel */
    .lead-panel {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 24px;
    }

    .lead-header-info {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .order-headline {
      font-size: 20px;
      font-weight: 650;
      display: flex;
      align-items: center;
      gap: 12px;
      flex-wrap: wrap;
    }

    .status-indicator {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: 16px;
      font-weight: 500;
    }

    .status-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      display: inline-block;
    }

    .status-good {
      color: #24704B;
    }
    .status-good .status-dot {
      background-color: #24704B;
    }

    .status-waiting {
      color: #805800;
    }
    .status-waiting .status-dot {
      background-color: #805800;
    }

    .status-refused {
      color: #AE2C2C;
    }
    .status-refused .status-dot {
      background-color: #AE2C2C;
    }

    .lead-meta-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 24px;
      margin-top: 16px;
      padding-top: 16px;
      border-top: 1px solid #D5D5D5;
    }

    .meta-item {
      display: flex;
      flex-direction: column;
      gap: 4px;
    }

    .meta-label {
      font-size: 14px;
      color: #626262;
    }

    .meta-value {
      font-size: 16px;
      color: #202020;
    }

    /* Evidence Layout: Large Inspection Area + Narrow Adjacent Column */
    .evidence-layout-grid {
      display: grid;
      grid-template-columns: 1fr 340px;
      gap: 32px;
      margin-bottom: 32px;
    }

    .section-title {
      font-size: 20px;
      font-weight: 650;
      line-height: 1.3;
      margin-bottom: 16px;
    }

    .evidence-card {
      background-color: #FFFFFF;
      border: 1px solid #D5D5D5;
      border-radius: 2px;
      padding: 16px;
      margin-bottom: 32px;
    }

    .evidence-image-container {
      width: 100%;
      border: 1px solid #D5D5D5;
      border-radius: 2px;
      overflow: hidden;
      background-color: #F7F7F7;
      margin-bottom: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .evidence-photo {
      width: 100%;
      aspect-ratio: 4 / 3;
      object-fit: cover;
      display: block;
      border-radius: 2px;
    }

    .signature-image {
      width: 100%;
      height: 200px;
      object-fit: contain;
      background-color: #FFFFFF;
      display: block;
      padding: 16px;
    }

    .evidence-caption {
      font-size: 14px;
      color: #626262;
      line-height: 1.4;
    }

    /* Narrow Column Detail List */
    .sidebar-panel {
      background-color: #FFFFFF;
      border: 1px solid #D5D5D5;
      border-radius: 2px;
      padding: 16px;
      display: flex;
      flex-direction: column;
      gap: 24px;
    }

    .data-group {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    .data-group:not(:last-child) {
      padding-bottom: 16px;
      border-bottom: 1px solid #D5D5D5;
    }

    .data-label {
      font-size: 14px;
      color: #626262;
    }

    .data-val {
      font-size: 16px;
      color: #202020;
    }

    /* Table System */
    .table-container {
      background-color: #FFFFFF;
      border: 1px solid #D5D5D5;
      border-radius: 2px;
      overflow: hidden;
      margin-bottom: 32px;
    }

    .table-header-block {
      padding: 16px;
      border-bottom: 1px solid #D5D5D5;
    }

    .evidence-table {
      width: 100%;
      border-collapse: collapse;
      text-align: left;
    }

    .evidence-table th {
      font-size: 14px;
      font-weight: 500;
      color: #626262;
      padding: 0 16px;
      height: 48px;
      background-color: #F7F7F7;
      border-bottom: 1px solid #D5D5D5;
    }

    .evidence-table td {
      font-size: 16px;
      color: #202020;
      padding: 0 16px;
      height: 48px;
      border-bottom: 1px solid #D5D5D5;
      vertical-align: middle;
    }

    .evidence-table tr:last-child td {
      border-bottom: none;
    }

    /* Motion Tokens and Animations */
    @keyframes entranceFadeUp {
      0% {
        opacity: 0;
        transform: translateY(8px);
      }
      100% {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes savedHandoff {
      0% {
        opacity: 0.6;
        transform: translateY(8px);
      }
      100% {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes syncBreathe {
      0%, 100% {
        opacity: 0.7;
      }
      50% {
        opacity: 1;
      }
    }

    .animate-entrance {
      animation: entranceFadeUp 260ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    .motion-saved-handoff {
      animation: savedHandoff 260ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    @media (prefers-reduced-motion: reduce) {
      *, ::before, ::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
      }
    }
  </style>
</head>
<body>

  <!-- Application Header -->
  <header class="app-header">
    <div class="header-left">
      <a href="#" class="brand-mark">
        <span class="brand-badge">M</span>
        <span class="brand-name">Meridian</span>
      </a>
      <nav class="main-nav">
        <a href="#" class="nav-link">Orders</a>
        <a href="#" class="nav-link active">Routes</a>
      </nav>
    </div>
    <div class="header-right">
      <div class="user-profile">
        <span class="user-avatar">PN</span>
        <span class="user-info">Priya Nair <span class="user-role">· Dispatcher</span></span>
      </div>
      <span class="lang-switcher">EN / العربية</span>
    </div>
  </header>

  <!-- Main Work Surface -->
  <main class="main-content animate-entrance">

    <!-- Page Title Row -->
    <div class="page-title-row">
      <h1 class="page-title">Delivery evidence</h1>
      <div class="page-actions">
        <a href="#" class="btn btn-secondary">Route detail</a>
      </div>
    </div>

    <!-- Lead Order Summary Panel -->
    <section class="panel">
      <div class="lead-panel">
        <div class="lead-header-info">
          <div class="order-headline">
            <span class="font-mono">O-290</span>
            <span>· Delivered</span>
            <span class="font-mono">13 May 10:14</span>
            <span>to Rania Karim, 20 packs</span>
            <span class="status-indicator status-good motion-saved-handoff">
              <span class="status-dot"></span>
              good
            </span>
          </div>
          <div class="meta-label">Consignment order reference and delivery handover record</div>
        </div>
      </div>

      <div class="lead-meta-grid">
        <div class="meta-item">
          <span class="meta-label">Destination</span>
          <span class="meta-value">Cedar Clinic</span>
          <span class="meta-label">42 River Road, London</span>
        </div>
        <div class="meta-item">
          <span class="meta-label">Delivery schedule</span>
          <span class="meta-value">Planned <span class="font-mono">13 May 10:00</span></span>
          <span class="meta-label">Handed <span class="font-mono">13 May 10:14</span></span>
        </div>
        <div class="meta-item">
          <span class="meta-label">Product & lot</span>
          <span class="meta-value">Insulin Glargine 100 units/mL</span>
          <span class="meta-label">Lot <span class="font-mono">IG-2509</span> (20 packs)</span>
        </div>
        <div class="meta-item">
          <span class="meta-label">Route & driver</span>
          <span class="meta-value">Route <span class="font-mono">R-201</span></span>
          <span class="meta-label">Tariq Mansour · <span class="font-mono">VAN-27</span> (<span class="font-mono">MTR-482</span>)</span>
        </div>
      </div>
    </section>

    <!-- Evidence Inspection & Narrow Column Layout -->
    <div class="evidence-layout-grid">

      <!-- Left Column: Primary Inspection Images -->
      <div>
        <!-- Photographic Proof Card -->
        <div class="evidence-card">
          <h2 class="section-title">Handover photograph</h2>
          <div class="evidence-image-container">
            <img src="https://lh3.googleusercontent.com/aida-public/AB6AXuCyt1HAwnKVsj63KI9aBLTGLQYbG8LAkqYn_jxdV8q1t_2Pz0v5t_kV05-MUoF-_FO0bOKaxBvLgIBj63oKD0Yjmv1hww7xQS-HM1fjnPTWws4wyC1T6k_5H4GMFQEM2HPd4wy3zQ3mE8lmnmy0WFEopWI-obXXPSwRdkTjIYqfnxxrNrYbzEpAMGBhyyvxN5ryn4OuP2RdkqRiCt9F2y7aTD3Ye7bswb8SqC9cvr3hiUtMsxoUJVV2UKU7VRqA1WxrliprnaMM4Rk" alt="Handover photograph at Cedar Clinic reception desk" class="evidence-photo">
          </div>
          <p class="evidence-caption">
            Photographic proof captured at handover: courier Tariq Mansour presenting insulated medical shipper consignment to clinic staff receiver Rania Karim at Cedar Clinic reception desk, 42 River Road, London.
          </p>
        </div>

        <!-- Captured Handwritten Signature Card -->
        <div class="evidence-card">
          <h2 class="section-title">Captured handwritten signature</h2>
          <div class="evidence-image-container">
            <img src="https://lh3.googleusercontent.com/aida/AEtjO1XiQLF9k7--ur6fSrB4z8X35Xb_0CF91XnAx78dvWbIWxfGuWWv_C5b7kSAqb9AOaOad6ECNuELUlXi-TRCpqYEpKz9h6xL6lB1odvG1QDdVhbERGDyqdQR-U-TeXucGiUxtESx4T_fzuuwfR2X6dtBjt1fxug1xivZWM8GyzvJFjb_biMdo9dHJiJQ5Ck9alqBebc37DzWxu-ocF9cdvw6vo7xnv6ZHHT7OHJN1kqO0XXQBfms6H8CemY" alt="Captured ink signature of receiver Rania Karim" class="signature-image">
          </div>
          <p class="evidence-caption">
            Handwritten biometric signature captured on handheld terminal at time of consignment release by authorized receiver Rania Karim.
          </p>
        </div>
      </div>

      <!-- Right Column: Narrow Adjacent Metadata -->
      <aside>
        <div class="sidebar-panel">
          <div class="data-group">
            <span class="data-label">Receiver name</span>
            <span class="data-val">Rania Karim</span>
          </div>

          <div class="data-group">
            <span class="data-label">Delivery location</span>
            <span class="data-val">Cedar Clinic</span>
            <span class="meta-label">42 River Road, London</span>
          </div>

          <div class="data-group">
            <span class="data-label">Evidence availability period</span>
            <span class="data-val">7-year evidence availability</span>
            <span class="meta-label">Retained through <span class="font-mono">13 May 2033</span> under cold chain compliance mandate</span>
          </div>

          <div class="data-group">
            <span class="data-label">Certificate release</span>
            <span class="data-val">Certificate versions 1 and 2</span>
            <span class="meta-label">Version 2 appended with late readings reconciliation</span>
          </div>

          <div class="data-group">
            <span class="data-label">Quality assurance context</span>
            <span class="data-val"><span class="font-mono">Q-89</span> under review</span>
            <span class="meta-label">Corrected readings after completed <span class="font-mono">O-290</span> delivery</span>
          </div>

          <div class="data-group">
            <span class="data-label">Dispatch origin</span>
            <span class="data-val">North Quay Warehouse</span>
            <span class="meta-label">Cold Room C2, Rack 4</span>
          </div>

          <div class="data-group">
            <span class="data-label">Transit vehicle</span>
            <span class="data-val"><span class="font-mono">VAN-27</span> · <span class="font-mono">MTR-482</span></span>
            <span class="meta-label">Refrigerated courier van · Profile v3</span>
          </div>

          <div class="data-group">
            <span class="data-label">Refusal status</span>
            <span class="data-val">No refusal recorded</span>
            <span class="meta-label">Consignment accepted in full (20/20 packs)</span>
          </div>
        </div>
      </aside>

    </div>

    <!-- Per-Box Quantities & Refusal Information Table -->
    <section class="table-container">
      <div class="table-header-block">
        <h2 class="section-title" style="margin-bottom: 4px;">Per-box quantities and refusal information</h2>
        <span class="meta-label">Shipper box breakdown, allocated pack counts, returned telemetry and refusal verification</span>
      </div>

      <table class="evidence-table">
        <thead>
          <tr>
            <th>Box</th>
            <th>Shipper specification</th>
            <th>Delivered packs</th>
            <th>Lot number</th>
            <th>Handover time</th>
            <th>Refusal status</th>
            <th>Returned status</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td class="font-mono">B-691</td>
            <td>BioTherm Insulated Shipper 12L</td>
            <td><span class="font-mono">10</span> packs</td>
            <td class="font-mono">IG-2509</td>
            <td class="font-mono">13 May 10:14</td>
            <td>None (accepted)</td>
            <td>
              <span class="status-indicator status-good">
                <span class="status-dot"></span>
                good
              </span>
            </td>
          </tr>
          <tr>
            <td class="font-mono">B-692</td>
            <td>BioTherm Insulated Shipper 12L</td>
            <td><span class="font-mono">10</span> packs</td>
            <td class="font-mono">IG-2509</td>
            <td class="font-mono">13 May 10:14</td>
            <td>None (accepted)</td>
            <td>
              <span class="status-indicator status-good">
                <span class="status-dot"></span>
                good
              </span>
            </td>
          </tr>
        </tbody>
      </table>
    </section>

  </main>

</body>
</html>
