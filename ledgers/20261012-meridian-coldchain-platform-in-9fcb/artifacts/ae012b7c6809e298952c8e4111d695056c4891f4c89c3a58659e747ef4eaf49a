<!DOCTYPE html>

<html lang="en"><head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<title>Pack box</title>
<link href="https://fonts.googleapis.com" rel="preconnect"/>
<link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect"/>
<link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@600;650;700&amp;family=IBM+Plex+Mono:wght@400;500;600&amp;family=Public+Sans:wght@400;500;600&amp;display=swap" rel="stylesheet"/>
<style>
    /* Design system motion tokens */
    :root {
      --motion-duration-instant: 90ms;
      --motion-duration-short: 140ms;
      --motion-duration-standard: 220ms;
      --motion-duration-enter: 280ms;
      --motion-duration-complex: 360ms;
      --motion-ease-standard: cubic-bezier(0.2, 0, 0, 1);
      --motion-ease-decelerate: cubic-bezier(0, 0, 0.2, 1);
      --motion-ease-accelerate: cubic-bezier(0.3, 0, 1, 1);
      --motion-ease-spring: cubic-bezier(0.34, 1.3, 0.64, 1);
    }

    /* Reset & baseline */
    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      background-color: #F7F7F7;
      color: #202020;
      font-family: 'Public Sans', sans-serif;
      font-size: 16px;
      line-height: 1.5;
      -webkit-font-smoothing: antialiased;
      min-height: 100vh;
    }

    /* Typography tokens */
    h1, h2, h3, .font-heading {
      font-family: 'Hanken Grotesk', sans-serif;
    }

    .font-mono {
      font-family: 'IBM Plex Mono', monospace;
    }

    .text-quieter {
      color: #626262;
    }

    /* Keyframes for page entrance sequence */
    @keyframes motionEnter {
      from {
        opacity: 0;
        transform: translateY(8px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    /* Staggered entrance animation applied to sections/cards down the page */
    .site-header {
      animation: motionEnter var(--motion-duration-enter) var(--motion-ease-decelerate) both;
      animation-delay: 0ms;
    }

    .page-title {
      animation: motionEnter var(--motion-duration-enter) var(--motion-ease-decelerate) both;
      animation-delay: 40ms;
    }

    .panel-stagger-1 {
      animation: motionEnter var(--motion-duration-enter) var(--motion-ease-decelerate) both;
      animation-delay: 80ms;
    }

    .panel-stagger-2 {
      animation: motionEnter var(--motion-duration-enter) var(--motion-ease-decelerate) both;
      animation-delay: 130ms;
    }

    .panel-stagger-3 {
      animation: motionEnter var(--motion-duration-enter) var(--motion-ease-decelerate) both;
      animation-delay: 180ms;
    }

    .panel-stagger-4 {
      animation: motionEnter var(--motion-duration-enter) var(--motion-ease-decelerate) both;
      animation-delay: 230ms;
    }

    /* Interactive control states */
    /* Links & navigation items */
    a, .nav-link, .brand-mark, .lang-switch {
      transition: color var(--motion-duration-short) var(--motion-ease-standard),
                  background-color var(--motion-duration-short) var(--motion-ease-standard),
                  border-color var(--motion-duration-short) var(--motion-ease-standard),
                  transform var(--motion-duration-instant) var(--motion-ease-standard),
                  box-shadow var(--motion-duration-short) var(--motion-ease-standard);
    }

    a:focus-visible, .nav-link:focus-visible, .lang-switch:focus-visible {
      outline: 2px solid #A94B1D;
      outline-offset: 2px;
    }

    a:active:not([disabled]), .nav-link:active {
      transform: scale(0.98);
    }

    /* Buttons */
    button, .btn-primary, .btn-secondary {
      transition: all var(--motion-duration-short) var(--motion-ease-standard);
    }

    button:focus-visible, .btn-primary:focus-visible, .btn-secondary:focus-visible {
      outline: 2px solid #A94B1D;
      outline-offset: 2px;
    }

    button:active:not(:disabled), .btn-primary:active:not(:disabled), .btn-secondary:active:not(:disabled) {
      transform: scale(0.97);
    }

    /* Disabled/read-only buttons */
    button:disabled, .btn-primary:disabled {
      cursor: not-allowed;
      opacity: 0.65;
      transform: none !important;
    }

    button:disabled:hover, .btn-primary:disabled:hover {
      transform: none !important;
    }

    /* Text inputs, select inputs, readonly input boxes */
    input, select, .field-input {
      transition: border-color var(--motion-duration-short) var(--motion-ease-standard),
                  box-shadow var(--motion-duration-short) var(--motion-ease-standard);
    }

    input:hover, select:hover, .field-input:hover {
      border-color: #A94B1D;
    }

    input:focus, select:focus, .field-input:focus, input:focus-visible, select:focus-visible, .field-input:focus-visible {
      outline: none;
      border-color: #A94B1D;
      box-shadow: 0 0 0 3px rgba(169, 75, 29, 0.15);
    }

    .field-input.read-only:hover, .field-input:read-only:hover, .field-input:disabled:hover {
      border-color: #C0C0C0;
    }

    .field-input.read-only:focus, .field-input:read-only:focus, .field-input:disabled:focus {
      outline: none;
      border-color: #A94B1D;
      box-shadow: 0 0 0 3px rgba(169, 75, 29, 0.15);
    }

    /* Accessibility: Reduced motion preference */
    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
      }
    }

    /* Header styling */
    .site-header {
      background: #FFFFFF;
      border-bottom: 1px solid #D5D5D5;
      height: 64px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 32px;
    }

    .header-left {
      display: flex;
      align-items: center;
      gap: 32px;
    }

    .brand-mark {
      display: flex;
      align-items: center;
      gap: 12px;
      text-decoration: none;
      color: #202020;
    }

    .brand-mark:hover .brand-title {
      color: #A94B1D;
    }

    .brand-box {
      width: 28px;
      height: 28px;
      background: #202020;
      color: #FFFFFF;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: 'Hanken Grotesk', sans-serif;
      font-weight: 700;
      font-size: 15px;
      border-radius: 2px;
    }

    .brand-title {
      font-family: 'Hanken Grotesk', sans-serif;
      font-size: 18px;
      font-weight: 700;
      letter-spacing: -0.01em;
      transition: color var(--motion-duration-short) var(--motion-ease-standard);
    }

    .main-nav {
      display: flex;
      align-items: center;
      gap: 24px;
    }

    .nav-link {
      font-size: 15px;
      color: #626262;
      text-decoration: none;
      font-weight: 500;
      padding: 20px 0;
      border-bottom: 2px solid transparent;
      display: inline-block;
    }

    .nav-link:hover {
      color: #202020;
    }

    .nav-link.active {
      color: #202020;
      font-weight: 600;
      border-bottom: 2px solid #A94B1D;
    }

    .header-right {
      display: flex;
      align-items: center;
      gap: 24px;
      font-size: 14px;
    }

    .operator-profile {
      display: flex;
      align-items: center;
      gap: 8px;
      color: #202020;
    }

    .avatar-initials {
      width: 28px;
      height: 28px;
      background: #EAEAEA;
      color: #202020;
      border-radius: 2px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: 'IBM Plex Mono', monospace;
      font-size: 12px;
      font-weight: 600;
    }

    .lang-switch {
      color: #626262;
      font-size: 14px;
      cursor: pointer;
    }

    .lang-switch:hover {
      color: #202020;
    }

    /* Main layout container */
    .main-content {
      max-width: 1240px;
      margin: 0 auto;
      padding: 32px 32px 48px;
    }

    .page-title {
      font-size: 28px;
      font-weight: 650;
      line-height: 1.2;
      margin-bottom: 24px;
      letter-spacing: -0.02em;
    }

    /* Panels & rules */
    .panel {
      background: #FFFFFF;
      border: 1px solid #D5D5D5;
      border-radius: 2px;
      padding: 24px;
      margin-bottom: 32px;
    }

    .panel-header {
      margin-bottom: 20px;
    }

    .panel-heading {
      font-size: 20px;
      font-weight: 650;
      line-height: 1.3;
      letter-spacing: -0.01em;
    }

    /* Grid layout for form and photograph */
    .form-photo-grid {
      display: grid;
      grid-template-columns: 1fr 380px;
      gap: 32px;
      align-items: start;
    }

    .form-fields-col {
      display: flex;
      flex-direction: column;
      gap: 20px;
    }

    .field-group {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .field-label {
      font-size: 14px;
      font-weight: 500;
      color: #626262;
    }

    .field-input {
      height: 48px;
      border: 1px solid #D5D5D5;
      border-radius: 2px;
      background: #FFFFFF;
      padding: 0 16px;
      font-size: 16px;
      color: #202020;
      width: 100%;
    }

    .field-input.read-only,
    .field-input:read-only,
    .field-input:disabled {
      background: #F7F7F7;
      color: #202020;
      cursor: default;
    }

    .two-col-fields {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px;
    }

    /* Status indicators */
    .status-text {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-size: 14px;
      font-weight: 600;
    }

    .status-text.good {
      color: #24704B;
    }

    .status-text.waiting {
      color: #805800;
    }

    .status-text.failed {
      color: #AE2C2C;
    }

    .status-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      display: inline-block;
    }

    .status-dot.good {
      background-color: #24704B;
    }

    .status-dot.waiting {
      background-color: #805800;
    }

    .status-dot.failed {
      background-color: #AE2C2C;
    }

    /* Photo column styling */
    .photo-col {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .shipper-image-wrapper {
      width: 100%;
      aspect-ratio: 4 / 3;
      border: 1px solid #D5D5D5;
      border-radius: 2px;
      overflow: hidden;
      background: #FFFFFF;
    }

    .shipper-image-wrapper img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .photo-caption {
      font-size: 14px;
      color: #626262;
      line-height: 1.4;
    }

    /* Action bar with irreversible primary seal */
    .seal-action-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding-top: 24px;
      border-top: 1px solid #D5D5D5;
      margin-top: 8px;
    }

    .seal-button-group {
      display: flex;
      align-items: center;
      gap: 16px;
    }

    .btn-primary {
      height: 48px;
      padding: 0 24px;
      background-color: #A94B1D;
      color: #FFFFFF;
      font-family: 'Public Sans', sans-serif;
      font-weight: 600;
      font-size: 16px;
      border: none;
      border-radius: 2px;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }

    .btn-primary:hover:not(:disabled) {
      background-color: #933E15;
    }

    .btn-primary:disabled {
      background-color: #E0E0E0;
      color: #888888;
      cursor: not-allowed;
    }

    .btn-secondary {
      height: 48px;
      padding: 0 24px;
      background-color: #FFFFFF;
      color: #202020;
      font-family: 'Public Sans', sans-serif;
      font-weight: 600;
      font-size: 16px;
      border: 1px solid #D5D5D5;
      border-radius: 2px;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }

    .btn-secondary:hover {
      background-color: #F7F7F7;
    }

    .irreversible-notice {
      font-size: 14px;
      color: #626262;
      font-style: normal;
    }

    /* Structured data table */
    .records-table {
      width: 100%;
      border-collapse: collapse;
      text-align: left;
    }

    .records-table th {
      font-size: 14px;
      font-weight: 500;
      color: #626262;
      padding: 12px 16px;
      border-bottom: 1px solid #D5D5D5;
      height: 48px;
    }

    .records-table td {
      font-size: 15px;
      color: #202020;
      padding: 12px 16px;
      border-bottom: 1px solid #D5D5D5;
      height: 48px;
      vertical-align: middle;
    }

    .records-table tr:last-child td {
      border-bottom: none;
    }

    /* Key-value details grid */
    .details-summary-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 24px;
      padding: 16px 0;
    }

    .detail-item {
      display: flex;
      flex-direction: column;
      gap: 4px;
    }

    .detail-label {
      font-size: 14px;
      color: #626262;
    }

    .detail-value {
      font-size: 16px;
      font-weight: 500;
      color: #202020;
    }
  </style>
</head>
<body>
<!-- Standard Header -->
<header class="site-header">
<div class="header-left">
<a class="brand-mark" href="#">
<div class="brand-box">M</div>
<span class="brand-title">Meridian</span>
</a>
<nav class="main-nav">
<a class="nav-link" href="#">Receipts</a>
<a class="nav-link" href="#">Stock</a>
