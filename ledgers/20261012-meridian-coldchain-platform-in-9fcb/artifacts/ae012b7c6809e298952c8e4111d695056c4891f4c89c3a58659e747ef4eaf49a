</div>
<div class="detail-item">
<span class="detail-label">Order consignment status</span>
<span class="detail-value">
<span class="status-text good">
<span class="status-dot good"></span>
              good
            </span>
</span>
</div>
<div class="detail-item">
<span class="detail-label">Stock eligibility</span>
<span class="detail-value">
<span class="status-text good">
<span class="status-dot good"></span>
              good
            </span>
</span>
</div>
</div>
</section>
</main>
