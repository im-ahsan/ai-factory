<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Receipt detail — Meridian</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@600;650;700&family=IBM+Plex+Mono:wght@400;500;600&family=Public+Sans:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    /* CSS Reset & Base */
    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      background-color: #F7F7F7;
      color: #202020;
      font-family: 'Public Sans', sans-serif;
      font-size: 16px;
      line-height: 1.5;
      -webkit-font-smoothing: antialiased;
    }

    /* Typography */
    h1, .h1 {
      font-family: 'Hanken Grotesk', sans-serif;
      font-size: 28px;
      font-weight: 650;
      line-height: 1.25;
      color: #202020;
    }

    h2, .h2 {
      font-family: 'Hanken Grotesk', sans-serif;
      font-size: 20px;
      font-weight: 650;
      line-height: 1.3;
      color: #202020;
    }

    h3, .h3 {
      font-family: 'Hanken Grotesk', sans-serif;
      font-size: 16px;
      font-weight: 600;
      line-height: 1.4;
      color: #202020;
    }

    .mono {
      font-family: 'IBM Plex Mono', monospace;
    }

    .text-quiet {
      color: #626262;
    }

    .text-sm {
      font-size: 14px;
    }

    /* Semantic Status Colors */
    .status-good {
      color: #24704B;
    }
    .status-waiting {
      color: #805800;
    }
    .status-refused {
      color: #AE2C2C;
    }

    .dot-status {
      display: inline-block;
      width: 8px;
      height: 8px;
      border-radius: 50%;
      margin-right: 6px;
      vertical-align: middle;
    }
    .dot-waiting {
      background-color: #805800;
    }
    .dot-good {
      background-color: #24704B;
    }
    .dot-refused {
      background-color: #AE2C2C;
    }

    /* Header */
    .app-header {
      background-color: #FFFFFF;
      border-bottom: 1px solid #D5D5D5;
      height: 64px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 32px;
      position: sticky;
      top: 0;
      z-index: 50;
    }

    .header-left {
      display: flex;
      align-items: center;
      gap: 32px;
    }

    .brand-mark {
      display: flex;
      align-items: center;
      gap: 12px;
      text-decoration: none;
      color: #202020;
    }

    .brand-logo {
      width: 28px;
      height: 28px;
      background-color: #202020;
      color: #FFFFFF;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: 'Hanken Grotesk', sans-serif;
      font-weight: 700;
      font-size: 16px;
      border-radius: 2px;
    }

    .brand-title {
      font-family: 'Hanken Grotesk', sans-serif;
      font-size: 18px;
      font-weight: 700;
      letter-spacing: -0.01em;
    }

    .nav-menu {
      display: flex;
      align-items: center;
      gap: 24px;
      height: 64px;
    }

    .nav-item {
      text-decoration: none;
      color: #626262;
      font-size: 15px;
      font-weight: 500;
      height: 64px;
      display: flex;
      align-items: center;
      border-bottom: 2px solid transparent;
      transition: color 150ms ease, border-color 150ms ease;
    }

    .nav-item:hover {
      color: #202020;
    }

    .nav-item:focus-visible {
      outline: 2px solid #A94B1D;
      outline-offset: -2px;
    }

    .nav-item.active {
      color: #A94B1D;
      border-bottom-color: #A94B1D;
      font-weight: 600;
    }

    .header-right {
      display: flex;
      align-items: center;
      gap: 24px;
    }

    .user-profile {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .user-avatar {
      width: 32px;
      height: 32px;
      background-color: #F7F7F7;
      border: 1px solid #D5D5D5;
      border-radius: 2px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 12px;
      font-weight: 600;
      color: #202020;
    }

    .user-meta {
      font-size: 14px;
      color: #202020;
    }

    .user-meta span {
      color: #626262;
    }

    .lang-switcher {
      font-size: 14px;
      color: #202020;
      border-left: 1px solid #D5D5D5;
      padding-left: 16px;
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .lang-link {
      text-decoration: none;
      color: #202020;
      font-weight: 500;
    }
    .lang-link:focus-visible {
      outline: 2px solid #A94B1D;
    }

    /* Layout & Main */
    .main-container {
      max-width: 1360px;
      margin: 0 auto;
      padding: 32px;
      display: flex;
      flex-direction: column;
      gap: 32px;
    }

    /* Page Header */
    .page-title-row {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .headline-badges {
      display: flex;
      align-items: center;
      gap: 16px;
      font-size: 16px;
    }

    .headline-badges .lot-tag {
      font-weight: 600;
      color: #202020;
    }

    /* Panel & Cards */
    .panel {
      background-color: #FFFFFF;
      border: 1px solid #D5D5D5;
      border-radius: 2px;
      padding: 24px;
    }

    .panel-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 20px;
    }

    /* Top Overview Grid */
    .overview-grid {
      display: grid;
      grid-template-columns: 280px 1fr;
      gap: 24px;
      background-color: #FFFFFF;
      border: 1px solid #D5D5D5;
      border-radius: 2px;
      padding: 24px;
    }

    .product-photo-wrap {
      width: 100%;
      aspect-ratio: 4/3;
      overflow: hidden;
      border-radius: 2px;
      border: 1px solid #D5D5D5;
      background-color: #F7F7F7;
    }

    .product-photo {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .specs-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      row-gap: 20px;
      column-gap: 24px;
      align-content: start;
    }

    .spec-item {
      display: flex;
      flex-direction: column;
      gap: 4px;
    }

    .spec-label {
      font-size: 14px;
      color: #626262;
    }

    .spec-value {
      font-size: 16px;
      color: #202020;
      font-weight: 500;
    }

    /* Temperature Section */
    .chart-container-layout {
      display: grid;
      grid-template-columns: 1fr 64px; /* Narrow quiet margin beside chart on desktop */
      gap: 0;
    }

    .chart-box {
      border: 1px solid #D5D5D5;
      border-radius: 2px;
      background-color: #FFFFFF;
      padding: 20px 24px 16px 20px;
    }

    .chart-svg {
      width: 100%;
      height: 240px;
      display: block;
    }

    .chart-legend {
      display: flex;
      align-items: center;
      gap: 24px;
      margin-top: 16px;
      padding-top: 12px;
      border-top: 1px solid #D5D5D5;
      font-size: 14px;
    }

    .legend-item {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .legend-swatch {
      width: 14px;
      height: 4px;
      border-radius: 1px;
    }

    /* Readings Table */
    .table-container {
      width: 100%;
      overflow-x: auto;
      border: 1px solid #D5D5D5;
      border-radius: 2px;
      background-color: #FFFFFF;
      margin-top: 20px;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      text-align: left;
    }

    th {
      height: 48px;
      padding: 0 16px;
      font-size: 14px;
      font-weight: 600;
      color: #626262;
      border-bottom: 1px solid #D5D5D5;
      background-color: #FFFFFF;
    }

    td {
      height: 48px;
      padding: 0 16px;
      font-size: 15px;
      border-bottom: 1px solid #D5D5D5;
      color: #202020;
    }

    tr:last-child td {
      border-bottom: none;
    }

    /* Handling Units & Tier Budget */
    .hu-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 24px;
    }

    .hu-card {
      border: 1px solid #D5D5D5;
      border-radius: 2px;
      background-color: #FFFFFF;
      padding: 20px;
    }

    .hu-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 16px;
      padding-bottom: 12px;
      border-bottom: 1px solid #D5D5D5;
    }

    .hu-title-group {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .hu-link {
      color: #202020;
      text-decoration: underline;
      text-underline-offset: 4px;
      font-weight: 600;
      font-size: 16px;
    }

    .hu-link:hover {
      color: #A94B1D;
    }

    .hu-link:focus-visible {
      outline: 2px solid #A94B1D;
      outline-offset: 2px;
    }

    .breakdown-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 8px 0;
      font-size: 14px;
      border-bottom: 1px solid #F7F7F7;
    }
    .breakdown-row:last-child {
      border-bottom: none;
    }

    .tier-budget-box {
      margin-top: 16px;
      padding: 14px;
      background-color: #F7F7F7;
      border: 1px solid #D5D5D5;
      border-radius: 2px;
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .budget-bar-bg {
      width: 100%;
      height: 8px;
      background-color: #D5D5D5;
      border-radius: 2px;
      overflow: hidden;
    }

    .budget-bar-fill {
      height: 100%;
      background-color: #805800;
    }

    /* Upload & Outcomes Section */
    .upload-layout {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 24px;
    }

    .upload-card {
      border: 1px solid #D5D5D5;
      border-radius: 2px;
      padding: 20px;
      background-color: #FFFFFF;
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    .upload-outcome {
      border: 1px solid #D5D5D5;
      border-radius: 2px;
      padding: 14px 16px;
      background-color: #F7F7F7;
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    /* Buttons & Fields */
    .btn {
      height: 48px;
      padding: 0 20px;
      border-radius: 2px;
      font-family: 'Public Sans', sans-serif;
      font-size: 16px;
      font-weight: 600;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      text-decoration: none;
      transition: background-color 150ms ease, border-color 150ms ease, color 150ms ease, transform 100ms ease;
    }

    .btn:active {
      transform: translateY(1px);
    }

    .btn:focus-visible {
      outline: 2px solid #A94B1D;
      outline-offset: 2px;
    }

    .btn-primary {
      background-color: #A94B1D;
      color: #FFFFFF;
      border: 1px solid #A94B1D;
    }

    .btn-primary:hover {
      background-color: #933f17;
      border-color: #933f17;
    }

    .btn-secondary {
      background-color: #FFFFFF;
      color: #202020;
      border: 1px solid #D5D5D5;
    }

    .btn-secondary:hover {
      background-color: #F7F7F7;
      border-color: #626262;
    }

    .file-input-display {
      height: 48px;
      border: 1px dashed #D5D5D5;
      border-radius: 2px;
      background-color: #FFFFFF;
      display: flex;
      align-items: center;
      padding: 0 16px;
      gap: 12px;
      cursor: pointer;
      color: #626262;
      font-size: 14px;
      transition: border-color 150ms ease;
    }

    .file-input-display:hover {
      border-color: #626262;
      color: #202020;
    }

    .file-input-display:focus-visible {
      outline: 2px solid #A94B1D;
    }

    /* Motion Tokens and Animations */
    @keyframes entranceFadeIn {
      0% {
        opacity: 0;
        transform: translateY(6px);
      }
      100% {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes savedHandoff {
      0% {
        opacity: 0.6;
        transform: translateY(8px);
      }
      100% {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes waitingBreathe {
      0%, 100% {
        opacity: 0.7;
      }
      50% {
        opacity: 1;
      }
    }

    .entrance-animate {
      animation: entranceFadeIn 280ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    .handoff-animate {
      animation: savedHandoff 260ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    .sync-breathe {
      animation: waitingBreathe 6s ease-in-out infinite;
    }

    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
      }
    }
  </style>
</head>
<body>

  <!-- Top App Navigation Header -->
  <header class="app-header">
    <div class="header-left">
      <a href="#" class="brand-mark">
        <div class="brand-logo">M</div>
        <span class="brand-title">Meridian</span>
      </a>
      <nav class="nav-menu" aria-label="Main Navigation">
        <a href="#" class="nav-item active">Receipts</a>
        <a href="#" class="nav-item">Stock</a>
        <a href="#" class="nav-item">Moves</a>
        <a href="#" class="nav-item">Boxes</a>
        <a href="#" class="nav-item">Cold rooms</a>
      </nav>
    </div>
    <div class="header-right">
      <div class="user-profile">
        <div class="user-avatar">LH</div>
        <div class="user-meta">Leila Haddad <span>· Warehouse Operator</span></div>
      </div>
      <div class="lang-switcher">
        <a href="#" class="lang-link">EN</a>
        <span class="text-quiet">/</span>
        <a href="#" class="lang-link">العربية</a>
      </div>
    </div>
  </header>

  <!-- Main Work Surface -->
  <main class="main-container entrance-animate">
    
    <!-- Page Title & High-level Status -->
    <div class="page-title-row">
      <h1>Receipt detail</h1>
      <div class="headline-badges">
        <span class="lot-tag mono">IG-2511</span>
        <span class="text-quiet">·</span>
        <span><strong class="mono">120</strong> packs</span>
        <span class="text-quiet">·</span>
        <span class="status-waiting handoff-animate">
          <span class="dot-status dot-waiting sync-breathe"></span>Quarantined
        </span>
      </div>
    </div>

    <!-- Product Overview & Receipt Meta Panel -->
    <section class="overview-grid" aria-labelledby="receipt-meta-title">
      <div class="product-photo-wrap">
        <img 
          src="https://lh3.googleusercontent.com/aida/AEtjO1WgSPshUkFcZmvnxOy3H7uPFO7vnua31jEAabBdx4WfRYInoVBclaBYzr6EOTkCWFqGsJS1uhjgOZkjwXnc6tXok5_V7hnJD71fMFpVOQvB0xDilugRi-So3x2iuqG8mhzrhcPOXs_uaNz4_YRLSzRonyj7WTjf5nSvwTo_MrbJYO2Vuwzuzgh5Zyao9k4Tvi2zu6Rzpy9-qzR1Cr9NTtD1_aXoZOH7xfrp2HTEKJUlFP5vifyhiJqQhA" 
          alt="Insulin Glargine 100 units/mL pack of 10 pens" 
          class="product-photo"
        />
      </div>
      <div>
        <h2 id="receipt-meta-title" class="h3 text-quiet" style="margin-bottom: 16px;">Product and consignment specification</h2>
        <div class="specs-grid">
          <div class="spec-item">
            <span class="spec-label">Product</span>
            <span class="spec-value">Insulin Glargine 100 units/mL</span>
            <span class="text-sm text-quiet">pack of 10 pens</span>
          </div>
          <div class="spec-item">
            <span class="spec-label">Lot number</span>
            <span class="spec-value mono">IG-2511</span>
          </div>
          <div class="spec-item">
            <span class="spec-label">Expiry date</span>
            <span class="spec-value mono">31 March 2027</span>
          </div>
          <div class="spec-item">
            <span class="spec-label">Warehouse location</span>
            <span class="spec-value">North Quay · C2 Rack 4</span>
          </div>
          <div class="spec-item">
            <span class="spec-label">Supplier</span>
            <span class="spec-value">Sanofi Pasteur UK</span>
          </div>
          <div class="spec-item">
            <span class="spec-label">Receipt date & time</span>
            <span class="spec-value mono">14 May 2026 08:00</span>
          </div>
          <div class="spec-item">
            <span class="spec-label">Created by</span>
            <span class="spec-value">Leila Haddad</span>
          </div>
          <div class="spec-item">
            <span class="spec-label">Last changed</span>
            <span class="spec-value mono">14 May 2026 08:30</span>
          </div>
          <div class="spec-item">
            <span class="spec-label">Cold chain profile</span>
            <span class="spec-value">profile v3 (permitted 2–8°C)</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Inbound Temperature Chart & Table -->
    <section class="panel" aria-labelledby="temp-section-title">
      <div class="panel-header">
        <div>
          <h2 id="temp-section-title" class="h2">Inbound temperature profile</h2>
          <p class="text-sm text-quiet" style="margin-top: 4px;">Permitted threshold 2.0°C – 8.0°C · First upper tier >8.0°C – 10.0°C (30-minute allowance)</p>
        </div>
        <div class="text-sm">
          <span class="text-quiet">Profile state: </span>
          <span class="status-waiting">HU-82 excursion logged</span>
        </div>
      </div>

      <!-- Desktop Chart Layout with Quiet Narrow Margin -->
      <div class="chart-container-layout">
        <div class="chart-box">
          <svg class="chart-svg" viewBox="0 0 1000 240" fill="none" xmlns="http://www.w3.org/2000/svg" aria-label="Temperature readings graph">
            <!-- Background bands -->
            <!-- Allowed zone 2°C to 8°C (y: 160 to 70) -->
            <rect x="60" y="70" width="910" height="90" fill="#24704B" fill-opacity="0.05" />
            <!-- Upper tier >8°C to 10°C (y: 70 to 40) -->
            <rect x="60" y="40" width="910" height="30" fill="#805800" fill-opacity="0.08" />

            <!-- Horizontal Grid lines & Labels -->
            <!-- 12°C -->
            <line x1="60" y1="20" x2="970" y2="20" stroke="#D5D5D5" stroke-dasharray="2 2" stroke-width="1" />
            <text x="48" y="24" font-family="IBM Plex Mono" font-size="12" fill="#626262" text-anchor="end">12°C</text>

            <!-- 10°C (Upper tier ceiling) -->
            <line x1="60" y1="40" x2="970" y2="40" stroke="#805800" stroke-width="1" stroke-dasharray="4 4" />
            <text x="48" y="44" font-family="IBM Plex Mono" font-size="12" fill="#805800" text-anchor="end">10°C</text>

            <!-- 8°C (Permitted ceiling) -->
            <line x1="60" y1="70" x2="970" y2="70" stroke="#24704B" stroke-width="1" stroke-dasharray="4 4" />
            <text x="48" y="74" font-family="IBM Plex Mono" font-size="12" fill="#24704B" text-anchor="end">8°C</text>

            <!-- 5°C (Baseline) -->
            <line x1="60" y1="115" x2="970" y2="115" stroke="#D5D5D5" stroke-width="1" />
            <text x="48" y="119" font-family="IBM Plex Mono" font-size="12" fill="#626262" text-anchor="end">5°C</text>

            <!-- 2°C (Permitted floor) -->
            <line x1="60" y1="160" x2="970" y2="160" stroke="#24704B" stroke-width="1" stroke-dasharray="4 4" />
            <text x="48" y="164" font-family="IBM Plex Mono" font-size="12" fill="#24704B" text-anchor="end">2°C</text>

            <!-- 0°C (Floor) -->
            <line x1="60" y1="190" x2="970" y2="190" stroke="#D5D5D5" stroke-width="1" />
            <text x="48" y="194" font-family="IBM Plex Mono" font-size="12" fill="#626262" text-anchor="end">0°C</text>

            <!-- Time vertical markers & labels -->
            <!-- 04:00 -->
            <line x1="120" y1="20" x2="120" y2="195" stroke="#D5D5D5" stroke-width="1" />
            <text x="120" y="215" font-family="IBM Plex Mono" font-size="12" fill="#626262" text-anchor="middle">04:00</text>

            <!-- 05:00 -->
            <line x1="260" y1="20" x2="260" y2="195" stroke="#D5D5D5" stroke-width="1" />
            <text x="260" y="215" font-family="IBM Plex Mono" font-size="12" fill="#626262" text-anchor="middle">05:00</text>

            <!-- 06:00 -->
            <line x1="400" y1="20" x2="400" y2="195" stroke="#D5D5D5" stroke-width="1" />
            <text x="400" y="215" font-family="IBM Plex Mono" font-size="12" fill="#626262" text-anchor="middle">06:00</text>

            <!-- 07:00 -->
            <line x1="540" y1="20" x2="540" y2="195" stroke="#D5D5D5" stroke-width="1" />
            <text x="540" y="215" font-family="IBM Plex Mono" font-size="12" fill="#626262" text-anchor="middle">07:00</text>

            <!-- 08:00 (Receipt intake) -->
            <line x1="680" y1="20" x2="680" y2="195" stroke="#D5D5D5" stroke-width="1" />
            <text x="680" y="215" font-family="IBM Plex Mono" font-size="12" fill="#626262" text-anchor="middle">08:00</text>

            <!-- 08:30 (Excursion spike) -->
