  <!-- Wide Temperature Chart with 2-8°C Band -->
  <section class="panel chart-panel">
    <div class="panel-header">
      <div>
        <h2 class="panel-title">In-transit &amp; packing thermal curve</h2>
        <span style="font-size: 14px; color: var(--text-quieter);">Profile v3 permitted operating range: <strong class="mono-font" style="color: var(--text-primary);">2.0°C – 8.0°C</strong> · Upper tier threshold: <strong class="mono-font" style="color: var(--text-primary);">&gt;8.0°C – 10.0°C</strong></span>
      </div>
      <div class="chart-legend">
        <div class="legend-item">
          <span class="legend-band"></span>
          <span>Permitted band (2–8°C)</span>
        </div>
        <div class="legend-item">
          <span class="legend-line"></span>
          <span>Gateway returned telemetry</span>
        </div>
        <div class="legend-item">
          <span class="legend-gap"></span>
          <span>Gateway silence gap</span>
        </div>
      </div>
    </div>

    <!-- Scaled SVG Chart -->
    <div class="svg-chart-container">
      <svg viewBox="0 0 1136 240" width="100%" height="240" style="display: block; font-family: 'IBM Plex Mono', monospace; font-size: 12px; overflow: visible;">
        <!-- Definitions -->
        <defs>
          <pattern id="gapHatch" width="6" height="6" patternTransform="rotate(45 0 0)" patternUnits="userSpaceOnUse">
            <line x1="0" y1="0" x2="0" y2="6" stroke="#D5D5D5" stroke-width="1.5" />
          </pattern>
        </defs>

        <!-- Y Axis Grid and Labels: Scale 0°C to 12°C. Height 180px (Y=20 is 12°C, Y=200 is 0°C -> 15px per degree) -->
        <!-- Y=200: 0°C -->
        <!-- Y=170: 2°C -->
        <!-- Y=140: 4°C -->
        <!-- Y=110: 6°C -->
        <!-- Y=80:  8°C -->
        <!-- Y=50: 10°C -->
        <!-- Y=20: 12°C -->

        <!-- Background grid lines -->
        <line x1="60" y1="20" x2="1100" y2="20" stroke="#EBEBEB" stroke-width="1" />
        <line x1="60" y1="50" x2="1100" y2="50" stroke="#EBEBEB" stroke-width="1" />
        <line x1="60" y1="80" x2="1100" y2="80" stroke="#D5D5D5" stroke-width="1" stroke-dasharray="3,3" />
        <line x1="60" y1="110" x2="1100" y2="110" stroke="#EBEBEB" stroke-width="1" />
        <line x1="60" y1="140" x2="1100" y2="140" stroke="#EBEBEB" stroke-width="1" />
        <line x1="60" y1="170" x2="1100" y2="170" stroke="#D5D5D5" stroke-width="1" stroke-dasharray="3,3" />
        <line x1="60" y1="200" x2="1100" y2="200" stroke="#D5D5D5" stroke-width="1" />

        <!-- Permitted band 2°C - 8°C (Y=80 to Y=170, height=90) -->
        <rect x="60" y="80" width="1040" height="90" fill="#24704B" fill-opacity="0.08" />
        <!-- Upper tier band 8°C - 10°C (Y=50 to Y=80, height=30) -->
        <rect x="60" y="50" width="1040" height="30" fill="#805800" fill-opacity="0.05" />

        <!-- Gateway silence gap shading between 13:20 (X=660) and 13:50 (X=780) -->
        <rect x="670" y="20" width="120" height="180" fill="url(#gapHatch)" fill-opacity="0.6" />
        <rect x="670" y="20" width="120" height="180" fill="#F7F7F7" fill-opacity="0.4" />
        <!-- Gap indicator banner -->
        <rect x="680" y="28" width="100" height="20" fill="#FFFFFF" stroke="#D5D5D5" rx="2" />
        <text x="730" y="42" fill="#805800" text-anchor="middle" font-size="10" font-weight="600">Silent gap (30m)</text>

        <!-- Y Axis Text -->
        <text x="50" y="24" fill="#626262" text-anchor="end">12°C</text>
        <text x="50" y="54" fill="#805800" text-anchor="end">10°C</text>
        <text x="50" y="84" fill="#24704B" text-anchor="end" font-weight="600">8°C</text>
        <text x="50" y="114" fill="#626262" text-anchor="end">6°C</text>
        <text x="50" y="144" fill="#626262" text-anchor="end">4°C</text>
        <text x="50" y="174" fill="#24704B" text-anchor="end" font-weight="600">2°C</text>
        <text x="50" y="204" fill="#626262" text-anchor="end">0°C</text>

        <!-- Telemetry Polyline segment 1: 11:45 (X=100, 4.8°C Y=128), 12:00 (X=200, 4.6°C Y=131), 12:20 (X=310, 4.5°C Y=132.5), 12:40 (X=430, 4.3°C Y=135.5), 13:00 (X=550, 4.2°C Y=137), 13:20 (X=670, 4.3°C Y=135.5) -->
        <polyline points="100,128 200,131 310,132.5 430,135.5 550,137 670,135.5" fill="none" stroke="#24704B" stroke-width="2.5" stroke-linejoin="round" />

        <!-- Discontinuous break during gateway silence: line is omitted between X=670 and X=790 to never substitute estimated temperature -->
        <line x1="670" y1="135.5" x2="685" y2="135.5" stroke="#24704B" stroke-width="2" stroke-dasharray="2,2" />
        <line x1="775" y1="134" x2="790" y2="134" stroke="#24704B" stroke-width="2" stroke-dasharray="2,2" />

        <!-- Telemetry Polyline segment 2: 13:50 (X=790, 4.4°C Y=134), 14:15 (X=920, 4.5°C Y=132.5), 14:40 (X=1050, 4.4°C Y=134) -->
        <polyline points="790,134 920,132.5 1050,134" fill="none" stroke="#24704B" stroke-width="2.5" stroke-linejoin="round" />

