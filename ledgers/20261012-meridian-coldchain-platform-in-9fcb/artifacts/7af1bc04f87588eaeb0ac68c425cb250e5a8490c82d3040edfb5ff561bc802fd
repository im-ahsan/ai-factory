        <text x="1050" y="114" fill="#FFFFFF" text-anchor="middle" font-weight="600" font-size="12">4.4°C (good)</text>
        <line x1="1050" y1="122" x2="1050" y2="129" stroke="#202020" stroke-width="1.5" />

        <!-- X Axis labels -->
        <text x="100" y="222" fill="#626262" text-anchor="middle">11:45 (Sealed)</text>
