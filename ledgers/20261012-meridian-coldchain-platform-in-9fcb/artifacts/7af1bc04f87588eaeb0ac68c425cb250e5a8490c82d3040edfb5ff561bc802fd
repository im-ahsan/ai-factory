<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Box temperature</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@600;650;700&family=IBM+Plex+Mono:wght@400;500;600&family=Public+Sans:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root {
    --bg-page: #F7F7F7;
    --bg-surface: #FFFFFF;
    --text-primary: #202020;
    --text-quieter: #626262;
    --border-color: #D5D5D5;
    --brand-accent: #A94B1D;
    --status-good: #24704B;
    --status-waiting: #805800;
    --status-failed: #AE2C2C;
  }

  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  body {
    background-color: var(--bg-page);
    color: var(--text-primary);
    font-family: 'Public Sans', sans-serif;
    font-size: 16px;
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
  }

  h1, h2, h3, .heading-font {
    font-family: 'Hanken Grotesk', sans-serif;
  }

  .mono-font {
    font-family: 'IBM Plex Mono', monospace;
  }

  /* Header */
  header {
    background-color: var(--bg-surface);
    border-bottom: 1px solid var(--border-color);
    height: 56px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 32px;
  }

  .header-left {
    display: flex;
    align-items: center;
    gap: 32px;
  }

  .brand-group {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: var(--text-primary);
  }

  .brand-icon {
    width: 24px;
    height: 24px;
    background-color: #202020;
    color: #FFFFFF;
    font-family: 'Hanken Grotesk', sans-serif;
    font-weight: 700;
    font-size: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 2px;
  }

  .brand-name {
    font-family: 'Hanken Grotesk', sans-serif;
    font-size: 17px;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  nav.header-nav {
    display: flex;
    align-items: center;
    gap: 24px;
    height: 56px;
  }

  nav.header-nav a {
    color: var(--text-quieter);
    text-decoration: none;
    font-size: 15px;
    font-weight: 500;
    height: 100%;
    display: flex;
    align-items: center;
    border-bottom: 2px solid transparent;
    transition: color 0.15s ease, border-color 0.15s ease;
  }

  nav.header-nav a:hover {
    color: var(--text-primary);
  }

  nav.header-nav a.active {
    color: var(--brand-accent);
    border-bottom-color: var(--brand-accent);
  }

  .header-right {
    display: flex;
    align-items: center;
    gap: 24px;
    font-size: 14px;
  }

  .user-badge {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--text-primary);
  }

  .user-initials {
    width: 28px;
    height: 28px;
    border: 1px solid var(--border-color);
    background-color: #F7F7F7;
    border-radius: 2px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 12px;
    font-weight: 600;
    color: var(--text-primary);
  }

  .lang-switch {
    color: var(--text-quieter);
  }

  /* Main Container */
  main {
    max-width: 1200px;
    margin: 0 auto;
    padding: 32px;
  }

  /* Title row */
  .title-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 32px;
  }

  .page-title {
    font-size: 28px;
    font-weight: 650;
    line-height: 1.2;
    color: var(--text-primary);
  }

  .btn {
    height: 48px;
    padding: 0 20px;
    font-size: 15px;
    font-weight: 600;
    font-family: 'Public Sans', sans-serif;
    border-radius: 2px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    cursor: pointer;
    box-sizing: border-box;
    transition: background-color 0.15s ease, border-color 0.15s ease, color 0.15s ease;
  }

  .btn-secondary {
    background-color: var(--bg-surface);
    border: 1px solid var(--border-color);
    color: var(--text-primary);
  }

  .btn-secondary:hover {
    background-color: #F0F0F0;
    border-color: #C0C0C0;
  }

  .btn-secondary:focus-visible {
    outline: none;
    border-color: var(--brand-accent);
    box-shadow: 0 0 0 2px var(--brand-accent);
  }

  /* Panel */
  .panel {
    background-color: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-radius: 2px;
    margin-bottom: 32px;
  }

  /* Section Top Info */
  .hero-panel {
    display: grid;
    grid-template-columns: 280px 1fr;
    border-radius: 2px;
    overflow: hidden;
  }

  .hero-image-wrap {
    border-right: 1px solid var(--border-color);
    background-color: #FAFAFA;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 16px;
  }

  .hero-image {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 2px;
    border: 1px solid var(--border-color);
    display: block;
  }

  .hero-content {
    padding: 24px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .hero-precedence {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--border-color);
  }

  .box-id {
    font-size: 28px;
    font-weight: 700;
    color: var(--text-primary);
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .box-status-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 15px;
    font-weight: 600;
  }

  .status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    display: inline-block;
  }

  .status-good {
    color: var(--status-good);
  }
  .status-good .status-dot {
    background-color: var(--status-good);
  }

  .status-waiting {
    color: var(--status-waiting);
  }
  .status-waiting .status-dot {
    background-color: var(--status-waiting);
  }

  .status-failed {
    color: var(--status-failed);
  }
  .status-failed .status-dot {
    background-color: var(--status-failed);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    padding-top: 16px;
  }

  .metric-block {
    display: flex;
    flex-direction: column;
  }

  .metric-label {
    font-size: 13px;
    color: var(--text-quieter);
    margin-bottom: 4px;
  }

  .metric-value {
    font-size: 16px;
    font-weight: 500;
    color: var(--text-primary);
  }

  .metric-value-lg {
    font-size: 24px;
    font-weight: 600;
    line-height: 1.2;
    color: var(--text-primary);
  }

  /* Telemetry Chart Panel */
  .chart-panel {
    padding: 24px;
  }

  .panel-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 16px;
  }

  .panel-title {
    font-size: 20px;
    font-weight: 650;
    color: var(--text-primary);
  }

  .chart-legend {
    display: flex;
    align-items: center;
    gap: 20px;
    font-size: 13px;
    color: var(--text-quieter);
  }

  .legend-item {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .legend-band {
    width: 14px;
    height: 10px;
    background-color: rgba(36, 112, 75, 0.12);
    border: 1px dashed #24704B;
  }

  .legend-line {
    width: 16px;
    height: 2px;
    background-color: #24704B;
  }

  .legend-gap {
    width: 14px;
    height: 10px;
    background-color: #F0F0F0;
    border: 1px dotted #A0A0A0;
  }

  .svg-chart-container {
    width: 100%;
    overflow-x: auto;
  }

  /* Table styling */
  .table-panel {
    border-radius: 2px;
    overflow: hidden;
  }

  .table-header-block {
    padding: 20px 24px 12px 24px;
    border-bottom: 1px solid var(--border-color);
  }

  table.data-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 15px;
    text-align: left;
  }

  table.data-table th {
    height: 48px;
    padding: 0 20px;
    background-color: #FAFBFB;
    color: var(--text-quieter);
    font-weight: 600;
    font-size: 13px;
    border-bottom: 1px solid var(--border-color);
    letter-spacing: 0.01em;
  }

  table.data-table td {
    height: 48px;
    padding: 0 20px;
    border-bottom: 1px solid var(--border-color);
    color: var(--text-primary);
    vertical-align: middle;
  }

  table.data-table tr:last-child td {
    border-bottom: none;
  }

  table.data-table tr:hover td {
    background-color: #FBFBFB;
  }

  .badge-tag {
    display: inline-block;
    padding: 2px 8px;
    font-size: 12px;
    border-radius: 2px;
    font-weight: 500;
  }

  .badge-neutral {
    background-color: #EEEEEE;
    color: var(--text-primary);
  }

  .badge-gap {
    background-color: #F3EFE0;
    color: var(--status-waiting);
  }

  /* Footer notes / audit line */
  .metadata-bar {
    display: flex;
    justify-content: space-between;
    font-size: 13px;
    color: var(--text-quieter);
    margin-top: 16px;
    padding-top: 8px;
  }

  /* Motion keyframes */
  @keyframes fadeInEntrance {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes savedHandoff {
    0% {
      opacity: 0.6;
      transform: translateY(8px);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes waitingBreathe {
    0%, 100% {
      opacity: 0.7;
    }
    50% {
      opacity: 1;
    }
  }

  .entrance-load {
    animation: fadeInEntrance 320ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .status-sync-handoff {
    animation: savedHandoff 260ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .waiting-dot-breathe {
    animation: waitingBreathe 6s ease-in-out infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    *, ::before, ::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
  }
</style>
</head>
<body class="entrance-load">

<!-- Universal Header -->
<header>
  <div class="header-left">
