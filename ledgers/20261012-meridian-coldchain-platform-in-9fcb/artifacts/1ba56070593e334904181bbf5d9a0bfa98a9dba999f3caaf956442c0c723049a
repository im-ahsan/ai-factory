<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Organisations</title>
  <!-- Google Fonts: Hanken Grotesk, Public Sans, IBM Plex Mono -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@600;650;700&family=IBM+Plex+Mono:wght@400;500;600&family=Public+Sans:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    /* CSS Reset & Variables */
    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    :root {
      --bg: #F7F7F7;
      --panel: #FFFFFF;
      --text: #202020;
      --text-quiet: #626262;
      --border: #D5D5D5;
      --primary: #A94B1D;
      --status-good: #24704B;
      --status-waiting: #805800;
      --status-refused: #AE2C2C;
    }

    body {
      background-color: var(--bg);
      color: var(--text);
      font-family: 'Public Sans', -apple-system, BlinkMacSystemFont, sans-serif;
      font-size: 16px;
      line-height: 1.5;
      -webkit-font-smoothing: antialiased;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    /* Typography */
    h1, .heading-main {
      font-family: 'Hanken Grotesk', sans-serif;
      font-size: 28px;
      font-weight: 650;
      line-height: 1.2;
      color: var(--text);
    }

    .font-mono {
      font-family: 'IBM Plex Mono', monospace;
    }

    .text-quiet {
      color: var(--text-quiet);
    }

    /* Motion Tokens & Keyframes */
    @keyframes pageEntrance {
      from {
        opacity: 0;
        transform: translateY(6px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes savedHandoff {
      from {
        opacity: 0.6;
        transform: translateY(8px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes waitingBreathe {
      0%, 100% {
        opacity: 0.7;
      }
      50% {
        opacity: 1;
      }
    }

    .animate-entrance {
      animation: pageEntrance 260ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    /* Header Component */
    header {
      background-color: var(--panel);
      border-bottom: 1px solid var(--border);
      height: 64px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 32px;
      position: sticky;
      top: 0;
      z-index: 50;
    }

    .header-left {
      display: flex;
      align-items: center;
      gap: 32px;
    }

    .brand-cluster {
      display: flex;
      align-items: center;
      gap: 12px;
      text-decoration: none;
      color: var(--text);
    }

    .brand-mark {
      width: 28px;
      height: 28px;
      background-color: #202020;
      color: #FFFFFF;
      font-family: 'Hanken Grotesk', sans-serif;
      font-weight: 700;
      font-size: 16px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 2px;
    }

    .brand-name {
      font-family: 'Hanken Grotesk', sans-serif;
      font-size: 18px;
      font-weight: 650;
      color: var(--text);
      letter-spacing: -0.01em;
    }

    nav {
      display: flex;
      align-items: center;
      height: 64px;
    }

    .nav-link {
      display: inline-flex;
      align-items: center;
      height: 64px;
      padding: 0 16px;
      font-size: 15px;
      font-weight: 500;
      color: var(--text-quiet);
      text-decoration: none;
      border-bottom: 2px solid transparent;
      transition: color 150ms ease, border-color 150ms ease;
    }

    .nav-link:hover {
      color: var(--text);
    }

    .nav-link:focus-visible {
      outline: 2px solid var(--primary);
      outline-offset: -2px;
    }

    .nav-link.active {
      color: var(--primary);
      border-bottom-color: var(--primary);
      font-weight: 600;
    }

    .header-right {
      display: flex;
      align-items: center;
      gap: 24px;
    }

    .user-profile {
      display: flex;
      align-items: center;
      gap: 10px;
      font-size: 14px;
      color: var(--text);
    }

    .avatar-initials {
      width: 32px;
      height: 32px;
      background-color: #ECECEC;
      color: var(--text);
      font-family: 'Public Sans', sans-serif;
      font-size: 13px;
      font-weight: 600;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 2px;
      border: 1px solid var(--border);
    }

    .user-name-role {
      font-size: 14px;
      color: var(--text);
    }

    .lang-switcher {
      font-size: 14px;
      color: var(--text-quiet);
      border-left: 1px solid var(--border);
      padding-left: 16px;
      font-family: 'Public Sans', sans-serif;
    }

    /* Main Container */
    main {
      flex: 1;
      max-width: 1280px;
      width: 100%;
      margin: 0 auto;
      padding: 32px;
      display: flex;
      flex-direction: column;
      gap: 32px;
    }

    /* Panel Component */
    .panel {
      background-color: var(--panel);
      border: 1px solid var(--border);
      border-radius: 2px;
    }

    /* Filter & Search Bar */
    .filter-bar {
      padding: 16px;
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      gap: 16px;
    }

    .filter-inputs {
      display: flex;
      align-items: flex-end;
      gap: 16px;
      flex: 1;
      max-width: 720px;
    }

    .form-group {
      display: flex;
      flex-direction: column;
      gap: 6px;
      flex: 1;
    }

    .form-label {
      font-size: 14px;
      font-weight: 500;
      color: var(--text);
    }

    .input-field {
      height: 48px;
      background-color: var(--panel);
      border: 1px solid var(--border);
      border-radius: 2px;
      padding: 0 16px;
      font-size: 16px;
      font-family: 'Public Sans', sans-serif;
      color: var(--text);
      outline: none;
      transition: border-color 150ms ease, box-shadow 150ms ease;
      width: 100%;
    }

    .input-field:focus {
      border-color: var(--primary);
      box-shadow: 0 0 0 1px var(--primary);
    }

    .select-field {
      height: 48px;
      background-color: var(--panel);
      border: 1px solid var(--border);
      border-radius: 2px;
      padding: 0 16px;
      font-size: 16px;
      font-family: 'Public Sans', sans-serif;
      color: var(--text);
      outline: none;
      transition: border-color 150ms ease, box-shadow 150ms ease;
      appearance: none;
      background-image: url("data:image/svg2+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='%23626262' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3E%3Cpolyline points='6 9 12 15 18 9'%3E%3C/polyline%3E%3C/svg%3E");
      background-repeat: no-repeat;
      background-position: right 14px center;
      padding-right: 40px;
      cursor: pointer;
    }

    .select-field:focus {
      border-color: var(--primary);
      box-shadow: 0 0 0 1px var(--primary);
    }

    /* Buttons */
    .btn {
      height: 48px;
      padding: 0 20px;
      border-radius: 2px;
      font-size: 15px;
      font-weight: 500;
      font-family: 'Public Sans', sans-serif;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      cursor: pointer;
      text-decoration: none;
      white-space: nowrap;
      transition: background-color 150ms ease, border-color 150ms ease, color 150ms ease;
    }

    .btn:focus-visible {
      outline: 2px solid var(--primary);
      outline-offset: 2px;
    }

    .btn-secondary {
      background-color: var(--panel);
      border: 1px solid var(--border);
      color: var(--text);
    }

    .btn-secondary:hover {
      background-color: #F1F1F1;
      border-color: #C0C0C0;
    }

    .btn-secondary:active {
      background-color: #E7E7E7;
    }

    /* Table Component */
    .table-container {
      overflow-x: auto;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      text-align: left;
    }

    th {
      height: 48px;
      padding: 0 16px;
      font-size: 13px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--text-quiet);
      border-bottom: 1px solid var(--border);
      background-color: #FAFAFA;
      white-space: nowrap;
    }

    td {
      height: 48px;
      padding: 0 16px;
      font-size: 15px;
      border-bottom: 1px solid var(--border);
      color: var(--text);
      vertical-align: middle;
    }

    /* Clickable row behavior: Let the whole Cedar Health row open Organisation detail */
    tr.clickable-row {
      cursor: pointer;
      transition: background-color 150ms ease;
    }

    tr.clickable-row:hover {
      background-color: #FBF8F6;
    }

    tr.clickable-row:focus-visible {
      outline: 2px solid var(--primary);
      outline-offset: -2px;
    }

    .org-link {
      font-weight: 600;
      color: var(--text);
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }

    .org-link:hover {
      color: var(--primary);
    }

    .action-link {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      height: 36px;
      padding: 0 14px;
      background-color: var(--panel);
      border: 1px solid var(--border);
      border-radius: 2px;
      font-size: 14px;
      font-weight: 500;
      color: var(--text);
      text-decoration: none;
      transition: all 150ms ease;
    }

    .action-link:hover {
      background-color: #F1F1F1;
      border-color: #C0C0C0;
    }

    .action-link:focus-visible {
      outline: 2px solid var(--primary);
      outline-offset: 2px;
    }

    /* Status Indicator System */
    .status-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: 14px;
      font-weight: 500;
    }

    .status-dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
    }

    .status-good {
      color: var(--status-good);
    }
    .status-good .status-dot {
      background-color: var(--status-good);
    }

    .status-waiting {
      color: var(--status-waiting);
    }
    .status-waiting .status-dot {
      background-color: var(--status-waiting);
    }

    .status-refused {
      color: var(--status-refused);
    }
    .status-refused .status-dot {
      background-color: var(--status-refused);
    }

    /* Table footer/summary info inside panel */
    .table-summary {
      padding: 16px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      font-size: 14px;
      color: var(--text-quiet);
      background-color: var(--panel);
    }

    /* Generous whitespace container beneath table */
    .whitespace-spacer {
      min-height: 280px;
    }

    /* Reduced Motion */
    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
        scroll-behavior: auto !important;
      }
    }
  </style>
</head>
<body>

  <!-- Persistent Header -->
  <header>
    <div class="header-left">
      <a href="#" class="brand-cluster" aria-label="Meridian home">
        <div class="brand-mark">M</div>
        <span class="brand-name">Meridian</span>
      </a>
      <nav aria-label="Main menu">
        <a href="#" class="nav-link">Products</a>
        <a href="#" class="nav-link active" aria-current="page">Organisations</a>
        <a href="#" class="nav-link">Accounts</a>
        <a href="#" class="nav-link">Audit trail</a>
        <a href="#" class="nav-link">Reports</a>
      </nav>
    </div>
    <div class="header-right">
      <div class="user-profile">
        <div class="avatar-initials">MV</div>
        <span class="user-name-role">Marcus Vale · System Administrator</span>
      </div>
      <div class="lang-switcher">
        <span>EN / العربية</span>
      </div>
    </div>
  </header>

  <!-- Main View Area -->
  <main class="animate-entrance">
    <!-- One Heading -->
    <h1 class="heading-main">Organisations</h1>

    <!-- Search & CSV Export Toolbar with Table -->
    <section class="panel">
      <div class="filter-bar">
        <div class="filter-inputs">
          <div class="form-group">
            <label for="search-input" class="form-label">Search organisations</label>
            <input 
              id="search-input" 
              type="text" 
              class="input-field" 
              placeholder="Filter by organisation name, contact or location..." 
              value="Cedar Health"
            >
          </div>
          <div class="form-group" style="max-width: 260px;">
            <label for="status-filter" class="form-label">Assurance status</label>
            <select id="status-filter" class="select-field">
              <option value="all">All statuses</option>
              <option value="good" selected>good compliant</option>
              <option value="waiting">waiting response</option>
              <option value="refused">refused</option>
            </select>
          </div>
        </div>

        <div>
          <button type="button" class="btn btn-secondary" aria-label="Export organisations list as CSV">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="7 10 12 15 17 10"></polyline>
              <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
            CSV export
          </button>
        </div>
      </div>

      <!-- Organisations Table -->
      <div class="table-container">
        <table>
          <thead>
            <tr>
              <th scope="col">Organisation</th>
              <th scope="col">Minimum remaining shelf life</th>
              <th scope="col">Primary destination</th>
              <th scope="col">Primary buyer</th>
              <th scope="col">Assurance status</th>
              <th scope="col" style="text-align: right;">Action</th>
            </tr>
          </thead>
          <tbody>
            <!-- Whole row opens Organisation detail -->
            <tr class="clickable-row" onclick="window.location.href='#organisation-detail'" tabindex="0" role="link" aria-label="Open details for Cedar Health">
              <td>
                <span class="org-link">Cedar Health</span>
              </td>
              <td>
                <span class="font-mono">90 days</span>
              </td>
              <td>Cedar Clinic, 42 River Road, London</td>
              <td>Hana Youssef</td>
              <td>
                <span class="status-badge status-good">
                  <span class="status-dot"></span>
                  good compliant
                </span>
              </td>
              <td style="text-align: right;">
                <a href="#organisation-detail" class="action-link" onclick="event.stopPropagation();">Organisation detail</a>
              </td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- Table count / info -->
      <div class="table-summary">
        <span>Showing <span class="font-mono">1</span> organisation</span>
        <span>Contractual cold-chain assurance mandate</span>
      </div>
    </section>

    <!-- Generous whitespace beneath the short table rather than invented customers or tiles -->
    <div class="whitespace-spacer" aria-hidden="true"></div>
  </main>

</body>
</html>