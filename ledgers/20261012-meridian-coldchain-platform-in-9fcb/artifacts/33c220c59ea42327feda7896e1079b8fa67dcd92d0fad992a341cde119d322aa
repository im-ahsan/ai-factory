<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Accounts</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@600;650;700&family=IBM+Plex+Mono:wght@400;500;600&family=Public+Sans:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg: #F7F7F7;
      --surface: #FFFFFF;
      --text: #202020;
      --text-quiet: #626262;
      --border: #D5D5D5;
      --primary: #A94B1D;
      --status-good: #24704B;
      --status-waiting: #805800;
      --status-refused: #AE2C2C;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      background-color: var(--bg);
      color: var(--text);
      font-family: 'Public Sans', sans-serif;
      font-size: 16px;
      line-height: 1.5;
      -webkit-font-smoothing: antialiased;
      min-height: 100vh;
    }

    /* Typography */
    h1 {
      font-family: 'Hanken Grotesk', sans-serif;
      font-size: 28px;
      font-weight: 650;
      line-height: 1.25;
      color: var(--text);
    }

    .section-title {
      font-family: 'Hanken Grotesk', sans-serif;
      font-size: 20px;
      font-weight: 650;
      line-height: 1.3;
      color: var(--text);
    }

    .item-title {
      font-family: 'Hanken Grotesk', sans-serif;
      font-size: 16px;
      font-weight: 600;
      line-height: 1.4;
      color: var(--text);
    }

    .mono {
      font-family: 'IBM Plex Mono', monospace;
    }

    .supporting {
      font-size: 14px;
      color: var(--text-quiet);
    }

    /* Header */
    header {
      background: var(--surface);
      border-bottom: 1px solid var(--border);
      height: 64px;
      padding: 0 32px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .header-left {
      display: flex;
      align-items: center;
      gap: 32px;
    }

    .brand-mark {
      display: flex;
      align-items: center;
      gap: 12px;
      text-decoration: none;
      color: var(--text);
    }

    .brand-icon {
      width: 24px;
      height: 24px;
      background: #202020;
      color: #FFFFFF;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: 'Hanken Grotesk', sans-serif;
      font-weight: 700;
      font-size: 14px;
      border-radius: 2px;
    }

    .brand-name {
      font-family: 'Hanken Grotesk', sans-serif;
      font-weight: 700;
      font-size: 18px;
      letter-spacing: -0.01em;
    }

    nav.main-menu {
      display: flex;
      align-items: center;
      gap: 24px;
    }

    nav.main-menu a {
      color: var(--text-quiet);
      text-decoration: none;
      font-size: 15px;
      font-weight: 500;
      padding: 20px 0;
      position: relative;
      transition: color 150ms ease;
    }

    nav.main-menu a:hover {
      color: var(--text);
    }

    nav.main-menu a.active {
      color: var(--text);
      font-weight: 600;
    }

    nav.main-menu a.active::after {
      content: '';
      position: absolute;
      bottom: -1px;
      left: 0;
      right: 0;
      height: 2px;
      background: var(--primary);
    }

    .header-right {
      display: flex;
      align-items: center;
      gap: 24px;
    }

    .user-profile {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .avatar-initials {
      width: 32px;
      height: 32px;
      background: #EEEEEE;
      border: 1px solid var(--border);
      border-radius: 2px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: 'Public Sans', sans-serif;
      font-weight: 600;
      font-size: 13px;
      color: var(--text);
    }

    .user-text {
      font-size: 14px;
      color: var(--text);
    }

    .lang-switcher {
      font-size: 13px;
      color: var(--text-quiet);
      border-left: 1px solid var(--border);
      padding-left: 16px;
    }

    /* Layout */
    main {
      max-width: 1360px;
      margin: 0 auto;
      padding: 32px;
      display: flex;
      flex-direction: column;
      gap: 32px;
    }

    .heading-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    /* Panels & Rules */
    .panel {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 2px;
      padding: 16px;
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    /* Filter Toolbar inside panel */
    .toolbar-row {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      gap: 16px;
    }

    .filter-group {
      display: flex;
      align-items: flex-end;
      gap: 16px;
      flex: 1;
    }

    .field-wrapper {
      display: flex;
      flex-direction: column;
      gap: 6px;
      flex: 1;
    }

    .field-wrapper.short {
      max-width: 220px;
    }

    label {
      font-size: 14px;
      font-weight: 500;
      color: var(--text);
    }

    input[type="text"],
    select {
      height: 48px;
      padding: 0 14px;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 2px;
      font-family: 'Public Sans', sans-serif;
      font-size: 15px;
      color: var(--text);
      outline: none;
      width: 100%;
      transition: border-color 140ms ease, box-shadow 140ms ease;
    }

    input[type="text"]:focus,
    select:focus {
      border-color: var(--primary);
      box-shadow: 0 0 0 1px var(--primary);
    }

    input[type="text"]::placeholder {
      color: var(--text-quiet);
    }

    /* Buttons */
    .btn {
      height: 48px;
      padding: 0 24px;
      border-radius: 2px;
      font-family: 'Public Sans', sans-serif;
      font-size: 15px;
      font-weight: 600;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      cursor: pointer;
      text-decoration: none;
      white-space: nowrap;
      transition: background-color 140ms ease, border-color 140ms ease, transform 90ms ease;
    }

    .btn:active {
      transform: scale(0.98);
    }

    .btn-primary {
      background: var(--primary);
      color: #FFFFFF;
      border: 1px solid var(--primary);
    }

    .btn-primary:hover {
      background: #923f17;
      border-color: #923f17;
    }

    .btn-primary:focus-visible {
      outline: none;
      box-shadow: 0 0 0 2px var(--surface), 0 0 0 4px var(--primary);
    }

    .btn-secondary {
      background: var(--surface);
      color: var(--text);
      border: 1px solid var(--border);
    }

    .btn-secondary:hover {
      background: #F9F9F9;
      border-color: #C0C0C0;
    }

    .btn-secondary:focus-visible {
      outline: none;
      box-shadow: 0 0 0 2px var(--surface), 0 0 0 4px var(--primary);
    }

    .btn-sm {
      height: 36px;
      padding: 0 14px;
      font-size: 14px;
      font-weight: 500;
    }

    /* Table */
    .table-container {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 2px;
      overflow: hidden;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      text-align: left;
    }

    thead th {
      height: 48px;
      padding: 0 16px;
      font-size: 12px;
      font-weight: 600;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      color: var(--text-quiet);
      border-bottom: 1px solid var(--border);
      background: #FAFAFA;
      white-space: nowrap;
    }

    tbody tr {
      height: 48px;
      border-bottom: 1px solid var(--border);
      transition: background-color 120ms ease;
    }

    tbody tr:last-child {
      border-bottom: none;
    }

    tbody tr:hover {
      background-color: #FBFBFB;
    }

    td {
      padding: 0 16px;
      font-size: 15px;
      vertical-align: middle;
      color: var(--text);
    }

    /* Initials Avatar in Table */
    .user-cell {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .table-avatar {
      width: 32px;
      height: 32px;
      background: #F0F0F0;
      border: 1px solid var(--border);
      border-radius: 2px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: 'Public Sans', sans-serif;
      font-weight: 600;
      font-size: 13px;
      color: var(--text);
      flex-shrink: 0;
    }

    .user-cell-content {
      display: flex;
      flex-direction: column;
      gap: 2px;
    }

    .user-name {
      font-weight: 600;
      color: var(--text);
      font-size: 15px;
    }

    /* Status indicator */
    .status-badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-size: 14px;
      font-weight: 500;
    }

    .status-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      display: inline-block;
    }

    .status-good {
      color: var(--status-good);
    }
    .status-good .status-dot {
      background-color: var(--status-good);
    }

    .status-waiting {
      color: var(--status-waiting);
    }
    .status-waiting .status-dot {
      background-color: var(--status-waiting);
      animation: waitingBreathe 6s ease-in-out infinite;
    }

    .status-refused {
      color: var(--status-refused);
    }
    .status-refused .status-dot {
      background-color: var(--status-refused);
    }

    /* Summary bar at footer of table */
    .table-footer {
      padding: 12px 16px;
      background: #FAFAFA;
      border-top: 1px solid var(--border);
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 14px;
      color: var(--text-quiet);
    }

    /* Motion specifications */
    @keyframes pageEntrance {
      from {
        opacity: 0;
        transform: translateY(6px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes waitingBreathe {
      0%, 100% {
        opacity: 0.7;
      }
      50% {
        opacity: 1;
      }
    }

    @keyframes savedHandoff {
      from {
        opacity: 0.6;
        transform: translateY(8px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .animate-entrance {
      animation: pageEntrance 260ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    .saved-handoff {
      animation: savedHandoff 260ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    @media (prefers-reduced-motion: reduce) {
      *, ::before, ::after {
        animation-delay: -1ms !important;
        animation-duration: 1ms !important;
        animation-iteration-count: 1 !important;
        background-attachment: initial !important;
        scroll-behavior: auto !important;
        transition-delay: 0s !important;
        transition-duration: 0s !important;
      }
    }
  </style>
</head>
<body>
  <!-- Header: exact specification -->
  <header>
    <div class="header-left">
      <div class="brand-mark">
        <div class="brand-icon">M</div>
        <span class="brand-name">Meridian</span>
      </div>
      <nav class="main-menu">
        <a href="#products">Products</a>
        <a href="#organisations">Organisations</a>
        <a href="#accounts" class="active">Accounts</a>
        <a href="#audit-trail">Audit trail</a>
        <a href="#reports">Reports</a>
      </nav>
    </div>
    <div class="header-right">
      <div class="user-profile">
        <div class="avatar-initials">MV</div>
        <span class="user-text">Marcus Vale · System Administrator</span>
      </div>
      <div class="lang-switcher">EN / العربية</div>
    </div>
  </header>

  <!-- Main Content -->
  <main class="animate-entrance">
    <!-- Title & primary action -->
    <div class="heading-bar">
      <h1>Accounts</h1>
      <button type="button" class="btn btn-primary">Account detail</button>
    </div>

    <!-- Filter & search panel -->
    <div class="panel">
      <div class="toolbar-row">
        <div class="filter-group">
          <div class="field-wrapper">
            <label for="search-input">Search accounts</label>
            <input type="text" id="search-input" value="" placeholder="Search by name, role, email or depot...">
          </div>
          <div class="field-wrapper short">
            <label for="role-select">Role</label>
            <select id="role-select">
              <option value="all">All roles</option>
              <option value="operator">Warehouse Operator</option>
              <option value="driver">Driver</option>
              <option value="buyer">Cedar Health buyer</option>
              <option value="quality">Quality Manager</option>
            </select>
          </div>
          <div class="field-wrapper short">
            <label for="status-select">Status</label>
            <select id="status-select">
              <option value="all">All statuses</option>
              <option value="good">good active</option>
              <option value="waiting">waiting response</option>
              <option value="refused">refused inactive</option>
            </select>
          </div>
        </div>
        <button type="button" class="btn btn-secondary">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--text-quiet);">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="7 10 12 15 17 10"></polyline>
            <line x1="12" y1="15" x2="12" y2="3"></line>
          </svg>
          CSV export
        </button>
      </div>
    </div>

    <!-- Table of accounts -->
    <div class="table-container">
      <table>
        <thead>
          <tr>
            <th>User</th>
            <th>Role</th>
            <th>Depot / Organisation</th>
            <th>Email</th>
            <th>Status</th>
            <th style="text-align: right;">Action</th>
          </tr>
        </thead>
        <tbody>
          <!-- Leila Haddad -->
          <tr>
            <td>
              <div class="user-cell">
                <div class="table-avatar">LH</div>
                <div class="user-cell-content">
                  <span class="user-name">Leila Haddad</span>
                </div>
              </div>
            </td>
            <td>Warehouse Operator</td>
            <td>North Quay Warehouse</td>
            <td class="supporting">leila.haddad@meridian.example</td>
            <td>
              <span class="status-badge status-good">
                <span class="status-dot"></span>
                good active
              </span>
            </td>
            <td style="text-align: right;">
              <button type="button" class="btn btn-secondary btn-sm">Account detail</button>
            </td>
          </tr>

          <!-- Tariq Mansour -->
          <tr>
            <td>
              <div class="user-cell">
                <div class="table-avatar">TM</div>
                <div class="user-cell-content">
                  <span class="user-name">Tariq Mansour</span>
                </div>
              </div>
            </td>
            <td>Driver</td>
            <td>North Quay (VAN-27 · MTR-482)</td>
            <td class="supporting">tariq.mansour@meridian.example</td>
            <td>
              <span class="status-badge status-good">
                <span class="status-dot"></span>
                good active
              </span>
            </td>
            <td style="text-align: right;">
              <button type="button" class="btn btn-secondary btn-sm">Account detail</button>
            </td>
          </tr>

          <!-- Hana Youssef -->
          <tr>
            <td>
              <div class="user-cell">
                <div class="table-avatar">HY</div>
                <div class="user-cell-content">
                  <span class="user-name">Hana Youssef</span>
                </div>
              </div>
            </td>
            <td>Cedar Health buyer</td>
            <td>Cedar Health (Cedar Clinic)</td>
            <td class="supporting">hana.youssef@cedarhealth.example</td>
            <td>
              <span class="status-badge status-good">
                <span class="status-dot"></span>
                good active
              </span>
            </td>
            <td style="text-align: right;">
              <button type="button" class="btn btn-secondary btn-sm">Account detail</button>
            </td>
          </tr>

          <!-- Nadia Farouk -->
          <tr>
            <td>
              <div class="user-cell">
                <div class="table-avatar">NF</div>
                <div class="user-cell-content">
                  <span class="user-name">Nadia Farouk</span>
                </div>
              </div>
            </td>
            <td>Quality Manager</td>
            <td>North Quay Warehouse</td>
            <td class="supporting">nadia.farouk@meridian.example</td>
            <td>
              <span class="status-badge status-good">
                <span class="status-dot"></span>
                good active
              </span>
            </td>
            <td style="text-align: right;">
              <button type="button" class="btn btn-secondary btn-sm">Account detail</button>
            </td>
          </tr>
        </tbody>
      </table>

      <!-- Table Footer with Prototype standard context -->
      <div class="table-footer">
        <span>Showing <span class="mono">4</span> accounts recorded</span>
        <span class="mono">Prototype date: 14 May 2026 · Europe/London (BST)</span>
      </div>
    </div>
  </main>
</body>
</html>
