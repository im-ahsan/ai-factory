    @keyframes settle {
      from { opacity: 0.6; transform: translateY(8px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .animate-entrance {
      animation: settle var(--dur-base) var(--ease-out) both;
    }

    .stagger-1 { animation-delay: 40ms; }
    .stagger-2 { animation-delay: 90ms; }
