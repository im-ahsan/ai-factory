    /* Motion specifications */
    :root {
      --dur-instant: 90ms;
      --dur-quick: 160ms;
      --dur-base: 260ms;
      --dur-slow: 420ms;
      --dur-scene: 800ms;
      --ease-out: cubic-bezier(0.16, 1, 0.3, 1);
