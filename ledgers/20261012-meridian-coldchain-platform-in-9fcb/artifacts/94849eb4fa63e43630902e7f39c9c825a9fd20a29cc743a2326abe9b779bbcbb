<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Account detail</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@600;650&family=IBM+Plex+Mono:wght@400;500&family=Public+Sans:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg: #F7F7F7;
      --surface: #FFFFFF;
      --text: #202020;
      --text-quiet: #626262;
      --border: #D5D5D5;
      --primary: #A94B1D;
      --status-good: #24704B;
      --status-waiting: #805800;
      --status-refused: #AE2C2C;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      background-color: var(--bg);
      color: var(--text);
      font-family: 'Public Sans', sans-serif;
      font-size: 16px;
      line-height: 1.5;
      min-height: 100vh;
      -webkit-font-smoothing: antialiased;
    }

    /* Typography */
    h1, h2, h3 {
      font-family: 'Hanken+Grotesk', 'Hanken Grotesk', sans-serif;
    }

    .font-mono {
      font-family: 'IBM Plex Mono', monospace;
    }

    /* Motion */
    @keyframes pageEntrance {
      from {
        opacity: 0;
        transform: translateY(6px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes waitingBreathe {
      0%, 100% {
        opacity: 0.7;
      }
      50% {
        opacity: 1;
      }
    }

    .animate-entrance {
      animation: pageEntrance 260ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    .status-dot-waiting {
      display: inline-block;
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background-color: var(--status-waiting);
      animation: waitingBreathe 6s ease-in-out infinite;
    }

    .status-dot-good {
      display: inline-block;
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background-color: var(--status-good);
    }

    .status-dot-refused {
      display: inline-block;
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background-color: var(--status-refused);
    }

    @media (prefers-reduced-motion: reduce) {
      *, ::before, ::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
        scroll-behavior: auto !important;
      }
    }

    /* Header */
    header {
      background-color: var(--surface);
      border-bottom: 1px solid var(--border);
      height: 56px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 32px;
      position: sticky;
      top: 0;
      z-index: 50;
    }

    .header-left {
      display: flex;
      align-items: center;
      gap: 32px;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 12px;
      text-decoration: none;
      color: var(--text);
    }

    .brand-mark {
      width: 24px;
      height: 24px;
      background-color: #202020;
      color: #FFFFFF;
      font-family: 'Hanken Grotesk', sans-serif;
      font-weight: 650;
      font-size: 14px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 2px;
    }

    .brand-name {
      font-family: 'Hanken Grotesk', sans-serif;
      font-weight: 650;
      font-size: 18px;
      letter-spacing: -0.01em;
    }

    nav {
      display: flex;
      align-items: center;
      gap: 24px;
      height: 56px;
    }

    .nav-link {
      text-decoration: none;
      color: var(--text-quiet);
      font-size: 15px;
      font-weight: 500;
      height: 56px;
      display: flex;
      align-items: center;
      border-bottom: 2px solid transparent;
      transition: color 150ms ease, border-color 150ms ease;
    }

    .nav-link:hover {
      color: var(--text);
    }

    .nav-link:focus-visible {
      outline: none;
      box-shadow: 0 0 0 2px var(--primary);
    }

    .nav-link.active {
      color: var(--primary);
      border-bottom-color: var(--primary);
      font-weight: 600;
    }

    .header-right {
      display: flex;
      align-items: center;
      gap: 24px;
    }

    .user-profile {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 14px;
      color: var(--text);
    }

    .user-initials {
      width: 28px;
      height: 28px;
      background-color: #ECECEC;
      color: var(--text);
      font-size: 12px;
      font-weight: 600;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 2px;
      border: 1px solid var(--border);
    }

    .lang-toggle {
      font-size: 13px;
      color: var(--text-quiet);
      font-weight: 500;
      border-left: 1px solid var(--border);
      padding-left: 16px;
    }

    /* Main Container */
    main {
      max-width: 1040px;
      margin: 0 auto;
      padding: 32px 24px 64px 24px;
    }

    .top-actions {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 32px;
    }

    .page-title {
      font-size: 28px;
      font-weight: 650;
      line-height: 1.2;
      letter-spacing: -0.02em;
    }

    .secondary-link-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      height: 48px;
      padding: 0 20px;
      background-color: var(--surface);
      border: 1px solid var(--border);
      border-radius: 2px;
      color: var(--text);
      text-decoration: none;
      font-size: 15px;
      font-weight: 500;
      cursor: pointer;
      transition: background-color 150ms ease, border-color 150ms ease;
    }

    .secondary-link-btn:hover {
      background-color: #F1F1F1;
      border-color: #B5B5B5;
    }

    .secondary-link-btn:focus-visible {
      outline: none;
      box-shadow: 0 0 0 2px var(--primary);
    }

    .secondary-link-btn:active {
      transform: scale(0.99);
    }

    /* Panels */
    .panel {
      background-color: var(--surface);
      border: 1px solid var(--border);
      border-radius: 2px;
      padding: 24px;
      margin-bottom: 32px;
    }

    .panel-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 20px;
      padding-bottom: 16px;
      border-bottom: 1px solid var(--border);
    }

    .section-title {
      font-size: 20px;
      font-weight: 650;
      letter-spacing: -0.01em;
    }

    .section-subtitle {
      font-size: 14px;
      color: var(--text-quiet);
      margin-top: 4px;
    }

    .status-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: 14px;
      font-weight: 500;
    }

    .status-good {
      color: var(--status-good);
    }

    .status-waiting {
      color: var(--status-waiting);
    }

    .status-refused {
      color: var(--status-refused);
    }

    /* Form Layout */
    .form-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 20px;
      margin-bottom: 20px;
    }

    .form-group {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .form-group.full-width {
      grid-column: 1 / -1;
    }

    label {
      font-size: 14px;
      font-weight: 600;
      color: var(--text);
    }

    .form-hint {
      font-size: 13px;
      color: var(--text-quiet);
      margin-top: -4px;
    }

    input[type="text"],
    input[type="email"],
    select {
      height: 48px;
      width: 100%;
      background-color: var(--surface);
      border: 1px solid var(--border);
      border-radius: 2px;
      padding: 0 16px;
      font-family: 'Public Sans', sans-serif;
      font-size: 15px;
      color: var(--text);
      transition: border-color 150ms ease, box-shadow 150ms ease;
    }

    input[type="text"]:focus,
    input[type="email"]:focus,
    select:focus {
      outline: none;
      border-color: var(--primary);
      box-shadow: 0 0 0 2px var(--primary);
    }

    /* Checkbox & Access Groups */
    .access-block {
      background-color: #FAFAFA;
      border: 1px solid var(--border);
      border-radius: 2px;
      padding: 16px;
      margin-bottom: 16px;
    }

    .access-block-title {
      font-size: 15px;
      font-weight: 600;
      margin-bottom: 4px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .access-block-desc {
      font-size: 14px;
      color: var(--text-quiet);
      margin-bottom: 12px;
    }

    .checkbox-group {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .checkbox-label {
      display: flex;
      align-items: flex-start;
      gap: 12px;
      font-size: 15px;
      font-weight: 400;
      color: var(--text);
      cursor: pointer;
    }

    .checkbox-label input[type="checkbox"] {
      width: 18px;
      height: 18px;
      accent-color: var(--primary);
      margin-top: 2px;
      cursor: pointer;
    }

    .checkbox-label input[type="checkbox"]:focus-visible {
      outline: none;
      box-shadow: 0 0 0 2px var(--primary);
    }

    .checkbox-text {
      display: flex;
      flex-direction: column;
    }

    .checkbox-title {
      font-weight: 500;
    }

    .checkbox-detail {
      font-size: 14px;
      color: var(--text-quiet);
    }

    /* Buttons */
    .btn-row {
      display: flex;
      align-items: center;
      justify-content: flex-end;
      gap: 16px;
      margin-top: 24px;
      padding-top: 20px;
      border-top: 1px solid var(--border);
    }

    .btn-primary {
      height: 48px;
      padding: 0 24px;
      background-color: var(--primary);
      border: 1px solid var(--primary);
      border-radius: 2px;
      color: #FFFFFF;
      font-family: 'Public Sans', sans-serif;
      font-size: 15px;
      font-weight: 600;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      transition: background-color 150ms ease, transform 90ms ease;
    }

    .btn-primary:hover {
      background-color: #923E15;
    }

    .btn-primary:focus-visible {
      outline: none;
      box-shadow: 0 0 0 2px var(--primary);
    }

    .btn-primary:active {
      transform: scale(0.99);
    }

    .btn-secondary {
      height: 48px;
      padding: 0 20px;
      background-color: var(--surface);
      border: 1px solid var(--border);
      border-radius: 2px;
      color: var(--text);
      font-family: 'Public Sans', sans-serif;
      font-size: 15px;
      font-weight: 500;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      transition: background-color 150ms ease, border-color 150ms ease;
    }

    .btn-secondary:hover {
      background-color: #F1F1F1;
      border-color: #B5B5B5;
    }

    .btn-secondary:focus-visible {
      outline: none;
      box-shadow: 0 0 0 2px var(--primary);
    }

    .btn-secondary:active {
      transform: scale(0.99);
    }

    .btn-danger {
      height: 48px;
      padding: 0 20px;
      background-color: var(--surface);
      border: 1px solid var(--status-refused);
      border-radius: 2px;
      color: var(--status-refused);
      font-family: 'Public Sans', sans-serif;
      font-size: 15px;
      font-weight: 600;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      transition: background-color 150ms ease, color 150ms ease;
    }

    .btn-danger:hover {
      background-color: #FDF3F3;
    }

    .btn-danger:focus-visible {
      outline: none;
      box-shadow: 0 0 0 2px var(--status-refused);
    }

    .btn-danger:active {
      transform: scale(0.99);
    }

    /* Warning Panel */
    .danger-zone {
      border: 1px solid var(--border);
      border-left: 3px solid var(--status-refused);
      border-radius: 2px;
      background-color: var(--surface);
      padding: 24px;
      margin-bottom: 32px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 24px;
    }

    .danger-content {
      max-width: 680px;
    }

    .danger-title {
      font-size: 16px;
      font-weight: 650;
      color: var(--text);
      margin-bottom: 4px;
    }

    .danger-desc {
      font-size: 14px;
      color: var(--text-quiet);
      line-height: 1.45;
    }

    /* Audit & Governance Details */
    .audit-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px;
      padding: 16px 0 0 0;
    }

    .audit-item {
      display: flex;
      flex-direction: column;
      gap: 2px;
    }

    .audit-label {
      font-size: 13px;
      color: var(--text-quiet);
    }

    .audit-value {
      font-size: 15px;
      font-weight: 500;
      color: var(--text);
    }

    .audit-time {
      font-size: 13px;
      color: var(--text-quiet);
    }
  </style>
</head>
<body>

  <!-- Top Navigation Header -->
  <header>
    <div class="header-left">
      <a href="#" class="brand">
        <div class="brand-mark">M</div>
        <span class="brand-name">Meridian</span>
      </a>
      <nav>
        <a href="#" class="nav-link">Products</a>
        <a href="#" class="nav-link">Organisations</a>
        <a href="#" class="nav-link active">Accounts</a>
        <a href="#" class="nav-link">Audit trail</a>
        <a href="#" class="nav-link">Reports</a>
      </nav>
    </div>

    <div class="header-right">
      <div class="user-profile">
        <div class="user-initials">MV</div>
        <span>Marcus Vale · System Administrator</span>
      </div>
      <div class="lang-toggle">
        EN / العربية
      </div>
    </div>
  </header>

  <!-- Main Content Area -->
  <main class="animate-entrance">
    
    <!-- Title & Top Action -->
    <div class="top-actions">
      <h1 class="page-title">Account detail</h1>
      <button type="button" class="secondary-link-btn">Accounts</button>
    </div>

    <!-- Account Overview Panel -->
    <section class="panel">
      <div class="panel-header">
        <div>
          <h2 class="section-title">Leila Haddad</h2>
          <p class="section-subtitle">Account specification and identity controls</p>
        </div>
        <div class="status-badge status-good">
          <span class="status-dot-good"></span>
          <span>good active</span>
        </div>
      </div>

      <!-- Compact Form for Account Identity & Roles -->
      <form onsubmit="return false;">
        <div class="form-grid">
          <div class="form-group">
            <label for="fullName">Full name</label>
            <input type="text" id="fullName" value="Leila Haddad">
          </div>

          <div class="form-group">
            <label for="emailAddress">Email address</label>
            <input type="email" id="emailAddress" value="leila.haddad@meridian.example">
          </div>

          <div class="form-group">
            <label for="assignedRole">System role</label>
            <select id="assignedRole">
              <option value="Warehouse Operator" selected>Warehouse Operator</option>
              <option value="Quality Officer">Quality Officer</option>
              <option value="Quality Manager">Quality Manager</option>
              <option value="Dispatcher">Dispatcher</option>
              <option value="Driver">Driver</option>
              <option value="Auditor">Auditor</option>
              <option value="Cedar Health Buyer">Cedar Health Buyer</option>
              <option value="Cedar Health Customer Administrator">Cedar Health Customer Administrator</option>
              <option value="System Administrator">System Administrator</option>
            </select>
            <span class="form-hint">Assign roles returned by service authority</span>
          </div>

          <div class="form-group">
            <label for="primaryDepot">Primary facility</label>
            <select id="primaryDepot">
              <option value="North Quay Warehouse" selected>North Quay Warehouse</option>
              <option value="Cedar Health">Cedar Health</option>
            </select>
            <span class="form-hint">Determines home physical inventory boundary</span>
          </div>
        </div>

        <!-- North Quay Warehouse Access Block -->
        <div class="access-block">
          <div class="access-block-title">
            <span>North Quay warehouse access</span>
            <span class="status-badge status-good">
              <span class="status-dot-good"></span>
              <span>good active</span>
            </span>
          </div>
          <p class="access-block-desc">Assignable facility clearances and operations scoped to North Quay Depot</p>
          <div class="checkbox-group">
            <label class="checkbox-label">
              <input type="checkbox" checked>
              <div class="checkbox-text">
                <span class="checkbox-title">Cold Room C2 &amp; Rack 4 stock operations</span>
                <span class="checkbox-detail">Intake verification, opening stock submission, unit moves and BioTherm box packaging</span>
              </div>
            </label>
            <label class="checkbox-label">
              <input type="checkbox" checked>
              <div class="checkbox-text">
                <span class="checkbox-title">Inbound shipment logger data upload</span>
                <span class="checkbox-detail">Sensitech / Berlinger logger uploads and receipt dock custody check</span>
              </div>
            </label>
            <label class="checkbox-label">
              <input type="checkbox">
              <div class="checkbox-text">
                <span class="checkbox-title">Physical stock destruction witnessing</span>
                <span class="checkbox-detail">Secondary witness authority for unviable rejected stock disposal</span>
              </div>
            </label>
          </div>
        </div>

        <!-- Cedar Health Organisation Access Block -->
        <div class="access-block">
          <div class="access-block-title">
            <span>Cedar Health organisation access</span>
            <span class="status-badge" style="color: var(--text-quiet);">
              <span>not assigned</span>
            </span>
          </div>
          <p class="access-block-desc">Applicable only to authorized external customer and consignee personnel</p>
          <div class="checkbox-group">
            <label class="checkbox-label">
              <input type="checkbox">
              <div class="checkbox-text">
                <span class="checkbox-title">Consignment order procurement (Cedar Clinic, 42 River Road)</span>
                <span class="checkbox-detail">Authorises order placement and split-delivery selection for 90-day shelf-life stock</span>
              </div>
            </label>
            <label class="checkbox-label">
              <input type="checkbox">
              <div class="checkbox-text">
                <span class="checkbox-title">Customer administrator permissions</span>
                <span class="checkbox-detail">Manage team members and consignee destination addresses</span>
              </div>
            </label>
            <label class="checkbox-label">
              <input type="checkbox">
              <div class="checkbox-text">
                <span class="checkbox-title">Recall response &amp; clinical reconciliation confirmation</span>
                <span class="checkbox-detail">Acknowledge recall notices and report unreturned or quarantined clinic quantities</span>
              </div>
            </label>
          </div>
        </div>

        <!-- Primary Form Action -->
        <div class="btn-row">
          <button type="button" class="btn-secondary">Cancel</button>
          <button type="button" class="btn-primary">Save account</button>
        </div>
      </form>
    </section>

    <!-- Irreversible Deactivate Account Zone -->
    <div class="danger-zone">
      <div class="danger-content">
        <h3 class="danger-title">Deactivate account</h3>
        <p class="danger-desc">
          Warning: Deactivating Leila Haddad revokes access to North Quay Warehouse intake, stock moves, and pack-box execution. Sealed historical custody records and immutable receipts will remain preserved in the audit log.
        </p>
      </div>
      <div>
        <button type="button" class="btn-danger">Deactivate account</button>
      </div>
    </div>

    <!-- Governance, Creator & Last Changer Panel -->
    <section class="panel">
      <div class="panel-header" style="margin-bottom: 0; padding-bottom: 12px;">
        <div>
          <h2 class="section-title">Governance &amp; audit history</h2>
          <p class="section-subtitle">Account creation and modification record</p>
        </div>
        <div class="status-badge status-good">
          <span class="status-dot-good"></span>
          <span>good recorded</span>
        </div>
      </div>

      <div class="audit-grid">
        <div class="audit-item">
          <span class="audit-label">Created by</span>
          <span class="audit-value">Marcus Vale · System Administrator</span>
          <span class="audit-time font-mono">12 May 2026 08:30 BST</span>
        </div>

        <div class="audit-item">
          <span class="audit-label">Last changed by</span>
          <span class="audit-value">Marcus Vale · System Administrator</span>
          <span class="audit-time font-mono">14 May 2026 09:15 BST</span>
        </div>
      </div>
    </section>

  </main>

</body>
</html>
