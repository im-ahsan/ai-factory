<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Signed decision</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@600;650;700&family=IBM+Plex+Mono:wght@400;500;600&family=Public+Sans:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg: #F7F7F7;
      --surface: #FFFFFF;
      --text: #202020;
      --text-muted: #626262;
      --border: #D5D5D5;
      --primary: #A94B1D;
      --good: #24704B;
      --waiting: #805800;
      --failed: #AE2C2C;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      background-color: var(--bg);
      color: var(--text);
      font-family: 'Public Sans', sans-serif;
      font-size: 16px;
      line-height: 1.5;
      -webkit-font-smoothing: antialiased;
      min-height: 100vh;
    }

    /* Motion tokens & keyframes */
    @keyframes entranceFadeUp {
      0% {
        opacity: 0;
        transform: translateY(12px);
      }
      100% {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes savedHandoff {
      0% {
        opacity: 0.6;
        transform: translateY(8px);
      }
      100% {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes waitingBreathe {
      0%, 100% {
        opacity: 0.7;
      }
      50% {
        opacity: 1;
      }
    }

    .animate-entrance {
      animation: entranceFadeUp 320ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    .status-handoff-motion {
      animation: savedHandoff 260ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    .waiting-dot-breathe {
      animation: waitingBreathe 6s ease-in-out infinite;
    }

    @media (prefers-reduced-motion: reduce) {
      *, ::before, ::after {
        animation-delay: -1ms !important;
        animation-duration: 1ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0s !important;
        transition-delay: 0s !important;
      }
    }

    /* Header */
    header {
      background: var(--surface);
      border-bottom: 1px solid var(--border);
      height: 56px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 32px;
    }

    .header-left {
      display: flex;
      align-items: center;
      gap: 32px;
      height: 100%;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 8px;
      text-decoration: none;
      color: var(--text);
    }

    .brand-logo {
      width: 20px;
      height: 20px;
      background: var(--text);
      color: #FFFFFF;
      font-family: 'Hanken Grotesk', sans-serif;
      font-weight: 700;
      font-size: 13px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 2px;
      line-height: 1;
    }

    .brand-name {
      font-family: 'Hanken Grotesk', sans-serif;
      font-weight: 650;
      font-size: 16px;
      letter-spacing: -0.01em;
    }

    .header-nav {
      display: flex;
      align-items: center;
      height: 100%;
    }

    .nav-item {
      display: flex;
      align-items: center;
      height: 100%;
      padding: 0 4px;
      font-family: 'Public Sans', sans-serif;
      font-size: 15px;
      font-weight: 500;
      color: var(--primary);
      text-decoration: none;
      border-bottom: 2px solid var(--primary);
      transition: color 150ms ease;
    }

    .header-right {
      display: flex;
      align-items: center;
      gap: 24px;
    }

    .user-info {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .user-avatar {
      width: 28px;
      height: 28px;
      background: #EBEBEB;
      color: var(--text);
      font-family: 'IBM Plex Mono', monospace;
      font-size: 12px;
      font-weight: 500;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 2px;
      border: 1px solid var(--border);
    }

    .user-details {
      font-size: 14px;
      color: var(--text);
    }

    .lang-switch {
      font-size: 14px;
      color: var(--text-muted);
    }

    /* Layout */
    main {
      max-width: 1120px;
      margin: 0 auto;
      padding: 32px 32px 64px 32px;
    }

    .page-title {
      font-family: 'Hanken Grotesk', sans-serif;
      font-size: 28px;
      font-weight: 650;
      line-height: 1.25;
      margin-bottom: 32px;
      color: var(--text);
    }

    .section-title {
      font-family: 'Hanken Grotesk', sans-serif;
      font-size: 20px;
      font-weight: 650;
      line-height: 1.3;
      margin-bottom: 16px;
      color: var(--text);
    }

    .sub-heading {
      font-family: 'Hanken Grotesk', sans-serif;
      font-size: 16px;
      font-weight: 600;
      line-height: 1.4;
      margin-bottom: 8px;
      color: var(--text);
    }

    /* Panel */
    .panel {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 2px;
      padding: 16px;
      margin-bottom: 32px;
    }

    .panel-inset {
      background: #FAFAFA;
      border: 1px solid var(--border);
      border-radius: 2px;
      padding: 16px;
      margin-top: 16px;
    }

    /* Grid Helpers */
    .grid-2col {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 24px;
    }

    .grid-3col {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 16px;
    }

    .grid-4col {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 16px;
    }

    /* Metadata rows */
    .meta-group {
      display: flex;
      flex-direction: column;
      gap: 4px;
    }

    .meta-label {
      font-size: 14px;
      color: var(--text-muted);
    }

    .meta-value {
      font-size: 16px;
      color: var(--text);
      font-weight: 500;
    }

    .mono {
      font-family: 'IBM Plex Mono', monospace;
    }

    /* Status indicators */
    .status {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-weight: 500;
    }

    .status-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      display: inline-block;
    }

    .status-good {
      color: var(--good);
    }
    .status-good .status-dot {
      background-color: var(--good);
    }

    .status-waiting {
      color: var(--waiting);
    }
    .status-waiting .status-dot {
      background-color: var(--waiting);
    }

    .status-failed {
      color: var(--failed);
    }
    .status-failed .status-dot {
      background-color: var(--failed);
    }

    /* Tables */
    .table-container {
      width: 100%;
      border-top: 1px solid var(--border);
      margin-top: 16px;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      text-align: left;
    }

    th {
      font-size: 14px;
      font-weight: 500;
      color: var(--text-muted);
      height: 48px;
      border-bottom: 1px solid var(--border);
      padding: 0 16px;
    }

    td {
      font-size: 15px;
      height: 48px;
      border-bottom: 1px solid var(--border);
      padding: 0 16px;
      vertical-align: middle;
    }

    tr:last-child td {
      border-bottom: none;
    }

    /* Forms & Fields */
    .field-group {
      display: flex;
      flex-direction: column;
      gap: 8px;
      margin-bottom: 16px;
    }

    label {
      font-size: 14px;
      font-weight: 500;
      color: var(--text);
    }

    .field {
      height: 48px;
      width: 100%;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 2px;
      padding: 0 16px;
      font-family: 'Public Sans', sans-serif;
      font-size: 16px;
      color: var(--text);
      outline: none;
      transition: border-color 150ms ease, box-shadow 150ms ease;
    }

    textarea.field {
      height: auto;
      min-height: 96px;
      padding: 12px 16px;
      line-height: 1.5;
      resize: vertical;
    }

    .field:focus {
      border-color: var(--primary);
      outline: 2px solid var(--primary);
      outline-offset: -1px;
    }

    /* Buttons */
    .btn {
      height: 48px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 0 24px;
      font-family: 'Public Sans', sans-serif;
      font-size: 16px;
      font-weight: 500;
      border-radius: 2px;
      cursor: pointer;
      text-decoration: none;
      transition: background-color 150ms ease, border-color 150ms ease, transform 90ms ease;
      white-space: nowrap;
    }

    .btn:active {
      transform: scale(0.98);
    }

    .btn:focus {
      outline: 2px solid var(--primary);
      outline-offset: 2px;
    }

    .btn-primary {
      background: var(--primary);
      border: 1px solid var(--primary);
      color: #FFFFFF;
    }

    .btn-primary:hover {
      background: #933E15;
      border-color: #933E15;
    }

    .btn-secondary {
      background: var(--surface);
      border: 1px solid var(--border);
      color: var(--text);
    }

    .btn-secondary:hover {
      background: #F0F0F0;
      border-color: #C0C0C0;
    }

    /* Card callouts */
    .callout {
      border-left: 3px solid var(--border);
      padding: 12px 16px;
      background: #FAFAFA;
      margin: 16px 0;
    }

    .callout-title {
      font-size: 14px;
      font-weight: 600;
      color: var(--text);
      margin-bottom: 4px;
    }

    .callout-body {
      font-size: 14px;
      color: var(--text-muted);
    }

    /* Divider */
    .divider {
      height: 1px;
      background: var(--border);
      margin: 16px 0;
    }

    .tag {
      display: inline-block;
      padding: 2px 8px;
      font-size: 14px;
      border-radius: 2px;
      background: #EFEFEF;
      color: var(--text);
      font-family: 'IBM Plex Mono', monospace;
    }
  </style>
</head>
<body>

  <!-- Persistent Header -->
  <header>
    <div class="header-left">
      <a href="#" class="brand">
        <span class="brand-logo">M</span>
        <span class="brand-name">Meridian</span>
      </a>
      <nav class="header-nav">
        <a href="#" class="nav-item">Quality cases</a>
      </nav>
    </div>
    <div class="header-right">
      <div class="user-info">
        <span class="user-avatar">OS</span>
        <span class="user-details">Omar Saleh · Quality Officer</span>
      </div>
      <span class="lang-switch">EN / العربية</span>
    </div>
  </header>

  <!-- Main Content Area -->
  <main class="animate-entrance">
    <!-- The page's single heading -->
    <h1 class="page-title">Signed decision</h1>

    <!-- 1. Read-only Original Signed Decision Panel -->
    <section class="panel">
      <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 16px;">
        <div>
          <h2 class="section-title" style="margin-bottom: 4px;">Original signed decision</h2>
          <p class="meta-label">Immutable disposition record for Quality Case <span class="tag">Q-88</span></p>
        </div>
        <div style="text-align: right;">
          <div class="meta-label">Signed timestamp</div>
          <div class="meta-value mono">14 May 2026 08:45 BST</div>
        </div>
      </div>

      <!-- Signer & Core Recommendation -->
      <div class="grid-3col" style="margin-bottom: 16px;">
        <div class="meta-group">
          <span class="meta-label">Signer & authorization</span>
          <span class="meta-value">Omar Saleh · Quality Officer</span>
          <span class="meta-label">North Quay Facility</span>
        </div>
        <div class="meta-group">
          <span class="meta-label">Recommendation</span>
          <span class="meta-value" style="font-weight: 600;">Hold remaining upper tier & quarantine excursion units</span>
        </div>
        <div class="meta-group">
          <span class="meta-label">Verification method</span>
          <span class="meta-value">Account credentials signed</span>
          <span class="meta-label mono">ID: QS-20260514-088</span>
        </div>
      </div>

      <!-- Reason for Signed Decision -->
      <div class="field-group" style="margin-bottom: 16px;">
        <span class="meta-label">Reason</span>
        <div style="background: #FAFAFA; border: 1px solid var(--border); padding: 12px 16px; border-radius: 2px; font-size: 15px; color: var(--text);">
          North Quay logger recorded 9.1°C excursion on handling unit HU-82 for 22 minutes against 30m tier allowance (22m used, 8m remaining). Profile v3 permitted 2–8°C threshold exceeded; 10 packs isolated to quarantine, 5 packs placed On Hold pending secondary assay, 2 packs confirmed rejected awaiting destruction, and 3 packs confirmed expired. Unresolved reading gap contains no estimated temperature or tier charge.
        </div>
      </div>

      <div class="divider"></div>

      <!-- Dispositions: Earlier and Current together -->
      <h3 class="sub-heading">Earlier and current dispositions</h3>
      <p class="meta-label" style="margin-bottom: 12px;">Comparative disposition states showing baseline intake and signed quality rulings together.</p>

      <div class="table-container">
        <table>
          <thead>
            <tr>
              <th>Handling unit & lot</th>
              <th>Earlier disposition</th>
              <th>Current signed disposition</th>
              <th>Telemetry & allowance record</th>
              <th>Status</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>
                <span class="mono" style="font-weight: 500;">HU-81</span> · Lot <span class="mono">IG-2511</span>
              </td>
              <td>100 packs received intake</td>
              <td>60 available, 40 allocated (O-299 & O-301)</td>
              <td>Steady <span class="mono">4.4°C</span> · 0m allowance used</td>
              <td><span class="status status-good"><span class="status-dot"></span>good</span></td>
            </tr>
            <tr>
              <td>
                <span class="mono" style="font-weight: 500;">HU-82</span> · Lot <span class="mono">IG-2511</span>
              </td>
              <td>20 packs dock arrival quarantined</td>
              <td>10 quarantined, 5 On Hold, 2 Rejected, 3 Expired</td>
              <td><span class="mono">9.1°C</span> for <span class="mono">22m</span> · 8m remaining</td>
              <td><span class="status status-waiting"><span class="status-dot waiting-dot-breathe"></span>waiting</span></td>
            </tr>
          </tbody>
        </table>
      </div>

      <div class="divider"></div>

      <!-- Resulting Stock, Order O-299, and Route R-204 Statuses -->
      <h3 class="sub-heading">Resulting stock, order and route impacts</h3>
      <div class="grid-3col" style="margin-top: 12px;">
        <div class="meta-group">
          <span class="meta-label">Resulting stock balance</span>
          <span class="meta-value mono">124 packs total on hand</span>
          <span class="meta-label">60 available · 40 allocated · 10 quarantined · 5 On Hold · 2 Rejected · 4 Recalled · 3 Expired</span>
        </div>
        <div class="meta-group">
          <span class="meta-label">Order O-299 status</span>
          <span class="meta-value">
            <span class="status status-good"><span class="status-dot"></span>good</span> (eligible)
          </span>
          <span class="meta-label">20 packs IG-2511 allocated in B-701 (12) & B-702 (8)</span>
        </div>
        <div class="meta-group">
          <span class="meta-label">Route R-204 status</span>
          <span class="meta-value">
            <span class="status status-good"><span class="status-dot"></span>good</span> (confirmed)
          </span>
          <span class="meta-label">Planned departure <span class="mono">14 May 15:00 BST</span> · Tariq Mansour</span>
        </div>
      </div>
    </section>

    <!-- 2. Supersede Decision Action & Distinct Form State Beneath -->
    <section class="panel">
      <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 16px;">
        <div>
          <h2 class="section-title" style="margin-bottom: 4px;">Supersede decision</h2>
          <p class="meta-label">Open a distinct supersede record beneath the immutable original. Text of the signed original is not editable in place.</p>
        </div>
        <div>
          <span class="status status-waiting"><span class="status-dot waiting-dot-breathe"></span>waiting</span>
        </div>
      </div>

      <div class="callout">
        <div class="callout-title">Regulatory & assurance rule</div>
        <div class="callout-body">
          Signed quality decisions cannot be edited in place. Any revised recommendation creates a subsequent cryptographic supersede record referencing Case Q-88. An opposing-recommendation justification is strictly required if overriding the previous quarantine disposition.
        </div>
      </div>

      <!-- Form for superseding decision -->
      <form onsubmit="return false;" style="margin-top: 24px;">
        <div class="grid-2col">
          <div class="field-group">
            <label for="new-recommendation">New recommendation</label>
            <select id="new-recommendation" class="field">
              <option value="release">Release HU-82 remaining 15 packs under tier v3 exception</option>
              <option value="quarantine" selected>Re-classify HU-82: 15 packs to absolute quarantine pending destruction</option>
              <option value="extended-hold">Extend Hold period for further laboratory stability assay</option>
            </select>
          </div>
          <div class="field-group">
            <label for="effective-profile">Applicable thermal profile</label>
            <select id="effective-profile" class="field">
              <option value="v3">Profile v3 (Permitted 2.0°C–8.0°C, 30m upper tier allowance)</option>
              <option value="v4">Proposed Profile v4 (Takes effect today or later)</option>
            </select>
          </div>
        </div>

        <div class="field-group">
          <label for="new-reason">New reason (required)</label>
          <textarea id="new-reason" class="field" placeholder="Provide full technical rationale for superseding the existing signed decision..."></textarea>
        </div>

        <div class="field-group">
          <label for="opposing-justification">Opposing-recommendation justification</label>
          <textarea id="opposing-justification" class="field" placeholder="Required when the new recommendation opposes or relaxes previous quarantine or hold dispositions..."></textarea>
        </div>

        <div class="divider"></div>

        <h3 class="sub-heading" style="margin-bottom: 12px;">Sign-in method identity confirmation</h3>
        <p class="meta-label" style="margin-bottom: 16px;">Confirm authorization using Omar Saleh's authenticated Meridian account credentials before applying digital signature.</p>

        <div class="grid-2col" style="align-items: flex-end;">
          <div class="field-group" style="margin-bottom: 0;">
            <label for="auth-password">Account password or one-time security token</label>
            <input type="password" id="auth-password" class="field" placeholder="Enter account password">
          </div>
          <div style="display: flex; gap: 16px; align-items: center; height: 48px;">
            <button type="button" class="btn btn-primary" style="flex: 1;">
              Sign & supersede decision
            </button>
            <a href="#" class="btn btn-secondary">Quality review</a>
          </div>
        </div>
      </form>
    </section>

  </main>

</body>
</html>
