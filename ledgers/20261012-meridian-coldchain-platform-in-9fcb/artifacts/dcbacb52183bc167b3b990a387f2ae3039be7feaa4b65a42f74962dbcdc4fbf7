<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Reports</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@600;650;700&family=IBM+Plex+Mono:wght@400;500;600&family=Public+Sans:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    /* Reset & Base */
    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }
    body {
      background-color: #F7F7F7;
      color: #202020;
      font-family: 'Public Sans', sans-serif;
      font-size: 16px;
      line-height: 1.5;
      min-height: 100vh;
      -webkit-font-smoothing: antialiased;
    }
    
    /* Typography */
    h1, h2, h3, .heading {
      font-family: 'Hanken Grotesk', sans-serif;
      color: #202020;
    }
    h1 {
      font-size: 28px;
      font-weight: 650;
      line-height: 1.2;
    }
    h2 {
      font-size: 20px;
      font-weight: 650;
      line-height: 1.3;
    }
    h3 {
      font-size: 16px;
      font-weight: 600;
      line-height: 1.4;
    }
    .text-quieter {
      color: #626262;
    }
    .mono {
      font-family: 'IBM Plex Mono', monospace;
    }
    
    /* Layout */
    .header {
      background-color: #FFFFFF;
      border-bottom: 1px solid #D5D5D5;
      height: 64px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 32px;
    }
    .header-left {
      display: flex;
      align-items: center;
      gap: 32px;
    }
    .brand-wrap {
      display: flex;
      align-items: center;
      gap: 10px;
      text-decoration: none;
      color: #202020;
    }
    .brand-logo-sq {
      width: 28px;
      height: 28px;
      background-color: #202020;
      border-radius: 2px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #FFFFFF;
      font-family: 'Hanken Grotesk', sans-serif;
      font-weight: 700;
      font-size: 16px;
    }
    .brand-name {
      font-family: 'Hanken Grotesk', sans-serif;
      font-weight: 650;
      font-size: 18px;
      letter-spacing: -0.01em;
    }
    .nav-menu {
      display: flex;
      align-items: center;
      gap: 24px;
      list-style: none;
    }
    .nav-item a {
      text-decoration: none;
      color: #626262;
      font-size: 15px;
      font-weight: 500;
      padding: 20px 0;
      position: relative;
      display: inline-block;
      transition: color 150ms ease;
    }
    .nav-item a:hover {
      color: #202020;
    }
    .nav-item a:focus {
      outline: 2px solid #A94B1D;
      outline-offset: 4px;
    }
    .nav-item.active a {
      color: #A94B1D;
      font-weight: 600;
    }
    .nav-item.active a::after {
      content: '';
      position: absolute;
      bottom: -1px;
      left: 0;
      right: 0;
      height: 2px;
      background-color: #A94B1D;
    }
    
    .header-right {
      display: flex;
      align-items: center;
      gap: 24px;
    }
    .user-profile {
      display: flex;
      align-items: center;
      gap: 10px;
      font-size: 14px;
    }
    .user-avatar-initials {
      width: 28px;
      height: 28px;
      background-color: #F7F7F7;
      border: 1px solid #D5D5D5;
      border-radius: 2px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: 'IBM Plex Mono', monospace;
      font-size: 12px;
      font-weight: 500;
      color: #202020;
    }
    .lang-switcher {
      font-size: 14px;
      color: #626262;
      border-left: 1px solid #D5D5D5;
      padding-left: 16px;
    }
    
    /* Main Content */
    .container {
      max-width: 1440px;
      margin: 0 auto;
      padding: 32px;
      display: flex;
      flex-direction: column;
      gap: 32px;
    }
    
    .page-title-row {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
    }
    
    /* Panels */
    .panel {
      background-color: #FFFFFF;
      border: 1px solid #D5D5D5;
      border-radius: 2px;
      padding: 24px;
      display: flex;
      flex-direction: column;
      gap: 16px;
    }
    
    /* Filter Bar */
    .filter-bar {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      gap: 16px;
      flex-wrap: wrap;
    }
    .filter-controls {
      display: flex;
      align-items: flex-end;
      gap: 16px;
      flex-wrap: wrap;
    }
    .form-group {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }
    .form-label {
      font-size: 14px;
      font-weight: 500;
      color: #626262;
    }
    .field-input, .field-select {
      height: 48px;
      background-color: #FFFFFF;
      border: 1px solid #D5D5D5;
      border-radius: 2px;
      padding: 0 16px;
      font-family: 'Public Sans', sans-serif;
      font-size: 15px;
      color: #202020;
      min-width: 220px;
      transition: border-color 150ms ease;
    }
    .field-input.mono, .field-select.mono {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 14px;
    }
    .field-input:focus, .field-select:focus {
      outline: 2px solid #A94B1D;
      outline-offset: -1px;
      border-color: #A94B1D;
    }
    
    /* Buttons */
    .btn {
      height: 48px;
      padding: 0 24px;
      border-radius: 2px;
      font-family: 'Public Sans', sans-serif;
      font-size: 15px;
      font-weight: 500;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      cursor: pointer;
      text-decoration: none;
      transition: background-color 150ms ease, border-color 150ms ease, transform 90ms ease;
    }
    .btn:focus {
      outline: 2px solid #A94B1D;
      outline-offset: 2px;
    }
    .btn:active {
      transform: scale(0.98);
    }
    .btn-secondary {
      background-color: #FFFFFF;
      border: 1px solid #D5D5D5;
      color: #202020;
    }
    .btn-secondary:hover {
      background-color: #F7F7F7;
      border-color: #C0C0C0;
    }
    
    /* KPI Headline Block */
    .kpi-row {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 16px;
    }
    .kpi-card {
      background-color: #FFFFFF;
      border: 1px solid #D5D5D5;
      border-radius: 2px;
      padding: 20px;
      display: flex;
      flex-direction: column;
      gap: 8px;
    }
    .kpi-title {
      font-size: 14px;
      color: #626262;
      font-weight: 500;
    }
    .kpi-headline {
      font-family: 'Hanken Grotesk', sans-serif;
      font-size: 24px;
      font-weight: 650;
      color: #202020;
    }
    .kpi-sub {
      font-size: 14px;
      display: flex;
      align-items: center;
      gap: 6px;
    }
    
    /* Status indicators */
    .status-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: 14px;
      font-weight: 500;
    }
    .status-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      flex-shrink: 0;
    }
    .status-good {
      color: #24704B;
    }
    .status-good .status-dot {
      background-color: #24704B;
    }
    .status-waiting {
      color: #805800;
    }
    .status-waiting .status-dot {
      background-color: #805800;
      animation: waitingBreathe 6s ease-in-out infinite;
    }
    .status-refused, .status-failed {
      color: #AE2C2C;
    }
    .status-refused .status-dot, .status-failed .status-dot {
      background-color: #AE2C2C;
    }
    
    /* Dense Tables */
    .table-container {
      width: 100%;
      overflow-x: auto;
      border-top: 1px solid #D5D5D5;
    }
    table {
      width: 100%;
      border-collapse: collapse;
      text-align: left;
    }
    thead th {
      height: 48px;
      padding: 0 16px;
      font-size: 14px;
      font-weight: 600;
      color: #626262;
      border-bottom: 1px solid #D5D5D5;
      background-color: #FFFFFF;
      white-space: nowrap;
    }
    tbody tr {
      height: 48px;
      border-bottom: 1px solid #D5D5D5;
      transition: background-color 120ms ease;
    }
    tbody tr:hover {
      background-color: #FAFAFA;
    }
    tbody td {
      padding: 0 16px;
      font-size: 15px;
      color: #202020;
      vertical-align: middle;
      white-space: nowrap;
    }
    
    .panel-header-desc {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      padding-bottom: 4px;
    }
    
    /* Responsive Grid for 2 panels */
    .two-col-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 32px;
    }
    
    /* Animations */
    @keyframes entranceFade {
      from {
        opacity: 0;
        transform: translateY(6px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
    
    @keyframes waitingBreathe {
      0%, 100% {
        opacity: 0.7;
      }
      50% {
        opacity: 1;
      }
    }
    
    .animated-entrance {
      animation: entranceFade 300ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
    
    /* Saved handoff signature motion */
    .saved-handoff-sync {
      animation: savedHandoff 260ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
    @keyframes savedHandoff {
      from {
        opacity: 0.6;
        transform: translateY(8px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
    
    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
      }
    }
  </style>
</head>
