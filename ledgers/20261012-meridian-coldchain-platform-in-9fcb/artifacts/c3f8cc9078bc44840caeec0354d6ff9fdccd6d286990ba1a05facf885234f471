<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Place order</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@600;650;700&family=IBM+Plex+Mono:wght@400;500;600&family=Public+Sans:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    /* Reset & base tokens */
    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }
    body {
      background-color: #F7F7F7;
      color: #202020;
      font-family: 'Public Sans', sans-serif;
      font-size: 16px;
      line-height: 1.5;
      -webkit-font-smoothing: antialiased;
    }

    /* Typography */
    h1, .heading-main {
      font-family: 'Hanken Grotesk', sans-serif;
      font-size: 28px;
      font-weight: 650;
      line-height: 1.25;
      color: #202020;
    }
    h2, .heading-section {
      font-family: 'Hanken Grotesk', sans-serif;
      font-size: 20px;
      font-weight: 650;
      line-height: 1.3;
      color: #202020;
    }
    h3, .heading-sm {
      font-family: 'Hanken Grotesk', sans-serif;
      font-size: 16px;
      font-weight: 600;
      line-height: 1.4;
      color: #202020;
    }
    .text-quieter {
      color: #626262;
    }
    .mono {
      font-family: 'IBM Plex Mono', monospace;
    }

    /* Semantic Statuses */
    .status-good {
      color: #24704B;
      font-weight: 500;
    }
    .status-good::before {
      content: "•";
      margin-right: 6px;
      color: #24704B;
    }
    .status-waiting {
      color: #805800;
      font-weight: 500;
    }
    .status-waiting::before {
      content: "•";
      margin-right: 6px;
      color: #805800;
    }
    .status-failed {
      color: #AE2C2C;
      font-weight: 500;
    }
    .status-failed::before {
      content: "•";
      margin-right: 6px;
      color: #AE2C2C;
    }

    /* Layout & Panels */
    .site-header {
      background-color: #FFFFFF;
      border-bottom: 1px solid #D5D5D5;
      height: 64px;
      padding: 0 32px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .header-left {
      display: flex;
      align-items: center;
      gap: 32px;
    }
    .brand-mark {
      display: flex;
      align-items: center;
      gap: 12px;
      text-decoration: none;
      color: #202020;
    }
    .brand-square {
      width: 28px;
      height: 28px;
      background-color: #202020;
      color: #FFFFFF;
      font-family: 'Hanken Grotesk', sans-serif;
      font-weight: 700;
      font-size: 16px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 2px;
    }
    .brand-name {
      font-family: 'Hanken Grotesk', sans-serif;
      font-weight: 700;
      font-size: 18px;
      letter-spacing: -0.01em;
    }
    .nav-menu {
      display: flex;
      align-items: center;
      gap: 8px;
      list-style: none;
    }
    .nav-item {
      padding: 8px 16px;
      text-decoration: none;
      color: #626262;
      font-size: 15px;
      font-weight: 500;
      border-radius: 2px;
      transition: color 150ms ease, background-color 150ms ease;
    }
    .nav-item:hover {
      color: #202020;
      background-color: #F7F7F7;
    }
    .nav-item.active {
      color: #A94B1D;
      font-weight: 600;
      border-bottom: 2px solid #A94B1D;
      border-radius: 0;
      padding-bottom: 6px;
    }
    .header-right {
      display: flex;
      align-items: center;
      gap: 20px;
    }
    .user-profile {
      display: flex;
      align-items: center;
      gap: 10px;
      font-size: 14px;
      color: #202020;
    }
    .initials-avatar {
      width: 32px;
      height: 32px;
      background-color: #F7F7F7;
      border: 1px solid #D5D5D5;
      border-radius: 2px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: 'IBM Plex Mono', monospace;
      font-size: 13px;
      font-weight: 600;
      color: #202020;
    }
    .lang-switcher {
      font-size: 14px;
      color: #626262;
      border-left: 1px solid #D5D5D5;
      padding-left: 20px;
    }

    .main-container {
      max-width: 1040px;
      margin: 0 auto;
      padding: 32px 24px 64px 24px;
    }
    .page-title-row {
      margin-bottom: 32px;
      display: flex;
      align-items: baseline;
      justify-content: space-between;
    }

    .panel {
      background-color: #FFFFFF;
      border: 1px solid #D5D5D5;
      border-radius: 2px;
      padding: 16px;
      margin-bottom: 32px;
    }

    /* Grid & Form fields */
    .form-grid-2 {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 24px;
      margin-top: 16px;
    }
    .field-group {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }
    .field-label {
      font-size: 14px;
      font-weight: 600;
      color: #202020;
    }
    .field-hint {
      font-size: 14px;
      color: #626262;
    }
    .input-field, .select-field {
      height: 48px;
      background-color: #FFFFFF;
      border: 1px solid #D5D5D5;
      border-radius: 2px;
      padding: 0 16px;
      font-family: 'Public Sans', sans-serif;
      font-size: 16px;
      color: #202020;
      width: 100%;
      outline: none;
      transition: border-color 150ms ease, box-shadow 150ms ease;
    }
    .input-field.mono {
      font-family: 'IBM Plex Mono', monospace;
    }
    .input-field:focus, .select-field:focus {
      border-color: #A94B1D;
      box-shadow: 0 0 0 1px #A94B1D;
    }

    /* Product Line Item */
    .product-row-panel {
      display: grid;
      grid-template-columns: 160px 1fr 140px;
      gap: 20px;
      align-items: center;
      padding: 16px 0;
      border-bottom: 1px solid #D5D5D5;
    }
    .product-photo {
      width: 160px;
      height: 120px;
      object-fit: cover;
      border: 1px solid #D5D5D5;
      border-radius: 2px;
      aspect-ratio: 4 / 3;
      background-color: #FFFFFF;
    }
    .product-details {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }
    .spec-line {
      font-size: 14px;
      color: #626262;
    }

    /* Radio choices */
    .radio-group {
      display: flex;
      flex-direction: column;
      gap: 12px;
      margin-top: 12px;
    }
    .radio-option {
      display: flex;
      align-items: flex-start;
      gap: 12px;
      padding: 12px 16px;
      border: 1px solid #D5D5D5;
      border-radius: 2px;
      cursor: pointer;
      background-color: #FFFFFF;
      transition: border-color 150ms ease;
    }
    .radio-option:hover {
      border-color: #626262;
    }
    .radio-option.selected {
      border-color: #A94B1D;
      background-color: #FFFFFF;
    }
    .radio-input {
      margin-top: 4px;
      accent-color: #A94B1D;
      width: 18px;
      height: 18px;
      cursor: pointer;
    }
    .radio-text-title {
      font-size: 16px;
      font-weight: 600;
      color: #202020;
    }
    .radio-text-desc {
      font-size: 14px;
      color: #626262;
      margin-top: 2px;
    }

    /* Buttons */
    .btn-primary {
      height: 48px;
      background-color: #A94B1D;
      color: #FFFFFF;
      font-family: 'Public Sans', sans-serif;
      font-size: 16px;
      font-weight: 600;
      border: none;
      border-radius: 2px;
      padding: 0 24px;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      transition: background-color 150ms ease, transform 90ms ease;
    }
    .btn-primary:hover {
      background-color: #8E3E17;
    }
    .btn-primary:active {
      transform: scale(0.98);
    }
    .btn-primary:focus-visible {
      outline: 2px solid #A94B1D;
      outline-offset: 2px;
    }

    .btn-secondary {
      height: 48px;
      background-color: #FFFFFF;
      color: #202020;
      border: 1px solid #D5D5D5;
      border-radius: 2px;
      padding: 0 20px;
      font-family: 'Public Sans', sans-serif;
      font-size: 16px;
      font-weight: 500;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      transition: border-color 150ms ease, background-color 150ms ease;
    }
    .btn-secondary:hover {
      border-color: #626262;
      background-color: #F7F7F7;
    }
    .btn-secondary:active {
      transform: scale(0.98);
    }
    .btn-secondary:focus-visible {
      outline: 2px solid #A94B1D;
      outline-offset: 2px;
    }

    /* Link button for navigation */
    .link-action {
      text-decoration: none;
      color: #202020;
      border: 1px solid #D5D5D5;
      background-color: #FFFFFF;
      padding: 0 16px;
      height: 48px;
      display: inline-flex;
      align-items: center;
      border-radius: 2px;
      font-size: 15px;
      font-weight: 500;
      transition: border-color 150ms ease;
    }
    .link-action:hover {
      border-color: #626262;
      background-color: #F7F7F7;
    }

    /* Table styles */
    .data-table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 16px;
      text-align: left;
    }
    .data-table th {
      height: 48px;
      border-bottom: 1px solid #D5D5D5;
      font-size: 14px;
      font-weight: 600;
      color: #626262;
      padding: 0 12px;
    }
    .data-table td {
      height: 48px;
      border-bottom: 1px solid #D5D5D5;
      font-size: 15px;
      color: #202020;
      padding: 0 12px;
      vertical-align: middle;
    }
    .data-table tr:last-child td {
      border-bottom: none;
    }

    /* Motion Specification */
    @keyframes pageEntrance {
      from {
        opacity: 0;
        transform: translateY(6px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
    @keyframes savedHandoff {
      0% {
        opacity: 0.6;
        transform: translateY(8px);
      }
      100% {
        opacity: 1;
        transform: translateY(0);
      }
    }
    @keyframes waitingDotBreathe {
      0%, 100% {
        opacity: 0.7;
      }
      50% {
        opacity: 1.0;
      }
    }

    .animate-entrance {
      animation: pageEntrance 260ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
    .animate-saved-handoff {
      animation: savedHandoff 260ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    @media (prefers-reduced-motion: reduce) {
      .animate-entrance,
      .animate-saved-handoff {
        animation: none !important;
        transform: none !important;
        opacity: 1 !important;
      }
      .btn-primary, .btn-secondary, .nav-item {
        transition: none !important;
      }
    }
  </style>
</head>
<body>

  <!-- Site Header -->
  <header class="site-header">
    <div class="header-left">
      <a href="#" class="brand-mark">
        <div class="brand-square">M</div>
        <span class="brand-name">Meridian</span>
      </a>
      <nav>
        <ul class="nav-menu">
          <li><a href="#" class="nav-item active">Orders</a></li>
          <li><a href="#" class="nav-item">Deliveries</a></li>
          <li><a href="#" class="nav-item">Recall notices</a></li>
          <li><a href="#" class="nav-item">Account</a></li>
        </ul>
      </nav>
    </div>
    <div class="header-right">
      <div class="user-profile">
        <div class="initials-avatar">HY</div>
        <span>Hana Youssef · Cedar Health</span>
      </div>
      <div class="lang-switcher">EN / العربية</div>
    </div>
  </header>

  <!-- Main Content -->
  <main class="main-container animate-entrance">
    <div class="page-title-row">
      <h1 class="heading-main">Place order</h1>
      <div class="text-quieter" style="font-size: 14px;">
        Prototype date: <span class="mono">14 May 2026</span> · Europe/London (BST)
      </div>
    </div>

    <!-- Order Line Items Panel -->
    <section class="panel">
      <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 12px;">
        <h2 class="heading-section">Product line items</h2>
        <span class="text-quieter" style="font-size: 14px;">1 product line configured</span>
      </div>

      <!-- Item line -->
      <div class="product-row-panel">
        <div>
          <img src="https://lh3.googleusercontent.com/aida/AEtjO1WgSPshUkFcZmvnxOy3H7uPFO7vnua31jEAabBdx4WfRYInoVBclaBYzr6EOTkCWFqGsJS1uhjgOZkjwXnc6tXok5_V7hnJD71fMFpVOQvB0xDilugRi-So3x2iuqG8mhzrhcPOXs_uaNz4_YRLSzRonyj7WTjf5nSvwTo_MrbJYO2Vuwzuzgh5Zyao9k4Tvi2zu6Rzpy9-qzR1Cr9NTtD1_aXoZOH7xfrp2HTEKJUlFP5vifyhiJqQhA" alt="Insulin Glargine 100 units/mL pack of 10 pens" class="product-photo">
        </div>
        <div class="product-details">
          <div style="font-weight: 600; font-size: 17px; color: #202020;">Insulin Glargine 100 units/mL</div>
          <div class="spec-line">Pack of 10 pens · Thermal profile v3 (2.0°C–8.0°C)</div>
          <div class="spec-line">
            Consignment source: North Quay Warehouse Cold Room C2, Rack 4
          </div>
          <div style="display: flex; gap: 16px; align-items: center; margin-top: 4px;">
            <span class="text-quieter" style="font-size: 14px;">Batch tracking:</span>
            <span class="mono" style="font-size: 14px; color: #202020;">Lot IG-2511</span>
            <span class="text-quieter" style="font-size: 14px;">Expiry:</span>
            <span class="mono" style="font-size: 14px; color: #202020;">31 March 2027</span>
          </div>
        </div>
        <div class="field-group">
          <label for="pack-qty" class="field-label">Pack quantity</label>
          <input type="text" id="pack-qty" class="input-field mono" value="30" readonly style="background-color: #F7F7F7;">
          <span class="text-quieter" style="font-size: 13px;">300 pens total</span>
        </div>
      </div>

      <!-- Add line item secondary action -->
      <div style="margin-top: 16px; display: flex; justify-content: flex-start;">
        <button type="button" class="btn-secondary">Add product line</button>
      </div>
    </section>

    <!-- Delivery destination & parameters -->
    <section class="panel">
      <h2 class="heading-section">Delivery destination and schedule</h2>

      <div class="form-grid-2">
        <div class="field-group">
          <label for="saved-address" class="field-label">Delivery destination</label>
          <select id="saved-address" class="select-field">
            <option selected>Cedar Clinic, 42 River Road, London</option>
            <option>Cedar Day Unit, 18 Elm Street, London</option>
          </select>
          <div class="field-hint">Cedar Health saved address</div>
        </div>

        <div class="field-group">
          <label for="delivery-date" class="field-label">Eligible delivery date</label>
          <input type="text" id="delivery-date" class="input-field mono" value="14 May 2026 (Today, 15:00 BST)" readonly>
          <div class="field-hint">Next verified cold-chain departure via Route R-204</div>
        </div>
      </div>

      <!-- Shelf-Life Requirement Guideline -->
      <div style="margin-top: 24px; padding: 16px; background-color: #F7F7F7; border: 1px solid #D5D5D5; border-radius: 2px;">
        <div style="display: flex; justify-content: space-between; align-items: center;">
          <div>
            <div style="font-size: 14px; font-weight: 600; color: #202020;">Cedar Health shelf-life requirement</div>
            <div class="text-quieter" style="font-size: 14px; margin-top: 2px;">
              Lot verification confirms IG-2511 exceeds required threshold (321 days remaining versus 90 days required).
            </div>
          </div>
          <div style="text-align: right;">
            <div class="mono" style="font-size: 18px; font-weight: 600; color: #202020;">90 days</div>
            <div class="text-quieter" style="font-size: 13px;">read-only policy minimum</div>
          </div>
        </div>
      </div>

      <!-- Fulfillment choice -->
      <div style="margin-top: 24px;">
        <label class="field-label">Fulfillment policy</label>
        <div class="radio-group">
          <label class="radio-option selected">
            <input type="radio" name="fulfillment_policy" class="radio-input" checked>
            <div>
              <div class="radio-text-title">Deliver available quantities</div>
              <div class="radio-text-desc">Dispatch allocated on-hand stock immediately on next departure (20 packs); remaining 10 packs queued for subsequent dispatch upon inspection clearance.</div>
            </div>
          </label>
          <label class="radio-option">
            <input type="radio" name="fulfillment_policy" class="radio-input">
            <div>
              <div class="radio-text-title">Complete delivery only</div>
              <div class="radio-text-desc">Hold consignment until all 30 packs are fully allocated, packed, and released in one consolidated shipment.</div>
            </div>
          </label>
        </div>
      </div>

      <!-- Primary Action -->
      <div style="margin-top: 32px; padding-top: 24px; border-top: 1px solid #D5D5D5; display: flex; justify-content: space-between; align-items: center;">
        <div class="text-quieter" style="font-size: 14px;">
          Submitting evaluates active warehouse inventory against Cedar Health clinical criteria.
        </div>
        <button type="button" class="btn-primary">Place order</button>
      </div>
    </section>

    <!-- Returned Order Outcome Panel -->
    <section class="panel animate-saved-handoff">
      <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 16px;">
        <div>
          <div style="display: flex; align-items: center; gap: 12px;">
            <h2 class="heading-section">Returned order outcome</h2>
            <span class="mono" style="font-size: 16px; font-weight: 600; color: #202020;">Order O-301</span>
          </div>
          <p class="text-quieter" style="font-size: 14px; margin-top: 4px;">
            Actual service-evaluated outcome returned upon submission; shows returned allocation result rather than promised supply.
          </p>
        </div>
        <div>
          <span class="status-waiting">waiting</span>
        </div>
      </div>

      <!-- Summary metrics -->
      <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; padding: 16px 0; border-top: 1px solid #D5D5D5; border-bottom: 1px solid #D5D5D5;">
        <div>
          <div class="text-quieter" style="font-size: 14px;">Requested quantity</div>
          <div class="mono" style="font-size: 24px; font-weight: 600; color: #202020; margin-top: 4px;">30 packs</div>
          <div class="text-quieter" style="font-size: 13px;">300 pens ordered</div>
        </div>
        <div>
          <div class="text-quieter" style="font-size: 14px;">Allocated quantity</div>
          <div class="mono" style="font-size: 24px; font-weight: 600; color: #202020; margin-top: 4px;">20 packs</div>
          <div class="status-good" style="font-size: 13px;">good verified on-hand</div>
        </div>
        <div>
          <div class="text-quieter" style="font-size: 14px;">Outstanding balance</div>
          <div class="mono" style="font-size: 24px; font-weight: 600; color: #202020; margin-top: 4px;">10 packs</div>
          <div class="status-waiting" style="font-size: 13px;">waiting packaging release</div>
        </div>
        <div>
          <div class="text-quieter" style="font-size: 14px;">Assigned transit route</div>
          <div class="mono" style="font-size: 20px; font-weight: 600; color: #202020; margin-top: 4px;">Route R-204</div>
          <div class="text-quieter" style="font-size: 13px;">VAN-27 · Planned 15:00 BST</div>
        </div>
      </div>

      <!-- Ledger & Allocation breakdown table -->
      <table class="data-table">
        <thead>
          <tr>
            <th>Product & Lot</th>
            <th>Expiry</th>
            <th>Warehouse Unit</th>
            <th>Unit Balance</th>
            <th>Returned Allocation</th>
            <th>Status</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>
              <div style="font-weight: 600; color: #202020;">Insulin Glargine 100 units/mL</div>
              <div class="mono" style="font-size: 13px; color: #626262;">Lot IG-2511</div>
            </td>
            <td class="mono">31 Mar 2027</td>
            <td class="mono">HU-81</td>
            <td class="mono">100 (60 avail, 40 alloc)</td>
            <td class="mono" style="font-weight: 600;">20 packs</td>
            <td><span class="status-good">good</span></td>
          </tr>
          <tr>
            <td>
              <div style="font-weight: 600; color: #202020;">Insulin Glargine 100 units/mL</div>
              <div class="mono" style="font-size: 13px; color: #626262;">Lot IG-2511</div>
            </td>
            <td class="mono">31 Mar 2027</td>
            <td class="mono">HU-82</td>
            <td class="mono">20 (10 Q, 5 Hold, 2 Rej, 3 Exp)</td>
            <td class="mono" style="font-weight: 600;">0 packs (held)</td>
            <td><span class="status-waiting">waiting</span></td>
          </tr>
        </tbody>
      </table>

      <!-- Navigation to detail -->
      <div style="margin-top: 20px; display: flex; justify-content: flex-end; align-items: center; gap: 16px;">
        <span class="text-quieter" style="font-size: 14px;">Review fulfillment progress and shipping details:</span>
        <a href="#" class="link-action">Order detail</a>
      </div>
    </section>
  </main>

</body>
</html>
