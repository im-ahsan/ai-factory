<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Orders</title>
  <!-- Google Fonts: Hanken Grotesk, Public Sans, IBM Plex Mono -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@600;650;700&family=IBM+Plex+Mono:wght@400;500;600&family=Public+Sans:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    /* Design System Tokens & Exact Constraints */
    :root {
      --bg-page: #F7F7F7;
      --bg-surface: #FFFFFF;
      --text-main: #202020;
      --text-quiet: #626262;
      --border-color: #D5D5D5;
      --primary-color: #A94B1D;
      
      --status-good: #24704B;
      --status-waiting: #805800;
      --status-failed: #AE2C2C;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      background-color: var(--bg-page);
      color: var(--text-main);
      font-family: 'Public Sans', sans-serif;
      font-size: 16px;
      line-height: 1.5;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      -webkit-font-smoothing: antialiased;
    }

    /* Motion specifications */
    @keyframes entranceFadeUp {
      from {
        opacity: 0;
        transform: translateY(6px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes savedHandoff {
      from {
        opacity: 0.6;
        transform: translateY(8px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes waitingBreathe {
      0%, 100% {
        opacity: 0.7;
      }
      50% {
        opacity: 1;
      }
    }

    .animate-entrance {
      animation: entranceFadeUp 260ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    .handoff-sync {
      animation: savedHandoff 260ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    .waiting-pulse {
      animation: waitingBreathe 6s ease-in-out infinite;
    }

    @media (prefers-reduced-motion: reduce) {
      *, ::before, ::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
      }
    }

    /* Typography assignments */
    h1, .font-heading {
      font-family: 'Hanken Grotesk', sans-serif;
    }
    
    .font-mono {
      font-family: 'IBM Plex Mono', monospace;
    }

    /* Header */
    header {
      background-color: var(--bg-surface);
      border-bottom: 1px solid var(--border-color);
      height: 64px;
      padding: 0 32px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .header-left {
      display: flex;
      align-items: center;
      gap: 32px;
    }

    .brand-mark {
      display: flex;
      align-items: center;
      gap: 12px;
      text-decoration: none;
      color: var(--text-main);
    }

    .brand-icon {
      width: 28px;
      height: 28px;
      background-color: #202020;
      color: #FFFFFF;
      font-family: 'Hanken Grotesk', sans-serif;
      font-weight: 700;
      font-size: 16px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 2px;
    }

    .brand-name {
      font-family: 'Hanken Grotesk', sans-serif;
      font-weight: 650;
      font-size: 18px;
      letter-spacing: -0.01em;
    }

    nav.header-menu {
      display: flex;
      align-items: center;
      gap: 24px;
      height: 64px;
    }

    .menu-item {
      text-decoration: none;
      font-size: 15px;
      font-weight: 500;
      color: var(--text-quiet);
      height: 100%;
      display: flex;
      align-items: center;
      position: relative;
      transition: color 150ms ease;
    }

    .menu-item:hover {
      color: var(--text-main);
    }

    .menu-item:focus-visible {
      outline: 2px solid var(--primary-color);
      outline-offset: -2px;
    }

    .menu-item.active {
      color: var(--primary-color);
      font-weight: 600;
    }

    .menu-item.active::after {
      content: '';
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      height: 2px;
      background-color: var(--primary-color);
    }

    .header-right {
      display: flex;
      align-items: center;
      gap: 24px;
    }

    .user-profile {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .user-avatar {
      width: 32px;
      height: 32px;
      background-color: #EEEEEE;
      border: 1px solid var(--border-color);
      border-radius: 2px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: 'Public Sans', sans-serif;
      font-weight: 600;
      font-size: 12px;
      color: var(--text-main);
    }

    .user-details {
      font-size: 14px;
      color: var(--text-main);
    }

    .lang-switcher {
      font-size: 14px;
      color: var(--text-quiet);
      border-left: 1px solid var(--border-color);
      padding-left: 16px;
    }

    /* Main Container */
    main {
      width: 100%;
      max-width: 1360px;
      margin: 0 auto;
      padding: 32px 32px 48px;
      display: flex;
      flex-direction: column;
      gap: 32px;
    }

    /* Page Heading */
    .page-title {
      font-size: 28px;
      font-weight: 650;
      line-height: 1.2;
      color: var(--text-main);
      letter-spacing: -0.02em;
    }

    /* Panels */
    .panel {
      background-color: var(--bg-surface);
      border: 1px solid var(--border-color);
      border-radius: 2px;
      padding: 16px;
    }

    /* Current Work Summary Section */
    .lead-panel {
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    .lead-header {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      border-bottom: 1px solid var(--border-color);
      padding-bottom: 12px;
    }

    .lead-title {
      font-size: 16px;
      font-weight: 600;
      color: var(--text-main);
      font-family: 'Hanken Grotesk', sans-serif;
    }

    .lead-meta {
      font-size: 14px;
      color: var(--text-quiet);
    }

    .current-work-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 16px;
    }

    .work-item-box {
      border: 1px solid var(--border-color);
      border-radius: 2px;
      padding: 16px;
      background: var(--bg-surface);
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .work-item-top {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
    }

    .order-code {
      font-size: 16px;
      font-weight: 600;
      color: var(--text-main);
    }

    .work-item-body {
      display: flex;
      flex-direction: column;
      gap: 4px;
    }

    .work-client {
      font-size: 15px;
      font-weight: 600;
      color: var(--text-main);
    }

    .work-detail-line {
      font-size: 14px;
      color: var(--text-quiet);
    }

    /* Filters Bar */
    .filter-panel {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      gap: 16px;
      padding: 16px;
    }

    .filters-group {
      display: flex;
      align-items: flex-end;
      gap: 16px;
      flex-wrap: wrap;
    }

    .field-wrapper {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    .field-label {
      font-size: 14px;
      font-weight: 500;
      color: var(--text-quiet);
    }

    .filter-input, .filter-select {
      height: 48px;
      background-color: var(--bg-surface);
      border: 1px solid var(--border-color);
      border-radius: 2px;
      padding: 0 16px;
      font-family: 'Public Sans', sans-serif;
      font-size: 15px;
      color: var(--text-main);
      min-width: 200px;
      outline: none;
      transition: border-color 150ms ease;
    }

    .filter-input.font-mono, .filter-select.font-mono {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 14px;
    }

    .filter-input:focus, .filter-select:focus {
      border-color: var(--primary-color);
      box-shadow: 0 0 0 1px var(--primary-color);
    }

    .btn-secondary {
      height: 48px;
      background-color: var(--bg-surface);
      border: 1px solid var(--border-color);
      border-radius: 2px;
      padding: 0 20px;
      font-family: 'Public Sans', sans-serif;
      font-size: 15px;
      font-weight: 500;
      color: var(--text-main);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      cursor: pointer;
      text-decoration: none;
      transition: background-color 150ms ease, border-color 150ms ease;
    }

    .btn-secondary:hover {
      background-color: #F0F0F0;
      border-color: #BDBDBD;
    }

    .btn-secondary:focus-visible {
      outline: 2px solid var(--primary-color);
      outline-offset: 1px;
    }

    .btn-secondary:active {
      background-color: #E6E6E6;
    }

    .btn-primary {
      height: 48px;
      background-color: var(--primary-color);
      border: 1px solid var(--primary-color);
      border-radius: 2px;
      padding: 0 20px;
      font-family: 'Public Sans', sans-serif;
      font-size: 15px;
      font-weight: 500;
      color: #FFFFFF;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      text-decoration: none;
      transition: opacity 150ms ease;
    }

    .btn-primary:hover {
      opacity: 0.92;
    }

    .btn-primary:focus-visible {
      outline: 2px solid var(--primary-color);
      outline-offset: 2px;
    }

    .btn-primary:active {
      opacity: 0.84;
    }

    /* Table Container */
    .table-container {
      background-color: var(--bg-surface);
      border: 1px solid var(--border-color);
      border-radius: 2px;
      overflow: hidden;
    }

    table.dense-table {
      width: 100%;
      border-collapse: collapse;
      text-align: left;
    }

    table.dense-table th {
      height: 48px;
      padding: 0 16px;
      background-color: var(--bg-surface);
      border-bottom: 1px solid var(--border-color);
      font-size: 14px;
      font-weight: 500;
      color: var(--text-quiet);
    }

    table.dense-table td {
      height: 48px;
      padding: 0 16px;
      border-bottom: 1px solid var(--border-color);
      font-size: 15px;
      color: var(--text-main);
      vertical-align: middle;
    }

    table.dense-table tr:last-child td {
      border-bottom: none;
    }

    table.dense-table tbody tr {
      transition: background-color 120ms ease;
    }

    table.dense-table tbody tr:hover {
      background-color: #FAFAFA;
    }

    /* Status indicators */
    .status-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: 14px;
      font-weight: 500;
    }

    .status-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      display: inline-block;
      flex-shrink: 0;
    }

    .status-good {
      color: var(--status-good);
    }
    .status-good .status-dot {
      background-color: var(--status-good);
    }

    .status-waiting {
      color: var(--status-waiting);
    }
    .status-waiting .status-dot {
      background-color: var(--status-waiting);
    }

    .status-failed {
      color: var(--status-failed);
    }
    .status-failed .status-dot {
      background-color: var(--status-failed);
    }

    /* Row Action Button */
    .action-btn {
      height: 34px;
      padding: 0 12px;
      font-size: 14px;
      font-weight: 500;
      background-color: var(--bg-surface);
      border: 1px solid var(--border-color);
      border-radius: 2px;
      color: var(--text-main);
      cursor: pointer;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      transition: background-color 150ms ease, border-color 150ms ease;
    }

    .action-btn:hover {
      background-color: #F0F0F0;
      border-color: #BDBDBD;
    }

    .action-btn:focus-visible {
      outline: 2px solid var(--primary-color);
      outline-offset: 1px;
    }

    .action-btn:active {
      background-color: #E6E6E6;
    }

    .table-footer {
      padding: 12px 16px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      background-color: var(--bg-surface);
      border-top: 1px solid var(--border-color);
      font-size: 14px;
      color: var(--text-quiet);
    }
  </style>
</head>
