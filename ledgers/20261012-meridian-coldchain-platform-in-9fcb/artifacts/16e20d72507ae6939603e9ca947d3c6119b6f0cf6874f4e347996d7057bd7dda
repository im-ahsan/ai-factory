<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Orders — Empty State</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@600;650;700&family=IBM+Plex+Mono:wght@400;500;600&family=Public+Sans:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    /* CSS Reset & Design System Tokens */
    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    :root {
      --bg: #F7F7F7;
      --surface: #FFFFFF;
      --text: #202020;
      --text-muted: #626262;
      --border: #D5D5D5;
      --primary: #A94B1D;
      --status-good: #24704B;
      --status-waiting: #805800;
      --status-failed: #AE2C2C;
      --radius: 2px;
    }

    body {
      background-color: var(--bg);
      color: var(--text);
      font-family: 'Public Sans', -apple-system, BlinkMacSystemFont, sans-serif;
      font-size: 16px;
      line-height: 1.5;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      -webkit-font-smoothing: antialiased;
    }

    /* Motion Tokens & Keyframes */
    @keyframes entranceFadeUp {
      from {
        opacity: 0;
        transform: translateY(6px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes statusBreath {
      0%, 100% {
        opacity: 0.7;
      }
      50% {
        opacity: 1;
      }
    }

    .animate-entrance {
      animation: entranceFadeUp 260ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    /* Accessibility */
    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
      }
    }

    /* Typography */
    .heading-main {
      font-family: 'Hanken Grotesk', sans-serif;
      font-size: 28px;
      font-weight: 650;
      line-height: 1.2;
      letter-spacing: -0.02em;
    }

    .heading-section {
      font-family: 'Hanken Grotesk', sans-serif;
      font-size: 20px;
      font-weight: 650;
      line-height: 1.3;
    }

    .heading-sub {
      font-family: 'Hanken Grotesk', sans-serif;
      font-size: 16px;
      font-weight: 600;
      line-height: 1.4;
    }

    .mono-val {
      font-family: 'IBM Plex Mono', monospace;
    }

    /* Header */
    header {
      background: var(--surface);
      border-bottom: 1px solid var(--border);
      height: 64px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 32px;
      position: sticky;
      top: 0;
      z-index: 50;
    }

    .header-left {
      display: flex;
      align-items: center;
      gap: 32px;
    }

    .brand-mark {
      display: flex;
      align-items: center;
      gap: 10px;
      text-decoration: none;
      color: var(--text);
    }

    .logo-square {
      width: 28px;
      height: 28px;
      background: #202020;
      color: #FFFFFF;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: 'Hanken Grotesk', sans-serif;
      font-weight: 700;
      font-size: 16px;
      border-radius: var(--radius);
    }

    .brand-name {
      font-family: 'Hanken Grotesk', sans-serif;
      font-weight: 700;
      font-size: 18px;
      letter-spacing: -0.01em;
    }

    nav.main-nav {
      display: flex;
      align-items: center;
      gap: 24px;
    }

    nav.main-nav a {
      text-decoration: none;
      color: var(--text-muted);
      font-size: 15px;
      font-weight: 500;
      padding: 20px 0;
      position: relative;
      transition: color 150ms ease;
    }

    nav.main-nav a:hover {
      color: var(--text);
    }

    nav.main-nav a:focus-visible {
      outline: none;
      box-shadow: 0 0 0 2px var(--primary);
      border-radius: var(--radius);
    }

    nav.main-nav a.active {
      color: var(--primary);
      font-weight: 600;
    }

    nav.main-nav a.active::after {
      content: '';
      position: absolute;
      bottom: -1px;
      left: 0;
      right: 0;
      height: 2px;
      background: var(--primary);
    }

    .header-right {
      display: flex;
      align-items: center;
      gap: 24px;
    }

    .user-profile {
      display: flex;
      align-items: center;
      gap: 10px;
      font-size: 14px;
      color: var(--text);
    }

    .initials-avatar {
      width: 32px;
      height: 32px;
      background: #EAEAEA;
      color: #202020;
      font-weight: 600;
      font-size: 13px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: var(--radius);
      border: 1px solid var(--border);
    }

    .user-details {
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .user-name {
      font-weight: 600;
    }

    .user-org {
      color: var(--text-muted);
    }

    .lang-switch {
      display: flex;
      align-items: center;
      gap: 6px;
      font-size: 14px;
      color: var(--text-muted);
    }

    .lang-switch a {
      color: inherit;
      text-decoration: none;
      transition: color 120ms ease;
    }

    .lang-switch a:hover {
      color: var(--text);
    }

    .lang-switch a:focus-visible {
      outline: none;
      box-shadow: 0 0 0 2px var(--primary);
      border-radius: var(--radius);
    }

    .lang-switch .active {
      color: var(--text);
      font-weight: 600;
    }

    /* Main Container */
    main {
      flex: 1;
      max-width: 1200px;
      width: 100%;
      margin: 0 auto;
      padding: 32px;
    }

    /* Page Header */
    .page-title-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 24px;
    }

    /* Button styles */
    .btn {
      height: 48px;
      padding: 0 24px;
      border-radius: var(--radius);
      font-size: 16px;
      font-weight: 600;
      font-family: 'Public Sans', sans-serif;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      text-decoration: none;
      transition: background-color 150ms ease, border-color 150ms ease, transform 90ms ease;
      white-space: nowrap;
    }

    .btn:active {
      transform: scale(0.98);
    }

    .btn:focus-visible {
      outline: none;
      box-shadow: 0 0 0 2px var(--primary);
    }

    .btn-primary {
      background: var(--primary);
      color: #FFFFFF;
      border: 1px solid var(--primary);
    }

    .btn-primary:hover {
      background: #8F3E17;
      border-color: #8F3E17;
    }

    .btn-secondary {
      background: var(--surface);
      color: var(--text);
      border: 1px solid var(--border);
    }

    .btn-secondary:hover {
      background: #F2F2F2;
      border-color: #C0C0C0;
    }

    /* Filter & Search Bar */
    .filter-panel {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 16px;
      margin-bottom: 32px;
      display: grid;
      grid-template-columns: 2fr 1fr;
      gap: 16px;
    }

    .form-group {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    .form-label {
      font-size: 14px;
      font-weight: 500;
      color: var(--text-muted);
    }

    .input-field {
      height: 48px;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 0 16px;
      font-size: 16px;
      font-family: 'Public Sans', sans-serif;
      color: var(--text);
      outline: none;
      transition: border-color 150ms ease;
      width: 100%;
    }

    .input-field:focus {
      border-color: var(--primary);
      box-shadow: 0 0 0 1px var(--primary);
    }

    select.input-field {
      appearance: none;
      background-image: url("data:image/svg2;charset=UTF-8,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%23626262' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3e%3cpolyline points='6 9 12 15 18 9'%3e%3c/polyline%3e%3c/svg%3e");
      background-repeat: no-repeat;
      background-position: right 16px center;
      background-size: 16px;
      cursor: pointer;
    }

    /* List Table Panel */
    .list-panel {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      overflow: hidden;
    }

    .table-header {
      display: grid;
      grid-template-columns: 140px 1.5fr 1.5fr 1fr 140px;
      padding: 0 24px;
      background: #FAFAFA;
      border-bottom: 1px solid var(--border);
      height: 48px;
      align-items: center;
      font-size: 14px;
      font-weight: 600;
      color: var(--text-muted);
    }

    /* Empty State Container */
    .empty-state-box {
      padding: 88px 24px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
    }

    .empty-icon-wrapper {
      width: 56px;
      height: 56px;
      border: 1px solid var(--border);
      border-radius: var(--radius);
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 24px;
      background: #FAFAFA;
      color: var(--text-muted);
    }

    .empty-icon-wrapper svg {
      width: 26px;
      height: 26px;
      stroke: var(--text-muted);
    }

    .empty-title {
      font-family: 'Hanken Grotesk', sans-serif;
      font-size: 20px;
      font-weight: 650;
      color: var(--text);
      margin-bottom: 8px;
      letter-spacing: -0.01em;
    }

    .empty-desc {
      font-size: 15px;
      color: var(--text-muted);
      max-width: 440px;
      line-height: 1.5;
      margin-bottom: 24px;
    }

    /* RTL Support */
    html[dir="rtl"] {
      direction: rtl;
      text-align: right;
    }

    html[dir="rtl"] .header-left {
      gap: 32px;
    }

    html[dir="rtl"] select.input-field {
      background-position: left 16px center;
    }

    html[dir="rtl"] nav.main-nav a.active::after {
      left: 0;
      right: 0;
    }
  </style>
</head>
<body>

  <!-- Persistent Standard Header -->
  <header>
    <div class="header-left">
      <a href="#" class="brand-mark" aria-label="Meridian Home">
        <div class="logo-square">M</div>
        <span class="brand-name">Meridian</span>
      </a>

      <nav class="main-nav" aria-label="Main Navigation">
        <a href="#" class="active">Orders</a>
        <a href="#">Deliveries</a>
        <a href="#">Recall notices</a>
        <a href="#">Account</a>
      </nav>
    </div>

    <div class="header-right">
      <div class="user-profile">
        <div class="initials-avatar">HY</div>
        <div class="user-details">
          <span class="user-name">Hana Youssef</span>
          <span class="user-org">· Cedar Health</span>
        </div>
      </div>

      <div class="lang-switch" aria-label="Language selection">
        <a href="?lang=en" class="active">EN</a>
        <span>/</span>
        <a href="?lang=ar" onclick="document.documentElement.dir='rtl';document.documentElement.lang='ar';return false;">العربية</a>
      </div>
    </div>
  </header>

  <!-- Main Content -->
  <main class="animate-entrance">
    <!-- Page Header -->
    <div class="page-title-row">
      <h1 class="heading-main">Orders</h1>
      <button type="button" class="btn btn-primary">Place order</button>
    </div>

    <!-- Filter Bar -->
    <section class="filter-panel" aria-label="Order filters">
      <div class="form-group">
        <label for="order-search" class="form-label">Search order or product</label>
        <input type="text" id="order-search" class="input-field" placeholder="e.g. O-301, Insulin Glargine" disabled>
      </div>
      <div class="form-group">
        <label for="status-filter" class="form-label">Status</label>
        <select id="status-filter" class="input-field" disabled>
          <option value="all">All statuses</option>
          <option value="outstanding">Outstanding</option>
          <option value="packed">Packed</option>
          <option value="delivered">Delivered</option>
        </select>
      </div>
    </section>

    <!-- Dense List Container showing Empty State -->
    <section class="list-panel" aria-label="Orders table">
      <div class="table-header">
        <div>Order</div>
        <div>Product &amp; Destination</div>
        <div>Consigned quantity</div>
        <div>Status</div>
        <div style="text-align: right;">Action</div>
      </div>

      <div class="empty-state-box">
        <div class="empty-icon-wrapper" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
            <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
          </svg>
        </div>
        <h2 class="empty-title">No orders recorded</h2>
        <p class="empty-desc">No active or fulfilled orders have been registered for Cedar Health. Place an order to begin cold-chain allocation and dispatch.</p>
        <button type="button" class="btn btn-primary">Place order</button>
      </div>
    </section>
  </main>

</body>
</html>
