  <script>
    // Live arithmetic logic for the per-delivery response form
    const DELIVERED_TOTAL = 20;

    function calculateArithmetic() {
      const onHandInput = document.getElementById('input-onhand');
      const usedInput = document.getElementById('input-used');
      const destroyedInput = document.getElementById('input-destroyed');

      const onHand = parseInt(onHandInput.value, 10) || 0;
      const used = parseInt(usedInput.value, 10) || 0;
      const destroyed = parseInt(destroyedInput.value, 10) || 0;

      const accounted = onHand + used + destroyed;
      const unaccounted = DELIVERED_TOTAL - accounted;

      document.getElementById('stat-accounted').innerText = accounted;
      document.getElementById('stat-unaccounted').innerText = unaccounted >= 0 ? unaccounted : 0;

      const statPill = document.getElementById('stat-pill');
      const statDot = document.getElementById('stat-dot');
      const statMsg = document.getElementById('stat-message');
      const saveBtn = document.getElementById('btn-save');

      if (accounted > DELIVERED_TOTAL) {
        // Exceeds total: reject
        statPill.className = 'arithmetic-status-pill failed';
        statDot.className = 'status-dot-failed';
        statMsg.innerText = 'failed rejected: total ' + accounted + ' exceeds delivered limit of ' + DELIVERED_TOTAL + ' packs';
        saveBtn.disabled = true;
      } else if (accounted < DELIVERED_TOTAL) {
        // Below total: remaining unaccounted
        statPill.className = 'arithmetic-status-pill waiting';
        statDot.className = 'status-dot-waiting';
        statMsg.innerText = 'waiting response: ' + unaccounted + ' packs remaining unaccounted';
        saveBtn.disabled = false;
      } else {
        // Exactly accounted: 20/20
        statPill.className = 'arithmetic-status-pill good';
        statDot.className = 'status-dot-good';
        statMsg.innerText = 'good complete: all 20 delivered packs fully accounted';
        saveBtn.disabled = false;
      }
    }

    function handleFormSubmit(event) {
      event.preventDefault();
      const onHand = parseInt(document.getElementById('input-onhand').value, 10) || 0;
      const used = parseInt(document.getElementById('input-used').value, 10) || 0;
      const destroyed = parseInt(document.getElementById('input-destroyed').value, 10) || 0;
      const total = onHand + used + destroyed;

      if (total > DELIVERED_TOTAL) {
        alert('Cannot save response: Accounted quantity exceeds delivered quantity of 20 packs.');
        return;
      }

      // Populate outcome panel values
      document.getElementById('out-onhand').innerText = onHand + ' packs';
      document.getElementById('out-used').innerText = used + ' packs';
      document.getElementById('out-destroyed').innerText = destroyed + ' packs';
      
      const reconStatus = document.getElementById('out-recon-status');
      if (total === DELIVERED_TOTAL) {
        reconStatus.innerText = 'good complete (20/20 accounted)';
        document.getElementById('recon-status-text').innerHTML = '<span class="status-dot-good"></span><span>good reconciled</span>';
        document.getElementById('recon-status-text').className = 'summary-value badge-status good';
      } else {
        reconStatus.innerText = 'waiting partial (' + total + '/20 accounted, ' + (DELIVERED_TOTAL - total) + ' unaccounted)';
        document.getElementById('recon-status-text').innerHTML = '<span class="status-dot-waiting"></span><span>waiting partial</span>';
        document.getElementById('recon-status-text').className = 'summary-value badge-status waiting';
      }

      // Update form header badge to show saved handoff
      document.getElementById('form-header-badge').innerHTML = '<span class="status-dot-good"></span><span>good saved</span>';
      document.getElementById('form-header-badge').className = 'badge-status good';

      // Show outcome panel with signature motion
      const outcomePanel = document.getElementById('outcome-panel');
      outcomePanel.classList.add('visible');
      outcomePanel.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    function resetFormToSample() {
      document.getElementById('input-onhand').value = 16;
      document.getElementById('input-used').value = 4;
      document.getElementById('input-destroyed').value = 0;
      calculateArithmetic();
    }

    // Initialize with a default balanced sample state (e.g. 16 on hand, 4 used, 0 destroyed = 20)
    window.addEventListener('DOMContentLoaded', () => {
      document.getElementById('input-onhand').value = 16;
      document.getElementById('input-used').value = 4;
      document.getElementById('input-destroyed').value = 0;
      calculateArithmetic();
    });
  </script>
