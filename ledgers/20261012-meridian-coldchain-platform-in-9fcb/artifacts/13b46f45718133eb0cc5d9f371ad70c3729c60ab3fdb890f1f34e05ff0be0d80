<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Recall response</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@600;650;700&family=IBM+Plex+Mono:wght@400;500;600&family=Public+Sans:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    /* CSS Reset & Variables */
    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    :root {
      --bg: #F7F7F7;
      --surface: #FFFFFF;
      --text: #202020;
      --text-quiet: #626262;
      --border: #D5D5D5;
      --primary: #A94B1D;
      --status-good: #24704B;
      --status-waiting: #805800;
      --status-failed: #AE2C2C;
      --font-heading: 'Hanken Grotesk', sans-serif;
      --font-body: 'Public Sans', sans-serif;
      --font-mono: 'IBM Plex Mono', monospace;
    }

    body {
      background-color: var(--bg);
      color: var(--text);
      font-family: var(--font-body);
      font-size: 16px;
      line-height: 1.5;
      -webkit-font-smoothing: antialiased;
      min-height: 100vh;
    }

    /* Motion Tokens & Keyframes */
    @keyframes entranceFade {
      0% {
        opacity: 0;
        transform: translateY(6px);
      }
      100% {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes waitingBreathe {
      0%, 100% {
        opacity: 0.7;
      }
      50% {
        opacity: 1;
      }
    }

    @keyframes savedHandoff {
      0% {
        opacity: 0.6;
        transform: translateY(8px);
      }
      100% {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .animate-entrance {
      animation: entranceFade 280ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    .status-dot-waiting {
      display: inline-block;
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background-color: var(--status-waiting);
      animation: waitingBreathe 6s ease-in-out infinite;
    }

    .status-dot-failed {
      display: inline-block;
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background-color: var(--status-failed);
    }

    .status-dot-good {
      display: inline-block;
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background-color: var(--status-good);
    }

    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
        scroll-behavior: auto !important;
      }
    }

    /* Header */
    header {
      background-color: var(--surface);
      border-bottom: 1px solid var(--border);
      height: 64px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 32px;
    }

    .header-left {
      display: flex;
      align-items: center;
      gap: 32px;
    }

    .brand-mark {
      display: flex;
      align-items: center;
      gap: 12px;
      text-decoration: none;
      color: var(--text);
    }

    .brand-icon {
      width: 28px;
      height: 28px;
      background-color: var(--text);
      color: #FFFFFF;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: var(--font-heading);
      font-weight: 700;
      font-size: 16px;
      border-radius: 2px;
    }

    .brand-name {
      font-family: var(--font-heading);
      font-size: 18px;
      font-weight: 700;
      letter-spacing: -0.01em;
    }

    nav.header-nav {
      display: flex;
      align-items: center;
      gap: 24px;
    }

    .nav-item {
      color: var(--text-quiet);
      text-decoration: none;
      font-size: 15px;
      font-weight: 500;
      padding: 20px 0;
      border-bottom: 2px solid transparent;
      transition: color 150ms ease;
    }

    .nav-item:hover {
      color: var(--text);
    }

    .nav-item.active {
      color: var(--primary);
      border-bottom-color: var(--primary);
      font-weight: 600;
    }

    .header-right {
      display: flex;
      align-items: center;
      gap: 16px;
      font-size: 14px;
    }

    .user-profile {
      display: flex;
      align-items: center;
      gap: 8px;
      color: var(--text);
    }

    .user-avatar {
      width: 28px;
      height: 28px;
      background-color: #EBEBEB;
      color: var(--text);
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: var(--font-mono);
      font-size: 12px;
      font-weight: 600;
      border-radius: 2px;
      border: 1px solid var(--border);
    }

    .lang-switcher {
      color: var(--text-quiet);
      font-size: 13px;
      border-left: 1px solid var(--border);
      padding-left: 16px;
    }

    /* Main Container */
    main {
      max-width: 1140px;
      margin: 0 auto;
      padding: 32px 32px 64px 32px;
    }

    /* Page Heading & Sub-bar */
    .page-title-row {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      margin-bottom: 8px;
    }

    h1 {
      font-family: var(--font-heading);
      font-size: 28px;
      font-weight: 650;
      line-height: 1.25;
      color: var(--text);
    }

    .action-header-link {
      display: inline-flex;
      align-items: center;
      height: 40px;
      padding: 0 16px;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 2px;
      color: var(--text);
      text-decoration: none;
      font-size: 14px;
      font-weight: 500;
      transition: background 150ms ease, border-color 150ms ease;
    }

    .action-header-link:hover {
      background: #FAFAFA;
      border-color: #BDBDBD;
    }

    .metadata-line {
      font-size: 14px;
      color: var(--text-quiet);
      margin-bottom: 24px;
    }

    .metadata-line .mono {
      font-family: var(--font-mono);
    }

    /* Panel Specifications */
    .panel {
      background-color: var(--surface);
      border: 1px solid var(--border);
      border-radius: 2px;
      margin-bottom: 32px;
    }

    .panel-header {
      padding: 16px 20px;
      border-bottom: 1px solid var(--border);
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    h2 {
      font-family: var(--font-heading);
      font-size: 20px;
      font-weight: 650;
      color: var(--text);
      line-height: 1.3;
    }

    h3 {
      font-family: var(--font-heading);
      font-size: 16px;
      font-weight: 600;
      color: var(--text);
    }

    .panel-body {
      padding: 20px;
    }

    /* Recall Lead Banner Panel */
    .recall-lead-grid {
      display: grid;
      grid-template-columns: 240px 1fr;
      gap: 24px;
    }

    .product-photo-wrap {
      width: 100%;
      aspect-ratio: 4/3;
      border-radius: 2px;
      overflow: hidden;
      border: 1px solid var(--border);
      background-color: #FFFFFF;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .product-photo-wrap img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .lead-info-col {
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }

    .lead-top-row {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      margin-bottom: 12px;
    }

    .lead-headline {
      font-family: var(--font-mono);
      font-size: 18px;
      font-weight: 600;
      color: var(--text);
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .badge-status {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: 14px;
      font-weight: 500;
    }

    .badge-status.refused {
      color: var(--status-failed);
    }

    .badge-status.waiting {
      color: var(--status-waiting);
    }

    .badge-status.good {
      color: var(--status-good);
    }

    .lead-desc {
      color: var(--text);
      font-size: 15px;
      line-height: 1.5;
      margin-bottom: 16px;
    }

    .lead-summary-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 16px;
      border-top: 1px solid var(--border);
      padding-top: 16px;
    }

    .summary-cell {
      display: flex;
      flex-direction: column;
      gap: 4px;
    }

    .summary-label {
      font-size: 14px;
      color: var(--text-quiet);
    }

    .summary-value {
      font-size: 15px;
      color: var(--text);
      font-weight: 500;
    }

    .summary-value.mono {
      font-family: var(--font-mono);
    }

    /* Form Section */
    .form-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
      margin-bottom: 24px;
    }

    .form-group {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .form-group.full-width {
      grid-column: 1 / -1;
    }

    label {
      font-size: 14px;
      font-weight: 500;
      color: var(--text);
      display: flex;
      justify-content: space-between;
    }

    .label-hint {
      font-size: 13px;
      color: var(--text-quiet);
      font-weight: 400;
    }

    input[type="number"],
    select,
    textarea {
      width: 100%;
      height: 48px;
      padding: 0 16px;
      font-family: var(--font-body);
      font-size: 16px;
      color: var(--text);
      background-color: var(--surface);
      border: 1px solid var(--border);
      border-radius: 2px;
      outline: none;
      transition: border-color 150ms ease, box-shadow 150ms ease;
    }

    input[type="number"] {
      font-family: var(--font-mono);
      font-size: 16px;
    }

    textarea {
      height: 96px;
      padding: 12px 16px;
      resize: vertical;
      line-height: 1.5;
    }

    input:focus,
    select:focus,
    textarea:focus {
      border-color: var(--primary);
      box-shadow: 0 0 0 1px var(--primary);
    }

    /* Arithmetic Feedback Strip */
    .arithmetic-bar {
      border: 1px solid var(--border);
      border-radius: 2px;
      padding: 16px 20px;
      background: #FAFAFA;
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 24px;
    }

    .arithmetic-stat-group {
      display: flex;
      align-items: center;
      gap: 32px;
    }

    .stat-item {
      display: flex;
      flex-direction: column;
      gap: 4px;
    }

    .stat-label {
      font-size: 13px;
      color: var(--text-quiet);
      text-transform: uppercase;
      letter-spacing: 0.03em;
    }

    .stat-val {
      font-family: var(--font-mono);
      font-size: 18px;
      font-weight: 600;
      color: var(--text);
    }

    .arithmetic-status-pill {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 15px;
      font-weight: 500;
    }

    .arithmetic-status-pill.waiting {
      color: var(--status-waiting);
    }

    .arithmetic-status-pill.failed {
      color: var(--status-failed);
    }

    .arithmetic-status-pill.good {
      color: var(--status-good);
    }

    .form-actions-row {
      display: flex;
      align-items: center;
      justify-content: flex-end;
      gap: 16px;
      border-top: 1px solid var(--border);
      padding-top: 20px;
    }

    button.btn-primary {
      height: 48px;
      padding: 0 24px;
      background-color: var(--primary);
      color: #FFFFFF;
      font-family: var(--font-body);
      font-size: 16px;
      font-weight: 600;
      border: 1px solid var(--primary);
      border-radius: 2px;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      transition: opacity 150ms ease, transform 90ms ease;
    }

    button.btn-primary:hover {
      opacity: 0.95;
    }

    button.btn-primary:active {
      transform: scale(0.98);
    }

    button.btn-primary:disabled {
      background-color: #C0C0C0;
      border-color: #C0C0C0;
      cursor: not-allowed;
      transform: none;
    }

    button.btn-secondary {
      height: 48px;
      padding: 0 20px;
      background-color: var(--surface);
      color: var(--text);
      font-family: var(--font-body);
      font-size: 16px;
      font-weight: 500;
      border: 1px solid var(--border);
      border-radius: 2px;
      cursor: pointer;
      transition: background 150ms ease, border-color 150ms ease;
    }

    button.btn-secondary:hover {
      background: #FAFAFA;
      border-color: #BDBDBD;
    }

    /* Returned Outcomes Panel (Initially hidden, revealed on primary save) */
    #outcome-panel {
      display: none;
    }

    #outcome-panel.visible {
      display: block;
      animation: savedHandoff 260ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    /* Structured Table in Panel */
    .ledger-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 15px;
    }

    .ledger-table th {
      height: 48px;
      padding: 0 16px;
      text-align: left;
      font-size: 13px;
      font-weight: 600;
      color: var(--text-quiet);
      text-transform: uppercase;
      letter-spacing: 0.04em;
      border-bottom: 1px solid var(--border);
      background-color: #FAFAFA;
    }

    .ledger-table td {
      height: 48px;
      padding: 0 16px;
      border-bottom: 1px solid var(--border);
      color: var(--text);
    }

    .ledger-table tr:last-child td {
      border-bottom: none;
    }

    .mono {
      font-family: var(--font-mono);
    }

    /* Key-Value Split in Panel */
    .kv-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 16px;
    }

    .kv-item {
      display: flex;
      flex-direction: column;
      gap: 4px;
    }

    .kv-label {
      font-size: 14px;
      color: var(--text-quiet);
    }

    .kv-val {
      font-size: 15px;
      font-weight: 500;
      color: var(--text);
    }

    .reconciliation-notice {
      margin-top: 16px;
      padding: 16px;
      border: 1px solid var(--border);
      background-color: #FAFAFA;
      border-radius: 2px;
      font-size: 14px;
      line-height: 1.5;
      color: var(--text);
      display: flex;
      align-items: flex-start;
      gap: 12px;
    }

    .notice-indicator {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      margin-top: 6px;
      flex-shrink: 0;
    }
  </style>
</head>
<body class="animate-entrance">

  <!-- Header: exact specification across Meridian platform -->
  <header>
    <div class="header-left">
      <a href="#" class="brand-mark">
        <div class="brand-icon">M</div>
        <span class="brand-name">Meridian</span>
      </a>
      <nav class="header-nav">
        <a href="#" class="nav-item">Orders</a>
        <a href="#" class="nav-item">Deliveries</a>
        <a href="#" class="nav-item active">Recall notices</a>
        <a href="#" class="nav-item">Account</a>
      </nav>
    </div>
    <div class="header-right">
      <div class="user-profile">
        <div class="user-avatar">HY</div>
        <span>Hana Youssef · Cedar Health</span>
      </div>
      <div class="lang-switcher">
        <span>EN / العربية</span>
      </div>
    </div>
  </header>

  <!-- Main Work Area -->
  <main>
    <div class="page-title-row">
      <h1>Recall response</h1>
      <a href="#" class="action-header-link">Delivery detail</a>
    </div>
    <div class="metadata-line">
      Prototype date: <span class="mono">14 May 2026</span> · Europe/London (BST) · Scope: Cedar Clinic consignment
    </div>

    <!-- Lead Section: Delivery reference & pack photo -->
    <section class="panel">
      <div class="panel-header">
        <h2>Lead consignment specification</h2>
        <div class="badge-status refused">
          <span class="status-dot-failed"></span>
          <span>refused active (RC-12)</span>
        </div>
      </div>
      <div class="panel-body">
        <div class="recall-lead-grid">
          <div class="product-photo-wrap">
            <img src="https://lh3.googleusercontent.com/aida/AEtjO1WgSPshUkFcZmvnxOy3H7uPFO7vnua31jEAabBdx4WfRYInoVBclaBYzr6EOTkCWFqGsJS1uhjgOZkjwXnc6tXok5_V7hnJD71fMFpVOQvB0xDilugRi-So3x2iuqG8mhzrhcPOXs_uaNz4_YRLSzRonyj7WTjf5nSvwTo_MrbJYO2Vuwzuzgh5Zyao9k4Tvi2zu6Rzpy9-qzR1Cr9NTtD1_aXoZOH7xfrp2HTEKJUlFP5vifyhiJqQhA" alt="Insulin Glargine 100 units/mL pack of 10 pens">
          </div>
          <div class="lead-info-col">
            <div>
              <div class="lead-top-row">
                <div class="lead-headline">
                  <span>RC-12 · O-290 · 20 IG-2509 packs delivered</span>
                </div>
              </div>
              <p class="lead-desc">
                Manufacturer defect notice <span class="mono">RC-12</span> covers lot <span class="mono">IG-2509</span> (expiry <span class="mono">30 Nov 2026</span>). Consignment <span class="mono">O-290</span> of 20 packs was delivered to Cedar Clinic on 13 May at 10:14 via route R-201 and received by Rania Karim. Four additional packs remain quarantined on hand at North Quay Warehouse Cold Room C2 Rack 4. Total traced scope is 24 packs.
              </p>
            </div>
            <div class="lead-summary-grid">
              <div class="summary-cell">
                <span class="summary-label">Delivered quantity</span>
                <span class="summary-value mono">20 packs</span>
              </div>
              <div class="summary-cell">
                <span class="summary-label">Consignee destination</span>
                <span class="summary-value">Cedar Clinic, 42 River Road</span>
              </div>
              <div class="summary-cell">
                <span class="summary-label">Handover timestamp</span>
                <span class="summary-value mono">13 May 2026 10:14 BST</span>
              </div>
              <div class="summary-cell">
                <span class="summary-label">Customer reconciliation</span>
                <span class="summary-value badge-status waiting" id="recon-status-text">
                  <span class="status-dot-waiting"></span>
                  <span>waiting response</span>
                </span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Focused Per-Delivery Response Form -->
    <section class="panel">
      <div class="panel-header">
        <h2>Per-delivery physical inventory form</h2>
        <span class="badge-status waiting" id="form-header-badge">
          <span class="status-dot-waiting"></span>
          <span>waiting submission</span>
        </span>
      </div>
      <div class="panel-body">
        <form id="recall-form" onsubmit="handleFormSubmit(event)">
          <div class="form-grid">
            <div class="form-group">
              <label for="input-onhand">
                <span>Packs on hand (quarantined)</span>
                <span class="label-hint">Available for pickup</span>
              </label>
              <input type="number" id="input-onhand" min="0" max="20" value="0" oninput="calculateArithmetic()" required>
            </div>

            <div class="form-group">
              <label for="input-used">
                <span>Used or dispensed packs</span>
                <span class="label-hint">Administered to patients</span>
              </label>
              <input type="number" id="input-used" min="0" max="20" value="0" oninput="calculateArithmetic()" required>
            </div>

            <div class="form-group">
              <label for="input-destroyed">
                <span>Destroyed packs</span>
                <span class="label-hint">Witnessed clinical disposal</span>
              </label>
              <input type="number" id="input-destroyed" min="0" max="20" value="0" oninput="calculateArithmetic()" required>
            </div>

            <div class="form-group">
              <label for="select-disposition">
                <span>Stated disposition</span>
              </label>
              <select id="select-disposition" required>
                <option value="quarantine_return">Physical quarantine on-site pending carrier pickup</option>
                <option value="witnessed_destruction">Clinical destruction logged under SOP-CC-204</option>
                <option value="partial_dispensed">Mixed disposition: partial dispensed, balance segregated</option>
              </select>
            </div>

            <div class="form-group full-width">
              <label for="input-notes">
                <span>Clinical notes and technical verification</span>
                <span class="label-hint">Authorized Cedar Health buyer statement</span>
              </label>
              <textarea id="input-notes" placeholder="Confirm physical storage location at clinic, serial seals, and local quarantine status...">Cedar Clinic pharmacy inspection confirms delivered shipper packs are physically isolated in secondary medicine storage awaiting logistics reconciliation.</textarea>
            </div>
          </div>

          <!-- Live Arithmetic Feedback Strip -->
          <div class="arithmetic-bar" id="arithmetic-bar">
            <div class="arithmetic-stat-group">
              <div class="stat-item">
                <span class="stat-label">Delivered quota</span>
                <span class="stat-val">20</span>
              </div>
              <div class="stat-item">
                <span class="stat-label">Accounted total</span>
                <span class="stat-val" id="stat-accounted">0</span>
              </div>
              <div class="stat-item">
                <span class="stat-label">Remaining unaccounted</span>
                <span class="stat-val" id="stat-unaccounted">20</span>
              </div>
            </div>
            <div class="arithmetic-status-pill waiting" id="stat-pill">
              <span class="status-dot-waiting" id="stat-dot"></span>
              <span id="stat-message">waiting response: 20 packs remaining unaccounted</span>
            </div>
          </div>

          <div class="form-actions-row">
            <button type="button" class="btn-secondary" onclick="resetFormToSample()">Reset fields</button>
            <button type="submit" class="btn-primary" id="btn-save">
              <span>Save response</span>
            </button>
          </div>
        </form>
      </div>
    </section>

    <!-- Primary Save response returned outcome panel (Rendered only after submission) -->
    <section class="panel" id="outcome-panel">
      <div class="panel-header">
        <h2>Returned reconciliation and stock-block result</h2>
        <div class="badge-status good">
          <span class="status-dot-good"></span>
          <span>good recorded</span>
        </div>
      </div>
      <div class="panel-body">
