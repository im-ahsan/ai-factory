<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Organisations — Empty State</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@600;650;700&family=IBM+Plex+Mono:wght@400;500;600&family=Public+Sans:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      background-color: #F7F7F7;
      color: #202020;
      font-family: 'Public Sans', -apple-system, BlinkMacSystemFont, sans-serif;
      font-size: 16px;
      line-height: 1.5;
      min-height: 100vh;
      -webkit-font-smoothing: antialiased;
    }

    /* Motion Tokens & Keyframes */
    @keyframes pageEntrance {
      from {
        opacity: 0;
        transform: translateY(6px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes savedHandoff {
      from {
        opacity: 0.6;
        transform: translateY(8px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes waitingBreathe {
      0%, 100% {
        opacity: 0.7;
      }
      50% {
        opacity: 1;
      }
    }

    .animate-entrance {
      animation: pageEntrance 280ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    .status-handoff {
      animation: savedHandoff 260ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    .dot-waiting-sync {
      animation: waitingBreathe 6s ease-in-out infinite;
    }

    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
      }
    }

    /* Header */
    header {
      background-color: #FFFFFF;
      border-bottom: 1px solid #D5D5D5;
      height: 56px;
      padding: 0 32px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .header-left {
      display: flex;
      align-items: center;
      gap: 32px;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 8px;
      text-decoration: none;
      color: #202020;
    }

    .brand-mark {
      width: 20px;
      height: 20px;
      background-color: #202020;
      color: #FFFFFF;
      font-family: 'Hanken Grotesk', sans-serif;
      font-weight: 700;
      font-size: 13px;
      line-height: 20px;
      text-align: center;
      border-radius: 2px;
      display: inline-block;
    }

    .brand-name {
      font-family: 'Hanken Grotesk', sans-serif;
      font-weight: 650;
      font-size: 18px;
      letter-spacing: -0.01em;
      color: #202020;
    }

    nav {
      display: flex;
      align-items: center;
      gap: 24px;
    }

    .nav-link {
      font-family: 'Public Sans', sans-serif;
      font-size: 15px;
      font-weight: 500;
      color: #626262;
      text-decoration: none;
      padding: 16px 0;
      border-bottom: 2px solid transparent;
      transition: color 150ms ease, border-color 150ms ease;
    }

    .nav-link:hover {
      color: #202020;
    }

    .nav-link:focus-visible {
      outline: 2px solid #A94B1D;
      outline-offset: 2px;
    }

    .nav-link.active {
      color: #A94B1D;
      border-bottom-color: #A94B1D;
      font-weight: 600;
    }

    .header-right {
      display: flex;
      align-items: center;
      gap: 24px;
    }

    .user-profile {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 14px;
      color: #202020;
    }

    .avatar-initials {
      width: 28px;
      height: 28px;
      background-color: #F7F7F7;
      border: 1px solid #D5D5D5;
      border-radius: 2px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: 'IBM Plex Mono', monospace;
      font-size: 12px;
      font-weight: 500;
      color: #202020;
    }

    .user-name-title {
      font-size: 14px;
      color: #202020;
    }

    .lang-switcher {
      font-size: 14px;
      color: #626262;
      text-decoration: none;
    }

    .lang-switcher:hover {
      color: #202020;
    }

    .lang-switcher:focus-visible {
      outline: 2px solid #A94B1D;
      outline-offset: 2px;
    }

    /* Main Container */
    main {
      max-width: 1280px;
      margin: 0 auto;
      padding: 32px 32px 96px 32px;
    }

    .page-title-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 32px;
    }

    h1 {
      font-family: 'Hanken Grotesk', sans-serif;
      font-size: 28px;
      font-weight: 650;
      line-height: 1.2;
      color: #202020;
      letter-spacing: -0.01em;
    }

    /* Primary & Secondary Buttons */
    .btn-primary {
      height: 48px;
      padding: 0 20px;
      background-color: #A94B1D;
      color: #FFFFFF;
      font-family: 'Public Sans', sans-serif;
      font-size: 15px;
      font-weight: 600;
      border: 1px solid #A94B1D;
      border-radius: 2px;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      text-decoration: none;
      transition: background-color 150ms ease, opacity 150ms ease, transform 100ms ease;
    }

    .btn-primary:hover {
      opacity: 0.92;
    }

    .btn-primary:active {
      transform: scale(0.99);
    }

    .btn-primary:focus-visible {
      outline: 2px solid #A94B1D;
      outline-offset: 2px;
    }

    .btn-secondary {
      height: 48px;
      padding: 0 20px;
      background-color: #FFFFFF;
      color: #202020;
      font-family: 'Public Sans', sans-serif;
      font-size: 15px;
      font-weight: 500;
      border: 1px solid #D5D5D5;
      border-radius: 2px;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      text-decoration: none;
      transition: background-color 150ms ease, border-color 150ms ease, transform 100ms ease;
    }

    .btn-secondary:hover {
      background-color: #F7F7F7;
      border-color: #202020;
    }

    .btn-secondary:active {
      transform: scale(0.99);
    }

    .btn-secondary:focus-visible {
      outline: 2px solid #A94B1D;
      outline-offset: 2px;
    }

    /* Filter & Search Bar */
    .filter-panel {
      background-color: #FFFFFF;
      border: 1px solid #D5D5D5;
      border-radius: 2px;
      padding: 16px;
      display: flex;
      align-items: flex-end;
      gap: 16px;
      margin-bottom: 24px;
    }

    .form-group {
      display: flex;
      flex-direction: column;
      gap: 8px;
      flex: 1;
    }

    label {
      font-size: 14px;
      font-weight: 500;
      color: #626262;
    }

    .input-field {
      height: 48px;
      width: 100%;
      background-color: #FFFFFF;
      border: 1px solid #D5D5D5;
      border-radius: 2px;
      padding: 0 16px;
      font-family: 'Public Sans', sans-serif;
      font-size: 15px;
      color: #202020;
      transition: border-color 150ms ease;
    }

    .input-field::placeholder {
      color: #626262;
    }

    .input-field:focus {
      outline: none;
      border-color: #A94B1D;
    }

    .input-field:focus-visible {
      outline: 2px solid #A94B1D;
      outline-offset: 0;
    }

    /* Table & Empty State Card */
    .table-container {
      background-color: #FFFFFF;
      border: 1px solid #D5D5D5;
      border-radius: 2px;
      overflow: hidden;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      text-align: left;
    }

    thead {
      background-color: #FFFFFF;
      border-bottom: 1px solid #D5D5D5;
    }

    th {
      font-family: 'Public Sans', sans-serif;
      font-size: 13px;
      font-weight: 600;
      color: #626262;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      padding: 0 20px;
      height: 48px;
      vertical-align: middle;
      border-bottom: 1px solid #D5D5D5;
    }

    /* Empty state inner */
    .empty-state-card {
      padding: 88px 24px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
    }

    .empty-icon-wrap {
      width: 48px;
      height: 48px;
      border: 1px solid #D5D5D5;
      border-radius: 2px;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 24px;
      color: #626262;
      background-color: #FFFFFF;
    }

    .empty-title {
      font-family: 'Hanken Grotesk', sans-serif;
      font-size: 20px;
      font-weight: 650;
      color: #202020;
      margin-bottom: 8px;
    }

    .empty-message {
      font-size: 15px;
      color: #626262;
      max-width: 460px;
      line-height: 1.5;
      margin-bottom: 24px;
    }

    .empty-footer-meta {
      padding: 12px 20px;
      border-top: 1px solid #D5D5D5;
      font-family: 'IBM Plex Mono', monospace;
      font-size: 13px;
      color: #626262;
      background-color: #FFFFFF;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .spacer-whitespace {
      height: 64px;
    }
  </style>
</head>
<body class="animate-entrance">

  <!-- Header -->
  <header>
    <div class="header-left">
      <a href="#" class="brand" aria-label="Meridian Platform Home">
        <span class="brand-mark">M</span>
        <span class="brand-name">Meridian</span>
      </a>
      <nav aria-label="Main Navigation">
        <a href="#" class="nav-link">Products</a>
        <a href="#" class="nav-link active" aria-current="page">Organisations</a>
        <a href="#" class="nav-link">Accounts</a>
        <a href="#" class="nav-link">Audit trail</a>
        <a href="#" class="nav-link">Reports</a>
      </nav>
    </div>
    <div class="header-right">
      <div class="user-profile">
        <span class="avatar-initials">MV</span>
        <span class="user-name-title">Marcus Vale · System Administrator</span>
      </div>
      <a href="#" class="lang-switcher">EN / العربية</a>
    </div>
  </header>

  <!-- Main Content -->
  <main>
    <div class="page-title-row">
      <h1>Organisations</h1>
      <button type="button" class="btn-primary">Add organisation</button>
    </div>

    <!-- Search & Export Filters -->
    <div class="filter-panel">
      <div class="form-group">
        <label for="org-search">Search organisations</label>
        <input type="text" id="org-search" class="input-field" placeholder="Search by organisation name, address, or status...">
      </div>
      <button type="button" class="btn-secondary">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M8 2V10M8 10L5.5 7.5M8 10L10.5 7.5" stroke="#202020" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M2.5 11.5V13.5H13.5V11.5" stroke="#202020" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        CSV export
      </button>
    </div>

    <!-- Table Container with Empty State -->
    <div class="table-container">
      <table>
        <thead>
          <tr>
            <th style="width: 28%;">Organisation</th>
            <th style="width: 24%;">Destination Unit & Address</th>
            <th style="width: 20%;">Minimum shelf life</th>
            <th style="width: 16%;">Assurance status</th>
            <th style="width: 12%; text-align: right;">Action</th>
          </tr>
        </thead>
      </table>

      <!-- Empty State Content -->
      <div class="empty-state-card">
        <div class="empty-icon-wrap" aria-hidden="true">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect x="3.5" y="4.5" width="17" height="15" rx="1.5" stroke="#626262"/>
            <path d="M3.5 9.5H20.5" stroke="#626262"/>
            <path d="M9.5 9.5V19.5" stroke="#626262"/>
          </svg>
        </div>
        <h2 class="empty-title">No organisations recorded</h2>
        <p class="empty-message">No healthcare customer or clinic organisations have been registered yet. Add the first organisation to configure delivery destinations and shelf-life thresholds.</p>
        <button type="button" class="btn-primary">Add organisation</button>
      </div>

      <!-- Footer Metadata row within container -->
      <div class="empty-footer-meta">
        <span>0 organisations</span>
        <span>Prototype date: 14 May 2026 · Europe/London (BST)</span>
      </div>
    </div>

    <!-- Generous whitespace beneath the short table / empty state -->
    <div class="spacer-whitespace"></div>
  </main>

</body>
</html>
