              <td><span class="status-waiting"><span class="status-dot-waiting"></span>waiting</span> (quarantined)</td>
            </tr>
            <tr>
              <td class="font-mono">12 May 2026 10:05</td>
              <td>North Quay Cold Room C2, Rack 4</td>
