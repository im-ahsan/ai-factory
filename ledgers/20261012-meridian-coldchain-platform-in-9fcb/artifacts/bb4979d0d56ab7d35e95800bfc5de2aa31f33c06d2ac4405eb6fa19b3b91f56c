              <select id="writeoff-signer">
                <option value="nadia" selected>Nadia Farouk · Quality Manager (Meridian Microsoft account)</option>
              </select>
            </div>

            <div class="form-group">
              <label for="writeoff-auth">Account passcode or security token <span class="req">*</span></label>
              <input type="password" id="writeoff-auth" class="font-mono" value="••••••••••••••••" placeholder="Enter password or token">
            </div>

            <div style="margin-top: 8px;">
              <button type="button" class="btn btn-warning-action" style="width: 100%;">
                Write off unaccounted quantity
              </button>
            </div>
