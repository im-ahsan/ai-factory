<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Recall detail</title>
  <!-- Fonts: Hanken Grotesk, Public Sans, IBM Plex Mono -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@600;650;700&family=IBM+Plex+Mono:wght@400;500;600&family=Public+Sans:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    /* CSS Reset & Design System Tokens */
    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      background-color: #F7F7F7;
      color: #202020;
      font-family: 'Public Sans', -apple-system, BlinkMacSystemFont, sans-serif;
      font-size: 16px;
      line-height: 1.5;
      -webkit-font-smoothing: antialiased;
      min-height: 100vh;
    }

    .font-mono {
      font-family: 'IBM Plex Mono', monospace;
    }

    .font-heading {
      font-family: 'Hanken Grotesk', sans-serif;
    }

    /* Motion Tokens */
    @keyframes entranceFadeIn {
      0% {
        opacity: 0;
        transform: translateY(6px);
      }
      100% {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes savedHandoff {
      0% {
        opacity: 0.6;
        transform: translateY(8px);
      }
      100% {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes waitingBreathe {
      0%, 100% {
        opacity: 0.7;
      }
      50% {
        opacity: 1;
      }
    }

    .animate-entrance {
      animation: entranceFadeIn 280ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    .status-dot-waiting {
      display: inline-block;
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background-color: #805800;
      margin-right: 6px;
      vertical-align: middle;
      animation: waitingBreathe 6s ease-in-out infinite;
    }

    .status-dot-good {
      display: inline-block;
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background-color: #24704B;
      margin-right: 6px;
      vertical-align: middle;
    }

    .status-dot-refused {
      display: inline-block;
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background-color: #AE2C2C;
      margin-right: 6px;
      vertical-align: middle;
    }

    /* Semantic Status Text */
    .status-good {
      color: #24704B;
      font-weight: 500;
    }
    .status-waiting {
      color: #805800;
      font-weight: 500;
    }
    .status-refused {
      color: #AE2C2C;
      font-weight: 500;
    }

    /* Header */
    header {
      background-color: #FFFFFF;
      border-bottom: 1px solid #D5D5D5;
      height: 56px;
      padding: 0 32px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .header-left {
      display: flex;
      align-items: center;
      gap: 32px;
    }

    .brand-mark {
      display: flex;
      align-items: center;
      gap: 8px;
      text-decoration: none;
      color: #202020;
    }

    .m-square {
      width: 24px;
      height: 24px;
      background-color: #202020;
      color: #FFFFFF;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: 'Hanken Grotesk', sans-serif;
      font-weight: 700;
      font-size: 14px;
      border-radius: 2px;
    }

    .brand-title {
      font-family: 'Hanken Grotesk', sans-serif;
      font-size: 18px;
      font-weight: 650;
      letter-spacing: -0.01em;
    }

    nav.header-nav {
      display: flex;
      align-items: center;
      gap: 24px;
      height: 56px;
    }

    nav.header-nav a {
      text-decoration: none;
      color: #626262;
      font-size: 15px;
      font-weight: 500;
      height: 100%;
      display: flex;
      align-items: center;
      position: relative;
      transition: color 150ms ease;
    }

    nav.header-nav a:hover {
      color: #202020;
    }

    nav.header-nav a.active {
      color: #A94B1D;
      font-weight: 600;
    }

    nav.header-nav a.active::after {
      content: '';
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      height: 2px;
      background-color: #A94B1D;
    }

    .header-right {
      display: flex;
      align-items: center;
      gap: 16px;
      font-size: 14px;
    }

    .user-profile {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .avatar-initials {
      width: 28px;
      height: 28px;
      background-color: #F0F0F0;
      border: 1px solid #D5D5D5;
      color: #202020;
      border-radius: 2px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: 'Public Sans', sans-serif;
      font-weight: 600;
      font-size: 12px;
    }

    .user-text {
      color: #202020;
      font-weight: 500;
    }

    .user-text span {
      color: #626262;
    }

    .lang-divider {
      color: #D5D5D5;
    }

    .lang-switch {
      color: #626262;
      font-size: 13px;
    }

    /* Main Container */
    main {
      max-width: 1280px;
      margin: 0 auto;
      padding: 32px 32px 64px 32px;
      display: flex;
      flex-direction: column;
      gap: 32px;
    }

    /* Page Heading Area */
    .page-title-row {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
    }

    h1.page-title {
      font-family: 'Hanken Grotesk', sans-serif;
      font-size: 28px;
      font-weight: 650;
      line-height: 1.2;
      color: #202020;
      letter-spacing: -0.01em;
    }

    .meta-lead {
      color: #626262;
      font-size: 14px;
    }

    /* Panels & Cards */
    .panel {
      background-color: #FFFFFF;
      border: 1px solid #D5D5D5;
      border-radius: 2px;
    }

    .panel-header {
      padding: 16px 20px;
      border-bottom: 1px solid #D5D5D5;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .panel-body {
      padding: 20px;
    }

    h2.section-title {
      font-family: 'Hanken Grotesk', sans-serif;
      font-size: 20px;
      font-weight: 650;
      line-height: 1.3;
      color: #202020;
    }

    h3.sub-title {
      font-family: 'Hanken Grotesk', sans-serif;
      font-size: 16px;
      font-weight: 600;
      color: #202020;
    }

    /* Primary Metric Hero Card */
    .overview-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      divide-x: 1px solid #D5D5D5;
    }

    .metric-col {
      padding: 20px;
      display: flex;
      flex-direction: column;
      gap: 6px;
      border-right: 1px solid #D5D5D5;
    }

    .metric-col:last-child {
      border-right: none;
    }

    .metric-label {
      font-size: 14px;
      color: #626262;
    }

    .metric-value-huge {
      font-size: 28px;
      font-weight: 600;
      color: #202020;
      line-height: 1.1;
    }

    .metric-hint {
      font-size: 14px;
      color: #626262;
      margin-top: 2px;
    }

    /* Warning Callout Box */
    .governance-note {
      background-color: #FFFFFF;
      border: 1px solid #D5D5D5;
      border-left: 3px solid #805800;
      padding: 14px 16px;
      font-size: 14px;
      color: #202020;
      line-height: 1.45;
    }

    /* Data Tables */
    .table-container {
      width: 100%;
      overflow-x: auto;
    }

    table.data-table {
      width: 100%;
      border-collapse: collapse;
      text-align: left;
    }

    table.data-table th {
      padding: 12px 16px;
      font-size: 13px;
      font-weight: 600;
      color: #626262;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      border-bottom: 1px solid #D5D5D5;
      background-color: #FAFAFA;
      white-space: nowrap;
    }

    table.data-table td {
      padding: 12px 16px;
      height: 48px;
      border-bottom: 1px solid #D5D5D5;
      font-size: 15px;
      color: #202020;
      vertical-align: middle;
    }

    table.data-table tr:last-child td {
      border-bottom: none;
    }

    /* Forms & Fields */
    .form-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 20px;
    }

    .form-group {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    .form-group.full-width {
      grid-column: 1 / -1;
    }

    label {
      font-size: 14px;
      font-weight: 500;
      color: #202020;
    }

    label .req {
      color: #AE2C2C;
    }

    .field-hint {
      font-size: 13px;
      color: #626262;
    }

    input[type="text"],
    input[type="password"],
    select,
    textarea {
      width: 100%;
      height: 48px;
      padding: 0 14px;
      border: 1px solid #D5D5D5;
      border-radius: 2px;
      background-color: #FFFFFF;
      color: #202020;
      font-family: inherit;
      font-size: 15px;
      transition: border-color 140ms ease, box-shadow 140ms ease;
    }

    textarea {
      height: 96px;
      padding: 12px 14px;
      resize: vertical;
    }

    input:focus,
    select:focus,
    textarea:focus {
      outline: none;
      border-color: #A94B1D;
      box-shadow: 0 0 0 1px #A94B1D;
    }

    /* Buttons */
    .button-group {
      display: flex;
      align-items: center;
      gap: 16px;
      margin-top: 8px;
    }

    .btn {
      height: 48px;
      padding: 0 24px;
      border-radius: 2px;
      font-family: 'Public Sans', sans-serif;
      font-size: 15px;
      font-weight: 600;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      text-decoration: none;
      transition: background-color 150ms ease, border-color 150ms ease, opacity 150ms ease, transform 90ms ease;
      white-space: nowrap;
    }

    .btn:active {
      transform: scale(0.98);
    }

    .btn-primary {
      background-color: #A94B1D;
      border: 1px solid #A94B1D;
      color: #FFFFFF;
    }

    .btn-primary:hover {
      background-color: #933f17;
      border-color: #933f17;
    }

    .btn-secondary {
      background-color: #FFFFFF;
      border: 1px solid #D5D5D5;
      color: #202020;
    }

    .btn-secondary:hover {
      background-color: #F7F7F7;
      border-color: #C0C0C0;
    }

    .btn-warning-action {
      background-color: #FFFFFF;
      border: 1px solid #D5D5D5;
      color: #202020;
    }

    .btn-warning-action:hover {
      background-color: #FFF9F7;
      border-color: #A94B1D;
      color: #A94B1D;
    }

    .warning-text {
      font-size: 13px;
      color: #626262;
      line-height: 1.4;
    }

    .action-panel-split {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 24px;
    }

    /* Returned Outcomes Section */
    .result-ledger {
      background-color: #FAFAFA;
      border: 1px solid #D5D5D5;
      border-radius: 2px;
      padding: 16px 20px;
    }

    .result-row {
      display: flex;
      justify-content: space-between;
      padding: 10px 0;
      border-bottom: 1px solid #E5E5E5;
      font-size: 14px;
    }

    .result-row:last-child {
      border-bottom: none;
    }

    .result-label {
      color: #626262;
    }

    .result-value {
      color: #202020;
      font-weight: 500;
    }

    /* Accessibility reduced motion */
    @media (prefers-reduced-motion: reduce) {
      .animate-entrance {
        animation: none;
      }
      .status-dot-waiting {
        animation: none;
      }
      .btn {
        transition: none;
      }
    }
  </style>
</head>
<body>

  <!-- Application Header -->
  <header>
    <div class="header-left">
      <a href="#" class="brand-mark">
        <div class="m-square">M</div>
        <span class="brand-title">Meridian</span>
