            </div>

            <div class="form-group">
              <label for="writeoff-category">Disposal & write-off category <span class="req">*</span></label>
              <select id="writeoff-category">
                <option value="consignee_loss" selected>Consignee confirmed clinical destruction / unrecoverable</option>
                <option value="in_transit_loss">Transit disposal certificate received</option>
                <option value="regulatory_exemption">Regulatory cold chain waiver protocol D-12</option>
              </select>
            </div>

            <div class="form-group">
