    <!-- Custody & Outstanding Customer Status Detail -->
    <div class="action-panel-split">
      <section class="panel">
        <div class="panel-header">
          <h3 class="sub-title">Outstanding customer & consignee status</h3>
          <span class="status-waiting"><span class="status-dot-waiting"></span>waiting reconciliation</span>
        </div>
        <div class="panel-body" style="display: flex; flex-direction: column; gap: 14px;">
          <div class="result-row">
