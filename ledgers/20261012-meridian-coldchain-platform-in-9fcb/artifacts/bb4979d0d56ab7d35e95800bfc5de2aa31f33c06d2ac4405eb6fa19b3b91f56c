        <a href="#">Waiting decisions</a>
        <a href="#" class="active">Recalls</a>
      </nav>
    </div>
    <div class="header-right">
      <div class="user-profile">
        <div class="avatar-initials">NF</div>
        <div class="user-text">Nadia Farouk <span>· Quality Manager</span></div>
      </div>
      <span class="lang-divider">|</span>
      <span class="lang-switch">EN / العربية</span>
    </div>
  </header>

  <!-- Main Content Area -->
  <main class="animate-entrance">

    <!-- Page Title Row -->
    <div class="page-title-row">
      <h1 class="page-title">Recall detail</h1>
      <div class="meta-lead">
        Prototype date: <span class="font-mono">14 May 2026</span> · Europe/London (BST)
      </div>
    </div>

    <!-- Active Recall Scope & Accountability Lead -->
    <section class="panel">
      <div class="panel-header">
        <div style="display: flex; align-items: center; gap: 12px;">
          <h2 class="section-title">Recall RC-12</h2>
          <span class="status-refused"><span class="status-dot-refused"></span>refused</span>
          <span style="font-size: 14px; color: #626262;">Active manufacturer recall</span>
        </div>
        <div style="font-size: 14px; color: #626262;">
          Initiated: <span class="font-mono">14 May 2026 10:00 BST</span> by Nadia Farouk
        </div>
      </div>

      <div class="overview-grid">
        <!-- Lead 1: Lot & Product -->
        <div class="metric-col">
          <span class="metric-label">Affected Lot & Product</span>
          <div class="metric-value-huge font-mono" style="font-size: 22px;">IG-2509</div>
          <div style="font-size: 14px; color: #202020; font-weight: 500;">Insulin Glargine 100 units/mL</div>
          <span class="metric-hint">Expiry: <span class="font-mono">30 Nov 2026</span> · Profile v3 (2–8°C)</span>
        </div>

        <!-- Lead 2: Accounted Percentage -->
        <div class="metric-col">
          <span class="metric-label">Returned Accounted</span>
          <div class="metric-value-huge font-mono">16.7%</div>
          <span style="font-size: 14px; color: #202020;">
            <strong class="font-mono">4</strong> of <strong class="font-mono">24</strong> packs isolated
          </span>
          <span class="metric-hint">In North Quay quarantine</span>
        </div>

        <!-- Lead 3: Traced vs Received -->
        <div class="metric-col">
          <span class="metric-label">Traced vs Received (Exact Match)</span>
          <div class="metric-value-huge font-mono">
            24 <span style="font-size: 18px; color: #626262; font-weight: 400;">/</span> 24
          </div>
          <span class="status-good"><span class="status-dot-good"></span>good traced</span>
          <span class="metric-hint">Received 24 packs · 100% physically traced</span>
        </div>

        <!-- Lead 4: Customer Reconciliation Separation -->
        <div class="metric-col">
          <span class="metric-label">Customer Reconciliation</span>
          <div class="metric-value-huge font-mono status-waiting">
            20 <span style="font-size: 16px; font-weight: 500;">pending</span>
          </div>
          <span class="status-waiting"><span class="status-dot-waiting"></span>waiting response</span>
          <span class="metric-hint">Cedar Health response & physical return</span>
        </div>
      </div>

      <!-- Governance note clarifying tracing vs reconciliation -->
      <div style="padding: 16px 20px; border-top: 1px solid #D5D5D5;">
        <div class="governance-note">
          <strong>Cold Chain Assurance Notice:</strong> Traced quantity (<span class="font-mono">24/24 packs</span>) verifies complete chain-of-custody across North Quay Warehouse and carrier transit. Customer reconciliation (<span class="font-mono">20 packs</span> delivered to Cedar Clinic) represents unreturned consigned stock currently in off-site clinical custody. Tracing verification must never be confused with customer physical reconciliation.
        </div>
      </div>
    </section>

    <!-- Chronological Trace Table -->
    <section class="panel">
      <div class="panel-header">
        <div>
          <h2 class="section-title">Chronological lot trace & custody ledger</h2>
          <div style="font-size: 14px; color: #626262; margin-top: 2px;">
            Full physical custody ledger for Lot IG-2509 across warehouse storage, transit boxes, and consignee delivery
          </div>
        </div>
        <div style="font-size: 14px; color: #626262;">
