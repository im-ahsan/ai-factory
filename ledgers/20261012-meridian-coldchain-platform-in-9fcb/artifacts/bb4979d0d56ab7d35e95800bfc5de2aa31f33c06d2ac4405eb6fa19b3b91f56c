              <span class="field-hint">Authenticates Nadia Farouk credentials prior to immutable record seal</span>
            </div>

            <div class="button-group" style="align-items: center; margin-top: 8px;">
              <button type="button" class="btn btn-primary">
                Sign and close recall
              </button>
              <div class="warning-text">
                <span class="status-refused"><span class="status-dot-refused"></span>Irreversible warning:</span> Primary recall closure permanently seals electronic custody records and locks Lot IG-2509 disposition.
              </div>
            </div>
          </form>
        </div>
