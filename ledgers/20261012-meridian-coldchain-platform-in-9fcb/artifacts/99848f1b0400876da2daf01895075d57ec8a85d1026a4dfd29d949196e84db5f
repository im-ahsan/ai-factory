<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Route stops</title>
  <!-- Google Fonts: Hanken Grotesk, Public Sans, IBM Plex Mono -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@600;650;700&family=IBM+Plex+Mono:wght@400;500;600&family=Public+Sans:wght@400;500;600&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    /* Design System Tokens */
    :root {
      --bg-page: #F7F7F7;
      --bg-panel: #FFFFFF;
      --text-main: #202020;
      --text-quiet: #626262;
      --border-rule: #D5D5D5;
      --primary-accent: #A94B1D;
      --status-good: #24704B;
      --status-waiting: #805800;
      --status-refused: #AE2C2C;
    }

    body {
      background-color: var(--bg-page);
      color: var(--text-main);
      font-family: 'Public Sans', -apple-system, BlinkMacSystemFont, sans-serif;
      margin: 0;
      padding: 0;
      -webkit-font-smoothing: antialiased;
    }

    .font-heading {
      font-family: 'Hanken Grotesk', -apple-system, BlinkMacSystemFont, sans-serif;
    }

    .font-mono-val {
      font-family: 'IBM Plex Mono', monospace;
    }

    /* Motion Tokens & Keyframes */
    @keyframes entranceFadeIn {
      0% {
        opacity: 0;
        transform: translateY(6px);
      }
      100% {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes savedHandoff {
      0% {
        opacity: 0.6;
        transform: translateY(8px);
      }
      100% {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes waitingBreathe {
      0%, 100% {
        opacity: 0.7;
      }
      50% {
        opacity: 1;
      }
    }

    .animate-entrance {
      animation: entranceFadeIn 280ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    .status-handoff-anim {
      animation: savedHandoff 260ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    .dot-sync-breathe {
      animation: waitingBreathe 6s ease-in-out infinite;
    }

    /* Interactive state rules */
    button, a {
      transition: background-color 140ms ease, border-color 140ms ease, opacity 140ms ease, transform 90ms ease;
    }

    button:focus-visible, a:focus-visible {
      outline: 2px solid var(--primary-accent);
      outline-offset: 2px;
    }

    .btn-primary:active {
      transform: scale(0.985);
      opacity: 0.92;
    }

    .btn-secondary:active {
      transform: scale(0.985);
      background-color: #EFEFEF;
    }

    /* Respect reduced motion */
    @media (prefers-reduced-motion: reduce) {
      *, ::before, ::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
        scroll-behavior: auto !important;
      }
    }
  </style>
</head>
<body class="flex justify-center min-h-screen">
  <!-- Mobile Container ~390px -->
  <div class="w-full max-w-[392px] bg-[#F7F7F7] min-h-screen flex flex-col border-x border-[#D5D5D5] relative animate-entrance pb-12">
    
    <!-- Header (Mobile: Brand + Menu trigger, no other items, no footer) -->
    <header class="h-14 bg-white border-b border-[#D5D5D5] px-4 flex items-center justify-between sticky top-0 z-40">
      <div class="flex items-center gap-2">
        <!-- Small square with white M -->
        <div class="w-6 h-6 bg-[#202020] rounded-[2px] flex items-center justify-center">
          <span class="text-white text-xs font-bold font-heading leading-none">M</span>
        </div>
        <span class="font-heading font-semibold text-[17px] tracking-tight text-[#202020]">Meridian</span>
      </div>

      <!-- Mobile drawer toggle checkbox (pure CSS, no JS) -->
      <label for="mobile-nav-toggle" class="cursor-pointer p-1.5 -mr-1 rounded-[2px] border border-[#D5D5D5] bg-[#FFFFFF] hover:bg-[#F7F7F7] active:scale-95 flex items-center justify-center text-[#202020]" aria-label="Toggle Navigation Menu">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </label>
    </header>

    <!-- Hidden checkbox to control mobile nav menu purely in CSS -->
    <input type="checkbox" id="mobile-nav-toggle" class="peer hidden" />

    <!-- Drawer Navigation Backdrop & Menu Panel (pure CSS toggled) -->
    <div class="fixed inset-0 bg-black/40 z-50 hidden peer-checked:block transition-opacity">
      <div class="w-[300px] h-full bg-white border-r border-[#D5D5D5] p-4 flex flex-col justify-between shadow-none animate-entrance">
        <div>
          <!-- Drawer Header with close button -->
          <div class="flex items-center justify-between pb-4 border-b border-[#D5D5D5]">
            <div class="flex items-center gap-2">
              <div class="w-6 h-6 bg-[#202020] rounded-[2px] flex items-center justify-center">
                <span class="text-white text-xs font-bold font-heading leading-none">M</span>
              </div>
              <span class="font-heading font-semibold text-[16px] text-[#202020]">Meridian</span>
            </div>
            <label for="mobile-nav-toggle" class="cursor-pointer p-1 text-[#626262] hover:text-[#202020]">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
              </svg>
            </label>
          </div>

          <!-- Driver Profile in Drawer -->
          <div class="py-3 border-b border-[#D5D5D5] flex items-center justify-between">
            <div class="flex items-center gap-2.5">
              <span class="w-7 h-7 rounded-[2px] bg-[#F7F7F7] border border-[#D5D5D5] text-xs font-semibold text-[#202020] flex items-center justify-center font-heading">TM</span>
              <span class="text-[14px] font-medium text-[#202020]">Tariq Mansour · Driver</span>
            </div>
            <span class="text-[13px] text-[#626262]">EN / العربية</span>
          </div>

          <!-- Menu Links (worded exactly: Today's routes, Pending work) -->
          <nav class="mt-4 flex flex-col gap-1">
            <a href="#" class="px-3 py-2.5 text-[15px] font-medium rounded-[2px] text-[#A94B1D] bg-[#F7F7F7] border-l-2 border-[#A94B1D]">Today's routes</a>
            <a href="#" class="px-3 py-2.5 text-[15px] font-normal rounded-[2px] text-[#202020] hover:bg-[#F7F7F7]">Pending work</a>
          </nav>
        </div>

        <div class="pt-4 border-t border-[#D5D5D5] text-[13px] text-[#626262]">
          Europe/London (BST)
        </div>
      </div>
    </div>

    <!-- Main Content Area -->
    <main class="p-4 flex flex-col gap-6">

      <!-- One Page Heading -->
      <div>
        <h1 class="font-heading text-[28px] leading-tight font-[650] text-[#202020] tracking-tight">Route stops</h1>
      </div>

      <!-- Route Header & Vehicle Overview Panel (2px corner, 1px solid border #D5D5D5, #FFFFFF bg) -->
      <section class="bg-white border border-[#D5D5D5] rounded-[2px] p-4 flex flex-col gap-4">
        
        <!-- Route Title & Status Badge -->
        <div class="flex items-baseline justify-between pb-3 border-b border-[#D5D5D5]">
          <div class="flex items-baseline gap-2">
            <span class="text-[14px] text-[#626262]">Route</span>
            <span class="font-mono-val text-[20px] font-semibold text-[#202020]">R-204</span>
          </div>
          <div class="flex items-center gap-1.5 status-handoff-anim">
            <span class="w-2 h-2 rounded-full bg-[#24704B]"></span>
            <span class="text-[14px] font-medium text-[#24704B]">good</span>
          </div>
        </div>

        <!-- Vehicle Details -->
        <div class="flex flex-col gap-1 text-[14px]">
          <div class="flex items-baseline justify-between">
            <span class="text-[#626262]">Vehicle</span>
            <span class="font-mono-val text-[#202020] font-medium">VAN-27 <span class="text-[#626262] font-normal">(plate MTR-482)</span></span>
          </div>
          <div class="flex items-baseline justify-between">
            <span class="text-[#626262]">Driver</span>
            <span class="text-[#202020]">Tariq Mansour</span>
          </div>
          <div class="flex items-baseline justify-between">
            <span class="text-[#626262]">Consigned cargo</span>
            <span class="text-[#202020] text-right"><span class="font-mono-val">Order 0-299</span> (20 packs in <span class="font-mono-val">B-701 &amp; B-702</span>)</span>
          </div>
        </div>

        <!-- Real White-Van Photograph Cropped to 4:3 (2px rounded, 1px rule) -->
        <div class="w-full aspect-[4/3] rounded-[2px] overflow-hidden border border-[#D5D5D5] bg-[#F7F7F7]">
          <img 
            src="https://lh3.googleusercontent.com/aida/AEtjO1V6kxYXeODWvoVpe_AFHY4zsq216s3f0d3gRHvPhp40XlRK89pWY1jPW_fFhbYpRHAg1_GLjHxB-FI97c57LzSDBD1Hkjp0ljamOnEHEiCjXr-WXPbXNQohpZVStaEUMYdNNPm4wCbrUKRHPk9LUzi8cPB4mbUsQFeYIrxYsTYCb9B7tJ5XwjSuUWt4duyQ8iGzf2XMDVg_eov4oLCi_E4150eyJh3A7ZJyCpDoqQIYq3sgPEIJV-QGZSw" 
            alt="Refrigerated courier van VAN-27 at depot bay" 
            class="w-full h-full object-cover"
          />
        </div>

        <!-- Primary Action: Load boxes (solid fill #A94B1D, contrasting text, 48px tall, 2px corner) -->
        <button type="button" class="btn-primary w-full h-12 bg-[#A94B1D] text-white rounded-[2px] font-medium text-[16px] flex items-center justify-center hover:bg-[#933F17]">
          Load boxes
        </button>
      </section>

      <!-- Server Route Changes Alert (Appears when server changes route before more work proceeds) -->
      <div class="bg-white border border-[#D5D5D5] rounded-[2px] p-4 flex items-center justify-between">
        <div class="flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-[#805800] dot-sync-breathe"></span>
          <span class="text-[14px] text-[#202020]">Schedule updates from dispatch</span>
        </div>
        <a href="#" class="text-[14px] font-medium text-[#A94B1D] hover:underline underline-offset-4 focus-visible:outline-none">Route changes</a>
      </div>

      <!-- Ordered Stops Section -->
      <section class="flex flex-col gap-3">
        <div class="flex items-baseline justify-between px-0.5">
          <h2 class="font-heading text-[20px] font-[650] text-[#202020]">Ordered stops</h2>
          <span class="text-[14px] text-[#626262] font-mono-val">1 stop planned</span>
        </div>

        <!-- Stop Card (Individual stop row stacked for phone, 48px row heights / flush dividers) -->
        <div class="bg-white border border-[#D5D5D5] rounded-[2px] overflow-hidden">
          
          <!-- Stop Header Row -->
          <div class="p-4 border-b border-[#D5D5D5] flex items-start justify-between">
            <div class="flex items-start gap-3">
              <span class="w-6 h-6 rounded-[2px] bg-[#202020] text-white text-[13px] font-semibold flex items-center justify-center font-mono-val flex-shrink-0 mt-0.5">1</span>
              <div>
                <div class="flex items-center gap-2">
                  <h3 class="font-heading font-semibold text-[16px] text-[#202020]">Cedar Clinic</h3>
                  <div class="flex items-center gap-1">
                    <span class="w-1.5 h-1.5 rounded-full bg-[#24704B]"></span>
                    <span class="text-[13px] font-medium text-[#24704B]">good</span>
                  </div>
                </div>
                <p class="text-[14px] text-[#626262] mt-0.5">42 River Road, London</p>
              </div>
            </div>
            <div class="text-right">
              <span class="block text-[12px] text-[#626262]">Planned</span>
              <span class="font-mono-val text-[15px] font-semibold text-[#202020]">15:00 BST</span>
            </div>
          </div>

          <!-- Consignment & Product Details Meta Row -->
          <div class="p-4 bg-[#FFFFFF] border-b border-[#D5D5D5] text-[14px] flex flex-col gap-1.5">
            <div class="flex justify-between items-baseline">
              <span class="text-[#626262]">Consignment</span>
              <span class="font-mono-val text-[#202020]">Order 0-299</span>
            </div>
            <div class="flex justify-between items-baseline">
              <span class="text-[#626262]">Product</span>
              <span class="text-[#202020] text-right">Insulin Glargine 100 units/mL</span>
            </div>
            <div class="flex justify-between items-baseline">
              <span class="text-[#626262]">Lot &amp; allocation</span>
              <span class="text-[#202020]"><span class="font-mono-val">Lot IG-2511</span> · 20 packs</span>
            </div>
            <div class="flex justify-between items-baseline">
              <span class="text-[#626262]">Packaging band</span>
              <span class="text-[#202020]">Profile v3 (<span class="font-mono-val">2.0°C–8.0°C</span>)</span>
            </div>
          </div>

          <!-- Secondary Button for Stop: Stop detail (48px tall, surface fill, 1px rule) -->
          <div class="p-3 border-b border-[#D5D5D5] bg-[#FFFFFF]">
            <button type="button" class="btn-secondary w-full h-12 bg-white border border-[#D5D5D5] text-[#202020] rounded-[2px] font-medium text-[15px] hover:bg-[#F7F7F7]">
              Stop detail
            </button>
          </div>

          <!-- Gateway Box Temperatures Section Header -->
          <div class="px-4 py-3 bg-[#F7F7F7] border-b border-[#D5D5D5]">
            <h4 class="text-[13px] font-semibold text-[#626262] uppercase tracking-wider">Gateway box temperatures</h4>
          </div>

          <!-- Box B-701 Record (48px logical row breakdown) -->
          <div class="p-4 border-b border-[#D5D5D5] flex flex-col gap-2">
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-2">
                <span class="font-mono-val text-[16px] font-semibold text-[#202020]">B-701</span>
                <span class="text-[14px] text-[#626262]">(12 packs)</span>
              </div>
              <div class="flex items-center gap-1.5">
                <span class="w-1.5 h-1.5 rounded-full bg-[#24704B]"></span>
                <span class="text-[13px] font-medium text-[#24704B]">good</span>
              </div>
            </div>

            <div class="grid grid-cols-2 gap-2 text-[14px] pt-1">
              <div>
                <span class="block text-[12px] text-[#626262]">Latest temperature</span>
                <span class="font-mono-val text-[16px] font-semibold text-[#202020]">4.4°C</span>
              </div>
              <div>
                <span class="block text-[12px] text-[#626262]">Reading time</span>
                <span class="font-mono-val text-[14px] text-[#202020]">14:40 BST</span>
              </div>
            </div>

            <div class="flex items-center justify-between text-[13px] pt-1 border-t border-[#D5D5D5]/60 text-[#626262]">
              <span>Gateway: <span class="font-mono-val text-[#202020]">LOG-9921</span></span>
              <span class="text-[#24704B] font-medium flex items-center gap-1">
                <span class="w-1.5 h-1.5 rounded-full bg-[#24704B]"></span> Connected
              </span>
            </div>
          </div>

          <!-- Box B-702 Record (Disconnected with cached readings stale) -->
          <div class="p-4 flex flex-col gap-2 bg-[#FFFFFF]">
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-2">
                <span class="font-mono-val text-[16px] font-semibold text-[#202020]">B-702</span>
                <span class="text-[14px] text-[#626262]">(8 packs)</span>
              </div>
              <div class="flex items-center gap-1.5">
                <span class="w-1.5 h-1.5 rounded-full bg-[#24704B]"></span>
                <span class="text-[13px] font-medium text-[#24704B]">good</span>
              </div>
            </div>

            <div class="grid grid-cols-2 gap-2 text-[14px] pt-1">
              <div>
                <span class="block text-[12px] text-[#626262]">Latest temperature</span>
                <div class="flex flex-col">
                  <span class="font-mono-val text-[16px] font-semibold text-[#202020]">4.8°C</span>
                  <!-- Disconnected cached reading stale label -->
                  <span class="text-[12px] text-[#805800] font-medium">[cached reading stale]</span>
                </div>
              </div>
              <div>
                <span class="block text-[12px] text-[#626262]">Reading time</span>
                <span class="font-mono-val text-[14px] text-[#202020]">11:45 BST</span>
              </div>
            </div>

            <div class="flex items-center justify-between text-[13px] pt-1 border-t border-[#D5D5D5]/60 text-[#626262]">
              <span>Gateway: <span class="font-mono-val text-[#202020]">LOG-8819</span></span>
              <span class="text-[#805800] font-medium flex items-center gap-1">
                <span class="w-1.5 h-1.5 rounded-full bg-[#805800]"></span> Disconnected
              </span>
            </div>
          </div>

        </div>
      </section>

    </main>

  </div>
</body>
</html>
