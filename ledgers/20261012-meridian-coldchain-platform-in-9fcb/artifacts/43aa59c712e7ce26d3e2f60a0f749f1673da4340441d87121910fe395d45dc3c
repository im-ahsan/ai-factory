<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Route plan</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@600;650;700&family=IBM+Plex+Mono:wght@400;500;600&family=Public+Sans:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    /* Reset & base tokens */
    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      background-color: #F7F7F7;
      color: #202020;
      font-family: 'Public Sans', sans-serif;
      font-size: 16px;
      line-height: 1.5;
      -webkit-font-smoothing: antialiased;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    /* Typography tokens */
    .font-mono {
      font-family: 'IBM Plex Mono', monospace;
    }

    .font-heading {
      font-family: 'Hanken Grotesk', sans-serif;
    }

    h1, .h1 {
      font-family: 'Hanken Grotesk', sans-serif;
      font-size: 28px;
      font-weight: 650;
      line-height: 1.25;
      color: #202020;
    }

    h2, .h2 {
      font-family: 'Hanken Grotesk', sans-serif;
      font-size: 20px;
      font-weight: 650;
      line-height: 1.3;
      color: #202020;
    }

    h3, .h3 {
      font-family: 'Hanken Grotesk', sans-serif;
      font-size: 16px;
      font-weight: 600;
      line-height: 1.4;
      color: #202020;
    }

    .text-quiet {
      color: #626262;
    }

    .text-sm {
      font-size: 14px;
      line-height: 1.4;
    }

    /* Status tokens */
    .status-good {
      color: #24704B;
    }
    .status-waiting {
      color: #805800;
    }
    .status-refused {
      color: #AE2C2C;
    }

    .status-dot {
      display: inline-block;
      width: 8px;
      height: 8px;
      border-radius: 50%;
      margin-right: 6px;
      vertical-align: middle;
    }
    .status-dot.good { background-color: #24704B; }
    .status-dot.waiting { background-color: #805800; }
    .status-dot.refused { background-color: #AE2C2C; }

    /* Layout & rhythm */
    .header-bar {
      height: 56px;
      background-color: #FFFFFF;
      border-bottom: 1px solid #D5D5D5;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 32px;
    }

    .header-left {
      display: flex;
      align-items: center;
      gap: 32px;
    }

    .brand-cluster {
      display: flex;
      align-items: center;
      gap: 10px;
      text-decoration: none;
      color: #202020;
    }

    .brand-mark {
      width: 24px;
      height: 24px;
      background-color: #202020;
      color: #FFFFFF;
      font-family: 'Hanken Grotesk', sans-serif;
      font-weight: 700;
      font-size: 14px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 2px;
    }

    .brand-title {
      font-family: 'Hanken Grotesk', sans-serif;
      font-weight: 700;
      font-size: 18px;
      letter-spacing: -0.01em;
    }

    .nav-menu {
      display: flex;
      align-items: center;
      gap: 24px;
      height: 56px;
    }

    .nav-item {
      display: inline-flex;
      align-items: center;
      height: 56px;
      color: #626262;
      text-decoration: none;
      font-size: 16px;
      font-weight: 500;
      position: relative;
      border-bottom: 2px solid transparent;
      transition: color 150ms ease;
    }

    .nav-item:hover {
      color: #202020;
    }

    .nav-item.active {
      color: #A94B1D;
      border-bottom-color: #A94B1D;
      font-weight: 600;
    }

    .header-right {
      display: flex;
      align-items: center;
      gap: 24px;
    }

    .user-profile {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .user-avatar {
      width: 32px;
      height: 32px;
      background-color: #FFFFFF;
      border: 1px solid #D5D5D5;
      border-radius: 2px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 13px;
      font-weight: 600;
      color: #202020;
    }

    .user-name-title {
      font-size: 15px;
      color: #202020;
    }

    .lang-switcher {
      font-size: 14px;
      color: #626262;
      padding-left: 16px;
      border-left: 1px solid #D5D5D5;
    }

    /* Main Container */
    .container {
      width: 100%;
      max-width: 1240px;
      margin: 0 auto;
      padding: 32px 32px 64px;
      display: flex;
      flex-direction: column;
      gap: 32px;
    }

    /* Panels */
    .panel {
      background-color: #FFFFFF;
      border: 1px solid #D5D5D5;
      border-radius: 2px;
      padding: 16px;
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    /* Buttons */
    .btn-primary {
      height: 48px;
      padding: 0 24px;
      background-color: #A94B1D;
      color: #FFFFFF;
      font-family: 'Public Sans', sans-serif;
      font-size: 16px;
      font-weight: 600;
      border: none;
      border-radius: 2px;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      transition: background-color 150ms ease, outline 150ms ease;
    }

    .btn-primary:hover {
      background-color: #933f16;
    }

    .btn-primary:focus-visible {
      outline: 2px solid #A94B1D;
      outline-offset: 2px;
    }

    .btn-primary:active {
      background-color: #7d3511;
    }

    .btn-secondary {
      height: 48px;
      padding: 0 20px;
      background-color: #FFFFFF;
      color: #202020;
      font-family: 'Public Sans', sans-serif;
      font-size: 16px;
      font-weight: 500;
      border: 1px solid #D5D5D5;
      border-radius: 2px;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      text-decoration: none;
      transition: background-color 150ms ease, border-color 150ms ease;
    }

    .btn-secondary:hover {
      background-color: #F7F7F7;
      border-color: #626262;
    }

    .btn-secondary:focus-visible {
      outline: 2px solid #A94B1D;
      outline-offset: 2px;
    }

    .btn-secondary:active {
      background-color: #EFEFEF;
    }

    /* Form Fields */
    .form-group {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .form-label {
      font-size: 14px;
      font-weight: 500;
      color: #626262;
    }

    .form-input {
      height: 48px;
      padding: 0 14px;
      background-color: #FFFFFF;
      border: 1px solid #D5D5D5;
      border-radius: 2px;
      font-family: 'Public Sans', sans-serif;
      font-size: 16px;
      color: #202020;
      outline: none;
      transition: border-color 150ms ease;
    }

    .form-input:focus {
      border-color: #A94B1D;
      outline: 1px solid #A94B1D;
    }

    /* Overview Header Card */
    .overview-grid {
      display: grid;
      grid-template-columns: 240px 1fr auto;
      gap: 24px;
      align-items: start;
    }

    .vehicle-photo {
      width: 240px;
      height: 180px; /* 4:3 ratio */
      object-fit: cover;
      border-radius: 2px;
      border: 1px solid #D5D5D5;
      display: block;
    }

    .overview-details {
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    .meta-row {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 16px;
      border-top: 1px solid #D5D5D5;
      padding-top: 16px;
    }

    .meta-item {
      display: flex;
      flex-direction: column;
      gap: 4px;
    }

    .meta-label {
      font-size: 14px;
      color: #626262;
    }

    .meta-value {
      font-size: 16px;
      font-weight: 500;
      color: #202020;
    }

    /* Table styles */
    .data-table {
      width: 100%;
      border-collapse: collapse;
      text-align: left;
    }

    .data-table th {
      height: 40px;
      padding: 0 16px;
      font-size: 14px;
      font-weight: 600;
      color: #626262;
      border-bottom: 1px solid #D5D5D5;
      background-color: #FFFFFF;
    }

    .data-table td {
      height: 48px;
      padding: 0 16px;
      font-size: 16px;
      border-bottom: 1px solid #D5D5D5;
      background-color: #FFFFFF;
      vertical-align: middle;
    }

    .data-table tr:last-child td {
      border-bottom: none;
    }

    /* Stop item styling inside stop editor */
    .stop-card {
      border: 1px solid #D5D5D5;
      border-radius: 2px;
      padding: 16px;
      background-color: #FFFFFF;
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    .stop-card-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding-bottom: 12px;
      border-bottom: 1px solid #D5D5D5;
    }

    .stop-title-wrap {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .stop-seq-badge {
      width: 28px;
      height: 28px;
      background-color: #202020;
      color: #FFFFFF;
      border-radius: 2px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 14px;
      font-weight: 600;
    }

    .parameters-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 16px;
    }

    .param-box {
      border: 1px solid #D5D5D5;
      border-radius: 2px;
      padding: 12px 14px;
      background-color: #FFFFFF;
      display: flex;
      flex-direction: column;
      gap: 4px;
    }

    /* Alert / Error returned directly beside affected stops */
    .stop-inline-error {
      border-top: 1px solid #D5D5D5;
      padding-top: 12px;
      display: flex;
      align-items: flex-start;
      gap: 12px;
    }

    .error-label {
      font-size: 14px;
      font-weight: 600;
      color: #AE2C2C;
      white-space: nowrap;
    }

    .error-body {
      font-size: 14px;
      color: #626262;
      line-height: 1.4;
    }

    /* Service returned changes banner */
    .service-diff-panel {
      border: 1px solid #D5D5D5;
      border-radius: 2px;
      padding: 16px;
      background-color: #FFFFFF;
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .diff-item {
      display: flex;
      align-items: baseline;
      gap: 12px;
      padding: 8px 0;
      border-bottom: 1px solid #D5D5D5;
      font-size: 14px;
    }

    .diff-item:last-child {
      border-bottom: none;
      padding-bottom: 0;
    }

    .diff-field {
      font-weight: 600;
      color: #202020;
      min-width: 180px;
    }

    .diff-prev {
      color: #626262;
      text-decoration: line-through;
    }

    .diff-arrow {
      color: #626262;
    }

    .diff-next {
      color: #202020;
      font-weight: 500;
    }

    .diff-reason {
      color: #626262;
      font-size: 14px;
      margin-left: auto;
    }

    /* Motion specifications */
    @keyframes entranceFadeIn {
      0% {
        opacity: 0;
        transform: translateY(6px);
      }
      100% {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .animate-entrance {
      animation: entranceFadeIn 280ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    /* Signature motion: Saved handoff */
    @keyframes savedHandoff {
      0% {
        opacity: 0.6;
        transform: translateY(8px);
      }
      100% {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .handoff-synced {
      animation: savedHandoff 260ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    /* Ambient animation during sync */
    @keyframes waitingBreathe {
      0%, 100% { opacity: 0.7; }
      50% { opacity: 1.0; }
    }

    .breathing-dot {
      animation: waitingBreathe 6s ease-in-out infinite;
    }

    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
      }
    }
  </style>
</head>
<body>

  <!-- Global Header -->
  <header class="header-bar">
    <div class="header-left">
      <div class="brand-cluster">
        <div class="brand-mark">M</div>
        <span class="brand-title">Meridian</span>
      </div>
      <nav class="nav-menu">
        <a href="#" class="nav-item">Orders</a>
        <a href="#" class="nav-item active">Routes</a>
      </nav>
    </div>
    <div class="header-right">
      <div class="user-profile">
        <div class="user-avatar font-heading">PN</div>
        <span class="user-name-title">Priya Nair · Dispatcher</span>
      </div>
      <div class="lang-switcher">EN / العربية</div>
    </div>
  </header>

  <!-- Main Content Area -->
  <main class="container animate-entrance">
    
    <!-- Page Heading and Primary Action Bar -->
    <div style="display: flex; justify-content: space-between; align-items: flex-end;">
      <div>
        <h1 class="font-heading">Route plan</h1>
        <p class="text-quiet text-sm" style="margin-top: 4px;">
          Ordered-stop editor and departure dispatch plan · Prototype date: <span class="font-mono">14 May 2026</span> · Europe/London (BST)
        </p>
      </div>
      <div style="display: flex; gap: 12px; align-items: center;">
        <a href="#" class="btn-secondary">Route detail</a>
        <button type="button" class="btn-primary">
          Confirm route
        </button>
      </div>
    </div>

    <!-- Service-returned changes to confirmed route banner -->
    <section class="panel service-diff-panel">
      <div style="display: flex; justify-content: space-between; align-items: center;">
        <div style="display: flex; align-items: center; gap: 8px;">
          <span class="status-dot good"></span>
          <h3 class="font-heading" style="display: inline;">Service-returned changes to confirmed route</h3>
        </div>
        <span class="text-sm font-mono text-quiet">Updated 14 May 2026 09:30 BST · Priya Nair</span>
      </div>
      <p class="text-sm text-quiet">
        Route modifications were evaluated by the dispatch verification service. Rather than silently accepting edits, the following schedule and telemetry adjustments were returned:
      </p>
      <div style="margin-top: 4px;">
        <div class="diff-item">
          <span class="diff-field">Cedar Clinic Departure</span>
          <span class="diff-prev font-mono">14:45 BST</span>
          <span class="diff-arrow">→</span>
          <span class="diff-next font-mono">15:00 BST</span>
          <span class="diff-reason">Buffer allocated for cold-chain shipper verification at North Quay Bay 12</span>
        </div>
        <div class="diff-item">
          <span class="diff-field">Qualified-duration limit</span>
          <span class="diff-prev font-mono">35 min safety margin</span>
          <span class="diff-arrow">→</span>
          <span class="diff-next font-mono">30 min safety margin</span>
          <span class="diff-reason">Synchronized with Profile v3 upper-tier cumulative allowance</span>
        </div>
        <div class="diff-item">
          <span class="diff-field">Box consignment check</span>
          <span class="diff-prev font-mono">B-701 single load</span>
          <span class="diff-arrow">→</span>
          <span class="diff-next font-mono">B-701 (12 packs) + B-702 (8 packs)</span>
          <span class="diff-reason">Consolidated fulfillment of Order O-299 allocation (20 packs total)</span>
        </div>
      </div>
    </section>

    <!-- Route & Vehicle Overview Panel -->
    <section class="panel">
      <div class="overview-grid">
        <!-- 4:3 Vehicle Photo -->
        <img 
          src="https://lh3.googleusercontent.com/aida/AEtjO1V6kxYXeODWvoVpe_AFHY4zsq216s3f0d3gRHvPhp40XlRK89pWY1jPW_fFhbYpRHAg1_GLjHxB-FI97c57LzSDBD1Hkjp0ljamOnEHEiCjXr-WXPbXNQohpZVStaEUMYdNNPm4wCbrUKRHPk9LUzi8cPB4mbUsQFeYIrxYsTYCb9B7tJ5XwjSuUWt4duyQ8iGzf2XMDVg_eov4oLCi_E4150eyJh3A7ZJyCpDoqQIYq3sgPEIJV-QGZSw" 
          alt="White refrigerated delivery van VAN-27 plate MTR-482 parked in logistics loading bay" 
          class="vehicle-photo"
        >

        <div class="overview-details">
          <div style="display: flex; justify-content: space-between; align-items: baseline;">
            <div>
              <h2 class="font-heading">Route R-204</h2>
              <span class="text-sm text-quiet">Schedule allocation · Assigned depot: North Quay Warehouse</span>
            </div>
            <div style="display: flex; align-items: center;">
              <span class="status-dot good"></span>
              <span class="status-good font-mono" style="font-weight: 600; font-size: 14px;">good (confirmed)</span>
            </div>
          </div>

          <div class="meta-row">
            <div class="meta-item">
              <span class="meta-label">Schedule date</span>
              <span class="meta-value font-mono">14 May 2026</span>
            </div>
            <div class="meta-item">
              <span class="meta-label">Vehicle</span>
              <span class="meta-value">VAN-27 <span class="font-mono text-quiet text-sm">(MTR-482)</span></span>
            </div>
            <div class="meta-item">
              <span class="meta-label">Assigned driver</span>
              <span class="meta-value">Tariq Mansour</span>
            </div>
            <div class="meta-item">
              <span class="meta-label">Assigned dispatcher</span>
              <span class="meta-value">Priya Nair</span>
            </div>
          </div>

          <div class="meta-row">
            <div class="meta-item">
              <span class="meta-label">Depot origin</span>
              <span class="meta-value">North Quay Warehouse</span>
            </div>
            <div class="meta-item">
              <span class="meta-label">Storage location</span>
              <span class="meta-value">Cold Room C2, Rack 4</span>
            </div>
            <div class="meta-item">
              <span class="meta-label">Consignment cargo</span>
              <span class="meta-value">Order O-299 (20 packs)</span>
            </div>
            <div class="meta-item">
              <span class="meta-label">Consignment condition</span>
              <span class="meta-value status-good font-mono"><span class="status-dot good"></span>good (Profile v3 compliant)</span>
            </div>
          </div>
        </div>

        <!-- Quick Route Controls Form -->
        <div style="display: flex; flex-direction: column; gap: 12px; width: 220px; border-left: 1px solid #D5D5D5; padding-left: 20px;">
          <div class="form-group">
            <label class="form-label" for="plan-date">Planned date</label>
            <input class="form-input font-mono text-sm" id="plan-date" type="text" value="14 May 2026" readonly>
          </div>
          <div class="form-group">
            <label class="form-label" for="plan-driver">Driver</label>
            <input class="form-input text-sm" id="plan-driver" type="text" value="Tariq Mansour" readonly>
          </div>
        </div>
      </div>
    </section>

    <!-- Ordered-Stop Editor Section -->
    <section style="display: flex; flex-direction: column; gap: 16px;">
      <div style="display: flex; justify-content: space-between; align-items: center;">
        <div>
          <h2 class="font-heading">Ordered stops & delivery sequence</h2>
          <p class="text-sm text-quiet">Sequential stop verification with configured qualified-duration safety margins and live predicted limits.</p>
        </div>
        <span class="text-sm font-mono text-quiet">1 stop planned · 0 stops pending</span>
      </div>

      <!-- Stop 1: Cedar Clinic (First Stop Planned 15:00) -->
      <div class="stop-card">
        <div class="stop-card-header">
          <div class="stop-title-wrap">
            <div class="stop-seq-badge font-mono">1</div>
            <div>
              <h3 class="font-heading" style="font-size: 18px;">Cedar Clinic</h3>
              <p class="text-sm text-quiet">Cedar Health · 42 River Road, London</p>
            </div>
          </div>
          <div style="display: flex; align-items: center; gap: 20px;">
            <div style="text-align: right;">
              <span class="meta-label">Planned arrival</span>
              <div class="font-mono" style="font-size: 16px; font-weight: 600;">14 May 2026 15:00 BST</div>
            </div>
            <div>
              <span class="status-dot good"></span>
              <span class="status-good font-mono" style="font-weight: 600; font-size: 14px;">good</span>
            </div>
          </div>
        </div>

        <!-- Cargo & Box Allocation for Stop 1 -->
        <div style="display: flex; flex-direction: column; gap: 8px;">
          <span class="meta-label">Associated order & consignments</span>
          <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px;">
            <div class="param-box">
              <span class="meta-label">Order reference</span>
              <span class="font-mono" style="font-size: 15px; font-weight: 600;">O-299</span>
              <span class="text-sm text-quiet">Customer: Cedar Health (Hana Youssef)</span>
            </div>
            <div class="param-box">
              <span class="meta-label">Shipper box B-701</span>
              <span class="font-mono" style="font-size: 15px; font-weight: 600;">12 packs · Insulin Glargine</span>
              <span class="text-sm status-good font-mono"><span class="status-dot good"></span>good (Lot IG-2511)</span>
            </div>
            <div class="param-box">
              <span class="meta-label">Shipper box B-702</span>
              <span class="font-mono" style="font-size: 15px; font-weight: 600;">8 packs · Insulin Glargine</span>
              <span class="text-sm status-good font-mono"><span class="status-dot good"></span>good (Lot IG-2511)</span>
            </div>
          </div>
        </div>

        <!-- Safety Margin and Predicted Limits Alongside Stop -->
        <div style="display: flex; flex-direction: column; gap: 8px;">
          <span class="meta-label">Service configured safety margins & predicted thermal limits</span>
          <div class="parameters-grid">
            <div class="param-box">
              <span class="meta-label">Configured qualified-duration safety margin</span>
              <span class="font-mono" style="font-size: 16px; font-weight: 600;">48 hours thermal hold</span>
              <span class="text-sm text-quiet">SenseTech / Berlinger data-logger required</span>
            </div>
            <div class="param-box">
