<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Routes</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@600;650;700&family=IBM+Plex+Mono:wght@400;500;600&family=Public+Sans:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    /* Reset & Exact Design Tokens */
    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      background-color: #F7F7F7;
      color: #202020;
      font-family: 'Public Sans', sans-serif;
      font-size: 16px;
      line-height: 1.5;
      -webkit-font-smoothing: antialiased;
      min-height: 100vh;
    }

    /* Typography */
    h1, .heading-main {
      font-family: 'Hanken Grotesk', sans-serif;
      font-size: 28px;
      font-weight: 650;
      line-height: 1.25;
      color: #202020;
    }

    h2, .heading-section {
      font-family: 'Hanken Grotesk', sans-serif;
      font-size: 20px;
      font-weight: 650;
      line-height: 1.3;
      color: #202020;
    }

    h3, .heading-small {
      font-family: 'Hanken Grotesk', sans-serif;
      font-size: 16px;
      font-weight: 600;
      line-height: 1.4;
      color: #202020;
    }

    .mono {
      font-family: 'IBM Plex Mono', monospace;
    }

    .quiet {
      color: #626262;
    }

    /* Motion specifications */
    @keyframes entranceFade {
      from {
        opacity: 0;
        transform: translateY(4px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes savedHandoff {
      0% {
        opacity: 0.6;
        transform: translateY(8px);
      }
      100% {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes breatheWaiting {
      0%, 100% { opacity: 0.7; }
      50% { opacity: 1; }
    }

    .animate-entrance {
      animation: entranceFade 200ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    /* Header */
    .app-header {
      background-color: #FFFFFF;
      border-bottom: 1px solid #D5D5D5;
      height: 64px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 32px;
      width: 100%;
    }

    .header-left {
      display: flex;
      align-items: center;
      gap: 32px;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 12px;
      text-decoration: none;
      color: #202020;
    }

    .brand-mark {
      width: 28px;
      height: 28px;
      background-color: #202020;
      color: #FFFFFF;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: 'Hanken Grotesk', sans-serif;
      font-weight: 700;
      font-size: 16px;
      border-radius: 2px;
    }

    .brand-name {
      font-family: 'Hanken Grotesk', sans-serif;
      font-weight: 700;
      font-size: 18px;
      letter-spacing: -0.01em;
    }

    .nav-menu {
      display: flex;
      align-items: center;
      gap: 24px;
      height: 64px;
    }

    .nav-item {
      display: flex;
      align-items: center;
      height: 100%;
      text-decoration: none;
      color: #626262;
      font-size: 16px;
      font-weight: 500;
      padding: 0 4px;
      position: relative;
      transition: color 150ms ease;
    }

    .nav-item:hover {
      color: #202020;
    }

    .nav-item:focus-visible {
      outline: 2px solid #A94B1D;
      outline-offset: -2px;
    }

    .nav-item.active {
      color: #A94B1D;
      font-weight: 600;
    }

    .nav-item.active::after {
      content: '';
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      height: 3px;
      background-color: #A94B1D;
    }

    .header-right {
      display: flex;
      align-items: center;
      gap: 24px;
    }

    .user-profile {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .user-initials {
      width: 32px;
      height: 32px;
      background-color: #F7F7F7;
      border: 1px solid #D5D5D5;
      border-radius: 2px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: 'Hanken Grotesk', sans-serif;
      font-weight: 600;
      font-size: 13px;
      color: #202020;
    }

    .user-name {
      font-size: 14px;
      color: #202020;
    }

    .lang-divider {
      width: 1px;
      height: 18px;
      background-color: #D5D5D5;
    }

    .lang-switcher {
      font-size: 14px;
      color: #626262;
    }

    /* Main Container */
    .main-content {
      max-width: 1376px;
      margin: 0 auto;
      padding: 32px;
      display: flex;
      flex-direction: column;
      gap: 32px;
    }

    /* Page Title */
    .page-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    /* Panels & Cards */
    .panel {
      background-color: #FFFFFF;
      border: 1px solid #D5D5D5;
      border-radius: 2px;
      padding: 16px;
    }

    /* Active Route Lead Card */
    .active-route-lead {
      display: grid;
      grid-template-columns: 220px 1fr auto;
      gap: 24px;
      align-items: center;
    }

    .route-vehicle-media {
      width: 220px;
      height: 165px; /* exactly 4:3 crop */
      border-radius: 2px;
      border: 1px solid #D5D5D5;
      overflow: hidden;
      background-color: #F7F7F7;
      flex-shrink: 0;
    }

    .route-vehicle-media img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .route-details-body {
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    .route-details-top {
      display: flex;
      align-items: baseline;
      gap: 16px;
      flex-wrap: wrap;
    }

    .badge-status {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-size: 14px;
      font-weight: 500;
    }

    .badge-status.status-good {
      color: #24704B;
    }

    .badge-status.status-waiting {
      color: #805800;
    }

    .badge-status.status-failed {
      color: #AE2C2C;
    }

    .status-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      display: inline-block;
    }

    .status-good .status-dot {
      background-color: #24704B;
    }

    .status-waiting .status-dot {
      background-color: #805800;
    }

    .status-failed .status-dot {
      background-color: #AE2C2C;
    }

    .meta-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 16px;
      padding-top: 16px;
      border-top: 1px solid #D5D5D5;
    }

    .meta-item {
      display: flex;
      flex-direction: column;
      gap: 4px;
    }

    .meta-label {
      font-size: 14px;
      color: #626262;
    }

    .meta-value {
      font-size: 16px;
      color: #202020;
      font-weight: 500;
    }

    .route-lead-actions {
      display: flex;
      flex-direction: column;
      gap: 12px;
      align-self: center;
      min-width: 160px;
    }

    /* Buttons */
    .btn {
      height: 48px;
      padding: 0 20px;
      border-radius: 2px;
      font-family: 'Public Sans', sans-serif;
      font-size: 16px;
      font-weight: 500;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      text-decoration: none;
      transition: background-color 140ms ease, border-color 140ms ease, transform 100ms ease;
    }

    .btn:focus-visible {
      outline: 2px solid #A94B1D;
      outline-offset: 2px;
    }

    .btn:active {
      transform: scale(0.98);
    }

    .btn-primary {
      background-color: #A94B1D;
      color: #FFFFFF;
      border: 1px solid #A94B1D;
    }

    .btn-primary:hover {
      background-color: #933f17;
      border-color: #933f17;
    }

    .btn-secondary {
      background-color: #FFFFFF;
      color: #202020;
      border: 1px solid #D5D5D5;
    }

    .btn-secondary:hover {
      background-color: #F7F7F7;
      border-color: #202020;
    }

    /* Filter Controls Bar */
    .filter-bar {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      gap: 16px;
      background-color: #FFFFFF;
      border: 1px solid #D5D5D5;
      border-radius: 2px;
      padding: 16px;
    }

    .filter-fields-group {
      display: flex;
      align-items: flex-end;
      gap: 16px;
      flex-wrap: wrap;
    }

    .field-group {
      display: flex;
      flex-direction: column;
      gap: 8px;
      min-width: 240px;
    }

    .field-label {
      font-size: 14px;
      color: #626262;
      font-weight: 500;
    }

    .field-input, .field-select {
      height: 48px;
      background-color: #FFFFFF;
      border: 1px solid #D5D5D5;
      border-radius: 2px;
      padding: 0 16px;
      font-family: 'Public Sans', sans-serif;
      font-size: 16px;
      color: #202020;
      outline: none;
      transition: border-color 140ms ease;
    }

    .field-input.mono, .field-select.mono {
      font-family: 'IBM Plex Mono', monospace;
    }

    .field-input:focus, .field-select:focus {
      border-color: #A94B1D;
      outline: 2px solid #A94B1D;
      outline-offset: -1px;
    }

    /* Table Component */
    .table-container {
      background-color: #FFFFFF;
      border: 1px solid #D5D5D5;
      border-radius: 2px;
      overflow: hidden;
    }

    .data-table {
      width: 100%;
      border-collapse: collapse;
      text-align: left;
    }

    .data-table th {
      height: 48px;
      padding: 0 16px;
      font-size: 14px;
      font-weight: 500;
      color: #626262;
      border-bottom: 1px solid #D5D5D5;
      background-color: #FFFFFF;
    }

    .data-table td {
      height: 48px;
      padding: 8px 16px;
      font-size: 16px;
      color: #202020;
      border-bottom: 1px solid #D5D5D5;
      vertical-align: middle;
    }

    .data-table tr:last-child td {
      border-bottom: none;
    }

    .data-table tbody tr:hover td {
      background-color: #FAFAFA;
    }

    .table-vehicle-cell {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .table-vehicle-thumb {
      width: 48px;
      height: 36px; /* 4:3 aspect ratio */
      border: 1px solid #D5D5D5;
      border-radius: 2px;
      overflow: hidden;
      flex-shrink: 0;
      background-color: #F7F7F7;
    }

    .table-vehicle-thumb img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .table-footer-status {
      padding: 12px 16px;
      background-color: #FFFFFF;
      border-top: 1px solid #D5D5D5;
      display: flex;
      align-items: center;
      justify-content: space-between;
      font-size: 14px;
      color: #626262;
    }

    /* Prefers-reduced-motion */
    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
        scroll-behavior: auto !important;
      }
    }
  </style>
</head>
<body>

