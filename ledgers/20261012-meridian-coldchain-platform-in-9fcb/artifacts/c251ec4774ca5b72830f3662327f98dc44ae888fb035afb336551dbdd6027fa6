<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Meridian — Set new password</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@600;650;700&family=IBM+Plex+Mono:wght@400;500;600&family=Public+Sans:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    /* CSS Reset & Design System Tokens */
    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      background-color: #F7F7F7;
      color: #202020;
      font-family: 'Public Sans', -apple-system, BlinkMacSystemFont, sans-serif;
      font-size: 16px;
      line-height: 1.5;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 32px 16px;
      -webkit-font-smoothing: antialiased;
    }

    /* Motion Tokens & Entrance Sequence */
    @keyframes entranceFadeUp {
      0% {
        opacity: 0;
        transform: translateY(12px);
      }
      100% {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes savedHandoff {
      0% {
        opacity: 0.6;
        transform: translateY(8px);
      }
      100% {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes ambientBreathe {
      0%, 100% {
        opacity: 0.7;
      }
      50% {
        opacity: 1;
      }
    }

    .wrapper {
      width: 100%;
      max-width: 440px;
      animation: entranceFadeUp 260ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    /* Meridian Logo & Brand Header */
    .brand-header {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 24px;
    }

    .brand-mark {
      width: 32px;
      height: 32px;
      background-color: #202020;
      color: #FFFFFF;
      font-family: 'Hanken Grotesk', sans-serif;
      font-weight: 700;
      font-size: 18px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 2px;
      user-select: none;
    }

    .brand-name {
      font-family: 'Hanken Grotesk', sans-serif;
      font-weight: 650;
      font-size: 20px;
      line-height: 1.2;
      color: #202020;
      letter-spacing: -0.01em;
    }

    /* Main Panel */
    .panel {
      background-color: #FFFFFF;
      border: 1px solid #D5D5D5;
      border-radius: 2px;
      padding: 32px;
    }

    .main-heading {
      font-family: 'Hanken Grotesk', sans-serif;
      font-weight: 650;
      font-size: 28px;
      line-height: 1.25;
      color: #202020;
      margin-bottom: 8px;
      letter-spacing: -0.01em;
    }

    .supporting-text {
      font-size: 16px;
      line-height: 1.5;
      color: #626262;
      margin-bottom: 24px;
    }

    /* Form Layout */
    .form-group {
      margin-bottom: 16px;
      display: flex;
      flex-direction: column;
    }

    .form-label {
      font-size: 14px;
      font-weight: 500;
      color: #202020;
      margin-bottom: 8px;
    }

    .input-field {
      width: 100%;
      height: 48px;
      background-color: #FFFFFF;
      border: 1px solid #D5D5D5;
      border-radius: 2px;
      padding: 0 16px;
      font-family: 'Public Sans', sans-serif;
      font-size: 16px;
      color: #202020;
      transition: border-color 150ms ease, box-shadow 150ms ease;
    }

    .input-field:hover {
      border-color: #626262;
    }

    .input-field:focus {
      outline: none;
      border-color: #A94B1D;
      box-shadow: 0 0 0 1px #A94B1D;
    }

    .form-action {
      margin-top: 24px;
      margin-bottom: 24px;
    }

    /* Buttons */
    .btn-primary {
      width: 100%;
      height: 48px;
      background-color: #A94B1D;
      color: #FFFFFF;
      border: 1px solid #A94B1D;
      border-radius: 2px;
      font-family: 'Public Sans', sans-serif;
      font-size: 16px;
      font-weight: 600;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: background-color 150ms ease, border-color 150ms ease;
    }

    .btn-primary:hover {
      background-color: #923f17;
      border-color: #923f17;
    }

    .btn-primary:focus {
      outline: none;
      box-shadow: 0 0 0 2px #F7F7F7, 0 0 0 4px #A94B1D;
    }

    .btn-primary:active {
      background-color: #7d3513;
      border-color: #7d3513;
    }

    .panel-navigation {
      display: flex;
      justify-content: center;
      align-items: center;
    }

    .nav-link {
      color: #626262;
      text-decoration: underline;
      font-size: 14px;
      font-weight: 500;
      background: none;
      border: none;
      cursor: pointer;
      padding: 4px 8px;
      border-radius: 2px;
      transition: color 150ms ease;
    }

    .nav-link:hover {
      color: #202020;
    }

    .nav-link:focus {
      outline: none;
      box-shadow: 0 0 0 2px #A94B1D;
      color: #202020;
    }

    @media (prefers-reduced-motion: reduce) {
      .wrapper {
        animation: none;
      }
      .input-field, .btn-primary, .nav-link {
        transition: none;
      }
    }
  </style>
</head>
<body>
  <main class="wrapper">
    <!-- Meridian Square M mark and Name above panel -->
    <header class="brand-header">
      <div class="brand-mark" aria-hidden="true">M</div>
      <span class="brand-name">Meridian</span>
    </header>

    <!-- Centered Form Panel -->
    <section class="panel">
      <h1 class="main-heading">Set new password</h1>
      <p class="supporting-text">Create a new password to secure your account access.</p>

      <form action="#" method="POST" onsubmit="return false;">
        <div class="form-group">
          <label for="new-password" class="form-label">New password</label>
          <input 
            type="password" 
            id="new-password" 
            name="new_password" 
            class="input-field" 
            autocomplete="new-password" 
            required
          >
        </div>

        <div class="form-group">
          <label for="confirm-password" class="form-label">Confirm password</label>
          <input 
            type="password" 
            id="confirm-password" 
            name="confirm_password" 
            class="input-field" 
            autocomplete="new-password" 
            required
          >
        </div>

        <div class="form-action">
          <button type="submit" class="btn-primary">Save password</button>
        </div>
      </form>

      <nav class="panel-navigation" aria-label="Account navigation">
        <a href="#signin" class="nav-link">Back to sign in</a>
      </nav>
    </section>
  </main>
</body>
</html>