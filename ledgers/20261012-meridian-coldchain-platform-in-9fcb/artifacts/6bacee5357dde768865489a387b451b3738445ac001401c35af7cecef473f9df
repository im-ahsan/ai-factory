<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Order detail — Meridian</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@600;650;700&family=IBM+Plex+Mono:wght@400;500;600&family=Public+Sans:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    /* Reset & tokens */
    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      background-color: #F7F7F7;
      color: #202020;
      font-family: 'Public Sans', sans-serif;
      font-size: 16px;
      line-height: 1.5;
      -webkit-font-smoothing: antialiased;
    }

    /* Headings in Hanken Grotesk */
    h1, h2, h3, .heading-hanken {
      font-family: 'Hanken Grotesk', sans-serif;
    }

    /* Numbers, codes, and times in IBM Plex Mono */
    .mono {
      font-family: 'IBM Plex Mono', monospace;
    }

    /* Exact Design Tokens */
    :root {
      --bg-page: #F7F7F7;
      --bg-surface: #FFFFFF;
      --text-main: #202020;
      --text-quieter: #626262;
      --border-rule: #D5D5D5;
      --primary-brand: #A94B1D;
      --status-good: #24704B;
      --status-waiting: #805800;
      --status-refused: #AE2C2C;
    }

    /* Motion specifications */
    @keyframes entranceFadeUp {
      0% {
        opacity: 0;
        transform: translateY(6px);
      }
      100% {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes savedHandoff {
      0% {
        opacity: 0.6;
        transform: translateY(8px);
      }
      100% {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes waitingBreathe {
      0%, 100% {
        opacity: 0.7;
      }
      50% {
        opacity: 1;
      }
    }

    .animate-entrance {
      animation: entranceFadeUp 260ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    .animate-saved-handoff {
      animation: savedHandoff 260ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    .breathe-waiting {
      animation: waitingBreathe 6s ease-in-out infinite;
    }

    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
      }
    }

    /* Header styling */
    header {
      background-color: #FFFFFF;
      border-bottom: 1px solid #D5D5D5;
      height: 56px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 32px;
    }

    .header-left {
      display: flex;
      align-items: center;
      gap: 32px;
      height: 100%;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 8px;
      text-decoration: none;
      color: #202020;
    }

    .brand-logo {
      width: 24px;
      height: 24px;
      background-color: #202020;
      color: #FFFFFF;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: 'Hanken Grotesk', sans-serif;
      font-weight: 700;
      font-size: 15px;
      border-radius: 2px;
    }

    .brand-text {
      font-family: 'Hanken Grotesk', sans-serif;
      font-weight: 650;
      font-size: 16px;
      letter-spacing: -0.2px;
    }

    .header-nav {
      display: flex;
      gap: 24px;
      height: 100%;
    }

    .nav-link {
      display: flex;
      align-items: center;
      text-decoration: none;
      font-size: 15px;
      font-weight: 500;
      color: #626262;
      height: 100%;
      position: relative;
      transition: color 120ms ease;
    }

    .nav-link:hover {
      color: #202020;
    }

    .nav-link:focus-visible {
      outline: 2px solid #A94B1D;
      outline-offset: -2px;
    }

    .nav-link.active {
      color: #A94B1D;
    }

    .nav-link.active::after {
      content: '';
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      height: 2px;
      background-color: #A94B1D;
    }

    .header-right {
      display: flex;
      align-items: center;
      gap: 24px;
    }

    .user-info {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .avatar-initials {
      width: 28px;
      height: 28px;
      background-color: #F7F7F7;
      border: 1px solid #D5D5D5;
      border-radius: 2px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 12px;
      font-weight: 600;
      color: #202020;
    }

    .user-name-role {
      font-size: 14px;
      color: #202020;
    }

    .lang-switcher {
      font-size: 14px;
      color: #626262;
      border-left: 1px solid #D5D5D5;
      padding-left: 16px;
    }

    /* Main container layout */
    main {
      max-width: 1140px;
      margin: 0 auto;
      padding: 32px 32px 64px;
    }

    /* Page title */
    .page-title {
      font-size: 28px;
      font-weight: 650;
      line-height: 1.25;
      color: #202020;
      margin-bottom: 24px;
    }

    /* Panels & components following design system rules */
    .panel {
      background-color: #FFFFFF;
      border: 1px solid #D5D5D5;
      border-radius: 2px;
      padding: 16px;
      margin-bottom: 32px;
    }

    .panel:last-child {
      margin-bottom: 0;
    }

    .panel-heading {
      font-size: 20px;
      font-weight: 650;
      line-height: 1.3;
      color: #202020;
      margin-bottom: 16px;
    }

    .sub-heading {
      font-size: 16px;
      font-weight: 600;
      line-height: 1.4;
      color: #202020;
      margin-bottom: 8px;
    }

    /* Status indicator tokens */
    .status-indicator {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: 14px;
      font-weight: 500;
    }

    .status-dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      flex-shrink: 0;
    }

    .status-good {
      color: #24704B;
    }
    .status-good .status-dot {
      background-color: #24704B;
    }

    .status-waiting {
      color: #805800;
    }
    .status-waiting .status-dot {
      background-color: #805800;
    }

    .status-refused {
      color: #AE2C2C;
    }
    .status-refused .status-dot {
      background-color: #AE2C2C;
    }

    /* Key-value metrics row */
    .summary-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding-bottom: 16px;
      margin-bottom: 16px;
      border-bottom: 1px solid #D5D5D5;
      flex-wrap: wrap;
      gap: 16px;
    }

    .order-identity {
      display: flex;
      align-items: center;
      gap: 16px;
    }

    .order-id {
      font-size: 24px;
      font-weight: 600;
      color: #202020;
    }

    .allocation-line {
      font-size: 16px;
      color: #202020;
      display: flex;
      align-items: center;
      gap: 16px;
    }

    .allocation-line span.quiet {
      color: #626262;
    }

    /* Detail Grid */
    .spec-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 16px;
    }

    .spec-item {
      display: flex;
      flex-direction: column;
      gap: 4px;
    }

    .spec-label {
      font-size: 14px;
      color: #626262;
      line-height: 1.3;
    }

    .spec-value {
      font-size: 15px;
      color: #202020;
      font-weight: 500;
    }

    /* Tables */
    .table-container {
      border: 1px solid #D5D5D5;
      border-radius: 2px;
      background-color: #FFFFFF;
      overflow-x: auto;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      text-align: left;
    }

    th {
      font-size: 14px;
      font-weight: 600;
      color: #626262;
      background-color: #FAFAFA;
      padding: 0 16px;
      height: 48px;
      border-bottom: 1px solid #D5D5D5;
      white-space: nowrap;
    }

    td {
      font-size: 15px;
      color: #202020;
      padding: 0 16px;
      height: 48px;
      border-bottom: 1px solid #D5D5D5;
      vertical-align: middle;
    }

    tr:last-child td {
      border-bottom: none;
    }

    /* Forms & Controls */
    .form-group {
      display: flex;
      flex-direction: column;
      gap: 8px;
      margin-bottom: 16px;
    }

    .form-label {
      font-size: 14px;
      color: #202020;
      font-weight: 500;
    }

    .form-field {
      height: 48px;
      background-color: #FFFFFF;
      border: 1px solid #D5D5D5;
      border-radius: 2px;
      padding: 0 16px;
      font-family: 'Public Sans', sans-serif;
      font-size: 15px;
      color: #202020;
      outline: none;
      transition: border-color 120ms ease;
    }

    .form-field:focus {
      border-color: #A94B1D;
      box-shadow: 0 0 0 1px #A94B1D;
    }

    .field-readonly {
      background-color: #F7F7F7;
      color: #626262;
      display: flex;
      align-items: center;
    }

    /* Buttons */
    .btn {
      height: 48px;
      padding: 0 24px;
      border-radius: 2px;
      font-family: 'Public Sans', sans-serif;
      font-size: 15px;
      font-weight: 600;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      text-decoration: none;
      transition: background-color 120ms ease, border-color 120ms ease, transform 90ms ease;
    }

    .btn:active {
      transform: scale(0.99);
    }

    .btn:focus-visible {
      outline: 2px solid #A94B1D;
      outline-offset: 2px;
    }

    .btn-primary {
      background-color: #A94B1D;
      color: #FFFFFF;
      border: 1px solid #A94B1D;
    }

    .btn-primary:hover {
      background-color: #933f17;
      border-color: #933f17;
    }

    .btn-secondary {
      background-color: #FFFFFF;
      color: #202020;
      border: 1px solid #D5D5D5;
    }

    .btn-secondary:hover {
      background-color: #F7F7F7;
      border-color: #BFBFBF;
    }

    /* Creator & modifier panel layout */
    .audit-strip {
      display: flex;
      justify-content: space-between;
      border-top: 1px solid #D5D5D5;
      padding-top: 16px;
      margin-top: 16px;
      font-size: 14px;
      color: #626262;
    }

    .audit-entry {
      display: flex;
      gap: 6px;
      align-items: center;
    }

    .route-effect-card {
      border: 1px solid #D5D5D5;
      border-radius: 2px;
      background-color: #FFFFFF;
      padding: 16px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-top: 12px;
    }
  </style>
</head>
<body>

  <!-- Persistent Standard Header -->
  <header>
    <div class="header-left">
      <a href="#" class="brand">
        <div class="brand-logo">M</div>
        <span class="brand-text">Meridian</span>
      </a>
      <nav class="header-nav">
        <a href="#" class="nav-link active">Orders</a>
        <a href="#" class="nav-link">Routes</a>
      </nav>
    </div>
    <div class="header-right">
      <div class="user-info">
        <div class="avatar-initials">PN</div>
        <span class="user-name-role">Priya Nair · Dispatcher</span>
      </div>
      <div class="lang-switcher">EN / العربية</div>
    </div>
  </header>

  <!-- Main Content Body -->
  <main class="animate-entrance">
    
    <!-- One Heading on Page -->
    <h1 class="page-title">Order detail</h1>

    <!-- Panel 1: Order O-301 & Allocation Summary -->
    <section class="panel">
      <!-- O-301 and its returned status first -->
      <div class="summary-bar">
        <div class="order-identity">
          <span class="order-id mono">O-301</span>
          <div class="status-indicator status-waiting">
            <span class="status-dot breathe-waiting"></span>
            <span>waiting</span>
          </div>
        </div>

        <!-- One line showing 30 ordered / 20 allocated / 10 outstanding -->
        <div class="allocation-line">
          <span class="mono"><strong>30</strong> ordered</span>
          <span class="quiet">/</span>
          <span class="mono"><strong>20</strong> allocated</span>
          <span class="quiet">/</span>
          <span class="mono"><strong>10</strong> outstanding</span>
          <span class="quiet">(not packed)</span>
        </div>
      </div>

      <!-- Cedar Health Destination & Specifications Grid -->
      <div class="spec-grid">
        <div class="spec-item">
          <span class="spec-label">Customer & destination</span>
          <span class="spec-value">Cedar Health · Cedar Clinic</span>
          <span class="spec-label" style="font-size: 13px;">42 River Road, London</span>
        </div>
        <div class="spec-item">
          <span class="spec-label">Shelf-life condition</span>
          <span class="spec-value">90-day shelf-life minimum</span>
          <span class="spec-label" style="font-size: 13px;">Customer requirement</span>
        </div>
        <div class="spec-item">
          <span class="spec-label">Warehouse location</span>
          <span class="spec-value">North Quay Warehouse</span>
          <span class="spec-label" style="font-size: 13px;">Cold Room C2, Rack 4</span>
        </div>
        <div class="spec-item">
          <span class="spec-label">Consignment condition</span>
          <div class="status-indicator status-good">
            <span class="status-dot"></span>
            <span>good</span>
          </div>
          <span class="spec-label" style="font-size: 13px;">Profile v3 (2–8°C) compliant</span>
        </div>
      </div>
    </section>

    <!-- Panel 2: Product & Lot-Level Allocation -->
    <section class="panel">
      <h2 class="panel-heading">Product & lot-level allocation</h2>

      <div style="margin-bottom: 16px;">
        <div style="font-weight: 600; font-size: 16px; margin-bottom: 4px;">Insulin Glargine 100 units/mL</div>
        <div style="color: #626262; font-size: 14px;">Pack of 10 pens · Profile v3 permitted 2–8°C · First upper tier >8–10°C (30-minute allowance)</div>
      </div>

      <div class="table-container">
        <table>
          <thead>
            <tr>
              <th>Lot number</th>
              <th>Expiry date</th>
              <th>Shelf life</th>
              <th>Handling unit</th>
              <th>Unit on hand</th>
              <th>Allocated to O-301</th>
              <th>Lot status</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td class="mono">IG-2511</td>
              <td class="mono">31 March 2027</td>
              <td>321 days remaining (&gt;90d minimum)</td>
              <td class="mono">HU-81</td>
              <td class="mono">100 packs (60 available, 40 allocated)</td>
              <td class="mono"><strong>20 packs</strong></td>
              <td>
                <div class="status-indicator status-good">
                  <span class="status-dot"></span>
                  <span>good</span>
                </div>
              </td>
            </tr>
            <tr>
              <td class="mono">IG-2511</td>
              <td class="mono">31 March 2027</td>
              <td>321 days remaining</td>
              <td class="mono">HU-82</td>
              <td class="mono">20 packs (10 quarantined, 5 On Hold, 2 Rejected, 3 Expired)</td>
              <td class="mono">0 packs (held)</td>
              <td>
                <div class="status-indicator status-waiting">
                  <span class="status-dot"></span>
                  <span>waiting</span>
                </div>
              </td>
            </tr>
          </tbody>
        </table>
      </div>

      <div style="margin-top: 16px; font-size: 14px; color: #626262; line-height: 1.4;">
        Current warehouse lot balance: 60 available, 40 allocated across orders (20 to O-299, 20 to O-301). 10 packs outstanding await incoming intake or inspection release before dispatch allocation.
      </div>
    </section>

    <!-- Panel 3: Service-Returned Box & Route Effects -->
    <section class="panel">
      <h2 class="panel-heading">Service-returned box and route effects</h2>
      
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 16px;">
        <div style="border: 1px solid #D5D5D5; border-radius: 2px; padding: 16px; background-color: #FFFFFF;">
          <div class="sub-heading">Route assignment effect</div>
          <div style="font-size: 14px; color: #626262; margin-bottom: 12px;">Returned service routing schedule:</div>
          <div style="display: flex; flex-direction: column; gap: 8px;">
            <div style="display: flex; justify-content: space-between;">
              <span style="font-size: 14px; color: #626262;">Target route</span>
              <span class="mono" style="font-size: 14px; font-weight: 500;">R-204</span>
            </div>
            <div style="display: flex; justify-content: space-between;">
              <span style="font-size: 14px; color: #626262;">Planned departure</span>
              <span class="mono" style="font-size: 14px;">14 May 2026 15:00 BST</span>
            </div>
            <div style="display: flex; justify-content: space-between;">
              <span style="font-size: 14px; color: #626262;">Vehicle & driver</span>
              <span style="font-size: 14px;">Tariq Mansour · VAN-27 (MTR-482)</span>
            </div>
            <div style="display: flex; justify-content: space-between; align-items: center; border-top: 1px solid #D5D5D5; padding-top: 8px; margin-top: 4px;">
              <span style="font-size: 14px; color: #626262;">Route status</span>
              <div class="status-indicator status-good">
                <span class="status-dot"></span>
                <span>good</span>
              </div>
            </div>
          </div>
          <div style="margin-top: 16px;">
            <a href="#" class="btn btn-secondary" style="width: 100%;">Route detail</a>
          </div>
        </div>

        <div style="border: 1px solid #D5D5D5; border-radius: 2px; padding: 16px; background-color: #FFFFFF;">
          <div class="sub-heading">Box packaging status</div>
          <div style="font-size: 14px; color: #626262; margin-bottom: 12px;">Shipper packaging eligibility and allocation:</div>
          <div style="display: flex; flex-direction: column; gap: 8px;">
            <div style="display: flex; justify-content: space-between;">
              <span style="font-size: 14px; color: #626262;">Packaging stage</span>
              <span style="font-size: 14px; font-weight: 500;">Unpacked (pending 10 outstanding)</span>
            </div>
            <div style="display: flex; justify-content: space-between;">
              <span style="font-size: 14px; color: #626262;">Box requirement</span>
              <span style="font-size: 14px;">BioTherm Insulated Shipper 12L</span>
            </div>
            <div style="display: flex; justify-content: space-between;">
              <span style="font-size: 14px; color: #626262;">Datalogger requirement</span>
              <span style="font-size: 14px;">SenseTech / Berlinger Fridge-tag</span>
            </div>
            <div style="display: flex; justify-content: space-between; align-items: center; border-top: 1px solid #D5D5D5; padding-top: 8px; margin-top: 4px;">
              <span style="font-size: 14px; color: #626262;">Box packaging eligibility</span>
              <div class="status-indicator status-waiting">
                <span class="status-dot"></span>
                <span>waiting</span>
              </div>
            </div>
          </div>
          <div style="margin-top: 16px; font-size: 13px; color: #626262;">
            Packing locked until 20 allocated packs are boxed or order is released for staged packaging.
          </div>
        </div>
      </div>
    </section>

    <!-- Panel 4: Focused Override Lot Section -->
    <section class="panel">
      <h2 class="panel-heading">Override lot</h2>
      <div style="font-size: 14px; color: #626262; margin-bottom: 16px;">
        Manual allocation adjustment requires an authorized operational reason. Modifications directly recalculate returned lot balances and routing eligibility.
      </div>

      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
        <div class="form-group">
          <label class="form-label" for="override-lot-select">Target lot for override</label>
          <input id="override-lot-select" class="form-field" type="text" value="IG-2511 (Exp: 31 March 2027 · North Quay C2)" readonly style="background-color: #F7F7F7; color: #202020;">
        </div>

        <div class="form-group">
          <label class="form-label" for="override-qty">Override allocation quantity (packs)</label>
          <input id="override-qty" class="form-field mono" type="text" value="20" placeholder="Enter pack quantity">
        </div>
      </div>

      <div class="form-group">
        <label class="form-label" for="override-reason">Override reason (required)</label>
        <input id="override-reason" class="form-field" type="text" value="Preserve remaining 10 packs allocation pending intake lot release from HU-82 quality review" placeholder="Specify mandatory justification">
      </div>

      <!-- Returned Allocation and Stock Result -->
      <div style="background-color: #F7F7F7; border: 1px solid #D5D5D5; border-radius: 2px; padding: 16px; margin: 16px 0;">
        <div style="font-size: 14px; font-weight: 600; color: #202020; margin-bottom: 8px;">Returned allocation and stock result:</div>
        <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px;">
          <div>
            <div style="font-size: 13px; color: #626262;">Returned allocation</div>
            <div class="mono" style="font-size: 15px; font-weight: 600; color: #202020;">20 packs (IG-2511 · HU-81)</div>
          </div>
          <div>
            <div style="font-size: 13px; color: #626262;">Returned warehouse balance</div>
            <div class="mono" style="font-size: 15px; font-weight: 600; color: #202020;">60 available / 40 allocated</div>
          </div>
          <div>
            <div style="font-size: 13px; color: #626262;">Validation state</div>
            <div class="status-indicator status-good">
              <span class="status-dot"></span>
              <span>good</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Actions: Override & Cancel order -->
      <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 16px;">
        <button type="button" class="btn btn-primary">Apply override</button>
        <!-- Cancel order is shown because O-301 is returned as available (not packed) -->
        <button type="button" class="btn btn-secondary">Cancel order</button>
      </div>
    </section>

    <!-- Panel 5: Audit & History (Creator and last changer with times) -->
    <section class="panel">
      <h2 class="panel-heading">Order activity and audit</h2>
      <div class="audit-strip" style="border-top: none; margin-top: 0; padding-top: 0;">
        <div class="audit-entry">
