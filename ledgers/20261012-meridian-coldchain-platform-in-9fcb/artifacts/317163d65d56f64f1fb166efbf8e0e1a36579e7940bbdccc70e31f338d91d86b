<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Stock</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@600;650;700&family=IBM+Plex+Mono:wght@400;500;600&family=Public+Sans:wght@400;500;600&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    body {
      background-color: #F7F7F7;
      color: #202020;
      font-family: 'Public Sans', sans-serif;
      margin: 0;
      padding: 0;
      -webkit-font-smoothing: antialiased;
    }
    
    h1, h2, h3 {
      font-family: 'Hanken Grotesk', sans-serif;
    }

    .font-mono-num {
      font-family: 'IBM Plex Mono', monospace;
    }

    /* Exact border and color styling */
    .border-custom {
      border-color: #D5D5D5;
    }

    .text-quiet {
      color: #626262;
    }

    /* Motion specifications */
    @keyframes entranceFadeUp {
      from {
        opacity: 0;
        transform: translateY(8px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes waitingBreathe {
      0%, 100% {
        opacity: 0.7;
      }
      50% {
        opacity: 1;
      }
    }

    .animate-entrance {
      animation: entranceFadeUp 260ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    .waiting-pulse {
      animation: waitingBreathe 6s ease-in-out infinite;
    }

    @media (prefers-reduced-motion: reduce) {
      .animate-entrance, .waiting-pulse {
        animation: none !important;
        transform: none !important;
      }
    }

    /* Control interactive states */
    .btn-secondary {
      height: 48px;
      background-color: #FFFFFF;
      border: 1px solid #D5D5D5;
      border-radius: 2px;
      color: #202020;
      transition: background-color 150ms ease, border-color 150ms ease;
    }
    .btn-secondary:hover {
      background-color: #F7F7F7;
      border-color: #626262;
    }
    .btn-secondary:focus {
      outline: none;
      border-color: #A94B1D;
      box-shadow: 0 0 0 1px #A94B1D;
    }
    .btn-secondary:active {
      background-color: #EDEDED;
    }

    .btn-primary {
      height: 48px;
      background-color: #A94B1D;
      border-radius: 2px;
      color: #FFFFFF;
      transition: opacity 150ms ease;
    }
    .btn-primary:hover {
      opacity: 0.92;
    }
    .btn-primary:focus {
      outline: none;
      box-shadow: 0 0 0 2px #FFFFFF, 0 0 0 4px #A94B1D;
    }
    .btn-primary:active {
      opacity: 0.84;
    }

    input, select {
      height: 48px;
      background-color: #FFFFFF;
      border: 1px solid #D5D5D5;
      border-radius: 2px;
      color: #202020;
      transition: border-color 150ms ease;
    }
    input:focus, select:focus {
      outline: none;
      border-color: #A94B1D;
      box-shadow: 0 0 0 1px #A94B1D;
    }

    .nav-item {
      transition: color 150ms ease, border-color 150ms ease;
    }
    .nav-item:hover {
      color: #202020;
    }
    .nav-item:focus {
      outline: none;
      border-color: #A94B1D;
    }

    /* Table row specifics */
    .stock-table tr {
      height: 48px;
    }
  </style>
</head>
