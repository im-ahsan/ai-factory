<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Team</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@600;650;700&family=IBM+Plex+Mono:wght@400;500;600&family=Public+Sans:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    /* Reset & Base Tokens */
    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      background-color: #F7F7F7;
      color: #202020;
      font-family: 'Public Sans', sans-serif;
      font-size: 16px;
      line-height: 1.5;
      -webkit-font-smoothing: antialiased;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    /* Typography */
    h1, .heading-main {
      font-family: 'Hanken Grotesk', sans-serif;
      font-size: 28px;
      line-height: 1.25;
      font-weight: 650;
      color: #202020;
    }

    h2, .heading-section {
      font-family: 'Hanken Grotesk', sans-serif;
      font-size: 20px;
      line-height: 1.3;
      font-weight: 650;
      color: #202020;
    }

    h3, .heading-sub {
      font-family: 'Hanken Grotesk', sans-serif;
      font-size: 16px;
      line-height: 1.4;
      font-weight: 600;
      color: #202020;
    }

    .mono {
      font-family: 'IBM Plex Mono', monospace;
    }

    .text-quiet {
      color: #626262;
    }

    .text-sm {
      font-size: 14px;
      line-height: 1.4;
    }

    /* Status Colors */
    .status-good {
      color: #24704B;
      font-weight: 500;
    }
    .status-waiting {
      color: #805800;
      font-weight: 500;
    }
    .status-failed {
      color: #AE2C2C;
      font-weight: 500;
    }

    .status-dot {
      display: inline-block;
      width: 8px;
      height: 8px;
      border-radius: 50%;
      margin-right: 6px;
      vertical-align: middle;
    }
    .status-dot.good { background-color: #24704B; }
    .status-dot.waiting { background-color: #805800; }
    .status-dot.failed { background-color: #AE2C2C; }

    /* Header */
    header {
      background-color: #FFFFFF;
      border-bottom: 1px solid #D5D5D5;
      height: 64px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 32px;
      width: 100%;
    }

    .header-left {
      display: flex;
      align-items: center;
      gap: 32px;
    }

    .brand-group {
      display: flex;
      align-items: center;
      gap: 12px;
      text-decoration: none;
      color: #202020;
    }

    .brand-mark {
      width: 24px;
      height: 24px;
      background-color: #202020;
      color: #FFFFFF;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: 'Hanken Grotesk', sans-serif;
      font-weight: 700;
      font-size: 14px;
      border-radius: 2px;
    }

    .brand-name {
      font-family: 'Hanken Grotesk', sans-serif;
      font-weight: 650;
      font-size: 18px;
      letter-spacing: -0.01em;
    }

    nav {
      display: flex;
      align-items: center;
      gap: 24px;
    }

    nav a {
      text-decoration: none;
      font-size: 15px;
      font-weight: 500;
      color: #626262;
      padding: 20px 0;
      position: relative;
      transition: color 140ms ease;
    }

    nav a:hover {
      color: #202020;
    }

    nav a.active {
      color: #A94B1D;
      font-weight: 600;
    }

    nav a.active::after {
      content: '';
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      height: 2px;
      background-color: #A94B1D;
    }

    .header-right {
      display: flex;
      align-items: center;
      gap: 20px;
    }

    .user-profile {
      display: flex;
      align-items: center;
      gap: 10px;
      font-size: 14px;
      color: #202020;
    }

    .avatar-initials {
      width: 32px;
      height: 32px;
      background-color: #F7F7F7;
      border: 1px solid #D5D5D5;
      border-radius: 2px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: 'Hanken Grotesk', sans-serif;
      font-size: 12px;
      font-weight: 600;
      color: #202020;
    }

    .lang-switch {
      font-size: 14px;
      color: #626262;
      border-left: 1px solid #D5D5D5;
      padding-left: 20px;
    }

    /* Layout Container */
    main {
      max-width: 1140px;
      width: 100%;
      margin: 0 auto;
      padding: 32px 24px 64px;
      display: flex;
      flex-direction: column;
      gap: 32px;
      flex: 1;
    }

    .page-title-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    /* Panels & Cards */
    .panel {
      background-color: #FFFFFF;
      border: 1px solid #D5D5D5;
      border-radius: 2px;
      overflow: hidden;
    }

    .panel-header {
      padding: 20px 24px;
      border-bottom: 1px solid #D5D5D5;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .panel-body {
      padding: 24px;
    }

    /* Forms & Controls */
    .form-grid {
      display: grid;
      grid-template-columns: 1fr 1fr auto;
      gap: 16px;
      align-items: flex-end;
    }

    .field-group {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .field-label {
      font-size: 14px;
      font-weight: 500;
      color: #202020;
    }

    .field-input, .field-select {
      height: 48px;
      background-color: #FFFFFF;
      border: 1px solid #D5D5D5;
      border-radius: 2px;
      padding: 0 16px;
      font-family: 'Public Sans', sans-serif;
      font-size: 15px;
      color: #202020;
      width: 100%;
      outline: none;
      transition: border-color 140ms ease, box-shadow 140ms ease;
    }

    .field-input:focus, .field-select:focus {
      border-color: #A94B1D;
      box-shadow: 0 0 0 1px #A94B1D;
    }

    .field-input::placeholder {
      color: #626262;
      opacity: 0.8;
    }

    /* Buttons */
    button, .btn {
      height: 48px;
      padding: 0 24px;
      font-family: 'Public Sans', sans-serif;
      font-size: 15px;
      font-weight: 600;
      border-radius: 2px;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      text-decoration: none;
      transition: background-color 140ms ease, border-color 140ms ease, transform 90ms ease, box-shadow 140ms ease;
      white-space: nowrap;
    }

    button:focus-visible, .btn:focus-visible {
      outline: none;
      box-shadow: 0 0 0 2px #FFFFFF, 0 0 0 4px #A94B1D;
    }

    button:active, .btn:active {
      transform: scale(0.98);
    }

    .btn-primary {
      background-color: #A94B1D;
      color: #FFFFFF;
      border: 1px solid #A94B1D;
    }

    .btn-primary:hover {
      background-color: #923f17;
      border-color: #923f17;
    }

    .btn-secondary {
      background-color: #FFFFFF;
      color: #202020;
      border: 1px solid #D5D5D5;
    }

    .btn-secondary:hover {
      background-color: #F7F7F7;
      border-color: #C0C0C0;
    }

    .btn-danger {
      background-color: #FFFFFF;
      color: #AE2C2C;
      border: 1px solid #D5D5D5;
    }

    .btn-danger:hover {
      background-color: #FFF5F5;
      border-color: #AE2C2C;
    }

    /* Tables */
    .table-container {
      width: 100%;
      overflow-x: auto;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      text-align: left;
    }

    thead th {
      height: 48px;
      background-color: #FFFFFF;
      font-size: 14px;
      font-weight: 600;
      color: #626262;
      padding: 0 24px;
      border-bottom: 1px solid #D5D5D5;
    }

    tbody tr {
      height: 56px;
      border-bottom: 1px solid #D5D5D5;
      transition: background-color 120ms ease;
    }

    tbody tr:last-child {
      border-bottom: none;
    }

    tbody tr:hover {
      background-color: #FAFAFA;
    }

    tbody td {
      padding: 12px 24px;
      vertical-align: middle;
      font-size: 15px;
    }

    .member-name {
      font-weight: 600;
      color: #202020;
    }

    .member-role {
      font-size: 14px;
      color: #626262;
    }

    .warning-box {
      background-color: #FFFFFF;
      border-left: 3px solid #AE2C2C;
      padding: 12px 16px;
      margin-top: 16px;
      font-size: 14px;
      color: #202020;
      line-height: 1.45;
      display: flex;
      align-items: flex-start;
      gap: 12px;
    }

    .meta-box {
      background-color: #FFFFFF;
      border: 1px solid #D5D5D5;
      border-radius: 2px;
      padding: 16px 20px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 14px;
      color: #626262;
    }

    /* Motion Tokens & Keyframes */
    @keyframes pageEnter {
      from {
        opacity: 0;
        transform: translateY(6px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes savedHandoff {
      0% {
        opacity: 0.6;
        transform: translateY(8px);
      }
      100% {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes waitingBreathe {
      0%, 100% {
        opacity: 0.7;
      }
      50% {
        opacity: 1;
      }
    }

    .animate-enter {
      animation: pageEnter 280ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    .animate-handoff {
      animation: savedHandoff 260ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
        scroll-behavior: auto !important;
      }
    }
  </style>
</head>
<body>

  <!-- Header -->
  <header>
    <div class="header-left">
      <a href="#" class="brand-group">
        <div class="brand-mark">M</div>
        <span class="brand-name">Meridian</span>
      </a>
      <nav>
        <a href="#">Addresses</a>
        <a href="#" class="active">Team</a>
      </nav>
    </div>
    <div class="header-right">
      <div class="user-profile">
        <div class="avatar-initials">SI</div>
        <span>Salma Idris · Cedar Health administrator</span>
      </div>
      <div class="lang-switch">EN / العربية</div>
    </div>
  </header>

  <!-- Main Workspace -->
  <main class="animate-enter">
    
    <!-- Title Area -->
    <div class="page-title-row">
      <h1>Team</h1>
      <div class="text-sm text-quiet">
        Scope: <strong style="color: #202020; font-weight: 600;">Cedar Health</strong>
      </div>
    </div>

    <!-- Scoped Team Members Panel -->
    <section class="panel">
      <div class="panel-header">
        <div>
          <h2 class="heading-section">Cedar Health team members</h2>
          <p class="text-sm text-quiet" style="margin-top: 2px;">Authorized accounts scoped to Cedar Health consignment orders and delivery administration</p>
        </div>
      </div>

      <div class="table-container">
        <table>
          <thead>
            <tr>
              <th style="width: 28%;">Member</th>
              <th style="width: 24%;">Role</th>
              <th style="width: 28%;">Email</th>
              <th style="width: 20%;">Access state</th>
            </tr>
          </thead>
          <tbody>
            <!-- Salma Idris -->
            <tr>
              <td>
                <div class="member-name">Salma Idris</div>
                <div class="text-sm text-quiet">Current active administrator</div>
              </td>
              <td>
                <span class="member-role" style="color: #202020; font-weight: 500;">Administrator</span>
              </td>
              <td>
                <span class="mono text-sm" style="color: #202020;">salma.idris@cedarhealth.example</span>
              </td>
              <td>
                <span class="status-good"><span class="status-dot good"></span>good active</span>
              </td>
            </tr>

            <!-- Hana Youssef -->
            <tr>
              <td>
                <div class="member-name">Hana Youssef</div>
                <div class="text-sm text-quiet">Primary buyer contact</div>
              </td>
              <td>
                <span class="member-role" style="color: #202020; font-weight: 500;">Buyer</span>
              </td>
              <td>
                <span class="mono text-sm" style="color: #202020;">hana.youssef@cedarhealth.example</span>
              </td>
              <td>
                <span class="status-good"><span class="status-dot good"></span>good active</span>
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- Scoped Member Management: Remove User Action (Eligible records) -->
    <section class="panel">
      <div class="panel-header">
        <div>
          <h3 class="heading-sub">Member access management</h3>
          <p class="text-sm text-quiet" style="margin-top: 2px;">Remove user permissions for eligible Cedar Health team records</p>
        </div>
      </div>
      <div class="panel-body">
        <div style="display: flex; justify-content: space-between; align-items: center; padding-bottom: 16px; border-bottom: 1px solid #D5D5D5;">
          <div>
            <div style="font-weight: 600; color: #202020;">Hana Youssef · Buyer</div>
            <div class="mono text-sm text-quiet">hana.youssef@cedarhealth.example · Eligible for access revocation</div>
          </div>
          <div>
            <button type="button" class="btn btn-danger">Remove user</button>
          </div>
        </div>

        <div class="warning-box">
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none" style="flex-shrink: 0; margin-top: 1px;">
            <path d="M10 2L18 16H2L10 2Z" stroke="#AE2C2C" stroke-width="2" stroke-linejoin="round"/>
            <path d="M10 8V11M10 13.5V14" stroke="#AE2C2C" stroke-width="2" stroke-linecap="round"/>
          </svg>
          <div>
            <strong style="color: #AE2C2C; font-weight: 600;">Irreversible warning:</strong> Removing user access permanently revokes Cedar Health procurement authority, order placement permissions, and consignee notice acknowledgments. This action cannot be undone.
          </div>
        </div>
      </div>
    </section>

    <!-- Invite User Form (Scoped to Cedar Health) -->
    <section class="panel">
      <div class="panel-header">
        <div>
          <h3 class="heading-sub">Invite team member</h3>
          <p class="text-sm text-quiet" style="margin-top: 2px;">Add a new authorized member scoped exclusively to Cedar Health</p>
        </div>
      </div>
      <div class="panel-body">
        <form onsubmit="return false;">
          <div class="form-grid">
            <div class="field-group">
              <label class="field-label" for="invite-email">Member email address</label>
              <input type="email" id="invite-email" class="field-input" placeholder="colleague@cedarhealth.example" required>
            </div>
            <div class="field-group">
              <label class="field-label" for="invite-role">Cedar Health role</label>
              <select id="invite-role" class="field-select">
                <option value="buyer">Buyer (Order placement & consignment notice)</option>
                <option value="clinical_receiver">Clinical receiver (Handover verification)</option>
                <option value="administrator">Customer administrator (Team management)</option>
              </select>
            </div>
            <div>
              <button type="submit" class="btn btn-primary">Invite user</button>
            </div>
          </div>
        </form>
        <p class="text-sm text-quiet" style="margin-top: 16px;">
          Invitations are cryptographically restricted to organization domain <strong class="mono" style="color: #202020;">@cedarhealth.example</strong>. Invitations or searches outside Cedar Health are strictly refused.
        </p>
      </div>
    </section>

    <!-- Context & Scope Reference -->
    <div class="meta-box">
      <div>
        Organization scope: <strong style="color: #202020; font-weight: 600;">Cedar Health</strong> · Prototype date: <span class="mono">14 May 2026</span> (<span class="mono">Europe/London BST</span>)
      </div>
      <div>
        Primary delivery location: <strong style="color: #202020; font-weight: 500;">Cedar Clinic, 42 River Road, London</strong>
      </div>
    </div>

  </main>

</body>
</html>
