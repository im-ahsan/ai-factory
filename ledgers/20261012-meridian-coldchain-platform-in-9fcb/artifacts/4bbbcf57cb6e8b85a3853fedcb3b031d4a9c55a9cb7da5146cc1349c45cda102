              </td>
              <td>
                <span class="font-mono" style="font-weight: 600; font-size: 15px; color: #202020;">B-701</span>
              </td>
              <td>
                <div style="display: flex; flex-direction: column;">
                  <span style="font-weight: 500; color: #202020;">
                    <span class="font-mono">12</span> packs · Insulin Glargine 100 units/mL
                  </span>
                  <span style="font-size: 14px; color: #626262;">
                    Lot <span class="font-mono">IG-2511</span> · Exp. <span class="font-mono">31 March 2027</span>
                  </span>
                </div>
              </td>
              <td>
                <span class="font-mono" style="color: #202020;">O-299</span>
              </td>
              <td>
                <span class="font-mono" style="color: #202020;">R-204</span>
              </td>
              <td>
                <span style="font-size: 14px; color: #202020;">Credo ProEnthalp 4L</span>
              </td>
              <td>
                <div style="display: flex; flex-direction: column;">
                  <span class="font-mono" style="font-size: 14px; color: #202020;">LOG-8814</span>
                  <span style="font-size: 13px; color: #626262;">1 logger assigned</span>
                </div>
              </td>
              <td>
                <div class="status-indicator status-good">
                  <span class="status-dot"></span>
                  <span>good</span>
                </div>
              </td>
              <td>
                <div class="status-indicator status-good">
                  <span class="status-dot"></span>
                  <span>sealed</span>
                </div>
              </td>
              <td style="text-align: right;">
                <button class="btn-secondary" type="button" style="height: 38px; padding: 0 14px;">Pack box</button>
              </td>
            </tr>

            <!-- Row 2: B-702 -->
            <tr>
              <td>
                <img src="https://lh3.googleusercontent.com/aida-public/AB6AXuAxsLYZzsTPKsiC2Rwd_tSdO9aX6b_fVpPAVz_SFLEd3sOiO9jg-6Oi-u94VdCfXi8wVPAOZMuFG85_85LATv8Aol1JQupRKhRUOlCZio546U4EBPoDiz9iVjH390-EbkbBkj8P_vtSvsmsbCwu0XrgsQSslyf9PVFxq5djLfOO8Z5fEl1GBHwrv8MI67XXWwVPnx0h6H_SRELIhPWW0_jZFHbsSmGH5eekVN3dxk-mPQIt-vbWInKM1QGSzOlyChF6DXuEJDmox7Q" alt="Sealed insulated shipper box B-702" style="width: 72px; height: 54px; object-fit: cover; border-radius: 2px; border: 1px solid #D5D5D5; display: block;" />
              </td>
              <td>
                <span class="font-mono" style="font-weight: 600; font-size: 15px; color: #202020;">B-702</span>
              </td>
              <td>
                <div style="display: flex; flex-direction: column;">
                  <span style="font-weight: 500; color: #202020;">
                    <span class="font-mono">8</span> packs · Insulin Glargine 100 units/mL
                  </span>
                  <span style="font-size: 14px; color: #626262;">
                    Lot <span class="font-mono">IG-2511</span> · Exp. <span class="font-mono">31 March 2027</span>
                  </span>
                </div>
              </td>
              <td>
                <span class="font-mono" style="color: #202020;">O-299</span>
              </td>
              <td>
                <span class="font-mono" style="color: #202020;">R-204</span>
              </td>
              <td>
                <span style="font-size: 14px; color: #202020;">Credo ProEnthalp 4L</span>
              </td>
              <td>
                <div style="display: flex; flex-direction: column;">
                  <span class="font-mono" style="font-size: 14px; color: #202020;">LOG-8819</span>
                  <span style="font-size: 13px; color: #626262;">1 logger assigned</span>
                </div>
              </td>
              <td>
                <div class="status-indicator status-good">
                  <span class="status-dot"></span>
                  <span>good</span>
                </div>
              </td>
              <td>
                <div class="status-indicator status-good">
                  <span class="status-dot"></span>
                  <span>sealed</span>
                </div>
              </td>
              <td style="text-align: right;">
                <button class="btn-secondary" type="button" style="height: 38px; padding: 0 14px;">Pack box</button>
              </td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- Table Footnote & Contextual Information Flush with Panel Boundary -->
      <div style="border-top: 1px solid #D5D5D5; padding: 12px 16px; background-color: #FAFAFA; display: flex; align-items: center; justify-content: space-between; font-size: 14px; color: #626262;">
        <div>
          Showing <span class="font-mono" style="font-weight: 500; color: #202020;">2</span> boxes for order <span class="font-mono" style="font-weight: 500; color: #202020;">O-299</span> · Route <span class="font-mono" style="font-weight: 500; color: #202020;">R-204</span> (Cedar Clinic, planned <span class="font-mono">14 May 2026 15:00</span>)
        </div>
        <div>
          Assigned warehouse: North Quay · Cold Room C2, Rack 4
        </div>
      </div>
    </section>

  </main>

</body>
</html>