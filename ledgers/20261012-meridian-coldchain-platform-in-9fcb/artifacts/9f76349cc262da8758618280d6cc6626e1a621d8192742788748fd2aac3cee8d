<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Recalls</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@500;600;650;700&family=IBM+Plex+Mono:wght@400;500;600&family=Public+Sans:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg-page: #F7F7F7;
      --bg-panel: #FFFFFF;
      --text-main: #202020;
      --text-muted: #626262;
      --border-color: #D5D5D5;
      --primary: #A94B1D;
      --status-good: #24704B;
      --status-waiting: #805800;
      --status-refused: #AE2C2C;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      background-color: var(--bg-page);
      color: var(--text-main);
      font-family: 'Public Sans', -apple-system, BlinkMacSystemFont, sans-serif;
      font-size: 16px;
      line-height: 1.5;
      -webkit-font-smoothing: antialiased;
      min-height: 100vh;
    }

    /* Motion Tokens & Keyframes */
    @keyframes pageEntrance {
      0% {
        opacity: 0;
        transform: translateY(6px);
      }
      100% {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes savedHandoff {
      0% {
        opacity: 0.6;
        transform: translateY(8px);
      }
      100% {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes waitingBreathe {
      0%, 100% {
        opacity: 0.7;
      }
      50% {
        opacity: 1;
      }
    }

    .animate-entrance {
      animation: pageEntrance 260ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    .status-dot-waiting {
      display: inline-block;
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background-color: var(--status-waiting);
      margin-right: 6px;
      vertical-align: middle;
    }

    .status-dot-refused {
      display: inline-block;
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background-color: var(--status-refused);
      margin-right: 6px;
      vertical-align: middle;
    }

    .status-dot-good {
      display: inline-block;
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background-color: var(--status-good);
      margin-right: 6px;
      vertical-align: middle;
    }

    .mono {
      font-family: 'IBM Plex Mono', monospace;
    }

    /* Typography */
    h1 {
      font-family: 'Hanken Grotesk', sans-serif;
      font-size: 28px;
      font-weight: 650;
      line-height: 1.2;
      color: var(--text-main);
    }

    h2 {
      font-family: 'Hanken Grotesk', sans-serif;
      font-size: 20px;
      font-weight: 650;
      line-height: 1.3;
      color: var(--text-main);
    }

    h3 {
      font-family: 'Hanken Grotesk', sans-serif;
      font-size: 16px;
      font-weight: 600;
      line-height: 1.4;
      color: var(--text-main);
    }

    .supporting-text {
      font-size: 14px;
      color: var(--text-muted);
    }

    /* Header */
    header {
      background-color: var(--bg-panel);
      border-bottom: 1px solid var(--border-color);
      height: 56px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 32px;
    }

    .header-left {
      display: flex;
      align-items: center;
      gap: 32px;
      height: 100%;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 8px;
      font-family: 'Hanken Grotesk', sans-serif;
      font-weight: 700;
      font-size: 18px;
      color: var(--text-main);
      text-decoration: none;
    }

    .brand-mark {
      width: 24px;
      height: 24px;
      background-color: #202020;
      color: #FFFFFF;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 2px;
      font-size: 14px;
      font-weight: 700;
      font-family: 'Hanken Grotesk', sans-serif;
    }

    nav {
      display: flex;
      height: 100%;
      align-items: center;
      gap: 24px;
    }

    .nav-item {
      text-decoration: none;
      color: var(--text-main);
      font-size: 15px;
      font-weight: 500;
      height: 100%;
      display: flex;
      align-items: center;
      padding: 0 4px;
      border-bottom: 2px solid transparent;
      transition: color 150ms ease, border-color 150ms ease;
    }

    .nav-item:hover {
      color: var(--primary);
    }

    .nav-item:focus {
      outline: none;
      box-shadow: 0 0 0 2px var(--primary);
      border-radius: 2px;
    }

    .nav-item.active {
      color: var(--primary);
      border-bottom: 2px solid var(--primary);
      font-weight: 600;
    }

    .header-right {
      display: flex;
      align-items: center;
      gap: 24px;
    }

    .user-profile {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 14px;
      color: var(--text-main);
    }

    .avatar-initials {
      width: 28px;
      height: 28px;
      background-color: #EFEFEF;
      border: 1px solid var(--border-color);
      border-radius: 2px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 12px;
      font-weight: 600;
      color: var(--text-main);
    }

    .lang-switcher {
      font-size: 14px;
      color: var(--text-muted);
      border-left: 1px solid var(--border-color);
      padding-left: 16px;
    }

    /* Container */
    main {
      max-width: 1280px;
      margin: 0 auto;
      padding: 32px 32px 48px;
    }

    /* Page Header area */
    .page-title-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 32px;
    }

    /* Panels */
    .panel {
      background-color: var(--bg-panel);
      border: 1px solid var(--border-color);
      border-radius: 2px;
      padding: 16px;
      margin-bottom: 32px;
    }

    .panel-flush {
      background-color: var(--bg-panel);
      border: 1px solid var(--border-color);
      border-radius: 2px;
      margin-bottom: 32px;
    }

    .panel-flush-header {
      padding: 16px;
      border-bottom: 1px solid var(--border-color);
    }

    /* Active recall lead banner / summary card */
    .lead-panel {
      background-color: var(--bg-panel);
      border: 1px solid var(--border-color);
      border-radius: 2px;
      padding: 16px;
      margin-bottom: 32px;
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    .lead-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      border-bottom: 1px solid var(--border-color);
      padding-bottom: 16px;
    }

    .lead-title-area {
      display: flex;
      flex-direction: column;
      gap: 4px;
    }

    .lead-badge-row {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .lead-stats-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 16px;
      padding-top: 4px;
    }

    .stat-item {
      display: flex;
      flex-direction: column;
      gap: 4px;
    }

    .stat-label {
      font-size: 14px;
      color: var(--text-muted);
    }

    .stat-value {
      font-size: 18px;
      font-weight: 600;
      color: var(--text-main);
    }

    /* Buttons */
    .btn {
      height: 48px;
      padding: 0 20px;
      border-radius: 2px;
      font-family: 'Public Sans', sans-serif;
      font-size: 15px;
      font-weight: 600;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      text-decoration: none;
      transition: background-color 150ms ease, border-color 150ms ease, transform 90ms ease;
    }

    .btn:active {
      transform: scale(0.98);
    }

    .btn:focus {
      outline: none;
      box-shadow: 0 0 0 2px var(--primary);
    }

    .btn-primary {
      background-color: var(--primary);
      color: #FFFFFF;
      border: 1px solid var(--primary);
    }

    .btn-primary:hover {
      background-color: #923f17;
      border-color: #923f17;
    }

    .btn-secondary {
      background-color: var(--bg-panel);
      color: var(--text-main);
      border: 1px solid var(--border-color);
    }

    .btn-secondary:hover {
      background-color: #F7F7F7;
      border-color: #C0C0C0;
    }

    /* Filter Bar */
    .filter-bar {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      padding: 16px;
      border-bottom: 1px solid var(--border-color);
      gap: 16px;
      flex-wrap: wrap;
    }

    .filter-fields {
      display: flex;
      gap: 16px;
      flex-wrap: wrap;
      align-items: flex-end;
    }

    .field-group {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    .field-label {
      font-size: 14px;
      color: var(--text-muted);
      font-weight: 500;
    }

    .input-field {
      height: 48px;
      background-color: var(--bg-panel);
      border: 1px solid var(--border-color);
      border-radius: 2px;
      padding: 0 14px;
      font-family: 'Public Sans', sans-serif;
      font-size: 15px;
      color: var(--text-main);
      min-width: 220px;
      transition: border-color 150ms ease;
    }

    .input-field:focus {
      outline: none;
      border-color: var(--primary);
      box-shadow: 0 0 0 1px var(--primary);
    }

    select.input-field {
      appearance: none;
      background-image: url("data:image/svg+xml;charset=US-ASCII,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20width%3D%2212%22%20height%3D%2212%22%20viewBox%3D%220%200%2024%2024%22%20fill%3D%22none%22%20stroke%3D%22%23626262%22%20stroke-width%3D%222%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%3E%3Cpolyline%20points%3D%226%209%2012%2015%2018%209%22%3E%3C%2Fpolyline%3E%3C%2Fsvg%3E");
      background-repeat: no-repeat;
      background-position: right 14px center;
      padding-right: 36px;
      cursor: pointer;
    }

    /* Table */
    .ledger-table {
      width: 100%;
      border-collapse: collapse;
      text-align: left;
    }

    .ledger-table th {
      height: 48px;
      padding: 0 16px;
      background-color: #FAFAFA;
      border-bottom: 1px solid var(--border-color);
      font-size: 14px;
      font-weight: 600;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 0.03em;
    }

    .ledger-table td {
      height: 48px;
      padding: 0 16px;
      border-bottom: 1px solid var(--border-color);
      font-size: 15px;
      color: var(--text-main);
      vertical-align: middle;
    }

    .ledger-table tr:last-child td {
      border-bottom: none;
    }

    .ledger-table tr:hover td {
      background-color: #FCFCFC;
    }

    .ledger-footer {
      padding: 12px 16px;
      background-color: #FAFAFA;
      border-top: 1px solid var(--border-color);
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 14px;
      color: var(--text-muted);
    }

    /* Status indicator */
    .status-text {
      display: inline-flex;
      align-items: center;
      font-weight: 500;
    }

    .status-text.waiting {
      color: var(--status-waiting);
    }

    .status-text.refused {
      color: var(--status-refused);
    }

    .status-text.good {
      color: var(--status-good);
    }

    @media (prefers-reduced-motion: reduce) {
      .animate-entrance {
        animation: none;
      }
      .btn, .input-field, .nav-item {
        transition: none;
      }
    }
  </style>
</head>
<body class="animate-entrance">

  <!-- Header -->
  <header>
    <div class="header-left">
      <a href="#" class="brand">
        <div class="brand-mark">M</div>
        <span>Meridian</span>
      </a>
      <nav>
        <a href="#" class="nav-item">Waiting decisions</a>
        <a href="#" class="nav-item active">Recalls</a>
      </nav>
    </div>
    <div class="header-right">
      <div class="user-profile">
        <div class="avatar-initials">NF</div>
        <span>Nadia Farouk · Quality Manager</span>
      </div>
      <div class="lang-switcher">
        <span>EN / العربية</span>
      </div>
    </div>
  </header>

  <!-- Main Content -->
  <main>
    <div class="page-title-row">
      <h1>Recalls</h1>
      <button class="btn btn-primary" type="button">Start recall</button>
    </div>

    <!-- Lead Active Recall Card -->
    <section class="lead-panel">
      <div class="lead-header">
        <div class="lead-title-area">
          <div class="lead-badge-row">
            <h2>Recall RC-12</h2>
            <span class="status-text refused"><span class="status-dot-refused"></span>refused</span>
          </div>
          <div class="supporting-text">
            Initiated <span class="mono">14 May 2026 10:00 BST</span> by Nadia Farouk · Lot <span class="mono">IG-2509</span> Insulin Glargine 100 units/mL
          </div>
        </div>
        <a href="#" class="btn btn-secondary">Recall detail</a>
      </div>

      <div class="lead-stats-grid">
        <div class="stat-item">
          <div class="stat-label">Traced lot scope</div>
          <div class="stat-value"><span class="mono">24</span> packs traced</div>
          <div class="supporting-text"><span class="mono">4</span> on hand (Cold Room C2, Rack 4)</div>
        </div>
        <div class="stat-item">
          <div class="stat-label">Customer delivery</div>
          <div class="stat-value"><span class="mono">20</span> packs delivered</div>
          <div class="supporting-text">Cedar Clinic · Order <span class="mono">O-290</span> (<span class="mono">13 May</span>)</div>
        </div>
        <div class="stat-item">
          <div class="stat-label">Returned accounted</div>
          <div class="stat-value"><span class="mono">16.7%</span> accounted</div>
          <div class="supporting-text"><span class="mono">4</span> of <span class="mono">24</span> isolated in quarantine</div>
        </div>
        <div class="stat-item">
          <div class="stat-label">Cedar Health response & reminder</div>
          <div class="stat-value status-text waiting"><span class="status-dot-waiting"></span>waiting</div>
          <div class="supporting-text">Response pending · Initial notice sent <span class="mono">10:05 BST</span></div>
        </div>
      </div>
    </section>

    <!-- Compact Filtered, CSV-Exportable Ledger -->
    <section class="panel-flush">
      <div class="filter-bar">
        <div class="filter-fields">
          <div class="field-group">
            <label class="field-label" for="filter-search">Search recall or lot</label>
            <input type="text" id="filter-search" class="input-field" placeholder="Search reference, lot, customer" value="IG-2509">
          </div>
          <div class="field-group">
            <label class="field-label" for="filter-status">Recall state</label>
            <select id="filter-status" class="input-field">
              <option selected>All states</option>
              <option>refused</option>
              <option>waiting</option>
              <option>good</option>
            </select>
          </div>
          <div class="field-group">
            <label class="field-label" for="filter-consignee">Consignee</label>
            <select id="filter-consignee" class="input-field">
              <option selected>All consignees</option>
              <option>Cedar Health · Cedar Clinic</option>
              <option>North Quay Warehouse</option>
            </select>
          </div>
        </div>
        <button class="btn btn-secondary" type="button">↓ CSV export</button>
      </div>

      <table class="ledger-table">
        <thead>
          <tr>
            <th>Recall</th>
            <th>Lot & Product</th>
            <th>Traced</th>
            <th>Accounted</th>
            <th>Consignee response</th>
            <th>Reminder state</th>
            <th>Status</th>
            <th>Action</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>
              <span class="mono" style="font-weight: 600;">RC-12</span>
            </td>
            <td>
              <div><span class="mono" style="font-weight: 600;">IG-2509</span> · Insulin Glargine</div>
              <div class="supporting-text">Exp: <span class="mono">30 Nov 2026</span> · Cold Room C2, Rack 4</div>
            </td>
            <td>
              <div><span class="mono">24</span> traced</div>
              <div class="supporting-text"><span class="mono">4</span> on hand, <span class="mono">20</span> delivered (<span class="mono">O-290</span>)</div>
            </td>
            <td>
              <div><span class="mono">16.7%</span> accounted</div>
              <div class="supporting-text">4/24 quarantined; 20 pending reconciliation</div>
            </td>
            <td>
              <div>Cedar Health (Cedar Clinic)</div>
              <div class="supporting-text status-text waiting"><span class="status-dot-waiting"></span>waiting response</div>
            </td>
            <td>
              <div>Reminder scheduled</div>
              <div class="supporting-text">Next at <span class="mono">14:00 BST</span> (Hana Youssef)</div>
            </td>
            <td>
              <span class="status-text refused"><span class="status-dot-refused"></span>refused</span>
            </td>
            <td>
              <a href="#" class="btn btn-secondary" style="height: 36px; padding: 0 14px; font-size: 14px;">Recall detail</a>
            </td>
          </tr>
        </tbody>
      </table>

      <div class="ledger-footer">
        <span>Showing <span class="mono">1</span> active recall · Prototype date: <span class="mono">14 May 2026</span> (Europe/London BST)</span>
        <span>Reconciliation pending · 20 packs awaiting Cedar Health physical return or destruction confirmation</span>
      </div>
    </section>

  </main>

</body>
</html>
