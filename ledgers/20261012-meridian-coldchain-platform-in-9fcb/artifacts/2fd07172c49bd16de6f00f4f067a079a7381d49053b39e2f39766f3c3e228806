<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Delivery detail</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@600;650;700&family=IBM+Plex+Mono:wght@400;500;600&family=Public+Sans:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      background-color: #F7F7F7;
      color: #202020;
      font-family: 'Public Sans', -apple-system, BlinkMacSystemFont, sans-serif;
      font-size: 16px;
      line-height: 1.5;
      -webkit-font-smoothing: antialiased;
      padding-bottom: 64px;
    }

    /* Motion Tokens & Keyframes */
    @keyframes entranceFadeUp {
      0% {
        opacity: 0;
        transform: translateY(8px);
      }
      100% {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes waitingBreathe {
      0%, 100% {
        opacity: 0.7;
      }
      50% {
        opacity: 1;
      }
    }

    .animate-entrance {
      animation: entranceFadeUp 260ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    .status-dot-waiting {
      animation: waitingBreathe 6s ease-in-out infinite;
    }

    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
      }
    }

    /* Typography */
    .font-mono {
      font-family: 'IBM Plex Mono', monospace;
    }

    .main-heading {
      font-family: 'Hanken Grotesk', sans-serif;
      font-size: 28px;
      font-weight: 650;
      line-height: 1.25;
      color: #202020;
    }

    .section-heading {
      font-family: 'Hanken Grotesk', sans-serif;
      font-size: 20px;
      font-weight: 650;
      line-height: 1.3;
      color: #202020;
    }

    .small-heading {
      font-family: 'Hanken Grotesk', sans-serif;
      font-size: 16px;
      font-weight: 600;
      line-height: 1.4;
      color: #202020;
    }

    .text-quiet {
      color: #626262;
    }

    .text-sm-support {
      font-size: 14px;
      line-height: 1.4;
    }

    /* Status Colors */
    .status-good {
      color: #24704B;
    }
    .status-waiting {
      color: #805800;
    }
    .status-failed {
      color: #AE2C2C;
    }

    .dot {
      display: inline-block;
      width: 8px;
      height: 8px;
      border-radius: 50%;
      margin-right: 6px;
      vertical-align: middle;
    }
    .dot-good { background-color: #24704B; }
    .dot-waiting { background-color: #805800; }
    .dot-failed { background-color: #AE2C2C; }

    /* Header */
    header {
      background: #FFFFFF;
      border-bottom: 1px solid #D5D5D5;
      height: 64px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 32px;
      position: sticky;
      top: 0;
      z-index: 50;
    }

    .header-left {
      display: flex;
      align-items: center;
      gap: 32px;
    }

    .brand-mark {
      display: flex;
      align-items: center;
      gap: 10px;
      text-decoration: none;
      color: #202020;
      font-family: 'Hanken Grotesk', sans-serif;
      font-weight: 700;
      font-size: 18px;
    }

    .brand-square {
      width: 28px;
      height: 28px;
      background: #202020;
      color: #FFFFFF;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 15px;
      font-weight: 700;
      border-radius: 2px;
    }

    nav {
      display: flex;
      align-items: center;
      gap: 24px;
    }

    .nav-item {
      text-decoration: none;
      font-size: 15px;
      font-weight: 500;
      color: #626262;
      padding: 20px 0;
      position: relative;
      transition: color 150ms ease;
    }

    .nav-item:hover {
      color: #202020;
    }

    .nav-item:focus-visible {
      outline: 2px solid #A94B1D;
      outline-offset: 4px;
      border-radius: 2px;
    }

    .nav-item.active {
      color: #A94B1D;
      font-weight: 600;
    }

    .nav-item.active::after {
      content: '';
      position: absolute;
      bottom: -1px;
      left: 0;
      right: 0;
      height: 2px;
      background: #A94B1D;
    }

    .header-right {
      display: flex;
      align-items: center;
      gap: 16px;
      font-size: 14px;
    }

    .avatar-initials {
      width: 32px;
      height: 32px;
      background: #EAEAEA;
      border: 1px solid #D5D5D5;
      border-radius: 2px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 13px;
      font-weight: 600;
      color: #202020;
    }

    .lang-switcher {
      color: #626262;
      margin-left: 8px;
      border-left: 1px solid #D5D5D5;
      padding-left: 16px;
    }

    /* Layout */
    .container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 32px 32px 0 32px;
    }

    .page-header {
      margin-bottom: 32px;
    }

    .section-gap {
      margin-bottom: 32px;
    }

    /* Panels */
    .panel {
      background: #FFFFFF;
      border: 1px solid #D5D5D5;
      border-radius: 2px;
      padding: 24px;
    }

    .panel-inset {
      padding: 16px;
      background: #FFFFFF;
      border: 1px solid #D5D5D5;
      border-radius: 2px;
    }

    /* Grid helpers */
    .grid-2col {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 24px;
    }

    .grid-3col {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 16px;
    }

    .grid-4col {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 16px;
    }

    /* Buttons & Controls */
    button, .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      height: 48px;
      padding: 0 20px;
      font-size: 15px;
      font-weight: 600;
      text-decoration: none;
      border-radius: 2px;
      cursor: pointer;
      transition: background-color 150ms ease, border-color 150ms ease, transform 90ms ease;
    }

    button:focus-visible, .btn:focus-visible {
      outline: 2px solid #A94B1D;
      outline-offset: 2px;
    }

    button:active, .btn:active {
      transform: scale(0.98);
    }

    .btn-primary {
      background: #A94B1D;
      color: #FFFFFF;
      border: 1px solid #A94B1D;
    }
    .btn-primary:hover {
      background: #933E15;
      border-color: #933E15;
    }

    .btn-secondary {
      background: #FFFFFF;
      color: #202020;
      border: 1px solid #D5D5D5;
    }
    .btn-secondary:hover {
      background: #F7F7F7;
      border-color: #C0C0C0;
    }

    .btn-link {
      background: transparent;
      border: none;
      height: auto;
      padding: 0;
      color: #A94B1D;
      font-size: 15px;
      font-weight: 600;
      text-decoration: underline;
      text-underline-offset: 4px;
      cursor: pointer;
    }
    .btn-link:hover {
      color: #933E15;
    }

    /* Table */
    table {
      width: 100%;
      border-collapse: collapse;
      text-align: left;
    }

    th {
      height: 48px;
      font-size: 13px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      color: #626262;
      border-bottom: 1px solid #D5D5D5;
      padding: 0 16px;
    }

    td {
      height: 48px;
      font-size: 15px;
      border-bottom: 1px solid #D5D5D5;
      padding: 0 16px;
      vertical-align: middle;
    }

    tr:last-child td {
      border-bottom: none;
    }

    /* Evidence photo & signature */
    .photo-frame {
      width: 100%;
      aspect-ratio: 4 / 3;
      object-fit: cover;
      border-radius: 2px;
      border: 1px solid #D5D5D5;
      display: block;
      background: #EAEAEA;
    }

    .sig-frame {
      width: 100%;
      height: 180px;
      border: 1px solid #D5D5D5;
      border-radius: 2px;
      background: #FFFFFF;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 16px;
    }

    .sig-frame svg {
      width: 100%;
      max-height: 100%;
    }

    .card-divider {
      height: 1px;
      background: #D5D5D5;
      margin: 16px 0;
    }

    .meta-group {
      display: flex;
      flex-direction: column;
      gap: 4px;
    }

    .meta-label {
      font-size: 13px;
      color: #626262;
    }

    .meta-value {
      font-size: 15px;
      color: #202020;
    }
  </style>
</head>
