<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Handling unit</title>
  <!-- Google Fonts: Hanken Grotesk, Public Sans, IBM Plex Mono -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@600;650;700&family=IBM+Plex+Mono:wght@400;500;600&family=Public+Sans:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    /* CSS Reset & Design System Tokens */
    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      background-color: #F7F7F7;
      color: #202020;
      font-family: 'Public Sans', sans-serif;
      font-size: 16px;
      line-height: 1.5;
      -webkit-font-smoothing: antialiased;
    }

    /* Typography assignments */
    h1, h2, h3, .heading-hanken {
      font-family: 'Hanken Grotesk', sans-serif;
      font-weight: 650;
    }

    .mono-val {
      font-family: 'IBM Plex Mono', monospace;
    }

    /* Motion Tokens & Keyframes */
    @keyframes pageEntrance {
      from {
        opacity: 0;
        transform: translateY(6px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes savedHandoff {
      from {
        opacity: 0.6;
        transform: translateY(8px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes waitingBreathe {
      0%, 100% {
        opacity: 0.7;
      }
      50% {
        opacity: 1;
      }
    }

    .animate-entrance {
      animation: pageEntrance 260ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
      }
    }

    /* Global Header */
    header {
      background: #FFFFFF;
      border-bottom: 1px solid #D5D5D5;
      height: 56px;
      padding: 0 32px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .header-left {
      display: flex;
      align-items: center;
      gap: 32px;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 8px;
      text-decoration: none;
      color: #202020;
      font-weight: 650;
      font-family: 'Hanken Grotesk', sans-serif;
      font-size: 18px;
    }

    .brand-logo {
      width: 24px;
      height: 24px;
      background: #202020;
      color: #FFFFFF;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: 'Hanken Grotesk', sans-serif;
      font-weight: 700;
      font-size: 14px;
      border-radius: 2px;
    }

    nav {
      display: flex;
      align-items: center;
      gap: 24px;
    }

    nav a {
      text-decoration: none;
      color: #626262;
      font-size: 15px;
      font-weight: 500;
      padding: 16px 0;
      position: relative;
      transition: color 140ms ease;
    }

    nav a:hover {
      color: #202020;
    }

    nav a:focus-visible {
      outline: 2px solid #A94B1D;
      outline-offset: 4px;
    }

    nav a.active {
      color: #A94B1D;
      font-weight: 600;
    }

    nav a.active::after {
      content: '';
      position: absolute;
      bottom: -1px;
      left: 0;
      right: 0;
      height: 2px;
      background: #A94B1D;
    }

    .header-right {
      display: flex;
      align-items: center;
      gap: 16px;
      font-size: 14px;
    }

    .user-profile {
      display: flex;
      align-items: center;
      gap: 8px;
      color: #202020;
    }

    .initials-avatar {
      width: 28px;
      height: 28px;
      border: 1px solid #D5D5D5;
      border-radius: 2px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: 'IBM Plex Mono', monospace;
      font-size: 12px;
      font-weight: 600;
      color: #202020;
      background: #F7F7F7;
    }

    .divider-v {
      width: 1px;
      height: 16px;
      background: #D5D5D5;
    }

    .lang-switcher {
      color: #626262;
      font-size: 14px;
    }

    /* Container */
    main {
      max-width: 1280px;
      margin: 0 auto;
      padding: 32px 32px 64px 32px;
    }

    /* Page Heading & Actions bar */
    .title-row {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      margin-bottom: 24px;
    }

    .title-area h1 {
      font-size: 28px;
      line-height: 1.2;
      color: #202020;
    }

    .actions-group {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    /* Buttons */
    .btn {
      height: 48px;
      padding: 0 20px;
      border-radius: 2px;
      font-size: 15px;
      font-weight: 600;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      text-decoration: none;
      cursor: pointer;
      transition: background-color 140ms ease, border-color 140ms ease, transform 90ms ease;
    }

    .btn:active {
      transform: scale(0.98);
    }

    .btn:focus-visible {
      outline: 2px solid #A94B1D;
      outline-offset: 2px;
    }

    .btn-primary {
      background-color: #A94B1D;
      color: #FFFFFF;
      border: 1px solid #A94B1D;
    }

    .btn-primary:hover {
      background-color: #923f17;
      border-color: #923f17;
    }

    .btn-secondary {
      background-color: #FFFFFF;
      color: #202020;
      border: 1px solid #D5D5D5;
    }

    .btn-secondary:hover {
      background-color: #F7F7F7;
      border-color: #C0C0C0;
    }

    /* Panels & Cards */
    .panel {
      background: #FFFFFF;
      border: 1px solid #D5D5D5;
      border-radius: 2px;
      padding: 16px;
      margin-bottom: 32px;
    }

    .panel-flush {
      padding: 0;
    }

    .panel-title {
      font-size: 20px;
      line-height: 1.3;
      color: #202020;
      margin-bottom: 16px;
    }

    .panel-header-padded {
      padding: 16px 16px 0 16px;
    }

    /* Status indicators */
    .status-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: 14px;
      font-weight: 500;
    }

    .status-dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      flex-shrink: 0;
    }

    .status-good {
      color: #24704B;
    }
    .status-good .status-dot {
      background-color: #24704B;
    }

    .status-waiting {
      color: #805800;
    }
    .status-waiting .status-dot {
      background-color: #805800;
    }

    .status-refused {
      color: #AE2C2C;
    }
    .status-refused .status-dot {
      background-color: #AE2C2C;
    }

    .status-neutral {
      color: #626262;
    }
    .status-neutral .status-dot {
      background-color: #626262;
    }

    /* Focal line panel */
    .focal-panel {
      background: #FFFFFF;
      border: 1px solid #D5D5D5;
      border-radius: 2px;
      padding: 24px;
      margin-bottom: 32px;
    }

    .focal-header {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      padding-bottom: 16px;
      border-bottom: 1px solid #D5D5D5;
      margin-bottom: 16px;
    }

    .focal-title {
      font-size: 24px;
      font-family: 'Hanken Grotesk', sans-serif;
      font-weight: 650;
      color: #202020;
    }

    .focal-subtitle {
      color: #626262;
      font-size: 14px;
    }

    .status-breakdown-row {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 20px;
    }

    .status-breakdown-label {
      font-size: 14px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      color: #626262;
    }

    .status-group {
      display: flex;
      align-items: center;
      gap: 16px;
    }

    .status-item {
      display: flex;
      align-items: center;
      gap: 6px;
      font-size: 15px;
    }

    /* Specs & Carton grid */
    .spec-grid {
      display: grid;
      grid-template-columns: 240px 1fr;
      gap: 24px;
      align-items: center;
    }

    .carton-photo-wrapper {
      width: 100%;
      aspect-ratio: 4 / 3;
      overflow: hidden;
      border-radius: 2px;
      border: 1px solid #D5D5D5;
      background: #F7F7F7;
    }

    .carton-photo-wrapper img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .spec-details {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 16px;
    }

    .spec-field {
      display: flex;
      flex-direction: column;
      gap: 4px;
    }

    .spec-label {
      font-size: 14px;
      color: #626262;
    }

    .spec-value {
      font-size: 16px;
      color: #202020;
      font-weight: 500;
    }

    /* Tier ledger & Alert summary */
    .two-col-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 32px;
      margin-bottom: 32px;
    }

    .tier-meter-bar {
      height: 10px;
      background: #F0F0F0;
      border: 1px solid #D5D5D5;
      border-radius: 2px;
      overflow: hidden;
      margin: 12px 0 8px 0;
      position: relative;
    }

    .tier-meter-fill {
      height: 100%;
      background: #805800;
      width: 73.33%; /* 22 of 30 mins */
    }

    .ledger-stats {
      display: flex;
      justify-content: space-between;
      font-size: 14px;
      color: #626262;
    }

    /* Tables */
    .data-table {
      width: 100%;
      border-collapse: collapse;
      text-align: left;
    }

    .data-table th {
      height: 48px;
      background: #FAFAFA;
      border-bottom: 1px solid #D5D5D5;
      padding: 0 16px;
      font-size: 14px;
      font-weight: 600;
      color: #626262;
    }

    .data-table td {
      height: 48px;
      border-bottom: 1px solid #D5D5D5;
      padding: 0 16px;
      font-size: 15px;
      color: #202020;
    }

    .data-table tr:last-child td {
      border-bottom: none;
    }

    /* SVG Temperature chart */
    .chart-container {
      padding: 16px;
      border-bottom: 1px solid #D5D5D5;
      background: #FFFFFF;
    }

    .chart-legend {
      display: flex;
      gap: 24px;
      align-items: center;
      margin-top: 12px;
      font-size: 14px;
      color: #626262;
    }

    .legend-item {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .legend-line {
      width: 18px;
      height: 2px;
    }

    /* Links */
    .text-link {
      color: #202020;
      text-decoration: underline;
      text-underline-offset: 3px;
      font-size: 14px;
      transition: color 140ms ease;
    }

    .text-link:hover {
      color: #A94B1D;
    }

    .text-link:focus-visible {
      outline: 2px solid #A94B1D;
      outline-offset: 2px;
    }
  </style>
</head>
