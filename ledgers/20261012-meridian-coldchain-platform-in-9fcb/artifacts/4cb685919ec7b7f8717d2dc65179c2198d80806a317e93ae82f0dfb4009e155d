    <!-- Full-width Temperature Chart with Permitted 2–8°C Band -->
    <div class="panel panel-flush" style="margin-bottom: 32px;">
      <div class="panel-header-padded">
        <div style="display: flex; justify-content: space-between; align-items: baseline;">
          <h2 class="panel-title" style="margin-bottom: 4px;">Inbound temperature profile</h2>
          <span class="mono-val" style="font-size: 14px; color: #626262;">Permitted band: 2.0°C – 8.0°C</span>
        </div>
        <p style="font-size: 14px; color: #626262;">Continuous logger timeline · HU-82 package sensor</p>
      </div>

      <div class="chart-container">
        <!-- High-fidelity SVG Temperature chart -->
        <svg viewBox="0 0 1100 220" width="100%" height="220" style="overflow: visible;">
