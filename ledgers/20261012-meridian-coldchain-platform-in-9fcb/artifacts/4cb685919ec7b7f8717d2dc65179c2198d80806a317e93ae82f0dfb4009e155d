          <line x1="50" y1="20" x2="1080" y2="20" stroke="#EDEDED" stroke-width="1" />
          <line x1="50" y1="60" x2="1080" y2="60" stroke="#EDEDED" stroke-width="1" />
          <line x1="50" y1="100" x2="1080" y2="100" stroke="#EDEDED" stroke-width="1" />
          <line x1="50" y1="140" x2="1080" y2="140" stroke="#EDEDED" stroke-width="1" />
