<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Pending work</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@600;650;700&family=IBM+Plex+Mono:wght@400;500;600&family=Public+Sans:wght@400;500;600&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    body {
      background-color: #F7F7F7;
      color: #202020;
      font-family: 'Public Sans', sans-serif;
      margin: 0;
      padding: 0;
      -webkit-font-smoothing: antialiased;
    }
    
    h1, h2, h3, .font-heading {
      font-family: 'Hanken Grotesk', sans-serif;
    }

    .font-mono-num {
      font-family: 'IBM Plex Mono', monospace;
    }

    /* Strict motion tokens */
    @keyframes pageEntrance {
      from {
        opacity: 0;
        transform: translateY(6px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes savedHandoff {
      from {
        opacity: 0.6;
        transform: translateY(8px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes syncBreathe {
      0%, 100% {
        opacity: 0.7;
      }
      50% {
        opacity: 1;
      }
    }

    .animate-entrance {
      animation: pageEntrance 280ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    .animate-handoff {
      animation: savedHandoff 260ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    .animate-sync-dot {
      animation: syncBreathe 6s ease-in-out infinite;
    }

    @media (prefers-reduced-motion: reduce) {
      .animate-entrance,
      .animate-handoff,
      .animate-sync-dot,
      * {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
      }
    }

    /* Interactive state styles */
    .btn-primary {
      background-color: #A94B1D;
      color: #FFFFFF;
      height: 48px;
      border-radius: 2px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 0 20px;
      font-weight: 600;
      font-size: 16px;
      transition: background-color 150ms ease, transform 90ms ease;
    }
    .btn-primary:hover {
      background-color: #8f3e17;
    }
    .btn-primary:active {
      transform: scale(0.98);
    }
    .btn-primary:focus-visible {
      outline: 2px solid #A94B1D;
      outline-offset: 2px;
    }

    .btn-secondary {
      background-color: #FFFFFF;
      color: #202020;
      border: 1px solid #D5D5D5;
      height: 48px;
      border-radius: 2px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 0 20px;
      font-weight: 500;
      font-size: 16px;
      transition: background-color 150ms ease, border-color 150ms ease, transform 90ms ease;
    }
    .btn-secondary:hover {
      background-color: #F7F7F7;
      border-color: #202020;
    }
    .btn-secondary:active {
      transform: scale(0.98);
    }
    .btn-secondary:focus-visible {
      outline: 2px solid #A94B1D;
      outline-offset: 2px;
    }

    .nav-item-active {
      border-bottom: 2px solid #A94B1D;
      color: #202020;
      font-weight: 600;
    }

    .nav-item-inactive {
      color: #626262;
      border-bottom: 2px solid transparent;
    }
    .nav-item-inactive:hover {
      color: #202020;
    }
    .nav-item-inactive:focus-visible {
      outline: 2px solid #A94B1D;
      outline-offset: 2px;
    }
  </style>
</head>
<body class="bg-[#F7F7F7] text-[#202020] min-h-screen">

  <!-- Header -->
  <header class="bg-[#FFFFFF] border-b border-[#D5D5D5] h-16 w-full flex items-center justify-between px-8">
    <div class="flex items-center gap-8 h-full">
      <div class="flex items-center gap-2">
        <div class="w-6 h-6 bg-[#202020] flex items-center justify-center rounded-[2px]">
          <span class="text-[#FFFFFF] text-xs font-bold leading-none">M</span>
        </div>
        <span class="font-heading font-bold text-lg tracking-tight text-[#202020]">Meridian</span>
      </div>
      <nav class="flex items-center gap-6 h-full text-base">
        <a href="#" class="nav-item-inactive h-full flex items-center px-1">Today's routes</a>
        <a href="#" class="nav-item-active h-full flex items-center px-1">Pending work</a>
      </nav>
    </div>

    <div class="flex items-center gap-6">
      <div class="flex items-center gap-2">
        <div class="w-8 h-8 rounded-[2px] bg-[#F7F7F7] border border-[#D5D5D5] flex items-center justify-center text-xs font-semibold text-[#202020]">
          TM
        </div>
        <span class="text-base text-[#202020]">Tariq Mansour · Driver</span>
      </div>
      <div class="h-4 w-[1px] bg-[#D5D5D5]"></div>
      <div class="text-sm font-medium text-[#626262]">
        <span class="text-[#202020]">EN</span> / العربية
      </div>
    </div>
  </header>

  <!-- Main Content Container -->
  <main class="max-w-[1240px] mx-auto px-8 py-8 animate-entrance">
    
    <!-- Title & Reauthentication Action Bar -->
    <div class="flex items-center justify-between mb-8">
      <div>
        <h1 class="text-[28px] leading-[34px] font-[650] text-[#202020]">Pending work</h1>
      </div>
      <div class="flex items-center gap-4">
        <a href="#" class="btn-primary">Sign in to sync</a>
      </div>
    </div>

    <!-- Prominent Unsent Actions Count over Chronological Ledger -->
    <div class="bg-[#FFFFFF] border border-[#D5D5D5] rounded-[2px] mb-8">
      <div class="p-6 border-b border-[#D5D5D5] flex items-start justify-between">
        <div>
          <div class="text-sm font-medium text-[#626262] uppercase tracking-wider mb-1">Unsent driver actions</div>
          <div class="flex items-baseline gap-3">
            <span class="font-mono-num text-[40px] font-semibold leading-none text-[#202020]">3</span>
            <span class="text-base text-[#626262]">unsent actions queued on Tariq's device</span>
          </div>
          <div class="text-sm text-[#626262] mt-2">
            Loading, handover and refusal actions recorded offline in <span class="text-[#202020] font-medium">VAN-27 (plate <span class="font-mono-num">MTR-482</span>)</span>. Actions auto-send when connectivity is established.
          </div>
        </div>
        <div class="text-right">
          <div class="text-xs text-[#626262]">Device session status</div>
          <div class="inline-flex items-center gap-1.5 mt-1 text-sm font-medium text-[#805800]">
            <span class="w-2 h-2 rounded-full bg-[#805800]"></span>
            <span>waiting (reauthentication required)</span>
          </div>
        </div>
      </div>

      <!-- Chronological Ledger -->
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="border-b border-[#D5D5D5] bg-[#FFFFFF] text-xs font-semibold text-[#626262] uppercase tracking-wider h-12">
              <th class="px-6 py-3 font-normal text-[#626262]">Time (BST)</th>
              <th class="px-6 py-3 font-normal text-[#626262]">Action</th>
              <th class="px-6 py-3 font-normal text-[#626262]">Entity / Stop</th>
              <th class="px-6 py-3 font-normal text-[#626262]">Payload summary</th>
              <th class="px-6 py-3 font-normal text-[#626262]">Transmission status</th>
              <th class="px-6 py-3 font-normal text-[#626262]">Returned outcome</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-[#D5D5D5] text-base">
            
            <!-- Row 1: Handover Action (Cedar Clinic, B-701) - Needs Tariq to sign in -->
            <tr class="h-12 hover:bg-[#F7F7F7] transition-colors">
              <td class="px-6 py-3 font-mono-num text-sm text-[#202020]">14:52</td>
              <td class="px-6 py-3 font-medium text-[#202020]">Handover</td>
              <td class="px-6 py-3 text-[#202020]">
                Cedar Clinic <span class="text-[#626262] text-sm">(Box <span class="font-mono-num">B-701</span>)</span>
              </td>
              <td class="px-6 py-3 text-sm text-[#626262]">
                12 packs Insulin Glargine (<span class="font-mono-num">IG-2511</span>), recipient signature captured
              </td>
              <td class="px-6 py-3">
                <span class="inline-flex items-center gap-1.5 text-sm font-medium text-[#805800]">
                  <span class="w-2 h-2 rounded-full bg-[#805800]"></span>
                  <span>waiting needs Tariq to sign in</span>
                </span>
              </td>
              <td class="px-6 py-3 text-sm text-[#626262]">
                Stored locally; awaiting driver session reauthentication
              </td>
            </tr>

            <!-- Row 2: Refusal Action - Syncing -->
            <tr class="h-12 hover:bg-[#F7F7F7] transition-colors">
              <td class="px-6 py-3 font-mono-num text-sm text-[#202020]">14:48</td>
              <td class="px-6 py-3 font-medium text-[#202020]">Refusal exception</td>
              <td class="px-6 py-3 text-[#202020]">
                Cedar Clinic <span class="text-[#626262] text-sm">(Consignment)</span>
              </td>
              <td class="px-6 py-3 text-sm text-[#626262]">
                Damaged external seal notice logged during vehicle unloading
              </td>
              <td class="px-6 py-3">
                <span class="inline-flex items-center gap-1.5 text-sm font-medium text-[#805800]">
                  <span class="w-2 h-2 rounded-full bg-[#805800] animate-sync-dot"></span>
                  <span>waiting syncing</span>
                </span>
              </td>
              <td class="px-6 py-3 text-sm text-[#626262]">
                Active background transmission in progress
              </td>
            </tr>

            <!-- Row 3: Loading Scan Action - Stored locally -->
            <tr class="h-12 hover:bg-[#F7F7F7] transition-colors">
              <td class="px-6 py-3 font-mono-num text-sm text-[#202020]">14:15</td>
              <td class="px-6 py-3 font-medium text-[#202020]">Loading scan</td>
              <td class="px-6 py-3 text-[#202020]">
                Box <span class="font-mono-num">B-701</span>
              </td>
              <td class="px-6 py-3 text-sm text-[#626262]">
                Van barcode scan verification (<span class="font-mono-num">MTR-482</span>), 12 packs confirmed
              </td>
              <td class="px-6 py-3">
                <span class="inline-flex items-center gap-1.5 text-sm font-medium text-[#805800]">
                  <span class="w-2 h-2 rounded-full bg-[#805800]"></span>
                  <span>waiting stored locally</span>
                </span>
              </td>
              <td class="px-6 py-3 text-sm text-[#626262]">
                Queued in durable local storage; unsent
              </td>
            </tr>

            <!-- Row 4: Returned stale-route / rejected action -->
            <tr class="h-12 hover:bg-[#F7F7F7] transition-colors">
              <td class="px-6 py-3 font-mono-num text-sm text-[#202020]">13:40</td>
              <td class="px-6 py-3 font-medium text-[#202020]">Departure check</td>
              <td class="px-6 py-3 text-[#202020]">
                Route <span class="font-mono-num">R-204</span>
              </td>
              <td class="px-6 py-3 text-sm text-[#626262]">
                Vehicle departure timestamp submission
              </td>
              <td class="px-6 py-3">
                <span class="inline-flex items-center gap-1.5 text-sm font-medium text-[#AE2C2C]">
                  <span class="w-2 h-2 rounded-full bg-[#AE2C2C]"></span>
                  <span>failed rejected</span>
                </span>
              </td>
              <td class="px-6 py-3 text-sm text-[#AE2C2C] flex items-center justify-between">
                <span>Stale-route outcome: Route schedule modified by dispatch</span>
                <a href="#" class="text-[#A94B1D] font-medium hover:underline ml-2">Route changes</a>
              </td>
            </tr>

            <!-- Row 5: Previously Acknowledged Handover -->
            <tr class="h-12 hover:bg-[#F7F7F7] transition-colors bg-[#FFFFFF]">
              <td class="px-6 py-3 font-mono-num text-sm text-[#626262]">10:14</td>
              <td class="px-6 py-3 font-medium text-[#626262]">Handover</td>
              <td class="px-6 py-3 text-[#626262]">
                Cedar Clinic
              </td>
              <td class="px-6 py-3 text-sm text-[#626262]">
                20 packs (<span class="font-mono-num">IG-2509</span>) delivered to Rania Karim
              </td>
              <td class="px-6 py-3">
                <span class="inline-flex items-center gap-1.5 text-sm font-medium text-[#24704B] animate-handoff">
                  <span class="w-2 h-2 rounded-full bg-[#24704B]"></span>
                  <span>good acknowledged</span>
                </span>
              </td>
              <td class="px-6 py-3 text-sm text-[#626262]">
                Confirmed by service; local payload removed. Linked to quality case <span class="font-mono-num">Q-89</span>.
              </td>
            </tr>

          </tbody>
        </table>
      </div>
    </div>

    <!-- Two Information & Policy Panels -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      
      <!-- Panel 1: Offline Security & Sync Policy -->
      <div class="bg-[#FFFFFF] border border-[#D5D5D5] rounded-[2px] p-6 flex flex-col justify-between">
        <div>
          <h2 class="text-xl font-[650] text-[#202020] mb-3">Offline queue and sync security</h2>
          <p class="text-base leading-relaxed text-[#626262] mb-4">
            Driver actions are recorded in secure isolated storage on this handheld device while working in offline transit or low-connectivity zones.
          </p>
          <div class="space-y-3 text-sm text-[#626262] border-t border-[#D5D5D5] pt-4">
            <div class="flex items-start gap-2">
              <span class="font-semibold text-[#202020] min-w-[140px]">Auto-send:</span>
              <span>Queued actions automatically transmit immediately upon restored network connectivity.</span>
            </div>
            <div class="flex items-start gap-2">
              <span class="font-semibold text-[#202020] min-w-[140px]">Origin driver only:</span>
              <span>Stored records are cryptographically pinned to Tariq Mansour. Only Tariq's authenticated session can release or upload this queue.</span>
            </div>
            <div class="flex items-start gap-2">
              <span class="font-semibold text-[#202020] min-w-[140px]">Payload removal:</span>
              <span>Action payloads remain permanently in local queue until server acknowledgement is verified, preventing data loss.</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Panel 2: End-of-Day / Sign-Out Protection -->
      <div class="bg-[#FFFFFF] border border-[#D5D5D5] rounded-[2px] p-6 flex flex-col justify-between">
        <div>
          <h2 class="text-xl font-[650] text-[#202020] mb-3">Workday completion and sign-out safety</h2>
          <p class="text-base leading-relaxed text-[#626262] mb-4">
            In compliance with cold chain assurance protocols, sensitive consignment manifests and patient clinic details are cleared from memory upon session end.
          </p>
          <div class="bg-[#F7F7F7] border border-[#D5D5D5] rounded-[2px] p-4 text-sm text-[#626262]">
            <div class="font-semibold text-[#202020] mb-1">Safe action status mode</div>
            After driver sign-out or workday conclusion, no cached customer or route delivery details remain visible on this device. Only unalterable safe action status records persist to preserve traceability.
          </div>
        </div>
        <div class="mt-6 pt-4 border-t border-[#D5D5D5] flex items-center justify-between text-xs text-[#626262]">
          <span>Prototype date: <span class="font-mono-num">14 May 2026</span></span>
          <span>Europe/London (<span class="font-mono-num">BST</span>)</span>
        </div>
      </div>

    </div>

  </main>

</body>
</html>
