<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Access refused</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@600;650;700&family=IBM+Plex+Mono:wght@400;500;600&family=Public+Sans:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      background-color: #F7F7F7;
      color: #202020;
      font-family: 'Public Sans', sans-serif;
      font-size: 16px;
      line-height: 1.5;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 24px 16px;
      -webkit-font-smoothing: antialiased;
    }

    /* Keyframes & Motion Tokens */
    @keyframes entranceFadeIn {
      0% {
        opacity: 0;
        transform: translateY(8px);
      }
      100% {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes savedHandoff {
      0% {
        opacity: 0.6;
        transform: translateY(8px);
      }
      100% {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes waitingBreathe {
      0%, 100% {
        opacity: 0.7;
      }
      50% {
        opacity: 1;
      }
    }

    .entrance-sequence {
      animation: entranceFadeIn 260ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    /* Container */
    .flow-container {
      width: 100%;
      max-width: 440px;
      display: flex;
      flex-direction: column;
      align-items: stretch;
    }

    /* Brand Header */
    .brand-mark-group {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 24px;
    }

    .brand-square {
      width: 32px;
      height: 32px;
      background-color: #202020;
      border-radius: 2px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #FFFFFF;
      font-family: 'Hanken Grotesk', sans-serif;
      font-weight: 650;
      font-size: 17px;
      line-height: 1;
      user-select: none;
    }

    .brand-title {
      font-family: 'Hanken Grotesk', sans-serif;
      font-size: 20px;
      font-weight: 650;
      color: #202020;
      letter-spacing: -0.01em;
    }

    /* Card Panel */
    .panel {
      background-color: #FFFFFF;
      border: 1px solid #D5D5D5;
      border-radius: 2px;
      padding: 32px;
      display: flex;
      flex-direction: column;
    }

    .main-heading {
      font-family: 'Hanken Grotesk', sans-serif;
      font-size: 28px;
      font-weight: 650;
      line-height: 1.25;
      color: #202020;
      letter-spacing: -0.015em;
      margin-bottom: 16px;
    }

    .explanation-text {
      font-family: 'Public Sans', sans-serif;
      font-size: 16px;
      line-height: 1.5;
      color: #626262;
      margin-bottom: 32px;
    }

    /* Primary Action */
    .btn-primary {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 100%;
      height: 48px;
      background-color: #A94B1D;
      color: #FFFFFF;
      border: 1px solid #A94B1D;
      border-radius: 2px;
      font-family: 'Public Sans', sans-serif;
      font-size: 16px;
      font-weight: 600;
      text-decoration: none;
      cursor: pointer;
      box-sizing: border-box;
      transition: background-color 150ms ease, border-color 150ms ease, transform 100ms ease;
    }

    .btn-primary:hover {
      background-color: #933f17;
      border-color: #933f17;
    }

    .btn-primary:focus {
      outline: none;
      box-shadow: 0 0 0 2px #FFFFFF, 0 0 0 4px #A94B1D;
    }

    .btn-primary:active {
      background-color: #7e3613;
      border-color: #7e3613;
      transform: translateY(1px);
    }

    @media (prefers-reduced-motion: reduce) {
      .entrance-sequence {
        animation: none;
      }
      .btn-primary {
        transition: none;
      }
    }
  </style>
</head>
<body>
  <div class="flow-container entrance-sequence">
    <!-- Meridian Square M and Name -->
    <div class="brand-mark-group">
      <div class="brand-square" aria-hidden="true">M</div>
      <div class="brand-title">Meridian</div>
    </div>

    <!-- Panel max 440px -->
    <div class="panel">
      <h1 class="main-heading">Access refused</h1>
      <p class="explanation-text">
        Protected records were cleared and unsent work, if any, cannot be synchronized until its originating driver signs in and access is allowed.
      </p>
      <a href="#" class="btn-primary" role="button">Back to sign in</a>
    </div>
  </div>
</body>
</html>