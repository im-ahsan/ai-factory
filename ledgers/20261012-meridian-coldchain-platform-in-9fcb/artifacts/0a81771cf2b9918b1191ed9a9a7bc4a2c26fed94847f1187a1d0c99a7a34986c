    <!-- Release & Disposition Options (Governance Rules) -->
    <section class="panel">
      <div class="panel-header">
        <div>
          <h2>Available receipt release & disposition options</h2>
          <div class="text-quiet text-sm">Mandatory dual-authorization governance workflow based on excursion compliance</div>
        </div>
      </div>

      <!-- Recommendation Card -->
      <div style="border: 1px solid #D5D5D5; border-radius: 2px; padding: 16px; margin-bottom: 24px;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
          <div>
            <h3 style="font-size: 16px;">System recommendation for HU-82 (Quarantined 10 packs)</h3>
            <div class="text-sm text-quiet">Evaluation against Profile v3 criteria: 22m cumulative tier excursion ≤ 30m allowance limit</div>
          </div>
          <span class="status-good">good</span>
        </div>
        <p class="text-sm" style="margin-bottom: 12px;">
          <strong>Recommendation: Release to available stock.</strong> The recorded excursion of 9.1°C for 22 minutes is within the permitted 30-minute first-tier allowance (8 minutes remaining). Stock maintains full safety specifications.
        </p>
        <div style="padding: 12px; background-color: #F7F7F7; border: 1px solid #D5D5D5; border-radius: 2px; font-size: 14px;">
          <strong>Governance protocol:</strong> A matching first-tier recommendation with allowance allows a single-person signature (Omar Saleh). Every other case, including not-permitted range, requires Omar's proposal and a different manager's approval (Nadia Farouk). Written justification is required if opposing the recommendation.
        </div>
      </div>

      <!-- Disposition Form -->
      <form onsubmit="return false;" style="display: flex; flex-direction: column; gap: 20px;">
        <div class="grid-2">
          <div class="form-group">
            <label class="form-label" for="disposition-action">Selected disposition action</label>
            <select id="disposition-action" class="input-field">
              <option value="release_compliant" selected>Release 10 quarantined packs to Available (Matches first-tier allowance)</option>
              <option value="quarantine_hold">Extend Quarantine / Retain on Hold (Requires Manager approval)</option>
              <option value="reject_destruction">Reject packs & assign to destruction (Requires Manager approval)</option>
              <option value="custom_proposal">Opposing proposal / Not-permitted range (Requires Manager approval)</option>
            </select>
          </div>

          <div class="form-group">
            <label class="form-label" for="manager-approval">Required approval workflow</label>
            <input type="text" id="manager-approval" class="input-field" value="Single-person signature eligible (Omar Saleh)" readonly style="background-color: #F7F7F7; color: #202020;" />
          </div>
        </div>

        <div class="form-group">
          <label class="form-label" for="justification-text">Written justification (Required if opposing system advice)</label>
          <textarea id="justification-text" class="input-field" placeholder="Provide clinical or physical packaging rationale if overriding recommendation..."></textarea>
        </div>

        <div class="grid-2">
          <div class="form-group">
            <label class="form-label" for="sign-in-method">Sign-in verification method</label>
            <select id="sign-in-method" class="input-field">
              <option value="ms_sso" selected>Omar Saleh · Meridian Microsoft account authentication</option>
              <option value="one_time_code">One-time code verification</option>
            </select>
          </div>

          <div class="form-group">
            <label class="form-label" for="confirmation-input">Reason and confirmation</label>
            <input type="text" id="confirmation-input" class="input-field" placeholder="Confirm: 'Approve release of HU-82 compliant allowance'" value="Approve release of HU-82 compliant allowance" />
          </div>
        </div>

        <div style="display: flex; justify-content: space-between; align-items: center; padding-top: 12px; border-top: 1px solid #D5D5D5;">
          <div class="text-sm text-quiet">
            Action is cryptographic and immutable: never recalculates old signed decisions upon execution.
          </div>
          <button type="button" class="btn btn-primary">Sign and execute disposition</button>
        </div>
      </form>
    </section>

