<span style="font-size: 14px; color: var(--status-good); font-weight: 500;">good</span>
</div>
<div style="font-size: 14px; color: var(--text-muted);"><span class="font-mono">LOG-9921</span> (<span class="font-mono">14:40 BST</span>)</div>
</td>
<td style="padding: 12px 16px;">
<div style="display: flex; gap: 16px; align-items: center;">
<label style="display: flex; align-items: center; gap: 6px; cursor: pointer; font-size: 15px;">
<input checked="" name="disposition_b701" style="accent-color: var(--primary); width: 18px; height: 18px;" type="radio" value="handover"/>
<span>Handed over</span>
</label>
<label style="display: flex; align-items: center; gap: 6px; cursor: pointer; font-size: 15px;">
<input name="disposition_b701" style="accent-color: var(--status-refused); width: 18px; height: 18px;" type="radio" value="refused"/>
<span>Refused</span>
</label>
</div>
</td>
<td style="padding: 12px 16px;">
<input class="field-input" disabled="" id="reason_b701" placeholder="Required only if refused as whole" style="background-color: #F7F7F7; height: 40px; font-size: 14px;" type="text"/>
</td>
</tr>
<!-- Box B-702 Row -->
<tr style="height: 64px; border-bottom: 1px solid var(--border);">
<td class="font-mono" style="padding: 12px 16px; font-weight: 600;">B-702</td>
<td class="font-mono" style="padding: 12px 16px;">8 packs</td>
<td style="padding: 12px 16px;">
<div style="font-weight: 500;">Insulin Glargine 100 units/mL</div>
<div style="font-size: 14px; color: var(--text-muted);">Lot <span class="font-mono">IG-2511</span> · Exp. <span class="font-mono">31 Mar 2027</span></div>
</td>
