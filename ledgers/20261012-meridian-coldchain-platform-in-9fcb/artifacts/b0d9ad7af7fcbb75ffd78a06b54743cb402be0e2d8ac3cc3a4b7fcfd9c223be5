<!DOCTYPE html>

<html lang="en"><head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<title>Record handover</title>
<link href="https://fonts.googleapis.com" rel="preconnect"/>
<link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect"/>
<link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@600;650;700&amp;family=IBM+Plex+Mono:wght@400;500;600&amp;family=Public+Sans:wght@400;500;600&amp;display=swap" rel="stylesheet"/>
<style>
    /* Design System exact tokens & motion rules */
    :root {
      --bg: #F7F7F7;
      --surface: #FFFFFF;
      --text: #202020;
      --text-muted: #626262;
      --border: #D5D5D5;
      --primary: #A94B1D;
      --status-good: #24704B;
      --status-waiting: #805800;
      --status-refused: #AE2C2C;

      /* Motion tokens */
      --motion-duration-instant: 100ms;
      --motion-duration-fast: 150ms;
      --motion-duration-normal: 200ms;
      --motion-duration-slow: 300ms;
      --motion-ease-standard: cubic-bezier(0.2, 0.0, 0, 1.0);
      --motion-ease-decelerate: cubic-bezier(0.0, 0.0, 0.2, 1.0);
      --motion-ease-accelerate: cubic-bezier(0.3, 0.0, 1.0, 1.0);
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      background-color: var(--bg);
      color: var(--text);
      font-family: 'Public Sans', sans-serif;
      font-size: 16px;
      line-height: 1.5;
      -webkit-font-smoothing: antialiased;
      min-height: 100vh;
    }

    .font-mono {
      font-family: 'IBM Plex Mono', monospace;
    }

    h1, h2, h3, .font-heading {
      font-family: 'Hanken Grotesk', sans-serif;
    }

    /* Motion specifications */
    @keyframes entranceFadeIn {
      from {
        opacity: 0;
        transform: translateY(6px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes savedHandoff {
      0% {
        transform: scale(1);
      }
      50% {
        transform: scale(1.02);
      }
      100% {
        transform: scale(1);
      }
    }

    @keyframes waitingBreathe {
      0%, 100% {
        opacity: 1;
      }
      50% {
        opacity: 0.6;
      }
    }

    /* Entrance stagger sequence */
    .stagger-1 {
      animation: entranceFadeIn var(--motion-duration-slow) var(--motion-ease-decelerate) forwards;
      animation-delay: 0ms;
    }

    .stagger-2 {
      animation: entranceFadeIn var(--motion-duration-slow) var(--motion-ease-decelerate) both;
      animation-delay: 60ms;
    }

    .stagger-3 {
      animation: entranceFadeIn var(--motion-duration-slow) var(--motion-ease-decelerate) both;
      animation-delay: 120ms;
    }

    .stagger-4 {
      animation: entranceFadeIn var(--motion-duration-slow) var(--motion-ease-decelerate) both;
      animation-delay: 180ms;
    }

    .stagger-5 {
      animation: entranceFadeIn var(--motion-duration-slow) var(--motion-ease-decelerate) both;
      animation-delay: 240ms;
    }

    .stagger-6 {
      animation: entranceFadeIn var(--motion-duration-slow) var(--motion-ease-decelerate) both;
      animation-delay: 300ms;
    }

    .stagger-7 {
      animation: entranceFadeIn var(--motion-duration-slow) var(--motion-ease-decelerate) both;
      animation-delay: 360ms;
    }

    .saved-handoff-motion {
      animation: savedHandoff var(--motion-duration-slow) var(--motion-ease-standard) forwards;
    }

    .waiting-indicator {
      animation: waitingBreathe 3s ease-in-out infinite;
    }

    @media (prefers-reduced-motion: reduce) {
      *, ::before, ::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
        scroll-behavior: auto !important;
        animation-delay: 0ms !important;
      }
    }

    /* Interactive state styles on all controls */
    a, button, input, select, textarea, label {
      transition: background-color var(--motion-duration-fast) var(--motion-ease-standard),
                  border-color var(--motion-duration-fast) var(--motion-ease-standard),
                  transform var(--motion-duration-instant) var(--motion-ease-standard),
                  box-shadow var(--motion-duration-fast) var(--motion-ease-standard),
                  outline-color var(--motion-duration-instant) var(--motion-ease-standard);
    }

    a:focus-visible, button:focus-visible, input:focus-visible, select:focus-visible, textarea:focus-visible {
      outline: 2px solid var(--primary);
      outline-offset: 2px;
    }

    /* Buttons */
    .btn-primary {
      height: 48px;
      background-color: var(--primary);
      color: #FFFFFF;
      font-family: 'Public Sans', sans-serif;
      font-size: 16px;
      font-weight: 600;
      border: 1px solid var(--primary);
      border-radius: 2px;
      padding: 0 24px;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }

    .btn-primary:hover {
      background-color: #933F17;
      border-color: #933F17;
    }

    .btn-primary:active {
      transform: scale(0.98);
      background-color: #823612;
    }

    .btn-secondary {
      height: 48px;
      background-color: var(--surface);
      color: var(--text);
      font-family: 'Public Sans', sans-serif;
      font-size: 16px;
      font-weight: 500;
      border: 1px solid var(--border);
      border-radius: 2px;
      padding: 0 20px;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      text-decoration: none;
    }

    .btn-secondary:hover {
      background-color: #F0F0F0;
      border-color: #C0C0C0;
    }

    .btn-secondary:active {
      transform: scale(0.98);
      background-color: #E5E5E5;
    }

    /* Inputs */
    .field-input {
      height: 48px;
      background-color: var(--surface);
      border: 1px solid var(--border);
      border-radius: 2px;
      padding: 0 16px;
      font-family: 'Public Sans', sans-serif;
      font-size: 16px;
      color: var(--text);
      width: 100%;
    }

    .field-input:hover:not(:disabled) {
      border-color: #B5B5B5;
    }

    .field-input:focus:not(:disabled) {
      border-color: var(--primary);
      box-shadow: 0 0 0 1px var(--primary);
    }

    /* Interactive Checkboxes & Radios */
    input[type="checkbox"], input[type="radio"] {
      cursor: pointer;
    }

    input[type="checkbox"]:hover, input[type="radio"]:hover {
      filter: brightness(0.92);
    }

    input[type="checkbox"]:active, input[type="radio"]:active {
      transform: scale(0.92);
    }

    /* Links hover/active */
    nav a {
      transition: color var(--motion-duration-fast) var(--motion-ease-standard),
                  border-color var(--motion-duration-fast) var(--motion-ease-standard);
    }

    nav a:hover {
      color: var(--primary);
    }

    nav a:active {
      transform: scale(0.98);
    }

    .panel {
      background-color: var(--surface);
      border: 1px solid var(--border);
      border-radius: 2px;
    }
  </style>
</head>
<body>
<!-- Global Header (Exact specification) -->
<header style="background-color: var(--surface); border-bottom: 1px solid var(--border); height: 56px;">
<div style="max-width: 1160px; margin: 0 auto; height: 100%; padding: 0 24px; display: flex; align-items: center; justify-content: space-between;">
<!-- Left: Logo + Navigation -->
<div style="display: flex; align-items: center; gap: 32px;">
<div style="display: flex; align-items: center; gap: 8px;">
<div style="width: 24px; height: 24px; background-color: var(--text); border-radius: 2px; display: flex; align-items: center; justify-content: center; color: #FFFFFF; font-weight: 700; font-size: 14px; font-family: 'Hanken Grotesk', sans-serif;">
