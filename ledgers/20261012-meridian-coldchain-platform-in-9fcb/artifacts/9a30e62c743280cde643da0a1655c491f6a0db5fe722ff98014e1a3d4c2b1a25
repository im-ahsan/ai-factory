<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Record handover — Error State</title>
  <!-- Google Fonts: Hanken Grotesk, Public Sans, IBM Plex Mono -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@600;650;700&family=IBM+Plex+Mono:wght@400;500;600&family=Public+Sans:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    /* Design System Tokens */
    :root {
      --bg-page: #F7F7F7;
      --bg-panel: #FFFFFF;
      --text-main: #202020;
      --text-quiet: #626262;
      --border-rule: #D5D5D5;
      --brand-accent: #A94B1D;
      
      --status-good: #24704B;
      --status-waiting: #805800;
      --status-refused: #AE2C2C;
      --status-failed: #AE2C2C;
      
      --font-heading: 'Hanken Grotesk', sans-serif;
      --font-body: 'Public Sans', sans-serif;
      --font-mono: 'IBM Plex Mono', monospace;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      background-color: var(--bg-page);
      color: var(--text-main);
      font-family: var(--font-body);
      font-size: 16px;
      line-height: 1.5;
      -webkit-font-smoothing: antialiased;
    }

    /* Typography */
    h1, h2, h3, .heading-main, .heading-section, .heading-small {
      font-family: var(--font-heading);
      color: var(--text-main);
    }
    .heading-main {
      font-size: 28px;
      font-weight: 650;
      line-height: 1.25;
    }
    .heading-section {
      font-size: 20px;
      font-weight: 650;
      line-height: 1.3;
    }
    .heading-small {
      font-size: 16px;
      font-weight: 600;
      line-height: 1.4;
    }
    .text-quiet {
      color: var(--text-quiet);
    }
    .text-mono {
      font-family: var(--font-mono);
    }
    .text-supporting {
      font-size: 14px;
      color: var(--text-quiet);
    }

    /* Statuses */
    .status-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-family: var(--font-body);
      font-size: 14px;
      font-weight: 500;
    }
    .status-dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      display: inline-block;
    }
    .status-good { color: var(--status-good); }
    .status-good .status-dot { background-color: var(--status-good); }
    .status-waiting { color: var(--status-waiting); }
    .status-waiting .status-dot { background-color: var(--status-waiting); }
    .status-refused, .status-failed { color: var(--status-failed); }
    .status-refused .status-dot, .status-failed .status-dot { background-color: var(--status-failed); }

    /* Header */
    header {
      background-color: var(--bg-panel);
      border-bottom: 1px solid var(--border-rule);
      height: 64px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 32px;
      position: sticky;
      top: 0;
      z-index: 50;
    }
    .header-left {
      display: flex;
      align-items: center;
      gap: 32px;
    }
    .brand-logo {
      display: flex;
      align-items: center;
      gap: 10px;
      font-family: var(--font-heading);
      font-size: 18px;
      font-weight: 700;
      color: var(--text-main);
      text-decoration: none;
    }
    .logo-mark {
      width: 24px;
      height: 24px;
      background-color: var(--text-main);
      color: #FFFFFF;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 13px;
      font-weight: 700;
      border-radius: 2px;
      font-family: var(--font-heading);
    }
    .nav-menu {
      display: flex;
      align-items: center;
      gap: 24px;
      height: 64px;
    }
    .nav-item {
      color: var(--text-quiet);
      text-decoration: none;
      font-size: 15px;
      font-weight: 500;
      display: flex;
      align-items: center;
      height: 100%;
      border-bottom: 2px solid transparent;
      padding: 0 4px;
      transition: color 150ms ease, border-color 150ms ease;
    }
    .nav-item:hover {
      color: var(--text-main);
    }
    .nav-item.active {
      color: var(--brand-accent);
      border-bottom-color: var(--brand-accent);
      font-weight: 600;
    }
    .header-right {
      display: flex;
      align-items: center;
      gap: 20px;
      font-size: 14px;
    }
    .driver-profile {
      display: flex;
      align-items: center;
      gap: 8px;
      color: var(--text-main);
    }
    .avatar-initials {
      width: 28px;
      height: 28px;
      background-color: #E8E8E8;
      color: var(--text-main);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 12px;
      font-weight: 600;
      border-radius: 2px;
      border: 1px solid var(--border-rule);
    }
    .lang-divider {
      color: var(--border-rule);
    }
    .lang-switch {
      color: var(--text-quiet);
    }

    /* Layout Container */
    main {
      max-width: 1200px;
      margin: 0 auto;
      padding: 32px 32px 64px;
    }

    .page-title-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 24px;
    }

    /* Panels & Rules */
    .panel {
      background-color: var(--bg-panel);
      border: 1px solid var(--border-rule);
      border-radius: 2px;
      padding: 24px;
      margin-bottom: 32px;
    }
    .panel-flush-table {
      padding: 0;
      overflow: hidden;
    }

    /* Error Banner */
    .error-banner {
      background-color: #FFFFFF;
      border: 1px solid var(--status-failed);
      border-left: 4px solid var(--status-failed);
      border-radius: 2px;
      padding: 16px 20px;
      margin-bottom: 32px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
    }
    .error-content {
      display: flex;
      align-items: flex-start;
      gap: 12px;
    }
    .error-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background-color: var(--status-failed);
      margin-top: 7px;
      flex-shrink: 0;
    }
    .error-title {
      font-family: var(--font-heading);
      font-weight: 650;
      font-size: 16px;
      color: var(--text-main);
      margin-bottom: 2px;
    }
    .error-desc {
      font-size: 14px;
      color: var(--text-quiet);
    }

    /* Buttons */
    .btn {
      height: 48px;
      padding: 0 24px;
      font-family: var(--font-body);
      font-size: 15px;
      font-weight: 500;
      border-radius: 2px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      text-decoration: none;
      transition: background-color 140ms ease, border-color 140ms ease, opacity 140ms ease;
    }
    .btn:focus-visible {
      outline: 2px solid var(--brand-accent);
      outline-offset: 2px;
    }
    .btn-primary {
      background-color: var(--brand-accent);
      color: #FFFFFF;
      border: 1px solid var(--brand-accent);
    }
    .btn-primary:hover {
      background-color: #933F17;
      border-color: #933F17;
    }
    .btn-primary:active {
      background-color: #7D3412;
      border-color: #7D3412;
    }
    .btn-primary[disabled] {
      background-color: #E0E0E0;
      border-color: #E0E0E0;
      color: #8E8E8E;
      cursor: not-allowed;
    }
    .btn-secondary {
      background-color: #FFFFFF;
      color: var(--text-main);
      border: 1px solid var(--border-rule);
    }
    .btn-secondary:hover {
      background-color: #F7F7F7;
      border-color: #B5B5B5;
    }
    .btn-secondary:active {
      background-color: #EEEEEE;
    }

    /* Key-Value Summary Grid */
    .summary-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 20px;
    }
    .summary-item {
      display: flex;
      flex-col;
      flex-direction: column;
      gap: 4px;
    }
    .summary-label {
      font-size: 14px;
      color: var(--text-quiet);
    }
    .summary-val {
      font-size: 16px;
      font-weight: 600;
      color: var(--text-main);
    }
    .panel-rule {
      border: 0;
      border-top: 1px solid var(--border-rule);
      margin: 20px 0;
    }

    /* Tables */
    .data-table {
      width: 100%;
      border-collapse: collapse;
      text-align: left;
    }
    .data-table th {
      height: 48px;
      padding: 0 20px;
      font-size: 13px;
      font-weight: 500;
      color: var(--text-quiet);
      border-bottom: 1px solid var(--border-rule);
      background-color: #FAFAFA;
    }
    .data-table td {
      height: 56px;
      padding: 0 20px;
      font-size: 15px;
      color: var(--text-main);
      border-bottom: 1px solid var(--border-rule);
      vertical-align: middle;
    }
    .data-table tr:last-child td {
      border-bottom: 0;
    }

    /* Form Fields */
    .field-group {
      margin-bottom: 20px;
    }
    .field-label {
      display: block;
      font-size: 14px;
      font-weight: 500;
      color: var(--text-quiet);
      margin-bottom: 8px;
    }
    .field-input, .field-select {
      width: 100%;
      height: 48px;
      background-color: #FFFFFF;
      border: 1px solid var(--border-rule);
      border-radius: 2px;
      padding: 0 14px;
      font-family: var(--font-body);
      font-size: 15px;
      color: var(--text-main);
      outline: none;
      transition: border-color 140ms ease;
    }
    .field-input:focus, .field-select:focus {
      border-color: var(--brand-accent);
      outline: 1px solid var(--brand-accent);
    }
    .field-input[disabled], .field-select[disabled] {
      background-color: #FAFAFA;
      color: #8E8E8E;
      cursor: not-allowed;
    }

    /* Split Section Layout */
    .two-col-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 24px;
    }

    /* Photographic & Signature Cards */
    .asset-box {
      border: 1px solid var(--border-rule);
      border-radius: 2px;
      background-color: #FFFFFF;
      padding: 16px;
      display: flex;
      flex-direction: column;
      gap: 12px;
    }
    .photo-preview {
      width: 100%;
      aspect-ratio: 4/3;
      object-fit: cover;
      border-radius: 2px;
      border: 1px solid var(--border-rule);
      background-color: #EFEFEF;
    }
    .signature-pad-container {
      width: 100%;
      height: 180px;
      border: 1px solid var(--border-rule);
      border-radius: 2px;
      background-color: #FFFFFF;
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
    }
    .signature-svg {
      width: 100%;
      height: 100%;
      object-fit: contain;
    }

    /* Checkbox & radio */
    .checkbox-row {
      display: flex;
      align-items: flex-start;
      gap: 12px;
      padding: 16px;
      border: 1px solid var(--border-rule);
      border-radius: 2px;
      background-color: #FFFFFF;
    }
    .checkbox-custom {
      width: 20px;
      height: 20px;
      margin-top: 2px;
      accent-color: var(--brand-accent);
      cursor: pointer;
    }

    /* Radio buttons in table */
    .action-choice {
      display: inline-flex;
      align-items: center;
      gap: 16px;
    }
    .radio-label {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: 14px;
      cursor: pointer;
    }
    .radio-label input {
      accent-color: var(--brand-accent);
    }

    /* Sync & Offline Assurance Banner */
    .assurance-note {
      padding: 16px 20px;
      background-color: #FAFAFA;
      border: 1px solid var(--border-rule);
      border-radius: 2px;
      font-size: 14px;
      color: var(--text-quiet);
      margin-bottom: 24px;
      line-height: 1.5;
    }

    /* Footer Action Bar */
    .form-actions {
      display: flex;
      align-items: center;
      justify-content: flex-end;
      gap: 16px;
      padding-top: 16px;
    }

    /* Motion specifications */
    @keyframes fadeInEntrance {
      from { opacity: 0; transform: translateY(4px); }
      to { opacity: 1; transform: translateY(0); }
    }
    @keyframes savedHandoff {
      0% { opacity: 0.6; transform: translateY(8px); }
      100% { opacity: 1; transform: translateY(0); }
    }
    @keyframes waitingDotBreathe {
      0%, 100% { opacity: 0.7; }
      50% { opacity: 1; }
    }

    .animate-entrance {
      animation: fadeInEntrance 200ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
    .anim-saved-handoff {
      animation: savedHandoff 260ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
    .waiting-dot-breathe {
      animation: waitingDotBreathe 6s ease-in-out infinite;
    }

    @media (prefers-reduced-motion: reduce) {
      *, ::before, ::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
      }
    }
  </style>
</head>
<body class="animate-entrance">

  <!-- Header -->
  <header>
    <div class="header-left">
      <a href="#" class="brand-logo">
        <span class="logo-mark">M</span>
        <span>Meridian</span>
      </a>
      <nav class="nav-menu">
        <a href="#" class="nav-item">Today's routes</a>
        <a href="#" class="nav-item">Pending work</a>
      </nav>
    </div>
    <div class="header-right">
      <div class="driver-profile">
        <span class="avatar-initials">TM</span>
        <span>Tariq Mansour · Driver</span>
      </div>
      <span class="lang-divider">|</span>
      <span class="lang-switch">EN / العربية</span>
    </div>
  </header>

  <main>
    <!-- Title Row -->
    <div class="page-title-row">
      <h1 class="heading-main">Record handover</h1>
      <a href="#" class="btn btn-secondary">Stop detail</a>
    </div>

    <!-- Error State Banner -->
    <div class="error-banner">
      <div class="error-content">
        <span class="error-dot"></span>
        <div>
          <div class="error-title">Failed to load stop data and live telemetry</div>
          <div class="error-desc">Data failed to load. The dispatch synchronization service could not resolve current telemetry and stop status for Cedar Clinic.</div>
        </div>
      </div>
      <button type="button" class="btn btn-secondary">Retry</button>
    </div>

    <!-- Cedar Clinic Destination & Route Overview Panel -->
    <section class="panel">
      <div class="summary-grid">
        <div class="summary-item">
          <span class="summary-label">Delivery destination</span>
          <span class="summary-val">Cedar Clinic <span class="status-badge status-failed" style="margin-left: 6px;"><span class="status-dot"></span>failed</span></span>
          <span class="text-supporting">42 River Road, London</span>
        </div>
        <div class="summary-item">
          <span class="summary-label">Planned arrival</span>
          <span class="summary-val text-mono">15:00 BST</span>
          <span class="text-supporting text-mono">14 May 2026</span>
        </div>
        <div class="summary-item">
          <span class="summary-label">Route assignment</span>
          <span class="summary-val text-mono">R-204</span>
          <span class="text-supporting">Assigned to Tariq Mansour</span>
        </div>
        <div class="summary-item">
          <span class="summary-label">Vehicle</span>
          <span class="summary-val text-mono">VAN-27</span>
          <span class="text-supporting text-mono">(plate MTR-482)</span>
        </div>
      </div>

      <hr class="panel-rule">

      <div class="summary-grid">
        <div class="summary-item">
          <span class="summary-label">Consignment order</span>
          <span class="summary-val text-mono">Order 0-299</span>
          <span class="text-supporting">Insulin Glargine 100 units/mL</span>
        </div>
        <div class="summary-item">
          <span class="summary-label">Total allocated packs</span>
          <span class="summary-val text-mono">20 packs</span>
          <span class="text-supporting text-mono">(12 in B-701, 8 in B-702)</span>
        </div>
        <div class="summary-item">
          <span class="summary-label">Outstanding quantity</span>
          <span class="summary-val text-mono">0 packs outstanding</span>
          <span class="text-supporting">Full order allocated</span>
        </div>
        <div class="summary-item">
          <span class="summary-label">Telemetry connection</span>
          <span class="status-badge status-failed"><span class="status-dot"></span>failed</span>
          <span class="text-supporting">Cached telemetry while disconnected</span>
        </div>
      </div>
    </section>

    <!-- Whole-Box Consignment Rows & Decision Panel -->
    <section class="panel panel-flush-table" style="margin-bottom: 32px;">
      <div style="padding: 20px 24px; border-bottom: 1px solid var(--border-rule); display: flex; align-items: center; justify-content: space-between;">
        <div>
          <h2 class="heading-section">Whole-box handover disposition</h2>
          <p class="text-supporting" style="margin-top: 2px;">Each box is handed over or refused as a whole. Pack-level partial refusal is prohibited.</p>
        </div>
        <div class="status-badge status-failed">
          <span class="status-dot"></span>
          <span>Cached telemetry while disconnected</span>
        </div>
      </div>

      <table class="data-table">
        <thead>
          <tr>
            <th style="width: 140px;">Box identifier</th>
            <th style="width: 110px;">Quantity</th>
            <th style="width: 200px;">Datalogger gateway</th>
            <th style="width: 160px;">Latest reading</th>
            <th style="width: 160px;">Telemetry status</th>
            <th style="width: 200px;">Handover choice</th>
            <th>Refusal reason (required if refused)</th>
          </tr>
        </thead>
        <tbody>
          <!-- Row 1: B-701 -->
          <tr>
            <td class="text-mono" style="font-weight: 600;">B-701</td>
            <td class="text-mono">12 packs</td>
            <td class="text-mono text-supporting">LOG-9921 / GTW-VAN27</td>
            <td>
              <span class="text-mono">4.4°C</span>
              <span class="text-supporting" style="margin-left: 4px; color: var(--status-failed);">(stale)</span>
            </td>
            <td>
              <span class="status-badge status-failed"><span class="status-dot"></span>failed</span>
            </td>
            <td>
              <div class="action-choice">
                <label class="radio-label">
                  <input type="radio" name="disposition_B701" value="handover" checked>
                  <span>Hand over</span>
                </label>
                <label class="radio-label">
                  <input type="radio" name="disposition_B701" value="refuse">
                  <span>Refuse</span>
                </label>
              </div>
            </td>
            <td>
              <input type="text" class="field-input" placeholder="Required reason per refused box..." style="height: 38px; font-size: 14px;" disabled>
            </td>
          </tr>

          <!-- Row 2: B-702 -->
          <tr>
            <td class="text-mono" style="font-weight: 600;">B-702</td>
            <td class="text-mono">8 packs</td>
            <td class="text-mono text-supporting">LOG-8819 / GTW-VAN27</td>
            <td>
              <span class="text-mono">4.8°C</span>
              <span class="text-supporting" style="margin-left: 4px; color: var(--status-failed);">(stale · disconnected)</span>
            </td>
            <td>
              <span class="status-badge status-failed"><span class="status-dot"></span>failed</span>
            </td>
            <td>
              <div class="action-choice">
                <label class="radio-label">
                  <input type="radio" name="disposition_B702" value="handover">
                  <span>Hand over</span>
                </label>
                <label class="radio-label">
                  <input type="radio" name="disposition_B702" value="refuse" checked>
                  <span>Refuse</span>
                </label>
              </div>
            </td>
            <td>
              <input type="text" class="field-input" value="Telemetry disconnected >3h; unverified dock excursion hold" style="height: 38px; font-size: 14px; border-color: var(--status-failed);">
            </td>
          </tr>
        </tbody>
      </table>

      <div style="padding: 16px 24px; background-color: #FAFAFA; border-top: 1px solid var(--border-rule); font-size: 14px; color: var(--text-quiet);">
        Notice: An API-returned hold or online recall on a scanned box replaces its eligibility with "Do not deliver" and hold reason when returned. Handover record is restricted until telemetry sync is restored.
      </div>
    </section>

    <!-- Evidence & Receiver Verification Grid -->
    <div class="two-col-grid" style="margin-bottom: 32px;">
      
      <!-- Left Column: Receiver Identity, Timing, Location & Acknowledgment -->
      <div class="panel" style="margin-bottom: 0;">
        <h2 class="heading-section" style="margin-bottom: 20px;">Receiver verification</h2>
        
        <div class="field-group">
          <label class="field-label" for="receiver-name">Receiver name</label>
          <input type="text" id="receiver-name" class="field-input" value="Rania Karim">
        </div>

        <div class="summary-grid" style="grid-template-columns: 1fr 1fr; margin-bottom: 20px; gap: 16px;">
          <div class="field-group" style="margin-bottom: 0;">
            <label class="field-label">Recorded occurrence time</label>
            <input type="text" class="field-input text-mono" value="14 May 2026 15:02 BST" readonly>
            <span class="text-supporting" style="margin-top: 4px; display: block;">Kept across offline retries</span>
          </div>
          <div class="field-group" style="margin-bottom: 0;">
            <label class="field-label">Browser location prompt</label>
            <input type="text" class="field-input" value="Location unavailable" readonly style="color: var(--text-quiet);">
            <span class="text-supporting" style="margin-top: 4px; display: block;">Permission prompt denied / unavailable</span>
          </div>
        </div>

        <div class="checkbox-row" style="margin-bottom: 20px;">
          <input type="checkbox" id="acknowledgment" class="checkbox-custom" checked>
          <label for="acknowledgment" style="font-size: 14px; color: var(--text-main); line-height: 1.4; cursor: pointer;">
            <strong>Explicit electronic acknowledgment:</strong> I, Rania Karim, confirm receipt of whole-box consignment under verified cold-chain conditions for Cedar Clinic, noting whole-box acceptance and recorded holds.
          </label>
        </div>

        <div>
          <label class="field-label">Actual signature drawn by receiver</label>
          <div class="signature-pad-container">
