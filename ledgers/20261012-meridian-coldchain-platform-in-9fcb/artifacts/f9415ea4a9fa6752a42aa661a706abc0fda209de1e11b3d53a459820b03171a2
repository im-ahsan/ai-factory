<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Moves</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@600;650;700&family=IBM+Plex+Mono:wght@400;500;600&family=Public+Sans:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    /* Exact style rules per design system & user prompt */
    :root {
      --bg-page: #F7F7F7;
      --bg-surface: #FFFFFF;
      --color-text: #202020;
      --color-text-quiet: #626262;
      --color-border: #D5D5D5;
      --color-brand: #A94B1D;
      --status-good: #24704B;
      --status-waiting: #805800;
      --status-refused: #AE2C2C;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      background-color: var(--bg-page);
      color: var(--color-text);
      font-family: 'Public Sans', sans-serif;
      font-size: 16px;
      line-height: 1.5;
      -webkit-font-smoothing: antialiased;
    }

    /* Typography */
    h1, .font-heading {
      font-family: 'Hanken Grotesk', sans-serif;
      font-weight: 650;
    }

    .page-title {
      font-size: 28px;
      line-height: 1.2;
      font-weight: 650;
      color: var(--color-text);
    }

    .mono {
      font-family: 'IBM Plex Mono', monospace;
    }

    /* Motion specifications */
    @keyframes entranceFadeUp {
      from {
        opacity: 0;
        transform: translateY(6px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes waitingBreathe {
      0%, 100% {
        opacity: 0.7;
      }
      50% {
        opacity: 1;
      }
    }

    .animate-entrance {
      animation: entranceFadeUp 260ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    @media (prefers-reduced-motion: reduce) {
      *, ::before, ::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
      }
    }

    /* Header */
    header {
      background: var(--bg-surface);
      border-bottom: 1px solid var(--color-border);
      height: 56px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 24px;
    }

    .header-left {
      display: flex;
      align-items: center;
      gap: 32px;
    }

    .brand-group {
      display: flex;
      align-items: center;
      gap: 8px;
      text-decoration: none;
      color: var(--color-text);
    }

    .logo-square {
      width: 24px;
      height: 24px;
      background: #000000;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #FFFFFF;
      font-family: 'Hanken Grotesk', sans-serif;
      font-weight: 700;
      font-size: 14px;
      border-radius: 2px;
    }

    .brand-name {
      font-family: 'Hanken Grotesk', sans-serif;
      font-weight: 700;
      font-size: 16px;
      letter-spacing: -0.01em;
      color: var(--color-text);
    }

    nav.header-nav {
      display: flex;
      align-items: center;
      height: 56px;
    }

    .nav-item {
      display: flex;
      align-items: center;
      height: 56px;
      padding: 0 16px;
      text-decoration: none;
      color: var(--color-text);
      font-size: 15px;
      font-weight: 500;
      border-bottom: 2px solid transparent;
      transition: color 150ms ease, border-color 150ms ease;
    }

    .nav-item:hover {
      color: var(--color-brand);
    }

    .nav-item:focus-visible {
      outline: 2px solid var(--color-brand);
      outline-offset: -2px;
    }

    .nav-item.active {
      color: var(--color-brand);
      border-bottom: 2px solid var(--color-brand);
    }

    .header-right {
      display: flex;
      align-items: center;
      gap: 24px;
    }

    .user-profile {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .initials-badge {
      width: 28px;
      height: 28px;
      background: #EFEFEF;
      border: 1px solid var(--color-border);
      border-radius: 2px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: 'Public Sans', sans-serif;
      font-size: 12px;
      font-weight: 600;
      color: var(--color-text);
    }

    .user-meta {
      font-size: 14px;
      color: var(--color-text);
    }

    .lang-switcher {
      font-size: 14px;
      color: var(--color-text-quiet);
      border-left: 1px solid var(--color-border);
      padding-left: 16px;
    }

    /* Main Container */
    main {
      max-width: 1240px;
      margin: 0 auto;
      padding: 32px 24px 64px 24px;
    }

    .page-header-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 24px;
    }

    /* Filters Bar */
    .filter-panel {
      background: var(--bg-surface);
      border: 1px solid var(--color-border);
      border-radius: 2px;
      padding: 16px;
      display: flex;
      flex-wrap: wrap;
      align-items: flex-end;
      gap: 16px;
      margin-bottom: 24px;
    }

    .field-group {
      display: flex;
      flex-direction: column;
      gap: 6px;
      flex: 1;
      min-width: 200px;
    }

    .field-label {
      font-size: 14px;
      color: var(--color-text-quiet);
      font-weight: 500;
    }

    .field-input, .field-select {
      height: 48px;
      background: var(--bg-surface);
      border: 1px solid var(--color-border);
      border-radius: 2px;
      padding: 0 14px;
      font-family: 'Public Sans', sans-serif;
      font-size: 15px;
      color: var(--color-text);
      outline: none;
      transition: border-color 150ms ease, box-shadow 150ms ease;
    }

    .field-input.mono, .field-select.mono {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 14px;
    }

    .field-input:focus, .field-select:focus {
      border-color: var(--color-brand);
      box-shadow: 0 0 0 1px var(--color-brand);
    }

    /* Button */
    .btn-secondary {
      height: 48px;
      background: var(--bg-surface);
      border: 1px solid var(--color-border);
      border-radius: 2px;
      padding: 0 20px;
      font-family: 'Public Sans', sans-serif;
      font-size: 15px;
      font-weight: 500;
      color: var(--color-text);
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      white-space: nowrap;
      transition: background-color 150ms ease, border-color 150ms ease, transform 90ms ease;
    }

    .btn-secondary:hover {
      background-color: #FBFBFB;
      border-color: #BEBEBE;
    }

    .btn-secondary:focus-visible {
      outline: 2px solid var(--color-brand);
      outline-offset: 1px;
    }

    .btn-secondary:active {
      transform: scale(0.98);
    }

    .text-link {
      color: var(--color-text);
      text-decoration: underline;
      text-underline-offset: 3px;
      font-weight: 500;
    }

    .text-link:hover {
      color: var(--color-brand);
    }

    .text-link:focus-visible {
      outline: 2px solid var(--color-brand);
      outline-offset: 2px;
    }

    /* Table Panel */
    .ledger-panel {
      background: var(--bg-surface);
      border: 1px solid var(--color-border);
      border-radius: 2px;
      overflow: hidden;
    }

    .table-container {
      width: 100%;
      overflow-x: auto;
    }

    table.ledger-table {
      width: 100%;
      border-collapse: collapse;
      text-align: left;
    }

    table.ledger-table th {
      background: var(--bg-surface);
      color: var(--color-text-quiet);
      font-family: 'Public Sans', sans-serif;
      font-size: 14px;
      font-weight: 500;
      padding: 0 16px;
      height: 48px;
      border-bottom: 1px solid var(--color-border);
      white-space: nowrap;
    }

    table.ledger-table td {
      padding: 0 16px;
      height: 48px;
      border-bottom: 1px solid var(--color-border);
      font-size: 15px;
      color: var(--color-text);
      white-space: nowrap;
      vertical-align: middle;
    }

    table.ledger-table tr:last-child td {
      border-bottom: none;
    }

    table.ledger-table tr:hover td {
      background-color: #FAFAFA;
    }

    /* Status indicator */
    .status-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: 14px;
      font-weight: 500;
    }

    .status-dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      display: inline-block;
    }

    .status-good {
      color: var(--status-good);
    }
    .status-good .status-dot {
      background-color: var(--status-good);
    }

    .status-waiting {
      color: var(--status-waiting);
    }
    .status-waiting .status-dot {
      background-color: var(--status-waiting);
    }

    .status-refused {
      color: var(--status-refused);
    }
    .status-refused .status-dot {
      background-color: var(--status-refused);
    }

    /* Mobile stacked view (hidden on desktop) */
    .mobile-ledger-cards {
      display: none;
    }

    /* Responsive */
    @media (max-width: 820px) {
      header {
        padding: 0 16px;
        height: auto;
        flex-wrap: wrap;
        gap: 12px;
        padding-top: 12px;
        padding-bottom: 12px;
      }

      .header-left {
        width: 100%;
        justify-content: space-between;
      }

      nav.header-nav {
        overflow-x: auto;
        width: 100%;
        height: 44px;
      }

      .nav-item {
        height: 44px;
        padding: 0 12px;
        font-size: 14px;
      }

      .header-right {
        width: 100%;
        justify-content: space-between;
        padding-top: 8px;
        border-top: 1px solid var(--color-border);
      }

      .table-container {
        display: none;
      }

      .mobile-ledger-cards {
        display: block;
      }

      .mobile-ledger-row {
        padding: 16px;
        border-bottom: 1px solid var(--color-border);
      }

      .mobile-ledger-row:last-child {
        border-bottom: none;
      }

      .mobile-meta-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
        margin-top: 10px;
        font-size: 14px;
      }

      .mobile-meta-item {
        display: flex;
        flex-direction: column;
        gap: 2px;
      }

      .mobile-meta-label {
        font-size: 12px;
        color: var(--color-text-quiet);
      }
    }
  </style>
</head>
<body>

  <!-- Header -->
  <header>
    <div class="header-left">
      <a href="#" class="brand-group">
        <div class="logo-square">M</div>
        <span class="brand-name">Meridian</span>
      </a>
      <nav class="header-nav">
        <a href="#" class="nav-item">Receipts</a>
        <a href="#" class="nav-item">Stock</a>
        <a href="#" class="nav-item active">Moves</a>
        <a href="#" class="nav-item">Boxes</a>
        <a href="#" class="nav-item">Cold rooms</a>
      </nav>
    </div>
    <div class="header-right">
      <div class="user-profile">
        <div class="initials-badge">LH</div>
        <div class="user-meta">Leila Haddad · Warehouse Operator</div>
      </div>
      <div class="lang-switcher">EN / العربية</div>
    </div>
  </header>

  <!-- Main Content -->
  <main class="animate-entrance">
    <div class="page-header-row">
      <h1 class="page-title">Moves</h1>
    </div>

    <!-- Date Filter & Search & CSV Export Bar -->
    <div class="filter-panel">
      <div class="field-group" style="max-width: 220px;">
        <label class="field-label" for="date-filter">Date</label>
        <input type="text" id="date-filter" class="field-input mono" value="14 May 2026" readonly>
      </div>
      <div class="field-group" style="max-width: 200px;">
        <label class="field-label" for="unit-filter">Unit</label>
        <input type="text" id="unit-filter" class="field-input mono" value="HU-81" readonly>
      </div>
      <div class="field-group">
        <label class="field-label" for="location-filter">Location</label>
        <input type="text" id="location-filter" class="field-input" value="North Quay Warehouse" readonly>
      </div>
      <button type="button" class="btn-secondary">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
          <polyline points="7 10 12 15 17 10"></polyline>
          <line x1="12" y1="15" x2="12" y2="3"></line>
        </svg>
        CSV export
      </button>
    </div>

    <!-- Movement Ledger Panel -->
    <div class="ledger-panel">
      <!-- Desktop Table -->
      <div class="table-container">
        <table class="ledger-table">
          <thead>
            <tr>
              <th>Returned time</th>
              <th>Actor</th>
              <th>Unit</th>
              <th>Quantity</th>
              <th>Source</th>
              <th>Destination</th>
              <th>Status</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td class="mono">14 May 2026 08:19</td>
              <td>Omar Saleh</td>
              <td><a href="#" class="text-link mono">HU-81</a></td>
              <td class="mono">100 packs</td>
              <td>Inbound Quarantine</td>
              <td>Cold Room C2, Rack 4</td>
              <td>
                <span class="status-badge status-good">
                  <span class="status-dot"></span>
                  good
                </span>
              </td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- Mobile Stacked Rows -->
      <div class="mobile-ledger-cards">
        <div class="mobile-ledger-row">
          <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 8px;">
            <div>
              <span class="mono" style="font-weight: 600; font-size: 16px;"><a href="#" class="text-link">HU-81</a></span>
              <span class="mono" style="color: var(--color-text-quiet); font-size: 14px; margin-left: 8px;">100 packs</span>
            </div>
            <span class="status-badge status-good">
              <span class="status-dot"></span>
              good
            </span>
          </div>

          <div class="mobile-meta-grid">
            <div class="mobile-meta-item">
              <span class="mobile-meta-label">Returned time</span>
              <span class="mono" style="font-size: 13px;">14 May 2026 08:19</span>
            </div>
            <div class="mobile-meta-item">
              <span class="mobile-meta-label">Actor</span>
              <span>Omar Saleh</span>
            </div>
            <div class="mobile-meta-item">
              <span class="mobile-meta-label">Source</span>
              <span>Inbound Quarantine</span>
            </div>
            <div class="mobile-meta-item">
              <span class="mobile-meta-label">Destination</span>
              <span>Cold Room C2, Rack 4</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>

</body>
</html>
