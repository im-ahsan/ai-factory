<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Products</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@600;650&family=IBM+Plex+Mono:wght@400;500;600&family=Public+Sans:wght@400;500;600&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    :root {
      --bg-page: #F7F7F7;
      --bg-surface: #FFFFFF;
      --text-main: #202020;
      --text-muted: #626262;
      --border-color: #D5D5D5;
      --primary-color: #A94B1D;
      --status-good: #24704B;
      --status-waiting: #805800;
      --status-refused: #AE2C2C;
    }

    body {
      background-color: var(--bg-page);
      color: var(--text-main);
      font-family: 'Public Sans', sans-serif;
      font-size: 16px;
      line-height: 1.5;
      margin: 0;
      padding: 0;
      -webkit-font-smoothing: antialiased;
    }

    h1, h2, h3, .font-heading {
      font-family: 'Hanken+Grotesk', 'Hanken Grotesk', sans-serif;
    }

    .font-mono-num {
      font-family: 'IBM Plex Mono', monospace;
    }

    /* Motion & Transitions */
    @keyframes entranceFadeUp {
      from {
        opacity: 0;
        transform: translateY(6px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes waitingBreathe {
      0%, 100% {
        opacity: 0.7;
      }
      50% {
        opacity: 1;
      }
    }

    .animate-entrance {
      animation: entranceFadeUp 260ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    .status-dot-waiting {
      animation: waitingBreathe 6s ease-in-out infinite;
    }

    @media (prefers-reduced-motion: reduce) {
      .animate-entrance,
      .status-dot-waiting,
      * {
        animation: none !important;
        transition: none !important;
      }
    }

    /* Standard Interactive States */
    button, a, input, select {
      transition: background-color 150ms ease, border-color 150ms ease, color 150ms ease, transform 90ms ease, box-shadow 150ms ease;
    }

    button:focus-visible, a:focus-visible, input:focus-visible, select:focus-visible {
      outline: 2px solid var(--primary-color);
      outline-offset: 2px;
    }

    button:active, a:active {
      transform: scale(0.99);
    }
  </style>
</head>
<body class="min-h-screen pb-16">

  <!-- Application Header -->
  <header class="bg-[#FFFFFF] border-b border-[#D5D5D5] w-full">
    <div class="max-w-[1360px] mx-auto px-6 h-16 flex items-center justify-between">
      <!-- Left: Logo & Nav -->
      <div class="flex items-center space-x-8">
        <div class="flex items-center space-x-3">
          <div class="w-7 h-7 bg-[#202020] rounded-[2px] flex items-center justify-center font-bold text-white text-sm">
            M
          </div>
          <span class="font-heading font-[650] text-lg text-[#202020] tracking-tight">Meridian</span>
        </div>

        <nav class="flex items-center space-x-6 text-[15px]">
          <span class="text-[#A94B1D] font-medium border-b-2 border-[#A94B1D] py-5">Products</span>
          <a href="#" class="text-[#626262] hover:text-[#202020] py-5">Organisations</a>
          <a href="#" class="text-[#626262] hover:text-[#202020] py-5">Accounts</a>
          <a href="#" class="text-[#626262] hover:text-[#202020] py-5">Audit trail</a>
          <a href="#" class="text-[#626262] hover:text-[#202020] py-5">Reports</a>
        </nav>
      </div>

      <!-- Right: User & Language -->
      <div class="flex items-center space-x-6 text-sm">
        <div class="flex items-center space-x-3">
          <div class="w-8 h-8 rounded-[2px] bg-[#EAEAEA] text-[#202020] font-mono-num font-medium text-xs flex items-center justify-center border border-[#D5D5D5]">
            MV
          </div>
          <span class="text-[#202020] font-normal">Marcus Vale · System Administrator</span>
        </div>
        <div class="h-4 w-[1px] bg-[#D5D5D5]"></div>
        <div class="text-[#626262] space-x-1">
          <span class="text-[#202020] font-medium">EN</span>
          <span>/</span>
          <span class="hover:text-[#202020] cursor-pointer">العربية</span>
        </div>
      </div>
    </div>
  </header>

  <!-- Main Content Container -->
  <main class="max-w-[1360px] mx-auto px-6 pt-8 animate-entrance">
    
    <!-- Title Section -->
    <div class="mb-8">
      <h1 class="text-[28px] font-[650] text-[#202020] tracking-tight leading-tight">Products</h1>
    </div>

    <!-- Filter & Toolbar Panel -->
    <div class="bg-[#FFFFFF] border border-[#D5D5D5] rounded-[2px] p-4 mb-6">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <!-- Search & Instant Filters -->
        <div class="flex flex-1 items-center gap-4">
          <div class="relative flex-1 max-w-md">
            <input 
              type="text" 
              placeholder="Search product name, formulation or code..." 
              value="Insulin Glargine"
              class="w-full h-12 bg-[#FFFFFF] border border-[#D5D5D5] rounded-[2px] px-3 text-[#202020] placeholder-[#626262] focus:border-[#A94B1D]"
            >
          </div>

          <div class="flex items-center space-x-2 text-sm text-[#626262]">
            <span class="font-medium text-[#202020]">Status filter:</span>
            <select class="h-12 bg-[#FFFFFF] border border-[#D5D5D5] rounded-[2px] px-3 text-[#202020] focus:border-[#A94B1D]">
              <option selected>All records (active &amp; inactive)</option>
              <option>Active only</option>
              <option>Inactive only</option>
            </select>
          </div>
        </div>

        <!-- CSV Export -->
        <div>
          <button type="button" class="h-12 px-5 bg-[#FFFFFF] border border-[#D5D5D5] rounded-[2px] text-[#202020] font-medium hover:bg-[#F7F7F7] flex items-center space-x-2">
            <svg class="w-4 h-4 text-[#626262]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
            </svg>
            <span>CSV export</span>
          </button>
        </div>
      </div>
    </div>

    <!-- Products Table Panel -->
    <div class="bg-[#FFFFFF] border border-[#D5D5D5] rounded-[2px] mb-8 overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="border-b border-[#D5D5D5] bg-[#FFFFFF] text-xs font-semibold text-[#626262] uppercase tracking-wider h-12">
              <th class="px-4 w-28">Item photograph</th>
              <th class="px-4">Product name</th>
              <th class="px-4">Pack specification</th>
              <th class="px-4">Assigned profile</th>
              <th class="px-4">Catalog status</th>
              <th class="px-4 text-right">Action</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-[#D5D5D5] text-[15px]">
            <!-- Primary sample row -->
            <tr class="h-12 hover:bg-[#F7F7F7]">
              <td class="px-4 py-2">
                <img 
                  src="https://lh3.googleusercontent.com/aida/AEtjO1WgSPshUkFcZmvnxOy3H7uPFO7vnua31jEAabBdx4WfRYInoVBclaBYzr6EOTkCWFqGsJS1uhjgOZkjwXnc6tXok5_V7hnJD71fMFpVOQvB0xDilugRi-So3x2iuqG8mhzrhcPOXs_uaNz4_YRLSzRonyj7WTjf5nSvwTo_MrbJYO2Vuwzuzgh5Zyao9k4Tvi2zu6Rzpy9-qzR1Cr9NTtD1_aXoZOH7xfrp2HTEKJUlFP5vifyhiJqQhA" 
                  alt="Insulin Glargine 100 units/mL pack of 10 pens" 
                  class="w-20 h-[60px] object-cover rounded-[2px] border border-[#D5D5D5]"
                >
              </td>
              <td class="px-4 font-medium text-[#202020]">
                Insulin Glargine 100 units/mL
              </td>
              <td class="px-4 text-[#202020]">
                pack of <span class="font-mono-num font-medium">10</span> pens
              </td>
              <td class="px-4 text-[#202020]">
                <span class="font-mono-num text-sm bg-[#F7F7F7] px-2 py-1 rounded-[2px] border border-[#D5D5D5]">profile v3</span>
                <span class="text-xs text-[#626262] ml-1">(permitted <span class="font-mono-num">2–8°C</span>)</span>
              </td>
              <td class="px-4">
                <span class="inline-flex items-center text-sm font-medium text-[#24704B]">
                  <span class="w-2 h-2 rounded-full bg-[#24704B] mr-1.5"></span>
                  good active
                </span>
              </td>
              <td class="px-4 text-right">
                <a href="#" class="inline-flex items-center justify-center h-9 px-3 bg-[#FFFFFF] border border-[#D5D5D5] rounded-[2px] text-sm font-medium text-[#202020] hover:bg-[#F7F7F7]">
                  Product detail
                </a>
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Inline Add Product Section -->
    <div class="bg-[#FFFFFF] border border-[#D5D5D5] rounded-[2px] p-6 mb-8">
      <div class="border-b border-[#D5D5D5] pb-4 mb-6">
        <h2 class="text-[20px] font-[650] text-[#202020] tracking-tight">Add product</h2>
        <p class="text-sm text-[#626262] mt-1">Configure new pharmaceutical line item and assign cold-chain thermal profile.</p>
      </div>

      <form class="space-y-6">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          <!-- Product Name -->
          <div>
            <label class="block text-sm font-medium text-[#202020] mb-2">Product name</label>
            <input 
              type="text" 
              placeholder="e.g. Insulin Glargine 100 units/mL" 
              class="w-full h-12 bg-[#FFFFFF] border border-[#D5D5D5] rounded-[2px] px-3 text-[#202020] placeholder-[#626262] focus:border-[#A94B1D]"
            >
          </div>

          <!-- Pack Size -->
          <div>
            <label class="block text-sm font-medium text-[#202020] mb-2">Pack size &amp; presentation</label>
            <input 
              type="text" 
              placeholder="e.g. pack of 10 pens" 
              class="w-full h-12 bg-[#FFFFFF] border border-[#D5D5D5] rounded-[2px] px-3 text-[#202020] placeholder-[#626262] focus:border-[#A94B1D]"
            >
          </div>

          <!-- Thermal Profile -->
          <div>
            <label class="block text-sm font-medium text-[#202020] mb-2">Thermal profile</label>
            <select class="w-full h-12 bg-[#FFFFFF] border border-[#D5D5D5] rounded-[2px] px-3 text-[#202020] focus:border-[#A94B1D]">
              <option selected>profile v3 (permitted 2–8°C, first upper tier >8–10°C, 30m allowance)</option>
              <option>profile v4 (proposed, takes effect 14 May 2026 or later)</option>
            </select>
          </div>

          <!-- Minimum Shelf Life -->
          <div>
            <label class="block text-sm font-medium text-[#202020] mb-2">Contractual shelf life threshold (days)</label>
            <input 
              type="text" 
              value="90" 
              class="w-full h-12 bg-[#FFFFFF] border border-[#D5D5D5] rounded-[2px] px-3 font-mono-num text-[#202020] focus:border-[#A94B1D]"
            >
            <span class="text-xs text-[#626262] mt-1 block">Contractual minimum remaining shelf-life threshold</span>
          </div>

          <!-- Catalog Status -->
          <div>
            <label class="block text-sm font-medium text-[#202020] mb-2">Initial status</label>
            <select class="w-full h-12 bg-[#FFFFFF] border border-[#D5D5D5] rounded-[2px] px-3 text-[#202020] focus:border-[#A94B1D]">
              <option selected>Active</option>
              <option>Inactive</option>
            </select>
          </div>

          <!-- Storage Location Default -->
          <div>
            <label class="block text-sm font-medium text-[#202020] mb-2">Default storage location</label>
            <input 
              type="text" 
              value="Cold Room C2, Rack 4" 
              class="w-full h-12 bg-[#FFFFFF] border border-[#D5D5D5] rounded-[2px] px-3 text-[#202020] focus:border-[#A94B1D]"
            >
          </div>
        </div>

        <div class="pt-4 border-t border-[#D5D5D5] flex items-center justify-end space-x-3">
          <button type="button" class="h-12 px-6 bg-[#FFFFFF] border border-[#D5D5D5] rounded-[2px] text-[#202020] font-medium hover:bg-[#F7F7F7]">
            Cancel
          </button>
          <button type="button" class="h-12 px-6 bg-[#A94B1D] text-white rounded-[2px] font-medium hover:brightness-95">
            Save product
          </button>
        </div>
      </form>
    </div>

  </main>

</body>
</html>
