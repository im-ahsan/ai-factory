<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Opening stock</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@600;650&family=IBM+Plex+Mono:wght@400;500;600&family=Public+Sans:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    /* Reset & Base variables strictly matching Meridian system */
    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      background-color: #F7F7F7;
      color: #202020;
      font-family: 'Public Sans', -apple-system, BlinkMacSystemFont, sans-serif;
      font-size: 16px;
      line-height: 1.5;
      -webkit-font-smoothing: antialiased;
      min-height: 100vh;
    }

    /* Typography */
    h1, .heading-main {
      font-family: 'Hanken Grotesk', sans-serif;
      font-size: 28px;
      font-weight: 650;
      line-height: 1.25;
      color: #202020;
    }

    h2, .heading-section {
      font-family: 'Hanken Grotesk', sans-serif;
      font-size: 20px;
      font-weight: 650;
      line-height: 1.3;
      color: #202020;
    }

    h3, .heading-small {
      font-family: 'Hanken Grotesk', sans-serif;
      font-size: 16px;
      font-weight: 600;
      line-height: 1.4;
      color: #202020;
    }

    .font-mono {
      font-family: 'IBM Plex Mono', monospace;
    }

    .text-quiet {
      color: #626262;
    }

    .text-sm {
      font-size: 14px;
    }

    /* Motion Tokens & Keyframes */
    @keyframes pageEntrance {
      from {
        opacity: 0;
        transform: translateY(6px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes savedHandoff {
      from {
        opacity: 0.6;
        transform: translateY(8px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes breatheWaiting {
      0%, 100% {
        opacity: 0.7;
      }
      50% {
        opacity: 1;
      }
    }

    .animate-entrance {
      animation: pageEntrance 280ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
      }
    }

    /* Header Component */
    header.site-header {
      background: #FFFFFF;
      border-bottom: 1px solid #D5D5D5;
      height: 64px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 32px;
    }

    .header-left {
      display: flex;
      align-items: center;
      gap: 32px;
    }

    .brand-mark {
      display: flex;
      align-items: center;
      gap: 10px;
      text-decoration: none;
      color: #202020;
    }

    .brand-logo-sq {
      width: 24px;
      height: 24px;
      background: #202020;
      color: #FFFFFF;
      font-family: 'Hanken Grotesk', sans-serif;
      font-weight: 650;
      font-size: 14px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 2px;
    }

    .brand-name {
      font-family: 'Hanken Grotesk', sans-serif;
      font-weight: 650;
      font-size: 18px;
      letter-spacing: -0.2px;
    }

    nav.main-nav {
      display: flex;
      align-items: center;
      gap: 24px;
    }

    nav.main-nav a {
      text-decoration: none;
      color: #626262;
      font-size: 15px;
      font-weight: 500;
      padding: 20px 0;
      position: relative;
      transition: color 140ms ease;
    }

    nav.main-nav a:hover {
      color: #202020;
    }

    nav.main-nav a:focus-visible {
      outline: 2px solid #A94B1D;
      outline-offset: 4px;
    }

    nav.main-nav a.selected {
      color: #202020;
      font-weight: 600;
    }

    nav.main-nav a.selected::after {
      content: '';
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      height: 2px;
      background: #A94B1D;
    }

    .header-right {
      display: flex;
      align-items: center;
      gap: 24px;
    }

    .operator-profile {
      display: flex;
      align-items: center;
      gap: 10px;
      font-size: 14px;
      color: #202020;
    }

    .avatar-badge {
      width: 28px;
      height: 28px;
      background: #FFFFFF;
      border: 1px solid #D5D5D5;
      border-radius: 2px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: 'IBM Plex Mono', monospace;
      font-size: 12px;
      font-weight: 500;
      color: #202020;
    }

    .lang-switcher {
      font-size: 14px;
      color: #626262;
      border-left: 1px solid #D5D5D5;
      padding-left: 20px;
    }

    /* Main Container */
    main.main-content {
      max-width: 960px;
      margin: 0 auto;
      padding: 32px 24px 64px 24px;
    }

    .title-row {
      margin-bottom: 32px;
    }

    /* Panels & Cards */
    .panel {
      background: #FFFFFF;
      border: 1px solid #D5D5D5;
      border-radius: 2px;
      padding: 24px;
      margin-bottom: 32px;
    }

    /* Product row inside panel */
    .product-field-block {
      display: grid;
      grid-template-columns: 160px 1fr;
      gap: 20px;
      padding-bottom: 24px;
      border-bottom: 1px solid #D5D5D5;
      margin-bottom: 24px;
      align-items: center;
    }

    .product-photo {
      width: 160px;
      height: 120px;
      object-fit: cover;
      border-radius: 2px;
      border: 1px solid #D5D5D5;
      display: block;
    }

    .product-info-details {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    .field-label {
      font-size: 14px;
      font-weight: 600;
      color: #626262;
      margin-bottom: 8px;
      display: block;
    }

    /* Form Fields Grid */
    .form-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 20px;
      margin-bottom: 24px;
    }

    .form-field {
      display: flex;
      flex-direction: column;
    }

    .input-field {
      height: 48px;
      background: #FFFFFF;
      border: 1px solid #D5D5D5;
      border-radius: 2px;
      padding: 0 14px;
      font-family: 'IBM Plex Mono', monospace;
      font-size: 15px;
      color: #202020;
      transition: border-color 140ms ease, box-shadow 140ms ease;
      width: 100%;
    }

    .input-field:focus {
      outline: none;
      border-color: #A94B1D;
      box-shadow: 0 0 0 1px #A94B1D;
    }

    .input-field[readonly] {
      background-color: #F7F7F7;
      color: #202020;
      cursor: default;
    }

    /* Information explanatory note */
    .service-explanation {
      background: #F7F7F7;
      border: 1px solid #D5D5D5;
      border-radius: 2px;
      padding: 16px;
      margin-bottom: 24px;
      font-size: 14px;
      line-height: 1.5;
      color: #626262;
    }

    /* Buttons */
    .actions-row {
      display: flex;
      align-items: center;
      gap: 16px;
    }

    .btn-primary {
      height: 48px;
      background: #A94B1D;
      color: #FFFFFF;
      border: none;
      border-radius: 2px;
      padding: 0 28px;
      font-family: 'Public Sans', sans-serif;
      font-size: 15px;
      font-weight: 600;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      transition: background-color 140ms ease, transform 90ms ease;
    }

    .btn-primary:hover {
      background-color: #933f17;
    }

    .btn-primary:active {
      transform: scale(0.98);
    }

    .btn-primary:focus-visible {
      outline: 2px solid #A94B1D;
      outline-offset: 3px;
    }

    .btn-secondary {
      height: 48px;
      background: #FFFFFF;
      color: #202020;
      border: 1px solid #D5D5D5;
      border-radius: 2px;
      padding: 0 24px;
      font-family: 'Public Sans', sans-serif;
      font-size: 15px;
      font-weight: 500;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      text-decoration: none;
      transition: background-color 140ms ease;
    }

    .btn-secondary:hover {
      background-color: #F7F7F7;
    }

    .btn-secondary:focus-visible {
      outline: 2px solid #A94B1D;
      outline-offset: 3px;
    }

    /* Status Indicators */
    .status-item {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-size: 14px;
      font-weight: 500;
    }

    .status-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      flex-shrink: 0;
    }

    .status-good {
      color: #24704B;
    }
    .status-good .status-dot {
      background: #24704B;
    }

    .status-waiting {
      color: #805800;
    }
    .status-waiting .status-dot {
      background: #805800;
    }

    .status-refused {
      color: #AE2C2C;
    }
    .status-refused .status-dot {
      background: #AE2C2C;
    }

    /* Submission feedback placeholder (hidden initially as instructed: 'show the returned result only after submission') */
    #service-response-card {
      display: none;
    }
  </style>
</head>
<body>
  <!-- Header: exact specification across Meridian -->
  <header class="site-header">
    <div class="header-left">
      <a href="#" class="brand-mark">
        <div class="brand-logo-sq">M</div>
        <div class="brand-name">Meridian</div>
      </a>
      <nav class="main-nav">
        <a href="#">Receipts</a>
        <a href="#" class="selected">Stock</a>
        <a href="#">Moves</a>
        <a href="#">Boxes</a>
        <a href="#">Cold rooms</a>
      </nav>
    </div>
    <div class="header-right">
      <div class="operator-profile">
        <div class="avatar-badge">LH</div>
        <span>Leila Haddad · Warehouse Operator</span>
      </div>
      <div class="lang-switcher">
        <span>EN / العربية</span>
      </div>
    </div>
  </header>

  <!-- Main Content -->
  <main class="main-content animate-entrance">
    <div class="title-row">
      <h1 class="heading-main">Opening stock</h1>
    </div>

    <!-- Restrained Opening Stock Form Panel -->
    <div class="panel">
      <!-- Product Field with Real Photographic Asset -->
      <label class="field-label">Product</label>
      <div class="product-field-block">
        <img 
          src="https://lh3.googleusercontent.com/aida/AEtjO1WgSPshUkFcZmvnxOy3H7uPFO7vnua31jEAabBdx4WfRYInoVBclaBYzr6EOTkCWFqGsJS1uhjgOZkjwXnc6tXok5_V7hnJD71fMFpVOQvB0xDilugRi-So3x2iuqG8mhzrhcPOXs_uaNz4_YRLSzRonyj7WTjf5nSvwTo_MrbJYO2Vuwzuzgh5Zyao9k4Tvi2zu6Rzpy9-qzR1Cr9NTtD1_aXoZOH7xfrp2HTEKJUlFP5vifyhiJqQhA" 
          alt="Insulin Glargine 100 units/mL carton packaging" 
          class="product-photo"
        >
        <div class="product-info-details">
          <div style="font-weight: 600; font-size: 16px; color: #202020;">
            Insulin Glargine 100 units/mL
          </div>
          <div class="text-sm text-quiet">
            pack of 10 pens · profile v3 (2–8°C)
          </div>
          <div class="text-sm text-quiet font-mono" style="margin-top: 4px;">
            Upper tier allowance: &gt;8–10°C (30 min)
          </div>
        </div>
      </div>

      <!-- Lot and Expiry & Warehouse Location -->
      <div class="form-grid">
        <div class="form-field">
          <label class="field-label" for="lot-number">Lot number</label>
          <input 
            type="text" 
            id="lot-number" 
            class="input-field" 
            value="IG-2511" 
            readonly
          >
        </div>
        <div class="form-field">
          <label class="field-label" for="expiry-date">Expiry date</label>
          <input 
            type="text" 
            id="expiry-date" 
            class="input-field" 
            value="31 March 2027" 
            readonly
          >
        </div>
      </div>

      <div class="form-grid">
        <div class="form-field">
          <label class="field-label" for="warehouse-location">Location</label>
          <input 
            type="text" 
            id="warehouse-location" 
            class="input-field" 
            value="North Quay Cold Room C2 Rack 4" 
            readonly
          >
        </div>
        <div class="form-field">
          <label class="field-label" for="recorded-quantity">Quantity (packs)</label>
          <input 
            type="text" 
            id="recorded-quantity" 
            class="input-field" 
            value="120"
          >
        </div>
      </div>

      <!-- Service explanation note -->
      <div class="service-explanation">
        The service confirms the recorded quantity and status, and will return the validated lot record upon submission.
      </div>

      <!-- Primary Action -->
      <div class="actions-row">
        <button type="button" class="btn-primary" id="btn-submit">
          Submit opening stock
        </button>
        <a href="#" class="btn-secondary">
          Cancel
        </a>
      </div>
    </div>

    <!-- Returned Result Panel (Visible only after submission) -->
    <div class="panel" id="service-response-card" style="border-left: 3px solid #24704B;">
      <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 16px;">
        <div>
          <h2 class="heading-section">Service confirmation</h2>
          <div class="text-sm text-quiet" style="margin-top: 4px;">
            Opening lot record confirmed and initialized in warehouse inventory.
          </div>
        </div>
        <div class="status-item status-good">
          <span class="status-dot"></span>
          <span>good</span>
        </div>
      </div>

      <div style="border-top: 1px solid #D5D5D5; padding-top: 16px;">
        <table style="width: 100%; border-collapse: collapse; font-size: 14px;">
          <tbody>
            <tr style="height: 48px; border-bottom: 1px solid #D5D5D5;">
              <td class="text-quiet" style="width: 200px;">Confirmed lot</td>
              <td class="font-mono" style="font-weight: 500;">IG-2511</td>
            </tr>
            <tr style="height: 48px; border-bottom: 1px solid #D5D5D5;">
              <td class="text-quiet">Recorded quantity</td>
              <td class="font-mono" style="font-weight: 500;">120 packs</td>
            </tr>
            <tr style="height: 48px; border-bottom: 1px solid #D5D5D5;">
              <td class="text-quiet">Warehouse location</td>
              <td>North Quay Cold Room C2 Rack 4</td>
            </tr>
            <tr style="height: 48px;">
              <td class="text-quiet">Returned status</td>
              <td>
                <span class="status-item status-good">
                  <span class="status-dot"></span>
                  <span>good</span>
                </span>
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </main>
</body>
</html>
