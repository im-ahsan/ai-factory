      \"given\": \"A refusal with a reason for each refused box is submitted\",\n      \"id\": \"AC-REQ-8.2\",\n      \"level\": \"ui\",\n      \"then\": \"the screen displays the returned refusal status and the returned warehouse quarantine status for refused boxes\",\n      \"when\": \"the service returns the refusal result\"\n     }\n    ],\n    \"ears\": \"When a receiver refuses delivery, the Meridian web app shall let the driver record refusal only by whole box and require a reason for each refused box.\",\n    \"id\": \"REQ-8\",\n    \"op\": \"ADDED\",\n    \"sources\": [\n     \"I-6\",\n     \"I-7\",\n     \"Q-7\"\n    ]\n   },\n   {\n    \"acceptance\": [\n     {\n      \"given\": \"The browser is offline\",\n      \"id\": \"AC-REQ-9.1\",\n      \"level\": \"ui\",\n      \"then\": \"the screen shows each action as queued and retains its entered values\",\n      \"when\": \"the driver records loading, handover, or refusal work\"\n     },\n     {\n      \"given\": \"A handover was recorded offline and connectivity returns\",\n      \"id\": \"AC-REQ-9.2\",\n      \"level\": \"ui\",\n      \"then\": \"the outgoing request contains the original handover time and the screen shows the returned sync status\",\n      \"when\": \"the web app synchronizes queued work\"\n     },\n     {\n      \"given\": \"Queued loading, handover, and refusal work exists and connectivity returns\",\n      \"id\": \"AC-REQ-9.3\",\n      \"level\": \"ui\",\n      \"then\": \"the screen shows the queued work being sent without requiring the driver to resubmit each action\",\n      \"when\": \"the web app reconnects\"\n     }\n    ],\n    \"ears\": \"While the browser has no network connection, the Meridian web app shall allow loading, handover, and refusal work to be recorded locally and automatically send queued work when connectivity returns while preserving the recorded handover time.\",\n    \"id\": \"REQ-9\",\n    \"op\": \"ADDED\",\n    \"sources\": [\n     \"I-7\",\n     \"I-8\",\