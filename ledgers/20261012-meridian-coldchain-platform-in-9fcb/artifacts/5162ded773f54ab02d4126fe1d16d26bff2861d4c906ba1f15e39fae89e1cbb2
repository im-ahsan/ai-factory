<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Record destruction</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@600;650;700&family=IBM+Plex+Mono:wght@400;500;600&family=Public+Sans:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    /* Reset & Base System Tokens */
    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }
    body {
      background-color: #F7F7F7;
      color: #202020;
      font-family: 'Public Sans', sans-serif;
      font-size: 16px;
      line-height: 1.5;
      -webkit-font-smoothing: antialiased;
      min-height: 100vh;
    }
    /* Typography */
    h1, h2, h3, h4 {
      font-family: 'Hanken+Grotesk', sans-serif;
    }
    h1 {
      font-size: 28px;
      font-weight: 650;
      line-height: 1.25;
      letter-spacing: -0.01em;
    }
    h2 {
      font-size: 20px;
      font-weight: 650;
      line-height: 1.3;
    }
    h3 {
      font-size: 16px;
      font-weight: 600;
      line-height: 1.35;
    }
    .mono {
      font-family: 'IBM Plex Mono', monospace;
    }
    .text-quiet {
      color: #626262;
    }
    .text-sm {
      font-size: 14px;
      line-height: 1.4;
    }

    /* Statuses */
    .status-good {
      color: #24704B;
      font-weight: 500;
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }
    .status-good::before {
      content: "";
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background-color: #24704B;
    }
    .status-waiting {
      color: #805800;
      font-weight: 500;
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }
    .status-waiting::before {
      content: "";
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background-color: #805800;
      animation: waitingBreathe 6s ease-in-out infinite;
    }
    .status-refused {
      color: #AE2C2C;
      font-weight: 500;
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }
    .status-refused::before {
      content: "";
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background-color: #AE2C2C;
    }

    /* Motion Tokens & Keyframes */
    @keyframes entranceFadeUp {
      from {
        opacity: 0;
        transform: translateY(8px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
    @keyframes savedHandoff {
      from {
        opacity: 0.6;
        transform: translateY(8px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
    @keyframes waitingBreathe {
      0%, 100% { opacity: 0.7; }
      50% { opacity: 1; }
    }

    .animate-entrance {
      animation: entranceFadeUp 260ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
    .handoff-anim {
      animation: savedHandoff 260ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    /* Header */
    header {
      background: #FFFFFF;
      border-bottom: 1px solid #D5D5D5;
      height: 56px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 32px;
      position: sticky;
      top: 0;
      z-index: 50;
    }
    .header-left {
      display: flex;
      align-items: center;
      gap: 32px;
    }
    .brand-wrap {
      display: flex;
      align-items: center;
      gap: 10px;
      text-decoration: none;
      color: #202020;
    }
    .brand-box {
      width: 24px;
      height: 24px;
      background: #202020;
      color: #FFFFFF;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: 'Hanken Grotesk', sans-serif;
      font-weight: 700;
      font-size: 14px;
      border-radius: 2px;
    }
    .brand-title {
      font-family: 'Hanken Grotesk', sans-serif;
      font-weight: 700;
      font-size: 16px;
      letter-spacing: -0.01em;
    }
    .menu-link {
      text-decoration: none;
      color: #A94B1D;
      font-family: 'Public Sans', sans-serif;
      font-size: 15px;
      font-weight: 600;
      position: relative;
      padding: 17px 0;
      border-bottom: 2px solid #A94B1D;
    }
    .header-right {
      display: flex;
      align-items: center;
      gap: 24px;
      font-size: 14px;
    }
    .user-profile {
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .user-initials {
      background: #EAEAEA;
      color: #202020;
      font-family: 'IBM Plex Mono', monospace;
      font-weight: 600;
      font-size: 13px;
      padding: 4px 6px;
      border-radius: 2px;
    }
    .lang-switch {
      color: #626262;
      font-size: 14px;
      border-left: 1px solid #D5D5D5;
      padding-left: 16px;
    }

    /* Layout */
    main {
      max-width: 1080px;
      margin: 0 auto;
      padding: 32px 32px 64px 32px;
    }
    .page-title-row {
      margin-bottom: 32px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    /* Panels */
    .panel {
      background: #FFFFFF;
      border: 1px solid #D5D5D5;
      border-radius: 2px;
      padding: 24px;
      margin-bottom: 32px;
    }
    .panel-flush {
      background: #FFFFFF;
      border: 1px solid #D5D5D5;
      border-radius: 2px;
      margin-bottom: 32px;
      overflow: hidden;
    }
    .panel-header {
      padding: 20px 24px;
      border-bottom: 1px solid #D5D5D5;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .panel-body {
      padding: 24px;
    }

    /* Lead Item Card */
    .lead-card {
      display: grid;
      grid-template-columns: 280px 1fr;
      gap: 24px;
      align-items: start;
    }
    .lead-img-wrap {
      width: 100%;
      aspect-ratio: 4 / 3;
      border: 1px solid #D5D5D5;
      border-radius: 2px;
      overflow: hidden;
      background: #F7F7F7;
    }
    .lead-img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }
    .lead-meta {
      display: flex;
      flex-direction: column;
      gap: 16px;
    }
    .meta-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      row-gap: 16px;
      column-gap: 24px;
      padding-top: 8px;
    }
    .meta-item {
      display: flex;
      flex-direction: column;
      gap: 4px;
    }
    .meta-label {
      font-size: 14px;
      color: #626262;
    }
    .meta-val {
      font-size: 15px;
      font-weight: 500;
      color: #202020;
    }

    /* Narrow Form Section */
    .form-wrapper {
      max-width: 540px;
    }
    .form-group {
      display: flex;
      flex-direction: column;
      gap: 8px;
      margin-bottom: 20px;
    }
    .form-label {
      font-size: 14px;
      font-weight: 600;
      color: #202020;
    }
    .form-hint {
      font-size: 14px;
      color: #626262;
      margin-top: -4px;
    }
    .input-field {
      height: 48px;
      background: #FFFFFF;
      border: 1px solid #D5D5D5;
      border-radius: 2px;
      padding: 0 14px;
      font-family: 'Public Sans', sans-serif;
      font-size: 15px;
      color: #202020;
      outline: none;
      transition: border-color 140ms ease;
    }
    .input-field.mono-val {
      font-family: 'IBM Plex Mono', monospace;
    }
    .input-field:focus {
      border-color: #A94B1D;
      outline: 2px solid #A94B1D;
      outline-offset: -1px;
    }
    .input-field:hover:not(:focus) {
      border-color: #626262;
    }
    .select-field {
      height: 48px;
      background: #FFFFFF;
      border: 1px solid #D5D5D5;
      border-radius: 2px;
      padding: 0 14px;
      font-family: 'Public Sans', sans-serif;
      font-size: 15px;
      color: #202020;
      outline: none;
      cursor: pointer;
    }
    .select-field:focus {
      border-color: #A94B1D;
      outline: 2px solid #A94B1D;
      outline-offset: -1px;
    }

    /* Button and Warnings */
    .action-row {
      display: flex;
      align-items: center;
      gap: 20px;
      margin-top: 24px;
    }
    .btn-primary {
      height: 48px;
      background-color: #A94B1D;
      color: #FFFFFF;
      border: 1px solid #A94B1D;
      border-radius: 2px;
      padding: 0 24px;
      font-family: 'Public Sans', sans-serif;
      font-size: 15px;
      font-weight: 600;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      transition: background-color 140ms ease, transform 90ms ease;
    }
    .btn-primary:hover {
      background-color: #8c3d16;
      border-color: #8c3d16;
    }
    .btn-primary:active {
      transform: scale(0.98);
    }
    .btn-primary:focus {
      outline: 2px solid #A94B1D;
      outline-offset: 2px;
    }
    .btn-secondary {
      height: 48px;
      background-color: #FFFFFF;
      color: #202020;
      border: 1px solid #D5D5D5;
      border-radius: 2px;
      padding: 0 20px;
      font-family: 'Public Sans', sans-serif;
      font-size: 15px;
      font-weight: 600;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      text-decoration: none;
      transition: border-color 140ms ease, transform 90ms ease;
    }
    .btn-secondary:hover {
      border-color: #626262;
    }
    .btn-secondary:active {
      transform: scale(0.98);
    }
    .warning-text {
      font-size: 14px;
      color: #626262;
      display: flex;
      align-items: center;
      gap: 6px;
    }
    .warning-icon {
      color: #805800;
      font-weight: 600;
      font-size: 14px;
    }

    /* Confirmation / Success audit panel */
    .audit-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 14px;
    }
    .audit-table th {
      text-align: left;
      padding: 12px 16px;
      font-weight: 600;
      color: #626262;
      border-bottom: 1px solid #D5D5D5;
      background: #FAFAFA;
      font-size: 13px;
      text-transform: uppercase;
      letter-spacing: 0.03em;
    }
    .audit-table td {
      padding: 14px 16px;
      border-bottom: 1px solid #D5D5D5;
      height: 48px;
      vertical-align: middle;
    }
    .audit-table tr:last-child td {
      border-bottom: none;
    }

    /* Responsive adjustments */
    @media (max-width: 768px) {
      .lead-card {
        grid-template-columns: 1fr;
      }
      .action-row {
        flex-direction: column;
        align-items: flex-start;
      }
      header {
        padding: 0 16px;
      }
      main {
        padding: 24px 16px;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
      }
    }
  </style>
</head>
<body>

  <!-- System Header -->
  <header>
    <div class="header-left">
      <div class="brand-wrap">
        <div class="brand-box">M</div>
        <span class="brand-title">Meridian</span>
      </div>
      <a href="#" class="menu-link">Quality cases</a>
    </div>
    <div class="header-right">
      <div class="user-profile">
        <span class="user-initials">OS</span>
        <span>Omar Saleh · Quality Officer</span>
      </div>
      <span class="lang-switch">EN / العربية</span>
    </div>
  </header>

  <!-- Main Content -->
  <main class="animate-entrance">
    <div class="page-title-row">
      <h1>Record destruction</h1>
      <a href="#" class="btn-secondary">Quality review</a>
    </div>

    <!-- Lead Section: HU-82 · 2 rejected packs with genuine carton photo -->
    <div class="panel">
      <div class="lead-card">
        <div class="lead-img-wrap">
          <img src="https://lh3.googleusercontent.com/aida/AEtjO1WgSPshUkFcZmvnxOy3H7uPFO7vnua31jEAabBdx4WfRYInoVBclaBYzr6EOTkCWFqGsJS1uhjgOZkjwXnc6tXok5_V7hnJD71fMFpVOQvB0xDilugRi-So3x2iuqG8mhzrhcPOXs_uaNz4_YRLSzRonyj7WTjf5nSvwTo_MrbJYO2Vuwzuzgh5Zyao9k4Tvi2zu6Rzpy9-qzR1Cr9NTtD1_aXoZOH7xfrp2HTEKJUlFP5vifyhiJqQhA" alt="Insulin Glargine packaging carton" class="lead-img">
        </div>
        <div class="lead-meta">
          <div>
            <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 4px;">
              <h2>HU-82 · <span class="mono">2</span> rejected packs</h2>
              <span class="status-refused">refused</span>
            </div>
            <p class="text-quiet text-sm">Insulin Glargine 100 units/mL, pack of 10 pens · Lot <span class="mono">IG-2511</span></p>
          </div>

          <div class="meta-grid">
            <div class="meta-item">
              <span class="meta-label">Physical handling unit</span>
              <span class="meta-val mono">HU-82</span>
            </div>
            <div class="meta-item">
              <span class="meta-label">Storage location</span>
              <span class="meta-val">North Quay Cold Room C2, Rack 4</span>
            </div>
            <div class="meta-item">
              <span class="meta-label">Expiry date</span>
              <span class="meta-val mono">31 March 2027</span>
            </div>
            <div class="meta-item">
              <span class="meta-label">Handling unit split</span>
              <span class="meta-val mono">10 Quarantined · 5 On Hold · 2 Rejected · 3 Expired</span>
            </div>
            <div class="meta-item">
              <span class="meta-label">Thermal profile & limit</span>
              <span class="meta-val">Profile v3 (2.0°C–8.0°C, 30m upper tier)</span>
            </div>
            <div class="meta-item">
              <span class="meta-label">Telemetry incident record</span>
              <span class="meta-val">9.1°C for 22m (Quality Case <span class="mono">Q-88</span>)</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Destruction Entry Form -->
    <div class="panel">
      <div style="margin-bottom: 20px;">
        <h2>Destruction logging</h2>
        <p class="text-quiet text-sm">Submit physical destruction and disposal record for verified unviable pharmaceutical stock.</p>
      </div>

      <div class="form-wrapper">
        <form onsubmit="return false;">
          <div class="form-group">
            <label class="form-label" for="destruction-date">Destruction date</label>
            <input type="text" id="destruction-date" class="input-field mono-val" value="14 May 2026" required>
            <span class="form-hint">Effective execution date under Europe/London (BST) standard</span>
          </div>

          <div class="form-group">
            <label class="form-label" for="destruction-qty">Quantity (packs)</label>
            <input type="number" id="destruction-qty" class="input-field mono-val" value="2" min="1" max="2" required>
            <span class="form-hint">Maximum allowable quantity: <span class="mono">2</span> packs (cannot exceed displayed rejected amount)</span>
          </div>

          <div class="form-group">
            <label class="form-label" for="destruction-witness">Witness</label>
            <select id="destruction-witness" class="select-field" required>
              <option value="Nadia Farouk · Quality Manager" selected>Nadia Farouk · Quality Manager</option>
              <option value="Leila Haddad · Warehouse Operator">Leila Haddad · Warehouse Operator</option>
              <option value="Esha Raman · Auditor">Esha Raman · Auditor</option>
            </select>
            <span class="form-hint">Authorized quality management or compliance witness</span>
          </div>

          <div class="action-row">
            <button type="submit" class="btn-primary">Record destruction</button>
            <div class="warning-text">
              <span class="warning-icon">⚠</span>
              <span>Irreversible disposal action: Stock will be permanently removed from physical inventory.</span>
            </div>
          </div>
        </form>
      </div>
    </div>

    <!-- Post-Execution Returned Status & Traceability Breakdown -->
    <div class="panel-flush">
      <div class="panel-header">
        <div>
          <h3>Disposition & inventory reconciliation</h3>
          <p class="text-quiet text-sm">Post-execution returned quantities and audit confirmation</p>
        </div>
        <span class="status-waiting">waiting</span>
      </div>

      <table class="audit-table">
        <thead>
          <tr>
            <th>Parameter</th>
            <th>Recorded value</th>
            <th>Reconciliation effect</th>
            <th>Verification status</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>Returned remaining rejected quantity</td>
            <td class="mono">0 packs remaining (2 destroyed)</td>
            <td>HU-82 rejected ledger cleared to zero</td>
            <td><span class="status-good">good</span></td>
          </tr>
          <tr>
            <td>Creator & authorization</td>
            <td>Omar Saleh · Quality Officer</td>
            <td>North Quay Facility authorized credentials</td>
            <td><span class="status-good">good</span></td>
          </tr>
          <tr>
            <td>Recorded execution time</td>
            <td class="mono">14 May 2026 10:45 BST</td>
            <td>Immutable cryptographic audit event entry</td>
            <td><span class="status-good">good</span></td>
          </tr>
          <tr>
            <td>Witness verification</td>
            <td>Nadia Farouk · Quality Manager</td>
            <td>Counter-signed disposal certificate</td>
            <td><span class="status-good">good</span></td>
          </tr>
          <tr>
            <td>Total on-hand stock balance</td>
            <td class="mono">122 packs total on hand</td>
            <td>60 available, 40 allocated, 10 quarantined, 5 on hold, 0 rejected, 4 recalled, 3 expired</td>
            <td><span class="status-good">good</span></td>
          </tr>
        </tbody>
      </table>
    </div>
  </main>

</body>
</html>
