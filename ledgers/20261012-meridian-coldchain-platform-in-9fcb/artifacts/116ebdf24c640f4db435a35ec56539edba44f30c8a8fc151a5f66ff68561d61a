<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Certificates</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@600;650;700&family=IBM+Plex+Mono:wght@400;500;600&family=Public+Sans:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    /* CSS Reset and Design System Tokens */
    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      background-color: #F7F7F7;
      color: #202020;
      font-family: 'Public Sans', sans-serif;
      font-size: 16px;
      line-height: 1.5;
      -webkit-font-smoothing: antialiased;
    }

    /* Headings font */
    h1, h2, h3, h4, .font-heading {
      font-family: 'Hanken Grotesk', sans-serif;
    }

    /* Numbers, codes, times font */
    .mono {
      font-family: 'IBM Plex Mono', monospace;
    }

    /* Status colors */
    .status-good {
      color: #24704B;
    }
    .status-waiting {
      color: #805800;
    }
    .status-refused, .status-failed {
      color: #AE2C2C;
    }

    .dot-good {
      display: inline-block;
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background-color: #24704B;
      margin-right: 6px;
    }
    .dot-waiting {
      display: inline-block;
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background-color: #805800;
      margin-right: 6px;
    }
    .dot-refused {
      display: inline-block;
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background-color: #AE2C2C;
      margin-right: 6px;
    }

    /* Rules and borders */
    .panel {
      background-color: #FFFFFF;
      border: 1px solid #D5D5D5;
      border-radius: 2px;
      padding: 16px;
      margin-bottom: 32px;
    }

    /* Buttons */
    .btn-primary {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      height: 48px;
      padding: 0 20px;
      background-color: #A94B1D;
      color: #FFFFFF;
      border: 1px solid #A94B1D;
      border-radius: 2px;
      font-family: 'Public Sans', sans-serif;
      font-size: 16px;
      font-weight: 500;
      text-decoration: none;
      cursor: pointer;
      transition: background-color 150ms ease, border-color 150ms ease, transform 90ms ease;
    }
    .btn-primary:hover {
      background-color: #933f17;
      border-color: #933f17;
    }
    .btn-primary:active {
      transform: scale(0.98);
    }
    .btn-primary:focus-visible {
      outline: 2px solid #A94B1D;
      outline-offset: 2px;
    }

    .btn-secondary {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      height: 48px;
      padding: 0 20px;
      background-color: #FFFFFF;
      color: #202020;
      border: 1px solid #D5D5D5;
      border-radius: 2px;
      font-family: 'Public Sans', sans-serif;
      font-size: 16px;
      font-weight: 500;
      text-decoration: none;
      cursor: pointer;
      transition: background-color 150ms ease, border-color 150ms ease, transform 90ms ease;
    }
    .btn-secondary:hover {
      background-color: #F7F7F7;
      border-color: #BFBFBF;
    }
    .btn-secondary:active {
      transform: scale(0.98);
    }
    .btn-secondary:focus-visible {
      outline: 2px solid #A94B1D;
      outline-offset: 2px;
    }

    /* Header Nav */
    header {
      background-color: #FFFFFF;
      border-bottom: 1px solid #D5D5D5;
      height: 64px;
      padding: 0 32px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .header-left {
      display: flex;
      align-items: center;
      gap: 32px;
    }
    .brand {
      display: flex;
      align-items: center;
      gap: 8px;
      text-decoration: none;
      color: #202020;
    }
    .brand-mark {
      width: 24px;
      height: 24px;
      background-color: #202020;
      color: #FFFFFF;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: 'Hanken Grotesk', sans-serif;
      font-weight: 700;
      font-size: 14px;
      border-radius: 2px;
    }
    .brand-name {
      font-family: 'Hanken Grotesk', sans-serif;
      font-weight: 700;
      font-size: 16px;
      letter-spacing: -0.2px;
    }
    nav.main-nav {
      display: flex;
      gap: 24px;
      height: 64px;
    }
    nav.main-nav a {
      display: inline-flex;
      align-items: center;
      text-decoration: none;
      color: #626262;
      font-size: 16px;
      font-weight: 500;
      height: 100%;
      border-bottom: 2px solid transparent;
      transition: color 150ms ease, border-color 150ms ease;
    }
    nav.main-nav a:hover {
      color: #202020;
    }
    nav.main-nav a.active {
      color: #A94B1D;
      border-bottom-color: #A94B1D;
    }

    .header-right {
      display: flex;
      align-items: center;
      gap: 20px;
    }
    .user-profile {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 15px;
      color: #202020;
    }
    .avatar-pill {
      background-color: #EEEEEE;
      color: #202020;
      padding: 4px 6px;
      border-radius: 2px;
      font-family: 'Public Sans', sans-serif;
      font-size: 13px;
      font-weight: 600;
      border: 1px solid #D5D5D5;
    }
    .lang-toggle {
      color: #626262;
      font-size: 14px;
      text-decoration: none;
    }
    .lang-toggle:hover {
      color: #202020;
    }

    /* Main Container */
    main {
      max-width: 1200px;
      margin: 0 auto;
      padding: 32px 32px 48px;
    }

    /* Page heading */
    .page-title {
      font-size: 28px;
      font-weight: 650;
      line-height: 1.2;
      margin-bottom: 8px;
      color: #202020;
    }
    .page-meta {
      font-size: 14px;
      color: #626262;
      margin-bottom: 32px;
    }

    /* Grid & Layouts */
    .grid-2col {
      display: grid;
      grid-template-columns: 2fr 1fr;
      gap: 32px;
    }
    .grid-metrics {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 16px;
      padding-bottom: 16px;
      margin-bottom: 16px;
      border-bottom: 1px solid #D5D5D5;
    }
    .metric-item {
      display: flex;
      flex-direction: column;
      gap: 4px;
    }
    .metric-label {
      font-size: 14px;
      color: #626262;
    }
    .metric-value {
      font-size: 16px;
      color: #202020;
      font-weight: 500;
    }

    /* Tables */
    table {
      width: 100%;
      border-collapse: collapse;
      text-align: left;
    }
    th {
      font-size: 14px;
      font-weight: 500;
      color: #626262;
      padding: 12px 16px;
      border-bottom: 1px solid #D5D5D5;
      background-color: #FAFAFA;
    }
    td {
      font-size: 15px;
      color: #202020;
      padding: 12px 16px;
      height: 48px;
      border-bottom: 1px solid #D5D5D5;
      vertical-align: middle;
    }
    tr:last-child td {
      border-bottom: none;
    }

    /* Versions list */
    .version-item {
      padding: 14px 16px;
      border-bottom: 1px solid #D5D5D5;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .version-item:last-child {
      border-bottom: none;
    }

    /* Chart visualization */
    .chart-container {
      margin: 16px 0;
      background: #FFFFFF;
      border: 1px solid #D5D5D5;
      border-radius: 2px;
      padding: 16px;
    }
    .chart-legend {
      display: flex;
      align-items: center;
      gap: 20px;
      font-size: 13px;
      color: #626262;
      margin-bottom: 16px;
    }
    .legend-indicator {
      display: inline-block;
      width: 12px;
      height: 3px;
      margin-right: 6px;
      vertical-align: middle;
    }

    /* Motion Tokens */
    @keyframes entranceFadeUp {
      from {
        opacity: 0;
        transform: translateY(6px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
    .animate-entrance {
      animation: entranceFadeUp 260ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    @keyframes syncBreathe {
      0%, 100% { opacity: 0.7; }
      50% { opacity: 1; }
    }
    .sync-breathing {
      animation: syncBreathe 6s ease-in-out infinite;
    }

    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
      }
    }
  </style>
</head>
