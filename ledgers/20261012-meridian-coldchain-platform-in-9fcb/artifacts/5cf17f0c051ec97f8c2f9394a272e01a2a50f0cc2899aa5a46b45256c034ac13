<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Audit trail — Empty State</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@600;650;700&family=IBM+Plex+Mono:wght@400;500;600&family=Public+Sans:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    /* Reset & Base variables */
    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      background-color: #F7F7F7;
      color: #202020;
      font-family: 'Public Sans', sans-serif;
      font-size: 16px;
      line-height: 1.5;
      -webkit-font-smoothing: antialiased;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    /* Typography */
    h1, .h1 {
      font-family: 'Hanken Grotesk', sans-serif;
      font-size: 28px;
      font-weight: 650;
      line-height: 1.25;
      color: #202020;
    }

    h2, .h2 {
      font-family: 'Hanken Grotesk', sans-serif;
      font-size: 20px;
      font-weight: 650;
      line-height: 1.3;
      color: #202020;
    }

    h3, .h3 {
      font-family: 'Hanken Grotesk', sans-serif;
      font-size: 16px;
      font-weight: 600;
      line-height: 1.4;
      color: #202020;
    }

    .quieter {
      color: #626262;
    }

    .supporting-text {
      font-size: 14px;
      line-height: 1.4;
      color: #626262;
    }

    .mono {
      font-family: 'IBM Plex Mono', monospace;
    }

    /* Motion Tokens & Keyframes */
    @keyframes entranceFadeUp {
      0% {
        opacity: 0;
        transform: translateY(6px);
      }
      100% {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes savedHandoff {
      0% {
        opacity: 0.6;
        transform: translateY(8px);
      }
      100% {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes waitingBreathe {
      0%, 100% {
        opacity: 0.7;
      }
      50% {
        opacity: 1;
      }
    }

    .entrance-animate {
      animation: entranceFadeUp 260ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    /* Global Header */
    header {
      background-color: #FFFFFF;
      border-bottom: 1px solid #D5D5D5;
      height: 64px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 32px;
      position: sticky;
      top: 0;
      z-index: 50;
    }

    .header-left {
      display: flex;
      align-items: center;
      gap: 32px;
    }

    .brand-mark {
      display: flex;
      align-items: center;
      gap: 8px;
      text-decoration: none;
      color: #202020;
      font-family: 'Hanken Grotesk', sans-serif;
      font-size: 18px;
      font-weight: 700;
      letter-spacing: -0.01em;
    }

    .brand-logo-m {
      width: 24px;
      height: 24px;
      background-color: #202020;
      color: #FFFFFF;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: 'Hanken Grotesk', sans-serif;
      font-weight: 700;
      font-size: 14px;
      border-radius: 2px;
    }

    nav {
      display: flex;
      align-items: center;
      gap: 24px;
    }

    nav a {
      text-decoration: none;
      color: #626262;
      font-size: 15px;
      font-weight: 500;
      padding: 20px 0;
      position: relative;
      transition: color 150ms ease;
    }

    nav a:hover {
      color: #202020;
    }

    nav a.active {
      color: #A94B1D;
      font-weight: 600;
    }

    nav a.active::after {
      content: '';
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      height: 2px;
      background-color: #A94B1D;
    }

    nav a:focus-visible {
      outline: 2px solid #A94B1D;
      outline-offset: 4px;
      border-radius: 2px;
    }

    .header-right {
      display: flex;
      align-items: center;
      gap: 16px;
    }

    .user-profile {
      display: flex;
      align-items: center;
      gap: 10px;
      font-size: 14px;
      color: #202020;
    }

    .user-avatar {
      width: 28px;
      height: 28px;
      background-color: #E8E8E8;
      color: #202020;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: 'IBM Plex Mono', monospace;
      font-weight: 600;
      font-size: 12px;
      border-radius: 2px;
    }

    .lang-switch {
      font-size: 13px;
      color: #626262;
      border-left: 1px solid #D5D5D5;
      padding-left: 16px;
      display: flex;
      align-items: center;
      gap: 6px;
      font-family: 'Public Sans', sans-serif;
    }

    /* Main Container */
    main {
      flex: 1;
      width: 100%;
      max-width: 1360px;
      margin: 0 auto;
      padding: 32px 32px 48px;
      display: flex;
      flex-direction: column;
      gap: 32px;
    }

    /* Page Heading Block */
    .page-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    /* Panels & Containers */
    .panel {
      background-color: #FFFFFF;
      border: 1px solid #D5D5D5;
      border-radius: 2px;
      padding: 16px;
    }

    /* Filters Bar */
    .filters-grid {
      display: grid;
      grid-template-columns: 2fr 1.5fr 1.5fr 1.5fr auto;
      gap: 16px;
      align-items: flex-end;
    }

    .filter-group {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    .filter-label {
      font-size: 14px;
      color: #626262;
      font-weight: 500;
    }

    .input-field, .select-field {
      height: 48px;
      background-color: #FFFFFF;
      border: 1px solid #D5D5D5;
      border-radius: 2px;
      padding: 0 14px;
      font-family: 'Public Sans', sans-serif;
      font-size: 15px;
      color: #202020;
      width: 100%;
      outline: none;
      transition: border-color 150ms ease, box-shadow 150ms ease;
    }

    .input-field:focus, .select-field:focus {
      border-color: #A94B1D;
      outline: 1px solid #A94B1D;
    }

    .select-field {
      appearance: none;
      background-image: url("data:image/svg+xml;charset=US-ASCII,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20width%3D%2212%22%20height%3D%228%22%20viewBox%3D%220%200%2012%208%22%3E%3Cpath%20fill%3D%22%23202020%22%20d%3D%22M1.41%200L6%204.58L10.59%200L12%201.41l-6%206l-6-6z%22%2F%3E%3C%2Fsvg%3E");
      background-repeat: no-repeat;
      background-position: right 14px center;
      padding-right: 36px;
      cursor: pointer;
    }

    /* Buttons */
    .btn-secondary {
      height: 48px;
      background-color: #FFFFFF;
      border: 1px solid #D5D5D5;
      border-radius: 2px;
      padding: 0 20px;
      font-family: 'Public Sans', sans-serif;
      font-size: 15px;
      font-weight: 500;
      color: #202020;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      white-space: nowrap;
      transition: background-color 150ms ease, border-color 150ms ease, transform 90ms ease;
    }

    .btn-secondary:hover {
      background-color: #F7F7F7;
      border-color: #C0C0C0;
    }

    .btn-secondary:active {
      transform: scale(0.99);
      background-color: #ECECEC;
    }

    .btn-secondary:focus-visible {
      outline: 2px solid #A94B1D;
      outline-offset: 2px;
    }

    .btn-primary {
      height: 48px;
      background-color: #A94B1D;
      border: 1px solid #A94B1D;
      border-radius: 2px;
      padding: 0 24px;
      font-family: 'Public Sans', sans-serif;
      font-size: 15px;
      font-weight: 500;
      color: #FFFFFF;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      white-space: nowrap;
      transition: background-color 150ms ease, transform 90ms ease;
      text-decoration: none;
    }

    .btn-primary:hover {
      background-color: #933F17;
      border-color: #933F17;
    }

    .btn-primary:active {
      transform: scale(0.99);
      background-color: #803512;
    }

    .btn-primary:focus-visible {
      outline: 2px solid #A94B1D;
      outline-offset: 2px;
    }

    /* Ledger Table & Empty Area */
    .ledger-container {
      background-color: #FFFFFF;
      border: 1px solid #D5D5D5;
      border-radius: 2px;
      overflow: hidden;
      display: flex;
      flex-direction: column;
    }

    .table-header {
      display: grid;
      grid-template-columns: 140px 180px 180px 220px 1fr 140px;
      height: 48px;
      align-items: center;
      padding: 0 16px;
      background-color: #FFFFFF;
      border-bottom: 1px solid #D5D5D5;
      font-size: 13px;
      font-weight: 600;
      color: #626262;
      text-transform: uppercase;
      letter-spacing: 0.03em;
    }

    .empty-state-panel {
      padding: 88px 32px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      gap: 16px;
    }

    .empty-state-icon {
      width: 56px;
      height: 56px;
      border: 1px solid #D5D5D5;
      border-radius: 2px;
      background-color: #F7F7F7;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 8px;
      color: #626262;
    }

    .empty-state-title {
      font-family: 'Hanken Grotesk', sans-serif;
      font-size: 20px;
      font-weight: 650;
      color: #202020;
    }

    .empty-state-desc {
      font-size: 15px;
      color: #626262;
      max-width: 480px;
      line-height: 1.5;
    }

    .table-footer {
      height: 48px;
      padding: 0 16px;
      border-top: 1px solid #D5D5D5;
      display: flex;
      align-items: center;
      justify-content: space-between;
      background-color: #FFFFFF;
      font-size: 13px;
      color: #626262;
    }

    /* Accessibility */
    @media (prefers-reduced-motion: reduce) {
      .entrance-animate {
        animation: none;
      }
      .btn-primary, .btn-secondary, nav a {
        transition: none;
      }
    }
  </style>
</head>
<body>

  <!-- Persistent System Header -->
  <header>
    <div class="header-left">
      <a href="#" class="brand-mark">
        <span class="brand-logo-m">M</span>
        <span>Meridian</span>
      </a>
      <nav>
        <a href="#">Products</a>
        <a href="#">Organisations</a>
        <a href="#">Accounts</a>
        <a href="#" class="active">Audit trail</a>
        <a href="#">Reports</a>
      </nav>
    </div>
    <div class="header-right">
      <div class="user-profile">
        <span class="user-avatar">MV</span>
        <span>Marcus Vale · System Administrator</span>
      </div>
      <div class="lang-switch">
        <span>EN</span>
        <span>/</span>
        <span>العربية</span>
      </div>
    </div>
  </header>

  <!-- Main Content Area -->
  <main class="entrance-animate">
    <!-- Page Heading -->
    <div class="page-header">
      <h1>Audit trail</h1>
    </div>

    <!-- Filters Panel -->
    <div class="panel">
      <div class="filters-grid">
        <div class="filter-group">
          <label class="filter-label" for="search-record">Instant record or lot</label>
          <input type="text" id="search-record" class="input-field" placeholder="Search record, lot, or ID...">
        </div>
        <div class="filter-group">
          <label class="filter-label" for="filter-user">User</label>
          <select id="filter-user" class="select-field">
            <option value="">All users</option>
            <option value="leila">Leila Haddad</option>
            <option value="omar">Omar Saleh</option>
            <option value="priya">Priya Nair</option>
            <option value="nadia">Nadia Farouk</option>
            <option value="tariq">Tariq Mansour</option>
            <option value="hana">Hana Youssef</option>
            <option value="salma">Salma Idris</option>
            <option value="marcus">Marcus Vale</option>
            <option value="esha">Esha Raman</option>
          </select>
        </div>
        <div class="filter-group">
          <label class="filter-label" for="filter-date">Date range</label>
          <select id="filter-date" class="select-field">
            <option value="all">All dates</option>
            <option value="today">14 May 2026 (Today)</option>
            <option value="yesterday">13 May 2026</option>
            <option value="2days">12 May 2026</option>
          </select>
        </div>
        <div class="filter-group">
          <label class="filter-label" for="filter-action">Action type</label>
          <select id="filter-action" class="select-field">
            <option value="">All actions</option>
            <option value="receipt">Stock receipt</option>
            <option value="logger">Logger upload</option>
            <option value="release">Quality release</option>
            <option value="excursion">Excursion alert</option>
            <option value="order">Order placement</option>
            <option value="route">Route confirmation</option>
            <option value="recall">Recall initiation</option>
          </select>
        </div>
        <div>
          <button type="button" class="btn-secondary">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M8 11L4 7H6.5V2H9.5V7H12L8 11Z" fill="#202020"/>
              <path d="M2 13V14H14V13H2Z" fill="#202020"/>
            </svg>
            Export filtered CSV
          </button>
        </div>
      </div>
    </div>

    <!-- Ledger Table with Empty State -->
    <div class="ledger-container">
      <div class="table-header">
        <div>Timestamp</div>
        <div>Record ID</div>
        <div>User</div>
        <div>Action type</div>
        <div>Scope & Summary</div>
        <div>Status</div>
      </div>

      <!-- Empty State View -->
      <div class="empty-state-panel">
        <div class="empty-state-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="4" width="18" height="16" rx="1"/>
            <line x1="7" y1="8" x2="17" y2="8"/>
            <line x1="7" y1="12" x2="17" y2="12"/>
            <line x1="7" y1="16" x2="12" y2="16"/>
          </svg>
        </div>
        <div class="empty-state-title">No audit records recorded</div>
        <div class="empty-state-desc">
          No system events or ledger modifications have been recorded for this facility yet. Record the first receipt or intake transaction to initialize the audit trail.
        </div>
        <a href="#" class="btn-primary" style="margin-top: 8px;">
          Record receipt
        </a>
      </div>

      <!-- Table Footer / Count -->
      <div class="table-footer">
        <span class="mono">0 audit records</span>
        <span class="mono">Prototype date: 14 May 2026 · Europe/London (BST)</span>
      </div>
    </div>
  </main>

</body>
</html>