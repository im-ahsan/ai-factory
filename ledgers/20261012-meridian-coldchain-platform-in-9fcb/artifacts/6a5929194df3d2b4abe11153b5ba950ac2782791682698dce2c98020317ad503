<div class="w-full overflow-x-auto border-b border-[#D5D5D5]">
<div class="min-w-[980px] grid grid-cols-12 h-12 items-center px-4 text-xs font-semibold tracking-[0.08em] uppercase text-[#626262] select-none bg-[#FFFFFF]">
<div class="col-span-1">Case</div>
<div class="col-span-1">Opened (BST)</div>
<div class="col-span-2">Lot number</div>
<div class="col-span-2">Target entity</div>
<div class="col-span-3">Scope, customer &amp; telemetry summary</div>
<div class="col-span-1">Telemetry</div>
<div class="col-span-1">Status</div>
<div class="col-span-1 text-right">Action</div>
</div>
</div>
<!-- Empty State Content Canvas -->
<div class="flex-1 flex flex-col items-center justify-center py-20 px-4 text-center">
<!-- Clean minimalist line icon box (48px with 1px border #D5D5D5) -->
<div class="w-12 h-12 rounded-[2px] border border-[#D5D5D5] flex items-center justify-center bg-[#F7F7F7] mb-4">
<span aria-hidden="true" class="material-symbols-outlined text-[#626262] text-[24px]">
            fact_check
          </span>
</div>
<!-- Title -->
<h2 class="font-headline text-[20px] leading-[1.3] font-[650] text-[#202020] mb-2">
          No quality cases recorded
        </h2>
<!-- Explanatory message -->
<p class="font-body text-sm leading-[1.5] text-[#626262] max-w-[540px] mb-6">
          No quality review cases have been opened for North Quay Warehouse inventory or outbound shipments. Cases are logged when temperature excursions or reading discrepancies require investigation.
        </p>
<!-- Primary Action Button -->
<div>
<button class="btn-action-primary h-12 px-6 rounded-[2px] text-sm font-semibold flex items-center justify-center space-x-2" type="button">
<span aria-hidden="true" class="material-symbols-outlined text-[18px]">add</span>
<span>Quality review</span>
</button>
</div>
</div>
