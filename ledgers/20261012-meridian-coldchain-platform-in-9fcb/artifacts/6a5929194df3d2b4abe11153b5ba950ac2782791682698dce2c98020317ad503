<style>
    :root {
      --dur-instant: 90ms;
      --dur-quick: 160ms;
      --dur-base: 260ms;
      --dur-slow: 420ms;
      --dur-scene: 800ms;
      --ease-out: cubic-bezier(0.16, 1, 0.3, 1);
      --ease-spring: linear(0, 0.009, 0.035 2.1%, 0.141, 0.281 6.7%, 0.723 12.9%, 0.938 16.7%, 1.017, 1.077 21.4%, 1.121 24%, 1.149 27%, 1.159, 1.154 33%, 1.051 43.2%, 1.013 49.5%, 0.996 57%, 1.001 72%, 1);
    }

    @keyframes entranceFadeUp {
      from {
        opacity: 0;
        transform: translateY(8px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .animate-entrance-1 {
      animation: entranceFadeUp var(--dur-slow) var(--ease-out) both;
    }
    
    .animate-entrance-2 {
      animation: entranceFadeUp var(--dur-slow) var(--ease-out) 60ms both;
    }
    
    .animate-entrance-3 {
      animation: entranceFadeUp var(--dur-slow) var(--ease-out) 120ms both;
    }

    /* Interactive button styles complying with tokens */
    .btn-action-primary {
      background-color: #A94B1D;
      color: #FFFFFF;
      transition: transform var(--dur-instant), background-color var(--dur-instant);
    }
    .btn-action-primary:hover {
      background-color: #8f3e17;
    }
    .btn-action-primary:active {
      transform: scale(0.97);
    }
    .btn-action-primary:focus-visible {
      outline: 2px solid #A94B1D;
      outline-offset: 2px;
    }

    .btn-action-secondary {
      background-color: #FFFFFF;
      border: 1px solid #D5D5D5;
      color: #202020;
      transition: transform var(--dur-instant), background-color var(--dur-instant);
    }
    .btn-action-secondary:hover {
      background-color: #F7F7F7;
    }
    .btn-action-secondary:active {
      transform: scale(0.97);
    }
    .btn-action-secondary:focus-visible {
      outline: 2px solid #A94B1D;
      outline-offset: 2px;
    }

    /* Standard inputs */
    .work-input {
      background-color: #FFFFFF;
      border: 1px solid #D5D5D5;
      color: #202020;
      border-radius: 2px;
      height: 48px;
      transition: border-color var(--dur-instant), outline var(--dur-instant);
    }
    .work-input:focus {
      outline: 2px solid #A94B1D;
      outline-offset: 2px;
      border-color: #A94B1D;
    }

    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        animation: none !important;
        transition-property: opacity !important;
        transition-duration: 120ms !important;
        scroll-behavior: auto !important;
      }
    }
  </style>
