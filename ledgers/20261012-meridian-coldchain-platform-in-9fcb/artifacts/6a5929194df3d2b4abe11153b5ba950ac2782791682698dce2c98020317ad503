<div class="h-12 border-t border-[#D5D5D5] px-4 flex items-center justify-between text-xs text-[#626262] font-mono bg-[#FFFFFF]">
<div class="flex items-center space-x-2">
<span class="font-semibold text-[#202020]">0</span>
<span>records</span>
<span class="text-[#D5D5D5]">·</span>
<span>0 quality cases under review</span>
</div>
<div class="flex items-center space-x-1.5">
<span aria-hidden="true" class="w-1.5 h-1.5 rounded-full bg-[#24704B]"></span>
<span>North Quay Warehouse scope</span>
</div>
</div>
</section>
</main>
