<body class="min-h-screen bg-[#F7F7F7] text-[#202020] font-body flex flex-col antialiased selection:bg-[#ffdbcd] selection:text-[#360f00]">
<!-- Top Bar -->
<header class="w-full bg-[#FFFFFF] border-b border-[#D5D5D5] sticky top-0 z-40">
<div class="max-w-[1280px] h-14 mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-between">
<!-- Left side: Brand + Nav Menu Item -->
<div class="flex items-center h-full space-x-6">
<div class="flex items-center space-x-2">
<div class="w-6 h-6 bg-[#202020] rounded-[2px] flex items-center justify-center">
<span class="text-[#FFFFFF] font-headline font-bold text-xs tracking-wider">M</span>
</div>
<span class="font-headline font-bold text-base text-[#202020] tracking-tight">Meridian</span>
</div>
<nav class="flex items-center h-full">
<div class="h-14 flex items-center border-b-2 border-[#A94B1D] px-2">
<span class="font-body text-sm font-semibold text-[#A94B1D]">Quality cases</span>
</div>
</nav>
</div>
<!-- Right side: User Profile + Language -->
<div class="flex items-center space-x-4 text-sm">
<div class="flex items-center space-x-2">
<div class="w-7 h-7 bg-[#E8E8E8] text-[#202020] border border-[#D5D5D5] rounded-[2px] flex items-center justify-center font-mono font-medium text-xs">
            OS
          </div>
<span class="text-[#202020] font-medium">Omar Saleh</span>
<span class="text-[#626262]">· Quality Officer</span>
</div>
<span aria-hidden="true" class="text-[#D5D5D5]">|</span>
<div class="text-xs font-mono text-[#626262] tracking-wide" lang="ar">
          EN / العربية
        </div>
</div>
</div>
</header>
<!-- Main Work Surface -->
<main class="flex-1 w-full max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8 py-8 flex flex-col">
<!-- Page Heading -->
<div class="mb-6 animate-entrance-1">
<h1 class="font-headline text-[28px] leading-[1.2] font-[650] tracking-[-0.025em] text-[#202020]">
        Quality cases
      </h1>
</div>
<!-- Filter Bar / Search Section -->
<section aria-label="Filters" class="bg-[#FFFFFF] border border-[#D5D5D5] rounded-[2px] p-4 mb-6 animate-entrance-2">
<div class="grid grid-cols-1 md:grid-cols-12 gap-4 items-end">
<!-- Search Field -->
<div class="md:col-span-5 flex flex-col space-y-1.5">
<label class="text-xs font-semibold uppercase tracking-[0.08em] text-[#626262]" for="case-search">
            Search case, lot, entity, or consignee
          </label>
<div class="relative">
<input class="work-input w-full px-3 text-sm placeholder-[#626262]" id="case-search" placeholder="e.g. Q-88, HU-82, IG-2511, Cedar Health" type="text"/>
</div>
</div>
<!-- Review status select dropdown -->
<div class="md:col-span-3 flex flex-col space-y-1.5">
<label class="text-xs font-semibold uppercase tracking-[0.08em] text-[#626262]" for="review-status-select">
            Review status
          </label>
<div class="relative">
<select class="work-input w-full px-3 text-sm appearance-none bg-none cursor-pointer pr-8" id="review-status-select">
<option value="all">All statuses</option>
<option value="under_review">Under review</option>
<option value="held">Held</option>
<option value="resolved">Resolved</option>
<option value="closed">Closed</option>
</select>
<span aria-hidden="true" class="material-symbols-outlined pointer-events-none absolute right-2.5 top-3.5 text-[#626262] text-[20px]">
              expand_more
            </span>
</div>
</div>
<!-- Case classification select dropdown -->
<div class="md:col-span-3 flex flex-col space-y-1.5">
<label class="text-xs font-semibold uppercase tracking-[0.08em] text-[#626262]" for="case-class-select">
            Case classification
          </label>
<div class="relative">
<select class="work-input w-full px-3 text-sm appearance-none bg-none cursor-pointer pr-8" id="case-class-select">
<option value="all">All categories</option>
<option value="temp_excursion">Temperature excursion</option>
<option value="label_mismatch">Seal &amp; serial discrepancy</option>
<option value="sensor_telemetry">Sensor telemetry gap</option>
<option value="chain_custody">Chain of custody break</option>
</select>
<span aria-hidden="true" class="material-symbols-outlined pointer-events-none absolute right-2.5 top-3.5 text-[#626262] text-[20px]">
              expand_more
            </span>
</div>
</div>
<!-- CSV Export Secondary Button -->
<div class="md:col-span-1">
<button class="btn-action-secondary h-12 w-full px-3 rounded-[2px] text-sm font-medium flex items-center justify-center space-x-1.5" type="button">
