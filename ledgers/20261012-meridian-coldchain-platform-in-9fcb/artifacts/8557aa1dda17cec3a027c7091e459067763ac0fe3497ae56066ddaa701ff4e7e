<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Cold rooms</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@600;650&family=IBM+Plex+Mono:wght@400;500&family=Public+Sans:wght@400;500;600&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    /* Design System Tokens */
    :root {
      --bg-page: #F7F7F7;
      --bg-panel: #FFFFFF;
      --text-main: #202020;
      --text-quiet: #626262;
      --border-rule: #D5D5D5;
      --primary-accent: #A94B1D;
      --status-good: #24704B;
      --status-waiting: #805800;
      --status-refused: #AE2C2C;
    }

    body {
      background-color: var(--bg-page);
      color: var(--text-main);
      font-family: 'Public Sans', sans-serif;
      font-size: 16px;
      line-height: 1.5;
      margin: 0;
      padding: 0;
      -webkit-font-smoothing: antialiased;
    }

    h1, .font-heading {
      font-family: 'Hanken+Grotesk', sans-serif;
    }

    .font-mono-numbers {
      font-family: 'IBM Plex Mono', monospace;
    }

    /* 2px corners rule */
    .rounded-2px {
      border-radius: 2px;
    }

    /* Motion Tokens */
    @keyframes pageEnter {
      from {
        opacity: 0;
        transform: translateY(4px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes savedHandoff {
      0% {
        opacity: 0.6;
        transform: translateY(8px);
      }
      100% {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes syncBreathe {
      0%, 100% {
        opacity: 0.7;
      }
      50% {
        opacity: 1;
      }
    }

    .animate-page-enter {
      animation: pageEnter 260ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    .animate-saved-handoff {
      animation: savedHandoff 260ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    .animate-sync-breathe {
      animation: syncBreathe 6s ease-in-out infinite;
    }

    /* Interaction states */
    .interactive-control {
      transition: background-color 150ms ease, border-color 150ms ease, color 150ms ease;
    }
    .interactive-control:hover {
      background-color: #F0F0F0;
    }
    .interactive-control:focus-visible {
      outline: 2px solid var(--primary-accent);
      outline-offset: 2px;
    }
    .interactive-control:active {
      background-color: #E6E6E6;
    }

    .nav-link {
      transition: color 150ms ease, border-color 150ms ease;
    }
    .nav-link:hover {
      color: var(--text-main);
    }
    .nav-link:focus-visible {
      outline: 2px solid var(--primary-accent);
      outline-offset: 2px;
    }

    .btn-secondary {
      height: 48px;
      background-color: var(--bg-panel);
      border: 1px solid var(--border-rule);
      color: var(--text-main);
      border-radius: 2px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 0 20px;
      font-size: 16px;
      font-weight: 500;
      transition: background-color 150ms ease, border-color 150ms ease;
      text-decoration: none;
    }
    .btn-secondary:hover {
      background-color: #F7F7F7;
      border-color: #BEBEBE;
    }
    .btn-secondary:focus-visible {
      outline: 2px solid var(--primary-accent);
      outline-offset: 2px;
    }
    .btn-secondary:active {
      background-color: #EFEFEF;
    }

    @media (prefers-reduced-motion: reduce) {
      *, ::before, ::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
      }
    }
  </style>
</head>
<body class="min-h-screen">

  <!-- Header: exact specification across all pages -->
  <header class="bg-white border-b border-[#D5D5D5] h-16 w-full">
    <div class="max-w-[1440px] mx-auto h-full px-8 flex items-center justify-between">
      <!-- Left: Logo & Nav -->
      <div class="flex items-center space-x-8">
        <div class="flex items-center space-x-3">
          <div class="w-7 h-7 bg-[#202020] rounded-2px flex items-center justify-center">
            <span class="text-white font-heading font-semibold text-base leading-none">M</span>
          </div>
          <span class="font-heading font-semibold text-lg text-[#202020] tracking-tight">Meridian</span>
        </div>
        
        <nav class="flex items-center space-x-6 h-16">
          <a href="#" class="nav-link text-[#626262] text-base h-full flex items-center">Receipts</a>
          <a href="#" class="nav-link text-[#626262] text-base h-full flex items-center">Stock</a>
          <a href="#" class="nav-link text-[#626262] text-base h-full flex items-center">Moves</a>
          <a href="#" class="nav-link text-[#626262] text-base h-full flex items-center">Boxes</a>
          <a href="#" class="nav-link text-[#A94B1D] font-medium text-base h-full flex items-center border-b-2 border-[#A94B1D]">Cold rooms</a>
        </nav>
      </div>

      <!-- Right: User & Locale -->
      <div class="flex items-center space-x-6">
        <div class="flex items-center space-x-3">
          <div class="w-7 h-7 border border-[#D5D5D5] bg-[#F7F7F7] rounded-2px flex items-center justify-center">
            <span class="font-heading font-semibold text-xs text-[#202020]">LH</span>
          </div>
          <span class="text-[#202020] text-sm">Leila Haddad · Warehouse Operator</span>
        </div>
        <div class="h-4 w-[1px] bg-[#D5D5D5]"></div>
        <div class="text-[#202020] text-sm">
          <span>EN</span> / <span class="text-[#626262]">العربية</span>
        </div>
      </div>
    </div>
  </header>

  <!-- Main Content Area -->
  <main class="max-w-[1440px] mx-auto px-8 pt-8 pb-32 animate-page-enter">
    
    <!-- Page Single Heading (28px / 650) -->
    <h1 class="text-[28px] leading-tight font-semibold text-[#202020] tracking-tight mb-8">Cold rooms</h1>

    <!-- Lead Section: Latest Returned Reading & Status Flag for North Quay Cold Room C2 -->
    <section class="bg-white border border-[#D5D5D5] rounded-2px p-6 mb-8">
      <div class="flex flex-col md:flex-row gap-8 items-start">
        
        <!-- Photograph: Real cold storage racks and insulated door, 4:3 crop, 2px corners -->
        <div class="w-full md:w-[320px] flex-shrink-0">
          <img 
            src="https://lh3.googleusercontent.com/aida-public/AB6AXuDr6jflEi1CYSZ1lF5dbIqDZIeVO9O-9w6bId27zwi8f3bvl7WlNiKhRSncj3dnULG7FREavMONIXarEoMXNMU6uv5T-H-Gd5jcB8vgLoMin90TRwMfwOHAPo35B4BQejgl1zN1l-5IXHFYukqv3JCz-yRi8toT-jL-61aoQmVdVzztLPujg3W0AzN6kVM--KXShKbwCyKAIOiYCTvG5ujVMFZI3QPIUhZxtwOJSyHhybyHH6L9ZmgDHw-UQW0yS2jqQJGz12KQmNU" 
            alt="North Quay Cold Room C2 storage racks and insulated refrigeration door" 
            class="w-full aspect-[4/3] object-cover rounded-2px border border-[#D5D5D5]"
          >
        </div>

        <!-- Metric & Details -->
        <div class="flex-1 flex flex-col justify-between self-stretch">
          <div>
            <div class="text-sm text-[#626262] mb-1">Assigned facility &amp; room</div>
            <div class="text-[20px] font-semibold text-[#202020] mb-4">North Quay · Cold Room C2</div>

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 pt-2 pb-4 border-t border-b border-[#D5D5D5]">
              <div>
                <div class="text-sm text-[#626262] mb-1">Latest returned reading</div>
                <div class="text-[28px] font-semibold text-[#202020] font-mono-numbers leading-none">
                  4.4°C
                </div>
                <div class="text-sm text-[#626262] mt-1 font-mono-numbers">Permitted 2–8°C</div>
              </div>

              <div>
                <div class="text-sm text-[#626262] mb-1">Condition flag</div>
                <div class="flex items-center space-x-2 mt-1">
                  <span class="w-2.5 h-2.5 rounded-full bg-[#24704B] inline-block"></span>
                  <span class="text-base font-medium text-[#24704B]">good</span>
                </div>
                <div class="text-sm text-[#626262] mt-1">Steady within range</div>
              </div>

              <div>
                <div class="text-sm text-[#626262] mb-1">Reading timestamp</div>
                <div class="text-base font-normal text-[#202020] font-mono-numbers mt-1">
                  14 May 2026 08:19
                </div>
                <div class="text-sm text-[#626262] mt-1">North Quay datalogger</div>
              </div>
            </div>
          </div>

          <div class="pt-4 flex items-center justify-between">
            <div class="text-sm text-[#626262]">
              Storage profile: <span class="text-[#202020] font-mono-numbers">profile v3 (permitted 2–8°C)</span> · Rack 4
            </div>
          </div>
        </div>

      </div>
    </section>

    <!-- Cold rooms list table: single list row with location, alert, last reading time; row opens Cold room detail -->
    <section class="bg-white border border-[#D5D5D5] rounded-2px overflow-hidden">
      <table class="w-full border-collapse text-left">
        <thead>
          <tr class="h-12 border-b border-[#D5D5D5] bg-white text-sm text-[#626262] font-normal">
            <th class="px-6 font-normal">Location</th>
            <th class="px-6 font-normal">Alert</th>
            <th class="px-6 font-normal">Last reading time</th>
            <th class="px-6 font-normal text-right">Action</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-[#D5D5D5]">
          <!-- Single specified row for North Quay Cold Room C2 -->
          <tr class="h-12 hover:bg-[#F7F7F7] transition-colors">
            <td class="px-6 text-base text-[#202020] font-medium">
              North Quay Cold Room C2
            </td>
            <td class="px-6 text-base">
              <span class="inline-flex items-center space-x-2">
                <span class="w-2 h-2 rounded-full bg-[#24704B]"></span>
                <span class="text-[#24704B] font-medium">good</span>
              </span>
            </td>
            <td class="px-6 text-base text-[#202020] font-mono-numbers">
              14 May 2026 08:19
            </td>
            <td class="px-6 text-right">
              <a href="#" class="btn-secondary">
                Cold room detail
              </a>
            </td>
          </tr>
        </tbody>
      </table>
    </section>

    <!-- Generous whitespace preserved under the short list, no invented rooms -->

  </main>

</body>
</html>