  </header>

  <!-- Main Content -->
  <main class="container entrance-anim">
    <!-- Page Heading -->
    <div class="page-title-row">
      <h1>Accounts</h1>
      <a href="#" class="btn btn-primary">Account detail</a>
    </div>

    <!-- Search & Filters Toolbar -->
    <div class="panel controls-panel">
      <div class="filters-group">
