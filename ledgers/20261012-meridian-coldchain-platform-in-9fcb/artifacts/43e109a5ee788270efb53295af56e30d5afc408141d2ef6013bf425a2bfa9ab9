                <span>good active</span>
              </span>
            </td>
            <td style="text-align: right;">
              <a href="#" class="btn btn-secondary btn-table-action">Account detail</a>
            </td>
          </tr>
          <tr>
            <td>
              <div class="name-col">
                <span class="initials-badge">TM</span>
                <span style="font-weight: 500;">Tariq Mansour</span>
              </div>
            </td>
            <td>Driver</td>
            <td>North Quay · VAN-27 (MTR-482)</td>
            <td class="font-mono text-sm">tariq.mansour@meridian.example</td>
            <td>
              <span class="status-badge status-good">
                <span class="status-dot"></span>
                <span>good active</span>
              </span>
            </td>
            <td style="text-align: right;">
              <a href="#" class="btn btn-secondary btn-table-action">Account detail</a>
            </td>
          </tr>
          <tr>
            <td>
              <div class="name-col">
                <span class="initials-badge">HY</span>
                <span style="font-weight: 500;">Hana Youssef</span>
              </div>
            </td>
            <td>Cedar Health buyer</td>
            <td>Cedar Clinic, 42 River Road</td>
            <td class="font-mono text-sm">hana.youssef@cedarhealth.example</td>
            <td>
              <span class="status-badge status-good">
                <span class="status-dot"></span>
                <span>good active</span>
              </span>
            </td>
            <td style="text-align: right;">
              <a href="#" class="btn btn-secondary btn-table-action">Account detail</a>
            </td>
          </tr>
