            <th style="width: 220px;">Role</th>
            <th style="width: 260px;">Facility & Location Scope</th>
            <th style="width: 240px;">Identifier</th>
            <th style="width: 160px;">Status</th>
            <th style="width: 140px; text-align: right;">Action</th>
          </tr>
        </thead>
        <tbody>
