<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Routes — Empty State</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@600;650;700&family=IBM+Plex+Mono:wght@400;500;600&family=Public+Sans:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    /* Reset & Base Tokens */
    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      background-color: #F7F7F7;
      color: #202020;
      font-family: 'Public Sans', sans-serif;
      font-size: 16px;
      line-height: 1.5;
      -webkit-font-smoothing: antialiased;
      min-height: 100vh;
    }

    .font-mono {
      font-family: 'IBM Plex Mono', monospace;
    }

    .font-heading {
      font-family: 'Hanken Grotesk', sans-serif;
    }

    /* Motion Tokens & Keyframes */
    @keyframes pageEntrance {
      from {
        opacity: 0;
        transform: translateY(6px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes savedHandoff {
      0% {
        opacity: 0.6;
        transform: translateY(8px);
      }
      100% {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes syncBreathe {
      0%, 100% {
        opacity: 0.7;
      }
      50% {
        opacity: 1;
      }
    }

    .animate-entrance {
      animation: pageEntrance 260ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    .status-handoff {
      animation: savedHandoff 260ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    .status-waiting-breathe {
      animation: syncBreathe 6s ease-in-out infinite;
    }

    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
      }
    }

    /* Interactive States */
    a, button, select, input {
      transition: background-color 150ms ease, border-color 150ms ease, color 150ms ease;
    }

    a:focus-visible, button:focus-visible, select:focus-visible, input:focus-visible {
      outline: 2px solid #A94B1D;
      outline-offset: 2px;
    }

    /* Exact Header */
    .header {
      background-color: #FFFFFF;
      border-bottom: 1px solid #D5D5D5;
      height: 64px;
      padding: 0 32px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .header-left {
      display: flex;
      align-items: center;
      gap: 32px;
    }

    .brand-mark {
      display: flex;
      align-items: center;
      gap: 12px;
      text-decoration: none;
      color: #202020;
    }

    .brand-m {
      width: 28px;
      height: 28px;
      background-color: #202020;
      color: #FFFFFF;
      border-radius: 2px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: 'Hanken Grotesk', sans-serif;
      font-weight: 700;
      font-size: 15px;
      line-height: 1;
    }

    .brand-title {
      font-family: 'Hanken Grotesk', sans-serif;
      font-size: 18px;
      font-weight: 650;
      letter-spacing: -0.01em;
    }

    .header-nav {
      display: flex;
      align-items: center;
      gap: 24px;
      height: 64px;
    }

    .nav-item {
      text-decoration: none;
      color: #626262;
      font-weight: 500;
      font-size: 16px;
      height: 100%;
      display: flex;
      align-items: center;
      position: relative;
      padding: 0 4px;
    }

    .nav-item:hover {
      color: #202020;
    }

    .nav-item.active {
      color: #A94B1D;
      font-weight: 600;
    }

    .nav-item.active::after {
      content: '';
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      height: 2px;
      background-color: #A94B1D;
    }

    .header-right {
      display: flex;
      align-items: center;
      gap: 24px;
    }

    .user-profile {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .initials-avatar {
      width: 32px;
      height: 32px;
      background-color: #F7F7F7;
      border: 1px solid #D5D5D5;
      border-radius: 2px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: 'Public Sans', sans-serif;
      font-size: 13px;
      font-weight: 600;
      color: #202020;
    }

    .user-name-role {
      font-size: 14px;
      color: #202020;
    }

    .user-name-role span {
      color: #626262;
    }

    .lang-switcher {
      font-size: 14px;
      color: #626262;
      border-left: 1px solid #D5D5D5;
      padding-left: 20px;
    }

    /* Main Container */
    .main-content {
      max-width: 1376px;
      margin: 0 auto;
      padding: 32px;
    }

    .page-title {
      font-family: 'Hanken Grotesk', sans-serif;
      font-size: 28px;
      font-weight: 650;
      line-height: 1.2;
      color: #202020;
      margin-bottom: 32px;
    }

    /* Panels */
    .panel {
      background-color: #FFFFFF;
      border: 1px solid #D5D5D5;
      border-radius: 2px;
    }

    /* Filter Panel */
    .filter-panel {
      padding: 16px;
      margin-bottom: 32px;
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      gap: 16px;
    }

    .filter-group-container {
      display: flex;
      align-items: flex-end;
      gap: 16px;
      flex-wrap: wrap;
    }

    .filter-field {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .field-label {
      font-size: 14px;
      color: #626262;
      font-weight: 500;
    }

    .field-control {
      height: 48px;
      background-color: #FFFFFF;
      border: 1px solid #D5D5D5;
      border-radius: 2px;
      padding: 0 16px;
      font-size: 16px;
      color: #202020;
      min-width: 240px;
    }

    .field-control:hover {
      border-color: #626262;
    }

    /* Buttons */
    .btn {
      height: 48px;
      padding: 0 24px;
      font-size: 16px;
      font-weight: 600;
      border-radius: 2px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      text-decoration: none;
      white-space: nowrap;
      border: 1px solid transparent;
    }

    .btn:active {
      transform: translateY(1px);
    }

    .btn-primary {
      background-color: #A94B1D;
      color: #FFFFFF;
      border-color: #A94B1D;
    }

    .btn-primary:hover {
      background-color: #933F17;
      border-color: #933F17;
    }

    .btn-secondary {
      background-color: #FFFFFF;
      border-color: #D5D5D5;
      color: #202020;
    }

    .btn-secondary:hover {
      background-color: #F7F7F7;
      border-color: #626262;
    }

    .btn-export {
      display: inline-flex;
      align-items: center;
      gap: 8px;
    }

    /* Table & Empty State View */
    .table-container {
      overflow: hidden;
    }

    .data-table-header {
      display: grid;
      grid-template-columns: 140px 180px 140px 220px 240px 1fr 140px;
      align-items: center;
      height: 48px;
      padding: 0 16px;
      border-bottom: 1px solid #D5D5D5;
      font-size: 14px;
      font-weight: 600;
      color: #626262;
    }

    .empty-state-card {
      padding: 80px 16px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
    }

    .empty-icon-wrap {
      width: 48px;
      height: 48px;
      border: 1px solid #D5D5D5;
      border-radius: 2px;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 24px;
      color: #626262;
      background-color: #FFFFFF;
    }

    .empty-title {
      font-family: 'Hanken Grotesk', sans-serif;
      font-size: 20px;
      font-weight: 650;
      color: #202020;
      margin-bottom: 8px;
    }

    .empty-description {
      font-size: 16px;
      color: #626262;
      max-width: 520px;
      line-height: 1.5;
      margin-bottom: 24px;
    }

    .table-meta-footer {
      height: 48px;
      padding: 0 16px;
      border-top: 1px solid #D5D5D5;
      display: flex;
      align-items: center;
      justify-content: space-between;
      font-size: 14px;
      color: #626262;
      background-color: #FFFFFF;
    }
  </style>
</head>
<body class="animate-entrance">

  <!-- Header -->
  <header class="header">
    <div class="header-left">
      <a href="#" class="brand-mark">
        <div class="brand-m">M</div>
        <div class="brand-title">Meridian</div>
      </a>
      <nav class="header-nav">
        <a href="#" class="nav-item">Orders</a>
        <a href="#" class="nav-item active">Routes</a>
      </nav>
    </div>
    <div class="header-right">
      <div class="user-profile">
        <div class="initials-avatar">PN</div>
        <div class="user-name-role">Priya Nair · <span>Dispatcher</span></div>
      </div>
      <div class="lang-switcher">EN / العربية</div>
    </div>
  </header>

  <!-- Main Content -->
  <main class="main-content">
    <h1 class="page-title">Routes</h1>

    <!-- Filter Bar -->
    <div class="panel filter-panel">
      <div class="filter-group-container">
        <div class="filter-field">
          <label class="field-label" for="filter-date">Date</label>
          <select id="filter-date" class="field-control font-mono">
            <option>14 May 2026 (Today)</option>
            <option>13 May 2026</option>
            <option>12 May 2026</option>
          </select>
        </div>

        <div class="filter-field">
          <label class="field-label" for="filter-status">Status</label>
          <select id="filter-status" class="field-control">
            <option>All statuses</option>
            <option>Confirmed</option>
            <option>Delivered</option>
          </select>
        </div>

        <div class="filter-field">
          <label class="field-label" for="filter-search">Driver or route</label>
          <input id="filter-search" type="text" class="field-control" placeholder="Search driver, vehicle or reference">
        </div>
      </div>

      <div>
        <button type="button" class="btn btn-secondary btn-export">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="7 10 12 15 17 10"></polyline>
            <line x1="12" y1="15" x2="12" y2="3"></line>
          </svg>
          CSV export
        </button>
      </div>
    </div>

    <!-- Table Outline & Empty State -->
    <div class="panel table-container">
      <div class="data-table-header">
        <div>Date</div>
        <div>Route</div>
        <div>Driver</div>
        <div>Vehicle</div>
        <div>Planned stop</div>
        <div>Status</div>
        <div style="text-align: right;">Action</div>
      </div>

      <div class="empty-state-card">
        <div class="empty-icon-wrap">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
            <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
          </svg>
        </div>
        <h2 class="empty-title">No routes recorded</h2>
        <p class="empty-description">
          No dispatch routes have been registered for this schedule. Create the primary dispatch plan to allocate drivers and outbound deliveries.
        </p>
        <button type="button" class="btn btn-primary">
          Route plan
        </button>
      </div>

      <div class="table-meta-footer">
        <div>Assigned dispatcher: Priya Nair · North Quay</div>
        <div class="font-mono">0 records</div>
      </div>
    </div>
  </main>

</body>
</html>
