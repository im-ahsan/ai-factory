<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Boxes — Empty State</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@600;650;700&family=IBM+Plex+Mono:wght@400;500;600&family=Public+Sans:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      background-color: #F7F7F7;
      color: #202020;
      font-family: 'Public Sans', sans-serif;
      font-size: 16px;
      line-height: 1.5;
      -webkit-font-smoothing: antialiased;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    /* Typography tokens */
    h1, h2, h3, .font-heading {
      font-family: 'Hanken Grotesk', sans-serif;
    }

    .font-mono {
      font-family: 'IBM Plex Mono', monospace;
    }

    .text-quiet {
      color: #626262;
    }

    /* Motion Tokens */
    @keyframes entranceFadeIn {
      0% {
        opacity: 0;
        transform: translateY(6px);
      }
      100% {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes savedHandoff {
      0% {
        opacity: 0.6;
        transform: translateY(8px);
      }
      100% {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes waitingBreathe {
      0%, 100% {
        opacity: 0.7;
      }
      50% {
        opacity: 1;
      }
    }

    .animate-entrance {
      animation: entranceFadeIn 240ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    /* Header component */
    header {
      background: #FFFFFF;
      border-bottom: 1px solid #D5D5D5;
      height: 64px;
      padding: 0 32px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .header-left {
      display: flex;
      align-items: center;
      gap: 32px;
      height: 100%;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 10px;
      text-decoration: none;
      color: #202020;
    }

    .brand-mark {
      width: 24px;
      height: 24px;
      background: #202020;
      color: #FFFFFF;
      border-radius: 2px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: 'Hanken Grotesk', sans-serif;
      font-weight: 700;
      font-size: 14px;
      line-height: 1;
    }

    .brand-name {
      font-family: 'Hanken Grotesk', sans-serif;
      font-weight: 650;
      font-size: 18px;
      letter-spacing: -0.01em;
    }

    nav {
      display: flex;
      align-items: center;
      gap: 24px;
      height: 100%;
    }

    .nav-item {
      font-family: 'Public Sans', sans-serif;
      font-size: 15px;
      font-weight: 500;
      color: #202020;
      text-decoration: none;
      height: 100%;
      display: flex;
      align-items: center;
      border-bottom: 2px solid transparent;
      padding: 0 4px;
      transition: color 150ms ease, border-color 150ms ease;
    }

    .nav-item:hover {
      color: #A94B1D;
    }

    .nav-item:focus-visible {
      outline: 2px solid #A94B1D;
      outline-offset: -2px;
    }

    .nav-item.active {
      color: #A94B1D;
      border-bottom-color: #A94B1D;
      font-weight: 600;
    }

    .header-right {
      display: flex;
      align-items: center;
      gap: 24px;
    }

    .operator-profile {
      display: flex;
      align-items: center;
      gap: 10px;
      font-size: 14px;
      color: #202020;
    }

    .initials-badge {
      width: 28px;
      height: 28px;
      background: #F7F7F7;
      border: 1px solid #D5D5D5;
      border-radius: 2px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: 'IBM Plex Mono', monospace;
      font-size: 12px;
      font-weight: 500;
      color: #202020;
    }

    .lang-switcher {
      font-size: 13px;
      color: #626262;
      border-left: 1px solid #D5D5D5;
      padding-left: 16px;
      font-family: 'Public Sans', sans-serif;
    }

    /* Main Container */
    main {
      max-width: 1360px;
      width: 100%;
      margin: 0 auto;
      padding: 32px;
      flex: 1;
    }

    .page-title-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 32px;
    }

    .page-title {
      font-size: 28px;
      font-weight: 650;
      line-height: 1.2;
      color: #202020;
      letter-spacing: -0.02em;
    }

    /* Buttons */
    .btn {
      height: 48px;
      padding: 0 20px;
      border-radius: 2px;
      font-family: 'Public Sans', sans-serif;
      font-size: 16px;
      font-weight: 600;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      text-decoration: none;
      cursor: pointer;
      transition: background-color 150ms ease, border-color 150ms ease, color 150ms ease, transform 90ms ease;
    }

    .btn:active {
      transform: scale(0.98);
    }

    .btn:focus-visible {
      outline: 2px solid #A94B1D;
      outline-offset: 2px;
    }

    .btn-primary {
      background-color: #A94B1D;
      color: #FFFFFF;
      border: 1px solid #A94B1D;
    }

    .btn-primary:hover {
      background-color: #933f17;
      border-color: #933f17;
    }

    .btn-secondary {
      background-color: #FFFFFF;
      color: #202020;
      border: 1px solid #D5D5D5;
    }

    .btn-secondary:hover {
      background-color: #F7F7F7;
      border-color: #626262;
    }

    /* Panels & Tables */
    .panel {
      background: #FFFFFF;
      border: 1px solid #D5D5D5;
      border-radius: 2px;
    }

    /* Filter Toolbar Panel */
    .filter-panel {
      padding: 16px;
      margin-bottom: 32px;
      display: flex;
      align-items: flex-end;
      gap: 16px;
    }

    .field-group {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    .field-label {
      font-size: 14px;
      font-weight: 500;
      color: #626262;
    }

    .form-control {
      height: 48px;
      background: #FFFFFF;
      border: 1px solid #D5D5D5;
      border-radius: 2px;
      padding: 0 16px;
      font-family: 'Public Sans', sans-serif;
      font-size: 15px;
      color: #202020;
      transition: border-color 150ms ease;
    }

    .form-control:focus {
      outline: none;
      border-color: #A94B1D;
    }

    select.form-control {
      appearance: none;
      background-image: url("data:image/svg+xml;charset=UTF-8,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%23202020' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3e%3cpolyline points='6 9 12 15 18 9'%3e%3c/polyline%3e%3c/svg%3e");
      background-repeat: no-repeat;
      background-position: right 14px center;
      background-size: 16px;
      padding-right: 40px;
      cursor: pointer;
    }

    .export-btn-wrap {
      margin-left: auto;
    }

    /* Table Container & Empty State */
    .table-container {
      overflow: hidden;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      text-align: left;
    }

    th {
      height: 48px;
      padding: 0 16px;
      background: #FFFFFF;
      font-size: 14px;
      font-weight: 600;
      color: #626262;
      border-bottom: 1px solid #D5D5D5;
      white-space: nowrap;
    }

    .empty-state-card {
      padding: 64px 32px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
    }

    .empty-icon-wrap {
      width: 48px;
      height: 48px;
      border: 1px solid #D5D5D5;
      border-radius: 2px;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 16px;
      background: #FFFFFF;
    }

    .empty-title {
      font-size: 20px;
      font-weight: 650;
      color: #202020;
      margin-bottom: 8px;
      letter-spacing: -0.01em;
    }

    .empty-message {
      font-size: 15px;
      color: #626262;
      max-width: 460px;
      margin-bottom: 24px;
      line-height: 1.5;
    }

    .table-footer-status {
      padding: 14px 16px;
      border-top: 1px solid #D5D5D5;
      background: #FFFFFF;
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 14px;
      color: #626262;
    }

    /* Accessibility */
    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
      }
    }
  </style>
</head>
<body>

  <!-- Top Navigation Header -->
  <header>
    <div class="header-left">
      <a href="#" class="brand">
        <span class="brand-mark">M</span>
        <span class="brand-name">Meridian</span>
      </a>
      <nav>
        <a href="#" class="nav-item">Receipts</a>
        <a href="#" class="nav-item">Stock</a>
        <a href="#" class="nav-item">Moves</a>
        <a href="#" class="nav-item active">Boxes</a>
        <a href="#" class="nav-item">Cold rooms</a>
      </nav>
    </div>

    <div class="header-right">
      <div class="operator-profile">
        <span class="initials-badge">LH</span>
        <span>Leila Haddad · Warehouse Operator</span>
      </div>
      <div class="lang-switcher">
        <span>EN / العربية</span>
      </div>
    </div>
  </header>

  <!-- Main View -->
  <main class="animate-entrance">
    
    <!-- Title and Primary Action Row -->
    <div class="page-title-row">
      <h1 class="page-title">Boxes</h1>
      <button class="btn btn-primary" type="button">Pack box</button>
    </div>

    <!-- Filter Toolbar -->
    <div class="panel filter-panel">
      <div class="field-group" style="flex: 2; min-width: 220px;">
        <label class="field-label" for="search-box">Search</label>
        <input 
          type="text" 
          id="search-box" 
          class="form-control" 
          placeholder="Search box, order, lot or logger"
          value=""
        >
      </div>

      <div class="field-group" style="flex: 1; min-width: 160px;">
        <label class="field-label" for="filter-status">Status</label>
        <select id="filter-status" class="form-control">
          <option value="all">All statuses</option>
          <option value="eligible">Eligible</option>
          <option value="on-hold">On Hold</option>
          <option value="recalled">Recalled</option>
        </select>
      </div>

      <div class="field-group" style="flex: 1; min-width: 160px;">
        <label class="field-label" for="filter-route">Route &amp; Order</label>
        <select id="filter-route" class="form-control">
          <option value="all">All routes</option>
          <option value="r-204">R-204 (O-299)</option>
        </select>
      </div>

      <div class="export-btn-wrap">
        <button class="btn btn-secondary" type="button">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 2px;">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="7 10 12 15 17 10"></polyline>
            <line x1="12" y1="15" x2="12" y2="3"></line>
          </svg>
          CSV export
        </button>
      </div>
    </div>

    <!-- Table with Empty State -->
    <div class="panel table-container">
      <table>
        <thead>
          <tr>
            <th style="width: 80px;">Photo</th>
            <th style="width: 110px;">Box</th>
            <th>Contents &amp; Lot</th>
            <th style="width: 140px;">Order &amp; Route</th>
            <th style="width: 120px;">Logger</th>
            <th style="width: 130px;">Sealing</th>
            <th style="width: 110px;">Status</th>
            <th style="width: 110px; text-align: right;">Action</th>
          </tr>
        </thead>
      </table>

      <!-- Empty State Content -->
      <div class="empty-state-card">
        <div class="empty-icon-wrap">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#626262" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="21 8 21 21 3 21 3 8"></polyline>
            <rect x="1" y="3" width="22" height="5" rx="1"></rect>
            <line x1="10" y1="12" x2="14" y2="12"></line>
          </svg>
        </div>
        <h2 class="empty-title">No boxes recorded</h2>
        <p class="empty-message">
          No shipper boxes have been packed for dispatch yet. Begin outbound fulfillment by packing the first box for route allocation.
        </p>
        <button class="btn btn-primary" type="button">Pack box</button>
      </div>

      <!-- Table Footer Meta -->
      <div class="table-footer-status">
        <span>Assigned warehouse: North Quay</span>
        <span class="font-mono">0 records</span>
      </div>
    </div>

  </main>

</body>
</html>
