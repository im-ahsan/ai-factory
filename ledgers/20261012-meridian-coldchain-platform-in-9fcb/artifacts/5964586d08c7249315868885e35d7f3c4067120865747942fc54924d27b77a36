<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Change order</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@600;650&family=IBM+Plex+Mono:wght@400;500;600&family=Public+Sans:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    /* Reset & Base */
    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }
    body {
      background-color: #F7F7F7;
      color: #202020;
      font-family: 'Public Sans', sans-serif;
      font-size: 16px;
      line-height: 1.5;
      -webkit-font-smoothing: antialiased;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    /* Typography */
    h1, .h1 {
      font-family: 'Hanken Grotesk', sans-serif;
      font-size: 28px;
      font-weight: 650;
      line-height: 1.25;
      color: #202020;
    }
    h2, .h2 {
      font-family: 'Hanken Grotesk', sans-serif;
      font-size: 20px;
      font-weight: 650;
      line-height: 1.3;
      color: #202020;
    }
    h3, .h3 {
      font-family: 'Public Sans', sans-serif;
      font-size: 16px;
      font-weight: 600;
      line-height: 1.4;
      color: #202020;
    }
    .mono {
      font-family: 'IBM Plex Mono', monospace;
    }
    .text-quiet {
      color: #626262;
    }
    .text-sm {
      font-size: 14px;
      line-height: 1.4;
    }

    /* Status colors */
    .status-good {
      color: #24704B;
      font-weight: 500;
    }
    .status-waiting {
      color: #805800;
      font-weight: 500;
    }
    .status-refused {
      color: #AE2C2C;
      font-weight: 500;
    }
    .dot {
      display: inline-block;
      width: 8px;
      height: 8px;
      border-radius: 50%;
      margin-right: 6px;
      vertical-align: middle;
    }
    .dot-good { background-color: #24704B; }
    .dot-waiting { background-color: #805800; }
    .dot-refused { background-color: #AE2C2C; }

    /* Layout & Containers */
    .header-bar {
      background-color: #FFFFFF;
      border-bottom: 1px solid #D5D5D5;
      height: 64px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 32px;
      position: sticky;
      top: 0;
      z-index: 50;
    }
    .header-left {
      display: flex;
      align-items: center;
      gap: 32px;
    }
    .brand-mark {
      display: flex;
      align-items: center;
      gap: 12px;
      text-decoration: none;
      color: #202020;
    }
    .logo-square {
      width: 28px;
      height: 28px;
      background-color: #202020;
      color: #FFFFFF;
      font-family: 'Hanken Grotesk', sans-serif;
      font-weight: 650;
      font-size: 16px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 2px;
    }
    .brand-name {
      font-family: 'Hanken Grotesk', sans-serif;
      font-weight: 650;
      font-size: 18px;
      letter-spacing: -0.01em;
    }
    .nav-menu {
      display: flex;
      align-items: center;
      gap: 24px;
      list-style: none;
    }
    .nav-link {
      text-decoration: none;
      color: #202020;
      font-size: 16px;
      font-weight: 500;
      padding: 20px 0;
      position: relative;
      transition: color 150ms ease;
    }
    .nav-link:hover {
      color: #A94B1D;
    }
    .nav-link.active {
      color: #A94B1D;
      font-weight: 600;
    }
    .nav-link.active::after {
      content: '';
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      height: 2px;
      background-color: #A94B1D;
    }
    .header-right {
      display: flex;
      align-items: center;
      gap: 24px;
    }
    .user-info {
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .user-badge {
      width: 32px;
      height: 32px;
      background-color: #F7F7F7;
      border: 1px solid #D5D5D5;
      border-radius: 2px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 13px;
      font-weight: 600;
      color: #202020;
    }
    .lang-switch {
      color: #626262;
      font-size: 14px;
    }

    /* Main Container */
    .page-main {
      max-width: 1040px;
      width: 100%;
      margin: 0 auto;
      padding: 32px 24px 64px 24px;
      display: flex;
      flex-direction: column;
      gap: 32px;
    }

    .page-header {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 16px;
    }
    .page-header-text {
      display: flex;
      flex-direction: column;
      gap: 4px;
    }

    /* Panels */
    .panel {
      background-color: #FFFFFF;
      border: 1px solid #D5D5D5;
      border-radius: 2px;
      padding: 24px;
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    /* Grids & Form Controls */
    .grid-2 {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px;
    }
    .form-group {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }
    .form-label {
      font-size: 14px;
      font-weight: 600;
      color: #202020;
    }
    .input-field, .select-field {
      width: 100%;
      height: 48px;
      background-color: #FFFFFF;
      border: 1px solid #D5D5D5;
      border-radius: 2px;
      padding: 0 16px;
      font-family: 'Public Sans', sans-serif;
      font-size: 16px;
      color: #202020;
      outline: none;
      transition: border-color 150ms ease, box-shadow 150ms ease;
    }
    .input-field.mono, .select-field.mono {
      font-family: 'IBM Plex Mono', monospace;
    }
    .input-field:focus, .select-field:focus {
      border-color: #A94B1D;
      box-shadow: 0 0 0 1px #A94B1D;
    }
    .input-field:hover, .select-field:hover {
      border-color: #202020;
    }
    .input-field:disabled, .select-field:disabled {
      background-color: #F7F7F7;
      color: #626262;
      border-color: #D5D5D5;
      cursor: not-allowed;
    }

    /* Product Section */
    .product-row {
      display: flex;
      gap: 24px;
      align-items: flex-start;
    }
    .product-img {
      width: 160px;
      height: 120px;
      aspect-ratio: 4 / 3;
      object-fit: cover;
      border-radius: 2px;
      border: 1px solid #D5D5D5;
      flex-shrink: 0;
    }
    .product-details {
      display: flex;
      flex-direction: column;
      gap: 6px;
      flex-grow: 1;
    }
    .spec-line {
      display: flex;
      flex-wrap: wrap;
      gap: 16px;
      font-size: 14px;
      color: #626262;
    }

    /* Tables */
    .data-table {
      width: 100%;
      border-collapse: collapse;
      text-align: left;
    }
    .data-table th {
      font-size: 14px;
      font-weight: 600;
      color: #626262;
      border-bottom: 1px solid #D5D5D5;
      padding: 12px 16px;
      height: 48px;
    }
    .data-table td {
      border-bottom: 1px solid #D5D5D5;
      padding: 12px 16px;
      height: 48px;
      vertical-align: middle;
      font-size: 16px;
    }
    .data-table tr:last-child td {
      border-bottom: none;
    }

    /* Radio Group */
    .radio-group {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }
    .radio-label {
      display: flex;
      align-items: flex-start;
      gap: 12px;
      cursor: pointer;
      font-size: 16px;
    }
    .radio-input {
      appearance: none;
      width: 18px;
      height: 18px;
      border: 1px solid #D5D5D5;
      border-radius: 50%;
      outline: none;
      margin-top: 3px;
      display: grid;
      place-content: center;
      cursor: pointer;
      background-color: #FFFFFF;
      transition: border-color 150ms ease;
    }
    .radio-input:hover {
      border-color: #202020;
    }
    .radio-input:checked {
      border-color: #A94B1D;
    }
    .radio-input:checked::before {
      content: "";
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background-color: #A94B1D;
    }
    .radio-input:focus {
      box-shadow: 0 0 0 1px #A94B1D;
    }

    /* Buttons */
    .btn-primary {
      height: 48px;
      background-color: #A94B1D;
      color: #FFFFFF;
      border: none;
      border-radius: 2px;
      padding: 0 24px;
      font-family: 'Public Sans', sans-serif;
      font-size: 16px;
      font-weight: 600;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      transition: background-color 150ms ease, transform 90ms ease, box-shadow 150ms ease;
    }
    .btn-primary:hover {
      background-color: #933f17;
    }
    .btn-primary:active {
      transform: scale(0.98);
    }
    .btn-primary:focus {
      outline: none;
      box-shadow: 0 0 0 2px #FFFFFF, 0 0 0 4px #A94B1D;
    }
    .btn-primary:disabled {
      background-color: #D5D5D5;
      color: #626262;
      cursor: not-allowed;
      transform: none;
    }

    .btn-secondary {
      height: 48px;
      background-color: #FFFFFF;
      color: #202020;
      border: 1px solid #D5D5D5;
      border-radius: 2px;
      padding: 0 24px;
      font-family: 'Public Sans', sans-serif;
      font-size: 16px;
      font-weight: 500;
      cursor: pointer;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      transition: background-color 150ms ease, border-color 150ms ease, transform 90ms ease;
    }
    .btn-secondary:hover {
      border-color: #202020;
      background-color: #F7F7F7;
    }
    .btn-secondary:active {
      transform: scale(0.98);
    }
    .btn-secondary:focus {
      outline: none;
      border-color: #A94B1D;
      box-shadow: 0 0 0 1px #A94B1D;
    }

    /* Motion Tokens & Keyframes */
    @keyframes pageEntrance {
      from {
        opacity: 0;
        transform: translateY(6px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
    .animate-entrance {
      animation: pageEntrance 280ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    @keyframes savedHandoff {
      from {
        opacity: 0.6;
        transform: translateY(8px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
    .saved-handoff {
      animation: savedHandoff 260ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    @keyframes breathSync {
      0%, 100% { opacity: 0.7; }
      50% { opacity: 1; }
    }
    .sync-breathing {
      animation: breathSync 6s ease-in-out infinite;
    }

    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
      }
    }

    /* Feedback notice */
    .notice-box {
      border: 1px solid #D5D5D5;
      background-color: #FFFFFF;
      padding: 16px;
      border-radius: 2px;
      display: flex;
      flex-direction: column;
      gap: 6px;
    }
    .notice-box.refused {
      border-color: #AE2C2C;
    }
    .notice-box.waiting {
      border-color: #805800;
    }
  </style>
</head>
<body>

  <!-- Top Header Navigation -->
  <header class="header-bar">
    <div class="header-left">
      <a href="#" class="brand-mark">
        <div class="logo-square">M</div>
        <span class="brand-name">Meridian</span>
      </a>
      <nav>
        <ul class="nav-menu">
          <li><a href="#" class="nav-link active">Orders</a></li>
          <li><a href="#" class="nav-link">Deliveries</a></li>
          <li><a href="#" class="nav-link">Recall notices</a></li>
          <li><a href="#" class="nav-link">Account</a></li>
        </ul>
      </nav>
    </div>
    <div class="header-right">
      <div class="user-info">
        <div class="user-badge">HY</div>
        <span style="font-size: 15px; font-weight: 500;">Hana Youssef · Cedar Health</span>
      </div>
      <div class="lang-switch">EN / العربية</div>
    </div>
  </header>

  <!-- Page Body -->
  <main class="page-main animate-entrance">
    
    <!-- Top Action Bar -->
    <div class="page-header">
      <div class="page-header-text">
        <h1>Change order</h1>
        <p class="text-quiet text-sm">
          Prototype date: <span class="mono">14 May 2026</span> · Europe/London (BST)
        </p>
      </div>
      <a href="#" class="btn-secondary">Order detail</a>
    </div>

    <!-- Order O-301 Status Summary Panel -->
    <section class="panel">
      <div style="display: flex; justify-content: space-between; align-items: baseline; border-bottom: 1px solid #D5D5D5; padding-bottom: 12px;">
        <div style="display: flex; align-items: baseline; gap: 12px;">
          <h2 class="mono">O-301</h2>
          <span class="status-waiting"><span class="dot dot-waiting"></span>not packed</span>
        </div>
        <div style="display: flex; gap: 20px; font-size: 15px;">
          <span>Ordered: <strong class="mono">30</strong> packs</span>
          <span>Allocated: <strong class="mono">20</strong> packs</span>
          <span>Outstanding: <strong class="mono" style="color: #805800;">10</strong> packs</span>
        </div>
      </div>

      <!-- Real Product Details & Image -->
      <div class="product-row">
        <img src="https://lh3.googleusercontent.com/aida/AEtjO1WgSPshUkFcZmvnxOy3H7uPFO7vnua31jEAabBdx4WfRYInoVBclaBYzr6EOTkCWFqGsJS1uhjgOZkjwXnc6tXok5_V7hnJD71fMFpVOQvB0xDilugRi-So3x2iuqG8mhzrhcPOXs_uaNz4_YRLSzRonyj7WTjf5nSvwTo_MrbJYO2Vuwzuzgh5Zyao9k4Tvi2zu6Rzpy9-qzR1Cr9NTtD1_aXoZOH7xfrp2HTEKJUlFP5vifyhiJqQhA" alt="Insulin Glargine 100 units/mL packaging" class="product-img">
        <div class="product-details">
          <div style="display: flex; justify-content: space-between; align-items: baseline;">
            <h3>Insulin Glargine 100 units/mL</h3>
            <span class="status-good"><span class="dot dot-good"></span>good</span>
          </div>
          <p class="text-quiet text-sm">Pack of 10 pens · Profile v3 permitted 2.0°C–8.0°C · First upper tier >8.0°C–10.0°C (30 min allowance)</p>
          <div class="spec-line" style="margin-top: 8px;">
            <span>Lot: <strong class="mono">IG-2511</strong></span>
            <span>Expiry: <span class="mono">31 March 2027</span></span>
            <span>Minimum shelf life: <span class="mono">90 days</span></span>
            <span>Depot: North Quay Cold Room C2, Rack 4</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Order Modification Form Panel -->
    <form class="panel" onsubmit="event.preventDefault();">
      <h2>Order specification</h2>

      <!-- Quantity & Product Selection -->
      <div class="grid-2">
        <div class="form-group">
          <label class="form-label" for="productLine">Product line</label>
          <select id="productLine" class="select-field">
            <option selected>Insulin Glargine 100 units/mL (pack of 10 pens)</option>
          </select>
        </div>
        <div class="form-group">
          <label class="form-label" for="packQuantity">Ordered pack quantity</label>
          <input type="number" id="packQuantity" class="input-field mono" value="30" min="1" max="100">
        </div>
      </div>

      <!-- Address & Eligible Date -->
      <div class="grid-2">
        <div class="form-group">
          <label class="form-label" for="deliveryAddress">Saved destination address</label>
          <select id="deliveryAddress" class="select-field">
            <option selected>Cedar Clinic, 42 River Road, London</option>
            <option>Cedar Day Unit, 18 Elm Street, London</option>
          </select>
        </div>
        <div class="form-group">
          <label class="form-label" for="eligibleDate">Eligible delivery date</label>
          <input type="date" id="eligibleDate" class="input-field mono" value="2026-05-14">
        </div>
      </div>

      <!-- Delivery Fulfillment Preference -->
      <div class="form-group" style="padding-top: 8px;">
        <label class="form-label">Delivery preference</label>
        <div class="radio-group">
          <label class="radio-label">
            <input type="radio" name="fulfillmentPreference" class="radio-input" value="available" checked>
            <div>
              <strong>Dispatch available quantity immediately (split delivery)</strong>
              <div class="text-quiet text-sm">Dispatch 20 allocated packs immediately via route R-204; remaining 10 outstanding packs dispatch upon subsequent release.</div>
            </div>
          </label>
          <label class="radio-label">
            <input type="radio" name="fulfillmentPreference" class="radio-input" value="complete">
            <div>
              <strong>Wait for complete fulfillment (single consignment)</strong>
              <div class="text-quiet text-sm">Hold route dispatch until all 30 packs are allocated and verified from North Quay Cold Room C2.</div>
            </div>
          </label>
        </div>
      </div>

      <!-- Primary Action -->
      <div style="padding-top: 8px; border-top: 1px solid #D5D5D5; display: flex; justify-content: flex-start;">
        <button type="submit" class="btn-primary">Save changes</button>
      </div>
    </form>

    <!-- Returned Allocations & Errors Section -->
    <section class="panel">
      <h2>Returned allocations & stock balance</h2>

      <table class="data-table">
        <thead>
          <tr>
            <th>Handling unit</th>
            <th>Lot number</th>
            <th>Warehouse stock</th>
            <th>Allocation to O-301</th>
            <th>Returned status</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td class="mono">HU-81</td>
            <td class="mono">IG-2511</td>
            <td><span class="mono">60</span> available / <span class="mono">40</span> allocated</td>
            <td class="mono">20 packs allocated</td>
            <td><span class="status-good"><span class="dot dot-good"></span>good</span></td>
          </tr>
          <tr>
            <td class="mono">HU-82</td>
            <td class="mono">IG-2511</td>
            <td><span class="mono">10</span> quarantined, <span class="mono">5</span> On Hold, <span class="mono">2</span> Rejected, <span class="mono">3</span> Expired</td>
            <td class="mono">0 packs (10 outstanding)</td>
            <td><span class="status-waiting"><span class="dot dot-waiting"></span>waiting</span></td>
          </tr>
        </tbody>
      </table>

      <!-- Returned Allocation Notice & Error Details -->
      <div class="notice-box waiting saved-handoff">
        <div style="display: flex; justify-content: space-between; align-items: center;">
          <span class="status-waiting">
            <span class="dot dot-waiting sync-breathing"></span>Partial allocation returned: 10 packs outstanding
          </span>
          <span class="mono text-sm text-quiet">Case Q-88</span>
        </div>
        <p class="text-sm text-quiet">
          North Quay handling unit HU-82 recorded 9.1°C excursion for 22 minutes (Quality Case Q-88 under review). 10 packs remain in quarantine pending quality officer authorization. Fulfillment will resume automatically once released.
        </p>
      </div>
    </section>

  </main>

</body>
</html>
