<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Reports — Empty State</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@600;650&family=IBM+Plex+Mono:wght@400;500;600&family=Public+Sans:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    /* Reset & Base Tokens */
    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      background-color: #F7F7F7;
      color: #202020;
      font-family: 'Public Sans', sans-serif;
      font-size: 16px;
      line-height: 1.5;
      -webkit-font-smoothing: antialiased;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    /* Typography Classes */
    h1, .h1 {
      font-family: 'Hanken Grotesk', sans-serif;
      font-size: 28px;
      font-weight: 650;
      line-height: 1.25;
      color: #202020;
    }

    h2, .h2 {
      font-family: 'Hanken Grotesk', sans-serif;
      font-size: 20px;
      font-weight: 650;
      line-height: 1.3;
      color: #202020;
    }

    h3, .h3 {
      font-family: 'Hanken Grotesk', sans-serif;
      font-size: 16px;
      font-weight: 600;
      line-height: 1.4;
      color: #202020;
    }

    .mono {
      font-family: 'IBM Plex Mono', monospace;
    }

    .text-quiet {
      color: #626262;
    }

    /* Motion Tokens & Keyframes */
    @keyframes pageEntrance {
      from {
        opacity: 0;
        transform: translateY(6px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes savedHandoff {
      0% {
        opacity: 0.6;
        transform: translateY(8px);
      }
      100% {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes waitingBreathe {
      0%, 100% {
        opacity: 0.7;
      }
      50% {
        opacity: 1;
      }
    }

    .animate-entrance {
      animation: pageEntrance 280ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
        scroll-behavior: auto !important;
      }
    }

    /* Global Header */
    header {
      background-color: #FFFFFF;
      border-bottom: 1px solid #D5D5D5;
      height: 64px;
      padding: 0 32px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      position: sticky;
      top: 0;
      z-index: 50;
    }

    .header-left {
      display: flex;
      align-items: center;
      gap: 32px;
    }

    .brand-mark {
      display: flex;
      align-items: center;
      gap: 12px;
      text-decoration: none;
      color: #202020;
    }

    .logo-m {
      width: 24px;
      height: 24px;
      background-color: #202020;
      border-radius: 2px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #FFFFFF;
      font-family: 'Hanken Grotesk', sans-serif;
      font-weight: 650;
      font-size: 14px;
      line-height: 1;
    }

    .brand-name {
      font-family: 'Hanken Grotesk', sans-serif;
      font-weight: 650;
      font-size: 18px;
      letter-spacing: -0.01em;
    }

    nav {
      display: flex;
      align-items: center;
      gap: 8px;
      height: 64px;
    }

    .nav-link {
      display: inline-flex;
      align-items: center;
      height: 64px;
      padding: 0 16px;
      color: #626262;
      text-decoration: none;
      font-size: 15px;
      font-weight: 500;
      border-bottom: 2px solid transparent;
      transition: color 150ms ease, border-color 150ms ease;
    }

    .nav-link:hover {
      color: #202020;
    }

    .nav-link:focus-visible {
      outline: none;
      border-bottom-color: #A94B1D;
      color: #A94B1D;
    }

    .nav-link.active {
      color: #A94B1D;
      border-bottom-color: #A94B1D;
      font-weight: 600;
    }

    .header-right {
      display: flex;
      align-items: center;
      gap: 24px;
    }

    .user-profile {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .initials-badge {
      width: 28px;
      height: 28px;
      border: 1px solid #D5D5D5;
      border-radius: 2px;
      background-color: #FFFFFF;
      color: #202020;
      font-family: 'IBM Plex Mono', monospace;
      font-size: 12px;
      font-weight: 500;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .user-name-role {
      font-size: 14px;
      color: #202020;
      font-weight: 500;
    }

    .lang-switch {
      font-size: 14px;
      color: #626262;
      border-left: 1px solid #D5D5D5;
      padding-left: 16px;
      user-select: none;
    }

    /* Main Layout */
    main {
      flex: 1;
      max-width: 1360px;
      width: 100%;
      margin: 0 auto;
      padding: 32px;
      display: flex;
      flex-direction: column;
      gap: 32px;
    }

    .page-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    /* Filter Controls Panel */
    .filter-panel {
      background-color: #FFFFFF;
      border: 1px solid #D5D5D5;
      border-radius: 2px;
      padding: 16px;
      display: grid;
      grid-template-columns: 280px 320px 1fr auto;
      align-items: flex-end;
      gap: 16px;
    }

    .form-group {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    .form-label {
      font-size: 14px;
      font-weight: 500;
      color: #626262;
    }

    .form-control {
      height: 48px;
      background-color: #FFFFFF;
      border: 1px solid #D5D5D5;
      border-radius: 2px;
      padding: 0 16px;
      font-family: 'Public Sans', sans-serif;
      font-size: 15px;
      color: #202020;
      width: 100%;
      appearance: none;
      background-image: url("data:image/svg+xml,%3Csvg width='12' height='8' viewBox='0 0 12 8' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M1 1.5L6 6.5L11 1.5' stroke='%23626262' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E");
      background-repeat: no-repeat;
      background-position: right 16px center;
      cursor: default;
    }

    .form-control:focus {
      outline: none;
      border-color: #A94B1D;
    }

    /* Buttons */
    .btn {
      height: 48px;
      padding: 0 20px;
      font-family: 'Public Sans', sans-serif;
      font-size: 15px;
      font-weight: 600;
      border-radius: 2px;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      text-decoration: none;
      transition: background-color 150ms ease, border-color 150ms ease, color 150ms ease, transform 90ms ease;
    }

    .btn:active {
      transform: scale(0.98);
    }

    .btn:focus-visible {
      outline: none;
      box-shadow: 0 0 0 2px #A94B1D;
    }

    .btn-secondary {
      background-color: #FFFFFF;
      border: 1px solid #D5D5D5;
      color: #202020;
    }

    .btn-secondary:hover {
      background-color: #F7F7F7;
      border-color: #C0C0C0;
    }

    .btn-primary {
      background-color: #A94B1D;
      border: 1px solid #A94B1D;
      color: #FFFFFF;
    }

    .btn-primary:hover {
      background-color: #933F17;
      border-color: #933F17;
    }

    /* Empty State Canvas Container */
    .empty-state-panel {
      background-color: #FFFFFF;
      border: 1px solid #D5D5D5;
      border-radius: 2px;
      min-height: 480px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: 48px 24px;
    }

    .empty-icon-wrap {
      width: 48px;
      height: 48px;
      border: 1px solid #D5D5D5;
      border-radius: 2px;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 24px;
      background-color: #FFFFFF;
    }

    .empty-icon-wrap svg {
      width: 20px;
      height: 20px;
      color: #626262;
    }

    .empty-title {
      font-family: 'Hanken Grotesk', sans-serif;
      font-size: 20px;
      font-weight: 650;
      color: #202020;
      margin-bottom: 8px;
    }

    .empty-message {
      font-size: 15px;
      color: #626262;
      max-width: 460px;
      line-height: 1.5;
      margin-bottom: 24px;
    }

    /* Status badge rule compliant */
    .status-text {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: 14px;
      font-weight: 500;
    }

    .dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      display: inline-block;
    }

    .status-good { color: #24704B; }
    .status-good .dot { background-color: #24704B; }
    .status-waiting { color: #805800; }
    .status-waiting .dot { background-color: #805800; }
    .status-failed { color: #AE2C2C; }
    .status-failed .dot { background-color: #AE2C2C; }

    /* Footer Metadata Bar */
    .table-footer-bar {
      border-top: 1px solid #D5D5D5;
      padding-top: 16px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 14px;
      color: #626262;
    }
  </style>
</head>
<body class="animate-entrance">

  <!-- Persistent Standard Header -->
  <header>
    <div class="header-left">
      <div class="brand-mark">
        <div class="logo-m">M</div>
        <span class="brand-name">Meridian</span>
      </div>
      <nav>
        <a href="#" class="nav-link">Audit trail</a>
        <a href="#" class="nav-link">Lot history</a>
        <a href="#" class="nav-link active">Reports</a>
      </nav>
    </div>
    <div class="header-right">
      <div class="user-profile">
        <div class="initials-badge">ER</div>
        <span class="user-name-role">Esha Raman · Auditor</span>
      </div>
      <div class="lang-switch">EN / العربية</div>
    </div>
  </header>

  <!-- Main Content Area -->
  <main>
    <div class="page-header">
      <h1>Reports</h1>
    </div>

    <!-- Immediately applied filters: 13–14 May / North Quay / Export displayed CSV -->
    <div class="filter-panel">
      <div class="form-group">
        <label class="form-label">Date range</label>
        <select class="form-control" aria-label="Date range">
          <option selected>13–14 May 2026</option>
          <option>14 May 2026 (Today)</option>
          <option>All dates</option>
        </select>
      </div>

      <div class="form-group">
        <label class="form-label">Facility scope</label>
        <select class="form-control" aria-label="Facility scope">
          <option selected>North Quay Warehouse</option>
          <option>All facilities</option>
        </select>
      </div>

      <div></div>

      <button type="button" class="btn btn-secondary">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M2.5 10.5V13C2.5 13.2761 2.72386 13.5 3 13.5H13C13.2761 13.5 13.5 13.2761 13.5 13V10.5M8 2.5V10.5M8 10.5L4.5 7M8 10.5L11.5 7" stroke="#202020" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        Export displayed CSV
      </button>
    </div>

    <!-- Empty State Panel -->
    <div class="empty-state-panel">
      <div class="empty-icon-wrap">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <rect x="4" y="3" width="16" height="18" rx="0"/>
          <line x1="8" y1="17" x2="8" y2="13"/>
          <line x1="12" y1="17" x2="12" y2="9"/>
          <line x1="16" y1="17" x2="16" y2="15"/>
        </svg>
      </div>

      <h2 class="empty-title">No reports recorded</h2>
      <p class="empty-message">
        No completed distribution cycles or settled assurance records have been finalized for this reporting window. Record receipt to initialize facility activity.
      </p>

      <!-- The one action that adds the first -->
      <button type="button" class="btn btn-primary">
        Record receipt
      </button>
    </div>

    <!-- Bottom Metadata Bar -->
    <div class="table-footer-bar">
      <div><span class="mono">0</span> records</div>
      <div>Prototype date: <span class="mono">14 May 2026</span> · Europe/London (BST)</div>
    </div>
  </main>

</body>
</html>
