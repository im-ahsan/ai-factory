<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Reports</title>
  <!-- Google Fonts: Hanken Grotesk, Public Sans, IBM Plex Mono -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@600;650;700&family=IBM+Plex+Mono:wght@400;500;600&family=Public+Sans:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    /* Design System exact colors and rules */
    :root {
      --bg: #F7F7F7;
      --surface: #FFFFFF;
      --text: #202020;
      --text-quiet: #626262;
      --border: #D5D5D5;
      --primary: #A94B1D;
      --status-good: #24704B;
      --status-waiting: #805800;
      --status-refused: #AE2C2C;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      background-color: var(--bg);
      color: var(--text);
      font-family: 'Public Sans', -apple-system, BlinkMacSystemFont, sans-serif;
      font-size: 16px;
      line-height: 1.5;
      -webkit-font-smoothing: antialiased;
      min-height: 100vh;
    }

    /* Typography */
    h1, h2, h3, .font-heading {
      font-family: 'Hanken Grotesk', sans-serif;
      color: var(--text);
    }
    .mono {
      font-family: 'IBM Plex Mono', monospace;
    }

    /* Motion specifications */
    @keyframes pageEntrance {
      from {
        opacity: 0;
        transform: translateY(6px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes waitingBreathe {
      0%, 100% { opacity: 0.7; }
      50% { opacity: 1; }
    }

    .animate-entrance {
      animation: pageEntrance 280ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    .dot-waiting-pulse {
      animation: waitingBreathe 6s ease-in-out infinite;
    }

    @media (prefers-reduced-motion: reduce) {
      .animate-entrance,
      .dot-waiting-pulse,
      * {
        animation: none !important;
        transition: none !important;
      }
    }

    /* Header component */
    header {
      background-color: var(--surface);
      border-bottom: 1px solid var(--border);
      height: 64px;
      padding: 0 32px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .header-left {
      display: flex;
      align-items: center;
      gap: 32px;
    }

    .brand-mark {
      display: flex;
      align-items: center;
      gap: 12px;
      text-decoration: none;
      color: var(--text);
    }

    .brand-box {
      width: 28px;
      height: 28px;
      background-color: #000000;
      color: #FFFFFF;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: 'Hanken Grotesk', sans-serif;
      font-weight: 700;
      font-size: 16px;
      border-radius: 2px;
    }

    .brand-name {
      font-family: 'Hanken Grotesk', sans-serif;
      font-size: 20px;
      font-weight: 650;
      color: var(--text);
      letter-spacing: -0.01em;
    }

    nav {
      display: flex;
      align-items: center;
      gap: 24px;
    }

    .nav-link {
      font-family: 'Public Sans', sans-serif;
      font-size: 16px;
      font-weight: 500;
      color: var(--text-quiet);
      text-decoration: none;
      padding: 20px 0;
      border-bottom: 2px solid transparent;
      transition: color 150ms ease, border-color 150ms ease;
    }

    .nav-link:hover {
      color: var(--text);
    }

    .nav-link.active {
      color: var(--text);
      font-weight: 600;
      border-bottom-color: var(--primary);
    }

    .header-right {
      display: flex;
      align-items: center;
      gap: 24px;
    }

    .auditor-profile {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .avatar-initials {
      width: 32px;
      height: 32px;
      background-color: #EAEAEA;
      color: var(--text);
      border: 1px solid var(--border);
      border-radius: 2px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: 'IBM Plex Mono', monospace;
      font-size: 14px;
      font-weight: 500;
    }

    .auditor-name {
      font-size: 15px;
      color: var(--text);
      font-weight: 500;
    }

    .lang-toggle {
      font-size: 14px;
      color: var(--text-quiet);
      font-weight: 500;
      padding-left: 16px;
      border-left: 1px solid var(--border);
    }

    /* Main Container */
    main {
      max-width: 1360px;
      margin: 0 auto;
      padding: 32px 32px 64px 32px;
    }

    .page-title {
      font-size: 28px;
      line-height: 1.25;
      font-weight: 650;
      letter-spacing: -0.02em;
      margin-bottom: 24px;
    }

    /* Panels & General layout */
    .panel {
      background-color: var(--surface);
      border: 1px solid var(--border);
      border-radius: 2px;
      margin-bottom: 32px;
    }

    .panel-padding {
      padding: 16px;
    }

    /* Filter Bar */
    .filter-bar {
      display: flex;
      align-items: flex-end;
      gap: 16px;
      flex-wrap: wrap;
    }

    .form-group {
      display: flex;
      flex-direction: column;
      gap: 8px;
      flex: 1;
      min-width: 220px;
    }

    .field-label {
      font-size: 14px;
      color: var(--text-quiet);
      font-weight: 500;
    }

    .field-readonly {
      height: 48px;
      background-color: var(--surface);
      border: 1px solid var(--border);
      border-radius: 2px;
      padding: 0 16px;
      display: flex;
      align-items: center;
      font-size: 15px;
      color: var(--text);
    }

    .field-readonly:focus-visible {
      outline: 2px solid var(--primary);
      outline-offset: 1px;
    }

    .btn-secondary {
      height: 48px;
      background-color: var(--surface);
      border: 1px solid var(--border);
      border-radius: 2px;
      padding: 0 20px;
      font-family: 'Public Sans', sans-serif;
      font-size: 15px;
      font-weight: 500;
      color: var(--text);
      display: inline-flex;
      align-items: center;
      gap: 8px;
      cursor: pointer;
      transition: background-color 120ms ease, border-color 120ms ease;
      white-space: nowrap;
    }

    .btn-secondary:hover {
      background-color: #FBFBFB;
      border-color: #BDBDBD;
    }

    .btn-secondary:focus-visible {
      outline: 2px solid var(--primary);
      outline-offset: 1px;
    }

    .btn-secondary:active {
      background-color: #F0F0F0;
      transform: scale(0.99);
    }

    /* Headline Metric Cards Grid */
    .metrics-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 16px;
      margin-bottom: 32px;
    }

    .metric-card {
      background-color: var(--surface);
      border: 1px solid var(--border);
      border-radius: 2px;
      padding: 16px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      min-height: 120px;
    }

    .metric-caption {
      font-size: 14px;
      color: var(--text-quiet);
      font-weight: 500;
    }

    .metric-main {
      font-size: 26px;
      font-weight: 650;
      font-family: 'Hanken Grotesk', sans-serif;
      color: var(--text);
      margin: 8px 0 4px 0;
      display: flex;
      align-items: baseline;
      gap: 8px;
    }

    .metric-sub {
      font-size: 14px;
      display: flex;
      align-items: center;
      gap: 6px;
    }

    /* Status Indicators */
    .status-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: 14px;
      font-weight: 500;
    }

    .status-badge.good {
      color: var(--status-good);
    }

    .status-badge.waiting {
      color: var(--status-waiting);
    }

    .status-badge.refused {
      color: var(--status-refused);
    }

    .status-dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      display: inline-block;
      flex-shrink: 0;
    }

    .status-dot.good {
      background-color: var(--status-good);
    }

    .status-dot.waiting {
      background-color: var(--status-waiting);
    }

    .status-dot.refused {
      background-color: var(--status-refused);
    }

    /* Section Panels */
    .section-header {
      padding: 16px 20px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      border-bottom: 1px solid var(--border);
      background-color: #FAFAFA;
    }

    .section-title {
      font-size: 20px;
      font-weight: 650;
      letter-spacing: -0.01em;
    }

    .section-meta {
      font-size: 14px;
      color: var(--text-quiet);
    }

    /* Dense Tables */
    .table-container {
      width: 100%;
      overflow-x: auto;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      text-align: left;
    }

    th {
      height: 48px;
      padding: 0 16px;
      font-size: 14px;
      font-weight: 600;
      color: var(--text-quiet);
      border-bottom: 1px solid var(--border);
      background-color: #FCFCFC;
      letter-spacing: 0.01em;
    }

    td {
      height: 48px;
      padding: 0 16px;
      font-size: 15px;
      color: var(--text);
      border-bottom: 1px solid var(--border);
      vertical-align: middle;
    }

    tr:last-child td {
      border-bottom: none;
    }

    tr:hover td {
      background-color: #FAFAFA;
    }

    .text-right {
      text-align: right;
    }

    .table-footer-summary {
      padding: 12px 20px;
      background-color: #FCFCFC;
      border-top: 1px solid var(--border);
      font-size: 14px;
      color: var(--text-quiet);
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    /* Two-column layout for narrower tables */
    .grid-2col {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 32px;
      margin-bottom: 32px;
    }

    @media (max-width: 1024px) {
      .metrics-grid {
        grid-template-columns: repeat(2, 1fr);
      }
      .grid-2col {
        grid-template-columns: 1fr;
      }
    }
  </style>
</head>
