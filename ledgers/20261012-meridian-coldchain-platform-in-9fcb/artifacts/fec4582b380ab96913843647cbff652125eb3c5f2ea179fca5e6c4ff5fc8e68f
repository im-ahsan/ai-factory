ched\": [\n    \"no repository: this is new build work\"\n   ],\n   \"span\": \"I-36\"\n  },\n  {\n   \"searched\": [\n    \"no repository: this is new build work\"\n   ],\n   \"span\": \"I-37\"\n  },\n  {\n   \"searched\": [\n    \"no repository: this is new build work\"\n   ],\n   \"span\": \"I-38\"\n  },\n  {\n   \"searched\": [\n    \"no repository: this is new build work\"\n   ],\n   \"span\": \"I-39\"\n  },\n  {\n   \"searched\": [\n    \"no repository: this is new build work\"\n   ],\n   \"span\": \"I-40\"\n  },\n  {\n   \"searched\": [\n    \"no repository: this is new build work\"\n   ],\n   \"span\": \"I-41\"\n  },\n  {\n   \"searched\": [\n    \"no repository: this is new build work\"\n   ],\n   \"span\": \"I-42\"\n  },\n  {\n   \"searched\": [\n    \"no repository: this is new build work\"\n   ],\n   \"span\": \"I-43\"\n  },\n  {\n   \"searched\": [\n    \"no repository: this is new build work\"\n   ],\n   \"span\": \"I-44\"\n  },\n  {\n   \"searched\": [\n    \"no repository: this is new build work\"\n   ],\n   \"span\": \"I-45\"\n  },\n  {\n   \"searched\": [\n    \"no repository: this is new build work\"\n   ],\n   \"span\": \"I-46\"\n  },\n  {\n   \"searched\": [\n    \"no repository: this is new build work\"\n   ],\n   \"span\": \"I-47\"\n  },\n  {\n   \"searched\": [\n    \"no repository: this is new build work\"\n   ],\n   \"span\": \"I-48\"\n  },\n  {\n   \"searched\": [\n    \"no repository: this is new build work\"\n   ],\n   \"span\": \"I-49\"\n  },\n  {\n   \"searched\": [\n    \"no repository: this is new build work\"\n   ],\n   \"span\": \"I-50\"\n  }\n ]\n}\n</artifact>\n\n<artifact id=\"spec\" kind=\"spec\" sha=\"\">\n{\n \"requirements\": [\n  {\n   \"id\": \"REQ-1\",\n   \"ears\": \"The Meridian responsive web app shall provide role-oriented portal pages and navigation for stock, orders, deliveries, temperature monitoring, quality decisions, and recalls on phone, tablet, and desktop browser widths.\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-1\",\n    \"I-2\",\n    \"I-3\",\n    \"I-4\",\n    \"I-15\",\n    \"ASM-13\"\n   ],\n   \"acceptance\": [\n    {\n     \"id\": \"AC-1.1\",\n     \"given\": \"A signed-in staff or customer user has portal access\",\n     \"when\": \"the user opens portal navigation\",\n     \"then\": \"the screen shows links to the modules permitted for that user, including applicable stock, order, delivery, temperature, quality, and recall pages\",\n     \"level\": \"ui\"\n    },\n    {\n     \"id\": \"AC-1.2\",\n     \"given\": \"A user opens an available workflow at phone, tablet, and desktop viewport widths\",\n     \"when\": \"the page is rendered\",\n     \"then\": \"the screen content has no horizontal overflow and phone controls have touch targets of at least 44 by 44 CSS pixels\",\n     \"level\": \"ui\"\n    }\n   ],\n   \"stability\": 0.6666666666666666\n  },\n  {\n   \"id\": \"REQ-2\",\n   \"ears\": \"The Meridian responsive web app shall provide staff sign-in through Meridian Microsoft accounts, customer sign-in using email and password followed by a one-time code, and customer password-reset requests by email.\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-2\",\n    \"I-3\",\n    \"I-7\",\n    \"ASM-23\"\n   ],\n   \"acceptance\": [\n    {\n     \"id\": \"AC-2.1\",\n     \"given\": \"A staff user opens staff sign-in\",\n     \"when\": \"the user selects the staff sign-in flow\",\n     \"then\": \"the screen shows the Meridian Microsoft sign-in option and no external staff-account form\",\n     \"level\": \"ui\"\n    },\n    {\n     \"id\": \"AC-2.2\",\n     \"given\": \"The API returns a one-time-code challenge after a customer submits email and password\",\n     \"when\": \"the customer submits the credentials\",\n     \"then\": \"the screen shows a code-entry field and does not show customer account content before a successful code response\",\n     \"level\": \"ui\"\n    },\n    {\n     \"id\": \"AC-2.3\",\n     \"given\": \"A customer user requests a password reset\",\n     \"when\": \"the reset request is submitted\",\n     \"then\": \"the request contains the customer email address and the screen shows the reset-link-by-email confirmation returned by the API\",\n     \"level\": \"ui\"\n    },\n    {\n     \"id\": \"AC-2.4\",\n     \"given\": \"A disabled or removed account attempts online sign-in or access\",\n     \"when\": \"the API returns an access-denied response\",\n     \"then\": \"the screen shows an access-denied message and no protected page or record is displayed\",\n     \"level\": \"ui\"\n    }\n   ],\n   \"stability\": 1\n  },\n  {\n   \"id\": \"REQ-3\",\n   \"ears\": \"When a user opens portal views, the Meridian responsive web app shall show records and actions returned for that user's role, assigned warehouses, and customer organisation, present Auditor views as read-only, and clear protected data when the API refuses access.\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-2\",\n    \"I-3\",\n    \"I-7\",\n    \"ASM-1\",\n    \"ASM-17\",\n    \"ASM-11\",\n    \"ASM-23\"\n   ],\n   \"acceptance\": [\n    {\n     \"id\": \"AC-3.1\",\n     \"given\": \"The API returns records for a staff member's assigned warehouses or a customer's organisation\",\n     \"when\": \"the user opens the corresponding list\",\n     \"then\": \"the screen shows only the returned records\",\n     \"level\": \"ui\"\n    },\n    {\n     \"id\": \"AC-3.2\",\n     \"given\": \"A Quality Manager or Auditor opens a warehouse-scoped list and the API returns all-warehouse records\",\n     \"when\": \"the list is displayed\",\n     \"then\": \"the screen shows the returned records from all warehouses\",\n     \"level\": \"ui\"\n    },\n    {\n     \"id\": \"AC-3.3\",\n     \"given\": \"An Auditor opens a record page\",\n     \"when\": \"the page renders\",\n     \"then\": \"the screen shows record details without create, edit, or delete controls, and an API-refused write is shown as an error message\",\n     \"level\": \"ui\"\n    },\n    {\n     \"id\": \"AC-3.4\",\n     \"given\": \"A protected request is refused because the account or record is inaccessible\",\n     \"when\": \"the web app receives the refusal\",\n     \"then\": \"the screen shows an access-ended or access-denied message and clears protected record fields\",\n     \"level\": \"ui\"\n    }\n   ],\n   \"stability\": 1\n  },\n  {\n   \"id\": \"REQ-4\",\n   \"ears\": \"The Meridian responsive web app shall let a Customer Administrator invite and remove users through controls scoped to that administrator's customer organisation.\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-3\",\n    \"I-7\"\n   ],\n   \"acceptance\": [\n    {\n     \"id\": \"AC-4.1\",\n     \"given\": \"A Customer Administrator opens user management for their organisation\",\n     \"when\": \"the administrator submits an invitation or removal\",\n     \"then\": \"the screen shows the invitation or removal status returned by the API\",\n     \"level\": \"ui\"\n    },\n    {\n     \"id\": \"AC-4.2\",\n     \"given\": \"The API refuses a user-management action, including an action for another organisation\",\n     \"when\": \"the administrator submits the action\",\n     \"then\": \"the screen shows the returned error message and does not show the other organisation's user as changed\",\n     \"level\": \"ui\"\n    }\n   ],\n   \"stability\": 0.6666666666666666\n  },\n  {\n   \"id\": \"REQ-5\",\n   \"ears\": \"The Meridian responsive web app shall let System Administrators list, search, view, deactivate, and maintain products and create versioned temperature profiles with storage bands, contiguous non-overlapping tiers, allowance or not-permitted designations, a reason, and an effective date, while keeping earlier versions read-only.\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-8\",\n    \"I-10\",\n    \"ASM-4\"\n   ],\n   \"acceptance\": [\n    {\n     \"id\": \"AC-5.1\",\n     \"given\": \"A System Administrator searches by product name or code or opens a deactivated product\",\n     \"when\": \"the API returns matching products and active states\",\n     \"then\": \"the screen shows matching product records and identifies deactivated products as unavailable for ordering\",\n     \"level\": \"ui\"\n    },\n    {\n     \"id\": \"AC-5.2\",\n     \"given\": \"A System Administrator submits an incomplete profile or one with overlapping or gapped tiers\",\n     \"when\": \"the administrator attempts to save\",\n     \"then\": \"the screen shows the validation error returned by the API and does not show the product as saved\",\n     \"level\": \"ui\"\n    },\n    {\n     \"id\": \"AC-5.3\",\n     \"given\": \"A System Administrator submits a valid profile with tiers, reason, and effective date\",\n     \"when\": \"the profile change is submitted\",\n     \"then\": \"the request includes the profile tiers, reason, and effective date and the screen shows the new profile version returned by the API\",\n     \"level\": \"ui\"\n    },\n    {\n     \"id\": \"AC-5.4\",\n     \"given\": \"A product has multiple profile versions\",\n     \"when\": \"a user opens profile history\",\n     \"then\": \"the screen lists earlier versions with their returned values, reason, effective date, and creator where returned, and provides no edit controls for earlier versions\",\n     \"level\": \"ui\"\n    },\n    {\n     \"id\": \"AC-5.5\",\n     \"given\": \"A System Administrator deactivates a product\",\n     \"when\": \"the API returns the updated product status\",\n     \"then\": \"the screen shows the product as deactivated\",\n     \"level\": \"ui\"\n    }\n   ],\n   \"stability\": 1\n  },\n  {\n   \"id\": \"REQ-6\",\n   \"ears\": \"When a temperature-profile version takes effect, the Meridian responsive web app shall show the new version and API-returned recalculated budgets and decisions for stock remaining in Meridian inventory on or after the effective date, and the returned current workflow status for that affected stock.\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-8\",\n    \"I-9\",\n    \"I-11\",\n    \"I-17\",\n    \"Q-8\"\n   ],\n   \"acceptance\": [\n    {\n     \"id\": \"AC-6.1\",\n     \"given\": \"The API returns a new effective profile version and recalculated values for stock still held from the effective date onward\",\n     \"when\": \"a user opens the profile and affected stock views\",\n     \"then\": \"the screen shows the new version's effective date and the returned budget and decision values\",\n     \"level\": \"ui\"\n    },\n    {\n     \"id\": \"AC-6.2\",\n     \"given\": \"A profile effective date is backdated and the API returns recalculation results for stock remaining in Meridian inventory on or after that effective date\",\n     \"when\": \"a user opens the affected stock or order view\",\n     \"then\": \"the screen shows the returned recalculated budget and decision values and current workflow status without displaying a superseded status as current\",\n     \"level\": \"ui\"\n    },\n    {\n     \"id\": \"AC-6.3\",\n     \"given\": \"A System Administrator submits a profile change with a reason and effective date\",\n     \"when\": \"the API returns the updated profile and affected-stock results\",\n     \"then\": \"the screen shows the new version, reason, effective date, and returned recalculated budget and decision values\",\n     \"level\": \"ui\"\n    }\n   ],\n   \"stability\": 0.6666666666666666\n  },\n  {\n   \"id\": \"REQ-7\",\n   \"ears\": \"When a Warehouse Operator records a receipt, the Meridian responsive web app shall capture product, lot number, expiry date, quantity, supplier, and storage location and show returned quarantine status and inbound temperature information before a release decision.\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-9\",\n    \"ASM-9\",\n    \"ASM-21\",\n    \"ASM-4\"\n   ],\n   \"acceptance\": [\n    {\n     \"id\": \"AC-7.1\",\n     \"given\": \"A Warehouse Operator opens the receipt form\",\n     \"when\": \"the form is displayed\",\n     \"then\": \"the screen shows fields for product, lot number, expiry date, quantity, supplier, cold room, and shelf\",\n     \"level\": \"ui\"\n    },\n    {\n     \"id\": \"AC-7.2\",\n     \"given\": \"The API accepts a receipt with an inbound logger file\",\n     \"when\": \"the operator submits the receipt\",\n     \"then\": \"the screen shows the receipt record, Quarantined status, submitted receipt details, and returned inbound readings and budget use when available\",\n     \"level\": \"ui\"\n    },\n    {\n     \"id\": \"AC-7.3\",\n     \"given\": \"The API refuses a receipt with an expired lot date or missing required field\",\n     \"when\": \"the operator submits the receipt\",\n     \"then\": \"the screen shows the returned error message beside the relevant field and no saved receipt is displayed\",\n     \"level\": \"ui\"\n    }\n   ],\n   \"stability\": 1\n  },\n  {\n   \"id\": \"REQ-8\",\n   \"ears\": \"The Meridian responsive web app shall provide inbound logger-file upload and display returned temperature history and budget use, validate separate image or PDF receipt-evidence files, and accept logger exports in the supplier's documented format.\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-5\",\n    \"I-8\",\n    \"I-9\",\n    \"ASM-8\",\n    \"ASM-9\",\n    \"ASM-21\"\n   ],\n   \"acceptance\": [\n    {\n     \"id\": \"AC-8.1\",\n     \"given\": \"A Warehouse Operator uploads an inbound logger file in the configured supplier interface format\",\n     \"when\": \"the receipt is submitted\",\n     \"then\": \"the request includes the uploaded logger file and the screen shows the returned inbound readings and budget use before release controls\",\n     \"level\": \"ui\"\n    },\n    {\n     \"id\": \"AC-8.2\",\n     \"given\": \"A Warehouse Operator uploads a logger file rejected by the API\",\n     \"when\": \"the upload response is displayed\",\n     \"then\": \"the screen shows the returned file error message and no successful-upload indicator\",\n     \"level\": \"ui\"\n    },\n    {\n     \"id\": \"AC-8.3\",\n     \"given\": \"An operator uploads a separate receipt-evidence image or PDF larger than 10 MB or a separate receipt-evidence file that is not an image or PDF\",\n     \"when\": \"the operator attempts to submit the receipt\",\n     \"then\": \"the screen shows a validation error and no saved receipt is displayed\",\n     \"level\": \"ui\"\n    }\n   ],\n   \"stability\": 1\n  },\n  {\n   \"id\": \"REQ-9\",\n   \"ears\": \"When quality staff review a receipt or excursion, the Meridian responsive web app shall present available release or disposition actions and show decision states returned by the API, including separate proposal and approval steps for not-permitted-range dispositions.\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-9\",\n    \"I-14\",\n    \"Q-1\",\n    \"Q-2\",\n    \"ASM-4\"\n   ],\n   \"acceptance\": [\n    {\n     \"id\": \"AC-9.1\",\n     \"given\": \"A quarantined receipt is opened by a Quality Officer\",\n     \"when\": \"the receipt review page renders\",\n     \"then\": \"the screen shows returned receipt data, temperature-budget use, and release decision controls\",\n     \"level\": \"ui\"\n    },\n    {\n     \"id\": \"AC-9.2\",\n     \"given\": \"A receipt is within 30 days of expiry on arrival or the API refuses release\",\n     \"when\": \"a Quality Officer opens or submits the release decision\",\n     \"then\": \"the screen shows the reason returned by the API and does not display the stock as released\",\n     \"level\": \"ui\"\n    },\n    {\n     \"id\": \"AC-9.3\",\n     \"given\": \"A Quality Officer proposes a disposition for stock exposed to a not-permitted range\",\n     \"when\": \"the proposal is submitted\",\n     \"then\": \"the request includes the proposed disposition and reason and the screen shows the proposal awaiting a different Quality Manager's approval\",\n     \"level\": \"ui\"\n    },\n    {\n     \"id\": \"AC-9.4\",\n     \"given\": \"The proposing person attempts to approve, or a user without the Quality Manager role attempts approval\",\n     \"when\": \"the approval is attempted\",\n     \"then\": \"the screen shows the returned error message or disables the approval control and shows the decision as unapproved\",\n     \"level\": \"ui\"\n    },\n    {\n     \"id\": \"AC-9.5\",\n     \"given\": \"A different Quality Manager approves or rejects a pending disposition\",\n     \"when\": \"the API returns the final decision\",\n     \"then\": \"the screen shows the returned decision, decision-maker, and decision status\",\n     \"level\": \"ui\"\n    }\n   ],\n   \"stability\": 0.6666666666666666\n  },\n  {\n   \"id\": \"REQ-10\",\n   \"ears\": \"The Meridian responsive web app shall show on-hand stock with mutually exclusive quantities for available, allocated, quarantined, On Hold, Rejected, Recalled, and Expired statuses, and show returned warehouse, lot, product, receipt, and location details.\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-1\",\n    \"I-6\",\n    \"I-9\",\n    \"I-11\",\n    \"I-17\",\n    \"Q-7\",\n    \"ASM-3\"\n   ],\n   \"acceptance\": [\n    {\n     \"id\": \"AC-10.1\",\n     \"given\": \"The API returns on-hand and status quantities for a product, lot, and warehouse\",\n     \"when\": \"a user opens the stock view\",\n     \"then\": \"the screen shows the on-hand total and each returned status quantity as a separate field or row, with the quantities summing to the on-hand count\",\n     \"level\": \"ui\"\n    },\n    {\n     \"id\": \"AC-10.2\",\n     \"given\": \"The API returns stock rows for multiple lots or warehouses\",\n     \"when\": \"a user filters the stock list\",\n     \"then\": \"the screen shows only rows matching the selected filter values\",\n     \"level\": \"ui\"\n    }\n   ],\n   \"stability\": 1\n  },\n  {\n   \"id\": \"REQ-11\",\n   \"ears\": \"When portions of received stock have different temperature histories, the Meridian responsive web app shall show them as separate handling units with their returned quantity, history, and tier-budget use and remaining.\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-6\",\n    \"I-8\",\n    \"I-9\",\n    \"I-13\",\n    \"I-14\",\n    \"Q-5\"\n   ],\n   \"acceptance\": [\n    {\n     \"id\": \"AC-11.1\",\n     \"given\": \"A received lot is divided into handling units with different temperature histories\",\n     \"when\": \"a user opens the lot's handling-unit view\",\n     \"then\": \"the screen shows separate rows or records with each unit's returned quantity, history, and budget values\",\n     \"level\": \"ui\"\n    }\n   ],\n   \"stability\": 1\n  },\n  {\n   \"id\": \"REQ-12\",\n   \"ears\": \"The Meridian responsive web app shall provide stock-movement forms and show the returned movement record with source and destination locations, quantity, actor, and time.\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-9\"\n   ],\n   \"acceptance\": [\n    {\n     \"id\": \"AC-12.1\",\n     \"given\": \"A Warehouse Operator moves stock between shelves or cold rooms\",\n     \"when\": \"the operator submits the move and opens its result\",\n     \"then\": \"the request includes the source and destination and the screen shows the returned movement record with actor, time, and quantity fields\",\n     \"level\": \"ui\"\n    }\n   ],\n   \"stability\": 0.3333333333333333\n  },\n  {\n   \"id\": \"REQ-13\",\n   \"ears\": \"The Meridian responsive web app shall let Customer Administrators maintain their organisation's saved delivery addresses and let System Administrators set the organisation's minimum remaining shelf-life requirement, showing that value read-only to customer users and Dispatchers.\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-3\",\n    \"I-10\",\n    \"I-11\",\n    \"Q-6\",\n    \"ASM-5\"\n   ],\n   \"acceptance\": [\n    {\n     \"id\": \"AC-13.1\",\n     \"given\": \"A Customer Administrator opens address management\",\n     \"when\": \"the administrator adds, edits, or removes an address\",\n     \"then\": \"the screen shows the address list or status returned by the API\",\n     \"level\": \"ui\"\n    },\n    {\n     \"id\": \"AC-13.2\",\n     \"given\": \"A System Administrator changes minimum remaining shelf life for a customer organisation\",\n     \"when\": \"the change is submitted\",\n     \"then\": \"the request includes the organisation-level value and the screen shows the saved value and response status returned by the API\",\n     \"level\": \"ui\"\n    },\n    {\n     \"id\": \"AC-13.3\",\n     \"given\": \"A customer user or Dispatcher opens an order form\",\n     \"when\": \"the form renders\",\n     \"then\": \"the screen shows the organisation's minimum remaining shelf-life value without a control to change it per order\",\n     \"level\": \"ui\"\n    }\n   ],\n   \"stability\": 1\n  },\n  {\n   \"id\": \"REQ-14\",\n   \"ears\": \"The Meridian responsive web app shall let customer users create orders with one or more product lines, pack quantities, an organisation-saved delivery address, an eligible delivery date, and a choice between delivery of available quantities and complete delivery only.\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-3\",\n    \"I-10\",\n    \"ASM-5\",\n    \"ASM-6\",\n    \"ASM-27\"\n   ],\n   \"acceptance\": [\n    {\n     \"id\": \"AC-14.1\",\n     \"given\": \"A customer user opens the order form\",\n     \"when\": \"the form is displayed\",\n     \"then\": \"the screen provides fields for at least one product line, a quantity of at least one pack per line, a saved address, requested delivery date, and partial-or-complete delivery preference\",\n     \"level\": \"ui\"\n    },\n    {\n     \"id\": \"AC-14.2\",\n     \"given\": \"A customer enters a quantity below one pack or submits an order without a line\",\n     \"when\": \"the customer submits the form\",\n     \"then\": \"the screen shows a field error and the request is not sent\",\n     \"level\": \"ui\"\n    },\n    {\n     \"id\": \"AC-14.3\",\n     \"given\": \"The API returns eligible delivery dates for the serving warehouse, based on its configured local time, cut-off, working days, and holidays\",\n     \"when\": \"the customer opens the date selector before or after the configured cut-off\",\n     \"then\": \"the screen shows only returned eligible dates, applies the next-working-day rule for an order before cut-off and no-earlier-than-the-working-day-after-that rule for an order after cut-off, and identifies the warehouse time zone\",\n     \"level\": \"ui\"\n    },\n    {\n     \"id\": \"AC-14.4\",\n     \"given\": \"A customer selects a deactivated product for an order\",\n     \"when\": \"the product status is returned\",\n     \"then\": \"the screen shows that the product cannot be ordered and provides no orderable quantity field\",\n     \"level\": \"ui\"\n    },\n    {\n     \"id\": \"AC-14.5\",\n     \"given\": \"A customer selects products, quantities, address, date, and fulfillment choice\",\n     \"when\": \"the customer reviews the order before submission\",\n     \"then\": \"the screen shows the complete order summary\",\n     \"level\": \"ui\"\n    }\n   ],\n   \"stability\": 1\n  },\n  {\n   \"id\": \"REQ-15\",\n   \"ears\": \"When customers view, change, or cancel an order, the Meridian responsive web app shall show order status and allocated and outstanding quantities per line, expose customer change and cancellation controls only before Packed, expose dispatcher cancellation controls when returned as available, and display API outcomes.\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-3\",\n    \"I-10\",\n    \"I-11\",\n    \"Q-6\"\n   ],\n   \"acceptance\": [\n    {\n     \"id\": \"AC-15.1\",\n     \"given\": \"The API returns an order with line quantities and a status before Packed\",\n     \"when\": \"the customer opens the order\",\n     \"then\": \"the screen shows each line's allocated and outstanding quantities and customer change and cancel controls\",\n     \"level\": \"ui\"\n    },\n    {\n     \"id\": \"AC-15.2\",\n     \"given\": \"The API returns an order status of Packed or later\",\n     \"when\": \"the customer opens the order\",\n     \"then\": \"the screen shows the current status and no customer change or cancel controls\",\n     \"level\": \"ui\"\n    },\n    {\n     \"id\": \"AC-15.3\",\n     \"given\": \"A cancellation or change is refused or accepted by the API\",\n     \"when\": \"the customer submits the action or refreshes the order\",\n     \"then\": \"the screen shows the returned error or cancellation response, current status, updated quantities, and stock availability count when returned\",\n     \"level\": \"ui\"\n    },\n    {\n     \"id\": \"AC-15.4\",\n     \"given\": \"A customer submits an order more than once or retries after a network interruption\",\n     \"when\": \"the web app sends the submission or retry\",\n     \"then\": \"the captured request uses the same submission key for the retry and the screen shows one returned order record\",\n     \"level\": \"ui\"\n    },\n    {\n     \"id\": \"AC-15.5\",\n     \"given\": \"An order submission is pending\",\n     \"when\": \"the customer repeats the submission\",\n     \"then\": \"the screen sends only one order-submission request\",\n     \"level\": \"ui\"\n    },\n    {\n     \"id\": \"AC-15.6\",\n     \"given\": \"A Dispatcher opens an order in Packed or later status and the API returns cancellation as available\",\n     \"when\": \"the Dispatcher opens the order or submits cancellation\",\n     \"then\": \"the screen shows the dispatcher cancellation control and the returned cancellation response or error message\",\n     \"level\": \"ui\"\n    }\n   ],\n   \"stability\": 1\n  },\n  {\n   \"id\": \"REQ-16\",\n   \"ears\": \"The Meridian responsive web app shall show order allocations by line and lot, including returned expiry dates and quantities, expose dispatcher lot-override controls with a required reason and API outcome, and show returned allocation and stock-status outcomes in order, box, and route views.\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-10\",\n    \"I-11\",\n    \"I-12\",\n    \"I-15\",\n    \"I-17\",\n    \"ASM-5\",\n    \"Q-6\",\n    \"Q-7\"\n   ],\n   \"acceptance\": [\n    {\n     \"id\": \"AC-16.1\",\n     \"given\": \"An order line is allocated across lots\",\n     \"when\": \"a Dispatcher or customer opens allocation details\",\n     \"then\": \"the screen shows each returned lot, expiry date, allocated quantity, line split, and outstanding quantity separately\",\n     \"level\": \"ui\"\n    },\n    {\n     \"id\": \"AC-16.2\",\n     \"given\": \"A Dispatcher selects an alternative lot\",\n     \"when\": \"the override form renders and is submitted\",\n     \"then\": \"the screen shows a required reason field and the request includes the chosen lot and reason, while the screen shows the accepted allocation or returned refusal message\",\n     \"level\": \"ui\"\n    },\n    {\n     \"id\": \"AC-16.3\",\n     \"given\": \"The API reports back order, complete-only status, or no suitable stock\",\n     \"when\": \"the Dispatcher opens the order\",\n     \"then\": \"the screen shows the returned allocation status and outstanding quantity\",\n     \"level\": \"ui\"\n    },\n    {\n     \"id\": \"AC-16.4\",\n     \"given\": \"Allocated stock becomes On Hold, Rejected, Recalled, or Expired\",\n     \"when\": \"the order view refreshes\",\n     \"then\": \"the screen shows the returned removed allocation, replacement allocation outcome, outstanding quantity, and dispatcher message or notification outcome when returned\",\n     \"level\": \"ui\"\n    },\n    {\n     \"id\": \"AC-16.5\",\n     \"given\": \"Stock allocated to an order is reported by the API as On Hold, Rejected, Recalled, or Expired after it has been packed or placed on a route\",\n     \"when\": \"a user opens or refreshes the affected order, box, or route view\",\n     \"then\": \"the screen shows the returned stock status, resulting allocation and box or route status, and any returned action-required message or handover restriction\",\n     \"level\": \"ui\"\n    }\n   ],\n   \"stability\": 1\n  },\n  {\n   \"id\": \"REQ-17\",\n   \"ears\": \"The Meridian responsive web app shall let Warehouse Operators pack stock into shipper boxes by type, associate one logger with each box, and show compatibility, contents, and sealing details returned by the API.\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-9\",\n    \"I-12\",\n    \"I-13\"\n   ],\n   \"acceptance\": [\n    {\n     \"id\": \"AC-17.1\",\n     \"given\": \"A Warehouse Operator opens the packing form\",\n     \"when\": \"the form renders\",\n     \"then\": \"the screen provides fields for box type, logger identifier, delivery stop, products, lots, and quantities\",\n     \"level\": \"ui\"\n    },\n    {\n     \"id\": \"AC-17.2\",\n     \"given\": \"The operator selects stock, a box type, and logger and submits the packing action\",\n     \"when\": \"the API returns compatibility results or refuses an incompatible band, box type, missing logger, or already-associated logger\",\n     \"then\": \"the screen shows the returned compatibility result or error message and does not show an unsuccessful box as sealed\",\n     \"level\": \"ui\"\n    },\n    {\n     \"id\": \"AC-17.3\",\n     \"given\": \"A box is ready to be sealed and sealing succeeds\",\n     \"when\": \"the operator opens the box record\",\n     \"then\": \"the screen shows exactly one logger requirement and the returned seal time, operator, contents, quantities, and logger\",\n     \"level\": \"ui\"\n    }\n   ],\n   \"stability\": 1\n  },\n  {\n   \"id\": \"REQ-18\",\n   \"ears\": \"The Meridian responsive web app shall let Dispatchers create and view routes with a date, vehicle, driver, ordered stops, and planned arrival times and show route-confirmation errors and confirmed-route changes returned by the API, including configured qualified-duration safety margins.\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-2\",\n    \"I-12\",\n    \"I-15\",\n    \"ASM-6\",\n    \"ASM-27\"\n   ],\n   \"acceptance\": [\n    {\n     \"id\": \"AC-18.1\",\n     \"given\": \"A Dispatcher creates a route\",\n     \"when\": \"the route form is displayed\",\n     \"then\": \"the screen provides fields for one vehicle, one driver, route date, at least one ordered stop, and planned arrival times\",\n     \"level\": \"ui\"\n    },\n    {\n     \"id\": \"AC-18.2\",\n     \"given\": \"The API refuses confirmation because a box exceeds its qualified duration after applying the configured safety margin, which defaults to 4 hours\",\n     \"when\": \"the Dispatcher views the result\",\n     \"then\": \"the screen shows the refused status, affected box, returned overage amount, and returned configured safety-margin value\",\n     \"level\": \"ui\"\n    },\n    {\n     \"id\": \"AC-18.3\",\n     \"given\": \"A confirmed route is changed before the driver has left for an affected stop\",\n     \"when\": \"the Dispatcher reorders or moves the stop\",\n     \"then\": \"the request identifies the changed route and the screen shows returned stop order, schedule details, and driver notification status when returned\",\n     \"level\": \"ui\"\n    },\n    {\n     \"id\": \"AC-18.4\",\n     \"given\": \"A driver opens a changed confirmed route\",\n     \"when\": \"the route view is displayed\",\n     \"then\": \"the screen shows the changed stop or schedule details returned by the API\",\n     \"level\": \"ui\"\n    }\n   ],\n   \"stability\": 1\n  },\n  {\n   \"id\": \"REQ-19\",\n   \"ears\": \"The Meridian responsive web app shall show temperature histories for boxes, cold rooms, and lots as charts and tables with returned readings, applicable bands, excursions, gaps, and reading flags or silence status.\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-5\",\n    \"I-6\",\n    \"I-13\",\n    \"I-14\",\n    \"ASM-2\",\n    \"ASM-4\",\n    \"ASM-8\",\n    \"ASM-18\",\n    \"ASM-21\"\n   ],\n   \"acceptance\": [\n    {\n     \"id\": \"AC-19.1\",\n     \"given\": \"The API returns temperature history\",\n     \"when\": \"a user opens the history page\",\n     \"then\": \"the screen provides chart and table views with readings positioned by event or reading time, band bounds, excursion markers, and visible gaps\",\n     \"level\": \"ui\"\n    },\n    {\n     \"id\": \"AC-19.2\",\n     \"given\": \"The API returns duplicate, delayed, out-of-order, future-dated, pre-seal, or otherwise flagged readings\",\n     \"when\": \"the history is displayed\",\n     \"then\": \"the screen shows returned reading times and flags, identifies invalid-for-calculation readings, and displays returned history in time order without presenting excluded readings as calculation inputs\",\n     \"level\": \"ui\"\n    },\n    {\n     \"id\": \"AC-19.3\",\n     \"given\": \"A user switches between chart and table views\",\n     \"when\": \"the API returns the same history data\",\n     \"then\": \"the screen shows the corresponding returned history in each view\",\n     \"level\": \"ui\"\n    },\n    {\n     \"id\": \"AC-19.4\",\n     \"given\": \"The API returns gateway batch readings or inbound logger-file reading results\",\n     \"when\": \"a user opens the relevant device or receipt history\",\n     \"then\": \"the screen displays the returned readings and associated device or receipt\",\n     \"level\": \"ui\"\n    }\n   ],\n   \"stability\": 1\n  },\n  {\n   \"id\": \"REQ-20\",\n   \"ears\": \"The Meridian responsive web app shall show excursions, handling-unit budget use and remaining allowances, returned alerts, and returned hold and decision statuses for affected devices and stock.\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-5\",\n    \"I-8\",\n    \"I-9\",\n    \"I-13\",\n    \"I-14\",\n    \"I-15\",\n    \"Q-2\",\n    \"Q-5\",\n    \"Q-8\",\n    \"ASM-4\",\n    \"ASM-10\",\n    \"ASM-18\",\n    \"ASM-22\"\n   ],\n   \"acceptance\": [\n    {\n     \"id\": \"AC-20.1\",\n     \"given\": \"The API returns an excursion and its affected handling units\",\n     \"when\": \"a user opens excursion or budget details\",\n     \"then\": \"the screen shows returned excursion start, end, readings, closure status, affected units, and used and remaining amounts by tier\",\n     \"level\": \"ui\"\n    },\n    {\n     \"id\": \"AC-20.2\",\n     \"given\": \"The API returns an open excursion, handling units, and hold statuses\",\n     \"when\": \"a Quality Officer opens the excursion view\",\n     \"then\": \"the screen shows affected handling units, tier budgets, and returned hold statuses\",\n     \"level\": \"ui\"\n    },\n    {\n     \"id\": \"AC-20.3\",\n     \"given\": \"The API returns a remaining-budget warning, exhausted tier, or not-permitted-range alert\",\n     \"when\": \"a user opens alerts or quality status\",\n     \"then\": \"the screen shows the returned alert category and affected stock or device\",\n     \"level\": \"ui\"\n    },\n    {\n     \"id\": \"AC-20.4\",\n     \"given\": \"The API returns an alert for silence, excursion, low or exhausted budget, not-permitted range, or corrected excursion\",\n     \"when\": \"an intended user opens alert history\",\n     \"then\": \"the screen shows returned alert type, affected device or stock, recipient role and delivery metadata when returned, plus corrected excursion or budget status when present\",\n     \"level\": \"ui\"\n    }\n   ],\n   \"stability\": 1\n  },\n  {\n   \"id\": \"REQ-21\",\n   \"ears\": \"When the API returns an unresolved temperature-history gap affecting stock, the Meridian responsive web app shall show the gap, review status, the returned On Hold stock status, and no estimated temperature tier.\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-5\",\n    \"I-6\",\n    \"I-8\",\n    \"I-13\",\n    \"I-14\",\n    \"Q-2\",\n    \"ASM-18\",\n    \"ASM-11\",\n    \"ASM-24\"\n   ],\n   \"acceptance\": [\n    {\n     \"id\": \"AC-21.1\",\n     \"given\": \"The API returns an unresolved temperature-history gap for affected stock and reports its stock status as On Hold\",\n     \"when\": \"a Quality Officer opens the quality status\",\n     \"then\": \"the screen shows the gap, review status, and returned On Hold status without estimating a temperature tier\",\n     \"level\": \"ui\"\n    }\n   ],\n   \"stability\": 1\n  },\n  {\n   \"id\": \"REQ-22\",\n   \"ears\": \"When the API returns an unresolved temperature-history gap affecting stock as On Hold, the Meridian responsive web app shall show the stock as On Hold until resolution and show no charge to an unobserved temperature tier.\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-8\",\n    \"I-13\",\n    \"I-14\",\n    \"Q-2\",\n    \"Q-5\",\n    \"Q-8\",\n    \"ASM-4\",\n    \"ASM-10\",\n    \"ASM-18\"\n   ],\n   \"acceptance\": [\n    {\n     \"id\": \"AC-22.1\",\n     \"given\": \"The API reports an unresolved temperature-history gap affecting stock as On Hold\",\n     \"when\": \"a user opens the affected stock detail\",\n     \"then\": \"the screen shows On Hold until resolution and shows no automatic charge to an unobserved tier\",\n     \"level\": \"ui\"\n    }\n   ],\n   \"stability\": 0.3333333333333333\n  },\n  {\n   \"id\": \"REQ-23\",\n   \"ears\": \"When corrected temperature history identifies an excursion affecting stock already delivered, the Meridian responsive web app shall show the returned quality-review case to the relevant customer and staff users.\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-3\",\n    \"I-13\",\n    \"I-14\"\n   ],\n   \"acceptance\": [\n    {\n     \"id\": \"AC-23.1\",\n     \"given\": \"The API returns a quality-review case linked to a delivered customer order\",\n     \"when\": \"the customer or authorized staff user opens the related order or case\",\n     \"then\": \"the screen shows the returned case status and affected delivered line or stock details\",\n     \"level\": \"ui\"\n    }\n   ],\n   \"stability\": 1\n  },\n  {\n   \"id\": \"REQ-24\",\n   \"ears\": \"The Meridian responsive web app shall provide an installable, responsive driver web experience that caches the current workday's assigned route and queues supported loading and delivery actions for synchronization when connectivity returns, shows stale-route and queued-action outcomes returned by the API, and clears cached route and delivery data when the driver signs out, the workday ends, or the API reports the account disabled.\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-4\",\n    \"I-7\",\n    \"I-10\",\n    \"I-12\",\n    \"I-15\",\n    \"ASM-1\",\n    \"ASM-13\",\n    \"ASM-17\",\n    \"ASM-25\",\n    \"Q-3\",\n    \"Q-4\"\n   ],\n   \"acceptance\": [\n    {\n     \"id\": \"AC-24.1\",\n     \"given\": \"A driver has opened today's assigned route while connected and then loses connectivity\",\n     \"when\": \"the driver opens the cached route\",\n     \"then\": \"the screen shows the route, stops, and delivery details while offline\",\n     \"level\": \"ui\"\n    },\n    {\n     \"id\": \"AC-24.2\",\n     \"given\": \"A driver records a supported action while offline\",\n     \"when\": \"the action is saved without a connection\",\n     \"then\": \"the screen shows the action as queued and retains its entered values until synchronization is attempted\",\n     \"level\": \"ui\"\n    },\n    {\n     \"id\": \"AC-24.3\",\n     \"given\": \"A driver reconnects with an enabled account\",\n     \"when\": \"queued actions synchronize\",\n     \"then\": \"the screen shows the returned synchronization result for each queued action\",\n     \"level\": \"ui\"\n    },\n    {\n     \"id\": \"AC-24.4\",\n     \"given\": \"A queued action is submitted after the API reports the driver's account disabled or removed\",\n     \"when\": \"synchronization is attempted\",\n     \"then\": \"the screen shows the returned rejection message or error and marks the action as not accepted or synchronized\",\n     \"level\": \"ui\"\n    },\n    {\n     \"id\": \"AC-24.5\",\n     \"given\": \"A Dispatcher changes a cached route or cancels an order while the driver is offline and the API returns the updated route or order on reconnection\",\n     \"when\": \"the driver refreshes or synchronizes the cached work\",\n     \"then\": \"the screen identifies the cached route or stop as stale, shows the returned changed route or cancellation status, and does not present a removed stop or cancelled order as actionable\",\n     \"level\": \"ui\"\n    },\n    {\n     \"id\": \"AC-24.6\",\n     \"given\": \"A queued loading or handover action refers to a moved or removed stop or a cancelled order\",\n     \"when\": \"the action synchronizes and the API returns an acceptance or refusal\",\n     \"then\": \"the screen shows the returned result for that action and does not mark a refused handover as completed or accepted\",\n     \"level\": \"ui\"\n    },\n    {\n     \"id\": \"AC-24.7\",\n     \"given\": \"The browser has cached route or delivery data, including recipient details\",\n     \"when\": \"the driver signs out, the cached workday ends, or an API response reports that the account is disabled, and the driver next opens the driver experience\",\n     \"then\": \"the screen shows the sign-in or access-denied page and no cached route, stop, delivery, or recipient details\",\n     \"level\": \"ui\"\n    }\n   ],\n   \"stability\": 1\n  },\n  {\n   \"id\": \"REQ-25\",\n   \"ears\": \"When a driver records a delivery handover, the Meridian responsive web app shall capture the recipient's name, explicit electronic acknowledgment, quantities handed over, and any refusal or partial-delivery reason, and show outstanding quantities and returned delivery status.\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-3\",\n    \"I-4\",\n    \"I-15\",\n    \"Q-3\",\n    \"Q-4\",\n    \"I-9\",\n    \"I-10\"\n   ],\n   \"acceptance\": [\n    {\n     \"id\": \"AC-25.1\",\n     \"given\": \"A driver opens a delivery handover form\",\n     \"when\": \"the form is displayed\",\n     \"then\": \"the screen shows a recipient-name field and explicit electronic acknowledgment control and does not require a drawn signature\",\n     \"level\": \"ui\"\n    },\n    {\n     \"id\": \"AC-25.2\",\n     \"given\": \"A driver submits a handover\",\n     \"when\": \"the web app sends the handover\",\n     \"then\": \"the captured request contains recipient name, acknowledgment value, and handed-over quantities\",\n     \"level\": \"ui\"\n    },\n    {\n     \"id\": \"AC-25.3\",\n     \"given\": \"A delivery is refused or only partly completed\",\n     \"when\": \"the driver records the handover\",\n     \"then\": \"the request includes delivered and undelivered quantities and the reason, and the screen shows the returned outstanding quantity\",\n     \"level\": \"ui\"\n    },\n    {\n     \"id\": \"AC-25.4\",\n     \"given\": \"Undelivered stock is returned to a warehouse\",\n     \"when\": \"the API returns the warehouse receipt and any required quality-check result\",\n     \"then\": \"the screen shows the returned receipt and quality status and shows stock as available only when the API reports it available\",\n     \"level\": \"ui\"\n    }\n   ],\n   \"stability\": 1\n  },\n  {\n   \"id\": \"REQ-26\",\n   \"ears\": \"The Meridian responsive web app shall let Quality Managers start recalls by selecting affected lots and providing a reason, view and manage recall records, and close recalls, and let customer users submit a quantity and stated disposition for each affected delivery, showing returned reconciliation and stock-block information.\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-3\",\n    \"I-17\",\n    \"ASM-15\",\n    \"ASM-19\",\n    \"I-9\",\n    \"Q-1\"\n   ],\n   \"acceptance\": [\n    {\n     \"id\": \"AC-26.1\",\n     \"given\": \"A Quality Manager opens a recall record\",\n     \"when\": \"the recall detail is displayed\",\n     \"then\": \"the screen lists returned lot locations, affected deliveries, quantities, and remaining stock reported as blocked\",\n     \"level\": \"ui\"\n    },\n    {\n     \"id\": \"AC-26.2\",\n     \"given\": \"A customer user opens an affected delivery recall response form\",\n     \"when\": \"the form is displayed\",\n     \"then\": \"the screen provides fields for response, quantity, and stated disposition for each delivery and returned quantity categories for locating, using, returning, disposing of, or otherwise accounting for units\",\n     \"level\": \"ui\"\n    },\n    {\n     \"id\": \"AC-26.3\",\n     \"given\": \"A customer submits a recall quantity reconciliation\",\n     \"when\": \"the API returns the response status\",\n     \"then\": \"the screen shows submitted quantities, stated dispositions, and returned accounted-for status without requiring supporting-document upload\",\n     \"level\": \"ui\"\n    },\n    {\n     \"id\": \"AC-26.4\",\n     \"given\": \"A recall has unreconciled quantities\",\n     \"when\": \"a Quality Manager opens its progress page\",\n     \"then\": \"the screen shows the outstanding quantity count and affected customer responses returned by the API\",\n     \"level\": \"ui\"\n    },\n    {\n     \"id\": \"AC-26.5\",\n     \"given\": \"A Quality Manager starts a recall for one or more lots\",\n     \"when\": \"the Quality Manager selects the lots, enters a reason, and submits the recall\",\n     \"then\": \"the request includes the selected lots and reason, and the screen shows the recall record and status returned by the API\",\n     \"level\": \"ui\"\n    },\n    {\n     \"id\": \"AC-26.6\",\n     \"given\": \"A Quality Manager closes a recall\",\n     \"when\": \"the Quality Manager submits the close action\",\n     \"then\": \"the screen shows the recall status returned by the API\",\n     \"level\": \"ui\"\n    },\n    {\n     \"id\": \"AC-26.7\",\n     \"given\": \"The API refuses a recall start or close action\",\n     \"when\": \"the Quality Manager submits that action\",\n     \"then\": \"the screen shows the returned error message and does not show the recall as successfully started or closed\",\n     \"level\": \"ui\"\n    }\n   ],\n   \"stability\": 1\n  },\n  {\n   \"id\": \"REQ-27\",\n   \"ears\": \"The Meridian responsive web app shall provide filtered on-screen operational lists and CSV export, and show creator and last-changer identity and timestamps as read-only metadata where returned.\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-1\",\n    \"I-2\",\n    \"I-6\",\n    \"I-7\",\n    \"I-9\",\n    \"I-11\",\n    \"I-13\",\n    \"I-17\",\n    \"ASM-11\",\n    \"ASM-12\",\n    \"ASM-24\"\n   ],\n   \"acceptance\": [\n    {\n     \"id\": \"AC-27.1\",\n     \"given\": \"A user opens a supported operational list and applies filters\",\n     \"when\": \"the user requests CSV export\",\n     \"then\": \"the screen shows the filtered record list and the downloaded CSV file contains the displayed or filtered records\",\n     \"level\": \"ui\"\n    },\n    {\n     \"id\": \"AC-27.2\",\n     \"given\": \"The API returns creator and last-change metadata for a record\",\n     \"when\": \"an authorized user or Auditor opens the record\",\n     \"then\": \"the screen shows returned actor and timestamp fields as read-only values\",\n     \"level\": \"ui\"\n    }\n   ],\n   \"stability\": 1\n  },\n  {\n   \"id\": \"REQ-28\",\n   \"ears\": \"The Meridian responsive web app shall provide English and Arabic portal content and render Arabic pages right to left.\",\n   \"op\": \"ADDED\",\n   \"sources\": [\n    \"I-2\",\n    \"I-3\",\n    \"I-15\",\n    \"I-16\",\n    \"ASM-14\",\n    \"ASM-26\"\n   ],\n   \"acceptance\": [\n    {\n     \"id\": \"AC-28.1\",\n     \"given\": \"A user selects Arabic\",\n     \"when\": \"the user opens a staff, customer, or driver page\",\n     \"then\": \"the screen shows Arabic text with right-to-left page direction\",\n     \"level\": \"ui\"\n    },\n    {\n     \"id\": \"AC-28.2\",\n     \"given\": \"A user selects English\",\n     \"when\": \"the user opens a portal page\",\n     \"then\": \"the screen shows English text with left-to-right page direction\",\n     \"level\": \"ui\"\n    }\n   ],\n   \"stability\": 1\n  }\n ],\n \"nfrs\": [\n  {\n   \"id\": \"NFR-1\",\n   \"metric\": \"At viewport widths 320, 768, and 1280/1440 CSS pixels, zero horizontal overflow; phone interactive targets are at least 44 × 44 CSS pixels.\",\n   \"text\": \"Every portal page reflows for phone, tablet, and desktop browser widths, with touch-sized controls on narrow layouts.\"\n  },\n  {\n   \"id\": \"NFR-2\",\n   \"metric\": \"100% of the agreed main-flow screens pass WCAG 2.1 AA checks; zero unmet applicable success criteria in audited main flows.\",\n   \"text\": \"Main staff, customer, and driver web flows conform to WCAG 2.1 Level AA.\"\n  },\n  {\n   \"id\": \"NFR-3\",\n   \"text\": \"The responsive portals support the latest two versions of Chrome, Edge, Safari, and Firefox.\",\n   \"metric\": \"100% of agreed main-flow UI test cases pass on the latest two versions of each of Chrome, Edge, Safari, and Firefox.\"\n  },\n  {\n   \"id\": \"NFR-4\",\n   \"metric\": \"1,000 users, 100,000 records in the first year, and data from 5,000 devices reporting at once.\",\n   \"text\": \"The web portal supports the stated first-year user and record volume and displays data from the stated simultaneous device volume.\"\n  }\n ],\n \"outOfScope\": [\n  \"API-side durable persistence, server-side role and organisation enforcement, session revocation, server-side validation and workflow transitions, stock and allocation concurrency/invariants, policy calculations, expiry processing, recall blocking, and database-level audit retention; web requirements cover presentation of API responses.\",\n  \"API-side supplier-gateway ingestion, reading deduplication and reordering, sensor-scale ingestion and processing, silence and excursion detection, stability-budget recalculation, hold placement, and alert timing; web requirements cover returned histories, statuses, and alerts.\",\n  \"API-side email alert and password-reset or one-time-code delivery. SMS and native push channels are excluded; where notification is needed in the web product, it is represented by in-app notice or email as specified by the source requirements.\",\n  \"Historical spreadsheet or paper-record import is excluded; setup uses seed data.\",\n  \"A full immutable audit trail beyond returned creator and last-change identity and timestamps is excluded.\",\n  \"A custom report builder is excluded.\",\n  \"Native iOS/Android binaries and app-store publication are excluded; requested driver functions are delivered in the responsive web app.\"\n ],\n \"assumptions\": [\n  \"If a driver records actions offline and their account is disabled or removed before synchronization, should those queued actions be accepted into the shared record? → assumed: No; online only.\",\n  \"Staff sign in through Meridian Microsoft accounts; customers use email/password, an emailed one-time code, and an emailed reset link, as specified in US-001; ASM-23's no-social/no-SSO constraint applies to customer sign-in, while the one-time code remains required.\",\n  \"The web app presents access, persistence, revocation, and workflow outcomes returned by the separate API; API authorization and data isolation are not asserted by UI requirements.\",\n  \"For temperature-history gaps, no unobserved tier is charged; affected stock is flagged for quality review and remains On Hold until the gap is resolved.\",\n  \"Warehouse-local time governs cutoff, working-day, holiday, delivery-date, and route rules; dates and times are displayed in the user's local zone with the warehouse zone identified.\",\n  \"Numeric policy values stated in the drafts include a 15-minute silence interval, two-minute alert target, 25% budget warning, three consecutive in-band readings, and 30-day expiry restriction; server calculations and timing are API-side.\",\n  \"Logger gateway and inbound exports use the supplier's documented interface and file format; gateway ingestion is API-side. The logger export is separate from receipt-evidence files; separate evidence uploads, if used, are images or PDFs up to 10 MB each and are kept in cloud storage. The supported format contract needs confirmation.\",\n  \"Supported browsers are the latest two versions of Chrome, Edge, Safari, and Firefox; WCAG 2.1 AA applies to main flows.\",\n  \"The source request ends during US-009; driver behavior is limited to stated intent spans and Q-3/Q-4 decisions, with no unstated behavior inferred.\",\n  \"Recall responses record quantity and disposition per affected delivery, reconciling located, used, returned, disposed of, or otherwise accounted-for quantities; supporting documents are not required.\",\n  \"Planning volumes are up to 1,000 users and 100,000 records in the first year plus 5,000 reporting devices; backend capacity is API-side.\",\n  \"One minimum shelf-life value is set per customer organisation; customers and Dispatchers cannot set it per order.\",\n  \"When readings are missing, do not charge an assumed temperature tier automatically; flag affected stock for quality review and keep it On Hold until the gap is resolved.\",\n  \"Treat on-hand as a total and show non-overlapping quantities for available, allocated, quarantined, On Hold, Rejected, Recalled, and Expired stock.\",\n  \"Keep the stated numeric policy values fixed: 15-minute silence, two-minute alert target, 25% remaining-budget alert, three consecutive in-band readings, and 30-day expiry restriction.\",\n  \"A System Administrator sets one minimum remaining shelf-life value per customer organisation; Dispatchers and customers cannot change it per order.\",\n  \"Use the serving warehouse's configured local time zone for its cut-off, working-day, and route rules; display dates and times in the user's local zone with the warehouse zone identified.\",\n  \"No existing spreadsheet or operational data is migrated; the system starts empty with seed data for setup.\",\n  \"Use the supplier gateway's existing documented batch API; Meridian provides interface documentation, credentials, and sample payloads.\",\n  \"Alerts are sent by email from fixed templates; no SMS or push notifications.\",\n  \"Who created and last changed each record, and when, are retained; no full audit trail is required.\",\n  \"Provide on-screen lists with filters and CSV export; no custom report builder is required.\",\n  \"The latest two versions of Chrome, Edge, Safari, and Firefox are supported.\",\n  \"WCAG 2.1 AA applies to the main flows.\",\n  \"For each affected delivery, record the customer's response, quantity, and stated disposition; accept the response as accounted for without supporting documents.\",\n  \"Support up to 1,000 users and 100,000 records in the first year in addition to 5,000 reporting devices.\",\n  \"If a driver records actions offline and their account is disabled before those actions synchronize, queued actions are not accepted into the shared record.\",\n  \"When a logger or sensor has a reading gap, do not charge an assumed temperature tier automatically; flag the gap for quality review and keep affected stock On Hold until resolved.\",\n  \"A customer recall response reconciles each quantity as located, used, returned, disposed of, or otherwise accounted for.\",\n  \"No existing paper-record or spreadsheet information is migrated; the system starts empty with seed data for setup.\",\n  \"Use Meridian's existing supplier gateway and documented interface, and accept the supplier's documented inbound logger export format.\",\n  \"Excursion and route alerts use email only from fixed templates; no SMS or push.\",\n  \"Customer users use email and password, an emailed one-time code, and an emailed reset link; customer social sign-in and customer SSO are excluded. Staff use Meridian Microsoft accounts.\",\n  \"Who created and last changed each record, and when, are retained; no full audit trail is required.\",\n  \"The latest two versions of Chrome, Edge, Safari, and Firefox are supported.\",\n  \"WCAG 2.1 AA applies to the main flows.\",\n  \"Use the configured local time zone of the serving warehouse for order cut-offs, working days, delivery dates, and route times.\",\n  \"Support up to 1,000 users and 100,000 records in the first year in addition to 5,000 reporting devices.\"\n ]\n}\n</artifact>\n\nReview the spec."}