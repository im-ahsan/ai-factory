 ]\n   },\n   {\n    \"acceptance\": [\n     {\n      \"given\": \"A customer taps submit more than once or retries after a network interruption\",\n      \"id\": \"AC-REQ-19.1\",\n      \"level\": \"ui\",\n      \"then\": \"the captured request uses the same submission key and the screen shows one returned order record\",\n      \"when\": \"the web app sends the submission or retry\"\n     }\n    ],\n    \"ears\": \"When a customer submits an order, the Meridian responsive web app shall attach the same submission key to a retry of that submission and display the returned order rather than creating a second client-side order.\",\n    \"id\": \"REQ-19\",\n    \"op\": \"ADDED\",\n    \"sources\": [\n     \"I-10\"\n    ]\n   },\n   {\n    \"acceptance\": [\n     {\n      \"given\": \"An order has been allocated or partly allocated\",\n      \"id\": \"AC-REQ-20.1\",\n      \"level\": \"ui\",\n      \"then\": \"the screen shows the returned lot allocations, expiry dates, quantities, outstanding amounts, and order status\",\n      \"when\": \"a Dispatcher or customer user opens its details\"\n     },\n     {\n      \"given\": \"The API returns an allocation refusal or no suitable stock result\",\n      \"id\": \"AC-REQ-20.2\",\n      \"level\": \"ui\",\n      \"then\": \"the screen shows the returned refusal or availability message and the outstanding quantity field\",\n      \"when\": \"the order details refresh\"\n     }\n    ],\n    \"ears\": \"The Meridian responsive web app shall show the allocation returned for each order line, including lot, expiry, allocated quantity, outstanding quantity, and the order's allocation status.\",\n    \"id\": \"REQ-20\",\n    \"op\": \"ADDED\",\n    \"sources\": [\n     \"I-10\",\n     \"I-11\",\n     \"ASM-5\"\n    ]\n   },\n   {\n    \"acceptance\": [\n     {\n      \"given\": \"A Dispatcher selects a different lot for an order line\",\n      \"id\": \"AC-REQ-21.1\",\n      \"level\": \"ui\",\n      \"then\": \"the screen shows a required reason field and the selected lot and quantity fields\",\n      \"when\": \"the override form renders\"\n     },\n     {\n      \"given\": \"An override would use stock that is not Released or would violate minimum shelf life\",\n      \"id\": \"AC-REQ-21.2\",\n      \"level\": \"ui\",\n      \"then\": \"the screen shows the refusal message and the returned allocation remains displayed\",\n      \"when\": \"the API refuses the override\"\n     }\n    ],\n    \"ears\": \"The Meridian responsive web app shall require a reason for a Dispatcher lot-allocation override and show any API refusal of an override.\",\n    \"id\": \"REQ-21\",\n    \"op\": \"ADDED\",\n    \"sources\": [\n     \"I-11\"\n    ]\n   },\n   {\n    \"acceptance\": [\n     {\n      \"given\": \"Allocated stock changes to On Hold, Rejected, Recalled, or Expired\",\n      \"id\": \"AC-REQ-22.1\",\n      \"level\": \"ui\",\n      \"then\": \"the screen shows the returned removed allocation, replacement allocation outcome, outstanding quantity, and dispatcher message\",\n      \"when\": \"the order view refreshes\"\n     }\n    ],\n    \"ears\": \"When allocated stock becomes On Hold, Rejected, Recalled, or Expired, the Meridian responsive web app shall show the returned replacement-allocation outcome and dispatcher message.\",\n    \"id\": \"REQ-22\",\n    \"op\": \"ADDED\",\n    \"sources\": [\n     \"I-10\",\n     \"I-11\",\n     \"I-14\",\n     \"I-17\"\n    ]\n   },\n   {\n    \"acceptance\": [\n     {\n      \"given\": \"A Warehouse Operator packs stock into a box\",\n      \"id\": \"AC-REQ-23.1\",\n      \"level\": \"ui\",\n      \"then\": \"the screen shows fields for box type, logger identifier, delivery stop, products, lots, and quantities\",\n      \"when\": \"the packing form renders\"\n     },\n     {\n      \"given\": \"A box has no logger, a logger is already in an open box, or its contents violate a returned packing rule\",\n      \"id\": \"AC-REQ-23.2\",\n      \"level\": \"ui\",\