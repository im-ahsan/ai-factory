<div class="flex items-center justify-between pb-6 border-b border-[#D5D5D5] animate-stage-1">
<div>
<h1 class="text-[28px] leading-[1.2] font-headline font-[650] text-[#202020] tracking-[-0.025em]">
          Recalls
        </h1>
<p class="text-sm text-[#626262] mt-1 font-normal">
          Active lot quarantines, manufacturer revocations and product returns.
        </p>
</div>
<div class="flex items-center space-x-3">
<!-- Direct page control: Start recall -->
<button class="btn-press focus-ring h-12 px-6 bg-[#A94B1D] hover:bg-[#893405] text-[#FFFFFF] text-[15px] font-medium rounded-[2px] transition-colors inline-flex items-center justify-center" type="button">
          Start recall
        </button>
</div>
</div>
<!-- Empty State Container Panel -->
<div class="mt-8 flex-1 flex flex-col animate-stage-2">
<div class="bg-[#FFFFFF] border border-[#D5D5D5] rounded-[2px] w-full min-h-[460px] flex flex-col items-center justify-center px-6 py-16 text-center">
