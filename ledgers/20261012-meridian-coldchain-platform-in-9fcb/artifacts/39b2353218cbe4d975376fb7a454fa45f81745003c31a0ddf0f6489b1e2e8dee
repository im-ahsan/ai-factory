<div class="w-14 h-14 rounded-[2px] bg-[#F7F7F7] border border-[#D5D5D5] flex items-center justify-center mb-6 text-[#626262]">
<svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-linecap="square" stroke-linejoin="miter" stroke-width="1.75" viewbox="0 0 24 24">
