<!DOCTYPE html>

<html lang="en">
<head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<title>New profile version</title>
<link href="https://fonts.googleapis.com" rel="preconnect"/>
<link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect"/>
<link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@600;650;700&amp;family=IBM+Plex+Mono:wght@400;500;600&amp;family=Public+Sans:wght@400;500;600&amp;display=swap" rel="stylesheet"/>
<script src="https://cdn.tailwindcss.com"></script>
<style>
    :root {
      --bg: #F7F7F7;
      --surface: #FFFFFF;
      --text: #202020;
      --text-quiet: #626262;
      --border: #D5D5D5;
      --primary: #A94B1D;
      --status-good: #24704B;
      --status-waiting: #805800;
      --status-refused: #AE2C2C;
    }

    body {
      background-color: var(--bg);
      color: var(--text);
      font-family: 'Public Sans', sans-serif;
      margin: 0;
      padding: 0;
      -webkit-font-smoothing: antialiased;
    }

    h1, h2, h3, h4, .font-heading {
      font-family: 'Hanken Grotesk', sans-serif;
    }

    .font-mono-val {
      font-family: 'IBM Plex Mono', monospace;
    }

    .panel {
      background-color: var(--surface);
      border: 1px solid var(--border);
      border-radius: 2px;
    }

    /* Motion tokens */
    @keyframes entranceFadeIn {
      from {
        opacity: 0;
        transform: translateY(6px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes waitingBreathe {
      0%, 100% {
        opacity: 0.7;
      }
      50% {
        opacity: 1;
      }
    }

    .animate-entrance {
      animation: entranceFadeIn 260ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    .status-dot-waiting {
      display: inline-block;
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background-color: var(--status-waiting);
      animation: waitingBreathe 6s ease-in-out infinite;
    }

    .status-dot-good {
      display: inline-block;
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background-color: var(--status-good);
    }

    .status-dot-refused {
      display: inline-block;
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background-color: var(--status-refused);
    }

    /* Button interactions */
    .btn-primary {
      height: 48px;
      background-color: var(--primary);
      color: #FFFFFF;
      border-radius: 2px;
      font-weight: 600;
      font-size: 16px;
      padding: 0 24px;
      border: none;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: opacity 120ms ease, transform 90ms ease;
    }

    .btn-primary:hover {
      opacity: 0.92;
    }

    .btn-primary:active {
      transform: scale(0.98);
    }

    .btn-primary:focus-visible {
      outline: 2px solid var(--primary);
      outline-offset: 2px;
    }

    .btn-secondary {
      height: 48px;
      background-color: var(--surface);
      color: var(--text);
      border: 1px solid var(--border);
      border-radius: 2px;
      font-weight: 500;
      font-size: 16px;
      padding: 0 24px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: background-color 120ms ease, transform 90ms ease;
    }

    .btn-secondary:hover {
      background-color: #F0F0F0;
    }

    .btn-secondary:active {
      transform: scale(0.98);
    }

    .btn-secondary:focus-visible {
      outline: 2px solid var(--primary);
      outline-offset: 2px;
    }

    /* Form fields */
    .form-input {
      height: 48px;
      background-color: var(--surface);
      border: 1px solid var(--border);
      border-radius: 2px;
      color: var(--text);
      font-size: 16px;
      padding: 0 16px;
      width: 100%;
      box-sizing: border-box;
      transition: border-color 120ms ease;
    }

    .form-input:focus {
      outline: none;
      border-color: var(--primary);
      box-shadow: 0 0 0 1px var(--primary);
    }

    .form-input-sm {
      height: 40px;
      background-color: var(--surface);
      border: 1px solid var(--border);
      border-radius: 2px;
      color: var(--text);
      font-size: 15px;
      padding: 0 12px;
      box-sizing: border-box;
      transition: border-color 120ms ease;
    }

    .form-input-sm:focus {
      outline: none;
      border-color: var(--primary);
      box-shadow: 0 0 0 1px var(--primary);
    }

    /* Nav bar link interaction */
    .nav-item {
      color: var(--text);
      text-decoration: none;
      font-size: 15px;
      padding-bottom: 12px;
      border-bottom: 2px solid transparent;
      transition: color 120ms ease, border-color 120ms ease;
    }

    .nav-item:hover {
      color: var(--primary);
    }

    .nav-item.active {
      color: var(--primary);
      font-weight: 600;
      border-bottom-color: var(--primary);
    }

    .nav-item:focus-visible {
      outline: 2px solid var(--primary);
      outline-offset: 4px;
    }

    /* Table specifics */
    .data-table th {
      height: 48px;
      font-size: 14px;
      font-weight: 600;
      color: var(--text-quiet);
      text-align: left;
      border-bottom: 1px solid var(--border);
      padding: 0 16px;
      background-color: #FAFAFA;
    }

    .data-table td {
      height: 48px;
      font-size: 15px;
      border-bottom: 1px solid var(--border);
      padding: 0 16px;
      vertical-align: middle;
    }

    .data-table tr:last-child td {
      border-bottom: none;
    }

    @media (prefers-reduced-motion: reduce) {
      *, ::before, ::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
      }
    }
  </style>
</head>
