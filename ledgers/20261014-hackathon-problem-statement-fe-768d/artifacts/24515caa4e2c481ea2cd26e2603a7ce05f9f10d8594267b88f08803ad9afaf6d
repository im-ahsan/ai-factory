ssignments\").EnumerateArray());\n        Has(assignment, \"lotId\", \"lotName\", \"penId\", \"penName\", \"requestedHeadCount\", \"capacity\", \"currentAnimalCount\", \"status\", \"problemDetail\");\n        Assert.Equal(12, assignment.GetProperty(\"requestedHeadCount\").GetInt32());\n    }\n\n    [Fact]\n    public async Task AC_1_7_AssumptionUpdateReturnsUpdatedForecast()\n    {\n        var data = await WithDbAsync(CreateOperationalFixtureAsync);\n        using var json = await PatchJsonAsync($\"/lots/{data.LotId}/assumptions\", new\n        {\n            targetWeightLb = 1400m,\n            defaultGainRateLbPerDay = 2.7m\n        }, HttpStatusCode.OK);\n        AssertForecast(json.RootElement, data.LotId);\n        Assert.Equal(1400m, json.RootElement.GetProperty(\"targetWeightLb\").GetDecimal());\n        Assert.Equal(2.7m, json.RootElement.GetProperty(\"gainRateLbPerDay\").GetDecimal());\n    }\n\n    [Fact]\n    public async Task AC_1_8_LotForecastContainsForecastFields()\n    {\n        var data = await WithDbAsync(CreateOperationalFixtureAsync);\n        using var json = await GetJsonAsync($\"/lots/{data.LotId}/forecast\", HttpStatusCode.OK);\n        AssertForecast(json.RootElement, data.LotId);\n    }\n\n    [Fact]\n    public async Task AC_1_9_InventoryResponseContainsStockPropertiesAndMovements()\n    {\n        var data = await WithDbAsync(async db =>\n        {\n            var core = await CreateOperationalFixtureAsync(db);\n            await InsertInventoryMovementAsync(db, core.ItemId, \"received\", 100m, \"Restock\");\n            return core;\n        });\n        using var json = await GetJsonAsync(\"/inventory/items\", HttpStatusCode.OK);\n        Has(json.RootElement, \"wastageRatio\", \"items\");\n        var item = Assert.Single(json.RootElement.GetProperty(\"items\").EnumerateArray(), e => e.GetProperty(\"id\").GetInt32() == data.ItemId);\n        AssertInventoryItem(item);\n        Assert.NotEmpty(item.GetProperty(\"movements\").Enumerat