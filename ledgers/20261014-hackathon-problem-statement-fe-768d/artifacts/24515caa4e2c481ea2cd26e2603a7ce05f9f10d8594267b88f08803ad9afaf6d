ry/movements\"),\n            (HttpMethod.Post, \"/inventory/wastage\"),\n            (HttpMethod.Patch, \"/inventory/settings\"),\n            (HttpMethod.Post, \"/rations\"),\n            (HttpMethod.Post, \"/rations/optimize\"),\n            (HttpMethod.Post, \"/rations/selection\"),\n            (HttpMethod.Post, \"/feeding/plans\"),\n            (HttpMethod.Post, \"/feeding/activities\"),\n            (HttpMethod.Post, \"/lots/2147483647/weight-readings\"),\n            (HttpMethod.Put, \"/lots/2147483647/weight-readings/2147483647\"),\n            (HttpMethod.Post, \"/demo-data/load\")\n        };\n        foreach (var (method, path) in malformedRequests)\n        {\n            using var request = new HttpRequestMessage(method, path)\n            {\n                Content = new StringContent(\"{\", Encoding.UTF8, \"application/json\")\n            };\n            using var response = await _client.SendAsync(request);\n            using var badRequest = await ReadJsonAsync(response, HttpStatusCode.BadRequest);\n            AssertErrorResponse(badRequest.RootElement, \"bad_request\");\n        }\n\n        using var missingLot = await GetJsonAsync(\"/lots/2147483647/forecast\", HttpStatusCode.NotFound);\n        AssertErrorResponse(missingLot.RootElement, \"not_found\");\n\n        var data = await WithDbAsync(CreateOperationalFixtureAsync);\n        using var conflict = await PostJsonAsync(\"/feeding/activities\", new\n        {\n            penId = data.PenId, date = \"2026-10-14\", rationId = data.RationId, feedingPlanId = (int?)null,\n            lotQuantities = new[] { new { lotId = data.LotId, actualQuantityLb = 20000m } }\n        }, HttpStatusCode.Conflict);\n        AssertErrorResponse(conflict.RootElement, \"conflict\");\n\n        using var validation = await GetJsonAsync(\"/inventory/outlook?horizon=decennial&wastageRatio=0.05\", HttpStatusCode.UnprocessableEntity);\n        AssertErrorResponse(validation.RootElement, \"validation_error\");\n    }\