Property(x => x.Status).IsRequired();\n            builder.Property(x => x.TargetWeightLb).IsRequired();\n            builder.Property(x => x.DefaultGainRateLbPerDay).IsRequired();\n        }\n    }\n}\n\n[Table(\"ImportBatches\")]\ninternal sealed class ImportBatchEntity\n{\n    public string BatchId { get; set; } = \"\";\n    public string SourceName { get; set; } = \"\";\n    public ICollection<ImportRowEntity> Rows { get; set; } = new List<ImportRowEntity>();\n}\n\n[Table(\"ImportRows\")]\ninternal sealed class ImportRowEntity\n{\n    public int Id { get; set; }\n    public string BatchId { get; set; } = \"\";\n    public ImportBatchEntity Batch { get; set; } = null!;\n    public string SourceIdentifier { get; set; } = \"\";\n    public string SourceType { get; set; } = \"\";\n    public string Vendor { get; set; } = \"\";\n    public decimal Cost { get; set; }\n    public int HeadCount { get; set; }\n    public decimal WeightLb { get; set; }\n    public string Breed { get; set; } = \"\";\n    public int AgeDays { get; set; }\n    public string Source { get; set; } = \"\";\n    public string RowStatus { get; set; } = \"\";\n    public string? ProblemDetail { get; set; }\n}\n\n[Table(\"Pens\")]\ninternal sealed class PenEntity\n{\n    public int Id { get; set; }\n    public string Name { get; set; } = \"\";\n    public int Capacity { get; set; }\n    public ICollection<LotEntity> Lots { get; set; } = new List<LotEntity>();\n}\n\n[Table(\"Lots\")]\ninternal sealed class LotEntity\n{\n    public int Id { get; set; }\n    public string Name { get; set; } = \"\";\n    public int? PenId { get; set; }\n    public PenEntity? Pen { get; set; }\n    public int HeadCount { get; set; }\n    public string Breed { get; set; } = \"\";\n    public string Sex { get; set; } = \"\";\n    public string SourcePurchaseOrderLine { get; set; } = \"\";\n    public string Status { get; set; } = \"\";\n    public decimal TargetWeightLb { get; set; }\n    public decimal DefaultGainRateLbPerDay { get; set; }\n}\nusing System.ComponentModel.DataAnnotations.Schema;\nusing Microsoft.EntityFrameworkCore;\nusing Microsoft.EntityFrameworkCore.Metadata.Builders;\n\nnamespace App.Api.Data;\n\n[Table(\"Rations\")]\ninternal sealed class RationEntity\n{\n    public int Id { get; set; }\n    public string Name { get; set; } = \"\";\n    public string Type { get; set; } = \"\";\n    public decimal TargetWeightMinLb { get; set; }\n    public decimal TargetWeightMaxLb { get; set; }\n    public string OperationalStatus { get; set; } = \"\";\n    public ICollection<RationIngredientEntity> Ingredients { get; set; } = new List<RationIngredientEntity>();\n}\n\n[Table(\"RationIngredients\")]\ninternal sealed class RationIngredientEntity\n{\n    public int Id { get; set; }\n    public int RationId { get; set; }\n    public RationEntity Ration { get; set; } = null!;\n    public int ItemId { get; set; }\n    public InventoryItemEntity Item { get; set; } = null!;\n    public decimal ProportionPercent { get; set; }\n}\n\n[Table(\"RationCandidates\")]\ninternal sealed class RationCandidateEntity\n{\n    public int CandidateId { get; set; }\n    public bool Feasible { get; set; }\n    public decimal TargetWeightMinLb { get; set; }\n    public decimal TargetWeightMaxLb { get; set; }\n    public decimal MinimumDryMatterPercent { get; set; }\n    public decimal MinimumEnergyMcalPerKg { get; set; }\n    public decimal PredictedDryMatterPercent { get; set; }\n    public decimal PredictedEnergyMcalPerKg { get; set; }\n    public ICollection<RationCandidateIngredientEntity> Ingredients { get; set; } = new List<RationCandidateIngredientEntity>();\n}\n\n[Table(\"RationCandidateIngredients\")]\ninternal sealed class RationCandidateIngredientEntity\n{\n    public int Id { get; set; }\n    public int CandidateId { get; set; }\n    public RationCandidateEntity Candidate { get; set; } = null!;\n    public int ItemId { get; set; }\n    public InventoryItemEntity Item { get; set; } = null!;\n    public decimal ProportionPercent { get; set; }\n}\n\ninternal sealed class RationConfiguration : IEntityTypeConfiguration<RationEntity>\n{\n    public void Configure(EntityTypeBuilder<RationEntity> builder)\n    {\n        builder.ToTable(\"Rations\");\n        builder.HasKey(x => x.Id);\n        builder.Property(x => x.Id).ValueGeneratedOnAdd();\n        builder.HasIndex(x => x.Name).IsUnique();\n        builder.Property(x => x.Name).IsRequired();\n        builder.Property(x => x.Type).IsRequired();\n        builder.Property(x => x.TargetWeightMinLb).IsRequired();\n        builder.Property(x => x.TargetWeightMaxLb).IsRequired();\n        builder.Property(x => x.OperationalStatus).IsRequired();\n    }\n}\n\ninternal sealed class RationIngredientConfiguration : IEntityTypeConfiguration<RationIngredientEntity>\n{\n    public void Configure(EntityTypeBuilder<RationIngredientEntity> builder)\n    {\n        builder.ToTable(\"RationIngredients\");\n        builder.HasKey(x => x.Id);\n        builder.Property(x => x.Id).ValueGeneratedOnAdd();\n        builder.HasOne(x => x.Ration).WithMany(x => x.Ingredients).HasForeignKey(x => x.RationId)\n            .OnDelete(DeleteBehavior.Cascade);\n        builder.HasOne(x => x.Item).WithMany().HasForeignKey(x => x.ItemId)\n            .OnDelete(DeleteBehavior.Restrict);\n        builder.HasIndex(x => new { x.RationId, x.ItemId }).IsUnique();\n        builder.Property(x => x.ProportionPercent).IsRequired();\n    }\n}\n\ninternal sealed class RationCandidateConfiguration : IEntityTypeConfiguration<RationCandidateEntity>\n{\n    public void Configure(EntityTypeBuilder<RationCandidateEntity> builder)\n    {\n        builder.ToTable(\"RationCandidates\");\n        builder.HasKey(x => x.CandidateId);\n        builder.Property(x => x.CandidateId).ValueGeneratedOnAdd();\n        builder.Property(x => x.Feasible).IsRequired();\n        builder.Property(x => x.TargetWeightMinLb).IsRequired();\n        builder.Property(x => x.TargetWeightMaxLb).IsRequired();\n        builder.Property(x => x.MinimumDryMatterPercent).IsRequired();\n        builder.Property(x => x.MinimumEnergyMcalPerKg).IsRequired();\n        builder.Property(x => x.PredictedDryMatterPercent).IsRequired();\n        builder.Property(x => x.PredictedEnergyMcalPerKg).IsRequired();\n    }\n}\n\ninternal sealed class RationCandidateIngredientConfiguration : IEntityTypeConfiguration<RationCandidateIngredientEntity>\n{\n    public void Configure(EntityTypeBuilder<RationCandidateIngredientEntity> builder)\n    {\n        builder.ToTable(\"RationCandidateIngredients\");\n        builder.HasKey(x => x.Id);\n        builder.Property(x => x.Id).ValueGeneratedOnAdd();\n        builder.HasOne(x => x.Candidate).WithMany(x => x.Ingredients).HasForeignKey(x => x.CandidateId)\n            .OnDelete(DeleteBehavior.Cascade);\n        builder.HasOne(x => x.Item).WithMany().HasForeignKey(x => x.ItemId)\n            .OnDelete(DeleteBehavior.Restrict);\n        builder.HasIndex(x => new { x.CandidateId, x.ItemId }).IsUnique();\n        builder.Property(x => x.ProportionPercent).IsRequired();\n    }\n}\nusing System.ComponentModel.DataAnnotations.Schema;\nusing Microsoft.EntityFrameworkCore;\nusing Microsoft.EntityFrameworkCore.Metadata.Builders;\n\nnamespace App.Api.Data;\n\n[Table(\"InventoryItems\")]\ninternal sealed class InventoryItemEntity\n{\n    public int Id { get; set; }\n    public string Name { get; set; } = \"\";\n    public string Category { get; set; } = \"\";\n    public string Unit { get; set; } = \"\";\n    public decimal UnitCost { get; set; }\n    public decimal DryMatterPercent { get; set; }\n    public decimal EnergyMcalPerKg { get; set; }\n    public string StorageLocation { get; set; } = \"\";\n    public decimal OpeningStockLb { get; set; }\n    public ICollection<InventoryMovementEntity> Movements { get; set; } = new List<InventoryMovementEntity>();\n}\n\n[Table(\"InventoryMovements\")]\ninternal sealed class InventoryMovementEntity\n{\n    public int Id { get; set; }\n    public int ItemId { get; set; }\n    public InventoryItemEntity Item { get; set; } = null!;\n    public string MovementType { get; set; } = \"\";\n    public DateOnly Date { get; set; }\n    public decimal QuantityLb { get; set; }\n    public string Note { get; set; } = \"\";\n    public string? WastageCause { get; set; }\n}\n\n[Table(\"InventorySettings\")]\ninternal sealed class InventorySettingEntity\n{\n    public int Id { get; set; }\n    public string Scope { get; set; } = \"\";\n    public decimal WastageRatio { get; set; }\n}\n\ninternal sealed class InventoryItemConfiguration : IEntityTypeConfiguration<InventoryItemEntity>\n{\n    public void Configure(EntityTypeBuilder<InventoryItemEntity> builder)\n    {\n        builder.ToTable(\"InventoryItems\");\n        builder.HasKey(x => x.Id);\n        builder.Property(x => x.Id).ValueGeneratedOnAdd();\n        builder.HasIndex(x => x.Name).IsUnique();\n        builder.Property(x => x.Name).IsRequired();\n        builder.Property(x => x.Category).IsRequired();\n        builder.Property(x => x.Unit).IsRequired();\n        builder.Property(x => x.UnitCost).IsRequired();\n        builder.Property(x => x.DryMatterPercent).IsRequired();\n        builder.Property(x => x.EnergyMcalPerKg).IsRequired();\n        builder.Property(x => x.StorageLocation).IsRequired();\n        builder.Property(x => x.OpeningStockLb).IsRequired();\n    }\n}\n\ninternal sealed class InventoryMovementConfiguration : IEntityTypeConfiguration<InventoryMovementEntity>\n{\n    public void Configure(EntityTypeBuilder<InventoryMovementEntity> builder)\n    {\n        builder.ToTable(\"InventoryMovements\");\n        builder.HasKey(x => x.Id);\n        builder.Property(x => x.Id).ValueGeneratedOnAdd();\n        builder.HasOne(x => x.Item).WithMany(x => x.Movements).HasForeignKey(x => x.ItemId)\n            .OnDelete(DeleteBehavior.Restrict);\n        builder.Property(x => x.MovementType).IsRequired();\n        builder.Property(x => x.Date).IsRequired();\n        builder.Property(x => x.QuantityLb).IsRequired();\n        builder.Property(x => x.Note).IsRequired();\n    }\n}\n\ninternal sealed class InventorySettingConfiguration : IEntityTypeConfiguration<InventorySettingEntity>\n{\n    public void Configure(EntityTypeBuilder<InventorySettingEntity> builder)\n    {\n        builder.ToTable(\"InventorySettings\");\n        builder.HasKey(x => x.Id);\n        builder.Property(x => x.Id).ValueGeneratedOnAdd();\n        builder.HasIndex(x => x.Scope).IsUnique();\n        builder.Property(x => x.Scope).IsRequired();\n        builder.Property(x => x.WastageRatio).IsRequired();\n    }\n}\n","chars":13914,"exitCode":1}
