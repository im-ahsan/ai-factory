ertWeightReadingAsync(db, lotId, \"2026-10-01\", 700m);\n        return new OperationalFixture(itemId, penId, lotId, rationId, planId, activityId);\n    }\n\n    private static async Task<int> InsertItemAsync(AppDb db, string name) => await ScalarAsync<int>(db,\n        \"INSERT INTO \\\"InventoryItems\\\" (\\\"Name\\\", \\\"Category\\\", \\\"Unit\\\", \\\"UnitCost\\\", \\\"DryMatterPercent\\\", \\\"EnergyMcalPerKg\\\", \\\"StorageLocation\\\", \\\"OpeningStockLb\\\") VALUES (@p0, 'Feed', 'lb', 0.2, 88, 3.2, 'Bin A', 10000) RETURNING \\\"Id\\\"\", name);\n\n    private static async Task<int> InsertPenAsync(AppDb db, string name, int capacity) => await ScalarAsync<int>(db,\n        \"INSERT INTO \\\"Pens\\\" (\\\"Name\\\", \\\"Capacity\\\") VALUES (@p0, @p1) RETURNING \\\"Id\\\"\", name, capacity);\n\n    private static async Task<int> InsertLotAsync(AppDb db, string name, int penId, string sourceLine) => await ScalarAsync<int>(db,\n        \"INSERT INTO \\\"Lots\\\" (\\\"Name\\\", \\\"PenId\\\", \\\"HeadCount\\\", \\\"Breed\\\", \\\"Sex\\\", \\\"SourcePurchaseOrderLine\\\", \\\"Status\\\", \\\"TargetWeightLb\\\", \\\"DefaultGainRateLbPerDay\\\") VALUES (@p0, @p1, 40, 'Angus', 'steer', @p2, 'Active', 1400, 2.5) RETURNING \\\"Id\\\"\", name, penId, sourceLine);\n\n    private static async Task<int> InsertRationAsync(AppDb db, string name, int itemId)\n    {\n        var id = await ScalarAsync<int>(db,\n            \"INSERT INTO \\\"Rations\\\" (\\\"Name\\\", \\\"Type\\\", \\\"TargetWeightMinLb\\\", \\\"TargetWeightMaxLb\\\", \\\"OperationalStatus\\\") VALUES (@p0, 'Grower', 500, 1400, 'Active') RETURNING \\\"Id\\\"\", name);\n        await ExecuteAsync(db, \"INSERT INTO \\\"RationIngredients\\\" (\\\"RationId\\\", \\\"ItemId\\\", \\\"ProportionPercent\\\") VALUES (@p0, @p1, 100)\", id, itemId);\n        return id;\n    }\n\n    private static async Task<int> InsertPlanAsync(AppDb db, int penId, int rationId) => await ScalarAsync<int>(db,\n        \"INSERT INTO \\\"FeedingPlans\\\" (\\\"PenId\\\", \\\"RationId\\\", \\\"PlanDate\\\", \\\"DailyBunkRateLbPerHead\\\", \\\"CurrentPenHeadcount\\\", \\\"PlannedTime\\\", \\\"Status\\\") VALUES (@p0, @p1, DATE '2026-10-14', 25, 40, TIME '07:00', 'Planned') RETURNING \\\"Id\\\"\", penId, rationId);\n\n    private static async Task<int> InsertPlanForDateAsync(AppDb db, int penId, int rationId, string date) => await ScalarAsync<int>(db,\n        \"INSERT INTO \\\"FeedingPlans\\\" (\\\"PenId\\\", \\\"RationId\\\", \\\"PlanDate\\\", \\\"DailyBunkRateLbPerHead\\\", \\\"CurrentPenHeadcount\\\", \\\"PlannedTime\\\", \\\"Status\\\") VALUES (@p0, @p1, @p2, 25, 40, TIME '07:00', 'Planned') RETURNING \\\"Id\\\"\", penId, rationId, DateOnly.Parse(date));\n\n    private static async Task<int> InsertActivityAsync(AppDb db, int penId, int rationId, int? planId, decimal quantity, decimal cost) => await ScalarAsync<int>(db,\n        \"INSERT INTO \\\"FeedingActivities\\\" (\\\"ActivityDate\\\", \\\"PenId\\\", \\\"RationId\\\", \\\"FeedingPlanId\\\", \\\"Manager\\\", \\\"ActualQuantityLb\\\", \\\"FeedCost\\\", \\\"EnergyMcal\\\") VALUES (DATE '2026-10-14', @p0, @p1, @p2, 'Acceptance manager', @p3, @p4, 250) RETURNING \\\"Id\\\"\", penId, rationId, planId, quantity, cost);\n\n    private static async Task<int> InsertActivityForDateAsync(AppDb db, int penId, int rationId, string date,\n        decimal quantity, decimal cost, int? lotId = null)\n    {\n        var activityId = await ScalarAsync<int>(db,\n            \"INSERT INTO \\\"FeedingActivities\\\" (\\\"ActivityDate\\\", \\\"PenId\\\", \\\"RationId\\\", \\\"FeedingPlanId\\\", \\\"Manager\\\", \\\"ActualQuantityLb\\\", \\\"FeedCost\\\", \\\"EnergyMcal\\\") VALUES (@p0, @p1, @p2, NULL, 'Acceptance manager', @p3, @p4, 250) RETURNING \\\"Id\\\"\",\n            DateOnly.Parse(date), penId, rationId, quantity, cost);\n        if (lotId.HasValue)\n            await ExecuteAsync(db, \"INSERT INTO \\\"FeedingActivityLotConsumptions\\\" (\\\"ActivityId\\\", \\\"LotId\\\", \\\"QuantityLb\\\") VALUES (@p0, @p1, @p2)\", activityId, lotId.Value, quantity);\n        return activityId;\n    }\n\n    private static async Task<int> InsertWeightReadingAsync(AppDb db, int lotId, string date, decimal weight) => await ScalarAsync<int>(db,\n        \"INSERT INTO \\\"WeightReadings\\\" (\\\"LotId\\\", \\\"MeasurementDate\\\", \\\"ApplicableHeadcount\\\", \\\"AverageWeightLb\\\", \\\"RecordedBy\\\", \\\"Notes\\\") VALUES (@p0, @p1, 40, @p2, 'Acceptance manager', 'Acceptance reading') RETURNING \\\"Id\\\"\", lotId, DateOnly.Parse(date), weight);\n\n    private static async Task InsertBatchAsync(AppDb db, string batchId) => await ExecuteAsync(db,\n        Assert.Equal(costs.OrderBy(c => c), costs);\n    }\n\n    private static void AssertCandidate(JsonElement candidate, bool feasible)\n    {\n        Has(candidate, \"candidateId\", \"feasible\", \"costPerLb\", \"ingredients\", \"predictedDryMatterPercent\", \"predictedEnergyMcalPerKg\");\n        Assert.Equal(feasible, candidate.GetProperty(\"feasible\").GetBoolean());\n        foreach (var ingredient in candidate.GetProperty(\"ingredients\").EnumerateArray()) Has(ingredient, \"itemId\", \"name\", \"proportionPercent\", \"dryMatterPercent\", \"energyMcalPerKg\", \"costPerLb\");\n    }\n\n    private static void AssertFeedingPlan(JsonElement plan) => Has(plan, \"id\", \"date\", \"penId\", \"penName\", \"lotId\", \"lotName\", \"animalCount\", \"rationId\", \"rationName\", \"plannedQuantityLb\", \"plannedTime\", \"quantityPerAnimalLb\", \"totalFeedCost\", \"expectedEnergyMcal\", \"status\", \"actualQuantityLb\", \"varianceLb\");\n\n    private static void AssertFeedingActivity(JsonElement activity) => Has(activity, \"id\", \"date\", \"penId\", \"penName\", \"manager\", \"rationId\", \"rationName\", \"feedingPlanId\", \"plannedQuantityLb\", \"actualQuantityLb\", \"varianceLb\", \"status\", \"feedCost\", \"energyMcal\", \"ingredientConsumption\", \"lotConsumption\");\n\n    private static void A