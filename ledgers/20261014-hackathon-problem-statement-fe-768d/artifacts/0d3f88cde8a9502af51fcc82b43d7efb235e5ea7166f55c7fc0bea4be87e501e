n            var db = scope.ServiceProvider.GetRequiredService<AppDb>();\n            await db.Database.OpenConnectionAsync();\n            var connection = db.Database.GetDbConnection();\n            foreach (var tableName in PersistentTables)\n            {\n                await using var command = connection.CreateCommand();\n                command.CommandText = \"SELECT COUNT(*) FROM information_schema.columns WHERE table_schema = current_schema() AND table_name = @p0\";\n                var parameter = command.CreateParameter();\n                parameter.ParameterName = \"p0\";\n                parameter.Value = tableName;\n                command.Parameters.Add(parameter);\n                var columnCount = Convert.ToInt32(await command.ExecuteScalarAsync());\n                Assert.True(columnCount > 0, $\"Expected row-capable persistent table '{tableName}'.\");\n            }\n        }\n\n        private async Task ExecuteSeedSqlAsync(FormattableString sql)\n        {\n            using var scope = _factory.Services.CreateScope();\n            var db = scope.ServiceProvider.GetRequiredService<AppDb>();\n            await db.Database.ExecuteSqlInterpolatedAsync(sql);\n        }\n\n        public void Dispose()\n        {\n            Client.Dispose();\n            _factory.Dispose();\n        }\n    }\n}\nApp.Tests/AcceptancePart4Tests.cs:16:    private static readonly string[] PersistentTables =\nApp.Tests/AcceptancePart4Tests.cs:34:        await AssertEveryTableEmptyAsync(factory);\nApp.Tests/AcceptancePart4Tests.cs:36:        await AssertCollectionsEmptyAsync(client, \"/imports/batches\", \"batches\");\nApp.Tests/AcceptancePart4Tests.cs:37:        await AssertCollectionsEmptyAsync(client, \"/lots\", \"lots\", \"pens\");\nApp.Tests/AcceptancePart4Tests.cs:38:        await AssertCollectionsEmptyAsync(client, \"/inventory/items\", \"items\");\nApp.Tests/AcceptancePart4Tests.cs:39:        await AssertCollectionsEmptyAsync(client, \"/rations\", \"rations\")