iven\": \"A known import batch is available for synchronization.\",\n      \"id\": \"AC-REQ-1.4\",\n      \"level\": \"api\",\n      \"then\": \"The response status is 200 and the returned ImportSyncResponse contains the documented outcome counts, partial value, and row outcomes.\",\n      \"when\": \"A client sends POST /imports/synchronize with the contract's ImportPreviewRequest body.\"\n     },\n     {\n      \"given\": \"Lots and pens are available.\",\n      \"id\": \"AC-REQ-1.5\",\n      \"level\": \"api\",\n      \"then\": \"The response status is 200 and the returned lots and pens lists contain records matching the required Lot and Pen fields.\",\n      \"when\": \"A client sends GET /lots.\"\n     },\n     {\n      \"given\": \"The source purchase-order line, lots, and pens in a mapping request exist.\",\n      \"id\": \"AC-REQ-1.6\",\n      \"level\": \"api\",\n      \"then\": \"The response status is 200 and the returned assignment records include the source line, requested headcount, capacity, current animal count, status, and problemDetail fields.\",\n      \"when\": \"A client sends POST /lots/mappings with a valid LotMappingRequest.\"\n     },\n     {\n      \"given\": \"The requested lot exists and the assumptions are valid.\",\n      \"id\": \"AC-REQ-1.7\",\n      \"level\": \"api\",\n      \"then\": \"The response status is 200 and the returned ForecastResponse contains the lotId, updated target weight and gain rate, gainRateBasis, projectedMarketDate, and recommendations.\",\n      \"when\": \"A client sends PATCH /lots/{lotId}/assumptions with targetWeightLb and defaultGainRateLbPerDay.\"\n     },\n     {\n      \"given\": \"The requested lot exists.\",\n      \"id\": \"AC-REQ-1.8\",\n      \"level\": \"api\",\n      \"then\": \"The response status is 200 and the returned ForecastResponse contains targetWeightLb, gainRateLbPerDay, gainRateBasis, projectedMarketDate, and recommendations.\",\n      \"when\": \"A client sends GET /lots/{lotId}/forecast.\"\n     },\n     {\n      \"given\": \"Feed inventory records exist.\",\n      \"id\": \"AC-REQ-1.9\",\n      \"level\": \"api\",\n      \"then\": \"The response status is 200 and the returned inventory response contains wastageRatio and item records with stock totals and movement history.\",\n      \"when\": \"A client sends GET /inventory/items.\"\n     },\n     {\n      \"given\": \"The inventory item exists and the requested received or adjustment movement is valid.\",\n      \"id\": \"AC-REQ-1.10\",\n      \"level\": \"api\",\n      \"then\": \"The response status is 201 and the returned movement and item reflect the submitted itemId, movementType, date, quantityLb, and note.\",\n      \"when\": \"A client sends POST /inventory/movements.\"\n     },\n     {\n      \"given\": \"The inventory item exists and the actual wastage request is valid.\",\n      \"id\": \"AC-REQ-1.11\",\n      \"level\": \"api\",\n      \"then\": \"The response status is 201 and the returned movement and item include the actual_wastage quantity, date, and wastage cause.\",\n      \"when\": \"A client sends POST /inventory/wastage.\"\n     },\n     {\n      \"given\": \"The requested wastageRatio is valid.\",\n      \"id\": \"AC-REQ-1.12\",\n      \"level\": \"api\",\n      \"then\": \"The response status is 200 and the returned InventorySettingsResponse value equals the saved wastageRatio.\",\n      \"when\": \"A client sends PATCH /inventory/settings.\"\n     },\n     {\n      \"given\": \"Inventory data exists and a supported horizon and valid wastageRatio are supplied.\",\n      \"id\": \"AC-REQ-1.13\",\n      \"level\": \"api\",\n      \"then\": \"Each response status is 200 and each returned OutlookResponse contains the requested horizon, wastageRatio, and per-item current stock, daily estimated consumption, and projected balance fields.\",\n      \"when\": \"A client sends GET /inventory/outlook for each contract horizon: daily, weekly, monthly, quarterly, bi-annual, and annual.\"\n     },\n     {\n      \"given\": \"Ration records exist.\",\n      \"id\": \"AC-REQ-1.14\",\n      \"level\": \"api\",\n      \"then\": \"The response status is 200 and the returned rations list contains records with the required ration and ingredient fields.\",\n      \"when\": \"A client sends GET /rations.\"\n     },\n     {\n      \"given\": \"Every ingredient item exists and the ration request is valid.\",\n      \"id\": \"AC-REQ-1.15\",\n      \"level\": \"api\",\n      \"then\": \"The response status is 201 and the returned ration includes its identity, type, target weight range, operational status, ingredients, and calculated costPerLb.\",\n      \"when\": \"A client sends POST /rations.\"\n     },\n     {\n      \"given\": \"Inventory ingredients are available and the optimization request is valid.\",\n      \"id\": \"AC-REQ-1.16\",\n      \"level\": \"api\",\n      \"then\": \"The response status is 200 and the returned feasibleCandidates and infeasibleCandidates contain candidate feasibility, ingredient mix, costPerLb, predicted dry matter, and predicted energy fields in the contract's cost order.\",\n      \"when\": \"A client sends POST /rations/optimize.\"\n     },\n     {\n      \"given\": \"The requested candidateId is available for selection.\",\n      \"id\": \"AC-REQ-1.17\",\n      \"level\": \"api\",\n      \"then\": \"The response status is 200 and the returned selectedCandidate matches the requested candidate and the applied field is false.\",\n      \"when\": \"A client sends POST /rations/selection.\"\n     },\n     {\n      \"given\": \"Feeding plans exist for the requested date and pen.\",\n      \"id\": \"AC-REQ-1.18\",\n      \"level\": \"api\",\n      \"then\": \"The response status is 200 and the returned plans list contains FeedingPlan records matching the supplied filters and required schema fields.\",\n      \"when\": \"A client sends GET /feeding/plans with optional date and penId filters.\"\n     },\n     {\n      \"given\"