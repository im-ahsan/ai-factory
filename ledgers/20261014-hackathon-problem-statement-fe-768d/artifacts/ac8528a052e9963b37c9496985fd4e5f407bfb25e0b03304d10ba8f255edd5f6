tifact id=\"previous-change\" kind=\"diff\" sha=\"\">\nYour previous change (diff from the task start; it is already in the files):\ndiff --git a/App.Api/Data/DemoEntities.cs b/App.Api/Data/DemoEntities.cs\nnew file mode 100644\nindex 0000000..5f84841\n--- /dev/null\n+++ b/App.Api/Data/DemoEntities.cs\n@@ -0,0 +1,55 @@\n+using System.ComponentModel.DataAnnotations.Schema;\n+using Microsoft.EntityFrameworkCore;\n+using Microsoft.EntityFrameworkCore.Metadata.Builders;\n+\n+namespace App.Api.Data;\n+\n+internal static class DemoEntities\n+{\n+    internal sealed class DemoLoadRunConfiguration : IEntityTypeConfiguration<DemoLoadRunEntity>\n+    {\n+        public void Configure(EntityTypeBuilder<DemoLoadRunEntity> builder)\n+        {\n+            builder.ToTable(\"DemoLoadRuns\");\n+            builder.HasKey(x => x.DatasetId);\n+            builder.Property(x => x.DatasetId).ValueGeneratedNever();\n+            builder.Property(x => x.DatasetId).IsRequired();\n+        }\n+    }\n+\n+    internal sealed class DemoLoadOutcomeConfiguration : IEntityTypeConfiguration<DemoLoadOutcomeEntity>\n+    {\n+        public void Configure(EntityTypeBuilder<DemoLoadOutcomeEntity> builder)\n+        {\n+            builder.ToTable(\"DemoLoadOutcomes\");\n+            builder.HasKey(x => x.Id);\n+            builder.Property(x => x.Id).ValueGeneratedOnAdd();\n+            builder.HasOne(x => x.Run).WithMany(x => x.Outcomes).HasForeignKey(x => x.DatasetId)\n+                .OnDelete(DeleteBehavior.Cascade);\n+            builder.Property(x => x.DatasetId).IsRequired();\n+            builder.Property(x => x.OutcomeType).IsRequired();\n+            builder.Property(x => x.RecordType).IsRequired();\n+            builder.Property(x => x.SourceIdentifier).IsRequired();\n+            builder.Property(x => x.Reason).IsRequired();\n+        }\n+    }\n+}\n+\n+[Table(\"DemoLoadRuns\")]\n+internal sealed class DemoLoadRunEntity\n+{\n+    public string DatasetId { get; set; } = \"\";\n+    public ICollection<DemoLoadOutcomeEntity> Outcomes { get; set; } = new List<DemoLoadOutcomeEntity>();\n+}\n+\n+[Table(\"DemoLoadOutcomes\")]\n+internal sealed class DemoLoadOutcomeEntity\n+{\n+    public int Id { get; set; }\n+    public string DatasetId { get; set; } = \"\";\n+    public DemoLoadRunEntity Run { get; set; } = null!;\n+    public string OutcomeType { get; set; } = \"\";\n+    public string RecordType { get; set; } = \"\";\n+    public string SourceIdentifier { get; set; } = \"\";\n+    public string Reason { get; set; } = \"\";\n+}\ndiff --git a/App.Api/Endpoints/DemoEndpoints.cs b/App.Api/Endpoints/DemoEndpoints.cs\nnew file mode 100644\nindex 0000000..a8076db\n--- /dev/null\n+++ b/App.Api/Endpoints/DemoEndpoints.cs\n@@ -0,0 +1,102 @@\n+using App.Api.Data;\n+using Microsoft.AspNetCore.Http;\n+using Microsoft.EntityFrameworkCore;\n+\n+namespace App.Api.Endpoints;\n+\n+internal sealed class DemoEndpoints : IEndpointModule\n+{\n+    private const string SupportedDatasetId = \"feedlot-demo-2026\";\n+\n+    public void MapEndpoints(IEndpointRouteBuilder app)\n+    {\n+        app.MapPost(\"/demo-data/load\", LoadDemoData)\n+            .WithName(\"loadDemoData\")\n+            .Produces<DemoLoadResponse>(StatusCodes.Status200OK)\n+            .Produces<ErrorResponse>(StatusCodes.Status400BadRequest)\n+            .Produces<ErrorResponse>(StatusCodes.Status409Conflict)\n+            .Produces<ErrorResponse>(StatusCodes.Status422UnprocessableEntity);\n+    }\n+\n+    private static async Task<IResult> LoadDemoData(DemoLoadRequest? request, AppDb db)\n+    {\n+        var datasetId = request?.DatasetId?.Trim();\n+        if (string.IsNullOrWhiteSpace(datasetId))\n+            return ApiErrors.ValidationError(details: [\"datasetId is required.\"]);\n+        if (!string.Equals(datasetId, SupportedDatasetId, StringComparison.Ordinal))\n+            return ApiErrors.ValidationError(details: [\"The requested datasetId is not supported.\"]);\n+\n+        var run = 