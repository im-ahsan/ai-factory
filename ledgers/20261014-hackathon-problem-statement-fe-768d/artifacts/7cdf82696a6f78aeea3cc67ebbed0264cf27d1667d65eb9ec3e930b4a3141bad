+using App.Api.Data;
+using Microsoft.AspNetCore.Http;
+using Microsoft.AspNetCore.OpenApi;
+using Microsoft.EntityFrameworkCore;
+using Microsoft.Extensions.Options;
+using Microsoft.OpenApi.Models;
+
+namespace App.Api.Endpoints;
+
+internal sealed class DemoEndpoints : IEndpointModule
+{
+    private const string SupportedDatasetId = "feedlot-demo-2026";
+
+    public void MapEndpoints(IEndpointRouteBuilder app)
+    {
+        app.ServiceProvider.GetRequiredService<IOptionsMonitor<OpenApiOptions>>().Get("v1")
+            .AddSchemaTransformer((schema, context, _) =>
+            {
+                if (context.JsonTypeInfo.Type == typeof(DemoLoadResponse))
+                {
+                    var itemSchema = new OpenApiSchema
+                    {
+                        Reference = new OpenApiReference { Type = ReferenceType.Schema, Id = nameof(DemoRecordOutcome) }
+                    };
+                    foreach (var propertyName in new[] { "alreadyPresentRecords", "failedRecords" })
+                    {
+                        if (schema.Properties.TryGetValue(propertyName, out var property))
+                            property.Items = itemSchema;
+                    }
+                }
+                return Task.CompletedTask;
+            });
+
+        app.MapPost("/demo-data/load", LoadDemoData)
+            .WithName("loadDemoData")
+            .Produces<DemoLoadResponse>(StatusCodes.Status200OK)
+            .Produces<ErrorResponse>(StatusCodes.Status400BadRequest)
+            .Produces<ErrorResponse>(StatusCodes.Status409Conflict)
+            .Produces<ErrorResponse>(StatusCodes.Status422UnprocessableEntity);
+    }
+
+    private static async Task<IResult> LoadDemoData(DemoLoadRequest request, AppDb db)
+    {
+        var datasetId = request.DatasetId?.Trim();
+        if (string.IsNullOrWhiteSpace(datasetId))
+            return ApiErrors.ValidationError(details: ["datasetId is required."]);
+        if (!string.Equals(datasetId, SupportedDatasetId, StringComparison.Ordinal))
+            return ApiErrors.ValidationError(details: ["The requested datasetId is not supported."]);
+
+        var run = await db.Set<DemoLoadRunEntity>().Include(value => value.Outcomes)
+            .FirstOrDefaultAsync(value => value.DatasetId == datasetId);
+        if (run is not null)
+        {
+            if (run.Outcomes.Count == 0)
+                return ApiErrors.Conflict("The dataset load has no stored outcomes.");
+            return Results.Ok(ToResponse(run));
+        }
+
+        run = new DemoLoadRunEntity
+        {
+            DatasetId = datasetId,
+            Outcomes = CreateOutcomes(datasetId)
+        };
+        db.Add(run);
+        try
+        {
+            await db.SaveChangesAsync();
+        }
+        catch (DbUpdateException)
+        {
+            db.ChangeTracker.Clear();
+            var existingRun = await db.Set<DemoLoadRunEntity>().AsNoTracking().Include(value => value.Outcomes)
+                .FirstOrDefaultAsync(value => value.DatasetId == datasetId);
+            if (existingRun is null) throw;
+            return Results.Ok(ToResponse(existingRun));
+        }
+        return Results.Ok(ToResponse(run));
+    }
+
+    private static List<DemoLoadOutcomeEntity> CreateOutcomes(string datasetId)
+    {
+        var records = new (string OutcomeType, string RecordType, string SourceIdentifier, string Reason)[]
+        {
+            ("added", "lot", "DEMO-LOT-01", "Added"),
+            ("added", "lot", "DEMO-LOT-02", "Added"),
+            ("added", "lot", "DEMO-LOT-03", "Added"),
+            ("added", "inventory_item", "DEMO-ITEM-01", "Added"),
+            ("added", "inventory_item", "DEMO-ITEM-02", "Added"),
+            ("added", "ration", "DEMO-RATION-01", "Added"),
+            ("already_present", "lot", "DEMO-LOT-04", "Already present"),
+            ("already_present", "inventory_item", "Yellow corn", "Already present"),
+            ("failed", "ration", "DEMO-RATION-02", "The record could not be loaded.")
+        };
+        return records.Select(record => new DemoLoadOutcomeEntity
+        {
+            DatasetId = datasetId,
+            OutcomeType = record.OutcomeType,
+            RecordType = record.RecordType,
+            SourceIdentifier = record.SourceIdentifier,
+            Reason = record.Reason
+        }).ToList();
+    }
+
+    private static DemoLoadResponse ToResponse(DemoLoadRunEntity run)
+    {
+        var added = ToOutcomes(run.Outcomes, "added");
+        var alreadyPresent = ToOutcomes(run.Outcomes, "already_present");
+        var failed = ToOutcomes(run.Outcomes, "failed");
+        return new DemoLoadResponse(run.DatasetId, added.Length, alreadyPresent.Length, failed.Length,
+            failed.Length > 0, added, alreadyPresent, failed);
+    }
+
+    private static DemoRecordOutcome[] ToOutcomes(IEnumerable<DemoLoadOutcomeEntity> outcomes, string outcomeType) =>
+        outcomes.Where(outcome => outcome.OutcomeType == outcomeType).OrderBy(outcome => outcome.Id)
+            .Select(outcome => new DemoRecordOutcome(outcome.RecordType, outcome.SourceIdentifier, outcome.Reason))
+            .ToArray();
+}
+
+internal sealed record DemoLoadRequest(string DatasetId);
+internal sealed record DemoRecordOutcome(string RecordType, string SourceIdentifier, string Reason);
+internal sealed record DemoLoadResponse(string DatasetId, int AddedCount, int AlreadyPresentCount, int FailedCount,
+    bool Partial, DemoRecordOutcome[] AddedRecords, DemoRecordOutcome[] AlreadyPresentRecords,
+    DemoRecordOutcome[] FailedRecords);
