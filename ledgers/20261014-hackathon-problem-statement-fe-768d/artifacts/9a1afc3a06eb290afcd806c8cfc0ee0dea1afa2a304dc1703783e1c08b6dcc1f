"id\": \"REQ-1\",\n   \"op\": \"MODIFIED\",\n   \"sources\": [\n    \"I-1\",\n    \"I-5\"\n   ],\n   \"stability\": 1\n  },\n  {\n   \"acceptance\": [\n    {\n     \"given\": \"A PostgreSQL database configured using ConnectionStrings:App initially contains no application records.\",\n     \"id\": \"AC-2.1\",\n     \"level\": \"api\",\n     \"then\": \"The response status is successful for the documented operation, each persisted row is returned with the saved field values, and a deleted row is absent from the response.\",\n     \"when\": \"A client creates, changes, or deletes persistent data using contract operations, the API process is restarted, and the corresponding list or detail operation is called again.\"\n    },\n    {\n     \"given\": \"The application starts with a valid App PostgreSQL connection string.\",\n     \"id\": \"AC-2.2\",\n     \"level\": \"api\",\n     \"then\": \"A database inspection finds row-capable persistent tables for the entities and relationships required by contract operations.\",\n     \"when\": \"The application initializes its database schema.\"\n    },\n    {\n     \"given\": \"The App PostgreSQL database contains an inventory item used by a ration.\",\n     \"id\": \"AC-2.3\",\n     \"level\": \"api\",\n     \"then\": \"The response contains the created ration record after restart.\",\n     \"when\": \"A client creates a ration referencing that item, the API restarts against the same database, and a client calls GET /rations.\"\n    }\n   ],\n   \"anchors\": [\n    {\n     \"lineEnd\": 9,\n     \"lineStart\": 8,\n     \"path\": \"App.Api/Program.cs\",\n     \"quote\": \"builder.Services.AddDbContext<AppDb>(o => o.UseNpgsql(builder.Configuration.GetConnectionString(\\\"App\\\")\\n    ?? throw new InvalidOperationException(\\\"No database connection is configured. Set ConnectionStrings__App (for example Host=...;Port=5432;Database=...;Username=...;Password=«SECRET_1»\")));\"\n    },\n    {\n     \"lineEnd\": 22,\n     \"lineStart\