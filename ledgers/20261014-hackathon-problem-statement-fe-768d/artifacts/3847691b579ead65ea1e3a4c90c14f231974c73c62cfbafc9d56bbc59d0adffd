PlanId!.Value)","            .Select(group => new { PlanId = group.Key, Quantity = group.Sum(activity => activity.ActualQuantityLb) })","            .ToDictionaryAsync(group => group.PlanId, group => group.Quantity);","","        return new PlansResponse(plans.Select(plan => ToPlan(plan,","            pens.GetValueOrDefault(plan.PenId), rations.GetValueOrDefault(plan.RationId),","            actuals.GetValueOrDefault(plan.Id), actuals.ContainsKey(plan.Id))).ToList());","    }","","    private static async Task<IResult> CreateFeedingPlan(FeedingPlanRequest request, AppDb db)","    {","        if (request.PenId <= 0 || request.RationId <= 0 || request.PlanDate == default ||","            request.CurrentPenHeadcount <= 0 || !CanStore(request.DailyBunkRateLbPerHead) ||","            request.DailyBunkRateLbPerHead <= 0)","            return ApiErrors.ValidationError(details: [\"penId, rationId, planDate, currentPenHeadcount, and a positive finite dailyBunkRateLbPerHead are required.\"]);","","        var pen = await db.Set<PenEntity>().AsNoTracking().Include(value => value.Lots)","            .FirstOrDefaultAsync(value => value.Id == request.PenId);","        if (pen is null) return ApiErrors.NotFound(\"The requested pen was not found.\");","        var ration = await db.Set<RationEntity>().AsNoTracking().Include(value => value.Ingredients)","            .ThenInclude(ingredient => ingredient.Item).FirstOrDefaultAsync(value => value.Id == request.RationId);","        if (ration is null) return ApiErrors.NotFound(\"The requested ration was not found.\");","        if (request.CurrentPenHeadcount > pen.Capacity)","            return ApiErrors.Conflict(\"The requested headcount exceeds pen capacity.\");","        if (await db.Set<FeedingPlanEntity>().AnyAsync(plan => plan.PenId == pen.Id && plan.PlanDate == request.PlanDate))","            return ApiErrors.Conflict(\"A feeding plan already exists for this pen and date.\");","        if (!HasValidRation(ration))","            return ApiErrors.ValidationError(\"The ration must contain valid ingredient proportions totaling 100 percent.\");","","        var plan = new FeedingPlanEntity","        {","            PenId = pen.Id,","            RationId = ration.Id,","            PlanDate = request.PlanDate,","            DailyBunkRateLbPerHead = (decimal)request.DailyBunkRateLbPerHead,","            CurrentPenHeadcount = request.CurrentPenHeadcount,","            PlannedTime = new TimeOnly(7, 0),","            Status = \"Planned\"","        };","        db.Add(plan);","        await db.SaveChangesAsync();","        return Results.Json(new PlanResponse(ToPlan(plan, pen, ration, 0m, false)),","            statusCode: StatusCodes.Status201Created);","    }","","    private static async Task<FeedingLogResponse> GetFeedingActivities([FromQuery] DateOnly? date, [FromQuery] int? penId, AppDb db)","    {","        IQueryable<FeedingActivityEntity> query = db.Set<FeedingActivityEntity>().AsNoTracking()","            .Include(activity => activity.Pen)","            .Include(activity => activity.Ration)","            .Include(activity => activity.FeedingPlan)","            .Include(activity => activity.LotConsumptions).ThenInclude(consumption => consumption.Lot)","            .Include(activity => activity.IngredientConsumptions).ThenInclude(consumption => consumption.Item);","        if (date.HasValue) query = query.Where(activity => activity.ActivityDate == date.Value);","        if (penId.HasValue) query = query.Where(activity => activity.PenId == penId.Value);","        var activities = await query.OrderBy(activity => activity.ActivityDate).ThenBy(activity => activity.Id).ToListAsync();","        return new FeedingLogResponse(activities.Select(ToActivity).ToList());","    }","","    private static async Task<IResult> CreateFeedingActivity(FeedingActivityRequest request, AppDb db)","    {","        if (request.PenId <= 0 || request.RationId <= 0 || request.Date == default ||","            request.LotQuantities is null || request.LotQuantities.Count == 0 ||","            request.LotQuantities.Any(value => value.LotId <= 0 || !CanStore(value.ActualQuantityLb) || value.ActualQuantityLb <= 0))","            return ApiErrors.ValidationError(details: [\"penId, rationId, date, and positive finite lot quantities are required.\"]);","        if (request.LotQuantities.Select(value => value.LotId).Distinct().Count() != request.LotQuantities.Count)","            return ApiErrors.Conflict(\"Each lot may appear only once in an activity.\");","","        var pen = await db.Set<PenEntity>().AsNoTracking().FirstOrDefaultAsync(value => value.Id == request.PenId);","        if (pen is null) return ApiErrors.NotFound(\"The requested pen was not found.\");","        var ration = await db.Set<RationEntity>().AsNoTracking().Include(value => value.Ingredients)","            .ThenInclude(ingredient => ingredient.Item).FirstOrDefaultAsync(value => value.Id == request.RationId);","        if (ration is null) return ApiErrors.NotFound(\"The requested ration was not found.\");","        if (!HasValidRation(ration))","            return ApiErrors.ValidationError(\"The ration must contain valid ingredient proportions totaling 100 percent.\");","","        FeedingPlanEntity? plan = null;","        if (request.FeedingPlanId is int planId)","        {","            if (planId <= 0) return ApiErrors.ValidationError(details: [\"feedingPlanId must be greater than zero when supplied.\"]);","            plan = await db.Set<FeedingPlanEntity>().FirstOrDefaultAsync(value => value.Id == planId);","            if (plan is null) return ApiErrors.NotFound(\"The requested feeding plan was not found.\");","            if (plan.PenId != pen.Id || plan.RationId != ration.Id || plan.PlanDate != request.Date)","                return ApiErrors.Conflict(\"The feeding plan must match the activity pen, ration, and date.\");","        }","","        var lotIds = request.LotQuantities.Select(value => value.LotId).ToArray();","        var lots = await db.Set<LotEntity>().AsNoTracking().Where(lot => lotIds.Contains(lot.Id))","            .ToDictionaryAsync(lot => lot.Id);","        if (lots.Count != lotIds.Length) return ApiErrors.NotFound(\"One or more requested lots were not found.\");","        if (lots.Values.Any(lot => lot.PenId != pen.Id || !IsActive(lot)))","            return ApiErrors.Conflict(\"Each consumed lot must be active and assigned to the requested pen.\");","","        var actualQuantity = request.LotQuantities.Sum(value => (decimal)value.ActualQuantityLb);","        var ingredients = ration.Ingredients.OrderBy(ingredient => ingredient.ItemId)","            .Select(ingredient => new IngredientAmount(ingredient.Item, actualQuantity * ingredient.ProportionPercent / 100m))","            .ToList();","        var itemIds = ingredients.Select(ingredient => ingredient.Item.Id).ToArray();","","        await using var transaction = await db.Database.BeginTransactionAsync(IsolationLevel.Serializable);","        var movements = await db.Set<InventoryMovementEntity>().AsNoTracking()","            .Where(movement => itemIds.Contains(movement.ItemId)).ToListAsync();","        foreach (var ingredient in ingredients)","        {","            var stock = InventoryTotals.For(ingredient.Item,","                movements.Where(movement => movement.ItemId == ingredient.Item.Id)).ClosingStockLb;","            if (ingredient.QuantityLb > stock)","                return ApiErrors.Conflict($\"The feeding activity exceeds available stock for {ingredient.Item.Name}.\");","        }","","        var economics = GetEconomics(ration);","        var activity = new FeedingActivityEntity","        {","            ActivityDate = request.Date,","            PenId = pen.Id,","            RationId = ration.Id,","            FeedingPlanId = plan?.Id,","            Manager = ManagerName,","            ActualQuantityLb = actualQuantity,","            FeedCost = ingredients.Sum(value => value.QuantityLb * value.Item.UnitCost),","            EnergyMcal = actualQuantity * economics.EnergyMcalPerLb,","            LotConsumptions = request.LotQuantities.Select(value => new FeedingActivityLotConsumptionEntity","            {","                LotId = value.LotId,","                QuantityLb = (decimal)value.ActualQuantityLb","            }).ToList(),","            IngredientConsumptions = ingredients.Select(value => new FeedingActivityIngredientConsumptionEntity","            {","                ItemId = value.Item.Id,","                QuantityLb = value.QuantityLb","            }).ToList()","        };","","        if (plan is not null)","        {","            var previousActual = await db.Set<FeedingActivityEntity>().AsNoTracking()","                .Where(value => value.FeedingPlanId == plan.Id).SumAsync(value => (decimal?)value.ActualQuantityLb) ?? 0m;","            plan.Status = previousActual + actualQuantity < PlanQuantity(plan)","                ? \"In progress\"","                : \"Completed\";","            db.Update(plan);","        }","","        db.Add(activity);","        await db.SaveChangesAsync();","        db.AddRange(ingredients.Select(value => new InventoryMovementEntity","        {","            ItemId = value.Item.Id,","            MovementType = \"consumed\",","            Date = request.Date,","            QuantityLb = value.QuantityLb,","            Note = $\"Feeding activity {activity.Id}\"","        }));","        await db.SaveChangesAsync();","        await transaction.CommitAsync();","","        return Results.Json(new FeedingActivityResponse(ToActivity(activity, pen, ration, plan,","            lots, ingredients)),","            statusCode: StatusCodes.Status201Created);","    }","","    private static async Task<Dictionary<int, RationEntity>> LoadRations(AppDb db, int[] rationIds) =>","        await db.Set<RationEntity>().AsNoTracking().Include(ration => ration.Ingredients)","            .ThenInclude(ingredient => ingredient.Item).Where(ration => rationIds.Contains(ration.Id))","            .ToDictionaryAsync(ration => ration.Id);","","    private static FeedingPlan ToPlan(FeedingPlanEntity plan, PenEntity? pen, RationEntity? ration,","        decimal? actualQuantity, bool hasActual)","    {","        var plannedQuantity = PlanQuantity(plan);","        var activeLots = pen?.Lots.Where(IsActive).OrderBy(lot => lot.Id).ToList() ?? [];","        var lotId = activeLots.Count == 1 ? activeLots[0].Id : (int?)null;","        var lotName = activeLots.Count switch","        {","            0 => \"\",","            1 => activeLots[0].Name,","            _ => string.Join(\", \", activeLots.Select(lot => lot.Name))","        };","        var economics = ration is null ? new RationEconomics(0m, 0m) : GetEconomics(ration);","        return new FeedingPlan(plan.Id, plan.PlanDate, plan.PenId, pen?.Name ?? \"\", lotId, lotName,","            plan.CurrentPenHeadcount, plan.RationId, ration?.Name ?? \"\", (float)plannedQuantity,","            plan.PlannedTime.ToString(\"HH:mm\"), plan.CurrentPenHeadcount == 0 ? 0 : (float)(plannedQuantity / plan.CurrentPenHeadcount),","            (float)(plannedQuantity * economics.CostPerLb), (float)(plannedQuantity * economics.EnergyMcalPerLb),","            ParsePlanStatus(plan.Status), hasActual ? (float)actualQuantity!.Value : null,","            hasActual ? (float)(actualQuantity!.Value - plannedQuantity) : null);","    }","","    private static FeedingActivity ToActivity(FeedingActivityEntity activity)","    {","        return ToActivity(activity, activity.Pen, activity.Ration, activity.FeedingPlan,","            activity.LotConsumptions.ToDictionary(value => value.LotId, value => value.Lot),","            activity.IngredientConsumptions.Select(value => new IngredientAmount(value.Item, value.QuantityLb)).ToList());","    }","","    private static FeedingActivity ToActivity(FeedingActivityEntity activity, PenEntity pen, RationEntity ration,","        FeedingPlanEntity? plan, IReadOnlyDictionary<int, LotEntity> lots, IReadOnlyList<IngredientAmount> ingredients)","    {","        var plannedQuantity = plan is null ? (float?)null : (float)PlanQuantity(plan);","        return new FeedingActivity(activity.Id, activity.ActivityDate, activity.PenId, pen.Name,","            activity.Manager, activity.RationId, ration.Name, activity.FeedingPlanId, plannedQuantity,","            (float)activity.ActualQuantityLb,","            plannedQuantity.HasValue ? (float)activity.ActualQuantityLb - plannedQuantity.Value : null,","            plan is null ? \"Unplanned\" : \"Completed\",","            (float)activity.FeedCost, (float)activity.EnergyMcal,","            ingredients.OrderBy(value => value.Item.Id)","                .Select(value => new IngredientConsumption(value.Item.Id, value.Item.Name, (float)value.QuantityLb)).ToList(),","            activity.LotConsumptions.OrderBy(value => value.LotId)","                .Select(value => new LotConsumption(value.LotId, lots[value.LotId].Name, (float)value.QuantityLb)).ToList());","    }","","    private static bool HasValidRation(RationEntity ration) => ration.Ingredients.Count > 0 &&","        ration.Ingredients.All(value => value.ProportionPercent > 0) &&","        Math.Abs(ration.Ingredients.Sum(value => value.ProportionPercent) - 100m) <= 0.01m;","","    private static RationEconomics GetEconomics(RationEntity ration)","    {","        var cost = ration.Ingredients.Sum(value => value.Item.UnitCost * value.ProportionPercent / 100m);","        var energy = ration.Ingredients.Sum(value => value.Item.EnergyMcalPerKg *","            value.ProportionPercent / 100m * PoundsToKilograms);","        return new RationEconomics(cost, energy);","    }","","    private static decimal PlanQuantity(FeedingPlanEntity plan) =>","        plan.DailyBunkRateLbPerHead * plan.CurrentPenHeadcount;","","    private static bool IsActive(LotEntity lot) => string.Equals(lot.Status, \"Active\", StringComparison.OrdinalIgnoreCase);","","    private static string ParsePlanStatus(string status) => status switch","    {","        \"In progress\" => \"In progress\",","        \"Completed\" => \"Completed\",","        \"Skipped\" => \"Skipped\",","        _ => \"Planned\"","    };","","    private static void SetStatusEnum(Microsoft.OpenApi.Models.OpenApiSchema schema, string[] values)","    {","        if (!schema.Properties.TryGetValue(\"status\", out var status)) return;","        status.Type = \"string\";","        status.Enum = values.Select(value => (IOpenApiAny)new OpenApiString(value)).ToList();","    }","","    private static bool CanStore(float value) => float.IsFinite(value) && Math.Abs((double)value) <= (double)decimal.MaxValue;","","    private sealed record IngredientAmount(InventoryItemEntity Item, decimal QuantityLb);","    private sealed record RationEconomics(decimal CostPerLb, decimal EnergyMcalPerLb);","}","","internal sealed record PlansResponse(IReadOnlyList<FeedingPlan> Plans);","internal sealed record PlanResponse(FeedingPlan Plan);","internal sealed record FeedingLogResponse(IReadOnlyList<FeedingActivity> Activities);","internal sealed record FeedingActivityResponse(FeedingActivity Activity);","internal sealed record FeedingPlanRequest(int PenId, DateOnly PlanDate, int RationId,","    float DailyBunkRateLbPerHead, int CurrentPenHeadcount);","internal sealed record LotActualQuantity(int LotId, float ActualQuantityLb);","internal sealed record FeedingActivityRequest(int PenId, DateOnly Date, int RationId, int? FeedingPlanId,","    IReadOnlyList<LotActualQuantity> LotQuantities);","internal sealed record FeedingPlan(int Id, DateOnly Date, int PenId, string PenName, int? LotId, string LotName,","    int AnimalCount, int RationId, string RationName, float PlannedQuantityLb, string PlannedTime,","    float QuantityPerAnimalLb, float TotalFeedCost, float ExpectedEnergyMcal, string Status,","    float? ActualQuantityLb, float? VarianceLb);","internal sealed record FeedingActivity(int Id, DateOnly Date, int PenId, string PenName, string Manager,","    int RationId, string RationName, int? FeedingPlanId, float? PlannedQuantityLb, float ActualQuantityLb,","    float? VarianceLb, string Status, float FeedCost, float EnergyMcal,","    IReadOnlyList<IngredientConsumption> IngredientConsumption, IReadOnlyList<LotConsumption> LotConsumption);","internal sealed record IngredientConsumption(int ItemId, string ItemName, float QuantityLb);","internal sealed record LotConsumption(int LotId, string LotName, float QuantityLb);"],"path":"App.Api/Endpoints/FeedingEndpoints.cs","removed":[],"status":"A"}],"from":"6cb919e1e845a830418d73bc8dc328dbb6332343","lockedNow":{"App.Tests/AcceptancePart1Tests.cs":"8d590dc397a5c5957d8f4ab8c52d42add3508039a806eb94739be211cbe1f0cc","App.Tests/AcceptancePart2Tests.cs":"f30a2b8508873281b92101b73fde0ae9426495d38eff9ecaa6f99ef225f06ce9","App.Tests/AcceptancePart3Tests.cs":"85f2a58db7e5dcf4453fe34fa6408fa3206e476d67a5d1a5c99b9e02091fbdba","App.Tests/AcceptancePart4Tests.cs":"84c7f565f6ef6536f586a5d762c54c420f4f64f1920f597ec0f19764435296a6","contracts/data-model.yaml":"f10a70adaced7c971ebb5c76b56da89a2dac2db81f656dea8ba94f63b73fbc03","contracts/openapi.yaml":"e365553fe5287b3102e86b2c9ebbcbd84bd0018cee3ac37e61fe1dd2444df003"},"to":"f507356f27bc099c05c21ab96cecc9f54479231b"}