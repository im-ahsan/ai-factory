lue => value.Id == lotId);","        if (lot is null) return ApiErrors.NotFound(\"The requested lot was not found.\");","        var reading = await db.Set<WeightReadingEntity>()","            .FirstOrDefaultAsync(value => value.Id == readingId && value.LotId == lot.Id);","        if (reading is null) return ApiErrors.NotFound(\"The requested weight reading was not found.\");","","        db.Remove(reading);","        await db.SaveChangesAsync();","        return Results.Ok(await BuildMutationResponse(lot, db));","    }","","    private static async Task<IResult> GetLotPerformance(int lotId, AppDb db)","    {","        var lot = await db.Set<LotEntity>().AsNoTracking().FirstOrDefaultAsync(value => value.Id == lotId);","        if (lot is null) return ApiErrors.NotFound(\"The requested lot was not found.\");","        var readings = await LoadReadings(db, lot.Id);","        var sourceWeight = await LoadSourceWeight(db, lot);","        var throughDate = readings.LastOrDefault()?.MeasurementDate ?? DateOnly.FromDateTime(DateTime.UtcNow);","        var feed = await LoadLotFeed(db, lot.Id, throughDate);","        return Results.Ok(new PerformanceResponse(CalculateMetrics(lot, readings, sourceWeight, feed)));","    }","","    private static async Task<IResult> GetOperationalReports([FromQuery] DateOnly startDate,","        [FromQuery] DateOnly endDate, AppDb db)","    {","        if (!IsValidRange(startDate, endDate)) return InvalidDateRange();","","        var pens = await db.Set<PenEntity>().AsNoTracking().OrderBy(value => value.Id).ToListAsync();","        var lots = await db.Set<LotEntity>().AsNoTracking().Include(value => value.Pen)","            .OrderBy(value => value.Id).ToListAsync();","        var readings = await db.Set<WeightReadingEntity>().AsNoTracking()","            .OrderBy(value => value.MeasurementDate).ThenBy(value => value.Id).ToListAsync();","        var sourceRows = await db.Set<ImportRowEntity>().AsNoTracking().OrderBy(value => value.Id).ToListAsync();","        var inventoryItems = await db.Set<InventoryItemEntity>().AsNoTracking().OrderBy(value => value.Id).ToListAsync();","        var inventoryMovements = await db.Set<InventoryMovementEntity>().AsNoTracking()","            .OrderBy(value => value.Date).ThenBy(value => value.Id).ToListAsync();","        var rations = await db.Set<RationEntity>().AsNoTracking().Include(value => value.Ingredients)","            .ThenInclude(value => value.Item).OrderBy(value => value.Id).ToListAsync();","        var plans = await db.Set<FeedingPlanEntity>().AsNoTracking()","            .Where(value => value.PlanDate >= startDate && value.PlanDate <= endDate)","            .OrderBy(value => value.PlanDate).ThenBy(value => value.Id).ToListAsync();","        var activities = await db.Set<FeedingActivityEntity>().AsNoTracking()","            .Where(value => value.ActivityDate >= startDate && value.ActivityDate <= endDate)","            .OrderBy(value => value.ActivityDate).ThenBy(value => value.Id).ToListAsync();","        var feedConsumptions = await db.Set<FeedingActivityLotConsumptionEntity>().AsNoTracking()","            .Include(value => value.Activity).Where(value => value.Activity.ActivityDate >= startDate &&","                value.Activity.ActivityDate <= endDate).ToListAsync();","","        var lotsByPen = lots.Where(value => IsActive(value) && value.PenId.HasValue)","            .GroupBy(value => value.PenId!.Value).ToDictionary(group => group.Key, group => group.ToList());","        var rationsById = rations.ToDictionary(value => value.Id);","        var activeLots = lots.Where(IsActive).ToList();","        var penReports = pens.Select(pen =>","        {","            var occupiedLots = lotsByPen.GetValueOrDefault(pen.Id) ?? [];","            var headCount = occupiedLots.Sum(value => value.HeadCount);","            var penPlans = plans.Where(value => value.PenId == pen.Id).ToList();","            var penActivities = activities.Where(value => value.PenId == pen.Id).ToList();","            var latestPlan = penPlans.LastOrDefault();","            var latestActivity = penActivities.LastOrDefault();","            var rationId = latestPlan?.RationId ?? latestActivity?.RationId;","            var ration = rationId.HasValue ? rationsById.GetValueOrDefault(rationId.Value) : null;","            var delivery = latestPlan is not null","                ? PlanQuantity(latestPlan)","                : penActivities.Count == 0 ? 0m : penActivities.Sum(value => value.ActualQuantityLb) / DayCount(startDate, endDate);","            var dailyCost = delivery * RationCostPerLb(ration);","            var alignment = GetAlignment(pen.Name, penPlans, penActivities);","            var occupancy = $\"{headCount} / {pen.Capacity}\";","            var status = headCount == 0 ? \"Empty\" : alignment?.AlignmentStatus ?? \"On plan\";","            return new OperationalReportPen(pen.Id, pen.Name, occupancy, ration?.Name ?? \"No ration\",","                (float)delivery, (float)dailyCost, status);","        }).ToList();","","        var readingsByLot = readings.GroupBy(value => value.LotId)","            .ToDictionary(group => group.Key, group => group.ToList());","        var sourceByLine = sourceRows.GroupBy(value => value.SourceIdentifier, StringComparer.Ordinal)","            .ToDictionary(group => group.Key, group => new SourceWeight(group.First().HeadCount, group.First().WeightLb), StringComparer.Ordinal);","        var lotReports = activeLots.Select(lot =>","        {","            var lotReadings = readingsByLot.GetValueOrDefault(lot.Id) ?? [];","            var inRange = lotReadings.Where(value => value.MeasurementDate >= startDate && value.MeasurementDate <= endDate).ToList();","            var latest = inRange.LastOrDefault();","            var prior = latest is null ? null : lotReadings.LastOrDefault(value =>","                value.MeasurementDate < latest.MeasurementDate ||","                (value.MeasurementDate == latest.MeasurementDate && value.Id < latest.Id));","            var adg = AverageDailyGain(prior, latest);","            var quantity = feedConsumptions.Where(value => value.LotId == lot.Id).Sum(value => value.QuantityLb);","            var gain = latest is null ? 0m : prior is null","                ? FirstReadingGain(lot, latest, sourceByLine)","                : TotalWeight(latest) - TotalWeight(prior);","            var fcr = gain > 0 ? (float)(quantity / gain) : 0f;","            var cost = CostForLot(feedConsumptions.Where(value => value.LotId == lot.Id));","            var feedCostPerGain = gain > 0 ? (float)(cost / gain) : 0f;","            return new OperationalReportLot(lot.Id, lot.Name, lot.Pen?.Name ?? \"Unassigned\", lot.Breed,","                latest?.ApplicableHeadcount ?? lot.HeadCount, adg ?? 0f, fcr, feedCostPerGain);","        }).ToList();","","        var days = DayCount(startDate, endDate);","        var inventoryReports = inventoryItems.Select(item =>","        {","            var itemMovements = inventoryMovements.Where(value => value.ItemId == item.Id).ToList();","            var periodConsumption = itemMovements.Where(value => value.MovementType == \"consumed\" &&","                value.Date >= startDate && value.Date <= endDate).Sum(value => value.QuantityLb);","            return new OperationalReportInventory(item.Id, item.Name,","                (float)InventoryTotals.For(item, itemMovements).ClosingStockLb, (float)item.UnitCost,","                (float)(periodConsumption / days), (float)(periodConsumption / days * 365m));","        }).ToList();","","        var alignmentReports = plans.Select(value => value.PenId).Concat(activities.Select(value => value.PenId))","            .Distinct().OrderBy(value => value)","            .Select(penId =>","            {","                var penName = pens.FirstOrDefault(value => value.Id == penId)?.Name ?? \"\";","                return GetAlignment(penName, plans.Where(value => value.PenId == penId).ToList(),","                    activities.Where(value => value.PenId == penId).ToList())!;","            }).ToList();","","        var rationUsage = activities.GroupBy(value => value.RationId)","            .Select(group => new RationUsageReport(rationsById.GetValueOrDefault(group.Key)?.Name ?? \"\",","                group.Select(value => value.PenId).Distinct().Count(), (float)group.Sum(value => value.ActualQuantityLb)))","            .OrderBy(value => value.RationName, StringComparer.Ordinal).ToList();","","        return Results.Ok(new OperationalReportsResponse(startDate, endDate, penReports, lotReports,","            inventoryReports, alignmentReports, rationUsage));","    }","","    private static async Task<IResult> GetFeedToGainReport([FromQuery] DateOnly startDate,","        [FromQuery] DateOnly endDate, [FromQuery] string? breed, [FromQuery] string? sex,","        [FromQuery] int? penId, AppDb db)","    {","        if (!IsValidRange(startDate, endDate) || (penId.HasValue && penId.Value <= 0) ||","            (sex is not null && sex is not (\"steer\" or \"heifer\" or \"mixed\")))","            return ApiErrors.ValidationError(details: [\"Provide an ordered date range and valid optional breed, sex, and penId filters.\"]);","","        var lots = await db.Set<LotEntity>().AsNoTracking().Include(value => value.Pen)","            .OrderBy(value => value.Id).ToListAsync();","        var readings = await db.Set<WeightReadingEntity>().AsNoTracking()","            .OrderBy(value => value.MeasurementDate).ThenBy(value => value.Id).ToListAsync();","        var sourceRows = await db.Set<ImportRowEntity>().AsNoTracking().OrderBy(value => value.Id).ToListAsync();","        var consumptions = await db.Set<FeedingActivityLotConsumptionEntity>().AsNoTracking()","            .Include(value => value.Activity).ToListAsync();","        var readingsByLot = readings.GroupBy(value => value.LotId)","            .ToDictionary(group => group.Key, group => group.ToList());","        var sourceByLine = sourceRows.GroupBy(value => value.SourceIdentifier, StringComparer.Ordinal)","            .ToDictionary(group => group.Key, group => new SourceWeight(group.First().HeadCount, group.First().WeightLb), StringComparer.Ordinal);","","        var rows = new List<FeedToGainRow>();","        foreach (var lot in lots)","        {","            if ((!string.IsNullOrWhiteSpace(breed) && !string.Equals(lot.Breed, breed.Trim(), StringComparison.OrdinalIgnoreCase)) ||","                (sex is not null && !string.Equals(lot.Sex, sex, StringComparison.OrdinalIgnoreCase)) ||","                (penId.HasValue && lot.PenId != penId.Value))","                continue;","","            var series = readingsByLot.GetValueOrDefault(lot.Id) ?? [];","            var latest = series.LastOrDefault(value => value.MeasurementDate >= startDate && value.MeasurementDate <= endDate);","            if (latest is null) continue;","","            var historical = series.Where(value => value.MeasurementDate < latest.MeasurementDate ||","                (value.MeasurementDate == latest.MeasurementDate && value.Id <= latest.Id)).ToList();","            var previous = historical.Count > 1 ? historical[^2] : null;","            var selectedFeed = consumptions.Where(value => value.LotId == lot.Id &&","                value.Activity.ActivityDate <= latest.MeasurementDate).ToList();","            var totalFeed = selectedFeed.Sum(value => value.QuantityLb);","            var totalGain = historical.Select((value, index) => index == 0","                ? FirstReadingGain(lot, value, sourceByLine)","                : TotalWeight(value) - TotalWeight(historical[index - 1])).Sum();","            var totalCost = CostForLot(selectedFeed);","            var gain = totalGain > 0 ? totalGain : 0m;","            rows.Add(new FeedToGainRow(lot.Id, lot.Name, lot.Breed, lot.Sex, lot.Pen?.Name ?? \"Unassigned\",","                (float)latest.AverageWeightLb, latest.MeasurementDate, latest.ApplicableHeadcount,","                AverageDailyGain(previous, latest) ?? 0f, (float)totalFeed,","                gain > 0 ? (float)(totalFeed / gain) : 0f,","                gain > 0 ? (float)(totalCost / gain) : 0f));","        }","","        return Results.Ok(new FeedToGainResponse(new FeedToGainFilters(startDate, endDate, breed, sex, penId),","            WeightSelectionRule, rows));","    }","","    private static async Task<WeightMutationResponse> BuildMutationResponse(LotEntity lot, AppDb db)","    {","        var readings = await LoadReadings(db, lot.Id);","        var sourceWeight = await LoadSourceWeight(db, lot);","        var throughDate = readings.LastOrDefault()?.MeasurementDate ?? DateOnly.FromDateTime(DateTime.UtcNow);","        var feed = await LoadLotFeed(db, lot.Id, throughDate);","        return new WeightMutationResponse(ToReadings(lot, readings, sourceWeight),","            CalculateMetrics(lot, readings, sourceWeight, feed));","    }","","    private static async Task<List<WeightReadingEntity>> LoadReadings(AppDb db, int lotId) =>","        await db.Set<WeightReadingEntity>().AsNoTracking().Where(value => value.LotId == lotId)","            .OrderBy(value => value.MeasurementDate).ThenBy(value => value.Id).ToListAsync();","","    private static async Task<SourceWeight?> LoadSourceWeight(AppDb db, LotEntity lot)","    {","        var source = await db.Set<ImportRowEntity>().AsNoTracking()","            .Where(value => value.SourceIdentifier == lot.SourcePurchaseOrderLine)","            .OrderBy(value => value.Id).Select(value => new { value.HeadCount, value.WeightLb })","            .FirstOrDefaultAsync();","        return source is { WeightLb: > 0 } ? new SourceWeight(source.HeadCount, source.WeightLb) : null;","    }","","    private static async Task<List<FeedingActivityLotConsumptionEntity>> LoadLotFeed(AppDb db, int lotId,","        DateOnly throughDate) => await db.Set<FeedingActivityLotConsumptionEntity>().AsNoTracking()","        .Include(value => value.Activity).Where(value => value.LotId == lotId &&","            value.Activity.ActivityDate <= throughDate).ToListAsync();","","    private static IReadOnlyList<WeightReading> ToReadings(LotEntity lot,","        IReadOnlyList<WeightReadingEntity> readings, SourceWeight? sourceWeight)","    {","        return readings.Select((reading, index) =>","        {","            var total = TotalWeight(reading);","            var gain = index > 0","                ? total - TotalWeight(readings[index - 1])","                : sourceWeight is null ? 0m : total - sourceWeight.Value.WeightLb * sourceWeight.Value.HeadCount;","            return new WeightReading(reading.Id, lot.Id, reading.MeasurementDate, reading.ApplicableHeadcount,","                (float)reading.AverageWeightLb, (float)total, (float)gain, reading.Notes, reading.RecordedBy, \"Accepted\");","        }).ToList();","    }","","    private static PerformanceMetrics CalculateMetrics(LotEntity lot,","        IReadOnlyList<WeightReadingEntity> readings, SourceWeight? sourceWeight,","        IReadOnlyList<FeedingActivityLotConsumptionEntity> feed)","    {","        var totalGain = readings.Select((reading, index) => index == 0","            ? sourceWeight is null ? 0m : TotalWeight(reading) - sourceWeight.Value.WeightLb * sourceWeight.Value.HeadCount","            : TotalWeight(reading) - TotalWeight(readings[index - 1])).Sum();","        var days = readings.Count < 2","            ? 0","            : Math.Max(0, readings[^1].MeasurementDate.DayNumber - readings[0].MeasurementDate.DayNumber);","        var headCount = readings.LastOrDefault()?.ApplicableHeadcount ?? 0;","        var adg = days > 0 && headCount > 0 ? (float)(totalGain / headCount / days) : (float?)null;","        var totalFeed = feed.Sum(value => value.QuantityLb);","        var totalCost = CostForLot(feed);","        var ratio = totalGain > 0 ? (float)(totalFeed / totalGain) : (float?)null;","        var costPerGain = totalGain > 0 ? (float)(totalCost / totalGain) : (float?)null;","        DateOnly? projectedShipDate = null;","        var latest = readings.LastOrDefault();","        if (latest is not null && adg is > 0)","        {","            var daysToTarget = Math.Max(0, (int)Math.Ceiling(((double)lot.TargetWeightLb - (double)latest.AverageWeightLb) / adg.Value));","            projectedShipDate = latest.MeasurementDate.AddDays(daysToTarget);","        }","","        return new PerformanceMetrics(lot.Id, days, (float)totalGain, adg, (float)totalFeed,","            ratio, costPerGain, projectedShipDate);","    }","","    private static decimal CostForLot(IEnumerable<FeedingActivityLotConsumptionEntity> consumptions) =>","        consumptions.Sum(value => value.Activity.ActualQuantityLb > 0","            ? value.Activity.FeedCost * value.QuantityLb / value.Activity.ActualQuantityLb","            : 0m);","","    private static float? AverageDailyGain(WeightReadingEntity? previous, WeightReadingEntity? latest)","    {","        if (previous is null || latest is null) return null;","        var days = latest.MeasurementDate.DayNumber - previous.MeasurementDate.DayNumber;","        return days <= 0 ? null : (float)((latest.AverageWeightLb - previous.AverageWeightLb) / days);","    }","","    private static decimal FirstReadingGain(LotEntity lot, WeightReadingEntity reading,","        IReadOnlyDictionary<string, SourceWeight> sourceByLine) =>","        sourceByLine.TryGetValue(lot.SourcePurchaseOrderLine, out var source)","            ? TotalWeight(reading) - source.WeightLb * source.HeadCount","            : 0m;","","    private static decimal TotalWeight(WeightReadingEntity reading) =>","        reading.AverageWeightLb * reading.ApplicableHeadcount;","","    private static PlanAlignmentReport? GetAlignment(string penName, IReadOnlyList<FeedingPlanEntity> plans,","        IReadOnlyList<FeedingActivityEntity> activities)","    {","        if (plans.Count == 0 && activities.Count == 0) return null;","        var planned = plans.