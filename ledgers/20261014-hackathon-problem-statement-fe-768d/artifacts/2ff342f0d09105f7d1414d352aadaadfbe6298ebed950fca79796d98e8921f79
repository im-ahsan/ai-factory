oduces<ErrorResponse>(StatusCodes.Status400BadRequest)\n+            .Produces<ErrorResponse>(StatusCodes.Status404NotFound)\n+            .Produces<ErrorResponse>(StatusCodes.Status409Conflict)\n+            .Produces<ErrorResponse>(StatusCodes.Status422UnprocessableEntity);\n+\n+        app.MapPatch(\"/inventory/settings\", UpdateInventorySettings)\n+            .WithName(\"updateInventorySettings\")\n+            .Produces<InventorySettingsResponse>(StatusCodes.Status200OK)\n+            .Produces<ErrorResponse>(StatusCodes.Status400BadRequest)\n+            .Produces<ErrorResponse>(StatusCodes.Status422UnprocessableEntity);\n+\n+        app.MapGet(\"/inventory/outlook\", GetInventoryOutlook)\n+            .WithName(\"getInventoryOutlook\")\n+            .Produces<OutlookResponse>(StatusCodes.Status200OK)\n+            .Produces<ErrorResponse>(StatusCodes.Status400BadRequest)\n+            .Produces<ErrorResponse>(StatusCodes.Status422UnprocessableEntity)\n+            .Produces<ErrorResponse>(StatusCodes.Status500InternalServerError);\n+    }\n+\n+    private static async Task<InventoryResponse> GetInventoryItems(AppDb db)\n+    {\n+        var items = await db.Set<InventoryItemEntity>().AsNoTracking().OrderBy(item => item.Id).ToListAsync();\n+        var movements = await db.Set<InventoryMovementEntity>().AsNoTracking()\n+            .OrderBy(movement => movement.Date).ThenBy(movement => movement.Id).ToListAsync();\n+        var movementsByItem = movements.GroupBy(movement => movement.ItemId)\n+            .ToDictionary(group => group.Key, group => group.ToList());\n+        var settings = await db.Set<InventorySettingEntity>().AsNoTracking()\n+            .FirstOrDefaultAsync(setting => setting.Scope == DefaultScope);\n+        var wastageRatio = settings?.WastageRatio ?? DefaultWastageRatio;\n+\n+        return new InventoryResponse((float)wastageRatio, items.Select(item => ToInventoryItem(item,\n+            movementsByItem.GetValueOrDefault(item.Id) ?? [])).ToList());\n+    }\n+\n+    private static async Task<IResult> RecordInventoryMovement(InventoryMovementRequest request, AppDb db)\n+    {\n+        if (request.Date == default || string.IsNullOrWhiteSpace(request.Note) || !CanStore(request.QuantityLb))\n+            return ApiErrors.ValidationError(details: [\"date, note, and a finite quantityLb are required.\"]);\n+        if (request.MovementType == InventoryMovementRequestType.Received && request.QuantityLb <= 0)\n+            return ApiErrors.ValidationError(details: [\"Received quantityLb must be greater than zero.\"]);\n+        if (request.MovementType == InventoryMovementRequestType.Adjustment && request.QuantityLb == 0)\n+            return ApiErrors.ValidationError(details: [\"Adjustment quantityLb must not be zero.\"]);\n+\n+        var item = await db.Set<InventoryItemEntity>().FirstOrDefaultAsync(value => value.Id == request.ItemId);\n+        if (item is null) return ApiErrors.NotFound(\"The requested inventory item was not found.\");\n+\n+        var movementType = request.MovementType == InventoryMovementRequestType.Received ? \"received\" : \"adjustment\";\n+        var movement = new InventoryMovementEntity\n+        {\n+            ItemId = item.Id,\n+            MovementType = movementType,\n+            Date = request.Date,\n+            QuantityLb = (decimal)request.QuantityLb,\n+            Note = request.Note.Trim()\n+        };\n+        if (movementType == \"adjustment\" && (await CurrentStock(db, item) + movement.QuantityLb) < 0)\n+            return ApiErrors.Conflict(\"The adjustment would make inventory stock negative.\");\n+\n+        db.Add(movement);\n+        await db.SaveChangesAsync();\n+        var allMovements = await db.Set<InventoryMovementEntity>().AsNoTracking()\n+            .Where(value => value.ItemId == item.Id).OrderBy(value => value.Date).ThenBy(value => value.Id).ToListAsync();\n+        return Results.Json(new MovementCreatedResponse(ToMovement(movement),\n+            ToInventoryItem(item, allMovements)), statusCode: StatusCodes.Status201Created);\n+    }\n+\n+    private static async Task<IResult> RecordActualWastage(ActualWastageRequest request, AppDb db)\n+    {\n+        if (request.RecordDate == default || !CanStore(request.ActualWastageLb) || request.ActualWastageLb <= 0 ||\n+            string.IsNullOrWhiteSpace(request.WastageCause))\n+            return ApiErrors.ValidationError(details: [\"recordDate, a positive actualWastageLb, and wastageCause are required.\"]);\n+\n+        var item = await db.Set<InventoryItemEntity>().FirstOrDefaultAsync(value => value.Id == request.ItemId);\n+        if (item is null) return ApiErrors.NotFound(\"The requested inventory item was not found.\");\n+\n+        var quantity = (decimal)request.ActualWastageLb;\n+        if (await CurrentStock(db, item) < quantity)\n+            return ApiErrors.Conflict(\"The wastage quantity exceeds available inventory stock.\");\n+\n+        var movement = new InventoryMovementEntity\n+        {\n+            ItemId = item.Id,\n+            MovementType = \"actual_wastage\",\n+            Date = request.RecordDate,\n+            QuantityLb = quantity,\n+            Note = request.WastageCause.Trim(),\n+            WastageCause = request.WastageCause.Trim()\n+        };\n+        db.Add(movement);\n+        await db.SaveChangesAsync();\n+        var allMovements = await db.Set<InventoryMovementEntity>().AsNoTracking()\n+            .Where(value => value.ItemId == item.Id).OrderBy(value => value.Date).ThenBy(value => value.Id).ToListAsync();\n+        return Results.Json(new MovementCreatedResponse(ToMovement(movement),\n+            ToInventoryItem(item, allMovements)), statusCode: StatusCodes.Status201Created);\n+    }\n+\n+    private static async Task<IResult> UpdateInventorySettings(InventorySettingsRequest request, AppDb db)\n+    {\n+        if (!float.IsFinite(request.WastageRatio) || request.WastageRatio < 0 || request.WastageRatio > 1)\n+            return ApiErrors.ValidationError(details: [\"wastageRatio must be between zero and one.\"]);\n+\n+        var setting = await db.Set<InventorySettingEntity>().FirstOrDefaultAsync(value => value.Scope == DefaultScope);\n+        if (setting is null)\n+        {\n+            setting = new InventorySettingEntity { Scope = DefaultScope };\n+            db.Add(setting);\n+        }\n+        setting.WastageRatio = (decimal)request.WastageRatio;\n+        await db.SaveChangesAsync();\n+        return Results.Ok(new InventorySettingsResponse((float)setting.WastageRatio));\n+    }\n+\n+    private static async Task<IResult> GetInventoryOutlook([FromQuery] string horizon, [FromQuery] float wastageRatio, AppDb db)\n+    {\n+        var days = HorizonDays(horizon);\n+        if (days is null)\n+            return ApiErrors.ValidationError(details: [\"horizon must be daily, weekly, monthly, quarterly, bi-annual, or annual.\"]);\n+        if (!float.IsFinite(wastageRatio) || wastageRatio < 0 || wastageRatio > 1)\n+            return ApiErrors.ValidationError(details: [\"wastageRatio must be between zero and one.\"]);\n+\n+        var items = await db.Set<InventoryItemEntity>().AsNoTracking().OrderBy(item => item.Id).ToListAsync();\n+        var movements = await db.Set<InventoryMovementEntity>().AsNoTracking().OrderBy(movement => movement.Date)\n+            .ThenBy(movement => movement.Id).ToListAsync();\n+        var balances = items.Select(item =>\n+        {\n+            var itemMovements = movements.Where(movement => movement.ItemId == item.Id).ToList();\n+            var currentStock = InventoryTotals.For(item, itemMovements).ClosingStockLb;\n+            var consumption = itemMovements.Where(movement => movement.MovementType == \"consumed\").ToList();\n+            var dailyConsumption = consumption.Count == 0\n+                ? 0m\n+                : consumption.Sum(movement => movement.QuantityLb) /\n+                  Math.Max(1, consumption.Max(movement 