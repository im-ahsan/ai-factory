zonParameter = operation.Parameters?.FirstOrDefault(parameter => parameter.Name == \"horizon\");\n+                if (horizonParameter is not null)\n+                {\n+                    horizonParameter.Schema ??= new OpenApiSchema { Type = \"string\" };\n+                    horizonParameter.Schema.Enum = OutlookHorizons\n+                        .Select(value => (IOpenApiAny)new OpenApiString(value)).ToList();\n+                }\n+            }\n+            return Task.CompletedTask;\n+        }\n+    }\n+\n+    private static bool CanStore(float value) => float.IsFinite(value) && Math.Abs((double)value) <= (double)decimal.MaxValue;\n+\n+    private static InventoryItem ToInventoryItem(InventoryItemEntity item, IReadOnlyList<InventoryMovementEntity> movements)\n+    {\n+        var totals = InventoryTotals.For(item, movements);\n+        return new InventoryItem(item.Id, item.Name, item.Category, (float)totals.ClosingStockLb, item.Unit,\n+            (float)item.UnitCost, (float)item.DryMatterPercent, (float)item.EnergyMcalPerKg, item.StorageLocation,\n+            (float)totals.OpeningStockLb, (float)totals.ReceivedStockLb, (float)totals.ConsumedStockLb,\n+            (float)totals.ActualWastageLb, (float)totals.ClosingStockLb,\n+            movements.OrderBy(value => value.Date).ThenBy(value => value.Id).Select(ToMovement).ToList());\n+    }\n+\n+    private static InventoryMovement ToMovement(InventoryMovementEntity movement) => new(\n+        movement.Id, movement.ItemId, ParseMovementType(movement.MovementType), movement.Date, (float)movement.QuantityLb,\n+        movement.Note, movement.WastageCause);\n+\n+    private static InventoryMovementType ParseMovementType(string movementType) => movementType switch\n+    {\n+        \"opening\" => InventoryMovementType.Opening,\n+        \"received\" => InventoryMovementType.Received,\n+        \"consumed\" => InventoryMovementType.Consumed,\n+        \"actual_wastage\" => InventoryMovementType.ActualWastage,\n+        _ => InventoryMovementType.Adjustment\n+    };\n+}\n+\n+internal static class InventoryTotals\n+{\n+    internal static InventoryStockTotals For(InventoryItemEntity item, IEnumerable<InventoryMovementEntity> movements)\n+    {\n+        var records = movements.ToList();\n+        var opening = item.OpeningStockLb != 0\n+            ? item.OpeningStockLb\n+            : records.Where(movement => movement.MovementType == \"opening\").Sum(movement => movement.QuantityLb);\n+        var received = records.Where(movement => movement.MovementType == \"received\").Sum(movement => movement.QuantityLb);\n+        var consumed = records.Where(movement => movement.MovementType == \"consumed\").Sum(movement => movement.QuantityLb);\n+        var wastage = records.Where(movement => movement.MovementType == \"actual_wastage\").Sum(movement => movement.QuantityLb);\n+        var adjustments = records.Where(movement => movement.MovementType == \"adjustment\").Sum(movement => movement.QuantityLb);\n+        return new InventoryStockTotals(opening, received, consumed, wastage, opening + received + adjustments - consumed - wastage);\n+    }\n+}\n+\n+internal sealed record InventoryStockTotals(decimal OpeningStockLb, decimal ReceivedStockLb, decimal ConsumedStockLb,\n+    decimal ActualWastageLb, decimal ClosingStockLb);\n+internal sealed record InventoryResponse(float WastageRatio, IReadOnlyList<InventoryItem> Items);\n+internal sealed record InventoryItem(int Id, string Name, string Category, float AvailableQuantity, string Unit,\n+    float UnitCost, float DryMatterPercent, float EnergyMcalPerKg, string StorageLocation, float OpeningStockLb,\n+    float ReceivedStockLb, float ConsumedStockLb, float ActualWastageLb, float ClosingStockLb,\n+    IReadOnlyList<InventoryMovement> Movements);\n+internal sealed record InventoryMovement(int Id, int ItemId, InventoryMovementType MovementType, DateOnly Date,\n+    float QuantityLb, string Note, string? WastageCause);\n+internal sealed record MovementCreatedResponse(InventoryMovement Movement, InventoryItem Item);\n+internal sealed record InventorySettingsRequest(float WastageRatio);\n+internal sealed record InventorySettingsResponse(float WastageRatio);\n+internal sealed record OutlookBalance(int ItemId, string ItemName, float CurrentStockLb,\n+    float DailyEstimatedConsumptionLb, float ProjectedBalanceLb);\n+internal sealed record OutlookResponse(OutlookHorizon Horizon, float WastageRatio, IReadOnlyList<OutlookBalance> Balances);\n+internal sealed record InventoryMovementRequest(int ItemId, InventoryMovementRequestType MovementType, DateOnly Date,\n+    float QuantityLb, string Note);\n+internal sealed record ActualWastageRequest(int ItemId, DateOnly RecordDate, float ActualWastageLb, string WastageCause);\n+\n+[JsonConverter(typeof(JsonStringEnumConverter<InventoryMovementType>))]\n+internal enum InventoryMovementType\n+{\n+    [JsonStringEnumMemberName(\"opening\")] Opening,\n+    [JsonStringEnumMemberName(\"received\")] Received,\n+    [JsonStringEnumMemberName(\"consumed\")] Consumed,\n+    [JsonStringEnumMemberName(\"actual_wastage\")] ActualWastage,\n+    [JsonStringEnumMemberName(\"adjustment\")] Adjustment\n+}\n+\n+[JsonConverter(typeof(JsonStringEnumConverter<InventoryMovementRequestType>))]\n+internal enum InventoryMovementRequestType\n+{\n+    [JsonStringEnumMemberName(\"received\")] Received,\n+    [JsonStringEnumMemberName(\"adjustment\")] Adjustment\n+}\n+\n+[JsonConverter(typeof(JsonStringEnumConverter<OutlookHorizon>))]\n+internal enum OutlookHorizon\n+{\n+    [JsonStringEnumMemberName(\"daily\")] Daily,\n+    [JsonStringEnumMemberName(\"weekly\")] Weekly,\n+    [JsonStringEnumMemberName(\"monthly\")] Monthly,\n+    [JsonStringEnumMemberName(\"quarterly\")] Quarterly,\n+    [JsonStringEnumMemberName(\"bi-annual\")] BiAnnual,\n+    [JsonStringEnumMemberName(\"annual\")] Annual\n+}\ndiff --git a/App.Api/Endpoints/RationEndpoints.cs b/App.Api/Endpoints/RationEndpoints.cs\nnew 