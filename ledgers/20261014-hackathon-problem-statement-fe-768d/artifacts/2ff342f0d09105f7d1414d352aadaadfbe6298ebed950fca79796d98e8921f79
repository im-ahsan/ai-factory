ion.Ingredients)\n+            .ThenInclude(ingredient => ingredient.Item).OrderBy(ration => ration.Id).ToListAsync();\n+        return new RationsResponse(rations.Select(ToRation).ToList());\n+    }\n+\n+    private static async Task<IResult> CreateRation(RationRequest request, AppDb db)\n+    {\n+        if (string.IsNullOrWhiteSpace(request.Name) || string.IsNullOrWhiteSpace(request.Type) ||\n+            string.IsNullOrWhiteSpace(request.OperationalStatus) || !CanStore(request.TargetWeightMinLb) ||\n+            !CanStore(request.TargetWeightMaxLb) || request.TargetWeightMinLb <= 0 ||\n+            request.TargetWeightMaxLb < request.TargetWeightMinLb || request.Ingredients is null ||\n+            request.Ingredients.Count == 0)\n+            return ApiErrors.ValidationError(details: [\"Ration identity, target weights, status, and ingredients are required and must be valid.\"]);\n+\n+        if (request.Ingredients.Any(ingredient => ingredient.ItemId <= 0 || !float.IsFinite(ingredient.ProportionPercent) ||\n+                ingredient.ProportionPercent <= 0))\n+            return ApiErrors.ValidationError(details: [\"Ingredient itemIds and proportions must be positive finite values.\"]);\n+        if (request.Ingredients.Select(ingredient => ingredient.ItemId).Distinct().Count() != request.Ingredients.Count)\n+            return ApiErrors.ValidationError(details: [\"Each ingredient itemId may only appear once.\"]);\n+        if (Math.Abs(request.Ingredients.Sum(ingredient => ingredient.ProportionPercent) - 100f) > 0.01f)\n+            return ApiErrors.ValidationError(details: [\"Ingredient proportions must total 100 percent.\"]);\n+\n+        var name = request.Name.Trim();\n+        if (await db.Set<RationEntity>().AnyAsync(ration => ration.Name == name))\n+            return ApiErrors.Conflict(\"A ration with that name already exists.\");\n+\n+        var itemIds = request.Ingredients.Select(ingredient => ingredient.ItemId).ToArray();\n+        var items = await db.Set<InventoryItemEntity>().Where(item => itemIds.Contains(item.Id)).ToDictionaryAsync(item => item.Id);\n+        if (items.Count != itemIds.Length)\n+            return ApiErrors.ValidationError(\"One or more ration ingredients reference an unknown inventory item.\");\n+\n+        var ration = new RationEntity\n+        {\n+            Name = name,\n+            Type = request.Type.Trim(),\n+            TargetWeightMinLb = (decimal)request.TargetWeightMinLb,\n+            TargetWeightMaxLb = (decimal)request.TargetWeightMaxLb,\n+            OperationalStatus = request.OperationalStatus.Trim(),\n+            Ingredients = request.Ingredients.Select(ingredient => new RationIngredientEntity\n+            {\n+                ItemId = ingredient.ItemId,\n+                ProportionPercent = (decimal)ingredient.ProportionPercent\n+            }).ToList()\n+        };\n+        db.Add(ration);\n+        await db.SaveChangesAsync();\n+\n+        foreach (var ingredient in ration.Ingredients)\n+            ingredient.Item = items[ingredient.ItemId];\n+        return Results.Json(ToRation(ration), statusCode: StatusCodes.Status201Created);\n+    }\n+\n+    private static async Task<IResult> OptimizeRation(RationOptimizationRequest request, AppDb db)\n+    {\n+        if (!CanStore(request.TargetWeightMinLb) || !CanStore(request.TargetWeightMaxLb) ||\n+            !CanStore(request.MinimumDryMatterPercent) || !CanStore(request.MinimumEnergyMcalPerKg) ||\n+            request.TargetWeightMinLb <= 0 || request.TargetWeightMaxLb < request.TargetWeightMinLb ||\n+            request.MinimumDryMatterPercent < 0 || request.MinimumDryMatterPercent > 100 ||\n+            request.MinimumEnergyMcalPerKg < 0)\n+            return ApiErrors.ValidationError(details: [\"Optimization constraints are outside their valid ranges.\"]);\n+\n+        var items = await db.Set<InventoryItemEntity>().AsNoTracking().OrderBy(item => item.Id).ToListAsync();\n+        var mixes = CreateCandidateMi