ogram> _factory;\n\n    public AcceptancePart3Tests(WebApplicationFactory<Program> factory) => _factory = factory;\n\n    [Fact]\n    public async Task AC_3_1_SeedsPersistentEntitiesAndCollectionResponses()\n    {\n        using var seededFactory = CreateSeededFactory();\n        using var client = seededFactory.CreateClient();\n\n        await using var scope = seededFactory.Services.CreateAsyncScope();\n        var db = scope.ServiceProvider.GetRequiredService<AppDb>();\n        await db.Database.OpenConnectionAsync();\n\n        foreach (var (path, listNames) in CollectionOperations)\n        {\n            using var document = await GetJsonAsync(client, path);\n            foreach (var listName in listNames)\n            {\n                Assert.True(document.RootElement.TryGetProperty(listName, out var records),\n                    $\"{path} should include the '{listName}' collection.\");\n                Assert.Equal(JsonValueKind.Array, records.ValueKind);\n                switch (listName)\n                {\n                    case \"batches\":\n                        AssertSeededStringIds(records, await ReadStringsAsync(db, \"SELECT \\\"BatchId\\\" FROM \\\"ImportBatches\\\"\"), \"batchId\");\n                        break;\n                    case \"lots\":\n                        AssertSeededIntIds(records, await ReadIntsAsync(db, \"SELECT \\\"Id\\\" FROM \\\"Lots\\\"\"), \"id\");\n                        break;\n                    case \"pens\":\n                        AssertSeededIntIds(records, await ReadIntsAsync(db, \"SELECT \\\"Id\\\" FROM \\\"Pens\\\"\"), \"id\");\n                        break;\n                    case \"items\":\n                        AssertSeededIntIds(records, await ReadIntsAsync(db, \"SELECT \\\"Id\\\" FROM \\\"InventoryItems\\\"\"), \"id\");\n                        break;\n                    case \"rations\":\n                        AssertSeededIntIds(records, await ReadIntsAsync(db, \"SELECT \\\"Id\\\" FROM \\