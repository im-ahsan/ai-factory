vity.ActualQuantityLb) })\n            .ToDictionaryAsync(group => group.PlanId, group => group.Quantity);\n\n        return new PlansResponse(plans.Select(plan => ToPlan(plan,\n            pens.GetValueOrDefault(plan.PenId), rations.GetValueOrDefault(plan.RationId),\n            actuals.GetValueOrDefault(plan.Id), actuals.ContainsKey(plan.Id))).ToList());\n    }\n\n    private static async Task<IResult> CreateFeedingPlan(FeedingPlanRequest request, AppDb db)\n    {\n        if (request.PenId <= 0 || request.RationId <= 0 || request.PlanDate == default ||\n            request.CurrentPenHeadcount <= 0 || !CanStore(request.DailyBunkRateLbPerHead) ||\n            request.DailyBunkRateLbPerHead <= 0)\n            return ApiErrors.ValidationError(details: [\"penId, rationId, planDate, currentPenHeadcount, and a positive finite dailyBunkRateLbPerHead are required.\"]);\n\n        var pen = await db.Set<PenEntity>().AsNoTracking().Include(value => value.Lots)\n            .FirstOrDefaultAsync(value => value.Id == request.PenId);\n        if (pen is null) return ApiErrors.NotFound(\"The requested pen was not found.\");\n        var ration = await db.Set<RationEntity>().AsNoTracking().Include(value => value.Ingredients)\n            .ThenInclude(ingredient => ingredient.Item).FirstOrDefaultAsync(value => value.Id == request.RationId);\n        if (ration is null) return ApiErrors.NotFound(\"The requested ration was not found.\");\n        if (request.CurrentPenHeadcount > pen.Capacity)\n            return ApiErrors.Conflict(\"The requested headcount exceeds pen capacity.\");\n        if (await db.Set<FeedingPlanEntity>().AnyAsync(plan => plan.PenId == pen.Id && plan.PlanDate == request.PlanDate))\n            return ApiErrors.Conflict(\"A feeding plan already exists for this pen and date.\");\n        if (!HasValidRation(ration))\n            return ApiErrors.ValidationError(\"The ration must contain valid ingredient proportions totaling 100 percent.\");\n\n        var plan = new FeedingPlanEntity\n        {\n            PenId = pen.Id,\n            RationId = ration.Id,\n            PlanDate = request.PlanDate,\n            DailyBunkRateLbPerHead = (decimal)request.DailyBunkRateLbPerHead,\n            CurrentPenHeadcount = request.CurrentPenHeadcount,\n            PlannedTime = new TimeOnly(7, 0),\n            Status = \"Planned\"\n        };\n        db.Add(plan);\n        await db.SaveChangesAsync();\n        return Results.Json(new PlanResponse(ToPlan(plan, pen, ration, 0m, false)),\n            statusCode: StatusCodes.Status201Created);\n    }\n\n    private static async Task<FeedingLogResponse> GetFeedingActivities([FromQuery] DateOnly? date, [FromQuery] int? penId, AppDb db)\n    {\n        IQueryable<FeedingActivityEntity> query = db.Set<FeedingActivityEntity>().AsNoTracking()\n            .Include(activity => activity.Pen)\n            .Include(activity => activity.Ration)\n            .Include(activity => activity.FeedingPlan)\n            .Include(activity => activity.LotConsumptions).ThenInclude(consumption => consumption.Lot)\n            .Include(activity => activity.IngredientConsumptions).ThenInclude(consumption => consumption.Item);\n        if (date.HasValue) query = query.Where(activity => activity.ActivityDate == date.Value);\n        if (penId.HasValue) query = query.Where(activity => activity.PenId == penId.Value);\n        var activities = await query.OrderBy(activity => activity.ActivityDate).ThenBy(activity => activity.Id).ToListAsync();\n        return new FeedingLogResponse(activities.Select(ToActivity).ToList());\n    }\n\n    private static async Task<IResult> CreateFeedingActivity(FeedingActivityRequest request, AppDb db)\n    {\n        if (request.PenId <= 0 || request.RationId <= 0 || request.Date == default ||\n            request.LotQuantities is null || request.LotQuantities.Count == 0 ||\n            request.LotQuantities.Any(value => value.LotId <= 0 || !CanStore(value.ActualQuantityLb) || value.ActualQuantityLb <= 0))\n            return ApiErrors.ValidationError(details: [\"penId, rationId, date, and positive finite lot quantities are required.\"]);\n        if (request.LotQuantities.Select(value => value.LotId).Distinct().Count() != request.LotQuantities.Count)\n            return ApiErrors.Conflict(\"Each lot may appear only once in an activity.\");\n\n        var pen = await db.Set<PenEntity>().AsNoTracking().FirstOrDefaultAsync(value => value.Id == request.PenId);\n        if (pen is null) return ApiErrors.NotFound(\"The requested pen was not found.\");\n        var ration = await db.Set<RationEntity>().AsNoTracking().Include(value => value.Ingredients)\n            .ThenInclude(ingredient => ingredient.Item).FirstOrDefaultAsync(value => value.Id == request.RationId);\n        if (ration is null) return ApiErrors.NotFound(\"The requested ration was not found.\");\n        if (!HasValidRation(ration))\n            return ApiErrors.ValidationError(\"The ration must contain valid ingredient proportions totaling 100 percent.\");\n\n        FeedingPlanEntity? plan = null;\n","chars":14553,"exitCode":0}
{"ts":1791978079157,"kind":"call","tool":"Bash","input":"{\"command\":\"sed -n '1,150p' App.Api/Endpoints/RationEndpoints.cs\"}","output":"using App.Api.Data;\nusing Microsoft.AspNetCore.Http;\nusing Microsoft.AspNetCore.OpenApi;\nusing Microsoft.EntityFrameworkCore;\nusing Microsoft.Extensions.Options;\nusing Microsoft.OpenApi.Models;\n\nnamespace App.Api.Endpoints;\n\ninternal sealed class RationEndpoints : IEndpointModule\n{\n    public void MapEndpoints(IEndpointRouteBuilder app)\n    {\n        app.ServiceProvider.GetRequiredService<IOptionsMonitor<OpenApiOptions>>().Get(\"v1\")\n            .AddSchemaTransformer((schema, context, _) =>\n            {\n                if (context.JsonTypeInfo.Type == typeof(OptimizationResponse) &&\n                    schema.Properties.TryGetValue(\"infeasibleCandidates\", out var infeasibleCandidates))\n                {\n                    infeasibleCandidates.Items = new OpenApiSchema\n                    {\n                        Reference = new OpenApiReference { Type = ReferenceType.Schema, Id = nameof(RationCandidate) }\n                    };\n                }\n                return Task.CompletedTask;\n            });\n\n        app.MapGet(\"/rations\", GetRations)\n            .WithName(\"getRations\")\n            .Produces<RationsResponse>(StatusCodes.Status200OK)\n            .Produces<ErrorResponse>(StatusCodes.Status400BadRequest)\n            .Produces<ErrorResponse>(StatusCodes.Status500InternalServerError);\n\n        app.MapPost(\"/rations\", CreateRation)\n            .WithName(\"createRation\")\n            .Produces<Ration>(StatusCodes.Status201Created)\n            .Produces<ErrorResponse>(StatusCodes.Status400BadRequest)\n            .Produces<ErrorResponse>(StatusCodes.Status409Conflict)\n            .Produces<ErrorResponse>(StatusCodes.Status422UnprocessableEntity);\n\n        app.MapPost(\"/rations/optimize\", OptimizeRation)\n            .WithName(\"optimizeRation\")\n            .Produces<OptimizationResponse>(StatusCodes.Status200OK)\n            .Produces<ErrorResponse>(StatusCodes.Status400BadRequest)\n            .Produces<ErrorResponse>(StatusCodes.Status422UnprocessableEntity);\n\n        app.MapPost(\"/rations/selection\", SelectRationCandidate)\n            .WithName(\"selectRationCandidate\")\n            .Produces<RationSelectionResponse>(StatusCodes.Status200OK)\n            .Produces<ErrorResponse>(StatusCodes.Status400BadRequest)\n            .Produces<ErrorResponse>(StatusCodes.Status404NotFound)\n            .Produces<ErrorResponse>(StatusCodes.Status422UnprocessableEntity);\n    }\n\n    private static async Task<RationsResponse> GetRations(AppDb db)\n    {\n        var rations = await db.Set<RationEntity>().AsNoTracking().Include(ration => ration.Ingredients)\n            .ThenInclude(ingredient => ingredient.Item).OrderBy(ration => ration.Id).ToListAsync();\n        return new RationsResponse(rations.Select(ToRation).ToList());\n    }\n\n    private static async Task<IResult> CreateRation(RationRequest request, AppDb db)\n    {\n        if (string.IsNullOrWhiteSpace(request.Name) || string.IsNullOrWhiteSpace(request.Type) ||\n            string.IsNullOrWhiteSpace(request.OperationalStatus) || !CanStore(request.TargetWeightMinLb) ||\n            !CanStore(request.TargetWeightMaxLb) || request.TargetWeightMinLb <= 0 ||\n            request.TargetWeightMaxLb < request.TargetWeightMinLb || request.Ingredients is null ||\n            request.Ingredients.Count == 0)\n            return ApiErrors.ValidationError(details: [\"Ration identity, target weights, status, and ingredients are required and must be valid.\"]);\n\n        if (request.Ingredients.Any(ingredient => ingredient.ItemId <= 0 || !float.IsFinite(ingredient.ProportionPercent) ||\n                ingredient.ProportionPercent <= 0))\n            return ApiErrors.ValidationError(details: [\"Ingredient itemIds and proportions must be positive finite values.\"]);\n        if (request.Ingredients.Select(ingredient => ingredient.ItemId).Distinct().Count() != request.Ingredients.Count)\n            return ApiErrors.ValidationError(details: [\"Each ingredient itemId may only appear once.\"]);\n        if (Math.Abs(request.Ingredients.Sum(ingredient => ingredient.ProportionPercent) - 100f) > 0.01f)\n            return ApiErrors.ValidationError(details: [\"Ingredient proportions must total 100 percent.\"]);\n\n        var name = request.Name.Trim();\n        if (await db.Set<RationEntity>().AnyAsync(ration => ration.Name == name))\n            return ApiErrors.Conflict(\"A ration with that name already exists.\");\n\n        var itemIds = request.Ingredients.Select(ingredient => ingredient.ItemId).ToArray();\n        var items = await db.Set<InventoryItemEntity>().Where(item => itemIds.Contains(item.Id)).ToDictionaryAsync(item => item.Id);\n        if (items.Count != itemIds.Length)\n            return ApiErrors.ValidationError(\"One or more ration ingredients reference an unknown inventory item.\");\n\n        var ration = new RationEntity\n        {\n            Name = name,\n            Type = request.Type.Trim(),\n            TargetWeightMinLb = (decimal)request.TargetWeightMinLb,\n            TargetWeightMaxLb = (decimal)request.TargetWeightMaxLb,\n            OperationalStatus = request.OperationalStatus.Trim(),\n            Ingredients = request.Ingredients.Select(ingredient => new RationIngredientEntity\n            {\n                ItemId = ingredient.ItemId,\n                ProportionPercent = (decimal)ingredient.ProportionPercent\n            }).ToList()\n        };\n        db.Add(ration);\n        await db.SaveChangesAsync();\n\n        foreach (var ingredient in ration.Ingredients)\n            ingredient.Item = items[ingredient.ItemId];\n        return Results.Json(ToRation(ration), statusCode: StatusCodes.Status201Created);\n    }\n\n    private static async Task<IResult> OptimizeRation(RationOptimizationRequest request, AppDb db)\n    {\n        if (!CanStore(request.TargetWeightMinLb) || !CanStore(request.TargetWeightMaxLb) ||\n            !CanStore(request.MinimumDryMatterPercent) || !CanStore(request.MinimumEnergyMcalPerKg) ||\n            request.TargetWeightMinLb <= 0 || request.TargetWeightMaxLb < request.TargetWeightMinLb ||\n            request.MinimumDryMatterPercent < 0 || request.MinimumDryMatterPercent > 100 ||\n            request.MinimumEnergyMcalPerKg < 0)\n            return ApiErrors.ValidationError(details: [\"Optimization constraints are outside their valid ranges.\"]);\n\n        var items = await db.Set<InventoryItemEntity>().AsNoTracking().OrderBy(item => item.Id).ToListAsync();\n        var mixes = CreateCandidateMixes(items);\n        var candidates = mixes.Select(mix =>\n        {\n            var dryMatter = mix.Sum(part => part.Item.DryMatterPercent * part.ProportionPercent / 100m);\n            var energy = mix.Sum(part => part.Item.EnergyMcalPerKg * part.ProportionPercent / 100m);\n            return new RationCandidateEntity\n            {\n                // A single-ingredient suggestion is ineligible when a blend can be made.\n                Feasible = dryMatter >= (decimal)request.MinimumDryMatterPercent &&\n                    energy >= (decimal)request.MinimumEnergyMcalPerKg && (items.Count == 1 || mix.Count > 1),\n                TargetWeightMinLb = (decimal)request.TargetWeightMinLb,\n                TargetWeightMaxLb = (decimal)request.TargetWeightMaxLb,\n                MinimumDryMatterPercent = (decimal)request.MinimumDryMatterPercent,\n                MinimumEnergyMcalPerKg = (decimal)request.MinimumEnergyMcalPerKg,\n                PredictedDryMatterPercent = dryMatter,\n                PredictedEnergyMcalPerKg = energy,\n                Ingredients = mix.Select(part => new RationCandidateIngredientEntity\n                {\n                    ItemId = part.Item.Id,\n                    ProportionPercent = part.ProportionPercent\n                }).ToList()\n            };\n        }).ToList();\n\n        db.AddRange(candidates);\n        await db.SaveChangesAsync();\n        foreach (var candidate in candidates)\n            foreach (var ingredient in candidate.Ingredients)\n                ingredient.Item = items.Single(item => item.Id == ingredient.ItemId);\n\n        var feasible = candidates.Where(candidate => candidate.Feasible)\n            .OrderBy(CandidateCost).ThenBy(candidate => candidate.CandidateId).Select(ToCandidate).ToList();\n","chars":8181,"exitCode":0}
{"ts":1791978079161,"kind":"call","tool":"Bash","input":"{\"command\":\"sed -n '1,175p' App.Api/Endpoints/InventoryEndpoints.cs\"}","output":"using System.Text.Json.Serialization;\nusing App.Api.Data;\nusing Microsoft.AspNetCore.Http;\nusing Microsoft.AspNetCore.Mvc;\nusing Microsoft.AspNetCore.OpenApi;\nusing Microsoft.EntityFrameworkCore;\nusing Microsoft.OpenApi.Any;\nusing Microsoft.OpenApi.Models;\nusing Microsoft.Extensions.Options;\n\nnamespace App.Api.Endpoints;\n\ninternal sealed class InventoryEndpoints : IEndpointModule\n{\n    private const string DefaultScope = \"default\";\n    private const decimal DefaultWastageRatio = 0.04m;\n\n    public void MapEndpoints(IEndpointRouteBuilder app)\n    {\n        app.ServiceProvider.GetRequiredService<IOptionsMonitor<OpenApiOptions>>().Get(\"v1\")\n            .AddOperationTransformer(new OutlookHorizonOperationTransformer());\n\n        app.MapGet(\"/inventory/items\", GetInventoryItems)\n            .WithName(\"getInventoryItems\")\n            .Produces<InventoryResponse>(StatusCodes.Status200OK)\n            .Produces<ErrorResponse>(StatusCodes.Status400BadRequest)\n            .Produces<ErrorResponse>(StatusCodes.Status500InternalServerError);\n\n        app.MapPost(\"/inventory/movements\", RecordInventoryMovement)\n            .WithName(\"recordInventoryMovement\")\n            .Produces<MovementCreatedResponse>(StatusCodes.Status201Created)\n            .Produces<ErrorResponse>(StatusCodes.Status400BadRequest)\n            .Produces<ErrorResponse>(StatusCodes.Status404NotFound)\n            .Produces<ErrorResponse>(StatusCodes.Status409Conflict)\n            .Produces<ErrorResponse>(StatusCodes.Status422UnprocessableEntity);\n\n        app.MapPost(\"/inventory/wastage\", RecordActualWastage)\n            .WithName(\"recordActualWastage\")\n            .Produces<MovementCreatedResponse>(StatusCodes.Status201Created)\n            .Produces<ErrorResponse>(StatusCodes.Status400BadRequest)\n            .Produces<ErrorResponse>(StatusCodes.Status404NotFound)\n            .Produces<ErrorResponse>(StatusCodes.Status409Conflict)\n            .Produces<ErrorResponse>(StatusCodes.Status422UnprocessableEntity);\n\n        app.MapPatch(\"/inventory/settings\", UpdateInventorySettings)\n            .WithName(\"updateInventorySettings\")\n            .Produces<InventorySettingsResponse>(StatusCodes.Status200OK)\n            .Produces<ErrorResponse>(StatusCodes.Status400BadRequest)\n            .Produces<ErrorResponse>(StatusCodes.Status422UnprocessableEntity);\n\n        app.MapGet(\"/inventory/outlook\", GetInventoryOutlook)\n            .WithName(\"getInventoryOutlook\")\n            .Produces<OutlookResponse>(StatusCodes.Status200OK)\n            .Produces<ErrorResponse>(StatusCodes.Status400BadRequest)\n            .Produces<ErrorResponse>(StatusCodes.Status422UnprocessableEntity)\n            .Produces<ErrorResponse>(StatusCodes.Status500InternalServerError);\n    }\n\n    private static async Task<InventoryResponse> GetInventoryItems(AppDb db)\n    {\n        var items = await db.Set<InventoryItemEntity>().AsNoTracking().OrderBy(item => item.Id).ToListAsync();\n        var movements = await db.Set<InventoryMovementEntity>().AsNoTracking()\n            .OrderBy(movement => movement.Date).ThenBy(movement => movement.Id).ToListAsync();\n        var movementsByItem = movements.GroupBy(movement => movement.ItemId)\n            .ToDictionary(group => group.Key, group => group.ToList());\n        var settings = await db.Set<InventorySettingEntity>().AsNoTracking()\n            .FirstOrDefaultAsync(setting => setting.Scope == DefaultScope);\n        var wastageRatio = settings?.WastageRatio ?? DefaultWastageRatio;\n\n        return new InventoryResponse((float)wastageRatio, items.Select(item => ToInventoryItem(item,\n            movementsByItem.GetValueOrDefault(item.Id) ?? [])).ToList());\n    }\n\n    private static async Task<IResult> RecordInventoryMovement(InventoryMovementRequest request, AppDb db)\n    {\n        if (request.Date == default || string.IsNullOrWhiteSpace(request.Note) || !CanStore(request.QuantityLb))\n            return ApiErrors.ValidationError(details: [\"date, note, and a finite quantityLb are required.\"]);\n        if (request.MovementType == InventoryMovementRequestType.Received && request.QuantityLb <= 0)\n            return ApiErrors.ValidationError(details: [\"Received quantityLb must be greater than zero.\"]);\n        if (request.MovementType == InventoryMovementRequestType.Adjustment && request.QuantityLb == 0)\n            return ApiErrors.ValidationError(details: [\"Adjustment quantityLb must not be zero.\"]);\n\n        var item = await db.Set<InventoryItemEntity>().FirstOrDefaultAsync(value => value.Id == request.ItemId);\n        if (item is null) return ApiErrors.NotFound(\"The requested inventory item was not found.\");\n\n        var movementType = request.MovementType == InventoryMovementRequestType.Received ? \"received\" : \"adjustment\";\n        var movement = new InventoryMovementEntity\n        {\n            ItemId = item.Id,\n            MovementType = movementType,\n            Date = request.Date,\n            QuantityLb = (decimal)request.QuantityLb,\n            Note = request.Note.Trim()\n        };\n        if (movementType == \"adjustment\" && (await CurrentStock(db, item) + movement.QuantityLb) < 0)\n            return ApiErrors.Conflict(\"The adjustment would make inventory stock negative.\");\n\n        db.Add(movement);\n        await db.SaveChangesAsync();\n        var allMovements = await db.Set<InventoryMovementEntity>().AsNoTracking()\n            .Where(value => value.ItemId == item.Id).OrderBy(value => value.Date).ThenBy(value => value.Id).ToListAsync();\n        return Results.Json(new MovementCreatedResponse(ToMovement(movement),\n            ToInventoryItem(item, allMovements)), statusCode: StatusCodes.Status201Created);\n    }\n\n    private static async Task<IResult> RecordActualWastage(ActualWastageRequest request, AppDb db)\n    {\n        if (request.RecordDate == default || !CanStore(request.ActualWastageLb) || request.ActualWastageLb <= 0 ||\n            string.IsNullOrWhiteSpace(request.WastageCause))\n            return ApiErrors.ValidationError(details: [\"recordDate, a positive actualWastageLb, and wastageCause are required.\"]);\n\n        var item = await db.Set<InventoryItemEntity>().FirstOrDefaultAsync(value => value.Id == request.ItemId);\n        if (item is null) return ApiErrors.NotFound(\"The requested inventory item was not found.\");\n\n        var quantity = (decimal)request.ActualWastageLb;\n        if (await CurrentStock(db, item) < quantity)\n            return ApiErrors.Conflict(\"The wastage quantity exceeds available inventory stock.\");\n\n        var movement = new InventoryMovementEntity\n        {\n            ItemId = item.Id,\n            MovementType = \"actual_wastage\",\n            Date = request.RecordDate,\n            QuantityLb = quantity,\n            Note = request.WastageCause.Trim(),\n            WastageCause = request.WastageCause.Trim()\n        };\n        db.Add(movement);\n        await db.SaveChangesAsync();\n        var allMovements = await db.Set<InventoryMovementEntity>().AsNoTracking()\n            .Where(value => value.ItemId == item.Id).OrderBy(value => value.Date).ThenBy(value => value.Id).ToListAsync();\n        return Results.Json(new MovementCreatedResponse(ToMovement(movement),\n            ToInventoryItem(item, allMovements)), statusCode: StatusCodes.Status201Created);\n    }\n\n    private static async Task<IResult> UpdateInventorySettings(InventorySettingsRequest request, AppDb db)\n    {\n        if (!float.IsFinite(request.WastageRatio) || request.WastageRatio < 0 || request.WastageRatio > 1)\n            return ApiErrors.ValidationError(details: [\"wastageRatio must be between zero and one.\"]);\n\n        var setting = await db.Set<InventorySettingEntity>().FirstOrDefaultAsync(value => value.Scope == DefaultScope);\n        if (setting is null)\n        {\n            setting = new InventorySettingEntity { Scope = DefaultScope };\n            db.Add(setting);\n        }\n        setting.WastageRatio = (decimal)request.WastageRatio;\n        await db.SaveChangesAsync();\n        return Results.Ok(new InventorySettingsResponse((float)setting.WastageRatio));\n    }\n\n    private static async Task<IResult> GetInventoryOutlook([FromQuery] string horizon, [FromQuery] float wastageRatio, AppDb db)\n    {\n        var days = HorizonDays(horizon);\n        if (days is null)\n            return ApiErrors.ValidationError(details: [\"horizon must be daily, weekly, monthly, quarterly, bi-annual, or annual.\"]);\n        if (!float.IsFinite(wastageRatio) || wastageRatio < 0 || wastageRatio > 1)\n            return ApiErrors.ValidationError(details: [\"wastageRatio must be between zero and one.\"]);\n\n        var items = await db.Set<InventoryItemEntity>().AsNoTracking().OrderBy(item => item.Id).ToListAsync();\n        var movements = await db.Set<InventoryMovementEntity>().AsNoTracking().OrderBy(movement => movement.Date)\n            .ThenBy(movement => movement.Id).ToListAsync();\n        var balances = items.Select(item =>\n        {\n            var itemMovements = movements.Where(movement => movement.ItemId == item.Id).ToList();\n            var currentStock = InventoryTotals.For(item, itemMovements).ClosingStockLb;\n            var consumption = itemMovements.Where(movement => movement.MovementType == \"consumed\").ToList();\n            var dailyConsumption = consumption.Count == 0\n                ? 0m\n                : consumption.Sum(movement => movement.QuantityLb) /\n                  Math.Max(1, consumption.Max(movement => movement.Date.DayNumber) - consumption.Min(movement => movement.Date.DayNumber) + 1);\n            var projected = currentStock - dailyConsumption * days.Value * (1m + (decimal)wastageRatio);\n            return new OutlookBalance(item.Id, item.Name, (float)currentStock, (float)dailyConsumption, (float)projected);\n        }).ToList();\n\n","chars":9764,"exitCode":0}
