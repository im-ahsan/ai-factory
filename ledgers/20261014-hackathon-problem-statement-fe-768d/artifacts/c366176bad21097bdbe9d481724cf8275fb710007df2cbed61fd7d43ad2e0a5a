tyEntity>().AsNoTracking()\n            .Where(activity => activity.FeedingPlanId.HasValue && planIds.Contains(activity.FeedingPlanId.Value))\n            .GroupBy(activity => activity.FeedingPlanId!.Value)\n            .Select(group => new { PlanId = group.Key, Quantity = group.Sum(activity => activity.ActualQuantityLb) })\n            .ToDictionaryAsync(group => group.PlanId, group => group.Quantity);\n\n        return new PlansResponse(plans.Select(plan => ToPlan(plan,\n            pens.GetValueOrDefault(plan.PenId), rations.GetValueOrDefault(plan.RationId),\n            actuals.GetValueOrDefault(plan.Id), actuals.ContainsKey(plan.Id))).ToList());\n    }\n\n    private static async Task<IResult> CreateFeedingPlan(FeedingPlanRequest request, AppDb db)\n    {\n        if (request.PenId <= 0 || request.RationId <= 0 || request.PlanDate == default ||\n            request.CurrentPenHeadcount <= 0 || !CanStore(request.DailyBunkRateLbPerHead) ||\n            request.DailyBunkRateLbPerHead <= 0)\n            return ApiErrors.ValidationError(details: [\"penId, rationId, planDate, currentPenHeadcount, and a positive finite dailyBunkRateLbPerHead are required.\"]);\n\n        var pen = await db.Set<PenEntity>().AsNoTracking().Include(value => value.Lots)\n            .FirstOrDefaultAsync(value => value.Id == request.PenId);\n        if (pen is null) return ApiErrors.NotFound(\"The requested pen was not found.\");\n        var ration = await db.Set<RationEntity>().AsNoTracking().Include(value => value.Ingredients)\n            .ThenInclude(ingredient => ingredient.Item).FirstOrDefaultAsync(value => value.Id == request.RationId);\n        if (ration is null) return ApiErrors.NotFound(\"The requested ration was not found.\");\n        if (request.CurrentPenHeadcount > pen.Capacity)\n            return ApiErrors.Conflict(\"The requested headcount exceeds pen capacity.\");\n        if (await db.Set<FeedingPlanEntity>().AnyAsync(plan => plan.PenId == pen.Id && plan.PlanDate == re