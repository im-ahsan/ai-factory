{"ts":1791976435902,"kind":"call","tool":"Bash","input":"{\"command\":\"sed -n '1,280p' App.Api/Endpoints/RationEndpoints.cs\"}","output":"using App.Api.Data;\nusing Microsoft.AspNetCore.Http;\nusing Microsoft.EntityFrameworkCore;\n\nnamespace App.Api.Endpoints;\n\ninternal sealed class RationEndpoints : IEndpointModule\n{\n    public void MapEndpoints(IEndpointRouteBuilder app)\n    {\n        app.MapGet(\"/rations\", GetRations)\n            .WithName(\"getRations\")\n            .Produces<RationsResponse>(StatusCodes.Status200OK)\n            .Produces<ErrorResponse>(StatusCodes.Status400BadRequest)\n            .Produces<ErrorResponse>(StatusCodes.Status500InternalServerError);\n\n        app.MapPost(\"/rations\", CreateRation)\n            .WithName(\"createRation\")\n            .Produces<Ration>(StatusCodes.Status201Created)\n            .Produces<ErrorResponse>(StatusCodes.Status400BadRequest)\n            .Produces<ErrorResponse>(StatusCodes.Status409Conflict)\n            .Produces<ErrorResponse>(StatusCodes.Status422UnprocessableEntity);\n\n        app.MapPost(\"/rations/optimize\", OptimizeRation)\n            .WithName(\"optimizeRation\")\n            .Produces<OptimizationResponse>(StatusCodes.Status200OK)\n            .Produces<ErrorResponse>(StatusCodes.Status400BadRequest)\n            .Produces<ErrorResponse>(StatusCodes.Status422UnprocessableEntity);\n\n        app.MapPost(\"/rations/selection\", SelectRationCandidate)\n            .WithName(\"selectRationCandidate\")\n            .Produces<RationSelectionResponse>(StatusCodes.Status200OK)\n            .Produces<ErrorResponse>(StatusCodes.Status400BadRequest)\n            .Produces<ErrorResponse>(StatusCodes.Status404NotFound)\n            .Produces<ErrorResponse>(StatusCodes.Status422UnprocessableEntity);\n    }\n\n    private static async Task<RationsResponse> GetRations(AppDb db)\n    {\n        var rations = await db.Set<RationEntity>().AsNoTracking().Include(ration => ration.Ingredients)\n            .ThenInclude(ingredient => ingredient.Item).OrderBy(ration => ration.Id).ToListAsync();\n        return new RationsResponse(rations.Select(ToRation).ToList());\n    }\n\n    private static async Task<IResult> CreateRation(RationRequest request, AppDb db)\n    {\n        if (string.IsNullOrWhiteSpace(request.Name) || string.IsNullOrWhiteSpace(request.Type) ||\n            string.IsNullOrWhiteSpace(request.OperationalStatus) || !CanStore(request.TargetWeightMinLb) ||\n            !CanStore(request.TargetWeightMaxLb) || request.TargetWeightMinLb <= 0 ||\n            request.TargetWeightMaxLb < request.TargetWeightMinLb || request.Ingredients is null ||\n            request.Ingredients.Count == 0)\n            return ApiErrors.ValidationError(details: [\"Ration identity, target weights, status, and ingredients are required and must be valid.\"]);\n\n        if (request.Ingredients.Any(ingredient => ingredient.ItemId <= 0 || !float.IsFinite(ingredient.ProportionPercent) ||\n                ingredient.ProportionPercent <= 0))\n            return ApiErrors.ValidationError(details: [\"Ingredient itemIds and proportions must be positive finite values.\"]);\n        if (request.Ingredients.Select(ingredient => ingredient.ItemId).Distinct().Count() != request.Ingredients.Count)\n            return ApiErrors.ValidationError(details: [\"Each ingredient itemId may only appear once.\"]);\n        if (Math.Abs(request.Ingredients.Sum(ingredient => ingredient.ProportionPercent) - 100f) > 0.01f)\n            return ApiErrors.ValidationError(details: [\"Ingredient proportions must total 100 percent.\"]);\n\n        var name = request.Name.Trim();\n        if (await db.Set<RationEntity>().AnyAsync(ration => ration.Name == name))\n            return ApiErrors.Conflict(\"A ration with that name already exists.\");\n\n        var itemIds = request.Ingredients.Select(ingredient => ingredient.ItemId).ToArray();\n        var items = await db.Set<InventoryItemEntity>().Where(item => itemIds.Contains(item.Id)).ToDictionaryAsync(item => item.Id);\n        if (items.Count != itemIds.Length)\n            return ApiErrors.ValidationError(\"One or more ration ingredients reference an unknown inventory item.\");\n\n        var ration = new RationEntity\n        {\n            Name = name,\n            Type = request.Type.Trim(),\n            TargetWeightMinLb = (decimal)request.TargetWeightMinLb,\n            TargetWeightMaxLb = (decimal)request.TargetWeightMaxLb,\n            OperationalStatus = request.OperationalStatus.Trim(),\n            Ingredients = request.Ingredients.Select(ingredient => new RationIngredientEntity\n            {\n                ItemId = ingredient.ItemId,\n                ProportionPercent = (decimal)ingredient.ProportionPercent\n            }).ToList()\n        };\n        db.Add(ration);\n        await db.SaveChangesAsync();\n\n        foreach (var ingredient in ration.Ingredients)\n            ingredient.Item = items[ingredient.ItemId];\n        return Results.Json(ToRation(ration), statusCode: StatusCodes.Status201Created);\n    }\n\n    private static async Task<IResult> OptimizeRation(RationOptimizationRequest request, AppDb db)\n    {\n        if (!CanStore(request.TargetWeightMinLb) || !CanStore(request.TargetWeightMaxLb) ||\n            !CanStore(request.MinimumDryMatterPercent) || !CanStore(request.MinimumEnergyMcalPerKg) ||\n            request.TargetWeightMinLb <= 0 || request.TargetWeightMaxLb < request.TargetWeightMinLb ||\n            request.MinimumDryMatterPercent < 0 || request.MinimumDryMatterPercent > 100 ||\n            request.MinimumEnergyMcalPerKg < 0)\n            return ApiErrors.ValidationError(details: [\"Optimization constraints are outside their valid ranges.\"]);\n\n        var items = await db.Set<InventoryItemEntity>().AsNoTracking().OrderBy(item => item.Id).ToListAsync();\n        var mixes = CreateCandidateMixes(items);\n        var candidates = mixes.Select(mix =>\n        {\n            var cost = mix.Sum(part => part.Item.UnitCost * part.ProportionPercent / 100m);\n            var dryMatter = mix.Sum(part => part.Item.DryMatterPercent * part.ProportionPercent / 100m);\n            var energy = mix.Sum(part => part.Item.EnergyMcalPerKg * part.ProportionPercent / 100m);\n            return new RationCandidateEntity\n            {\n                Feasible = dryMatter >= (decimal)request.MinimumDryMatterPercent && energy >= (decimal)request.MinimumEnergyMcalPerKg,\n                TargetWeightMinLb = (decimal)request.TargetWeightMinLb,\n                TargetWeightMaxLb = (decimal)request.TargetWeightMaxLb,\n                MinimumDryMatterPercent = (decimal)request.MinimumDryMatterPercent,\n                MinimumEnergyMcalPerKg = (decimal)request.MinimumEnergyMcalPerKg,\n                PredictedDryMatterPercent = dryMatter,\n                PredictedEnergyMcalPerKg = energy,\n                Ingredients = mix.Select(part => new RationCandidateIngredientEntity\n                {\n                    ItemId = part.Item.Id,\n                    ProportionPercent = part.ProportionPercent\n                }).ToList()\n            };\n        }).ToList();\n\n        if (candidates.Count > 0 && candidates.All(candidate => candidate.Feasible))\n        {\n            candidates.Add(new RationCandidateEntity\n            {\n                Feasible = false,\n                TargetWeightMinLb = (decimal)request.TargetWeightMinLb,\n                TargetWeightMaxLb = (decimal)request.TargetWeightMaxLb,\n                MinimumDryMatterPercent = (decimal)request.MinimumDryMatterPercent,\n                MinimumEnergyMcalPerKg = (decimal)request.MinimumEnergyMcalPerKg\n            });\n        }\n\n        db.AddRange(candidates);\n        await db.SaveChangesAsync();\n        foreach (var candidate in candidates)\n            foreach (var ingredient in candidate.Ingredients)\n                ingredient.Item = items.Single(item => item.Id == ingredient.ItemId);\n\n        var feasible = candidates.Where(candidate => candidate.Feasible)\n            .OrderBy(CandidateCost).ThenBy(candidate => candidate.CandidateId).Select(ToCandidate).ToList();\n        var infeasible = candidates.Where(candidate => !candidate.Feasible)\n            .OrderBy(CandidateCost).ThenBy(candidate => candidate.CandidateId).Select(ToCandidate).ToList();\n        return Results.Ok(new OptimizationResponse(feasible, infeasible));\n    }\n\n    private static async Task<IResult> SelectRationCandidate(RationSelectionRequest request, AppDb db)\n    {\n        if (request.CandidateId <= 0)\n            return ApiErrors.ValidationError(details: [\"candidateId must be greater than zero.\"]);\n\n        var candidate = await db.Set<RationCandidateEntity>().Include(value => value.Ingredients)\n            .ThenInclude(ingredient => ingredient.Item).FirstOrDefaultAsync(value => value.CandidateId == request.CandidateId);\n        if (candidate is null)\n            return ApiErrors.NotFound(\"The requested ration candidate was not found.\");\n        if (!candidate.Feasible)\n            return ApiErrors.ValidationError(\"Only feasible ration candidates can be selected.\");\n\n        return Results.Ok(new RationSelectionResponse(ToCandidate(candidate), false));\n    }\n\n    private static List<List<CandidatePart>> CreateCandidateMixes(IReadOnlyList<InventoryItemEntity> items)\n    {\n        var mixes = new List<List<CandidatePart>>();\n        foreach (var item in items)\n            mixes.Add([new CandidatePart(item, 100m)]);\n\n        for (var first = 0; first < items.Count; first++)\n        {\n            for (var second = first + 1; second < items.Count; second++)\n            {\n                for (var firstPercent = 10; firstPercent < 100; firstPercent += 10)\n                {\n                    mixes.Add([\n                        new CandidatePart(items[first], firstPercent),\n                        new CandidatePart(items[second], 100m - firstPercent)\n                    ]);\n                }\n            }\n        }\n\n        if (items.Count > 2)\n        {\n            var share = decimal.Round(100m / items.Count, 6);\n            var equalMix = items.Select(item => new CandidatePart(item, share)).ToList();\n            equalMix[^1] = equalMix[^1] with { ProportionPercent = 100m - equalMix.Take(equalMix.Count - 1).Sum(part => part.ProportionPercent) };\n            mixes.Add(equalMix);\n        }\n        return mixes;\n    }\n\n    private static decimal CandidateCost(RationCandidateEntity candidate) => candidate.Ingredients\n        .Sum(ingredient => ingredient.Item.UnitCost * ingredient.ProportionPercent / 100m);\n\n    private static Ration ToRation(RationEntity ration)\n    {\n        var ingredients = ration.Ingredients.OrderBy(ingredient => ingredient.ItemId)\n            .Select(ingredient => ToRationIngredient(ingredient.Item, ingredient.ProportionPercent)).ToList();\n        var costPerLb = ration.Ingredients.Sum(ingredient => ingredient.Item.UnitCost * ingredient.ProportionPercent / 100m);\n        return new Ration(ration.Id, ration.Name, ration.Type, (float)ration.TargetWeightMinLb,\n            (float)ration.TargetWeightMaxLb, ration.OperationalStatus, (float)costPerLb, ingredients);\n    }\n\n    private static RationCandidate ToCandidate(RationCandidateEntity candidate)\n    {\n        var ingredients = candidate.Ingredients.OrderBy(ingredient => ingredient.ItemId)\n            .Select(ingredient => ToRationIngredient(ingredient.Item, ingredient.ProportionPercent)).ToList();\n        var costPerLb = CandidateCost(candidate);\n        return new RationCandidate(candidate.CandidateId, candidate.Feasible, (float)costPerLb, ingredients,\n            (float)candidate.PredictedDryMatterPercent, (float)candidate.PredictedEnergyMcalPerKg);\n    }\n\n    private static RationIngredient ToRationIngredient(InventoryItemEntity item, decimal proportionPercent) => new(\n        item.Id, item.Name, (float)proportionPercent, (float)item.DryMatterPercent, (float)item.EnergyMcalPerKg,\n        (float)item.UnitCost);\n\n    private static bool CanStore(float value) => float.IsFinite(value) && Math.Abs((double)value) <= (double)decimal.MaxValue;\n\n    private sealed record CandidatePart(InventoryItemEntity Item, decimal ProportionPercent);\n}\n\ninternal sealed record RationsResponse(IReadOnlyList<Ration> Rations);\ninternal sealed record Ration(int Id, string Name, string Type, float TargetWeightMinLb, float TargetWeightMaxLb,\n    string OperationalStatus, float CostPerLb, IReadOnlyList<RationIngredient> Ingredients);\ninternal sealed record RationIngredient(int ItemId, string Name, float ProportionPercent, float DryMatterPercent,\n    float EnergyMcalPerKg, float CostPerLb);\ninternal sealed record RationRequest(string Name, string Type, float TargetWeightMinLb, float TargetWeightMaxLb,\n    string OperationalStatus, IReadOnlyList<RationIngredientRequest> Ingredients);\ninternal sealed record RationIngredientRequest(int ItemId, float ProportionPercent);\ninternal sealed record RationOptimizationRequest(float TargetWeightMinLb, float TargetWeightMaxLb,\n    float MinimumDryMatterPercent, float MinimumEnergyMcalPerKg);\ninternal sealed record RationCandidate(int CandidateId, bool Feasible, float CostPerLb,\n    IReadOnlyList<RationIngredient> Ingredients, float PredictedDryMatterPercent, float PredictedEnergyMcalPerKg);\ninternal sealed record OptimizationResponse(IReadOnlyList<RationCandidate> FeasibleCandidates,\n    IReadOnlyList<RationCandidate> InfeasibleCandidates);\ninternal sealed record RationSelectionRequest(int CandidateId);\ninternal sealed record RationSelectionResponse(RationCandidate SelectedCandidate, bool Applied);\n","chars":13356,"exitCode":0}
