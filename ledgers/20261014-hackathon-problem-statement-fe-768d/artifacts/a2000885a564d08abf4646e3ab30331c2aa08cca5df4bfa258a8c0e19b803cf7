sponses/Conflict\"\n        \"422\":\n          $ref: \"#/components/responses/ValidationError\"\n  /inventory/settings:\n    patch:\n      operationId: updateInventorySettings\n      requestBody:\n        required: true\n        content:\n          application/json:\n            schema:\n              $ref: \"#/components/schemas/InventorySettingsRequest\"\n      responses:\n        \"200\":\n          $ref: \"#/components/responses/InventorySettingsOk\"\n        \"400\":\n          $ref: \"#/components/responses/BadRequest\"\n        \"422\":\n          $ref: \"#/components/responses/ValidationError\"\n  /inventory/outlook:\n    get:\n      operationId: getInventoryOutlook\n      parameters:\n        - name: horizon\n          in: query\n          required: true\n          schema:\n            type: string\n            enum:\n              - daily\n              - weekly\n              - monthly\n              - quarterly\n              - bi-annual\n              - annual\n        - name: wastageRatio\n          in: query\n          required: true\n          schema:\n            type: number\n            format: float\n      responses:\n        \"200\":\n          $ref: \"#/components/responses/OutlookOk\"\n        \"400\":\n          $ref: \"#/components/responses/BadRequest\"\n        \"422\":\n          $ref: \"#/components/responses/ValidationError\"\n        \"500\":\n          $ref: \"#/components/responses/ServerError\"\n  /rations:\n    get:\n      operationId: getRations\n      responses:\n        \"200\":\n          $ref: \"#/components/responses/RationsOk\"\n        \"400\":\n          $ref: \"#/components/responses/BadRequest\"\n        \"500\":\n          $ref: \"#/components/responses/ServerError\"\n    post:\n      operationId: createRation\n      requestBody:\n        required: true\n        content:\n          application/json:\n            schema:\n              $ref: \"#/components/schemas/RationRequest\"\n      responses:\n        \"201\":\n   