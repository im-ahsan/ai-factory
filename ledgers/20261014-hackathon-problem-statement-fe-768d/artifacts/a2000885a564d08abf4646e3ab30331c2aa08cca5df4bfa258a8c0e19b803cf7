{"ts":1791976435921,"kind":"call","tool":"Bash","input":"{\"command\":\"sed -n '1,210p' App.Api/Data/CoreEntities.cs && sed -n '1,220p' App.Api/Program.cs\"}","output":"using System.ComponentModel.DataAnnotations.Schema;\nusing Microsoft.EntityFrameworkCore;\nusing Microsoft.EntityFrameworkCore.Metadata.Builders;\n\nnamespace App.Api.Data;\n\ninternal static class CoreEntities\n{\n    internal static void Discover(ModelBuilder modelBuilder)\n    {\n        foreach (var entityType in typeof(CoreEntities).Assembly.GetTypes()\n            .Where(t => t.IsClass && !t.IsAbstract && t.GetCustomAttributes(typeof(TableAttribute), inherit: false).Length > 0))\n        {\n            modelBuilder.Entity(entityType);\n        }\n\n        modelBuilder.ApplyConfigurationsFromAssembly(typeof(CoreEntities).Assembly);\n    }\n\n    internal sealed class ImportBatchConfiguration : IEntityTypeConfiguration<ImportBatchEntity>\n    {\n        public void Configure(EntityTypeBuilder<ImportBatchEntity> builder)\n        {\n            builder.ToTable(\"ImportBatches\");\n            builder.HasKey(x => x.BatchId);\n            builder.Property(x => x.BatchId).ValueGeneratedNever();\n            builder.Property(x => x.SourceName).IsRequired();\n        }\n    }\n\n    internal sealed class ImportRowConfiguration : IEntityTypeConfiguration<ImportRowEntity>\n    {\n        public void Configure(EntityTypeBuilder<ImportRowEntity> builder)\n        {\n            builder.ToTable(\"ImportRows\");\n            builder.HasKey(x => x.Id);\n            builder.Property(x => x.Id).ValueGeneratedOnAdd();\n            builder.HasOne(x => x.Batch).WithMany(x => x.Rows).HasForeignKey(x => x.BatchId).OnDelete(DeleteBehavior.Cascade);\n            builder.Property(x => x.SourceIdentifier).IsRequired();\n            builder.Property(x => x.SourceType).IsRequired();\n            builder.Property(x => x.Vendor).IsRequired();\n            builder.Property(x => x.Cost).IsRequired();\n            builder.Property(x => x.HeadCount).IsRequired();\n            builder.Property(x => x.WeightLb).IsRequired();\n            builder.Property(x => x.Breed).IsRequired();\n            builder.Property(x => x.AgeDays).IsRequired();\n            builder.Property(x => x.Source).IsRequired();\n            builder.Property(x => x.RowStatus).IsRequired();\n        }\n    }\n\n    internal sealed class PenConfiguration : IEntityTypeConfiguration<PenEntity>\n    {\n        public void Configure(EntityTypeBuilder<PenEntity> builder)\n        {\n            builder.ToTable(\"Pens\");\n            builder.HasKey(x => x.Id);\n            builder.Property(x => x.Id).ValueGeneratedOnAdd();\n            builder.HasIndex(x => x.Name).IsUnique();\n            builder.Property(x => x.Name).IsRequired();\n            builder.Property(x => x.Capacity).IsRequired();\n        }\n    }\n\n    internal sealed class LotConfiguration : IEntityTypeConfiguration<LotEntity>\n    {\n        public void Configure(EntityTypeBuilder<LotEntity> builder)\n        {\n            builder.ToTable(\"Lots\");\n            builder.HasKey(x => x.Id);\n            builder.Property(x => x.Id).ValueGeneratedOnAdd();\n            builder.HasOne(x => x.Pen).WithMany(x => x.Lots).HasForeignKey(x => x.PenId).OnDelete(DeleteBehavior.SetNull);\n            builder.Property(x => x.Name).IsRequired();\n            builder.Property(x => x.HeadCount).IsRequired();\n            builder.Property(x => x.Breed).IsRequired();\n            builder.Property(x => x.Sex).IsRequired();\n            builder.Property(x => x.SourcePurchaseOrderLine).IsRequired();\n            builder.Property(x => x.Status).IsRequired();\n            builder.Property(x => x.TargetWeightLb).IsRequired();\n            builder.Property(x => x.DefaultGainRateLbPerDay).IsRequired();\n        }\n    }\n}\n\n[Table(\"ImportBatches\")]\ninternal sealed class ImportBatchEntity\n{\n    public string BatchId { get; set; } = \"\";\n    public string SourceName { get; set; } = \"\";\n    public ICollection<ImportRowEntity> Rows { get; set; } = new List<ImportRowEntity>();\n}\n\n[Table(\"ImportRows\")]\ninternal sealed class ImportRowEntity\n{\n    public int Id { get; set; }\n    public string BatchId { get; set; } = \"\";\n    public ImportBatchEntity Batch { get; set; } = null!;\n    public string SourceIdentifier { get; set; } = \"\";\n    public string SourceType { get; set; } = \"\";\n    public string Vendor { get; set; } = \"\";\n    public decimal Cost { get; set; }\n    public int HeadCount { get; set; }\n    public decimal WeightLb { get; set; }\n    public string Breed { get; set; } = \"\";\n    public int AgeDays { get; set; }\n    public string Source { get; set; } = \"\";\n    public string RowStatus { get; set; } = \"\";\n    public string? ProblemDetail { get; set; }\n}\n\n[Table(\"Pens\")]\ninternal sealed class PenEntity\n{\n    public int Id { get; set; }\n    public string Name { get; set; } = \"\";\n    public int Capacity { get; set; }\n    public ICollection<LotEntity> Lots { get; set; } = new List<LotEntity>();\n}\n\n[Table(\"Lots\")]\ninternal sealed class LotEntity\n{\n    public int Id { get; set; }\n    public string Name { get; set; } = \"\";\n    public int? PenId { get; set; }\n    public PenEntity? Pen { get; set; }\n    public int HeadCount { get; set; }\n    public string Breed { get; set; } = \"\";\n    public string Sex { get; set; } = \"\";\n    public string SourcePurchaseOrderLine { get; set; } = \"\";\n    public string Status { get; set; } = \"\";\n    public decimal TargetWeightLb { get; set; }\n    public decimal DefaultGainRateLbPerDay { get; set; }\n}\nusing App.Api;\nusing App.Api.Endpoints;\nusing Microsoft.EntityFrameworkCore;\n\nvar builder = WebApplication.CreateBuilder(args);\nbuilder.Services.AddOpenApi(options => options.AddSchemaTransformer((schema, context, _) =>\n{\n    if (context.JsonTypeInfo.Type == typeof(ErrorResponse))\n    {\n        schema.Required?.Remove(\"details\");\n        if (schema.Properties.TryGetValue(\"details\", out var details)) details.Nullable = false;\n    }\n    if (context.JsonTypeInfo.Type == typeof(ProjectDemoResponse) &&\n        schema.Properties.TryGetValue(\"validationCoverage\", out var validationCoverage) &&\n        schema.Properties.TryGetValue(\"productionReadiness\", out var productionReadiness))\n    {\n        productionReadiness.Items = validationCoverage.Items;\n    }\n    return Task.CompletedTask;\n}));\nbuilder.Services.Configure<RouteHandlerOptions>(o => o.ThrowOnBadRequest = true);\n// PostgreSQL: the connection comes from ConnectionStrings__App and nowhere else. There is no built-in login: an app that is\n// not given one stops when it first needs the database, so it can never run on a password that is written in the code.\nbuilder.Services.AddDbContext<AppDb>(o => o.UseNpgsql(builder.Configuration.GetConnectionString(\"App\")\n    ?? throw new InvalidOperationException(\"No database connection is configured. Set ConnectionStrings__App (for example Host=...;Port=5432;Database=...;Username=...;Password=«SECRET_1»")));\n// the web app's address: 3000 unless the setting Cors:Origin names another (the factory sets it when it starts the web app on another port)\nbuilder.Services.AddCors(o => o.AddDefaultPolicy(p => p.WithOrigins(builder.Configuration[\"Cors:Origin\"] ?? \"http://localhost:3000\").AllowAnyHeader().AllowAnyMethod()));\nvar app = builder.Build();\n// Create the database with every table when the app starts. The build also runs this file, to write the API's OpenAPI\n// document, and must not touch the database then. Keep this: the factory starts the app and reads the database it creates.\nif (System.Reflection.Assembly.GetEntryAssembly()?.GetName().Name != \"GetDocument.Insider\")\n{\n    // one at a time: the tests start several copies of the app in one process, and two creating the tables at once collide\n    lock (typeof(AppDb))\n    {\n        using var scope = app.Services.CreateScope();\n        var db = scope.ServiceProvider.GetRequiredService<AppDb>();\n        db.Database.EnsureCreated();\n        // sample rows, only when asked for (Seed__Demo=true): tests and the factory's own checks start on an empty database\n        if (app.Configuration.GetValue<bool>(\"Seed:Demo\")) SeedData.Run(db);\n    }\n}\napp.UseCors();\napp.Use(ApiErrors.Handle);\napp.MapGet(\"/\", () => \"API is up\").ExcludeFromDescription();\n// The API's own document (/openapi/v1.json) and a page to read and try it (/swagger). Keep both: the factory's product page links to the page.\napp.MapOpenApi();\napp.UseSwaggerUI(o => o.SwaggerEndpoint(\"/openapi/v1.json\", \"API\"));\n\nforeach (var moduleType in typeof(Program).Assembly.GetTypes()\n    .Where(t => !t.IsAbstract && !t.IsInterface && typeof(IEndpointModule).IsAssignableFrom(t)))\n{\n    var module = (IEndpointModule)Activator.CreateInstance(moduleType, nonPublic: true)!;\n    module.MapEndpoints(app);\n}\n\napp.Run();\n\npublic partial class Program { }\n","chars":8580,"exitCode":0}
