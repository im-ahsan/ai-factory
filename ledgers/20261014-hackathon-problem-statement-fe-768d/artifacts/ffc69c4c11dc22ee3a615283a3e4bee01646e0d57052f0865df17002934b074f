ch\")\n            .Produces<ImportSyncResponse>(StatusCodes.Status200OK)\n            .Produces<ErrorResponse>(StatusCodes.Status400BadRequest)\n            .Produces<ErrorResponse>(StatusCodes.Status404NotFound)\n            .Produces<ErrorResponse>(StatusCodes.Status409Conflict)\n            .Produces<ErrorResponse>(StatusCodes.Status422UnprocessableEntity);\n\n        app.MapGet(\"/lots\", GetLots)\n            .WithName(\"getLots\")\n            .WithSummary(\"Get lot and pen records\")\n            .Produces<LotsResponse>(StatusCodes.Status200OK)\n            .Produces<ErrorResponse>(StatusCodes.Status400BadRequest)\n            .Produces<ErrorResponse>(StatusCodes.Status500InternalServerError);\n\n        app.MapPost(\"/lots/mappings\", MapPurchaseOrderLine)\n            .WithName(\"mapPurchaseOrderLine\")\n            .WithSummary(\"Map a source purchase order line to lots and pens\")\n            .Produces<LotMappingResponse>(StatusCodes.Status200OK)\n            .Produces<ErrorResponse>(StatusCodes.Status400BadRequest)\n            .Produces<ErrorResponse>(StatusCodes.Status404NotFound)\n            .Produces<ErrorResponse>(StatusCodes.Status409Conflict)\n            .Produces<ErrorResponse>(StatusCodes.Status422UnprocessableEntity);\n\n        app.MapPatch(\"/lots/{lotId}/assumptions\", UpdateLotAssumptions)\n            .WithName(\"updateLotAssumptions\")\n            .Produces<ForecastResponse>(StatusCodes.Status200OK)\n            .Produces<ErrorResponse>(StatusCodes.Status400BadRequest)\n            .Produces<ErrorResponse>(StatusCodes.Status404NotFound)\n            .Produces<ErrorResponse>(StatusCodes.Status422UnprocessableEntity);\n\n        app.MapGet(\"/lots/{lotId}/forecast\", GetLotForecast)\n            .WithName(\"getLotForecast\")\n            .Produces<ForecastResponse>(StatusCodes.Status200OK)\n            .Produces<ErrorResponse>(StatusCodes.Status400BadRequest)\n            .Produces<ErrorResponse>(StatusCodes.Status404NotFound)\n       