{"ts":1791978557551,"kind":"call","tool":"Bash","input":"{\"command\":\"sed -n '1,100p' App.Api/Program.cs && sed -n '1,180p' App.Api/AppDb.cs && sed -n '1,200p' App.Api/Endpoints/RationEndpoints.cs\"}","output":"using App.Api;\nusing App.Api.Endpoints;\nusing Microsoft.EntityFrameworkCore;\n\nvar builder = WebApplication.CreateBuilder(args);\nbuilder.Services.AddOpenApi(options => options.AddSchemaTransformer((schema, context, _) =>\n{\n    if (context.JsonTypeInfo.Type == typeof(ErrorResponse))\n    {\n        schema.Required?.Remove(\"details\");\n        if (schema.Properties.TryGetValue(\"details\", out var details)) details.Nullable = false;\n    }\n    if (context.JsonTypeInfo.Type == typeof(ProjectDemoResponse) &&\n        schema.Properties.TryGetValue(\"validationCoverage\", out var validationCoverage) &&\n        schema.Properties.TryGetValue(\"productionReadiness\", out var productionReadiness))\n    {\n        productionReadiness.Items = validationCoverage.Items;\n    }\n    return Task.CompletedTask;\n}));\nbuilder.Services.Configure<RouteHandlerOptions>(o => o.ThrowOnBadRequest = true);\n// PostgreSQL: the connection comes from ConnectionStrings__App and nowhere else. There is no built-in login: an app that is\n// not given one stops when it first needs the database, so it can never run on a password that is written in the code.\nbuilder.Services.AddDbContext<AppDb>(o => o.UseNpgsql(builder.Configuration.GetConnectionString(\"App\")\n    ?? throw new InvalidOperationException(\"No database connection is configured. Set ConnectionStrings__App (for example Host=...;Port=5432;Database=...;Username=...;Password=«SECRET_1»")));\n// the web app's address: 3000 unless the setting Cors:Origin names another (the factory sets it when it starts the web app on another port)\nbuilder.Services.AddCors(o => o.AddDefaultPolicy(p => p.WithOrigins(builder.Configuration[\"Cors:Origin\"] ?? \"http://localhost:3000\").AllowAnyHeader().AllowAnyMethod()));\nvar app = builder.Build();\n// Create the database with every table when the app starts. The build also runs this file, to write the API's OpenAPI\n// document, and must not touch the database then. Keep this: the factory starts the app and reads the database it creates.\nif (System.Reflection.Assembly.GetEntryAssembly()?.GetName().Name != \"GetDocument.Insider\")\n{\n    // one at a time: the tests start several copies of the app in one process, and two creating the tables at once collide\n    lock (typeof(AppDb))\n    {\n        using var scope = app.Services.CreateScope();\n        var db = scope.ServiceProvider.GetRequiredService<AppDb>();\n        db.Database.EnsureCreated();\n        // sample rows, only when asked for (Seed__Demo=true): tests and the factory's own checks start on an empty database\n        if (app.Configuration.GetValue<bool>(\"Seed:Demo\")) SeedData.Run(db);\n    }\n}\napp.UseCors();\napp.Use(ApiErrors.Handle);\napp.MapGet(\"/\", () => \"API is up\").ExcludeFromDescription();\n// The API's own document (/openapi/v1.json) and a page to read and try it (/swagger). Keep both: the factory's product page links to the page.\napp.MapOpenApi();\napp.UseSwaggerUI(o => o.SwaggerEndpoint(\"/openapi/v1.json\", \"API\"));\n\nforeach (var moduleType in typeof(Program).Assembly.GetTypes()\n    .Where(t => !t.IsAbstract && !t.IsInterface && typeof(IEndpointModule).IsAssignableFrom(t)))\n{\n    var module = (IEndpointModule)Activator.CreateInstance(moduleType, nonPublic: true)!;\n    module.MapEndpoints(app);\n}\n\napp.Run();\n\npublic partial class Program { }\nusing Microsoft.EntityFrameworkCore;\nusing App.Api.Data;\n\nnamespace App.Api;\n\npublic class AppDb(DbContextOptions<AppDb> options) : DbContext(options)\n{\n    protected override void OnModelCreating(ModelBuilder modelBuilder)\n    {\n        CoreEntities.Discover(modelBuilder);\n        base.OnModelCreating(modelBuilder);\n    }\n}\nusing App.Api.Data;\nusing Microsoft.AspNetCore.Http;\nusing Microsoft.AspNetCore.OpenApi;\nusing Microsoft.EntityFrameworkCore;\nusing Microsoft.Extensions.Options;\nusing Microsoft.OpenApi.Models;\n\nnamespace App.Api.Endpoints;\n\ninternal sealed class RationEndpoints : IEndpointModule\n{\n    public void MapEndpoints(IEndpointRouteBuilder app)\n    {\n        app.ServiceProvider.GetRequiredService<IOptionsMonitor<OpenApiOptions>>().Get(\"v1\")\n            .AddSchemaTransformer((schema, context, _) =>\n            {\n                if (context.JsonTypeInfo.Type == typeof(OptimizationResponse) &&\n                    schema.Properties.TryGetValue(\"infeasibleCandidates\", out var infeasibleCandidates))\n                {\n                    infeasibleCandidates.Items = new OpenApiSchema\n                    {\n                        Reference = new OpenApiReference { Type = ReferenceType.Schema, Id = nameof(RationCandidate) }\n                    };\n                }\n                return Task.CompletedTask;\n            });\n\n        app.MapGet(\"/rations\", GetRations)\n            .WithName(\"getRations\")\n            .Produces<RationsResponse>(StatusCodes.Status200OK)\n            .Produces<ErrorResponse>(StatusCodes.Status400BadRequest)\n            .Produces<ErrorResponse>(StatusCodes.Status500InternalServerError);\n\n        app.MapPost(\"/rations\", CreateRation)\n            .WithName(\"createRation\")\n            .Produces<Ration>(StatusCodes.Status201Created)\n            .Produces<ErrorResponse>(StatusCodes.Status400BadRequest)\n            .Produces<ErrorResponse>(StatusCodes.Status409Conflict)\n            .Produces<ErrorResponse>(StatusCodes.Status422UnprocessableEntity);\n\n        app.MapPost(\"/rations/optimize\", OptimizeRation)\n            .WithName(\"optimizeRation\")\n            .Produces<OptimizationResponse>(StatusCodes.Status200OK)\n            .Produces<ErrorResponse>(StatusCodes.Status400BadRequest)\n            .Produces<ErrorResponse>(StatusCodes.Status422UnprocessableEntity);\n\n        app.MapPost(\"/rations/selection\", SelectRationCandidate)\n            .WithName(\"selectRationCandidate\")\n            .Produces<RationSelectionResponse>(StatusCodes.Status200OK)\n            .Produces<ErrorResponse>(StatusCodes.Status400BadRequest)\n            .Produces<ErrorResponse>(StatusCodes.Status404NotFound)\n            .Produces<ErrorResponse>(StatusCodes.Status422UnprocessableEntity);\n    }\n\n    private static async Task<RationsResponse> GetRations(AppDb db)\n    {\n        var rations = await db.Set<RationEntity>().AsNoTracking().Include(ration => ration.Ingredients)\n            .ThenInclude(ingredient => ingredient.Item).OrderBy(ration => ration.Id).ToListAsync();\n        return new RationsResponse(rations.Select(ToRation).ToList());\n    }\n\n    private static async Task<IResult> CreateRation(RationRequest request, AppDb db)\n    {\n        if (string.IsNullOrWhiteSpace(request.Name) || string.IsNullOrWhiteSpace(request.Type) ||\n            string.IsNullOrWhiteSpace(request.OperationalStatus) || !CanStore(request.TargetWeightMinLb) ||\n            !CanStore(request.TargetWeightMaxLb) || request.TargetWeightMinLb <= 0 ||\n            request.TargetWeightMaxLb < request.TargetWeightMinLb || request.Ingredients is null ||\n            request.Ingredients.Count == 0)\n            return ApiErrors.ValidationError(details: [\"Ration identity, target weights, status, and ingredients are required and must be valid.\"]);\n\n        if (request.Ingredients.Any(ingredient => ingredient.ItemId <= 0 || !float.IsFinite(ingredient.ProportionPercent) ||\n                ingredient.ProportionPercent <= 0))\n            return ApiErrors.ValidationError(details: [\"Ingredient itemIds and proportions must be positive finite values.\"]);\n        if (request.Ingredients.Select(ingredient => ingredient.ItemId).Distinct().Count() != request.Ingredients.Count)\n            return ApiErrors.ValidationError(details: [\"Each ingredient itemId may only appear once.\"]);\n        if (Math.Abs(request.Ingredients.Sum(ingredient => ingredient.ProportionPercent) - 100f) > 0.01f)\n            return ApiErrors.ValidationError(details: [\"Ingredient proportions must total 100 percent.\"]);\n\n        var name = request.Name.Trim();\n        if (await db.Set<RationEntity>().AnyAsync(ration => ration.Name == name))\n            return ApiErrors.Conflict(\"A ration with that name already exists.\");\n\n        var itemIds = request.Ingredients.Select(ingredient => ingredient.ItemId).ToArray();\n        var items = await db.Set<InventoryItemEntity>().Where(item => itemIds.Contains(item.Id)).ToDictionaryAsync(item => item.Id);\n        if (items.Count != itemIds.Length)\n            return ApiErrors.ValidationError(\"One or more ration ingredients reference an unknown inventory item.\");\n\n        var ration = new RationEntity\n        {\n            Name = name,\n            Type = request.Type.Trim(),\n            TargetWeightMinLb = (decimal)request.TargetWeightMinLb,\n            TargetWeightMaxLb = (decimal)request.TargetWeightMaxLb,\n            OperationalStatus = request.OperationalStatus.Trim(),\n            Ingredients = request.Ingredients.Select(ingredient => new RationIngredientEntity\n            {\n                ItemId = ingredient.ItemId,\n                ProportionPercent = (decimal)ingredient.ProportionPercent\n            }).ToList()\n        };\n        db.Add(ration);\n        await db.SaveChangesAsync();\n\n        foreach (var ingredient in ration.Ingredients)\n            ingredient.Item = items[ingredient.ItemId];\n        return Results.Json(ToRation(ration), statusCode: StatusCodes.Status201Created);\n    }\n\n    private static async Task<IResult> OptimizeRation(RationOptimizationRequest request, AppDb db)\n    {\n        if (!CanStore(request.TargetWeightMinLb) || !CanStore(request.TargetWeightMaxLb) ||\n            !CanStore(request.MinimumDryMatterPercent) || !CanStore(request.MinimumEnergyMcalPerKg) ||\n            request.TargetWeightMinLb <= 0 || request.TargetWeightMaxLb < request.TargetWeightMinLb ||\n            request.MinimumDryMatterPercent < 0 || request.MinimumDryMatterPercent > 100 ||\n            request.MinimumEnergyMcalPerKg < 0)\n            return ApiErrors.ValidationError(details: [\"Optimization constraints are outside their valid ranges.\"]);\n\n        var items = await db.Set<InventoryItemEntity>().AsNoTracking().OrderBy(item => item.Id).ToListAsync();\n        var mixes = CreateCandidateMixes(items);\n        var candidates = mixes.Select(mix =>\n        {\n            var dryMatter = mix.Sum(part => part.Item.DryMatterPercent * part.ProportionPercent / 100m);\n            var energy = mix.Sum(part => part.Item.EnergyMcalPerKg * part.ProportionPercent / 100m);\n            return new RationCandidateEntity\n            {\n                // A single-ingredient suggestion is ineligible when a blend can be made.\n                Feasible = dryMatter >= (decimal)request.MinimumDryMatterPercent &&\n                    energy >= (decimal)request.MinimumEnergyMcalPerKg && (items.Count == 1 || mix.Count > 1),\n                TargetWeightMinLb = (decimal)request.TargetWeightMinLb,\n                TargetWeightMaxLb = (decimal)request.TargetWeightMaxLb,\n                MinimumDryMatterPercent = (decimal)request.MinimumDryMatterPercent,\n                MinimumEnergyMcalPerKg = (decimal)request.MinimumEnergyMcalPerKg,\n                PredictedDryMatterPercent = dryMatter,\n                PredictedEnergyMcalPerKg = energy,\n                Ingredients = mix.Select(part => new RationCandidateIngredientEntity\n                {\n                    ItemId = part.Item.Id,\n                    ProportionPercent = part.ProportionPercent\n                }).ToList()\n            };\n        }).ToList();\n\n        db.AddRange(candidates);\n        await db.SaveChangesAsync();\n        foreach (var candidate in candidates)\n            foreach (var ingredient in candidate.Ingredients)\n                ingredient.Item = items.Single(item => item.Id == ingredient.ItemId);\n\n        var feasible = candidates.Where(candidate => candidate.Feasible)\n            .OrderBy(CandidateCost).ThenBy(candidate => candidate.CandidateId).Select(ToCandidate).ToList();\n        var infeasible = candidates.Where(candidate => !candidate.Feasible)\n            .OrderBy(CandidateCost).ThenBy(candidate => candidate.CandidateId).Select(ToCandidate).ToList();\n        return Results.Ok(new OptimizationResponse(feasible, infeasible));\n    }\n\n    private static async Task<IResult> SelectRationCandidate(RationSelectionRequest request, AppDb db)\n    {\n        if (request.CandidateId <= 0)\n            return ApiErrors.ValidationError(details: [\"candidateId must be greater than zero.\"]);\n\n        var candidate = await db.Set<RationCandidateEntity>().Include(value => value.Ingredients)\n            .ThenInclude(ingredient => ingredient.Item).FirstOrDefaultAsync(value => value.CandidateId == request.CandidateId);\n        if (candidate is null)\n            return ApiErrors.NotFound(\"The requested ration candidate was not found.\");\n        if (!candidate.Feasible)\n            return ApiErrors.ValidationError(\"Only feasible ration candidates can be selected.\");\n\n        return Results.Ok(new RationSelectionResponse(ToCandidate(candidate), false));\n    }\n\n    private static List<List<CandidatePart>> CreateCandidateMixes(IReadOnlyList<InventoryItemEntity> items)\n    {\n        var mixes = new List<List<CandidatePart>>();\n        foreach (var item in items)\n            mixes.Add([new CandidatePart(item, 100m)]);\n\n        for (var first = 0; first < items.Count; first++)\n        {\n            for (var second = first + 1; second < items.Count; second++)\n            {\n                for (var firstPercent = 10; firstPercent < 100; firstPercent += 10)\n                {\n                    mixes.Add([\n                        new CandidatePart(items[first], firstPercent),\n                        new CandidatePart(items[second], 100m - firstPercent)\n                    ]);\n                }\n            }\n        }\n\n        if (items.Count > 2)\n        {\n            var share = decimal.Round(100m / items.Count, 6);\n            var equalMix = items.Select(item => new CandidatePart(item, share)).ToList();\n            equalMix[^1] = equalMix[^1] with { ProportionPercent = 100m - equalMix.Take(equalMix.Count - 1).Sum(part => part.ProportionPercent) };\n            mixes.Add(equalMix);\n        }\n        return mixes;\n    }\n\n","chars":14044,"exitCode":0}
