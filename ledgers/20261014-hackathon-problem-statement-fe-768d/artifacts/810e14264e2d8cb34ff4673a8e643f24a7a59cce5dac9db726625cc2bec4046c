nce test lot {lotId}\";\n        int readingId;\n\n        using (var firstHost = new ApiHost())\n        {\n            await firstHost.AssertNoApplicationRecordsAsync();\n            await firstHost.SeedLotAsync(lotId, lotName);\n            using var created = await firstHost.Client.PostAsJsonAsync(\n                $\"/lots/{lotId}/weight-readings\",\n                new\n                {\n                    measurementDate = \"2026-10-01\",\n                    applicableHeadcount = 50,\n                    averageWeightLb = 640,\n                    recordedBy = \"Persistence acceptance test\",\n                    notes = \"Original persisted reading\"\n                });\n\n            Assert.Equal(HttpStatusCode.Created, created.StatusCode);\n            using var createdDocument = JsonDocument.Parse(await created.Content.ReadAsStringAsync());\n            readingId = createdDocument.RootElement.GetProperty(\"readings\").EnumerateArray()\n                .Single().GetProperty(\"id\").GetInt32();\n        }\n\n        using (var secondHost = new ApiHost())\n        {\n            using var list = await secondHost.Client.GetAsync($\"/lots/{lotId}/weight-readings\");\n            Assert.Equal(HttpStatusCode.OK, list.StatusCode);\n            using var document = JsonDocument.Parse(await list.Content.ReadAsStringAsync());\n            AssertReading(document.RootElement, readingId, lotId, \"2026-10-01\", 50, 640m,\n                \"Original persisted reading\");\n\n            using var updated = await secondHost.Client.PutAsJsonAsync(\n                $\"/lots/{lotId}/weight-readings/{readingId}\",\n                new\n                {\n                    measurementDate = \"2026-10-05\",\n                    applicableHeadcount = 48,\n                    averageWeightLb = 655,\n                    recordedBy = \"Persistence acceptance test\",\n                    notes = \"Updated persisted reading\"\n                });\n            Assert.Equal(HttpStatusCode.OK, updated.StatusCode);\n        }\n\n        using (var thirdHost = new ApiHost())\n        {\n            using var list = await thirdHost.Client.GetAsync($\"/lots/{lotId}/weight-readings\");\n            Assert.Equal(HttpStatusCode.OK, list.StatusCode);\n            using var document = JsonDocument.Parse(await list.Content.ReadAsStringAsync());\n            AssertReading(document.RootElement, readingId, lotId, \"2026-10-05\", 48, 655m,\n                \"Updated persisted reading\");\n\n            using var deleted = await thirdHost.Client.DeleteAsync(\n                $\"/lots/{lotId}/weight-readings/{readingId}\");\n            Assert.Equal(HttpStatusCode.OK, deleted.StatusCode);\n        }\n\n        using var fourthHost = new ApiHost();\n        using var finalList = await fourthHost.Client.GetAsync($\"/lots/{lotId}/weight-readings\");\n        Assert.Equal(HttpStatusCode.OK, finalList.StatusCode);\n        using var finalDocument = JsonDocument.Parse(await finalList.Content.ReadAsStringAsync());\n        Assert.DoesNotContain(finalDocument.RootElement.GetProperty(\"readings\").EnumerateArray(),\n            reading => reading.GetProperty(\"id\").GetInt32() == readingId);\n    }\n\n    [Fact]\n    public async Task AC_2_2_InitializesPersistentStorageForContractEntities()\n    {\n        using var host = new ApiHost();\n        await host.AssertEveryContractTableCanStoreRowsAsync();\n    }\n\n    [Fact]\n    public async Task AC_2_3_ReturnsCreatedRationAfterRestart()\n    {\n        var itemId = RandomNumberGenerator.GetInt32(100_000, int.MaxValue);\n        var rationName = $\"Restart persistence ration {itemId}\";\n        int rationId;\n\n        using (var firstHost = new ApiHost())\n        {\n            await firstHost.SeedInventoryItemAsync(itemId, $\"Test feed {itemId}\");\n            using var created = await firstHost.Client.PostAsJsonAsync(\"/rations\", new\n            {\n                name = rationName,\n                type = \"Finisher\",\n                targetWeightMinLb = 900,\n                targetWeightMaxLb = 1200,\n                operationalStatus = \"Active\",\n                ingredients = new[]\n                {\n                    new { itemId, proportionPercent = 100 }\n                }\n","chars":11506,"exitCode":0}
