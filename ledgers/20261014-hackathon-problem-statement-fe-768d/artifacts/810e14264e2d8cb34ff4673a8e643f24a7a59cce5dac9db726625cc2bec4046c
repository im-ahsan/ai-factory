t.Equal(batchId, json.RootElement.GetProperty(\"batchId\").GetString());\n        var row = Assert.Single(json.RootElement.GetProperty(\"rows\").EnumerateArray());\n        Has(row, \"id\", \"sourceIdentifier\", \"sourceType\", \"vendor\", \"cost\", \"headCount\", \"weightLb\", \"breed\",\n            \"ageDays\", \"source\", \"rowStatus\", \"problemDetail\", \"proposedLots\");\n    }\n\n    [Fact]\n    public async Task AC_1_5_LotsAndPensMatchTheirSchemas()\n    {\n        await WithDbAsync(async db => await CreateOperationalFixtureAsync(db));\n        using var json = await GetJsonAsync(\"/lots\", HttpStatusCode.OK);\n        var lots = json.RootElement.GetProperty(\"lots\").EnumerateArray().ToArray();\n        Assert.NotEmpty(lots);\n        foreach (var lot in lots)\n            Has(lot, \"id\", \"name\", \"penId\", \"penName\", \"headCount\", \"breed\", \"sex\", \"sourcePurchaseOrderLine\", \"status\",\n                \"targetWeightLb\", \"defaultGainRateLbPerDay\", \"measuredAdgLbPerDay\");\n        var pens = json.RootElement.GetProperty(\"pens\").EnumerateArray().ToArray();\n        Assert.NotEmpty(pens);\n        foreach (var pen in pens) Has(pen, \"id\", \"name\", \"capacity\", \"currentAnimalCount\", \"activeLotCount\", \"status\");\n    }\n\n    [Fact]\n    public async Task AC_1_6_LotMappingReturnsRequestedAssignments()\n    {\n        var data = await WithDbAsync(CreateOperationalFixtureAsync);\n        var sourceLine = \"PO-\" + Guid.NewGuid().ToString(\"N\");\n        using var json = await PostJsonAsync(\"/lots/mappings\", new\n        {\n            sourcePurchaseOrderLine = sourceLine,\n            assignments = new[] { new { lotId = data.LotId, penId = data.PenId, headCount = 12 } }\n        }, HttpStatusCode.OK);\n        Assert.Equal(sourceLine, json.RootElement.GetProperty(\"sourcePurchaseOrderLine\").GetString());\n        var assignment = Assert.Single(json.RootElement.GetProperty(\"assignments\").EnumerateArray());\n        Has(assignment,