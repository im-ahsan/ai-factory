{"ts":1791978557526,"kind":"call","tool":"Bash","input":"{\"command\":\"sed -n '1,140p' App.Api/Endpoints/DemoEndpoints.cs && sed -n '1,90p' App.Api/Data/DemoEntities.cs\"}","output":"using App.Api.Data;\nusing Microsoft.AspNetCore.Http;\nusing Microsoft.EntityFrameworkCore;\n\nnamespace App.Api.Endpoints;\n\ninternal sealed class DemoEndpoints : IEndpointModule\n{\n    private const string SupportedDatasetId = \"feedlot-demo-2026\";\n\n    public void MapEndpoints(IEndpointRouteBuilder app)\n    {\n        app.MapPost(\"/demo-data/load\", LoadDemoData)\n            .WithName(\"loadDemoData\")\n            .Produces<DemoLoadResponse>(StatusCodes.Status200OK)\n            .Produces<ErrorResponse>(StatusCodes.Status400BadRequest)\n            .Produces<ErrorResponse>(StatusCodes.Status409Conflict)\n            .Produces<ErrorResponse>(StatusCodes.Status422UnprocessableEntity);\n    }\n\n    private static async Task<IResult> LoadDemoData(DemoLoadRequest? request, AppDb db)\n    {\n        var datasetId = request?.DatasetId?.Trim();\n        if (string.IsNullOrWhiteSpace(datasetId))\n            return ApiErrors.ValidationError(details: [\"datasetId is required.\"]);\n        if (!string.Equals(datasetId, SupportedDatasetId, StringComparison.Ordinal))\n            return ApiErrors.ValidationError(details: [\"The requested datasetId is not supported.\"]);\n\n        var run = await db.Set<DemoLoadRunEntity>().Include(value => value.Outcomes)\n            .FirstOrDefaultAsync(value => value.DatasetId == datasetId);\n        if (run is not null)\n        {\n            if (run.Outcomes.Count == 0)\n                return ApiErrors.Conflict(\"The dataset load has no stored outcomes.\");\n            return Results.Ok(ToResponse(run));\n        }\n\n        run = new DemoLoadRunEntity\n        {\n            DatasetId = datasetId,\n            Outcomes = CreateOutcomes(datasetId)\n        };\n        db.Add(run);\n        try\n        {\n            await db.SaveChangesAsync();\n        }\n        catch (DbUpdateException)\n        {\n            db.ChangeTracker.Clear();\n            var existingRun = await db.Set<DemoLoadRunEntity>().AsNoTracking().Include(value => value.Outcomes)\n                .FirstOrDefaultAsync(value => value.DatasetId == datasetId);\n            if (existingRun is null) throw;\n            return Results.Ok(ToResponse(existingRun));\n        }\n        return Results.Ok(ToResponse(run));\n    }\n\n    private static List<DemoLoadOutcomeEntity> CreateOutcomes(string datasetId)\n    {\n        var records = new (string OutcomeType, string RecordType, string SourceIdentifier, string Reason)[]\n        {\n            (\"added\", \"lot\", \"DEMO-LOT-01\", \"Added\"),\n            (\"added\", \"lot\", \"DEMO-LOT-02\", \"Added\"),\n            (\"added\", \"lot\", \"DEMO-LOT-03\", \"Added\"),\n            (\"added\", \"inventory_item\", \"DEMO-ITEM-01\", \"Added\"),\n            (\"added\", \"inventory_item\", \"DEMO-ITEM-02\", \"Added\"),\n            (\"added\", \"ration\", \"DEMO-RATION-01\", \"Added\"),\n            (\"already_present\", \"lot\", \"DEMO-LOT-04\", \"Already present\"),\n            (\"already_present\", \"inventory_item\", \"Yellow corn\", \"Already present\"),\n            (\"failed\", \"ration\", \"DEMO-RATION-02\", \"The record could not be loaded.\")\n        };\n        return records.Select(record => new DemoLoadOutcomeEntity\n        {\n            DatasetId = datasetId,\n            OutcomeType = record.OutcomeType,\n            RecordType = record.RecordType,\n            SourceIdentifier = record.SourceIdentifier,\n            Reason = record.Reason\n        }).ToList();\n    }\n\n    private static DemoLoadResponse ToResponse(DemoLoadRunEntity run)\n    {\n        var added = ToOutcomes(run.Outcomes, \"added\");\n        var alreadyPresent = ToOutcomes(run.Outcomes, \"already_present\");\n        var failed = ToOutcomes(run.Outcomes, \"failed\");\n        return new DemoLoadResponse(run.DatasetId, added.Count, alreadyPresent.Count, failed.Count,\n            failed.Count > 0, added, alreadyPresent, failed);\n    }\n\n    private static List<DemoRecordOutcome> ToOutcomes(IEnumerable<DemoLoadOutcomeEntity> outcomes, string outcomeType) =>\n        outcomes.Where(outcome => outcome.OutcomeType == outcomeType).OrderBy(outcome => outcome.Id)\n            .Select(outcome => new DemoRecordOutcome(outcome.RecordType, outcome.SourceIdentifier, outcome.Reason))\n            .ToList();\n}\n\ninternal sealed record DemoLoadRequest(string? DatasetId);\ninternal sealed record DemoRecordOutcome(string RecordType, string SourceIdentifier, string Reason);\ninternal sealed record DemoLoadResponse(string DatasetId, int AddedCount, int AlreadyPresentCount, int FailedCount,\n    bool Partial, IReadOnlyList<DemoRecordOutcome> AddedRecords, IReadOnlyList<DemoRecordOutcome> AlreadyPresentRecords,\n    IReadOnlyList<DemoRecordOutcome> FailedRecords);\nusing System.ComponentModel.DataAnnotations.Schema;\nusing Microsoft.EntityFrameworkCore;\nusing Microsoft.EntityFrameworkCore.Metadata.Builders;\n\nnamespace App.Api.Data;\n\ninternal static class DemoEntities\n{\n    internal sealed class DemoLoadRunConfiguration : IEntityTypeConfiguration<DemoLoadRunEntity>\n    {\n        public void Configure(EntityTypeBuilder<DemoLoadRunEntity> builder)\n        {\n            builder.ToTable(\"DemoLoadRuns\");\n            builder.HasKey(x => x.DatasetId);\n            builder.Property(x => x.DatasetId).ValueGeneratedNever();\n            builder.Property(x => x.DatasetId).IsRequired();\n        }\n    }\n\n    internal sealed class DemoLoadOutcomeConfiguration : IEntityTypeConfiguration<DemoLoadOutcomeEntity>\n    {\n        public void Configure(EntityTypeBuilder<DemoLoadOutcomeEntity> builder)\n        {\n            builder.ToTable(\"DemoLoadOutcomes\");\n            builder.HasKey(x => x.Id);\n            builder.Property(x => x.Id).ValueGeneratedOnAdd();\n            builder.HasOne(x => x.Run).WithMany(x => x.Outcomes).HasForeignKey(x => x.DatasetId)\n                .OnDelete(DeleteBehavior.Cascade);\n            builder.Property(x => x.DatasetId).IsRequired();\n            builder.Property(x => x.OutcomeType).IsRequired();\n            builder.Property(x => x.RecordType).IsRequired();\n            builder.Property(x => x.SourceIdentifier).IsRequired();\n            builder.Property(x => x.Reason).IsRequired();\n        }\n    }\n}\n\n[Table(\"DemoLoadRuns\")]\ninternal sealed class DemoLoadRunEntity\n{\n    public string DatasetId { get; set; } = \"\";\n    public ICollection<DemoLoadOutcomeEntity> Outcomes { get; set; } = new List<DemoLoadOutcomeEntity>();\n}\n\n[Table(\"DemoLoadOutcomes\")]\ninternal sealed class DemoLoadOutcomeEntity\n{\n    public int Id { get; set; }\n    public string DatasetId { get; set; } = \"\";\n    public DemoLoadRunEntity Run { get; set; } = null!;\n    public string OutcomeType { get; set; } = \"\";\n    public string RecordType { get; set; } = \"\";\n    public string SourceIdentifier { get; set; } = \"\";\n    public string Reason { get; set; } = \"\";\n}\n","chars":6686,"exitCode":0}
