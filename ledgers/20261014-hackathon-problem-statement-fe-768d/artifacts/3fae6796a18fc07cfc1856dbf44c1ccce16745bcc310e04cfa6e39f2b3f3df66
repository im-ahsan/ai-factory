{"ts":1791976131463,"kind":"call","tool":"Bash","input":"{\"command\":\"sed -n '130,315p' App.Tests/AcceptancePart1Tests.cs; sed -n '635,660p' App.Tests/AcceptancePart1Tests.cs\"}","output":"    public async Task AC_1_8_LotForecastContainsForecastFields()\n    {\n        var data = await WithDbAsync(CreateOperationalFixtureAsync);\n        using var json = await GetJsonAsync($\"/lots/{data.LotId}/forecast\", HttpStatusCode.OK);\n        AssertForecast(json.RootElement, data.LotId);\n    }\n\n    [Fact]\n    public async Task AC_1_9_InventoryResponseContainsStockPropertiesAndMovements()\n    {\n        var data = await WithDbAsync(async db =>\n        {\n            var core = await CreateOperationalFixtureAsync(db);\n            await InsertInventoryMovementAsync(db, core.ItemId, \"received\", 100m, \"Restock\");\n            return core;\n        });\n        using var json = await GetJsonAsync(\"/inventory/items\", HttpStatusCode.OK);\n        Has(json.RootElement, \"wastageRatio\", \"items\");\n        var item = Assert.Single(json.RootElement.GetProperty(\"items\").EnumerateArray(), e => e.GetProperty(\"id\").GetInt32() == data.ItemId);\n        AssertInventoryItem(item);\n        Assert.NotEmpty(item.GetProperty(\"movements\").EnumerateArray());\n    }\n\n    [Fact]\n    public async Task AC_1_10_InventoryMovementReturnsSavedMovementAndUpdatedItem()\n    {\n        var itemId = await WithDbAsync(async db => (await CreateOperationalFixtureAsync(db)).ItemId);\n        using var beforeJson = await GetJsonAsync(\"/inventory/items\", HttpStatusCode.OK);\n        var before = Assert.Single(beforeJson.RootElement.GetProperty(\"items\").EnumerateArray(), e => e.GetProperty(\"id\").GetInt32() == itemId);\n        var beforeReceived = before.GetProperty(\"receivedStockLb\").GetDecimal();\n        var beforeClosing = before.GetProperty(\"closingStockLb\").GetDecimal();\n        var beforeAvailable = before.GetProperty(\"availableQuantity\").GetDecimal();\n        var date = \"2026-10-15\";\n        using var json = await PostJsonAsync(\"/inventory/movements\", new\n        {\n            itemId, movementType = \"received\", date, quantityLb = 25m, note = \"Acceptance test receipt\"\n        }, HttpStatusCode.Created);\n        var movement = json.RootElement.GetProperty(\"movement\");\n        Has(movement, \"id\", \"itemId\", \"movementType\", \"date\", \"quantityLb\", \"note\", \"wastageCause\");\n        Assert.Equal(itemId, movement.GetProperty(\"itemId\").GetInt32());\n        Assert.Equal(\"received\", movement.GetProperty(\"movementType\").GetString());\n        Assert.Equal(date, movement.GetProperty(\"date\").GetString());\n        Assert.Equal(25m, movement.GetProperty(\"quantityLb\").GetDecimal());\n        Assert.Equal(\"Acceptance test receipt\", movement.GetProperty(\"note\").GetString());\n        var item = json.RootElement.GetProperty(\"item\");\n        AssertInventoryItem(item);\n        Assert.Equal(itemId, item.GetProperty(\"id\").GetInt32());\n        Assert.Equal(beforeReceived + 25m, item.GetProperty(\"receivedStockLb\").GetDecimal());\n        Assert.Equal(beforeClosing + 25m, item.GetProperty(\"closingStockLb\").GetDecimal());\n        Assert.Equal(beforeAvailable + 25m, item.GetProperty(\"availableQuantity\").GetDecimal());\n    }\n\n    [Fact]\n    public async Task AC_1_11_ActualWastageReturnsMovementAndUpdatedItem()\n    {\n        var itemId = await WithDbAsync(async db => (await CreateOperationalFixtureAsync(db)).ItemId);\n        using var beforeJson = await GetJsonAsync(\"/inventory/items\", HttpStatusCode.OK);\n        var before = Assert.Single(beforeJson.RootElement.GetProperty(\"items\").EnumerateArray(), e => e.GetProperty(\"id\").GetInt32() == itemId);\n        var beforeWastage = before.GetProperty(\"actualWastageLb\").GetDecimal();\n        var beforeClosing = before.GetProperty(\"closingStockLb\").GetDecimal();\n        var beforeAvailable = before.GetProperty(\"availableQuantity\").GetDecimal();\n        var date = \"2026-10-15\";\n        using var json = await PostJsonAsync(\"/inventory/wastage\", new\n        {\n            itemId, recordDate = date, actualWastageLb = 3.5m, wastageCause = \"Spill\"\n        }, HttpStatusCode.Created);\n        var movement = json.RootElement.GetProperty(\"movement\");\n        Has(movement, \"id\", \"itemId\", \"movementType\", \"date\", \"quantityLb\", \"note\", \"wastageCause\");\n        Assert.Equal(itemId, movement.GetProperty(\"itemId\").GetInt32());\n        Assert.Equal(\"actual_wastage\", movement.GetProperty(\"movementType\").GetString());\n        Assert.Equal(date, movement.GetProperty(\"date\").GetString());\n        Assert.Equal(3.5m, movement.GetProperty(\"quantityLb\").GetDecimal());\n        Assert.Equal(\"Spill\", movement.GetProperty(\"wastageCause\").GetString());\n        var item = json.RootElement.GetProperty(\"item\");\n        AssertInventoryItem(item);\n        Assert.Equal(itemId, item.GetProperty(\"id\").GetInt32());\n        Assert.Equal(beforeWastage + 3.5m, item.GetProperty(\"actualWastageLb\").GetDecimal());\n        Assert.Equal(beforeClosing - 3.5m, item.GetProperty(\"closingStockLb\").GetDecimal());\n        Assert.Equal(beforeAvailable - 3.5m, item.GetProperty(\"availableQuantity\").GetDecimal());\n    }\n\n    [Fact]\n    public async Task AC_1_12_InventoryWastageRatioIsSaved()\n    {\n        using var json = await PatchJsonAsync(\"/inventory/settings\", new { wastageRatio = 0.075m }, HttpStatusCode.OK);\n        Has(json.RootElement, \"wastageRatio\");\n        Assert.Equal(0.075m, json.RootElement.GetProperty(\"wastageRatio\").GetDecimal());\n        using var inventory = await GetJsonAsync(\"/inventory/items\", HttpStatusCode.OK);\n        Assert.Equal(0.075m, inventory.RootElement.GetProperty(\"wastageRatio\").GetDecimal());\n    }\n\n    [Fact]\n    public async Task AC_1_13_InventoryOutlookSupportsEveryContractHorizon()\n    {\n        await WithDbAsync(async db => await CreateOperationalFixtureAsync(db));\n        foreach (var horizon in new[] { \"daily\", \"weekly\", \"monthly\", \"quarterly\", \"bi-annual\", \"annual\" })\n        {\n            using var json = await GetJsonAsync($\"/inventory/outlook?horizon={horizon}&wastageRatio=0.05\", HttpStatusCode.OK);\n            Has(json.RootElement, \"horizon\", \"wastageRatio\", \"balances\");\n            Assert.Equal(horizon, json.RootElement.GetProperty(\"horizon\").GetString());\n            Assert.Equal(0.05m, json.RootElement.GetProperty(\"wastageRatio\").GetDecimal());\n            var balances = json.RootElement.GetProperty(\"balances\").EnumerateArray().ToArray();\n            Assert.NotEmpty(balances);\n            var balance = balances[0];\n            Has(balance, \"itemId\", \"itemName\", \"currentStockLb\", \"dailyEstimatedConsumptionLb\", \"projectedBalanceLb\");\n        }\n    }\n\n    [Fact]\n    public async Task AC_1_14_RationListContainsContractRecordsOrIsEmpty()\n    {\n        var data = await WithDbAsync(CreateOperationalFixtureAsync);\n        using var json = await GetJsonAsync(\"/rations\", HttpStatusCode.OK);\n        var rations = json.RootElement.GetProperty(\"rations\");\n        Assert.Equal(JsonValueKind.Array, rations.ValueKind);\n        var ration = Assert.Single(rations.EnumerateArray(), e => e.GetProperty(\"id\").GetInt32() == data.RationId);\n        AssertRation(ration);\n        var ingredient = Assert.Single(ration.GetProperty(\"ingredients\").EnumerateArray());\n        Assert.Equal(data.ItemId, ingredient.GetProperty(\"itemId\").GetInt32());\n        Assert.Equal(100m, ingredient.GetProperty(\"proportionPercent\").GetDecimal());\n    }\n\n    [Fact]\n    public async Task AC_1_15_RationCreationReturnsCalculatedRation()\n    {\n        var data = await WithDbAsync(CreateOperationalFixtureAsync);\n        var name = \"Ration-\" + Guid.NewGuid().ToString(\"N\");\n        using var inventory = await GetJsonAsync(\"/inventory/items\", HttpStatusCode.OK);\n        var item = Assert.Single(inventory.RootElement.GetProperty(\"items\").EnumerateArray(), e => e.GetProperty(\"id\").GetInt32() == data.ItemId);\n        var itemName = item.GetProperty(\"name\").GetString();\n        var itemCost = item.GetProperty(\"unitCost\").GetDecimal();\n        using var json = await PostJsonAsync(\"/rations\", new\n        {\n            name, type = \"Grower\", targetWeightMinLb = 500m, targetWeightMaxLb = 1400m,\n            operationalStatus = \"Active\", ingredients = new[] { new { itemId = data.ItemId, proportionPercent = 100m } }\n        }, HttpStatusCode.Created);\n        AssertRation(json.RootElement);\n        Assert.Equal(name, json.RootElement.GetProperty(\"name\").GetString());\n        Assert.Equal(\"Grower\", json.RootElement.GetProperty(\"type\").GetString());\n        Assert.Equal(itemCost, json.RootElement.GetProperty(\"costPerLb\").GetDecimal());\n        var ingredient = Assert.Single(json.RootElement.GetProperty(\"ingredients\").EnumerateArray());\n        Assert.Equal(data.ItemId, ingredient.GetProperty(\"itemId\").GetInt32());\n        Assert.Equal(itemName, ingredient.GetProperty(\"name\").GetString());\n        Assert.Equal(100m, ingredient.GetProperty(\"proportionPercent\").GetDecimal());\n    }\n\n    [Fact]\n    public async Task AC_1_16_RationOptimizationReturnsCandidatesInCostOrder()\n    {\n        await WithDbAsync(async db =>\n        {\n            await CreateOperationalFixtureAsync(db);\n            await InsertItemAsync(db, \"Optimization ingredient\");\n        });\n        using var json = await PostJsonAsync(\"/rations/optimize\", new\n        {\n            targetWeightMinLb = 500m, targetWeightMaxLb = 1400m,\n            minimumDryMatterPercent = 40m, minimumEnergyMcalPerKg = 1.5m\n        }, HttpStatusCode.OK);\n        Has(json.RootElement, \"feasibleCandidates\", \"infeasibleCandidates\");\n        AssertCandidates(json.RootElement.GetProperty(\"feasibleCandidates\"), true);\n