s/BadRequest\"\n        \"404\":\n          $ref: \"#/components/responses/NotFound\"\n        \"422\":\n          $ref: \"#/components/responses/ValidationError\"\n  /lots/{lotId}/forecast:\n    get:\n      operationId: getLotForecast\n      parameters:\n        - $ref: \"#/components/parameters/LotId\"\n      responses:\n        \"200\":\n          $ref: \"#/components/responses/ForecastOk\"\n        \"400\":\n          $ref: \"#/components/responses/BadRequest\"\n        \"404\":\n          $ref: \"#/components/responses/NotFound\"\n        \"500\":\n          $ref: \"#/components/responses/ServerError\"\n  /inventory/items:\n    get:\n      operationId: getInventoryItems\n      responses:\n        \"200\":\n          $ref: \"#/components/responses/InventoryOk\"\n        \"400\":\n          $ref: \"#/components/responses/BadRequest\"\n        \"500\":\n          $ref: \"#/components/responses/ServerError\"\n  /inventory/movements:\n    post:\n      operationId: recordInventoryMovement\n      requestBody:\n        required: true\n        content:\n          application/json:\n            schema:\n              $ref: \"#/components/schemas/InventoryMovementRequest\"\n      responses:\n        \"201\":\n          $ref: \"#/components/responses/MovementCreated\"\n        \"400\":\n          $ref: \"#/components/responses/BadRequest\"\n        \"404\":\n          $ref: \"#/components/responses/NotFound\"\n        \"409\":\n          $ref: \"#/components/responses/Conflict\"\n        \"422\":\n          $ref: \"#/components/responses/ValidationError\"\n  /inventory/wastage:\n    post:\n      operationId: recordActualWastage\n      requestBody:\n        required: true\n        content:\n          application/json:\n            schema:\n              $ref: \"#/components/schemas/ActualWastageRequest\"\n      responses:\n        \"201\":\n          $ref: \"#/components/responses/MovementCreated\"\n        \"400\":\n          $ref: \"#/components/responses/BadRequest\"\n        \"404\":\n          $ref: \"#/components/responses/NotFound\"\n        \"409\":\n          $ref: \"#/components/responses/Conflict\"\n        \"422\":\n          $ref: \"#/components/responses/ValidationError\"\n  /inventory/settings:\n    patch:\n      operationId: updateInventorySettings\n      requestBody:\n        required: true\n        content:\n          application/json:\n            schema:\n              $ref: \"#/components/schemas/InventorySettingsRequest\"\n      responses:\n        \"200\":\n          $ref: \"#/components/responses/InventorySettingsOk\"\n        \"400\":\n          $ref: \"#/components/responses/BadRequest\"\n        \"422\":\n          $ref: \"#/components/responses/ValidationError\"\n  /inventory/outlook:\n    get:\n      operationId: getInventoryOutlook\n      parameters:\n        - name: horizon\n          in: query\n          required: true\n          schema:\n            type: string\n            enum:\n              - daily\n              - weekly\n              - monthly\n              - quarterly\n              - bi-annual\n              - annual\n        - name: wastageRatio\n          in: query\n          required: true\n          schema:\n            type: number\n            format: float\n      responses:\n        \"200\":\n          $ref: \"#/components/responses/OutlookOk\"\n        \"400\":\n          $ref: \"#/components/responses/BadRequest\"\n        \"422\":\n          $ref: \"#/components/responses/ValidationError\"\n        \"500\":\n          $ref: \"#/components/responses/ServerError\"\n  /rations:\n    get:\n      operationId: getRations\n      responses:\n        \"200\":\n          $ref: \"#/components/responses/RationsOk\"\n        \"400\":\nusing System.Net;\nusing System.Net.Http.Json;\nusing System.Security.Cryptography;\nusing System.Text.Json;\nusing App.Api;\nusing Microsoft.AspNetCore.Mvc.Testing;\nusing Microsoft.EntityFrameworkCore;\nusing Microsoft.Extensions.DependencyInjection;\nusing Xunit;\n\nnamespace App.Tests.Part2;\n\npublic sealed class AcceptancePart2Tests\n{\n    private static readonly string[] PersistentTables =\n    [\n        \"ImportBatches\", \"ImportRows\", \"Pens\", \"Lots\", \"InventoryItems\", \"InventoryMovements\", \"InventorySettings\",\n        \"Rations\", \"RationIngredients\", \"RationCandidates\", \"RationCandidateIngredients\", \"FeedingPlans\",\n        \"FeedingActivities\", \"FeedingActivityLotConsumptions\", \"FeedingActivityIngredientConsumptions\", \"WeightReadings\",\n        \"DemoLoadRuns\", \"DemoLoadOutcomes\"\n    ];\n\n    [Fact]\n    public async Task AC_2_1_PersistsWeightReadingChangesAndDeletionAcrossRestarts()\n    {\n        var lotId = RandomNumberGenerator.GetInt32(100_000, int.MaxValue);\n        var lotName = $\"Persistence test lot {lotId}\";\n        int readingId;\n\n        using (var firstHost = new ApiHost())\n        {\n            await firstHost.AssertNoApplicationRecordsAsync();\n            await firstHost.SeedLotAsync(lotId, lotName);\n            using var created = await firstHost.Client.PostAsJsonAsync(\n                $\"/lots/{lotId}/weight-readings\",\n                new\n                {\n                    measurementDate = \"2026-10-01\",\n                    applicableHeadcount = 50,\n                    averageWeightLb = 640,\n                    recordedBy = \"Persistence acceptance test\",\n                    notes = \"Original persisted reading\"\n                });\n\n            Assert.Equal(HttpStatusCode.Created, created.StatusCode);\n            using var createdDocument = JsonDocument.Parse(await created.Content.ReadAsStringAsync());\n            readingId = createdDocument.RootElement.GetProperty(\"readings\").EnumerateArray()\n                .Single().GetProperty(\"id\").GetInt32();\n        }\n\n        using (var secondHost = new ApiHost())\n        {\n            using var list = await secondHost.Client.GetAsync($\"/lots/{lotId}/weight-readings\");\n            Assert.Equal(HttpStatusCode.OK, list.StatusCode);\n            using var document = JsonDocument.Parse(await list.Content.ReadAsStringAsync());\n            AssertReading(document.RootElement, readingId, lotId, \"2026-10-01\", 50, 640m,\n                \"Original persisted reading\");\n\n            using var updated = await secondHost.Client.PutAsJsonAsync(\n                $\"/lots/{lotId}/weight-readings/{readingId}\",\n                new\n                {\n                    measurementDate = \"2026-10-05\",\n                    applicableHeadcount = 48,\n                    averageWeightLb = 655,\n                    recordedBy = \"Persistence acceptance test\",\n                    notes = \"Updated persisted reading\"\n                });\n            Assert.Equal(HttpStatusCode.OK, updated.StatusCode);\n        }\n\n        using (var thirdHost = new ApiHost())\n        {\n            using var list = await thirdHost.Client.GetAsync($\"/lots/{lotId}/weight-readings\");\n            Assert.Equal(HttpStatusCode.OK, list.StatusCode);\n            using var document = JsonDocument.Parse(await list.Content.ReadAsStringAsync());\n            AssertReading(document.RootElement, readingId, lotId, \"2026-10-05\", 48, 655m,\n                \"Updated persisted reading\");\n\n            using var deleted = await thirdHost.Client.DeleteAsync(\n                $\"/lots/{lotId}/weight-readings/{readingId}\");\n            Assert.Equal(HttpStatusCode.OK, deleted.StatusCode);\n        }\n\n        using var fourthHost = new ApiHost();\n        using var finalList = await fourthHost.Client.GetAsync($\"/lots/{lotId}/weight-readings\");\n        Assert.Equal(HttpStatusCode.OK, finalList.StatusCode);\n        using var finalDocument = JsonDocument.Parse(await finalList.Content.ReadAsStringAsync());\n        Assert.DoesNotContain(finalDocument.RootElement.GetProperty(\"readings\").EnumerateArray(),\n            reading => reading.GetProperty(\"id\").GetInt32() == readingId);\n    }\n\n    [Fact]\n    public async Task AC_2_2_InitializesPersistentStorageForContractEntities()\n    {\n        using var host = new ApiHost();\n        await host.AssertEveryContractTableCanStoreRowsAsync();\n    }\n\n    [Fact]\n    public async Task AC_2_3_ReturnsCreatedRationAfterRestart()\n    {\n        var itemId = RandomNumberGenerator.GetInt32(100_000, int.MaxValue);\n        var rationName = $\"Restart persistence ration {itemId}\";\n        int rationId;\n\n        using (var firstHost = new ApiHost())\n        {\n            await firstHost.SeedInventoryItemAsync(itemId, $\"Test feed {itemId}\");\n            using var created = await firstHost.Client.PostAsJsonAsync(\"/rations\", new\n            {\n                name = rationName,\n                type = \"Finisher\",\n                targetWeightMinLb = 900,\n                targetWeightMaxLb = 1200,\n                operationalStatus = \"Active\",\n                ingredients = new[]\n                {\n                    new { itemId, proportionPercent = 100 }\n                }\n            });\n\n            Assert.Equal(HttpStatusCode.Created, created.StatusCode);\n            using var createdDocument = JsonDocument.Parse(await created.Content.ReadAsStringAsync());\n            rationId = createdDocument.RootElement.GetProperty(\"id\").GetInt32();\n        }\n\n        using var restartedHost = new ApiHost();\n        using var response = await restartedHost.Client.GetAsync(\"/rations\");\n        Assert.Equal(HttpStatusCode.OK, response.StatusCode);\n        using var document = JsonDocument.Parse(await response.Content.ReadAsStringAsync());\n        var ration = document.RootElement.GetProperty(\"rations\").EnumerateArray()\n            .Single(row => row.GetProperty(\"id\").GetInt32() == rationId);\n\n        Assert.Equal(rationName, ration.GetProperty(\"name\").GetString());\n        Assert.Equal(\"Finisher\", ration.GetProperty(\"type\").GetString());\n        Assert.Equal(900m, ration.GetProperty(\"targetWeightMinLb\").GetDecimal());\n        Assert.Equal(1200m, ration.GetProperty(\"targetWeightMaxLb\").GetDecimal());\n        Assert.Equal(\"Active\", ration.GetProperty(\"operationalStatus\").GetString());\n        var ingredient = Assert.Single(ration.GetProperty(\"ingredients\").EnumerateArray());\n        Assert.Equal(itemId, ingredient.GetProperty(\"itemId\").GetInt32());\n        Assert.Equal(100m, ingredient.GetProperty(\"proportionPercent\").GetDecimal());\n    }\n\n    private static void AssertReading(JsonElement response, int readingId, int lotId,\n        string measurementDate, int headcount, decimal averageWeightLb, string notes)\n    {\n        var reading = response.GetProperty(\"readings\").EnumerateArray()\n            .Single(row => row.GetProperty(\"id\").GetInt32() == readingId);\n\n        Assert.Equal(lotId, reading.GetProperty(\"lotId\").GetInt32());\n        Assert.Equal(measurementDate, reading.GetProperty(\"measurementDate\").GetString());\n        Assert.Equal(headcount, reading.GetProperty(\"animalsWeighed\").GetInt32());\n        Assert.Equal(averageWeightLb, reading.GetProperty(\"averageWeightLb\").GetDecimal());\n        Assert.Equal(notes, reading.GetProperty(\"notes\").GetString());\n        Assert.Equal(\"Persistence acceptance test\", reading.GetProperty(\"recordedBy\").GetString());\n    }\n\n    private sealed class ApiHost : IDisposable\n    {\n        private readonly WebApplicationFactory<Program> _factory = new();\n\n        public HttpClient Client { get; }\n\n        public ApiHost() => Client = _factory.CreateClient();\n\n        public Task SeedLotAsync(int id, string name) => ExecuteSeedSqlAsync($\"\"\"\n            INSERT INTO \"Lots\"\n                (\"Id\", \"Name\", \"PenId\", \"HeadCount\", \"Breed\", \"Sex\", \"SourcePurchaseOrderLine\",\n                 \"Status\", \"TargetWeightLb\", \"DefaultGainRateLbPerDay\")\n            VALUES\n                ({id}, {name}, NULL, 50, 'Angus', 'steer', 'PERSISTENCE-TEST', 'Active', 1200, 3.0)\n            \"\"\");\n\n        public Task SeedInventoryItemAsync(int id, string name) => ExecuteSeedSqlAsync($\"\"\"\n            INSERT INTO \"InventoryItems\"\n                (\"Id\", \"Name\", \"Category\", \"Unit\", \"UnitCost\", \"DryMatterPercent\", \"EnergyMcalPerKg\",\n                 \"StorageLocation\", \"OpeningStockLb\")\n            VALUES\n                ({id}, {name}, 'Feed', 'lb', 0.25, 88, 3.2, 'Test storage', 10000)\n            \"\"\");\n\n        public async Task AssertNoApplicationRecordsAsync()\n        {\n            using var scope = _factory.Services.CreateScope();\n            var db = scope.ServiceProvider.GetRequiredService<AppDb>();\n            await db.Database.OpenConnectionAsync();\n            var connection = db.Database.GetDbConnection();\n            foreach (var tableName in PersistentTables)\n            {\n                await using var command = connection.CreateCommand();\n                command.CommandText = $\"SELECT COUNT(*) FROM \\\"{tableName}\\\"\";\n                var count = Convert.ToInt64(await command.ExecuteScalarAsync());\n                Assert.Equal(0L, count);\n            }\n        }\n\n        public async Task AssertEveryContractTableCanStoreRowsAsync()\n        {\n            using var scope = _factory.Services.CreateScope();\n            var db = scope.ServiceProvider.GetRequiredService<AppDb>();\n            await db.Database.OpenConnectionAsync();\n            var connection = db.Database.GetDbConnection();\n            foreach (var tableName in PersistentTables)\n            {\n                await using var command = connection.CreateCommand();\n                command.CommandText = \"SELECT COUNT(*) FROM information_schema.columns WHERE table_schema = current_schema() AND table_name = @p0\";\n                var parameter = command.CreateParameter();\n                parameter.ParameterName = \"p0\";\n                parameter.Value = tableName;\n                command.Parameters.Add(parameter);\n                var columnCount = Convert.ToInt32(await command.ExecuteScalarAsync());\n                Assert.True(columnCount > 0, $\"Expected row-capable persistent table '{tableName}'.\");\n            }\n        }\n\n        private async Task ExecuteSeedSqlAsync(FormattableString sql)\n        {\n            using var scope = _factory.Services.CreateScope();\n            var db = scope.ServiceProvider.GetRequiredService<AppDb>();\nusing System.Net;\nusing System.Net.Http.Json;\nusing System.Text.Json;\nusing App.Api;\nusing Microsoft.AspNetCore.Hosting;\nusing Microsoft.AspNetCore.Mvc.Testing;\nusing Microsoft.EntityFrameworkCore;\nusing Microsoft.Extensions.Configuration;\nusing Microsoft.Extensions.DependencyInjection;\nusing Xunit;\n\nnamespace App.Tests.Part4;\n\npublic sealed class AcceptancePart4Tests : IClassFixture<WebApplicationFactory<Program>>\n{\n    private static readonly string[] PersistentTables =\n    [\n        \"ImportBatches\", \"ImportRows\", \"Pens\", \"Lots\", \"InventoryItems\", \"InventoryMovements\", \"InventorySettings\",\n        \"Rations\", \"RationIngredients\", \"RationCandidates\", \"RationCandidateIngredients\", \"FeedingPlans\",\n        \"FeedingActivities\", \"FeedingActivityLotConsumptions\", \"FeedingActivityIngredientConsumptions\", \"WeightReadings\",\n        \"DemoLoadRuns\", \"DemoLoadOutcomes\"\n    ];\n\n    private readonly WebApplicationFactory<Program> _factory;\n\n    public AcceptancePart4Tests(WebApplicationFactory<Program> factory) => _factory = factory;\n\n    [Fact]\n    public async Task AC_5_1_UsesTestCreatedValuesWhenDemoSeedingIsDisabled()\n    {\n        using var factory = CreateFactoryWithoutDemoSeeding();\n        using var client = factory.CreateClient();\n\n        await AssertEveryTableEmptyAsync(factory);\n\n        await AssertCollectionsEmptyAsync(client, \"/imports/batches\", \"batches\");\n        await AssertCollectionsEmptyAsync(client, \"/lots\", \"lots\", \"pens\");\n        await AssertCollectionsEmptyAsync(client, \"/inventory/items\", \"items\");\n        await AssertCollectionsEmptyAsync(client, \"/rations\", \"rations\");\n        await AssertCollectionsEmptyAsync(client, \"/feeding/plans\", \"plans\");\n        await AssertCollectionsEmptyAsync(client, \"/feeding/activities\", \"activities\");\n\n        using var settingsResponse = await client.PatchAsJsonAsync(\n            \"/inventory/settings\",\n            new { wastageRatio = 0.037 });\n        Assert.Equal(HttpStatusCode.OK, settingsResponse.StatusCode);\n        var settings = await settingsResponse.Content.ReadFromJsonAsync<JsonElement>();\n        Assert.Equal(0.037, settings.GetProperty(\"wastageRatio\").GetDouble(), 3);\n        using var inventoryResponse = await client.GetAsync(\"/inventory/items\");\n        Assert.Equal(HttpStatusCode.OK, inventoryResponse.StatusCode);\n        var inventory = await inventoryResponse.Content.ReadFromJsonAsync<JsonElement>();\n        Assert.Equal(0.037, inventory.GetProperty(\"wastageRatio\").GetDouble(), 3);\n        Assert.Empty(inventory.GetProperty(\"items\").EnumerateArray());\n        await AssertOnlyTestCreatedSettingAsync(factory);\n    }\n\n... (2740 more characters not kept)","chars":22740,"exitCode":0}
