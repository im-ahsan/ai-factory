et<InventoryItemEntity>().AsNoTracking().OrderBy(item => item.Id).ToListAsync();","        var movements = await db.Set<InventoryMovementEntity>().AsNoTracking()","            .OrderBy(movement => movement.Date).ThenBy(movement => movement.Id).ToListAsync();","        var movementsByItem = movements.GroupBy(movement => movement.ItemId)","            .ToDictionary(group => group.Key, group => group.ToList());","        var settings = await db.Set<InventorySettingEntity>().AsNoTracking()","            .FirstOrDefaultAsync(setting => setting.Scope == DefaultScope);","        var wastageRatio = settings?.WastageRatio ?? DefaultWastageRatio;","","        return new InventoryResponse((float)wastageRatio, items.Select(item => ToInventoryItem(item,","            movementsByItem.GetValueOrDefault(item.Id) ?? [])).ToList());","    }","","    private static async Task<IResult> RecordInventoryMovement(InventoryMovementRequest request, AppDb db)","    {","        if (request.Date == default || string.IsNullOrWhiteSpace(request.Note) || !CanStore(request.QuantityLb))","            return ApiErrors.ValidationError(details: [\"date, note, and a finite quantityLb are required.\"]);","        if (request.MovementType == InventoryMovementRequestType.Received && request.QuantityLb <= 0)","            return ApiErrors.ValidationError(details: [\"Received quantityLb must be greater than zero.\"]);","        if (request.MovementType == InventoryMovementRequestType.Adjustment && request.QuantityLb == 0)","            return ApiErrors.ValidationError(details: [\"Adjustment quantityLb must not be zero.\"]);","","        var item = await db.Set<InventoryItemEntity>().FirstOrDefaultAsync(value => value.Id == request.ItemId);","        if (item is null) return ApiErrors.NotFound(\"The requested inventory item was not found.\");","","        var movementType = request.MovementType == InventoryMovementRequestType.Received ? \"received\" : \"adjustment\";","        var movement = new InventoryMovementEntity","        {","            ItemId = item.Id,","            MovementType = movementType,","            Date = request.Date,","            QuantityLb = (decimal)request.QuantityLb,","            Note = request.Note.Trim()","        };","        if (movementType == \"adjustment\" && (await CurrentStock(db, item) + movement.QuantityLb) < 0)","            return ApiErrors.Conflict(\"The adjustment would make inventory stock negative.\");","","        db.Add(movement);","        await db.SaveChangesAsync();","        var allMovements = await db.Set<InventoryMovementEntity>().AsNoTracking()","            .Where(value => value.ItemId == item.Id).OrderBy(value => value.Date).ThenBy(value => value.Id).ToListAsync();","        return Results.Json(new MovementCreatedResponse(ToMovement(movement),","            ToInventoryItem(item, allMovements)), statusCode: StatusCodes.Status201Created);","    }","","    private static async Task<IResult> RecordActualWastage(ActualWastageRequest request, AppDb db)","    {","        if (request.RecordDate == default || !CanStore(request.ActualWastageLb) || request.ActualWastageLb <= 0 ||","            string.IsNullOrWhiteSpace(request.WastageCause))","            return ApiErrors.ValidationError(details: [\"recordDate, a positive actualWastageLb, and wastageCause are required.\"]);","","        var item = await db.Set<InventoryItemEntity>().FirstOrDefaultAsync(value => value.Id == request.ItemId);","        if (item is null) return ApiErrors.NotFound(\"The requested inventory item was not found.\");","","        var quantity = (decimal)request.ActualWastageLb;","        if (await CurrentStock(db, item) < quantity)","            return ApiErrors.Conflict(\"The wastage quantity exceeds available inventory stock.\");","","        var movement = new InventoryMovementEntity","        {","            ItemId = item.Id,","            MovementType = \"actual_wastage\",","            Date = request.RecordDate,","            QuantityLb = quantity,","            Note = request.WastageCause.Trim(),","            WastageCause = request.WastageCause.Trim()","        };","        db.Add(movement);","        await db.SaveChangesAsync();","        var allMovements = await db.Set<InventoryMovementEntity>().AsNoTracking()","            .Where(value => value.ItemId == item.Id).OrderBy(value => value.Date).ThenBy(value => value.Id).ToListAsync();","        return Results.Json(new MovementCreatedResponse(ToMovement(movement),","            ToInventoryItem(item, allMovements)), statusCode: StatusCodes.Status201Created);","    }","","    private static async Task<IResult> UpdateInventorySettings(InventorySettingsRequest request, AppDb db)","    {","        if (!float.IsFinite(request.WastageRatio) || request.WastageRatio < 0 || request.WastageRatio > 1)","            return ApiErrors.ValidationError(details: [\"wastageRatio must be between zero and one.\"]);","","        var setting = await db.Set<InventorySettingEntity>().FirstOrDefaultAsync(value => value.Scope == DefaultScope);","        if (setting is null)","        {","            setting = new InventorySettingEntity { Scope = DefaultScope };","            db.Add(setting);","        }","        setting.WastageRatio = (decimal)request.WastageRatio;","        await db.SaveChangesAsync();","        return Results.Ok(new InventorySettingsResponse((float)setting.WastageRatio));","    }","","    private static async Task<IResult> GetInventoryOutlook([FromQuery] string horizon, [FromQuery] float wastageRatio, AppDb db)","    {","        var days = HorizonDays(horizon);","        if (days is null)","            return ApiErrors.ValidationError(details: [\"horizon must be daily, weekly, monthly, quarterly, bi-annual, or annual.\"]);","        if (!float.IsFinite(wastageRatio) || wastageRatio < 0 || wastageRatio > 1)","            return ApiErrors.ValidationError(details: [\"wastageRatio must be between zero and one.\"]);","","        var items = await db.Set<InventoryItemEntity>().AsNoTracking().OrderBy(item => item.Id).ToListAsync();","        var movements = await db.Set<InventoryMovementEntity>().AsNoTracking().OrderBy(movement => movement.Date)","            .ThenBy(movement => movement.Id).ToListAsync();","        var balances = items.Select(item =>","        {","            var itemMovements = movements.Where(movement => movement.ItemId == item.Id).ToList();","            var currentStock = InventoryTotals.For(item, itemMovements).ClosingStockLb;","            var consumption = itemMovements.Where(movement => movement.MovementType == \"consumed\").ToList();","            var dailyConsumption = consumption.Count == 0","                ? 0m","                : consumption.Sum(movement => movement.QuantityLb) /","                  Math.Max(1, consumption.Max(movement => movement.Date.DayNumber) - consumption.Min(movement => movement.Date.DayNumber) + 1);","            var projected = currentStock - dailyConsumption * days.Value * (1m + (decimal)wastageRatio);","            return new OutlookBalance(item.Id, item.Name, (float)currentStock, (float)dailyConsumption, (float)projected);","        }).ToList();","","        return Results.Ok(new OutlookResponse(ParseOutlookHorizon(horizon), wastageRatio, balances));","    }","","    private static async Task<decimal> CurrentStock(AppDb db, InventoryItemEntity item)","    {","        var movements = await db.Set<InventoryMovementEntity>().AsNoTracking()","            .Where(movement => movement.ItemId == item.Id).ToListAsync();","        return InventoryTotals.For(item, movements).ClosingStockLb;","    }","","    private static int? HorizonDays(string horizon) => horizon switch","    {","        \"daily\" => 1,","        \"weekly\" => 7,","        \"monthly\" => 30,","        \"quarterly\" => 90,","        \"bi-annual\" => 182,","        \"annual\" => 365,","        _ => null","    };","","    private static OutlookHorizon ParseOutlookHorizon(string horizon) => horizon switch","    {","        \"daily\" => OutlookHorizon.Daily,","        \"weekly\" => OutlookHorizon.Weekly,","        \"monthly\" => OutlookHorizon.Monthly,","        \"quarterly\" => OutlookHorizon.Quarterly,","        \"bi-annual\" => OutlookHorizon.BiAnnual,","        _ => OutlookHorizon.Annual","    };","","    private static readonly string[] OutlookHorizons = [\"daily\", \"weekly\", \"monthly\", \"quarterly\", \"bi-annual\", \"annual\"];","","    private sealed class OutlookHorizonOperationTransformer : IOpenApiOperationTransformer","    {","        public Task TransformAsync(OpenApiOperation operation, OpenApiOperationTransformerContext context,","            CancellationToken cancellationToken)","        {","            if (operation.OperationId == \"getInventoryOutlook\")","            {","                var horizonParameter = operation.Parameters?.FirstOrDefault(parameter => parameter.Name == \"horizon\");","                if (horizonParameter is not null)","                {","                    horizonParameter.Schema ??= new OpenApiSchema { Type = \"string\" };","                    horizonParameter.Schema.Enum = OutlookHorizons","                        .Select(value => (IOpenApiAny)new OpenApiString(value)).ToList();","                }","            }","            return Task.CompletedTask;","        }","    }","","    private static bool CanStore(float value) => float.IsFinite(value) && Math.Abs((double)value) <= (double)decimal.MaxValue;","","    private static InventoryItem ToInventoryItem(InventoryItemEntity item, IReadOnlyList<InventoryMovementEntity> movements)","    {","        var totals = InventoryTotals.For(item, movements);","        return new InventoryItem(item.Id, item.Name, item.Category, (float)totals.ClosingStockLb, item.Unit,","            (float)item.UnitCost, (float)item.DryMatterPercent, (float)item.EnergyMcalPerKg, item.StorageLocation,","            (float)totals.OpeningStockLb, (float)totals.ReceivedStockLb, (float)totals.ConsumedStockLb,","            (float)totals.ActualWastageLb, (float)totals.ClosingStockLb,","            movements.OrderBy(value => value.Date).ThenBy(value => value.Id).Select(ToMovement).ToList());","    }","","    private static InventoryMovement ToMovement(InventoryMovementEntity movement) => new(","        movement.Id, movement.ItemId, ParseMovementType(movement.MovementType), movement.Date, (float)movement.QuantityLb,","        movement.Note, movement.WastageCause);","","    private static InventoryMovementType ParseMovementType(string movementType) => movementType switch","    {","        \"opening\" => InventoryMovementType.Opening,","        \"received\" => InventoryMovementType.Received,","        \"consumed\" => InventoryMovementType.Consumed,","        \"actual_wastage\" => InventoryMovementType.ActualWastage,","        _ => InventoryMovementType.Adjustment","    };","}","","internal static class InventoryTotals","{","    internal static InventoryStockTotals For(InventoryItemEntity item, IEnumerable<InventoryMovementEntity> movements)","    {","        var records = movements.ToList();","        var opening = item.OpeningStockLb != 0","            ? item.OpeningStockLb","            : records.Where(movement => movement.MovementType == \"opening\").Sum(movement => movement.QuantityLb);","        var received = records.Where(movement => movement.MovementType == \"received\").Sum(movement => movement.QuantityLb);","        var consumed = records.Where(movement => movement.MovementType == \"consumed\").Sum(movement => movement.QuantityLb);","        var wastage = records.Where(movement => movement.MovementType == \"actual_wastage\").Sum(movement => movement.QuantityLb);","        var adjustments = records.Where(movement => movement.MovementType == \"adjustment\").Sum(movement => movement.QuantityLb);","        return new InventoryStockTotals(opening, received, consumed, wastage, opening + received + adjustments - consumed - wastage);","    }","}","","internal sealed record InventoryStockTotals(decimal OpeningStockLb, decimal ReceivedStockLb, decimal ConsumedStockLb,","    decimal ActualWastageLb, decimal ClosingStockLb);","internal sealed record InventoryResponse(float WastageRatio, IReadOnlyList<InventoryItem> Items);","internal sealed record InventoryItem(int Id, string Name, string Category, float AvailableQuantity, string Unit,","    float UnitCost, float DryMatterPercent, float EnergyMcalPerKg, string StorageLocation, float OpeningStockLb,","    float ReceivedStockLb, float ConsumedStockLb, float ActualWastageLb, float ClosingStockLb,","    IReadOnlyList<InventoryMovement> Movements);","internal sealed record InventoryMovement(int Id, int ItemId, InventoryMovementType MovementType, DateOnly Date,","    float QuantityLb, string Note, string? WastageCause);","internal sealed record MovementCreatedResponse(InventoryMovement Movement, InventoryItem Item);","internal sealed record InventorySettingsRequest(float WastageRatio);","internal sealed record InventorySettingsResponse(float WastageRatio);","internal sealed record OutlookBalance(int ItemId, string ItemName, float CurrentStockLb,","    float DailyEstimatedConsumptionLb, float ProjectedBalanceLb);","internal sealed record OutlookResponse(OutlookHorizon Horizon, float WastageRatio, IReadOnlyList<OutlookBalance> Balances);","internal sealed record InventoryMovementRequest(int ItemId, InventoryMovementRequestType MovementType, DateOnly Date,","    float QuantityLb, string Note);","internal sealed record ActualWastageRequest(int ItemId, DateOnly RecordDate, float ActualWastageLb, string WastageCause);","","[JsonConverter(typeof(JsonStringEnumConverter<InventoryMovementType>))]","internal enum InventoryMovementType","{","    [JsonStringEnumMemberName(\"opening\")] Opening,","    [JsonStringEnumMemberName(\"received\")] Received,","    [JsonStringEnumMemberName(\"consumed\")] Consumed,","    [JsonStringEnumMemberName(\"actual_wastage\")] ActualWastage,","    [JsonStringEnumMemberName(\"a