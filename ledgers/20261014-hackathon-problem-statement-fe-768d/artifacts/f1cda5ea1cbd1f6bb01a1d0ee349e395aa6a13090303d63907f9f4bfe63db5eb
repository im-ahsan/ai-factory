rLine)\n            .Select(x => (decimal?)x.WeightLb)\n            .FirstOrDefaultAsync();\n        DateOnly? projectedDate = null;\n        if (source is > 0 && lot.DefaultGainRateLbPerDay > 0)\n        {\n            var days = Math.Max(0, (int)Math.Ceiling(((double)lot.TargetWeightLb - (double)source.Value) /\n                (double)lot.DefaultGainRateLbPerDay));\n            projectedDate = DateOnly.FromDateTime(DateTime.UtcNow).AddDays(days);\n        }\n\n        var gainRate = (float)lot.DefaultGainRateLbPerDay;\n        var dateText = projectedDate?.ToString(\"yyyy-MM-dd\") ?? \"not yet available\";\n        return new ForecastResponse(\n            lot.Id,\n            (float)lot.TargetWeightLb,\n            gainRate,\n            GainRateBasis.ConfiguredDefault,\n            projectedDate,\n            [new ForecastRecommendation(\"sale_timing\", $\"Projected market date: {dateText}.\", gainRate, projectedDate, null)]);\n    }\n\n    private static ProjectDemoResponse GetProjectDemo() => new(\n        \"Responsive feedlot operations workspace for cattle, feed, plans, weights, and performance.\",\n        \"Web app calls a generated API client; a separate API service returns operational outcomes.\",\n        [\"Preview supplied purchase order records.\", \"Review pen occupancy and lot performance.\", \"Record feeding and weight measurements.\"],\n        [new ValidationCoverage(\"API acceptance suite\", \"Contract operations\", \"Responses are checked against the API contract.\", \"Covered\")],\n        [new ProjectChallenge(\"Operations\", \"Coordinate cattle, feed, and work plans.\", \"Workflow\", \"Core records are stored by the API.\")],\n        [new ValidationCoverage(\"API integration boundary\", \"Separate service\", \"Contract examples are used by API checks.\", \"Ready for integration\")],\n        [new GoToMarketEntry(\"Feedlot operators\", \"Shared operational workspace\", \"Pilot\")]);\n\n    private static Pen ToPen(PenEntity pen, IReadOnlyCollection<LotEntity> lots)\n    {\n        var activeLots = lots.Where(x => x.PenId == pen.Id && IsActive(x)).ToList();\n        var count = activeLots.Sum(x => x.HeadCount);\n        var status = count == 0 ? \"Empty\" : count >= pen.Capacity ? \"At Capacity\" : \"Active\";\n        return new Pen(pen.Id, pen.Name, pen.Capacity, count, activeLots.Count, status);\n    }\n\n    private static bool IsActive(LotEntity lot) => string.Equals(lot.Status, \"Active\", StringComparison.OrdinalIgnoreCase);\nusing System.Text.Json;\nusing Microsoft.AspNetCore.Http;\n\nnamespace App.Api;\n\ninternal static class ApiErrors\n{\n    internal static IResult BadRequest(string message = \"The request could not be interpreted.\", string[]? details = null) =>\n        Results.Json(new ErrorResponse(\"bad_request\", message, details ?? []), statusCode: StatusCodes.Status400BadRequest);\n\n    internal static IResult NotFound(string message = \"The requested record was not found.\") =>\n        Results.Json(new ErrorResponse(\"not_found\", message, []), statusCode: StatusCodes.Status404NotFound);\n\n    internal static IResult Conflict(string message, string[]? details = null) =>\n        Results.Json(new ErrorResponse(\"conflict\", message, details ?? []), statusCode: StatusCodes.Status409Conflict);\n\n    internal static IResult ValidationError(string message = \"One or more submitted values are invalid.\", string[]? details = null) =>\n        Results.Json(new ErrorResponse(\"validation_error\", message, details ?? []), statusCode: StatusCodes.Status422UnprocessableEntity);\n\n    internal static IResult ServerError() =>\n        Results.Json(new ErrorResponse(\"server_error\", \"The service could not complete the request.\", []), statusCode: StatusCodes.Status500InternalServerError);\n\n    internal static async Task Handle(HttpContext context, RequestDelegate next)\n    {\n        try\n        {\n            await next(context);\n        }\n        catch (BadHttpRequestException exc