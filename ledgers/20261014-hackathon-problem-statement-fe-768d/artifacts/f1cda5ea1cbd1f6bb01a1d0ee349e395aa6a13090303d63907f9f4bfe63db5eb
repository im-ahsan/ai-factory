{"ts":1791977360039,"kind":"call","tool":"Bash","input":"{\"command\":\"sed -n '1,260p' App.Api/Endpoints/FeedingEndpoints.cs\"}","output":"using System.Data;\nusing App.Api.Data;\nusing Microsoft.AspNetCore.Http;\nusing Microsoft.AspNetCore.Mvc;\nusing Microsoft.AspNetCore.OpenApi;\nusing Microsoft.EntityFrameworkCore;\nusing Microsoft.Extensions.Options;\nusing Microsoft.OpenApi.Any;\n\nnamespace App.Api.Endpoints;\n\ninternal sealed class FeedingEndpoints : IEndpointModule\n{\n    private const decimal PoundsToKilograms = 0.45359237m;\n    private const string ManagerName = \"Yard manager\";\n\n    public void MapEndpoints(IEndpointRouteBuilder app)\n    {\n        app.ServiceProvider.GetRequiredService<IOptionsMonitor<OpenApiOptions>>().Get(\"v1\")\n            .AddSchemaTransformer((schema, context, _) =>\n            {\n                if (context.JsonTypeInfo.Type == typeof(FeedingPlan))\n                    SetStatusEnum(schema, [\"Planned\", \"In progress\", \"Completed\", \"Skipped\"]);\n                else if (context.JsonTypeInfo.Type == typeof(FeedingActivity))\n                    SetStatusEnum(schema, [\"Planned\", \"In progress\", \"Completed\", \"Skipped\", \"Unplanned\"]);\n                return Task.CompletedTask;\n            });\n\n        app.MapGet(\"/feeding/plans\", GetFeedingPlans)\n            .WithName(\"getFeedingPlans\")\n            .Produces<PlansResponse>(StatusCodes.Status200OK)\n            .Produces<ErrorResponse>(StatusCodes.Status400BadRequest)\n            .Produces<ErrorResponse>(StatusCodes.Status500InternalServerError);\n\n        app.MapPost(\"/feeding/plans\", CreateFeedingPlan)\n            .WithName(\"generateFeedingPlan\")\n            .Produces<PlanResponse>(StatusCodes.Status201Created)\n            .Produces<ErrorResponse>(StatusCodes.Status400BadRequest)\n            .Produces<ErrorResponse>(StatusCodes.Status404NotFound)\n            .Produces<ErrorResponse>(StatusCodes.Status409Conflict)\n            .Produces<ErrorResponse>(StatusCodes.Status422UnprocessableEntity);\n\n        app.MapGet(\"/feeding/activities\", GetFeedingActivities)\n            .WithName(\"getFeedingActivities\")\n            .Produces<FeedingLogResponse>(StatusCodes.Status200OK)\n            .Produces<ErrorResponse>(StatusCodes.Status400BadRequest)\n            .Produces<ErrorResponse>(StatusCodes.Status500InternalServerError);\n\n        app.MapPost(\"/feeding/activities\", CreateFeedingActivity)\n            .WithName(\"recordFeedingActivity\")\n            .Produces<FeedingActivityResponse>(StatusCodes.Status201Created)\n            .Produces<ErrorResponse>(StatusCodes.Status400BadRequest)\n            .Produces<ErrorResponse>(StatusCodes.Status404NotFound)\n            .Produces<ErrorResponse>(StatusCodes.Status409Conflict)\n            .Produces<ErrorResponse>(StatusCodes.Status422UnprocessableEntity);\n    }\n\n    private static async Task<PlansResponse> GetFeedingPlans([FromQuery] DateOnly? date, [FromQuery] int? penId, AppDb db)\n    {\n        var query = db.Set<FeedingPlanEntity>().AsNoTracking();\n        if (date.HasValue) query = query.Where(plan => plan.PlanDate == date.Value);\n        if (penId.HasValue) query = query.Where(plan => plan.PenId == penId.Value);\n        var plans = await query.OrderBy(plan => plan.PlanDate).ThenBy(plan => plan.Id).ToListAsync();\n        if (plans.Count == 0) return new PlansResponse([]);\n\n        var penIds = plans.Select(plan => plan.PenId).Distinct().ToArray();\n        var rationIds = plans.Select(plan => plan.RationId).Distinct().ToArray();\n        var planIds = plans.Select(plan => plan.Id).ToArray();\n        var pens = await db.Set<PenEntity>().AsNoTracking().Include(pen => pen.Lots)\n            .Where(pen => penIds.Contains(pen.Id)).ToDictionaryAsync(pen => pen.Id);\n        var rations = await LoadRations(db, rationIds);\n        var actuals = await db.Set<FeedingActivityEntity>().AsNoTracking()\n            .Where(activity => activity.FeedingPlanId.HasValue && planIds.Contains(activity.FeedingPlanId.Value))\n            .GroupBy(activity => activity.FeedingPlanId!.Value)\n            .Select(group => new { PlanId = group.Key, Quantity = group.Sum(activity => activity.ActualQuantityLb) })\n            .ToDictionaryAsync(group => group.PlanId, group => group.Quantity);\n\n        return new PlansResponse(plans.Select(plan => ToPlan(plan,\n            pens.GetValueOrDefault(plan.PenId), rations.GetValueOrDefault(plan.RationId),\n            actuals.GetValueOrDefault(plan.Id), actuals.ContainsKey(plan.Id))).ToList());\n    }\n\n    private static async Task<IResult> CreateFeedingPlan(FeedingPlanRequest request, AppDb db)\n    {\n        if (request.PenId <= 0 || request.RationId <= 0 || request.PlanDate == default ||\n            request.CurrentPenHeadcount <= 0 || !CanStore(request.DailyBunkRateLbPerHead) ||\n            request.DailyBunkRateLbPerHead <= 0)\n            return ApiErrors.ValidationError(details: [\"penId, rationId, planDate, currentPenHeadcount, and a positive finite dailyBunkRateLbPerHead are required.\"]);\n\n        var pen = await db.Set<PenEntity>().AsNoTracking().Include(value => value.Lots)\n            .FirstOrDefaultAsync(value => value.Id == request.PenId);\n        if (pen is null) return ApiErrors.NotFound(\"The requested pen was not found.\");\n        var ration = await db.Set<RationEntity>().AsNoTracking().Include(value => value.Ingredients)\n            .ThenInclude(ingredient => ingredient.Item).FirstOrDefaultAsync(value => value.Id == request.RationId);\n        if (ration is null) return ApiErrors.NotFound(\"The requested ration was not found.\");\n        if (request.CurrentPenHeadcount > pen.Capacity)\n            return ApiErrors.Conflict(\"The requested headcount exceeds pen capacity.\");\n        if (await db.Set<FeedingPlanEntity>().AnyAsync(plan => plan.PenId == pen.Id && plan.PlanDate == request.PlanDate))\n            return ApiErrors.Conflict(\"A feeding plan already exists for this pen and date.\");\n        if (!HasValidRation(ration))\n            return ApiErrors.ValidationError(\"The ration must contain valid ingredient proportions totaling 100 percent.\");\n\n        var plan = new FeedingPlanEntity\n        {\n            PenId = pen.Id,\n            RationId = ration.Id,\n            PlanDate = request.PlanDate,\n            DailyBunkRateLbPerHead = (decimal)request.DailyBunkRateLbPerHead,\n            CurrentPenHeadcount = request.CurrentPenHeadcount,\n            PlannedTime = new TimeOnly(7, 0),\n            Status = \"Planned\"\n        };\n        db.Add(plan);\n        await db.SaveChangesAsync();\n        return Results.Json(new PlanResponse(ToPlan(plan, pen, ration, 0m, false)),\n            statusCode: StatusCodes.Status201Created);\n    }\n\n    private static async Task<FeedingLogResponse> GetFeedingActivities([FromQuery] DateOnly? date, [FromQuery] int? penId, AppDb db)\n    {\n        IQueryable<FeedingActivityEntity> query = db.Set<FeedingActivityEntity>().AsNoTracking()\n            .Include(activity => activity.Pen)\n            .Include(activity => activity.Ration)\n            .Include(activity => activity.FeedingPlan)\n            .Include(activity => activity.LotConsumptions).ThenInclude(consumption => consumption.Lot)\n            .Include(activity => activity.IngredientConsumptions).ThenInclude(consumption => consumption.Item);\n        if (date.HasValue) query = query.Where(activity => activity.ActivityDate == date.Value);\n        if (penId.HasValue) query = query.Where(activity => activity.PenId == penId.Value);\n        var activities = await query.OrderBy(activity => activity.ActivityDate).ThenBy(activity => activity.Id).ToListAsync();\n        return new FeedingLogResponse(activities.Select(ToActivity).ToList());\n    }\n\n    private static async Task<IResult> CreateFeedingActivity(FeedingActivityRequest request, AppDb db)\n    {\n        if (request.PenId <= 0 || request.RationId <= 0 || request.Date == default ||\n            request.LotQuantities is null || request.LotQuantities.Count == 0 ||\n            request.LotQuantities.Any(value => value.LotId <= 0 || !CanStore(value.ActualQuantityLb) || value.ActualQuantityLb <= 0))\n            return ApiErrors.ValidationError(details: [\"penId, rationId, date, and positive finite lot quantities are required.\"]);\n        if (request.LotQuantities.Select(value => value.LotId).Distinct().Count() != request.LotQuantities.Count)\n            return ApiErrors.Conflict(\"Each lot may appear only once in an activity.\");\n\n        var pen = await db.Set<PenEntity>().AsNoTracking().FirstOrDefaultAsync(value => value.Id == request.PenId);\n        if (pen is null) return ApiErrors.NotFound(\"The requested pen was not found.\");\n        var ration = await db.Set<RationEntity>().AsNoTracking().Include(value => value.Ingredients)\n            .ThenInclude(ingredient => ingredient.Item).FirstOrDefaultAsync(value => value.Id == request.RationId);\n        if (ration is null) return ApiErrors.NotFound(\"The requested ration was not found.\");\n        if (!HasValidRation(ration))\n            return ApiErrors.ValidationError(\"The ration must contain valid ingredient proportions totaling 100 percent.\");\n\n        FeedingPlanEntity? plan = null;\n        if (request.FeedingPlanId is int planId)\n        {\n            if (planId <= 0) return ApiErrors.ValidationError(details: [\"feedingPlanId must be greater than zero when supplied.\"]);\n            plan = await db.Set<FeedingPlanEntity>().FirstOrDefaultAsync(value => value.Id == planId);\n            if (plan is null) return ApiErrors.NotFound(\"The requested feeding plan was not found.\");\n            if (plan.PenId != pen.Id || plan.RationId != ration.Id || plan.PlanDate != request.Date)\n                return ApiErrors.Conflict(\"The feeding plan must match the activity pen, ration, and date.\");\n        }\n\n        var lotIds = request.LotQuantities.Select(value => value.LotId).ToArray();\n        var lots = await db.Set<LotEntity>().AsNoTracking().Where(lot => lotIds.Contains(lot.Id))\n            .ToDictionaryAsync(lot => lot.Id);\n        if (lots.Count != lotIds.Length) return ApiErrors.NotFound(\"One or more requested lots were not found.\");\n        if (lots.Values.Any(lot => lot.PenId != pen.Id || !IsActive(lot)))\n            return ApiErrors.Conflict(\"Each consumed lot must be active and assigned to the requested pen.\");\n\n        var actualQuantity = request.LotQuantities.Sum(value => (decimal)value.ActualQuantityLb);\n        var ingredients = ration.Ingredients.OrderBy(ingredient => ingredient.ItemId)\n            .Select(ingredient => new IngredientAmount(ingredient.Item, actualQuantity * ingredient.ProportionPercent / 100m))\n            .ToList();\n        var itemIds = ingredients.Select(ingredient => ingredient.Item.Id).ToArray();\n\n        await using var transaction = await db.Database.BeginTransactionAsync(IsolationLevel.Serializable);\n        var movements = await db.Set<InventoryMovementEntity>().AsNoTracking()\n            .Where(movement => itemIds.Contains(movement.ItemId)).ToListAsync();\n        foreach (var ingredient in ingredients)\n        {\n            var stock = InventoryTotals.For(ingredient.Item,\n                movements.Where(movement => movement.ItemId == ingredient.Item.Id)).ClosingStockLb;\n            if (ingredient.QuantityLb > stock)\n                return ApiErrors.Conflict($\"The feeding activity exceeds available stock for {ingredient.Item.Name}.\");\n        }\n\n        var economics = GetEconomics(ration);\n        var activity = new FeedingActivityEntity\n        {\n            ActivityDate = request.Date,\n            PenId = pen.Id,\n            RationId = ration.Id,\n            FeedingPlanId = plan?.Id,\n            Manager = ManagerName,\n            ActualQuantityLb = actualQuantity,\n            FeedCost = ingredients.Sum(value => value.QuantityLb * value.Item.UnitCost),\n            EnergyMcal = actualQuantity * economics.EnergyMcalPerLb,\n            LotConsumptions = request.LotQuantities.Select(value => new FeedingActivityLotConsumptionEntity\n            {\n                LotId = value.LotId,\n                QuantityLb = (decimal)value.ActualQuantityLb\n            }).ToList(),\n            IngredientConsumptions = ingredients.Select(value => new FeedingActivityIngredientConsumptionEntity\n            {\n                ItemId = value.Item.Id,\n                QuantityLb = value.QuantityLb\n            }).ToList()\n        };\n\n        if (plan is not null)\n        {\n            var previousActual = await db.Set<FeedingActivityEntity>().AsNoTracking()\n                .Where(value => value.FeedingPlanId == plan.Id).SumAsync(value => (decimal?)value.ActualQuantityLb) ?? 0m;\n            plan.Status = previousActual + actualQuantity < PlanQuantity(plan)\n                ? \"In progress\"\n                : \"Completed\";\n            db.Update(plan);\n        }\n\n        db.Add(activity);\n        await db.SaveChangesAsync();\n        db.AddRange(ingredients.Select(value => new InventoryMovementEntity\n        {\n            ItemId = value.Item.Id,\n            MovementType = \"consumed\",\n            Date = request.Date,\n            QuantityLb = value.QuantityLb,\n            Note = $\"Feeding activity {activity.Id}\"\n        }));\n        await db.SaveChangesAsync();\n        await transaction.CommitAsync();\n\n        return Results.Json(new FeedingActivityResponse(ToActivity(activity, pen, ration, plan,\n            lots, ingredients)),\n            statusCode: StatusCodes.Status201Created);\n    }\n\n    private static async Task<Dictionary<int, RationEntity>> LoadRations(AppDb db, int[] rationIds) =>\n        await db.Set<RationEntity>().AsNoTracking().Include(ration => ration.Ingredients)\n            .ThenInclude(ingredient => ingredient.Item).Where(ration => rationIds.Contains(ration.Id))\n            .ToDictionaryAsync(ration => ration.Id);\n\n    private static FeedingPlan ToPlan(FeedingPlanEntity plan, PenEntity? pen, RationEntity? ration,\n        decimal? actualQuantity, bool hasActual)\n    {\n        var plannedQuantity = PlanQuantity(plan);\n        var activeLots = pen?.Lots.Where(IsActive).OrderBy(lot => lot.Id).ToList() ?? [];\n        var lotId = activeLots.Count == 1 ? activeLots[0].Id : (int?)null;\n        var lotName = activeLots.Count switch\n        {\n            0 => \"\",\n            1 => activeLots[0].Name,\n            _ => string.Join(\", \", activeLots.Select(lot => lot.Name))\n        };\n        var economics = ration is null ? new RationEconomics(0m, 0m) : GetEconomics(ration);\n        return new FeedingPlan(plan.Id, plan.PlanDate, plan.PenId, pen?.Name ?? \"\", lotId, lotName,\n            plan.CurrentPenHeadcount, plan.RationId, ration?.Name ?? \"\", (float)plannedQuantity,\n            plan.PlannedTime.ToString(\"HH:mm\"), plan.CurrentPenHeadcount == 0 ? 0 : (float)(plannedQuantity / plan.CurrentPenHeadcount),\n            (float)(plannedQuantity * economics.CostPerLb), (float)(plannedQuantity * economics.EnergyMcalPerLb),\n            ParsePlanStatus(plan.Status), hasActual ? (float)actualQuantity!.Value : null,\n            hasActual ? (float)(actualQuantity!.Value - plannedQuantity) : null);\n    }\n\n","chars":14889,"exitCode":0}
