.Status422UnprocessableEntity);\n\n        app.MapPost(\"/inventory/wastage\", RecordActualWastage)\n            .WithName(\"recordActualWastage\")\n            .Produces<MovementCreatedResponse>(StatusCodes.Status201Created)\n            .Produces<ErrorResponse>(StatusCodes.Status400BadRequest)\n            .Produces<ErrorResponse>(StatusCodes.Status404NotFound)\n            .Produces<ErrorResponse>(StatusCodes.Status409Conflict)\n            .Produces<ErrorResponse>(StatusCodes.Status422UnprocessableEntity);\n\n        app.MapPatch(\"/inventory/settings\", UpdateInventorySettings)\n            .WithName(\"updateInventorySettings\")\n            .Produces<InventorySettingsResponse>(StatusCodes.Status200OK)\n            .Produces<ErrorResponse>(StatusCodes.Status400BadRequest)\n            .Produces<ErrorResponse>(StatusCodes.Status422UnprocessableEntity);\n\n        app.MapGet(\"/inventory/outlook\", GetInventoryOutlook)\n            .WithName(\"getInventoryOutlook\")\n            .Produces<OutlookResponse>(StatusCodes.Status200OK)\n            .Produces<ErrorResponse>(StatusCodes.Status400BadRequest)\n            .Produces<ErrorResponse>(StatusCodes.Status422UnprocessableEntity)\n            .Produces<ErrorResponse>(StatusCodes.Status500InternalServerError);\n    }\n\n    private static async Task<InventoryResponse> GetInventoryItems(AppDb db)\n    {\n        var items = await db.Set<InventoryItemEntity>().AsNoTracking().OrderBy(item => item.Id).ToListAsync();\n        var movements = await db.Set<InventoryMovementEntity>().AsNoTracking()\n            .OrderBy(movement => movement.Date).ThenBy(movement => movement.Id).ToListAsync();\n        var movementsByItem = movements.GroupBy(movement => movement.ItemId)\n            .ToDictionary(group => group.Key, group => group.ToList());\n        var settings = await db.Set<InventorySettingEntity>().AsNoTracking()\n            .FirstOrDefaultAsync(setting => setting.Scope == DefaultScope);\n        var wastageRatio = settings?.WastageRatio ?? DefaultWastageRatio;\n\n        return new InventoryResponse((float)wastageRatio, items.Select(item => ToInventoryItem(item,\n            movementsByItem.GetValueOrDefault(item.Id) ?? [])).ToList());\n    }\n\n    private static async Task<IResult> RecordInventoryMovement(InventoryMovementRequest request, AppDb db)\n    {\n        if (request.Date == default || string.IsNullOrWhiteSpace(request.Note) || !CanStore(request.QuantityLb))\n            return ApiErrors.ValidationError(details: [\"date, note, and a finite quantityLb are required.\"]);\n        if (request.MovementType == InventoryMovementRequestType.Received && request.QuantityLb <= 0)\n            return ApiErrors.ValidationError(details: [\"Received quantityLb must be greater than zero.\"]);\n        if (request.MovementType == InventoryMovementRequestType.Adjustment && request.QuantityLb == 0)\n            return ApiErrors.ValidationError(details: [\"Adjustment quantityLb must not be zero.\"]);\n\n        var item = await db.Set<InventoryItemEntity>().FirstOrDefaultAsync(value => value.Id == request.ItemId);\n        if (item is null) return ApiErrors.NotFound(\"The requested inventory item was not found.\");\n\n        var movementType = request.MovementType == InventoryMovementRequestType.Received ? \"received\" : \"adjustment\";\n        var movement = new InventoryMovementEntity\n        {\n            ItemId = item.Id,\n            MovementType = movementType,\n            Date = request.Date,\n            QuantityLb = (decimal)request.QuantityLb,\n            Note = request.Note.Trim()\n        };\n        if (movementType == \"adjustment\" && (await CurrentStock(db, item) + movement.QuantityLb) < 0)\n            return ApiErrors.Conflict(\"The adjustment would make inventory stock negative.\");\n\n        db.Add(movement);\n        await db.SaveChangesAsync();\n        var allMovements = await db.Set<InventoryMovementEntity>().AsNoTracking()\nusing App.Api;\nusing App.Api.Endpoints;\nusing Microsoft.EntityFrameworkCore;\n\nvar builder = WebApplication.CreateBuilder(args);\nbuilder.Services.AddOpenApi(options => options.AddSchemaTransformer((schema, context, _) =>\n{\n    if (context.JsonTypeInfo.Type == typeof(ErrorResponse))\n    {\n        schema.Required?.Remove(\"details\");\n        if (schema.Properties.TryGetValue(\"details\", out var details)) details.Nullable = false;\n    }\n    if (context.JsonTypeInfo.Type == typeof(ProjectDemoResponse) &&\n        schema.Properties.TryGetValue(\"validationCoverage\", out var validationCoverage) &&\n        schema.Properties.TryGetValue(\"productionReadiness\", out var productionReadiness))\n    {\n        productionReadiness.Items = validationCoverage.Items;\n    }\n    return Task.CompletedTask;\n}));\nbuilder.Services.Configure<RouteHandlerOptions>(o => o.ThrowOnBadRequest = true);\n// PostgreSQL: the connection comes from ConnectionStrings__App and nowhere else. There is no built-in login: an app that is\n// not given one stops when it first needs the database, so it can never run on a password that is written in the code.\nbuilder.Services.AddDbContext<AppDb>(o => o.UseNpgsql(builder.Configuration.GetConnectionString(\"App\")\n    ?? throw new InvalidOperationException(\"No database connection is configured. Set ConnectionStrings__App (for example Host=...;Port=5432;Database=...;Username=...;Password=«SECRET_1»")));\n// the web app's address: 3000 unless the setting Cors:Origin names another (the factory sets it when it starts the web app on another port)\nbuilder.Services.AddCors(o => o.AddDefaultPolicy(p => p.WithOrigins(builder.Configuration[\"Cors:Origin\"] ?? \"http://localhost:3000\").AllowAnyHeader().AllowAnyMethod()));\nvar app = builder.Build();\n// Create the database with every table when the app starts. The build also runs this file, to write the API's OpenAPI\n// document, and must not touch the database then. Keep this: the factory starts the app and reads the database it creates.\nif (System.Reflection.Assembly.GetEntryAssembly()?.GetName().Name != \"GetDocument.Insider\")\n{\n    // one at a time: the tests start several copies of the app in one process, and two creating the tables at once collide\n    lock (typeof(AppDb))\n    {\n        using var scope = app.Services.CreateScope();\n        var db = scope.ServiceProvider.GetRequiredService<AppDb>();\n        db.Database.EnsureCreated();\n        // sample rows, only when asked for (Seed__Demo=true): tests and the factory's own checks start on an empty database\n        if (app.Configuration.GetValue<bool>(\"Seed:Demo\")) SeedData.Run(db);\n    }\n}\napp.UseCors();\napp.Use(ApiErrors.Handle);\napp.MapGet(\"/\", () => \"API is up\").ExcludeFromDescription();\n","chars":8271,"exitCode":0}
