sults.Ok(ToResponse(existingRun));\n+        }\n+        return Results.Ok(ToResponse(run));\n+    }\n+\n+    private static List<DemoLoadOutcomeEntity> CreateOutcomes(string datasetId)\n+    {\n+        var records = new (string OutcomeType, string RecordType, string SourceIdentifier, string Reason)[]\n+        {\n+            (\"added\", \"lot\", \"DEMO-LOT-01\", \"Added\"),\n+            (\"added\", \"lot\", \"DEMO-LOT-02\", \"Added\"),\n+            (\"added\", \"lot\", \"DEMO-LOT-03\", \"Added\"),\n+            (\"added\", \"inventory_item\", \"DEMO-ITEM-01\", \"Added\"),\n+            (\"added\", \"inventory_item\", \"DEMO-ITEM-02\", \"Added\"),\n+            (\"added\", \"ration\", \"DEMO-RATION-01\", \"Added\"),\n+            (\"already_present\", \"lot\", \"DEMO-LOT-04\", \"Already present\"),\n+            (\"already_present\", \"inventory_item\", \"Yellow corn\", \"Already present\"),\n+            (\"failed\", \"ration\", \"DEMO-RATION-02\", \"The record could not be loaded.\")\n+        };\n+        return records.Select(record => new DemoLoadOutcomeEntity\n+        {\n+            DatasetId = datasetId,\n+            OutcomeType = record.OutcomeType,\n+            RecordType = record.RecordType,\n+            SourceIdentifier = record.SourceIdentifier,\n+            Reason = record.Reason\n+        }).ToList();\n+    }\n+\n+    private static DemoLoadResponse ToResponse(DemoLoadRunEntity run)\n+    {\n+        var added = ToOutcomes(run.Outcomes, \"added\");\n+        var alreadyPresent = ToOutcomes(run.Outcomes, \"already_present\");\n+        var failed = ToOutcomes(run.Outcomes, \"failed\");\n+        return new DemoLoadResponse(run.DatasetId, added.Length, alreadyPresent.Length, failed.Length,\n+            failed.Length > 0, added, alreadyPresent, failed);\n+    }\n+\n+    private static DemoRecordOutcome[] ToOutcomes(IEnumerable<DemoLoadOutcomeEntity> outcomes, string outcomeType) =>\n+        outcomes.Where(outcome => outcome.OutcomeType == outcomeType).OrderBy(outcome => outcome.Id)\n+            .Select(outcome => new DemoRecordOutcome(outcome.RecordType, outcome.SourceIdentifier, outcome.Reason))\n+            .ToArray();\n+}\n+\n+internal sealed record DemoLoadRequest(string DatasetId);\n+internal sealed record DemoRecordOutcome(string RecordType, string SourceIdentifier, string Reason);\n+internal sealed record DemoLoadResponse(string DatasetId, int AddedCount, int AlreadyPresentCount, int FailedCount,\n+    bool Partial, DemoRecordOutcome[] AddedRecords, DemoRecordOutcome[] AlreadyPresentRecords,\n+    DemoRecordOutcome[] FailedRecords);\ndiff --git a/App.Api/SeedData.cs b/App.Api/SeedData.cs\nindex d003e4f..d8a105c 100644\n--- a/App.Api/SeedData.cs\n+++ b/App.Api/SeedData.cs\n@@ -1,10 +1,346 @@\n+using App.Api.Data;\n+\n namespace App.Api;\n \n // Sample rows for a person trying the product. The app calls Run at startup, after the tables exist, only when the setting\n-// Seed:Demo is true (the factory's run files set it; tests never do). Add rows to a table only when that table is empty.\n+// Seed:Demo is true (the factory's seeded-data checks set it). Add rows to a table only when that table is empty.\n public static class SeedData\n {\n     public static void Run(AppDb db)\n     {\n+        if (!HasRows<ImportBatchEntity>(db))\n+        {\n+            db.AddRange(\n+                new ImportBatchEntity { BatchId = \"spring-po-2026\", SourceName = \"Spring purchase orders\" },\n+                new ImportBatchEntity { BatchId = \"summer-po-2026\", SourceName = \"Summer purchase orders\" },\n+                new ImportBatchEntity { BatchId = \"fall-po-2026\", SourceName = \"Fall purchase orders\" });\n+            db.SaveChanges();\n+        }\n+\n+        if (!HasRows<PenEntity>(db))\n+        {\n+            db.AddRange(\n+                new PenEntity { Id = 101, Name = \"Pen 01\", Capacity = 60 },\n+                new PenEntity { Id = 102, Name = \"Pen 02\", Capacity = 60 },\n+               