";\n+    public ICollection<DemoLoadOutcomeEntity> Outcomes { get; set; } = new List<DemoLoadOutcomeEntity>();\n+}\n+\n+[Table(\"DemoLoadOutcomes\")]\n+internal sealed class DemoLoadOutcomeEntity\n+{\n+    public int Id { get; set; }\n+    public string DatasetId { get; set; } = \"\";\n+    public DemoLoadRunEntity Run { get; set; } = null!;\n+    public string OutcomeType { get; set; } = \"\";\n+    public string RecordType { get; set; } = \"\";\n+    public string SourceIdentifier { get; set; } = \"\";\n+    public string Reason { get; set; } = \"\";\n+}\ndiff --git a/App.Api/Endpoints/DemoEndpoints.cs b/App.Api/Endpoints/DemoEndpoints.cs\nnew file mode 100644\nindex 0000000..986f9e8\n--- /dev/null\n+++ b/App.Api/Endpoints/DemoEndpoints.cs\n@@ -0,0 +1,123 @@\n+using App.Api.Data;\n+using Microsoft.AspNetCore.Http;\n+using Microsoft.AspNetCore.OpenApi;\n+using Microsoft.EntityFrameworkCore;\n+using Microsoft.Extensions.Options;\n+using Microsoft.OpenApi.Models;\n+\n+namespace App.Api.Endpoints;\n+\n+internal sealed class DemoEndpoints : IEndpointModule\n+{\n+    private const string SupportedDatasetId = \"feedlot-demo-2026\";\n+\n+    public void MapEndpoints(IEndpointRouteBuilder app)\n+    {\n+        app.ServiceProvider.GetRequiredService<IOptionsMonitor<OpenApiOptions>>().Get(\"v1\")\n+            .AddSchemaTransformer((schema, context, _) =>\n+            {\n+                if (context.JsonTypeInfo.Type == typeof(DemoLoadResponse))\n+                {\n+                    var itemSchema = new OpenApiSchema\n+                    {\n+                        Reference = new OpenApiReference { Type = ReferenceType.Schema, Id = nameof(DemoRecordOutcome) }\n+                    };\n+                    foreach (var propertyName in new[] { \"alreadyPresentRecords\", \"failedRecords\" })\n+                    {\n+                        if (schema.Properties.TryGetValue(propertyName, out var property))\n+                            property.Items = itemSchema;\n+   