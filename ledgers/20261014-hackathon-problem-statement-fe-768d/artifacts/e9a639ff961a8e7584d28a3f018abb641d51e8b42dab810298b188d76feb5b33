\n359\t        DateOnly? projectedShipDate = null;\n360\t        var latest = readings.LastOrDefault();\n361\t        if (latest is not null && adg is > 0)\n362\t        {\n363\t            var daysToTarget = Math.Max(0, (int)Math.Ceiling(((double)lot.TargetWeightLb - (double)latest.AverageWeightLb) / adg.Value));\n364\t            projectedShipDate = latest.MeasurementDate.AddDays(daysToTarget);\n365\t        }\n366\t\n367\t        return new PerformanceMetrics(lot.Id, days, (float)totalGain, adg, (float)totalFeed,\n368\t            ratio, costPerGain, projectedShipDate);\n369\t    }\n370\t\n371\t    private static decimal CostForLot(IEnumerable<FeedingActivityLotConsumptionEntity> consumptions) =>\n372\t        consumptions.Sum(value => value.Activity.ActualQuantityLb > 0\n373\t            ? value.Activity.FeedCost * value.QuantityLb / value.Activity.ActualQuantityLb\n374\t            : 0m);\n375\t\n376\t    private static float? AverageDailyGain(WeightReadingEntity? previous, WeightReadingEntity? latest)\n377\t    {\n378\t        if (previous is null || latest is null) return null;\n379\t        var days = latest.MeasurementDate.DayNumber - previous.MeasurementDate.DayNumber;\n380\t        return days <= 0 ? null : (float)((latest.AverageWeightLb - previous.AverageWeightLb) / days);\n381\t    }\n382\t\n383\t    private static decimal FirstReadingGain(LotEntity lot, WeightReadingEntity reading,\n384\t        IReadOnlyDictionary<string, SourceWeight> sourceByLine) =>\n385\t        sourceByLine.TryGetValue(lot.SourcePurchaseOrderLine, out var source)\n386\t            ? TotalWeight(reading) - source.WeightLb * source.HeadCount\n387\t            : 0m;\n388\t\n389\t    private static decimal TotalWeight(WeightReadingEntity reading) =>\n390\t        reading.AverageWeightLb * reading.ApplicableHeadcount;\n391\t\n392\t    private static PlanAlignmentReport? GetAlignment(string penName, IReadOnlyList<FeedingPlanEntity> plans,\n393\t        IReadOnlyList<FeedingActivityEnt