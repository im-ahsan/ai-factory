ctivities\", \"activities\");\n\n        using var settingsResponse = await client.PatchAsJsonAsync(\n            \"/inventory/settings\",\n            new { wastageRatio = 0.037 });\n        Assert.Equal(HttpStatusCode.OK, settingsResponse.StatusCode);\n        var settings = await settingsResponse.Content.ReadFromJsonAsync<JsonElement>();\n        Assert.Equal(0.037, settings.GetProperty(\"wastageRatio\").GetDouble(), 3);\n        using var inventoryResponse = await client.GetAsync(\"/inventory/items\");\n        Assert.Equal(HttpStatusCode.OK, inventoryResponse.StatusCode);\n        var inventory = await inventoryResponse.Content.ReadFromJsonAsync<JsonElement>();\n        Assert.Equal(0.037, inventory.GetProperty(\"wastageRatio\").GetDouble(), 3);\n        Assert.Empty(inventory.GetProperty(\"items\").EnumerateArray());\n        await AssertOnlyTestCreatedSettingAsync(factory);\n    }\n\n    [Fact]\n    public async Task AC_5_2_ReturnsAnEmptyCollectionWithoutDemoRows()\n    {\n        using var factory = CreateFactoryWithoutDemoSeeding();\n        using var client = factory.CreateClient();\n\n        await AssertEveryTableEmptyAsync(factory);\n\n        using var response = await client.GetAsync(\"/imports/batches\");\n\n        Assert.Equal(HttpStatusCode.OK, response.StatusCode);\n        var result = await response.Content.ReadFromJsonAsync<JsonElement>();\n        Assert.Empty(result.GetProperty(\"batches\").EnumerateArray());\n    }\n\n    private WebApplicationFactory<Program> CreateFactoryWithoutDemoSeeding() =>\n        _factory.WithWebHostBuilder(builder => builder.ConfigureAppConfiguration((_, configuration) =>\n            configuration.AddInMemoryCollection(new Dictionary<string, string?>\n            {\n                [\"Seed:Demo\"] = \"false\"\n            })));\n\n    private static async Task AssertCollectionsEmptyAsync(HttpClient client, string path, params string[] properties)\n    {\n        using var response = await client.GetAsync(path);\n        Assert.Equal(HttpStatusCode.OK, response.StatusCode);\n        var result = await response.Content.ReadFromJsonAsync<JsonElement>();\n\n        foreach (var property in properties)\n        {\n            Assert.Empty(result.GetProperty(property).EnumerateArray());\n        }\n    }\n\n    private static async Task AssertEveryTableEmptyAsync(WebApplicationFactory<Program> factory)\n    {\n        await using var scope = factory.Services.CreateAsyncScope();\n        var db = scope.ServiceProvider.GetRequiredService<AppDb>();\n        await db.Database.OpenConnectionAsync();\n        var connection = db.Database.GetDbConnection();\n        foreach (var tableName in PersistentTables)\n        {\n            await using var command = connection.CreateCommand();\n            command.CommandText = $\"SELECT COUNT(*) FROM \\\"{tableName}\\\"\";\n            Assert.Equal(0L, Convert.ToInt64(await command.ExecuteScalarAsync()));\n        }\n    }\n\n    private static async Task AssertOnlyTestCreatedSettingAsync(WebApplicationFactory<Program> factory)\n    {\n        await using var scope = factory.Services.CreateAsyncScope();\n        var db = scope.ServiceProvider.GetRequiredService<AppDb>();\n        await db.Database.OpenConnectionAsync();\n        var connection = db.Database.GetDbConnection();\n        foreach (var tableName in PersistentTables)\n        {\n            await using var command = connection.CreateCommand();\n            command.CommandText = $\"SELECT COUNT(*) FROM \\\"{tableName}\\\"\";\n            var expectedCount = tableName == \"InventorySettings\" ? 1L : 0L;\n            Assert.Equal(expectedCount, Convert.ToInt64(await command.ExecuteScalarAsync()));\n        }\n    }\n}\nusing System.Net;\nusing System.Data.Common;\nusing System.Text.Json;\nusing App.Api;\nusing Microsoft.AspNetCore.Hosting;\nusing Microsoft.AspNetCore.Mvc.Testing;\nusing Microsoft.EntityFrameworkCore;\nusing Microsoft.Extensions.Configuration;\nusing Microsoft.Extensions.DependencyInjection;\nusing Xunit;\n\nnamespace App.Tests.Part3;\n\npublic sealed class AcceptancePart3Tests : IClassFixture<WebApplicationFactory<Program>>\n{\n    private static readonly (string Path, string[] Lists)[] CollectionOperations =\n    [\n        (\"/imports/batches\", [\"batches\"]),\n        (\"/lots\", [\"lots\", \"pens\"]),\n        (\"/inventory/items\", [\"items\"]),\n        (\"/rations\", [\"rations\"]),\n        (\"/feeding/plans\", [\"plans\"]),\n        (\"/feeding/activities\", [\"activities\"]),\n        (\"/lots/101/weight-readings\", [\"readings\"])\n    ];\n\n    private static readonly string[] PersistentContractTables =\n    [\n        \"ImportBatches\",\n        \"ImportRows\",\n        \"Pens\",\n        \"Lots\",\n        \"InventoryItems\",\n        \"InventoryMovements\",\n        \"InventorySettings\",\n        \"Rations\",\n        \"RationIngredients\",\n        \"RationCandidates\",\n        \"RationCandidateIngredients\",\n        \"FeedingPlans\",\n        \"FeedingActivities\",\n        \"FeedingActivityLotConsumptions\",\n        \"FeedingActivityIngredientConsumptions\",\n        \"WeightReadings\",\n        \"DemoLoadRuns\",\n        \"DemoLoadOutcomes\"\n    ];\n\n    private readonly WebApplicationFactory<Program> _factory;\n\n    public AcceptancePart3Tests(WebApplicationFactory<Program> factory) => _factory = factory;\n\n    [Fact]\n    public async Task AC_3_1_SeedsPersistentEntitiesAndCollectionResponses()\n    {\n        using var seededFactory = CreateSeededFactory();\n        using var client = seededFactory.CreateClient();\n\n        await using var scope = seededFactory.Services.CreateAsyncScope();\n        var db = scope.ServiceProvider.GetRequiredService<AppDb>();\n        await db.Database.OpenConnectionAsync();\n\n        foreach (var (path, listNames) in CollectionOperations)\n        {\n            using var document = await GetJsonAsync(client, path);\n            foreach (var listName in listNames)\n            {\n                Assert.True(document.RootElement.TryGetProperty(listName, out var records),\n                    $\"{path} should include the '{listName}' collection.\");\n                Assert.Equal(JsonValueKind.Array, records.ValueKind);\n                switch (listName)\n                {\n                    case \"batches\":\n                        AssertSeededStringIds(records, await ReadStringsAsync(db, \"SELECT \\\"BatchId\\\" FROM \\\"ImportBatches\\\"\"), \"batchId\");\n                        break;\n                    case \"lots\":\n                        AssertSeededIntIds(records, await ReadIntsAsync(db, \"SELECT \\\"Id\\\" FROM \\\"Lots\\\"\"), \"id\");\n                        break;\n                    case \"pens\":\n                        AssertSeededIntIds(records, await ReadIntsAsync(db, \"SELECT \\\"Id\\\" FROM \\\"Pens\\\"\"), \"id\");\n                        break;\n                    case \"items\":\n                        AssertSeededIntIds(records, await ReadIntsAsync(db, \"SELECT \\\"Id\\\" FROM \\\"InventoryItems\\\"\"), \"id\");\n                        break;\n                    case \"rations\":\n                        AssertSeededIntIds(records, await ReadIntsAsync(db, \"SELECT \\\"Id\\\" FROM \\\"Rations\\\"\"), \"id\");\n                        break;\n                    case \"plans\":\n                        AssertSeededIntIds(records, await ReadIntsAsync(db, \"SELECT \\\"Id\\\" FROM \\\"FeedingPlans\\\"\"), \"id\");\n                        break;\n                    case \"activities\":\n                        AssertSeededIntIds(records, await ReadIntsAsync(db, \"SELECT \\\"Id\\\" FROM \\\"FeedingActivities\\\"\"), \"id\");\n                        break;\n                    case \"readings\":\n                        AssertSeededIntIds(records, await ReadIntsAsync(db, \"SELECT \\\"Id\\\" FROM \\\"WeightReadings\\\" WHERE \\\"LotId\\\" = 101\"), \"id\");\n                        break;\n                }\n            }\n        }\n\n        var connection = db.Database.GetDbConnection();\n\n        foreach (var tableName in PersistentContractTables)\n        {\n            await using var command = connection.CreateCommand();\n            command.CommandText = $\"SELECT COUNT(*) FROM \\\"{tableName}\\\"\";\n            var rowCount = Convert.ToInt64(await command.ExecuteScalarAsync());\n            Assert.True(rowCount >= 3,\n                $\"The seeded {tableName} table should contain at least three sample rows; found {rowCount}.\");\n        }\n    }\n\n    [Fact]\n    public async Task AC_3_2_ReturnsContractExampleValuesInRelevantCollections()\n    {\n        using var seededFactory = CreateSeededFactory();\n        using var client = seededFactory.CreateClient();\n\n        using var imports = await GetJsonAsync(client, \"/imports/batches\");\n        AssertContainsString(imports.RootElement, \"spring-po-2026\");\n\n        using var lotsAndPens = await GetJsonAsync(client, \"/lots\");\n        AssertContainsString(lotsAndPens.RootElement, \"PO-8041-L1\");\n        AssertContainsString(lotsAndPens.RootElement, \"Lot 24-A\");\n        AssertContainsString(lotsAndPens.RootElement, \"Pen 01\");\n\n        using var inventory = await GetJsonAsync(client, \"/inventory/items\");\n        AssertContainsString(inventory.RootElement, \"Yellow corn\");\n\n        using var rations = await GetJsonAsync(client, \"/rations\");\n        AssertContainsString(rations.RootElement, \"Grower 1\");\n    }\n\n    private WebApplicationFactory<Program> CreateSeededFactory() => _factory.WithWebHostBuilder(builder =>\n        builder.ConfigureAppConfiguration((_, configuration) =>\n            configuration.AddInMemoryCollection(new Dictionary<string, string?>\n            {\n                [\"Seed:Demo\"] = \"true\"\n            })));\n\n    private static async Task<JsonDocument> GetJsonAsync(HttpClient client, string path)\n    {\n        using var response = await client.GetAsync(path);\n        Assert.Equal(HttpStatusCode.OK, response.StatusCode);\n        await using var stream = await response.Content.ReadAsStreamAsync();\n        return await JsonDocument.ParseAsync(stream);\n    }\n\n    private static void AssertContainsString(JsonElement element, string expected) =>\n        Assert.True(ContainsString(element, expected), $\"Expected response to contain '{expected}'.\");\n\n    private static async Task<HashSet<int>> ReadIntsAsync(AppDb db, string sql)\n    {\n        var values = new HashSet<int>();\n        await using var command = db.Database.GetDbConnection().CreateCommand();\n        command.CommandText = sql;\n        await using var reader = await command.ExecuteReaderAsync();\n        while (await reader.ReadAsync()) values.Add(reader.GetInt32(0));\n        return values;\n    }\n\n    private static async Task<HashSet<string>> ReadStringsAsync(AppDb db, string sql)\n    {\n        var values = new HashSet<string>(StringComparer.Ordinal);\n        await using var command = db.Database.GetDbConnection().CreateCommand();\n        command.CommandText = sql;\n        await using var reader = await command.ExecuteReaderAsync();\n        while (await reader.ReadAsync()) values.Add(reader.GetString(0));\n        return values;\n    }\n\n    private static void AssertSeededIntIds(JsonElement records, HashSet<int> storedIds, string property)\n    {\n        var responseIds = records.EnumerateArray().Select(record => record.GetProperty(property).GetInt32()).ToHashSet();\n        Assert.True(responseIds.Count >= 3, \"Expected at least three seeded records in the API collection.\");\n        Assert.All(responseIds, id => Assert.Contains(id, storedIds));\n        Assert.True(storedIds.IsSubsetOf(responseIds), \"Every seeded row should be returned by its collection operation.\");\n    }\n\n    private static void AssertSeededStringIds(JsonElement records, HashSet<string> storedIds, string property)\n    {\n        var responseI