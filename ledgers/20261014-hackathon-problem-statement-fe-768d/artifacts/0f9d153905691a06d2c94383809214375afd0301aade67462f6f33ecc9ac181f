ading => reading.GetProperty(\"id\").GetInt32() == readingId);\n    }\n\n    [Fact]\n    public async Task AC_2_2_InitializesPersistentStorageForContractEntities()\n    {\n        using var host = new ApiHost();\n        using var response = await host.Client.GetAsync(\"/rations\");\n\n        Assert.Equal(HttpStatusCode.OK, response.StatusCode);\n        using var document = JsonDocument.Parse(await response.Content.ReadAsStringAsync());\n        Assert.Equal(JsonValueKind.Array, document.RootElement.GetProperty(\"rations\").ValueKind);\n    }\n\n    [Fact]\n    public async Task AC_2_3_ReturnsCreatedRationAfterRestart()\n    {\n        var itemId = RandomNumberGenerator.GetInt32(100_000, int.MaxValue);\n        var rationName = $\"Restart persistence ration {itemId}\";\n        int rationId;\n\n        using (var firstHost = new ApiHost())\n        {\n            await firstHost.SeedInventoryItemAsync(itemId, $\"Test feed {itemId}\");\n            using var created = await firstHost.Client.PostAsJsonAsync(\"/rations\", new\n            {\n                name = rationName,\n                type = \"Finisher\",\n                targetWeightMinLb = 900,\n                targetWeightMaxLb = 1200,\n                operationalStatus = \"Active\",\n                ingredients = new[]\n                {\n                    new { itemId, proportionPercent = 100 }\n                }\n            });\n\n            Assert.Equal(HttpStatusCode.Created, created.StatusCode);\n            using var createdDocument = JsonDocument.Parse(await created.Content.ReadAsStringAsync());\n            rationId = createdDocument.RootElement.GetProperty(\"id\").GetInt32();\n        }\n\n        using var restartedHost = new ApiHost();\n        using var response = await restartedHost.Client.GetAsync(\"/rations\");\n        Assert.Equal(HttpStatusCode.OK, response.StatusCode);\n        using var document = JsonDocument.Parse(await response.Content.ReadAsStringAsync());\n        var ration = document.RootElement.GetProperty(\"rations\").EnumerateArray()\n            .Single(row => row.GetProperty(\"id\").GetInt32() == rationId);\n\n        Assert.Equal(rationName, ration.GetProperty(\"name\").GetString());\n        Assert.Equal(\"Finisher\", ration.GetProperty(\"type\").GetString());\n        Assert.Equal(900m, ration.GetProperty(\"targetWeightMinLb\").GetDecimal());\n        Assert.Equal(1200m, ration.GetProperty(\"targetWeightMaxLb\").GetDecimal());\n        Assert.Equal(\"Active\", ration.GetProperty(\"operationalStatus\").GetString());\n        var ingredient = Assert.Single(ration.GetProperty(\"ingredients\").EnumerateArray());\n        Assert.Equal(itemId, ingredient.GetProperty(\"itemId\").GetInt32());\n        Assert.Equal(100m, ingredient.GetProperty(\"proportionPercent\").GetDecimal());\n    }\n\n    private static void AssertReading(JsonElement response, int readingId, int lotId,\n        string measurementDate, int headcount, decimal averageWeightLb, string notes)\n    {\n        var reading = response.GetProperty(\"readings\").EnumerateArray()\n            .Single(row => row.GetProperty(\"id\").GetInt32() == readingId);\n\n        Assert.Equal(lotId, reading.GetProperty(\"lotId\").GetInt32());\n        Assert.Equal(measurementDate, reading.GetProperty(\"measurementDate\").GetString());\n        Assert.Equal(headcount, reading.GetProperty(\"animalsWeighed\").GetInt32());\n        Assert.Equal(averageWeightLb, reading.GetProperty(\"averageWeightLb\").GetDecimal());\n        Assert.Equal(notes, reading.GetProperty(\"notes\").GetString());\n        Assert.Equal(\"Persistence acceptance test\", reading.GetProperty(\"recordedBy\").GetString());\n    }\n\n    private sealed class ApiHost : IDisposable\n    {\n        private readonly WebApplicationFactory<Program> _factory = new();\n\n        public HttpClient Client { get; }\n\n        public ApiHost() => Client = _factory.CreateClient();\n\n        public Task SeedLotAsync(int id, string name) 