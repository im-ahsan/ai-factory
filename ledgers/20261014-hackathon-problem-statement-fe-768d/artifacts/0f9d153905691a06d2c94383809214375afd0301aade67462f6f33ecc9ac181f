olean());\n        foreach (var ingredient in candidate.GetProperty(\"ingredients\").EnumerateArray()) Has(ingredient, \"itemId\", \"name\", \"proportionPercent\", \"dryMatterPercent\", \"energyMcalPerKg\", \"costPerLb\");\n    }\n\n    private static void AssertFeedingPlan(JsonElement plan) => Has(plan, \"id\", \"date\", \"penId\", \"penName\", \"lotId\", \"lotName\", \"animalCount\", \"rationId\", \"rationName\", \"plannedQuantityLb\", \"plannedTime\", \"quantityPerAnimalLb\", \"totalFeedCost\", \"expectedEnergyMcal\", \"status\", \"actualQuantityLb\", \"varianceLb\");\n\n    private static void AssertFeedingActivity(JsonElement activity) => Has(activity, \"id\", \"date\", \"penId\", \"penName\", \"manager\", \"rationId\", \"rationName\", \"feedingPlanId\", \"plannedQuantityLb\", \"actualQuantityLb\", \"varianceLb\", \"status\", \"feedCost\", \"energyMcal\", \"ingredientConsumption\", \"lotConsumption\");\n\n    private static void AssertWeightReading(JsonElement reading) => Has(reading, \"id\", \"lotId\", \"measurementDate\", \"animalsWeighed\", \"averageWeightLb\", \"totalLotWeightLb\", \"gainSincePriorLb\", \"notes\", \"recordedBy\", \"status\");\n\n    private static void AssertWeightMutation(JsonElement response)\n    {\n        Has(response, \"readings\", \"metrics\");\n        foreach (var reading in response.GetProperty(\"readings\").EnumerateArray()) AssertWeightReading(reading);\n        AssertPerformanceMetrics(response.GetProperty(\"metrics\"));\n    }\n\n    private static void AssertPerformanceMetrics(JsonElement metrics) => Has(metrics, \"lotId\", \"daysOnFeed\", \"totalWeightGainLb\", \"averageDailyGainLbPerDay\", \"totalFeedConsumedAsFedLb\", \"feedConversionRatio\", \"feedCostPerPoundOfGain\", \"projectedShipDate\");\n\n    private sealed record OperationalFixture(int ItemId, int PenId, int LotId, int RationId, int PlanId, int ActivityId);\n}\n\npublic sealed class Part1CharacterisationTests : IClassFixture<WebApplicationFactory<Program>>\n{\n   