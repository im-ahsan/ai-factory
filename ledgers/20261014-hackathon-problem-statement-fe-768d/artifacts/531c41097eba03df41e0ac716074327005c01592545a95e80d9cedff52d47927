d try it (/swagger). Keep both: the factory's product page links to the page.\napp.MapOpenApi();\napp.UseSwaggerUI(o => o.SwaggerEndpoint(\"/openapi/v1.json\", \"API\"));\n\nforeach (var moduleType in typeof(Program).Assembly.GetTypes()\n    .Where(t => !t.IsAbstract && !t.IsInterface && typeof(IEndpointModule).IsAssignableFrom(t)))\n{\n    var module = (IEndpointModule)Activator.CreateInstance(moduleType, nonPublic: true)!;\n    module.MapEndpoints(app);\n}\n\napp.Run();\n\npublic partial class Program { }\n<Project Sdk=\"Microsoft.NET.Sdk.Web\">\n  <PropertyGroup>\n    <TargetFramework>net9.0</TargetFramework>\n    <Nullable>enable</Nullable>\n    <ImplicitUsings>enable</ImplicitUsings>\n    <!-- the build writes the API's OpenAPI document here; the factory compares it with contracts/openapi.yaml -->\n    <OpenApiDocumentsDirectory>$(MSBuildProjectDirectory)/openapi</OpenApiDocumentsDirectory>\n    <OpenApiGenerateDocumentsOptions>--file-name built</OpenApiGenerateDocumentsOptions>\n  </PropertyGroup>\n  <ItemGroup>\n    <PackageReference Include=\"Microsoft.AspNetCore.OpenApi\" Version=\"9.0.0\" />\n    <PackageReference Include=\"Microsoft.Extensions.ApiDescription.Server\" Version=\"9.0.0\">\n      <PrivateAssets>all</PrivateAssets>\n    </PackageReference>\n    <PackageReference Include=\"Npgsql.EntityFrameworkCore.PostgreSQL\" Version=\"9.0.2\" />\n    <PackageReference Include=\"Swashbuckle.AspNetCore.SwaggerUI\" Version=\"7.3.2\" />\n  </ItemGroup>\n</Project>\n","chars":14814,"exitCode":0}
