atus,\n    IReadOnlyList<RationUsage> RationUsage,\n    IReadOnlyList<PenBunkRate> DailyBunkRateByPen,\n    float PlannedFeedLb,\n    float ActualFeedLb,\n    float TotalFeedConsumedLb,\n    float TotalFeedCost,\n    float StartingWeightLb,\n    float CurrentWeightLb,\n    float TotalGainLb,\n    float AdgLbPerDay,\n    float FcrAsFed,\n    float FeedCostPerLbGain,\n    float EnergyConsumedMcal,\n    string BestPerformingLot,\n    string WorstPerformingLot);\n\ninternal sealed record Pen(int Id, string Name, int Capacity, int CurrentAnimalCount, int ActiveLotCount, string Status);\n\ninternal sealed record Lot(\n    int Id,\n    string Name,\n    int? PenId,\n    string PenName,\n    int HeadCount,\n    string Breed,\n    string Sex,\n    string SourcePurchaseOrderLine,\n    string Status,\n    float TargetWeightLb,\n    float DefaultGainRateLbPerDay,\n    float? MeasuredAdgLbPerDay);\n\ninternal sealed record LotPerformance(int LotId, string LotName, string PenName, int HeadCount, string Breed,\n    float MeasuredAdgLbPerDay, float FcrAsFed, float FeedCostPerLbGain);\ninternal sealed record RationUsage(string RationName, int PenCount, float FeedLb);\ninternal sealed record PenBunkRate(int PenId, string PenName, float LbPerHeadPerDay);\ninternal sealed record ImportBatch(string BatchId, string SourceName, int RecordCount);\ninternal sealed record ImportBatchesResponse(IReadOnlyList<ImportBatch> Batches);\ninternal sealed record ImportPreviewRequest(string BatchId);\ninternal sealed record ImportRow(int Id, string SourceIdentifier, ImportSourceType SourceType, string Vendor,\n    float Cost, int HeadCount, float WeightLb, string Breed, int AgeDays, string Source,\n    ImportRowStatus RowStatus, string? ProblemDetail, IReadOnlyList<LotLink> ProposedLots);\ninternal sealed record LotLink(int LotId, string LotName, int PenId, string PenName, int HeadCount,\n    int Capacity, int CurrentAnimalCount, string Status);\ninternal sealed record ImportPreviewResponse(string Bat