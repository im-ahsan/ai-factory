  "responsive": [
    { "block": "table", "below": "md", "becomes": "a card per row, the first cell its title and the status as a badge" },
    { "block": "toolbar", "below": "sm", "becomes": "the search, with the dropdowns and buttons folded into a More menu" },
    { "block": "results", "below": "md", "becomes": "the results, with the filters in a side sheet" },
    { "part": "frame", "shell": "sidebar", "below": "md", "becomes": "a top bar whose menu button opens the navigation in a drawer" },
    { "part": "frame", "shell": "topbar", "below": "md", "becomes": "a menu button opening the navigation in a drawer" },
    { "part": "crumbs", "below": "sm", "becomes": "hidden (the page title stays)" }
  ]
