    "cmdk": "1.1.1",
    "sonner": "2.0.8",
    "react-day-picker": "9.14.0",
    "input-otp": "1.5.0",
    "@tanstack/react-table": "8.21.3",
    "recharts": "2.15.4",
    "leaflet": "1.9.4"
  },
  "targetDependencies": {
    "next-shadcn": { "next": "15.5.27", "react": "19.3.0", "react-dom": "19.3.0" },
    "vite-shadcn": { "react": "19.3.0", "react-dom": "19.3.0", "react-router": "7.18.4" }
