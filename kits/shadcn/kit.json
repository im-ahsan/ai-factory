{
  "kind": "ai-factory/ui-kit",
  "id": "shadcn",
  "version": "1.2.0",
  "description": "React components for the design's blocks, controls, layers and frame, on shadcn/ui patterns (Radix primitives, Tailwind v4). Copied into the repo, which then owns them.",
  "license": "The components under components/ui follow shadcn/ui (MIT, https://ui.shadcn.com; components/ui/LICENSE is copied with them). See NOTICE for the packages' licences.",
  "targets": {
    "next-shadcn": {
      "framework": "next",
      "root": "",
      "srcRoots": ["src/", ""],
      "stylesheet": "app/globals.css",
      "theme": "app/design-theme.css",
      "clientDirective": true,
      "routes": "app"
    },
    "vite-shadcn": {
      "framework": "vite",
      "root": "src/",
      "srcRoots": ["src/"],
      "stylesheet": "index.css",
      "theme": "design-theme.css",
      "clientDirective": false,
      "routes": "routes.tsx"
    }
  },
